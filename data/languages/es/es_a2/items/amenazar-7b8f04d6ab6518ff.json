    ],
    "pl": [
      "Burza wygląda groźnie.",
      "Nie wolno ci nikogo grozić.",
      "Zagrożę, że odejdę.",
      "On próbuje grozić złodziejowi."
    ],
    "pt": [
      "A tempestade parece ameaçadora.",
      "Não deves ameaçar ninguém.",
      "Vou ameaçar ir embora.",
      "Ele tenta ameaçar o ladrão."
    ],
    "ro": [
