      "Megpróbálja megfenyegetni a tolvajt."
    ],
    "id": [
      "Badai itu tampak mengancam.",
      "Kamu tidak boleh mengancam siapa pun.",
      "Aku akan mengancam akan pergi.",
      "Dia mencoba mengancam pencuri itu."
    ],
    "it": [
      "La tempesta sembra minacciosa.",
      "Non devi minacciare nessuno.",
      "Minaccerò di andarmene.",
      "Lui cerca di minacciare il ladro."
    ],
    "ja": [
      "嵐が今にも来そうだ。",
