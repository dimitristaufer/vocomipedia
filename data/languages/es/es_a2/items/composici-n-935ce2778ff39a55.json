    {
      "target": "Mi composición trata sobre mi perro.",
      "reading": "[mi kom.po.siˈsjon es ˈso.βɾe mi ˈpe.ɾo]",
      "translations": {
        "en": "My composition is about my dog.",
        "es": "Mi composición es sobre mi perro.",
        "ipa": "[mi kom.po.siˈsjon es ˈso.βɾe mi ˈpe.ɾo]",
        "ar": "موضوعي عن كلبي.",
        "cs": "Moje slohová práce je o mém psovi.",
        "da": "Min stil er om min hund.",
        "de": "Mein Aufsatz handelt von meinem Hund.",
        "el": "Η έκθεσή μου είναι για τον σκύλο μου.",
        "fi": "Aineeni kertoo koirastani.",
        "fr": "Ma rédaction parle de mon chien.",
