      "Nu fi prost.",
      "Astăzi sunt cam amețit.",
      "Măgarul cară saci."
    ],
    "ru": [
      "Осёл пьёт воду.",
      "Не будь глупым.",
      "Сегодня я немного не в себе.",
      "Осёл несёт мешки."
    ],
    "sv": [
      "Åsnan dricker vatten.",
      "Var inte dum.",
      "Jag är lite dimmig i dag.",
      "Åsnan bär säckar."
    ],
    "tr": [
      "Eşek su içiyor.",
      "Saçma davranma.",
      "Bugün biraz dalgınım.",
      "Eşek çuvalları taşıyor."
    ],
    "uk": [
      "Віслюк п'є воду.",
      "Не будь дурним.",
      "Сьогодні я трохи не в собі.",
      "Віслюк несе мішки."
    ],
    "vi": [
      "Con lừa đang uống nước.",
      "Đừng ngu ngốc.",
      "Hôm nay tôi hơi mơ màng.",
      "Con lừa đang chở những bao tải."
    ],
    "yue": [
      "隻驢飲水。",
      "唔好咁蠢。",
