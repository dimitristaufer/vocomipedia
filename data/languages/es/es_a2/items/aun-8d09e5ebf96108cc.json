      "target": "Aun los niños lo saben.",
      "reading": "/aun los ˈniɲos lo ˈsaβen/",
      "translations": {
        "en": "Even children know it.",
        "es": "Aun los niños lo saben.",
        "ipa": "/aun los ˈniɲos lo ˈsaβen/",
        "ar": "حتى الأطفال يعرفونه.",
        "cs": "I děti to vědí.",
        "da": "Selv børn ved det.",
        "de": "Sogar Kinder wissen das.",
        "el": "Ακόμα και τα παιδιά το ξέρουν.",
        "fi": "Jopa lapset tietävät sen.",
        "fr": "Même les enfants le savent.",
        "he": "אפילו ילדים יודעים את זה.",
