  "sentences": [
    {
      "target": "공원이 마을의 한가운데 있어요.",
      "reading": "gongwoni maeul-ui hangaunde isseoyo.",
      "translations": {
        "en": "The park is in the middle of the village.",
        "ko": "공원이 마을의 한가운데 있어요.",
        "ipa": "gongwoni maeul-ui hangaunde isseoyo.",
        "ar": "تقع الحديقة في وسط القرية.",
        "cs": "Park je uprostřed vesnice.",
        "da": "Parken ligger midt i landsbyen.",
        "de": "Der Park liegt in der Mitte des Dorfes.",
        "el": "Το πάρκο είναι στο κέντρο του χωριού.",
        "es": "El parque está en el centro del pueblo.",
        "fi": "Puisto on kylän keskellä.",
        "fr": "Le parc est au milieu du village.",
        "he": "הפארק נמצא באמצע הכפר.",
        "hi": "पार्क गाँव के बीच में है।",
        "hu": "A park a falu közepén van.",
        "id": "Taman itu berada di tengah desa.",
        "it": "Il parco è nel centro del villaggio.",
        "ja": "公園は村の真ん中にあります。",
        "nb": "Parken ligger midt i landsbyen.",
        "nl": "Het park ligt midden in het dorp.",
        "pl": "Park jest pośrodku wioski.",
        "pt": "O parque fica no meio da vila.",
        "ro": "Parcul este în mijlocul satului.",
        "ru": "Парк находится в центре деревни.",
        "sv": "Parken ligger mitt i byn.",
        "tr": "Park köyün tam ortasında.",
        "uk": "Парк розташований у центрі села.",
        "vi": "Công viên ở giữa làng.",
        "yue": "個公園喺條村正中間。",
        "zh-Hans": "公园在村子中间。"
      },
