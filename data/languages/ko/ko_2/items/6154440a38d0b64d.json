    {
      "target": "이 규칙에는 예외가 있어요.",
      "reading": "i gyuchigeneun yeoe-ga isseoyo.",
      "translations": {
        "en": "This rule has an exception.",
        "ko": "이 규칙에는 예외가 있어요.",
        "ipa": "i gyuchigeneun yeoe-ga isseoyo.",
