  "sentences": [
    {
      "target": "비가 그치면 산길이 트이다.",
      "reading": "Bi-ga geuchi-myeon san-gil-i teuida.",
      "translations": {
        "en": "When the rain stops, the mountain trail opens up.",
        "ko": "비가 그치면 산길이 트이다.",
        "ipa": "Bi-ga geuchi-myeon san-gil-i teuida.",
        "ar": "إذا توقف المطر، ينفتح المسار الجبلي.",
        "cs": "Když déšť ustane, horská stezka se otevře.",
        "da": "Når regnen stopper, åbner bjergstien sig.",
        "de": "Wenn der Regen aufhört, öffnet sich der Bergpfad.",
        "el": "Όταν σταματήσει η βροχή, ανοίγει το ορεινό μονοπάτι.",
        "es": "Cuando deja de llover, se abre el sendero de la montaña.",
        "fi": "Kun sade loppuu, vuoristopolku avautuu.",
        "fr": "Quand la pluie s'arrête, le sentier de montagne s'ouvre.",
        "he": "כשהגשם נפסק, שביל ההר נפתח.",
        "hi": "जब बारिश रुकती है, पहाड़ी रास्ता खुल जाता है।",
        "hu": "Ha eláll az eső, a hegyi ösvény szabaddá válik.",
        "id": "Kalau hujan berhenti, jalan setapaknya terbuka.",
        "it": "Quando smette di piovere, il sentiero di montagna si apre.",
        "ja": "雨がやむと、山道が開ける。",
        "nb": "Når regnet stopper, åpner stien i fjellet seg.",
        "nl": "Als de regen stopt, opent het bergpad zich.",
        "pl": "Kiedy przestaje padać, górska ścieżka się otwiera.",
        "pt": "Quando a chuva para, a trilha da montanha se abre.",
        "ro": "Când se oprește ploaia, se deschide poteca de munte.",
        "ru": "Когда дождь прекращается, горная тропа открывается.",
        "sv": "När regnet slutar öppnar sig bergsstigen.",
        "tr": "Yağmur dinince dağ yolu açılır.",
        "uk": "Коли дощ припиняється, гірська стежка відкривається.",
        "vi": "Khi trời mưa tạnh, con đường núi trở nên thông thoáng.",
        "yue": "雨停咗，山路就通咗。",
        "zh-Hans": "雨停了，山路就通了。"
      },
