    {
      "target": "할머니 연세가 아흔이세요.",
      "reading": "halmeoni yeonsega ahuniseyo.",
      "translations": {
        "en": "My grandmother is ninety years old.",
        "ko": "할머니 연세가 아흔이세요.",
        "ipa": "halmeoni yeonsega ahuniseyo.",
        "ar": "جدتي في التسعين من عمرها.",
        "cs": "Babičce je devadesát let.",
        "da": "Min bedstemor er halvfems år gammel.",
        "de": "Meine Großmutter ist neunzig Jahre alt.",
        "el": "Η γιαγιά μου είναι ενενήντα χρονών.",
        "es": "Mi abuela tiene noventa años.",
        "fi": "Isoäitini on yhdeksänkymmentä vuotta vanha.",
        "fr": "Ma grand-mère a quatre-vingt-dix ans.",
        "he": "סבתא שלי בת תשעים.",
        "hi": "मेरी दादी नब्बे साल की हैं।",
        "hu": "A nagymamám kilencvenéves.",
        "id": "Nenek saya berumur sembilan puluh tahun.",
        "it": "Mia nonna ha novant'anni.",
        "ja": "祖母は九十歳です。",
        "nb": "Bestemoren min er nitti år gammel.",
        "nl": "Mijn oma is negentig jaar oud.",
        "pl": "Moja babcia ma dziewięćdziesiąt lat.",
        "pt": "Minha avó tem noventa anos.",
        "ro": "Bunica mea are nouăzeci de ani.",
        "ru": "Моей бабушке девяносто лет.",
        "sv": "Min mormor är nittio år gammal.",
        "tr": "Büyükannem doksan yaşında.",
        "uk": "Моїй бабусі дев'яносто років.",
        "vi": "Bà tôi đã chín mươi tuổi.",
        "yue": "我婆婆九十歲。",
        "zh-Hans": "我奶奶九十岁。"
      },
