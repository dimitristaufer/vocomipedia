  "sentences": [
    {
      "target": "저는 아이의 손을 붙잡았어요.",
      "reading": "jeoneun ai-ui soneul butjabasseoyo.",
      "translations": {
        "en": "I grabbed the child's hand.",
        "ko": "저는 아이의 손을 붙잡았어요.",
        "ipa": "jeoneun ai-ui soneul butjabasseoyo.",
        "ar": "أمسكتُ بيد الطفل.",
        "cs": "Chytil jsem dítě za ruku.",
        "da": "Jeg tog fat i barnets hånd.",
        "de": "Ich habe die Hand des Kindes festgehalten.",
        "el": "Έπιασα το χέρι του παιδιού.",
        "es": "Agarré la mano del niño.",
        "fi": "Tartuin lapsen käteen.",
        "fr": "J'ai pris la main de l'enfant.",
        "he": "תפסתי את ידו של הילד.",
        "hi": "मैंने बच्चे का हाथ पकड़ लिया।",
        "hu": "Megfogtam a gyerek kezét.",
        "id": "Saya memegang tangan anak itu.",
        "it": "Ho preso la mano del bambino.",
        "ja": "私は子どもの手をつかみました。",
        "nb": "Jeg holdt barnet i hånden.",
        "nl": "Ik pakte de hand van het kind vast.",
        "pl": "Chwyciłem dziecko za rękę.",
        "pt": "Segurei a mão da criança.",
        "ro": "Am apucat mâna copilului.",
        "ru": "Я взял ребёнка за руку.",
        "sv": "Jag tog barnets hand.",
        "tr": "Çocuğun elini tuttum.",
        "uk": "Я взяв дитину за руку.",
        "vi": "Tôi nắm tay đứa trẻ.",
        "yue": "我攞住咗個小朋友隻手。",
        "zh-Hans": "我拉住了孩子的手。"
      },
