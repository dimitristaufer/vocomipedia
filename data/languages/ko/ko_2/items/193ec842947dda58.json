    {
      "target": "의사가 제 심장을 검사했어요.",
      "reading": "uisaga je simjangeul geomsahaesseoyo.",
      "translations": {
        "en": "The doctor examined my heart.",
        "ko": "의사가 제 심장을 검사했어요.",
        "ipa": "uisaga je simjangeul geomsahaesseoyo.",
        "ar": "فحص الطبيب قلبي.",
        "cs": "Lékař mi vyšetřil srdce.",
        "da": "Lægen undersøgte mit hjerte.",
        "de": "Der Arzt untersuchte mein Herz.",
        "el": "Ο γιατρός εξέτασε την καρδιά μου.",
        "es": "El médico me examinó el corazón.",
        "fi": "Lääkäri tutki sydämeni.",
        "fr": "Le médecin a examiné mon cœur.",
        "he": "הרופא בדק את הלב שלי.",
        "hi": "डॉक्टर ने मेरा दिल जाँचा।",
        "hu": "Az orvos megvizsgálta a szívemet.",
        "id": "Dokter memeriksa jantung saya.",
        "it": "Il medico ha esaminato il mio cuore.",
        "ja": "医者が私の心臓を診察しました。",
        "nb": "Legen undersøkte hjertet mitt.",
        "nl": "De dokter onderzocht mijn hart.",
        "pl": "Lekarz zbadał moje serce.",
        "pt": "O médico examinou meu coração.",
        "ro": "Doctorul mi-a examinat inima.",
        "ru": "Врач осмотрел моё сердце.",
        "sv": "Läkaren undersökte mitt hjärta.",
        "tr": "Doktor kalbimi muayene etti.",
        "uk": "Лікар оглянув моє серце.",
        "vi": "Bác sĩ đã khám tim tôi.",
        "yue": "醫生檢查咗我嘅心臟。",
        "zh-Hans": "医生检查了我的心脏。"
      },
