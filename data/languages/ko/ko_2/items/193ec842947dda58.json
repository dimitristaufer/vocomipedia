  "sentences": [
    {
      "target": "운동을 하면 심장이 빨리 뛰어요.",
      "reading": "undongeul hamyeon simjangi ppalli ttwieoyo.",
      "translations": {
        "en": "When I exercise, my heart beats fast.",
        "ko": "운동을 하면 심장이 빨리 뛰어요.",
        "ipa": "undongeul hamyeon simjangi ppalli ttwieoyo.",
        "ar": "عندما أمارس الرياضة، ينبض قلبي بسرعة.",
        "cs": "Když cvičím, srdce mi bije rychle.",
        "da": "Når jeg dyrker motion, banker mit hjerte hurtigt.",
        "de": "Wenn ich Sport mache, schlägt mein Herz schnell.",
        "el": "Όταν γυμνάζομαι, η καρδιά μου χτυπά γρήγορα.",
        "es": "Cuando hago ejercicio, me late rápido el corazón.",
        "fi": "Kun liikun, sydämeni lyö nopeasti.",
        "fr": "Quand je fais du sport, mon cœur bat vite.",
        "he": "כשאני עושה ספורט, הלב שלי פועם מהר.",
        "hi": "जब मैं व्यायाम करता हूँ, तो मेरा दिल तेज़ धड़कता है।",
        "hu": "Amikor sportolok, gyorsan ver a szívem.",
        "id": "Saat saya berolahraga, jantung saya berdebar cepat.",
        "it": "Quando faccio esercizio, il mio cuore batte forte.",
        "ja": "運動をすると、心臓が速く鼓動します。",
        "nb": "Når jeg trener, banker hjertet mitt fort.",
        "nl": "Als ik sport, klopt mijn hart snel.",
        "pl": "Kiedy ćwiczę, moje serce bije szybko.",
        "pt": "Quando faço exercício, meu coração bate rápido.",
        "ro": "Când fac exerciții, inima îmi bate repede.",
        "ru": "Когда я занимаюсь спортом, у меня быстро бьётся сердце.",
        "sv": "När jag tränar slår mitt hjärta snabbt.",
        "tr": "Egzersiz yapınca kalbim hızlı atıyor.",
        "uk": "Коли я займаюся спортом, у мене швидко б'ється серце.",
        "vi": "Khi tôi tập thể dục, tim tôi đập nhanh.",
        "yue": "我做運動嘅時候，心臟跳得好快。",
        "zh-Hans": "我运动时，心脏跳得很快。"
      },
