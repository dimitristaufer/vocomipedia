      "Я виріс у Пусані.",
      "Це цуценя так швидко росте."
    ],
    "vi": [
      "Đứa trẻ đã lớn rồi.",
      "Khi mùa xuân đến, hoa cũng nở nhiều hơn.",
      "Tôi lớn lên ở Busan.",
      "Chú cún đó lớn nhanh quá."
    ],
    "yue": [
