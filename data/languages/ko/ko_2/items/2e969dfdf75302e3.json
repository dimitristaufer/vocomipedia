  "sentences": [
    {
      "target": "미디어를 통해 소식을 알았어요.",
      "reading": "midieoreul tonghae sosigeul aratseoyo.",
      "translations": {
        "en": "I learned the news through the media.",
        "ko": "미디어를 통해 소식을 알았어요.",
        "ipa": "midieoreul tonghae sosigeul aratseoyo.",
        "ar": "عرفت الخبر من خلال وسائل الإعلام.",
        "cs": "Dozvěděl jsem se tu zprávu prostřednictvím médií.",
        "da": "Jeg fik nyheden gennem medierne.",
        "de": "Ich habe die Nachricht über die Medien erfahren.",
        "el": "Έμαθα τα νέα μέσω των μέσων ενημέρωσης.",
        "es": "Me enteré de la noticia a través de los medios.",
        "fi": "Sain uutisen tietääkseni median kautta.",
        "fr": "J'ai appris la nouvelle par les médias.",
        "he": "נודע לי על החדשות דרך אמצעי התקשורת.",
        "hi": "मुझे खबर मीडिया के ज़रिए मिली।",
        "hu": "A médiából tudtam meg a hírt.",
        "id": "Saya tahu beritanya lewat media.",
        "it": "Ho saputo la notizia attraverso i media.",
        "ja": "メディアを通してニュースを知りました。",
        "nb": "Jeg fikk vite om nyheten gjennom mediene.",
        "nl": "Ik hoorde het nieuws via de media.",
        "pl": "Dowiedziałem się o wiadomości za pośrednictwem mediów.",
        "pt": "Soube da notícia pelos meios de comunicação.",
        "ro": "Am aflat vestea prin intermediul mass-mediei.",
        "ru": "Я узнал новость через СМИ.",
        "sv": "Jag fick veta nyheten genom medierna.",
        "tr": "Haberi medyadan öğrendim.",
        "uk": "Я дізнався новину через медіа.",
        "vi": "Tôi biết tin qua phương tiện truyền thông.",
        "yue": "我透過媒體知道咗個消息。",
        "zh-Hans": "我通过媒体得知了这个消息。"
      },
