  "sentences": [
    {
      "target": "그는 사표를 내고 회사에서 나왔어요.",
      "reading": "geuneun sapyoreul naego hoesaeseo nawasseoyo",
      "translations": {
        "en": "He handed in his resignation and left the company.",
        "ko": "그는 사표를 내고 회사에서 나왔어요.",
        "ipa": "geuneun sapyoreul naego hoesaeseo nawasseoyo",
        "ar": "قدّم استقالته وغادر الشركة.",
        "cs": "Dal výpověď a odešel ze společnosti.",
        "da": "Han sagde op og forlod virksomheden.",
        "de": "Er reichte seine Kündigung ein und verließ die Firma.",
        "el": "Υπέβαλε την παραίτησή του και έφυγε από την εταιρεία.",
        "es": "Presentó su renuncia y salió de la empresa.",
        "fi": "Hän jätti irtisanoutumisilmoituksen ja lähti yrityksestä.",
        "fr": "Il a donné sa démission et a quitté l'entreprise.",
        "he": "הוא הגיש את מכתב ההתפטרות שלו ועזב את החברה.",
        "hi": "उसने इस्तीफा दिया और कंपनी छोड़ दी।",
        "hu": "Felmondott, és elhagyta a céget.",
        "id": "Dia mengajukan pengunduran diri dan keluar dari perusahaan.",
        "it": "Ha presentato le dimissioni e ha lasciato l'azienda.",
        "ja": "彼は退職届を出して会社を辞めました。",
        "nb": "Han leverte oppsigelsen sin og sluttet i selskapet.",
        "nl": "Hij diende zijn ontslag in en vertrok bij het bedrijf.",
        "pl": "Złożył wypowiedzenie i odszedł z firmy.",
        "pt": "Ele pediu demissão e saiu da empresa.",
        "ro": "Și-a dat demisia și a plecat de la companie.",
        "ru": "Он подал заявление об увольнении и ушёл из компании.",
        "sv": "Han lämnade in sin uppsägning och slutade på företaget.",
        "tr": "İstifasını verdi ve şirketten ayrıldı.",
        "uk": "Він подав заяву про звільнення і пішов із компанії.",
        "vi": "Anh ấy đã nộp đơn xin nghỉ việc và rời công ty.",
        "yue": "佢遞咗辭職信，然後離開咗公司。",
        "zh-Hans": "他递交了辞职信，离开了公司。"
      },
