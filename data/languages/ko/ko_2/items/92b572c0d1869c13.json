  "sentences": [
    {
      "target": "아침에 윗몸 운동을 했어요.",
      "reading": "achim-e wismom undong-eul haesseoyo.",
      "translations": {
        "en": "I did upper-body exercises in the morning.",
        "ko": "아침에 윗몸 운동을 했어요.",
        "ipa": "achim-e wismom undong-eul haesseoyo.",
        "ar": "قمت بتمارين للجزء العلوي من الجسم في الصباح.",
        "cs": "Ráno jsem cvičil horní část těla.",
        "da": "Jeg lavede øvelser for overkroppen om morgenen.",
        "de": "Ich habe morgens Übungen für den Oberkörper gemacht.",
        "el": "Έκανα ασκήσεις για το πάνω μέρος του σώματος το πρωί.",
        "es": "Hice ejercicios para la parte superior del cuerpo por la mañana.",
        "fi": "Tein aamulla ylävartaloharjoituksia.",
        "fr": "J’ai fait des exercices pour le haut du corps ce matin.",
        "he": "עשיתי תרגילי פלג גוף עליון בבוקר.",
        "hi": "मैंने सुबह ऊपरी शरीर के व्यायाम किए।",
        "hu": "Reggel felsőtestgyakorlatokat végeztem.",
        "id": "Saya melakukan latihan untuk tubuh bagian atas di pagi hari.",
        "it": "Ho fatto esercizi per la parte superiore del corpo al mattino.",
        "ja": "朝に上半身の運動をしました。",
        "nb": "Jeg gjorde øvelser for overkroppen om morgenen.",
        "nl": "Ik deed ’s ochtends oefeningen voor mijn bovenlichaam.",
        "pl": "Rano ćwiczyłem górną część ciała.",
        "pt": "Fiz exercícios para a parte superior do corpo de manhã.",
        "ro": "Am făcut exerciții pentru partea superioară a corpului dimineața.",
        "ru": "Утром я делал упражнения для верхней части тела.",
        "sv": "Jag gjorde övningar för överkroppen på morgonen.",
        "tr": "Sabah üst vücut egzersizleri yaptım.",
        "uk": "Вранці я робив вправи для верхньої частини тіла.",
        "vi": "Buổi sáng tôi đã tập các bài cho phần thân trên.",
        "yue": "朝早我做咗上身運動。",
        "zh-Hans": "我早上做了上半身运动。"
      },
