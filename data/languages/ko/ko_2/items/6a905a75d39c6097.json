  "sentences": [
    {
      "target": "어머니는 정성을 들여 반찬을 만드셨어요.",
      "reading": "eomeonineun jeongseongeul deuryeo banchaneul mandeusyeosseoyo.",
      "translations": {
        "en": "My mother made the side dishes with devotion.",
        "ko": "어머니는 정성을 들여 반찬을 만드셨어요.",
        "ipa": "eomeonineun jeongseongeul deuryeo banchaneul mandeusyeosseoyo.",
        "ar": "أعدت أمي الأطباق الجانبية بعناية كبيرة.",
        "cs": "Maminka připravila přílohy s velkou péčí.",
        "da": "Min mor lavede tilbehøret med stor omhu.",
        "de": "Meine Mutter hat das Gemüse mit viel Hingabe zubereitet.",
        "el": "Η μητέρα μου έφτιαξε τα συνοδευτικά με πολλή φροντίδα.",
        "es": "Mi madre preparó los acompañamientos con mucho esmero.",
        "fi": "Äitini teki lisukkeet suurella huolella.",
        "fr": "Ma mère a préparé les accompagnements avec beaucoup de soin.",
        "he": "אמא שלי הכינה את התוספות במסירות רבה.",
        "hi": "मेरी माँ ने साइड डिश बहुत मेहनत और प्यार से बनाई।",
        "hu": "Anyukám nagy gondossággal készítette el a köreteket.",
        "id": "Ibu saya membuat lauk dengan penuh perhatian.",
        "it": "Mia madre ha preparato i contorni con molta cura.",
        "ja": "母は心を込めておかずを作りました。",
        "nb": "Moren min laget tilbehøret med stor omtanke.",
        "nl": "Mijn moeder maakte de bijgerechten met veel zorg.",
        "pl": "Moja mama przygotowała dodatki z wielką starannością.",
        "pt": "Minha mãe preparou os acompanhamentos com muito carinho.",
        "ro": "Mama mea a pregătit garniturile cu multă grijă.",
        "ru": "Мама приготовила гарниры с большой заботой.",
        "sv": "Min mamma gjorde tillbehören med stor omsorg.",
        "tr": "Annem mezeleri büyük bir özenle yaptı.",
        "uk": "Моя мама приготувала гарніри з великою турботою.",
        "vi": "Mẹ tôi đã làm các món ăn kèm rất cẩn thận.",
        "yue": "我媽媽好用心咁整咗啲配菜。",
        "zh-Hans": "我妈妈用心做了配菜。"
      },
