    {
      "target": "시아버지 앞에서는 말을 조심해요.",
      "reading": "siabeoji apeseoneun mareul josimhaeyo.",
      "translations": {
        "en": "I’m careful with my words in front of my father-in-law.",
        "ko": "시아버지 앞에서는 말을 조심해요.",
        "ipa": "siabeoji apeseoneun mareul josimhaeyo.",
        "ar": "أنتبه إلى كلامي أمام والدي زوجي.",
        "cs": "Dávám si pozor na to, co říkám před tchánem.",
        "da": "Jeg passer på, hvad jeg siger foran min svigerfar.",
        "de": "Vor meinem Schwiegervater achte ich auf meine Worte.",
        "el": "Προσέχω τα λόγια μου μπροστά στον πεθερό μου.",
        "es": "Cuido lo que digo delante de mi suegro.",
        "fi": "Varon sanojani appivaarin edessä.",
        "fr": "Je fais attention à mes paroles devant mon beau-père.",
        "he": "אני נזהר במילים שלי ליד חמי.",
        "hi": "मैं अपने ससुर के सामने अपनी बातों का ध्यान रखता हूँ।",
        "hu": "Az apósom előtt megválogatom a szavaimat.",
        "id": "Saya berhati-hati dalam berbicara di depan mertua laki-laki saya.",
        "it": "Faccio attenzione alle mie parole davanti a mio suocero.",
        "ja": "義父の前では話し方に気をつけます。",
        "nb": "Jeg passer på hva jeg sier foran svigerfaren min.",
        "nl": "Ik let op mijn woorden in het bijzijn van mijn schoonvader.",
        "pl": "Uważam na słowa przy moim teściu.",
        "pt": "Eu tomo cuidado com o que digo perto do meu sogro.",
        "ro": "Am grijă ce spun în fața socrului meu.",
        "ru": "Я слежу за своими словами при свёкре.",
        "sv": "Jag passar mig för vad jag säger framför min svärfar.",
        "tr": "Kayınbabamın yanında sözlerime dikkat ederim.",
        "uk": "Я стежу за своїми словами при свекрі.",
        "vi": "Tôi cẩn thận lời nói trước mặt bố chồng.",
        "yue": "我喺老爺面前講嘢會小心啲。",
        "zh-Hans": "我在公公面前说话很小心。"
      },
