  "sentences": [
    {
      "target": "시아버지께서 주말에 집에 오셨어요.",
      "reading": "siabeojikkeseo jumare jibe oseosseoyo.",
      "translations": {
        "en": "My father-in-law came to our house on the weekend.",
        "ko": "시아버지께서 주말에 집에 오셨어요.",
        "ipa": "siabeojikkeseo jumare jibe oseosseoyo.",
        "ar": "جاء والدي زوجي إلى المنزل في عطلة نهاية الأسبوع.",
        "cs": "Můj tchán přišel o víkendu k nám domů.",
        "da": "Min svigerfar kom hjem til os i weekenden.",
        "de": "Mein Schwiegervater ist am Wochenende zu uns nach Hause gekommen.",
        "el": "Ο πεθερός μου ήρθε στο σπίτι το σαββατοκύριακο.",
        "es": "Mi suegro vino a nuestra casa el fin de semana.",
        "fi": "Appivaarini tuli meille viikonloppuna.",
        "fr": "Mon beau-père est venu chez nous le week-end.",
        "he": "חמי בא אלינו הביתה בסוף השבוע.",
        "hi": "मेरे ससुर वीकेंड पर हमारे घर आए।",
        "hu": "Az apósom hétvégén jött hozzánk.",
        "id": "Mertua laki-laki saya datang ke rumah kami pada akhir pekan.",
        "it": "Mio suocero è venuto a casa nostra nel fine settimana.",
        "ja": "義父が週末に家に来ました。",
        "nb": "Svigerfaren min kom hjem til oss i helgen.",
        "nl": "Mijn schoonvader kwam in het weekend bij ons thuis.",
        "pl": "Mój teść przyszedł do nas w weekend.",
        "pt": "Meu sogro veio à nossa casa no fim de semana.",
        "ro": "Socrul meu a venit la noi acasă în weekend.",
        "ru": "Мой свёкор приехал к нам домой на выходных.",
        "sv": "Min svärfar kom hem till oss i helgen.",
        "tr": "Kayınbabam hafta sonu evimize geldi.",
        "uk": "Мій свекор приїхав до нас додому на вихідних.",
        "vi": "Bố chồng tôi đã đến nhà vào cuối tuần.",
        "yue": "我嘅老爺週末嚟咗我哋屋企。",
        "zh-Hans": "我的公公周末来我们家了。"
      },
