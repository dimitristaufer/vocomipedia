    {
      "target": "따뜻한 햇살 아래서 책을 읽었어요.",
      "reading": "ttatteutan haetsal araeseo chaegeul ilgeosseoyo.",
      "translations": {
        "en": "I read a book under the warm sun.",
        "ko": "따뜻한 햇살 아래서 책을 읽었어요.",
        "ipa": "ttatteutan haetsal araeseo chaegeul ilgeosseoyo.",
        "ar": "قرأت كتابًا تحت الشمس الدافئة.",
        "cs": "Četl jsem knihu na teplém slunci.",
        "da": "Jeg læste en bog i den varme sol.",
        "de": "Ich habe unter der warmen Sonne ein Buch gelesen.",
        "el": "Διάβασα ένα βιβλίο κάτω από τον ζεστό ήλιο.",
        "es": "Leí un libro bajo el sol cálido.",
        "fi": "Luin kirjaa lämpimässä auringossa.",
        "fr": "J’ai lu un livre sous le soleil chaud.",
        "he": "קראתי ספר תחת השמש החמה.",
        "hi": "मैंने गर्म धूप में एक किताब पढ़ी।",
        "hu": "Meleg napsütésben olvastam egy könyvet.",
        "id": "Saya membaca buku di bawah sinar matahari yang hangat.",
        "it": "Ho letto un libro sotto il sole caldo.",
        "ja": "暖かい日差しの下で本を読みました。",
        "nb": "Jeg leste en bok i den varme solen.",
        "nl": "Ik las een boek in de warme zon.",
        "pl": "Czytałem książkę w ciepłym słońcu.",
        "pt": "Li um livro sob o sol quente.",
        "ro": "Am citit o carte sub soarele cald.",
        "ru": "Я читал книгу под тёплым солнцем.",
        "sv": "Jag läste en bok i den varma solen.",
        "tr": "Sıcak güneşin altında kitap okudum.",
        "uk": "Я читав книжку під теплим сонцем.",
        "vi": "Tôi đã đọc sách dưới ánh nắng ấm áp.",
        "yue": "我喺溫暖嘅陽光下睇書。",
        "zh-Hans": "我在温暖的阳光下读了书。"
      },
