    {
      "target": "우리 동네가 많이 발전했어요.",
      "reading": "uri dongnega mani baljeonhaesseoyo.",
      "translations": {
        "en": "Our neighborhood has improved a lot.",
        "ko": "우리 동네가 많이 발전했어요.",
        "ipa": "uri dongnega mani baljeonhaesseoyo.",
        "ar": "تحسّ حينا كثيرًا.",
        "cs": "Naše čtvrť se hodně zlepšila.",
        "da": "Vores kvarter er blevet meget bedre.",
        "de": "Unser Viertel hat sich sehr verbessert.",
        "el": "Η γειτονιά μας έχει βελτιωθεί πολύ.",
        "es": "Nuestro barrio ha mejorado mucho.",
        "fi": "Naapurustomme on parantunut paljon.",
        "fr": "Notre quartier s'est beaucoup amélioré.",
