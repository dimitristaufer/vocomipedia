  "sentences": [
    {
      "target": "아빠가 통에 물을 받았어요.",
      "reading": "appaga tong-e muleul badasseoyo.",
      "translations": {
        "en": "Dad filled the barrel with water.",
        "ko": "아빠가 통에 물을 받았어요.",
        "ipa": "appaga tong-e muleul badasseoyo.",
        "ar": "ملأ أبي البرميل بالماء.",
        "cs": "Táta naplnil sud vodou.",
        "da": "Far fyldte tønden med vand.",
        "de": "Papa hat das Fass mit Wasser gefüllt.",
        "el": "Ο μπαμπάς γέμισε το βαρέλι με νερό.",
        "es": "Papá llenó el barril de agua.",
        "fi": "Isä täytti tynnyrin vedellä.",
        "fr": "Papa a rempli le tonneau d'eau.",
        "he": "אבא מילא את החבית במים.",
        "hi": "पापा ने पीपे में पानी भरा।",
        "hu": "Apa megtöltötte a hordót vízzel.",
        "id": "Ayah mengisi tong itu dengan air.",
        "it": "Papà ha riempito la botte d'acqua.",
        "ja": "お父さんがたるに水を入れました。",
        "nb": "Pappa fylte tønnen med vann.",
        "nl": "Papa vulde het vat met water.",
        "pl": "Tata napełnił beczkę wodą.",
        "pt": "O pai encheu o barril com água.",
        "ro": "Tata a umplut butoiul cu apă.",
        "ru": "Папа наполнил бочку водой.",
        "sv": "Pappa fyllde tunnan med vatten.",
        "tr": "Babam fıçıya su doldurdu.",
        "uk": "Тато наповнив бочку водою.",
        "vi": "Bố đã đổ đầy nước vào thùng.",
        "yue": "爸爸喺桶入面裝滿水。",
        "zh-Hans": "爸爸往桶里装了水。"
      },
