  "sentences": [
    {
      "target": "나는 대답을 망설이다가 고개를 끄덕였어요.",
      "reading": "naneun daedabeul mangseoridaga gogaereul kkeudeokyeosseoyo",
      "translations": {
        "en": "I hesitated, then nodded.",
        "ko": "나는 대답을 망설이다가 고개를 끄덕였어요.",
        "ipa": "naneun daedabeul mangseoridaga gogaereul kkeudeokyeosseoyo",
        "ar": "ترددت، ثم أومأت برأسي.",
        "cs": "Chvíli jsem váhala s odpovědí a pak jsem přikývla.",
        "da": "Jeg tøvede, og så nikkede jeg.",
        "de": "Ich zögerte und nickte dann.",
        "el": "Δίστασα και μετά έγνεψα.",
        "es": "Dudé y luego asentí.",
        "fi": "Epäröin ja nyökkäsin sitten.",
        "fr": "J’ai hésité, puis j’ai hoché la tête.",
        "he": "התלבטתי ואז הנהנתי.",
        "hi": "मैंने हिचकिचाते हुए फिर सिर हिलाया।",
        "hu": "Habozva aztán bólintottam.",
        "id": "Saya ragu-ragu, lalu mengangguk.",
        "it": "Esitai, poi annuii.",
        "ja": "答えようか迷って、それからうなずきました。",
        "nb": "Jeg nølte, og så nikket jeg.",
        "nl": "Ik aarzelde en knikte toen.",
        "pl": "Zawahałam się, a potem skinęłam głową.",
        "pt": "Eu hesitei e depois acenei com a cabeça.",
        "ro": "Am ezitat, apoi am dat din cap.",
        "ru": "Я замялся, а потом кивнул.",
        "sv": "Jag tvekade och nickade sedan.",
        "tr": "Bir an tereddüt ettim, sonra başımı salladım.",
        "uk": "Я вагався, а потім кивнув.",
        "vi": "Tôi do dự rồi gật đầu.",
        "yue": "我猶疑咗一下，然後點咗頭。",
        "zh-Hans": "我犹豫了一下，然后点了点头。"
      },
