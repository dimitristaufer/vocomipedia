    {
      "target": "저는 밤 10시에 귀가했어요.",
      "reading": "jeoneun bam 10sie gwigahaesseoyo.",
      "translations": {
        "en": "I got home at 10 p.m.",
        "ko": "저는 밤 10시에 귀가했어요.",
        "ipa": "jeoneun bam 10sie gwigahaesseoyo.",
        "ar": "وصلتُ إلى البيت الساعة العاشرة مساءً.",
        "cs": "Dostal jsem se domů v deset večer.",
        "da": "Jeg kom hjem klokken 22.",
        "de": "Ich bin um 22 Uhr nach Hause gekommen.",
        "el": "Γύρισα σπίτι στις 10 το βράδυ.",
        "es": "Llegué a casa a las 10 de la noche.",
        "fi": "Pääsin kotiin kymmeneltä illalla.",
        "fr": "Je suis rentré à la maison à 22 heures.",
        "he": "הגעתי הביתה בשעה עשר בלילה.",
        "hi": "मैं रात 10 बजे घर पहुँचा।",
        "hu": "Este 10-kor értem haza.",
        "id": "Saya pulang ke rumah pukul 10 malam.",
        "it": "Sono tornato a casa alle 22.",
        "ja": "夜10時に帰宅しました。",
        "nb": "Jeg kom hjem klokka 22.",
        "nl": "Ik kwam om 10 uur 's avonds thuis.",
        "pl": "Wróciłem do domu o 22.",
        "pt": "Cheguei em casa às 22h.",
        "ro": "Am ajuns acasă la ora 10 seara.",
        "ru": "Я пришёл домой в 10 вечера.",
        "sv": "Jag kom hem klockan 22.",
        "tr": "Saat 10'da eve geldim.",
        "uk": "Я прийшов додому о 10-й вечора.",
        "vi": "Tôi về đến nhà lúc 10 giờ tối.",
        "yue": "我喺夜晚十點返到屋企。",
        "zh-Hans": "我晚上10点回到家。"
      },
