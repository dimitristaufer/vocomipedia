    {
      "target": "작은 소리에도 짜증이 나요.",
      "reading": "jageun soriedo jjajeungi nayo.",
      "translations": {
        "en": "Even small noises annoy me.",
        "ko": "작은 소리에도 짜증이 나요.",
        "ipa": "jageun soriedo jjajeungi nayo.",
        "ar": "حتى الأصوات الصغيرة تزعجني.",
        "cs": "Vadí mi i malé zvuky.",
        "da": "Selv små lyde irriterer mig.",
        "de": "Schon kleine Geräusche nerven mich.",
        "el": "Ακόμα και οι μικροί θόρυβοι με ενοχλούν.",
        "es": "Hasta los ruidos pequeños me molestan.",
        "fi": "Pienetkin äänet ärsyttävät minua.",
        "fr": "Même les petits bruits m'agacent.",
        "he": "אפילו רעשים קטנים מרגיזים אותי.",
        "hi": "छोटी-छोटी आवाज़ें भी मुझे चिढ़ाती हैं।",
        "hu": "Még a kis zajok is idegesítenek.",
        "id": "Bahkan suara kecil pun membuat saya kesal.",
        "it": "Anche i piccoli rumori mi irritano.",
        "ja": "小さな音でもいらいらします。",
        "nb": "Selv små lyder irriterer meg.",
        "nl": "Zelfs kleine geluiden irriteren me.",
        "pl": "Nawet małe dźwięki mnie irytują.",
        "pt": "Até barulhinhos me irritam.",
        "ro": "Și zgomotele mici mă enervează.",
        "ru": "Даже маленькие звуки меня раздражают.",
        "sv": "Till och med små ljud irriterar mig.",
        "tr": "Küçük sesler bile beni sinirlendiriyor.",
        "uk": "Навіть маленькі звуки мене дратують.",
        "vi": "Ngay cả những tiếng động nhỏ cũng làm tôi bực mình.",
        "yue": "就算係細聲音都會令我煩。",
        "zh-Hans": "连小声音都让我烦。"
      },
