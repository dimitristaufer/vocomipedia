    {
      "target": "기다리다 보니 짜증이 났어요.",
      "reading": "gidarida boni jjajeungi nasseoyo.",
      "translations": {
        "en": "I got annoyed after waiting.",
        "ko": "기다리다 보니 짜증이 났어요.",
        "ipa": "gidarida boni jjajeungi nasseoyo.",
        "ar": "شعرت بالانزعاج بعد أن انتظرت.",
        "cs": "Po čekání mě to začalo štvát.",
        "da": "Jeg blev irriteret af at vente.",
        "de": "Ich wurde vom Warten genervt.",
        "el": "Με ενόχλησε η αναμονή.",
        "es": "Me molesté después de esperar.",
        "fi": "Ärsyynnyin odottamisesta.",
        "fr": "J'étais agacé après avoir attendu.",
        "he": "התעצבנתי אחרי שחיכיתי.",
        "hi": "इंतजार करते-करते मुझे चिढ़ हो गई।",
        "hu": "A várakozástól ideges lettem.",
        "id": "Saya jadi kesal setelah menunggu.",
        "it": "Mi sono irritato dopo aver aspettato.",
        "ja": "待っているうちにいらいらしました。",
        "nb": "Jeg ble irritert av å vente.",
        "nl": "Ik werd geïrriteerd van het wachten.",
        "pl": "Zaczęło mnie to irytować od czekania.",
        "pt": "Fiquei irritado de tanto esperar.",
        "ro": "M-am enervat după ce am așteptat.",
        "ru": "Я начал раздражаться, пока ждал.",
        "sv": "Jag blev irriterad av att vänta.",
        "tr": "Beklerken canım sıkıldı.",
        "uk": "Я роздратувався, поки чекав.",
        "vi": "Chờ đợi làm tôi bực mình.",
        "yue": "等咗陣之後，我覺得好煩。",
        "zh-Hans": "等了一会儿，我有点烦了。"
      },
