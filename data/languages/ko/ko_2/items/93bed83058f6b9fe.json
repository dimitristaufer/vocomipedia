  "sentences": [
    {
      "target": "아이들은 경기 전에 흥분이 가라앉지 않았어요.",
      "reading": "aidureun gyeonggi jeone heungbun-i garajji anhasseoyo.",
      "translations": {
        "en": "The kids couldn't calm down before the game.",
        "ko": "아이들은 경기 전에 흥분이 가라앉지 않았어요.",
        "ipa": "aidureun gyeonggi jeone heungbun-i garajji anhasseoyo.",
        "ar": "لم يهدأ حماس الأطفال قبل المباراة.",
        "cs": "Děti se před zápasem nemohly uklidnit.",
        "da": "Børnene kunne ikke falde til ro før kampen.",
        "de": "Die Kinder konnten sich vor dem Spiel nicht beruhigen.",
        "el": "Τα παιδιά δεν μπορούσαν να ηρεμήσουν πριν από τον αγώνα.",
        "es": "Los niños no se calmaban antes del partido.",
        "fi": "Lapset eivät rauhoittuneet ennen peliä.",
        "fr": "Les enfants n'arrivaient pas à se calmer avant le match.",
        "he": "הילדים לא הצליחו להירגע לפני המשחק.",
        "hi": "बच्चे मैच से पहले शांत नहीं हो पाए।",
        "hu": "A gyerekek nem tudtak megnyugodni a meccs előtt.",
        "id": "Anak-anak tidak bisa tenang sebelum pertandingan.",
        "it": "I bambini non riuscivano a calmarsi prima della partita.",
        "ja": "子どもたちは試合の前に落ち着けませんでした。",
        "nb": "Barna klarte ikke å roe seg før kampen.",
        "nl": "De kinderen konden zich voor de wedstrijd niet kalmeren.",
        "pl": "Dzieci nie mogły się uspokoić przed meczem.",
        "pt": "As crianças não conseguiam se acalmar antes do jogo.",
        "ro": "Copiii nu se puteau liniști înainte de meci.",
        "ru": "Дети не могли успокоиться перед матчем.",
        "sv": "Barnen kunde inte lugna ner sig före matchen.",
        "tr": "Çocuklar maçtan önce sakinleşemedi.",
        "uk": "Діти не могли заспокоїтися перед грою.",
        "vi": "Bọn trẻ không thể bình tĩnh trước trận đấu.",
        "yue": "小朋友喺比賽前冷靜唔到落嚟。",
        "zh-Hans": "孩子们在比赛前平静不下来。"
      },
