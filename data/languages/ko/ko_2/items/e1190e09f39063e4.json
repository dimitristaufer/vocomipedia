    {
      "target": "급하게 걷다가 문에 부딪혔어요.",
      "reading": "geuphage geotdaga mune budichyeosseoyo.",
      "translations": {
        "en": "I was walking fast and bumped into the door.",
        "ko": "급하게 걷다가 문에 부딪혔어요.",
        "ipa": "geuphage geotdaga mune budichyeosseoyo.",
        "ar": "كنت أمشي بسرعة فاصطدمت بالباب.",
        "cs": "Šel jsem rychle a narazil jsem do dveří.",
        "da": "Jeg gik hurtigt og stødte ind i døren.",
        "de": "Ich bin schnell gegangen und gegen die Tür gestoßen.",
        "el": "Περπατούσα γρήγορα και χτύπησα στην πόρτα.",
        "es": "Iba andando deprisa y choqué con la puerta.",
        "fi": "Kävelin nopeasti ja törmäsin oveen.",
        "fr": "Je marchais vite et j'ai heurté la porte.",
        "he": "הלכתי מהר ונתקלתי בדלת.",
        "hi": "मैं जल्दी चल रहा था और दरवाज़े से टकरा गया।",
        "hu": "Gyorsan sétáltam, és nekimentem az ajtónak.",
        "id": "Saya berjalan cepat dan menabrak pintu.",
        "it": "Camminavo in fretta e ho sbattuto contro la porta.",
        "ja": "急いで歩いていてドアにぶつかりました。",
        "nb": "Jeg gikk raskt og støtte borti døren.",
        "nl": "Ik liep snel en botste tegen de deur.",
        "pl": "Szedłem szybko i uderzyłem w drzwi.",
        "pt": "Eu andava depressa e bati na porta.",
        "ro": "Mergeam repede și m-am lovit de ușă.",
        "ru": "Я шёл быстро и ударился о дверь.",
        "sv": "Jag gick snabbt och slog i dörren.",
        "tr": "Hızlı yürürken kapıya çarptım.",
        "uk": "Я швидко йшов і вдарився об двері.",
        "vi": "Tôi đi nhanh nên đã đụng vào cửa.",
        "yue": "我行得好快，撞咗埋門。",
        "zh-Hans": "我走得太快，撞到门了。"
      },
