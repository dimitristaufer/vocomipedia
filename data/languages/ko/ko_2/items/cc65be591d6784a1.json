  "sentences": [
    {
      "target": "여름철에는 아이스크림이 잘 팔려요.",
      "reading": "yeoreumcheore-neun aiseukeurimi jal pallyeoyo.",
      "translations": {
        "en": "Ice cream sells well in the summertime.",
        "ko": "여름철에는 아이스크림이 잘 팔려요.",
        "ipa": "yeoreumcheore-neun aiseukeurimi jal pallyeoyo.",
        "ar": "في فصل الصيف، تباع المثلجات جيدًا.",
        "cs": "V létě se zmrzlina dobře prodává.",
        "da": "Is sælger godt om sommeren.",
        "de": "Im Sommer verkauft sich Eis gut.",
        "el": "Το καλοκαίρι το παγωτό πουλιέται καλά.",
        "es": "En verano, el helado se vende bien.",
        "fi": "Jäätelöä myydään hyvin kesällä.",
        "fr": "En été, les glaces se vendent bien.",
        "he": "בקיץ גלידה נמכרת טוב.",
        "hi": "गर्मियों में आइसक्रीम अच्छी बिकती है।",
        "hu": "Nyáron jól fogy a fagylalt.",
        "id": "Di musim panas, es krim laku keras.",
        "it": "In estate il gelato si vende bene.",
        "ja": "夏はアイスクリームがよく売れます。",
        "nb": "Om sommeren selger is godt.",
        "nl": "In de zomer verkoopt ijs goed.",
        "pl": "Latem lody dobrze się sprzedają.",
        "pt": "No verão, o sorvete vende bem.",
        "ro": "Vara, înghețata se vinde bine.",
        "ru": "Летом мороженое хорошо продаётся.",
        "sv": "På sommaren säljer glass bra.",
        "tr": "Yazın dondurma iyi satar.",
        "uk": "Улітку морозиво добре продається.",
        "vi": "Vào mùa hè, kem bán rất chạy.",
        "yue": "夏天嘅雪糕好好賣。",
        "zh-Hans": "夏天冰淇淋很好卖。"
      },
