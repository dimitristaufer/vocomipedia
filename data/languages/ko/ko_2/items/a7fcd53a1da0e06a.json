  "sentences": [
    {
      "target": "그 말은 큰 깨달음을 줬어요.",
      "reading": "geu mareun keun kkaedareumeul jwosseoyo.",
      "translations": {
        "en": "That remark gave me a big realization.",
        "ko": "그 말은 큰 깨달음을 줬어요.",
        "ipa": "geu mareun keun kkaedareumeul jwosseoyo.",
        "ar": "تلك الكلمة منحتني إدراكًا كبيرًا.",
        "cs": "Ta poznámka mi přinesla velké uvědomění.",
        "da": "Den bemærkning gav mig en stor erkendelse.",
        "de": "Diese Bemerkung hat mir eine große Erkenntnis gebracht.",
        "el": "Αυτό το σχόλιο μου έδωσε μια μεγάλη συνειδητοποίηση.",
        "es": "Ese comentario me dio una gran revelación.",
        "fi": "Se huomautus sai minut oivaltamaan paljon.",
        "fr": "Cette remarque m’a beaucoup fait réaliser les choses.",
        "he": "ההערה הזאת עוררה בי תובנה גדולה.",
        "hi": "उस बात से मुझे बड़ी समझ मिली।",
        "hu": "Az a megjegyzés nagy felismerést adott nekem.",
        "id": "Ucapan itu memberi saya pemahaman besar.",
        "it": "Quella frase mi ha dato una grande intuizione.",
        "ja": "その言葉で大きな気づきを得ました。",
        "nb": "Den bemerkningen ga meg en stor erkjennelse.",
        "nl": "Die opmerking gaf me een groot inzicht.",
        "pl": "Ta uwaga dała mi wielkie olśnienie.",
        "pt": "Essa observação me deu uma grande percepção.",
        "ro": "Remarca aceea mi-a adus o mare revelație.",
        "ru": "Это замечание дало мне большое понимание.",
        "sv": "Den kommentaren gav mig en stor insikt.",
        "tr": "Bu söz bana büyük bir farkındalık verdi.",
        "uk": "Такий коментар дав мені велике усвідомлення.",
        "vi": "Lời đó đã cho tôi một sự nhận ra lớn.",
        "yue": "嗰句說話畀我一個好大嘅領悟。",
        "zh-Hans": "那句话让我有了很大的领悟。"
      },
