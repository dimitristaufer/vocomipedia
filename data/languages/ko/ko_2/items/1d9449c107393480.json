  "sentences": [
    {
      "target": "그 소식은 아직 믿어지지 않아요.",
      "reading": "geu sosigeun ajik mideojiji anayo.",
      "translations": {
        "en": "That news is still hard to believe.",
        "ko": "그 소식은 아직 믿어지지 않아요.",
        "ipa": "geu sosigeun ajik mideojiji anayo.",
        "ar": "ما زال الخبر غير قابل للتصديق.",
        "cs": "Ta zpráva se mi pořád nechce věřit.",
        "da": "Den nyhed er stadig svær at tro på.",
        "de": "Die Nachricht ist immer noch kaum zu glauben.",
        "el": "Η είδηση ακόμα δεν γίνεται να την πιστέψω.",
        "es": "Esa noticia todavía cuesta creerla.",
        "fi": "Sitä uutista on yhä vaikea uskoa.",
        "fr": "Cette nouvelle est encore difficile à croire.",
        "he": "עדיין קשה להאמין לחדשות האלה.",
        "hi": "वह खबर अभी भी यकीन करने लायक नहीं लगती।",
        "hu": "Ezt a hírt még mindig nehéz elhinni.",
        "id": "Berita itu masih sulit dipercaya.",
        "it": "Quella notizia è ancora difficile da credere.",
        "ja": "そのニュースはまだ信じられません。",
        "nb": "Den nyheten er fortsatt vanskelig å tro.",
        "nl": "Dat nieuws is nog steeds moeilijk te geloven.",
        "pl": "Wciąż trudno w to uwierzyć.",
        "pt": "Essa notícia ainda é difícil de acreditar.",
        "ro": "Vestea aceea încă e greu de crezut.",
        "ru": "Этой новости до сих пор трудно поверить.",
        "sv": "Den där nyheten är fortfarande svår att tro på.",
        "tr": "O habere hâlâ inanmak zor.",
        "uk": "У цю новину досі важко повірити.",
        "vi": "Tin đó vẫn khó tin.",
        "yue": "嗰個消息到而家都好難令人相信。",
        "zh-Hans": "那个消息到现在还很难相信。"
      },
