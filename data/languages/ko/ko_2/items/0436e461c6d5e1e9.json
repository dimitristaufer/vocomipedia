  "sentences": [
    {
      "target": "선생님의 칭찬에 기분이 좋아졌어요.",
      "reading": "Seonsaengnim-ui chingchan-e gibuni joajyeosseoyo.",
      "translations": {
        "en": "I felt better after the teacher's praise.",
        "ko": "선생님의 칭찬에 기분이 좋아졌어요.",
        "ipa": "Seonsaengnim-ui chingchan-e gibuni joajyeosseoyo.",
        "ar": "شعرتُ بتحسن بعد مديح المعلمة.",
        "cs": "Po pochvale od učitele mi bylo lépe.",
        "da": "Jeg fik det bedre efter lærerens ros.",
        "de": "Nach dem Lob der Lehrerin ging es mir besser.",
        "el": "Ένιωσα καλύτερα μετά τον έπαινο της δασκάλας.",
        "es": "Me sentí mejor después del elogio de la profesora.",
        "fi": "Olo parani opettajan kehujen jälkeen.",
        "fr": "Je me suis senti mieux après les compliments de la professeure.",
        "he": "הרגשתי יותר טוב אחרי השבחים של המורה.",
        "hi": "शिक्षक की तारीफ के बाद मेरा मन अच्छा हो गया।",
        "hu": "Jobban éreztem magam a tanárnő dicsérete után.",
        "id": "Saya merasa lebih baik setelah pujian dari guru.",
        "it": "Mi sono sentito meglio dopo il complimento dell'insegnante.",
        "ja": "先生にほめられて気分がよくなりました。",
        "nb": "Jeg følte meg bedre etter lærerens ros.",
        "nl": "Ik voelde me beter na het compliment van de leraar.",
        "pl": "Poczułem się lepiej po pochwale nauczycielki.",
        "pt": "Fiquei melhor depois do elogio da professora.",
        "ro": "M-am simțit mai bine după lauda profesoarei.",
        "ru": "Мне стало лучше после похвалы учителя.",
        "sv": "Jag mådde bättre efter lärarens beröm.",
        "tr": "Öğretmenin övgüsünden sonra kendimi daha iyi hissettim.",
        "uk": "Після похвали вчителя я почувався краще.",
        "vi": "Tôi thấy khá hơn sau lời khen của cô giáo.",
        "yue": "聽到老師讚我，我覺得好咗啲。",
        "zh-Hans": "听到老师的表扬后，我感觉好多了。"
      },
