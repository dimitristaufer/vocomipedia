  "sentences": [
    {
      "target": "선생님은 지각한 학생에게 벌을 줬어요.",
      "reading": "seonsaengnim-eun jigakhan haksaeng-ege beoreul jwosseoyo.",
      "translations": {
        "en": "The teacher gave the student punishment for being late.",
        "ko": "선생님은 지각한 학생에게 벌을 줬어요.",
        "ipa": "seonsaengnim-eun jigakhan haksaeng-ege beoreul jwosseoyo.",
        "ar": "أعطى المعلم الطالبَ عقابًا لأنه تأخر.",
        "cs": "Učitel dal studentovi trest za pozdní příchod.",
        "da": "Læreren gav eleven en straf, fordi han kom for sent.",
        "de": "Der Lehrer gab dem Schüler eine Strafe, weil er zu spät gekommen war.",
        "el": "Ο δάσκαλος έβαλε τιμωρία στον μαθητή επειδή άργησε.",
        "es": "El profesor castigó al estudiante por llegar tarde.",
        "fi": "Opettaja antoi oppilaalle rangaistuksen myöhästymisestä.",
        "fr": "Le professeur a puni l'élève parce qu'il était en retard.",
        "he": "המורה נתן לתלמיד עונש כי הוא איחר.",
        "hi": "शिक्षक ने देर से आने वाले छात्र को सज़ा दी।",
        "hu": "A tanár büntetést adott a diáknak, mert elkésett.",
        "id": "Guru memberi murid itu hukuman karena terlambat.",
        "it": "L'insegnante ha dato una punizione allo studente perché era in ritardo.",
        "ja": "先生は遅刻した生徒を罰しました。",
        "nb": "Læreren ga eleven en straff fordi han kom for sent.",
        "nl": "De leraar gaf de leerling straf omdat hij te laat kwam.",
        "pl": "Nauczyciel dał uczniowi karę za spóźnienie.",
        "pt": "O professor deu uma punição ao aluno por ter se atrasado.",
        "ro": "Profesorul i-a dat elevului o pedeapsă pentru că a întârziat.",
        "ru": "Учитель наказал ученика за опоздание.",
        "sv": "Läraren gav eleven ett straff för att hen kom för sent.",
        "tr": "Öğretmen, geç kalan öğrenciye ceza verdi.",
        "uk": "Учитель покарав учня за запізнення.",
        "vi": "Giáo viên phạt học sinh vì đến muộn.",
        "yue": "老師因為學生遲到而罰佢。",
        "zh-Hans": "老师因为学生迟到而罚了他。"
      },
