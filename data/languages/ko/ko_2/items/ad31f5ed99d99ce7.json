  "sentences": [
    {
      "target": "우리 두 사람의 공통 관심사는 영화예요.",
      "reading": "uri du saram-ui gongtong gwansimsa-neun yeonghwaye-yo.",
      "translations": {
        "en": "Our common interest is movies.",
        "ko": "우리 두 사람의 공통 관심사는 영화예요.",
        "ipa": "uri du saram-ui gongtong gwansimsa-neun yeonghwaye-yo.",
        "ar": "اهتمامنا المشترك نحن الاثنين هو الأفلام.",
        "cs": "Naším společným zájmem jsou filmy.",
        "da": "Vores fælles interesse er film.",
        "de": "Unser gemeinsames Interesse sind Filme.",
        "el": "Το κοινό ενδιαφέρον μας είναι οι ταινίες.",
        "es": "Nuestro interés común son las películas.",
        "fi": "Yhteinen kiinnostuksenkohteemme on elokuvat.",
        "fr": "Notre intérêt commun à tous les deux, ce sont les films.",
        "he": "העניין המשותף שלנו הוא סרטים.",
        "hi": "हम दोनों की साझा रुचि फ़िल्में हैं।",
        "hu": "Közös érdeklődésünk a filmek.",
        "id": "Minat bersama kami berdua adalah film.",
        "it": "Il nostro interesse comune è il cinema.",
        "ja": "私たち二人の共通の興味は映画です。",
        "nb": "Vår felles interesse er filmer.",
        "nl": "Onze gemeenschappelijke interesse is films.",
        "pl": "Naszym wspólnym zainteresowaniem są filmy.",
        "pt": "Nosso interesse comum são filmes.",
        "ro": "Interesul nostru comun este filmul.",
        "ru": "Наш общий интерес — фильмы.",
        "sv": "Vårt gemensamma intresse är filmer.",
        "tr": "İkimizin ortak ilgisi filmler.",
        "uk": "Наш спільний інтерес — фільми.",
        "vi": "Sở thích chung của hai chúng tôi là phim.",
        "yue": "我哋兩個嘅共同興趣係電影。",
        "zh-Hans": "我们两个人的共同兴趣是电影。"
      },
