    {
      "target": "우리 집은 시외에 있어요.",
      "reading": "uri jibeun sioee isseoyo.",
      "translations": {
        "en": "Our house is outside the city.",
        "ko": "우리 집은 시외에 있어요.",
        "ipa": "uri jibeun sioee isseoyo.",
        "ar": "بيتنا خارج المدينة.",
        "cs": "Náš dům je za městem.",
        "da": "Vores hus ligger uden for byen.",
        "de": "Unser Haus liegt außerhalb der Stadt.",
        "el": "Το σπίτι μας είναι έξω από την πόλη.",
        "es": "Nuestra casa está fuera de la ciudad.",
        "fi": "Meidän talomme on kaupungin ulkopuolella.",
