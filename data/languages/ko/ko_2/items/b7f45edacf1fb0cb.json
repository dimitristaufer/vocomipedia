  "sentences": [
    {
      "target": "문을 열자 고양이가 깜짝 나타났어요.",
      "reading": "mun-eul yeolja goyang-i-ga kkamjjak natanasseoyo.",
      "translations": {
        "en": "When I opened the door, a cat suddenly appeared.",
        "ko": "문을 열자 고양이가 깜짝 나타났어요.",
        "ipa": "mun-eul yeolja goyang-i-ga kkamjjak natanasseoyo.",
        "ar": "عندما فتحت الباب، ظهر قط فجأة.",
        "cs": "Když jsem otevřel dveře, najednou se objevila kočka.",
        "da": "Da jeg åbnede døren, dukkede en kat pludselig op.",
        "de": "Als ich die Tür öffnete, tauchte plötzlich eine Katze auf.",
        "el": "Όταν άνοιξα την πόρτα, εμφανίστηκε ξαφνικά μια γάτα.",
        "es": "Cuando abrí la puerta, apareció un gato de repente.",
        "fi": "Kun avasin oven, kissa ilmestyi yhtäkkiä.",
        "fr": "Quand j'ai ouvert la porte, un chat est apparu soudainement.",
        "he": "כשפתחתי את הדלת, חתול הופיע פתאום.",
        "hi": "जब मैंने दरवाज़ा खोला, तो एक बिल्ली अचानक दिखाई दी।",
        "hu": "Amikor kinyitottam az ajtót, hirtelen megjelent egy macska.",
        "id": "Saat saya membuka pintu, seekor kucing tiba-tiba muncul.",
        "it": "Quando ho aperto la porta, è apparsa all'improvviso una gatta.",
        "ja": "ドアを開けると、猫が急に現れました。",
        "nb": "Da jeg åpnet døren, dukket det plutselig opp en katt.",
        "nl": "Toen ik de deur opende, verscheen er plotseling een kat.",
        "pl": "Kiedy otworzyłem drzwi, nagle pojawił się kot.",
        "pt": "Quando abri a porta, um gato apareceu de repente.",
        "ro": "Când am deschis ușa, a apărut brusc o pisică.",
        "ru": "Когда я открыл дверь, вдруг появился кот.",
        "sv": "När jag öppnade dörren dök en katt plötsligt upp.",
        "tr": "Kapıyı açınca bir kedi aniden ortaya çıktı.",
        "uk": "Коли я відчинив двері, раптом з'явився кіт.",
        "vi": "Khi tôi mở cửa, một con mèo bất ngờ xuất hiện.",
        "yue": "我一開門，隻貓突然出現咗。",
        "zh-Hans": "我一开门，猫突然出现了。"
      },
