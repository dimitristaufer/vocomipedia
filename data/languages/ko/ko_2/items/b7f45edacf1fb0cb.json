    {
      "target": "아이가 선물을 보고 깜짝 놀랐어요.",
      "reading": "ai-ga seonmul-eul bogo kkamjjak nallasseoyo.",
      "translations": {
        "en": "The child was surprised to see the present.",
        "ko": "아이가 선물을 보고 깜짝 놀랐어요.",
        "ipa": "ai-ga seonmul-eul bogo kkamjjak nallasseoyo.",
        "ar": "تفاجأ الطفل عندما رأى الهدية.",
        "cs": "Dítě bylo překvapené, když uvidělo dárek.",
        "da": "Barnet blev overrasket over at se gaven.",
        "de": "Das Kind war überrascht, als es das Geschenk sah.",
        "el": "Το παιδί απόρησε όταν είδε το δώρο.",
        "es": "El niño se sorprendió al ver el regalo.",
        "fi": "Lapsi yllättyi nähdessään lahjan.",
        "fr": "L'enfant a été surpris de voir le cadeau.",
        "he": "הילד הופתע כשראה את המתנה.",
        "hi": "बच्चा तोहफ़ा देखकर चौंक गया।",
        "hu": "A gyerek meglepődött, amikor meglátta az ajándékot.",
        "id": "Anak itu terkejut melihat hadiah itu.",
        "it": "Il bambino è rimasto sorpreso nel vedere il regalo.",
        "ja": "子どもはプレゼントを見てびっくりしました。",
        "nb": "Barnet ble overrasket da det så gaven.",
        "nl": "Het kind was verrast toen het het cadeau zag.",
        "pl": "Dziecko bardzo się zdziwiło, gdy zobaczyło prezent.",
        "pt": "A criança ficou surpresa ao ver o presente.",
        "ro": "Copilul s-a mirat când a văzut cadoul.",
        "ru": "Ребёнок удивился, увидев подарок.",
        "sv": "Barnet blev överraskat när det såg paketet.",
        "tr": "Çocuk hediyeyi görünce çok şaşırdı.",
        "uk": "Дитина здивувалася, коли побачила подарунок.",
        "vi": "Đứa trẻ đã rất ngạc nhiên khi thấy món quà.",
        "yue": "個小朋友見到份禮物，好驚喜。",
        "zh-Hans": "孩子看到礼物时很惊喜。"
      },
