    {
      "target": "친구가 뒤에서 깜짝 나타났어요.",
      "reading": "chingu-ga dwieseo kkamjjak natanasseoyo.",
      "translations": {
        "en": "My friend suddenly appeared from behind.",
        "ko": "친구가 뒤에서 깜짝 나타났어요.",
        "ipa": "chingu-ga dwieseo kkamjjak natanasseoyo.",
        "ar": "ظهر صديقي من الخلف فجأة.",
        "cs": "Můj přítel se najednou objevil zezadu.",
        "da": "Min ven dukkede pludselig op bagfra.",
        "de": "Mein Freund tauchte plötzlich von hinten auf.",
        "el": "Ο φίλος μου εμφανίστηκε ξαφνικά από πίσω.",
        "es": "Mi amigo apareció de repente por detrás.",
        "fi": "Ystäväni ilmestyi yhtäkkiä takaa.",
        "fr": "Mon ami est apparu soudainement derrière moi.",
        "he": "החבר שלי הופיע פתאום מאחור.",
        "hi": "मेरा दोस्त अचानक पीछे से आ गया।",
        "hu": "A barátom hirtelen hátulról bukkant fel.",
        "id": "Teman saya tiba-tiba muncul dari belakang.",
        "it": "Il mio amico è apparso all'improvviso da dietro.",
        "ja": "友だちが後ろから急に現れました。",
        "nb": "Vennen min dukket plutselig opp bakfra.",
        "nl": "Mijn vriend verscheen plotseling van achteren.",
        "pl": "Mój przyjaciel nagle pojawił się zza pleców.",
        "pt": "Meu amigo apareceu de repente por trás.",
        "ro": "Prietenul meu a apărut brusc din spate.",
        "ru": "Мой друг вдруг появился сзади.",
        "sv": "Min vän dök plötsligt upp bakom mig.",
        "tr": "Arkadaşım arkadan aniden ortaya çıktı.",
        "uk": "Мій друг раптом з'явився ззаду.",
        "vi": "Bạn tôi bất ngờ xuất hiện từ phía sau.",
        "yue": "我朋友喺後面突然出現。",
        "zh-Hans": "我的朋友突然从后面出现了。"
      },
