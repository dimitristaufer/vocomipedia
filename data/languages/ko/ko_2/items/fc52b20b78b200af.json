  "sentences": [
    {
      "target": "화재가 나서 사람들이 밖으로 나왔어요.",
      "reading": "hwajaega naseo saramdeuri bakk-euro nawasseoyo.",
      "translations": {
        "en": "A fire broke out, and people came outside.",
        "ko": "화재가 나서 사람들이 밖으로 나왔어요.",
        "ipa": "hwajaega naseo saramdeuri bakk-euro nawasseoyo.",
        "ar": "اندلع حريق، وخرج الناس إلى الخارج.",
        "cs": "Vypukl požár a lidé vyšli ven.",
        "da": "Der opstod brand, og folk kom ud.",
        "de": "Es brach ein Feuer aus, und die Leute kamen nach draußen.",
        "el": "Ξέσπασε φωτιά και οι άνθρωποι βγήκαν έξω.",
        "es": "Se desató un incendio y la gente salió afuera.",
        "fi": "Tulipalo syttyi, ja ihmiset tulivat ulos.",
        "fr": "Un incendie s'est déclaré et les gens sont sortis.",
        "he": "פרצה שריפה והאנשים יצאו החוצה.",
        "hi": "आग लग गई, और लोग बाहर आ गए।",
        "hu": "Tűz ütött ki, és az emberek kijöttek az utcára.",
        "id": "Kebakaran terjadi, dan orang-orang keluar.",
        "it": "È scoppiato un incendio e la gente è uscita fuori.",
        "ja": "火事が起きて、人々は外に出ました。",
        "nb": "Det brøt ut brann, og folk kom ut.",
        "nl": "Er brak brand uit en de mensen kwamen naar buiten.",
        "pl": "Wybuchł pożar i ludzie wyszli na zewnątrz.",
        "pt": "Houve um incêndio e as pessoas saíram para fora.",
        "ro": "A izbucnit un incendiu și oamenii au ieșit afară.",
        "ru": "Произошёл пожар, и люди вышли на улицу.",
        "sv": "Det bröt ut en brand, och folk kom ut.",
        "tr": "Bir yangın çıktı ve insanlar dışarı çıktı.",
        "uk": "Сталася пожежа, і люди вийшли надвір.",
        "vi": "Đã xảy ra hỏa hoạn, và mọi người đi ra ngoài.",
        "yue": "發生咗火警，啲人走咗出去。",
        "zh-Hans": "着火了，人们都到外面来了。"
      },
