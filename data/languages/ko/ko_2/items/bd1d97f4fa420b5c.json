  "sentences": [
    {
      "target": "회의 내용은 대강 이해했어요.",
      "reading": "hoeui naeyongeun daegang ihaehaesseoyo.",
      "translations": {
        "en": "I roughly understood the meeting.",
        "ko": "회의 내용은 대강 이해했어요.",
        "ipa": "hoeui naeyongeun daegang ihaehaesseoyo.",
        "ar": "فهمتُ محتوى الاجتماع تقريبًا.",
        "cs": "Obsah schůzky jsem pochopil přibližně.",
        "da": "Jeg forstod mødet nogenlunde.",
        "de": "Ich habe den Inhalt des Meetings ungefähr verstanden.",
        "el": "Κατάλαβα περίπου το περιεχόμενο της συνάντησης.",
        "es": "Entendí más o menos lo de la reunión.",
        "fi": "Ymmärsin kokouksen sisällön suunnilleen.",
        "fr": "J’ai compris à peu près le contenu de la réunion.",
        "he": "הבנתי בערך את תוכן הפגישה.",
        "hi": "मैंने बैठक की बात लगभग समझ ली।",
        "hu": "Nagyjából megértettem az értekezletet.",
        "id": "Saya agak mengerti isi rapat itu.",
        "it": "Ho capito più o meno il contenuto della riunione.",
        "ja": "会議の内容はだいたいわかりました。",
        "nb": "Jeg forstod møtet sånn omtrent.",
        "nl": "Ik begreep de vergadering ongeveer.",
        "pl": "Mniej więcej zrozumiałem spotkanie.",
        "pt": "Entendi mais ou menos a reunião.",
        "ro": "Am înțeles cam despre ce a fost ședința.",
        "ru": "Я примерно понял, о чём было собрание.",
        "sv": "Jag förstod mötet ungefär.",
        "tr": "Toplantıyı kabaca anladım.",
        "uk": "Я приблизно зрозумів зміст наради.",
        "vi": "Tôi đã hiểu sơ sơ nội dung buổi họp.",
        "yue": "我大概明白咗會議內容。",
        "zh-Hans": "我大概明白了会议内容。"
      },
