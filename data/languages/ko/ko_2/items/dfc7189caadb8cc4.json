  "sentences": [
    {
      "target": "숙제를 소홀히 하면 선생님께 혼나요.",
      "reading": "sukjereul soholhi hamyeon seonsaengnimkke honnayo.",
      "translations": {
        "en": "If you neglect your homework, the teacher will scold you.",
        "ko": "숙제를 소홀히 하면 선생님께 혼나요.",
        "ipa": "sukjereul soholhi hamyeon seonsaengnimkke honnayo.",
        "ar": "إذا أهملت واجبك المنزلي، فسيوبخك المعلم.",
        "cs": "Když zanedbáš domácí úkol, učitel tě pokárá.",
        "da": "Hvis du forsømmer dit lektiearbejde, skælder læreren dig ud.",
        "de": "Wenn du deine Hausaufgaben vernachlässigst, schimpft der Lehrer mit dir.",
        "el": "Αν αμελήσεις τις εργασίες για το σπίτι, ο δάσκαλος θα σε μαλώσει.",
        "es": "Si descuidas los deberes, el profesor te regañará.",
        "fi": "Jos laiminlyöt läksysi, opettaja toruu sinua.",
        "fr": "Si tu négliges tes devoirs, le professeur va te gronder.",
        "he": "אם תזניח את שיעורי הבית, המורה יכעס עליך.",
        "hi": "अगर तुम अपना होमवर्क लापरवाही से करोगे, तो शिक्षक तुम्हें डाँटेंगे।",
        "hu": "Ha hanyagul kezeled a házi feladatot, a tanár le fog szidni.",
        "id": "Kalau kamu mengabaikan PR, guru akan memarahi kamu.",
        "it": "Se trascuri i compiti, l'insegnante ti rimprovererà.",
        "ja": "宿題をおろそかにすると、先生に叱られます。",
        "nb": "Hvis du forsømmer leksene dine, får du kjeft av læreren.",
        "nl": "Als je je huiswerk verwaarloost, krijg je van de leraar op je kop.",
        "pl": "Jeśli zaniedbasz pracę domową, nauczyciel cię skarci.",
        "pt": "Se você descuidar da lição de casa, o professor vai brigar com você.",
        "ro": "Dacă îți neglijezi temele, profesorul te va certa.",
        "ru": "Если ты небрежно относишься к домашнему заданию, учитель тебя отругает.",
        "sv": "Om du slarvar med läxorna får du skäll av läraren.",
        "tr": "Ödevlerini ihmal edersen öğretmen sana kızar.",
        "uk": "Якщо ти занедбаєш домашнє завдання, учитель тебе сваритиме.",
        "vi": "Nếu bạn sao nhãng bài tập về nhà, thầy giáo sẽ mắng bạn.",
        "yue": "如果你唔理功課，老師會鬧你。",
        "zh-Hans": "如果你不认真对待作业，老师会批评你。"
      },
