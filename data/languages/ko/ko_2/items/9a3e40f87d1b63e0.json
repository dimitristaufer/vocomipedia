  "sentences": [
    {
      "target": "밤에 혼자 있으면 귀신이 무서워요.",
      "reading": "bame honja isseumyeon gwisin-i museowoyo.",
      "translations": {
        "en": "I get scared of ghosts when I'm alone at night.",
        "ko": "밤에 혼자 있으면 귀신이 무서워요.",
        "ipa": "bame honja isseumyeon gwisin-i museowoyo.",
        "ar": "أخاف من الأشباح عندما أكون وحدي في الليل.",
        "cs": "Když jsem v noci sám, bojím se duchů.",
        "da": "Jeg bliver bange for spøgelser, når jeg er alene om natten.",
        "de": "Ich habe Angst vor Geistern, wenn ich nachts allein bin.",
        "el": "Φοβάμαι τα φαντάσματα όταν είμαι μόνος τη νύχτα.",
        "es": "Me asusto de los fantasmas cuando estoy solo por la noche.",
        "fi": "Pelkään kummituksia, kun olen yksin yöllä.",
        "fr": "J'ai peur des fantômes quand je suis seul la nuit.",
        "he": "אני מפחד מרוחות כשאני לבד בלילה.",
        "hi": "रात में अकेले होने पर मुझे भूतों से डर लगता है।",
        "hu": "Félek a szellemektől, amikor éjszaka egyedül vagyok.",
        "id": "Saya takut hantu saat sendirian di malam hari.",
        "it": "Ho paura dei fantasmi quando sono solo di notte.",
        "ja": "夜に一人だとお化けが怖いです。",
        "nb": "Jeg blir redd for spøkelser når jeg er alene om natten.",
        "nl": "Ik ben bang voor spoken als ik 's nachts alleen ben.",
        "pl": "Boję się duchów, kiedy jestem sam w nocy.",
        "pt": "Fico com medo de fantasmas quando estou sozinho à noite.",
        "ro": "Mă sperii de fantome când sunt singur noaptea.",
        "ru": "Мне страшно от привидений, когда я один ночью.",
        "sv": "Jag blir rädd för spöken när jag är ensam på natten.",
        "tr": "Gece yalnız olunca hayaletlerden korkarım.",
        "uk": "Мені страшно через привидів, коли я вночі сам.",
        "vi": "Tôi sợ ma khi ở một mình vào ban đêm.",
        "yue": "夜晚我一個人嘅時候會驚鬼。",
        "zh-Hans": "我晚上一个人时会怕鬼。"
      },
