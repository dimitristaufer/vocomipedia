  "sentences": [
    {
      "target": "오늘은 체육관에서 농구를 해요.",
      "reading": "Oneureun cheyukgwaneseo nonggureul haeyo.",
      "translations": {
        "en": "Today we’re playing basketball in the gym.",
        "ko": "오늘은 체육관에서 농구를 해요.",
        "ipa": "Oneureun cheyukgwaneseo nonggureul haeyo.",
        "ar": "نلعب كرة السلة اليوم في الصالة الرياضية.",
        "cs": "Dnes hrajeme v tělocvičně basketbal.",
        "da": "I dag spiller vi basketball i gymnastiksalen.",
        "de": "Heute spielen wir in der Turnhalle Basketball.",
        "el": "Σήμερα παίζουμε μπάσκετ στο γυμναστήριο.",
        "es": "Hoy jugamos baloncesto en el gimnasio.",
        "fi": "Pelaamme tänään koripalloa liikuntasalissa.",
        "fr": "Aujourd’hui, nous jouons au basket dans le gymnase.",
        "he": "היום אנחנו משחקים כדורסל באולם הספורט.",
        "hi": "आज हम जिम में बास्केटबॉल खेल रहे हैं।",
        "hu": "Ma a tornateremben kosárlabdázunk.",
        "id": "Hari ini kami bermain basket di gedung olahraga.",
        "it": "Oggi giochiamo a basket in palestra.",
        "ja": "今日は体育館でバスケットボールをします。",
        "nb": "I dag spiller vi basketball i gymsalen.",
        "nl": "Vandaag spelen we basketbal in de gymzaal.",
        "pl": "Dzisiaj gramy w koszykówkę w sali gimnastycznej.",
        "pt": "Hoje vamos jogar basquete no ginásio.",
        "ro": "Astăzi jucăm baschet în sala de sport.",
        "ru": "Сегодня мы играем в баскетбол в спортзале.",
        "sv": "I dag spelar vi basket i gympasalen.",
        "tr": "Bugün spor salonunda basketbol oynuyoruz.",
        "uk": "Сьогодні ми граємо в баскетбол у спортзалі.",
        "vi": "Hôm nay chúng tôi chơi bóng rổ trong nhà thi đấu.",
        "yue": "今日我哋喺體育館打籃球。",
        "zh-Hans": "今天我们在体育馆打篮球。"
      },
