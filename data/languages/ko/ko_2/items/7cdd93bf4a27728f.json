  "sentences": [
    {
      "target": "죄송할 때는 고개를 숙여요.",
      "reading": "joesonghal ttaeneun gogaereul sugyeoyo.",
      "translations": {
        "en": "I lower my head when I apologize.",
        "ko": "죄송할 때는 고개를 숙여요.",
        "ipa": "joesonghal ttaeneun gogaereul sugyeoyo.",
        "ar": "أخفض رأسي عندما أعتذر.",
        "cs": "Když se omlouvám, skloním hlavu.",
        "da": "Jeg sænker hovedet, når jeg undskylder.",
        "de": "Ich senke den Kopf, wenn ich mich entschuldige.",
        "el": "Κατεβάζω το κεφάλι μου όταν ζητάω συγγνώμη.",
        "es": "Bajo la cabeza cuando me disculpo.",
        "fi": "Lasken pääni, kun pyydän anteeksi.",
        "fr": "Je baisse la tête quand je m'excuse.",
        "he": "אני מוריד את הראש כשאני מתנצל.",
        "hi": "मैं माफ़ी माँगते समय सिर झुका लेता हूँ।",
        "hu": "Lehajtom a fejem, amikor bocsánatot kérek.",
        "id": "Saya menundukkan kepala saat meminta maaf.",
        "it": "Abbasso la testa quando mi scuso.",
        "ja": "謝るときは頭を下げます。",
        "nb": "Jeg senker hodet når jeg sier unnskyld.",
        "nl": "Ik buig mijn hoofd als ik me verontschuldig.",
        "pl": "Pochylam głowę, kiedy przepraszam.",
        "pt": "Eu abaixo a cabeça quando peço desculpas.",
        "ro": "Îmi plec capul când îmi cer scuze.",
        "ru": "Я опускаю голову, когда извиняюсь.",
        "sv": "Jag sänker huvudet när jag ber om ursäkt.",
        "tr": "Özür dilerken başımı eğiyorum.",
        "uk": "Я схиляю голову, коли перепрошую.",
        "vi": "Tôi cúi đầu khi xin lỗi.",
        "yue": "我道歉嗰陣會低頭。",
        "zh-Hans": "我道歉的时候会低头。"
      },
