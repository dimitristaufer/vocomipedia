  "sentences": [
    {
      "target": "한여름에는 아이스크림이 금방 녹아요.",
      "reading": "hanyeoreume-neun aiseukeurimi geumbang nogayo.",
      "translations": {
        "en": "In midsummer, ice cream melts quickly.",
        "ko": "한여름에는 아이스크림이 금방 녹아요.",
        "ipa": "hanyeoreume-neun aiseukeurimi geumbang nogayo.",
        "ar": "في ذروة الصيف، يذوب الآيس كريم بسرعة.",
        "cs": "Uprostřed léta se zmrzlina rychle rozpouští.",
        "da": "Midt om sommeren smelter is hurtigt.",
        "de": "Mitten im Sommer schmilzt Eis schnell.",
        "el": "Στην καρδιά του καλοκαιριού, το παγωτό λιώνει γρήγορα.",
        "es": "En pleno verano, el helado se derrite rápido.",
        "fi": "Kesän keskellä jäätelö sulaa nopeasti.",
        "fr": "Au cœur de l'été, la glace fond vite.",
        "he": "באמצע הקיץ הגלידה נמסה מהר.",
        "hi": "गर्मी के बीच में आइसक्रीम जल्दी पिघल जाती है।",
        "hu": "Nyár közepén a fagylalt gyorsan elolvad.",
        "id": "Di tengah musim panas, es krim cepat meleleh.",
        "it": "Nel pieno dell'estate, il gelato si scioglie in fretta.",
        "ja": "真夏はアイスクリームがすぐに溶けます。",
        "nb": "Midt på sommeren smelter iskrem fort.",
        "nl": "Midden in de zomer smelt ijs snel.",
        "pl": "W środku lata lody szybko się topią.",
        "pt": "No auge do verão, o sorvete derrete rápido.",
        "ro": "În toiul verii, înghețata se topește repede.",
        "ru": "В разгар лета мороженое быстро тает.",
        "sv": "Mitt i sommaren smälter glass snabbt.",
        "tr": "Yaz ortasında dondurma çabuk erir.",
        "uk": "У розпал літа морозиво швидко тане.",
        "vi": "Giữa mùa hè, kem tan nhanh lắm.",
        "yue": "盛夏時雪糕好快溶。",
        "zh-Hans": "盛夏时冰淇淋很快就融化。"
      },
