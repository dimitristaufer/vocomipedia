    {
      "target": "이 상은 선생님께 바칩니다.",
      "reading": "i sang-eun seonsaengnimkke bachimnida.",
      "translations": {
        "en": "I dedicate this award to my teacher.",
        "ko": "이 상은 선생님께 바칩니다.",
        "ipa": "i sang-eun seonsaengnimkke bachimnida.",
        "ar": "أهدي هذه الجائزة إلى معلمي.",
        "cs": "Toto ocenění věnuji svému učiteli.",
        "da": "Denne pris dedikerer jeg til min lærer.",
        "de": "Ich widme diese Auszeichnung meinem Lehrer.",
        "el": "Αφιερώνω αυτό το βραβείο στον δάσκαλό μου.",
        "es": "Dedico este premio a mi profesor.",
        "fi": "Omistan tämän palkinnon opettajalleni.",
        "fr": "Je dédie ce prix à mon professeur.",
        "he": "אני מקדיש את הפרס הזה למורה שלי.",
        "hi": "मैं यह पुरस्कार अपने शिक्षक को समर्पित करता हूँ।",
        "hu": "Ezt a díjat a tanáromnak ajánlom.",
        "id": "Saya mendedikasikan penghargaan ini untuk guru saya.",
        "it": "Dedico questo premio al mio insegnante.",
        "ja": "この賞を先生にささげます。",
        "nb": "Jeg vier denne prisen til læreren min.",
        "nl": "Ik draag deze prijs op aan mijn leraar.",
        "pl": "Dedykę tę nagrodę mojemu nauczycielowi.",
        "pt": "Dedico este prêmio ao meu professor.",
        "ro": "Dedic acest premiu profesorului meu.",
        "ru": "Я посвящаю эту награду своему учителю.",
        "sv": "Jag tillägnar det här priset min lärare.",
        "tr": "Bu ödülü öğretmenime adıyorum.",
        "uk": "Я присвячую цю нагороду своєму вчителю.",
        "vi": "Tôi dành giải thưởng này cho thầy của tôi.",
        "yue": "呢個獎我要獻畀老師。",
        "zh-Hans": "这个奖我要献给老师。"
      },
