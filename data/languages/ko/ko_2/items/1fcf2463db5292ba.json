    {
      "target": "어머니께 꽃을 바쳤어요.",
      "reading": "eomeonikke kkot-eul bachyeosseoyo.",
      "translations": {
        "en": "I offered flowers to my mother.",
        "ko": "어머니께 꽃을 바쳤어요.",
        "ipa": "eomeonikke kkot-eul bachyeosseoyo.",
        "ar": "قدمتُ الزهور لأمي.",
        "cs": "Darovala jsem mamince květiny.",
        "da": "Jeg gav min mor blomster.",
        "de": "Ich habe meiner Mutter Blumen dargebracht.",
        "el": "Προσέφερα λουλούδια στη μητέρα μου.",
        "es": "Le ofrecí flores a mi madre.",
        "fi": "Annoin äidilleni kukkia.",
        "fr": "J’ai offert des fleurs à ma mère.",
        "he": "נתתי לאמא שלי פרחים.",
        "hi": "मैंने अपनी माँ को फूल चढ़ाए।",
        "hu": "Virágot vittem az anyámnak.",
        "id": "Saya mempersembahkan bunga kepada ibu saya.",
        "it": "Ho offerto dei fiori a mia madre.",
        "ja": "母に花をささげました。",
        "nb": "Jeg ga blomster til moren min.",
        "nl": "Ik bood bloemen aan mijn moeder aan.",
        "pl": "Podarowałam kwiaty mojej mamie.",
        "pt": "Ofereci flores à minha mãe.",
        "ro": "I-am oferit flori mamei mele.",
        "ru": "Я преподнесла цветы своей маме.",
        "sv": "Jag gav min mamma blommor.",
        "tr": "Anneme çiçekler sundum.",
        "uk": "Я подарувала мамі квіти.",
        "vi": "Tôi dâng hoa cho mẹ.",
        "yue": "我向媽媽獻咗花。",
        "zh-Hans": "我给妈妈献了花。"
      },
