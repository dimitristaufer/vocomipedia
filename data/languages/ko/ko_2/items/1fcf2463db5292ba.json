    {
      "target": "그는 연구에 평생을 바쳤어요.",
      "reading": "geuneun yeongu-e pyeongsaengeul bachyeosseoyo.",
      "translations": {
        "en": "He devoted his whole life to research.",
        "ko": "그는 연구에 평생을 바쳤어요.",
        "ipa": "geuneun yeongu-e pyeongsaengeul bachyeosseoyo.",
        "ar": "كرّس حياته كلها للبحث.",
        "cs": "Věnoval celý svůj život výzkumu.",
        "da": "Han viet hele sit liv til forskning.",
        "de": "Er hat sein ganzes Leben der Forschung gewidmet.",
        "el": "Αφιέρωσε όλη του τη ζωή στην έρευνα.",
        "es": "Dedicó toda su vida a la investigación.",
        "fi": "Hän omisti koko elämänsä tutkimukselle.",
        "fr": "Il a consacré toute sa vie à la recherche.",
        "he": "הוא הקדיש את כל חייו למחקר.",
        "hi": "उसने अपना पूरा जीवन शोध को समर्पित कर दिया।",
        "hu": "Egész életét a kutatásnak szentelte.",
        "id": "Dia mendedikasikan seluruh hidupnya untuk penelitian.",
        "it": "Ha dedicato tutta la sua vita alla ricerca.",
        "ja": "彼は人生を研究にささげました。",
        "nb": "Han viet hele livet sitt til forskning.",
        "nl": "Hij wijdde zijn hele leven aan onderzoek.",
        "pl": "Poświęcił całe swoje życie badaniom.",
        "pt": "Ele dedicou a vida inteira à pesquisa.",
        "ro": "Și-a dedicat toată viața cercetării.",
        "ru": "Он посвятил всю свою жизнь исследованиям.",
        "sv": "Han ägnade hela sitt liv åt forskning.",
        "tr": "Tüm hayatını araştırmaya adadı.",
        "uk": "Він присвятив усе своє життя дослідженням.",
        "vi": "Anh ấy đã cống hiến cả đời cho nghiên cứu.",
        "yue": "佢將一生都奉獻畀研究。",
        "zh-Hans": "他把一生都献给了研究。"
      },
