    {
      "target": "엄마가 오늘 저를 칭찬하셨어요.",
      "reading": "eommaga oneul jeoreul chingchanhasyeosseoyo.",
      "translations": {
        "en": "My mom praised me today.",
        "ko": "엄마가 오늘 저를 칭찬하셨어요.",
        "ipa": "eommaga oneul jeoreul chingchanhasyeosseoyo.",
        "ar": "أشادت بي أمي اليوم.",
        "cs": "Maminka mě dnes pochválila.",
        "da": "Min mor roste mig i dag.",
        "de": "Meine Mutter hat mich heute gelobt.",
        "el": "Η μαμά με επαίνεσε σήμερα.",
        "es": "Mi mamá me elogió hoy.",
        "fi": "Äiti kehui minua tänään.",
        "fr": "Ma mère m'a félicité aujourd'hui.",
        "he": "אמא שלי שיבחה אותי היום.",
        "hi": "माँ ने आज मेरी प्रशंसा की।",
        "hu": "Anyukám ma megdicsért.",
        "id": "Ibu saya memuji saya hari ini.",
        "it": "Mia madre mi ha lodato oggi.",
        "ja": "母が今日私をほめてくれました。",
        "nb": "Mamma roste meg i dag.",
        "nl": "Mijn moeder prees me vandaag.",
        "pl": "Mama pochwaliła mnie dzisiaj.",
        "pt": "Minha mãe me elogiou hoje.",
        "ro": "Mama m-a lăudat azi.",
        "ru": "Мама похвалила меня сегодня.",
        "sv": "Mamma berömde mig i dag.",
        "tr": "Annem bugün beni övdü.",
        "uk": "Мама похвалила мене сьогодні.",
        "vi": "Mẹ tôi khen tôi hôm nay.",
        "yue": "媽媽今日讚咗我。",
        "zh-Hans": "妈妈今天表扬了我。"
