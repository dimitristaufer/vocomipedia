    {
      "target": "선생님이 제 발표를 칭찬하셨어요.",
      "reading": "seonsaengnimi je balpyoreul chingchanhasyeosseoyo.",
      "translations": {
        "en": "The teacher praised my presentation.",
        "ko": "선생님이 제 발표를 칭찬하셨어요.",
        "ipa": "seonsaengnimi je balpyoreul chingchanhasyeosseoyo.",
        "ar": "أشاد المعلم بعرضي.",
        "cs": "Učitel pochválil moji prezentaci.",
        "da": "Læreren roste min fremlæggelse.",
        "de": "Der Lehrer lobte meine Präsentation.",
        "el": "Ο δάσκαλος επαίνεσε την παρουσίασή μου.",
        "es": "El profesor elogió mi presentación.",
        "fi": "Opettaja kehui esitystäni.",
        "fr": "Le professeur a félicité ma présentation.",
        "he": "המורה שיבח את המצגת שלי.",
        "hi": "शिक्षक ने मेरी प्रस्तुति की प्रशंसा की।",
        "hu": "A tanár megdicsérte az előadásomat.",
        "id": "Guru memuji presentasi saya.",
        "it": "L'insegnante ha lodato la mia presentazione.",
        "ja": "先生が私の発表をほめてくれました。",
        "nb": "Læreren roste presentasjonen min.",
        "nl": "De leraar prees mijn presentatie.",
        "pl": "Nauczyciel pochwalił moją prezentację.",
        "pt": "O professor elogiou a minha apresentação.",
        "ro": "Profesorul mi-a lăudat prezentarea.",
        "ru": "Учитель похвалил мою презентацию.",
        "sv": "Läraren berömde min presentation.",
        "tr": "Öğretmen sunumumu övdü.",
        "uk": "Учитель похвалив мою презентацію.",
        "vi": "Giáo viên khen bài thuyết trình của tôi.",
        "yue": "老師讚咗我嘅報告。",
        "zh-Hans": "老师表扬了我的演讲。"
      },
