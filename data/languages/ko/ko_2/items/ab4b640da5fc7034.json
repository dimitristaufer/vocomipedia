  "sentences": [
    {
      "target": "그는 피곤하다는 핑계로 약속을 미뤘어요.",
      "reading": "Geuneun pigonhadaneun pinggyero yaksokeul mireoesseoyo.",
      "translations": {
        "en": "He postponed the appointment as an excuse that he was tired.",
        "ko": "그는 피곤하다는 핑계로 약속을 미뤘어요.",
        "ipa": "Geuneun pigonhadaneun pinggyero yaksokeul mireoesseoyo.",
        "ar": "أجَّل الموعد بحجة أنه متعب.",
        "cs": "Odložil schůzku s tím, že je unavený.",
        "da": "Han udsatte aftalen med den undskyldning, at han var træt.",
        "de": "Er verschob den Termin mit der Ausrede, dass er müde sei.",
        "el": "Ανέβαλε το ραντεβού με τη δικαιολογία ότι ήταν κουρασμένος.",
        "es": "Pospuso la cita con la excusa de que estaba cansado.",
        "fi": "Hän siirsi tapaamista sillä verukkeella, että oli väsynyt.",
        "fr": "Il a reporté le rendez-vous sous prétexte qu’il était fatigué.",
        "he": "הוא דחה את הפגישה בתירוץ שהוא עייף.",
        "hi": "उसने थकान का बहाना बनाकर मुलाकात टाल दी।",
        "hu": "Azt az ürügyet hozta fel, hogy fáradt, és elhalasztotta a találkozót.",
        "id": "Dia menunda janji itu dengan alasan dia lelah.",
        "it": "Ha rimandato l'appuntamento con la scusa di essere stanco.",
        "ja": "彼は疲れているという言い訳で約束を延期した。",
        "nb": "Han utsatte avtalen med unnskyldningen om at han var trøtt.",
        "nl": "Hij stelde de afspraak uit als excuus dat hij moe was.",
        "pl": "Przełożył spotkanie, tłumacząc się tym, że jest zmęczony.",
        "pt": "Ele adiou o compromisso com a desculpa de que estava cansado.",
        "ro": "A amânat întâlnirea pe motiv că era obosit.",
        "ru": "Он отложил встречу под предлогом, что устал.",
        "sv": "Han sköt upp mötet med ursäkten att han var trött.",
        "tr": "Yorgun olduğunu bahane ederek randevuyu erteledi.",
        "uk": "Він відкладав зустріч під приводом того, що втомився.",
        "vi": "Anh ấy hoãn cuộc hẹn với lý do là anh ấy mệt.",
        "yue": "佢以攰做藉口，將約會延期。",
        "zh-Hans": "他以自己累为借口，把约会推迟了。"
      },
