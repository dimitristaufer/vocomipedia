    {
      "target": "공사는 밤에는 중단합니다.",
      "reading": "gongsaneun bameneun jungdanhamnida.",
      "translations": {
        "en": "Construction stops at night.",
        "ko": "공사는 밤에는 중단합니다.",
        "ipa": "gongsaneun bameneun jungdanhamnida.",
        "ar": "يتوقف العمل في الليل.",
        "cs": "Stavba se v noci zastavuje.",
        "da": "Byggearbejdet stopper om natten.",
        "de": "Die Bauarbeiten werden nachts unterbrochen.",
        "el": "Οι εργασίες σταματούν τη νύχτα.",
        "es": "La construcción se detiene por la noche.",
        "fi": "Rakennustyöt keskeytetään yöksi.",
        "fr": "Les travaux s'arrêtent la nuit.",
        "he": "העבודות נעצרות בלילה.",
        "hi": "रात में निर्माण कार्य रुक जाता है।",
        "hu": "Az építkezés éjszaka leáll.",
        "id": "Pekerjaan konstruksi berhenti pada malam hari.",
        "it": "I lavori si fermano di notte.",
        "ja": "工事は夜に中断します。",
        "nb": "Byggearbeidet stopper om natten.",
        "nl": "De bouwwerkzaamheden stoppen 's nachts.",
        "pl": "Prace budowlane są wstrzymywane w nocy.",
        "pt": "A construção para à noite.",
        "ro": "Lucrările de construcții se opresc noaptea.",
        "ru": "Строительство ночью останавливается.",
        "sv": "Byggarbetet stoppas på natten.",
        "tr": "İnşaat gece durur.",
        "uk": "Будівництво зупиняється вночі.",
        "vi": "Công trình xây dựng dừng vào ban đêm.",
        "yue": "工程夜晚會停止。",
        "zh-Hans": "施工在夜里会停止。"
      },
