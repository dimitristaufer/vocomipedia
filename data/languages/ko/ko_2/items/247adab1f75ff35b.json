    {
      "target": "회의는 여기서 중단할게요.",
      "reading": "hoeuineun yeogiseo jungdanhalgeyo.",
      "translations": {
        "en": "We'll stop the meeting here.",
        "ko": "회의는 여기서 중단할게요.",
        "ipa": "hoeuineun yeogiseo jungdanhalgeyo.",
        "ar": "سنتوقف عن الاجتماع هنا.",
        "cs": "Skončíme schůzku tady.",
        "da": "Vi stopper mødet her.",
        "de": "Wir beenden das Meeting hier.",
        "el": "Θα σταματήσουμε τη συνάντηση εδώ.",
        "es": "Vamos a parar la reunión aquí.",
        "fi": "Lopetamme kokouksen tähän.",
        "fr": "Nous allons arrêter la réunion ici.",
        "he": "נסיים את הפגישה כאן.",
        "hi": "हम बैठक यहीं रोकेंगे।",
        "hu": "Itt befejezzük az értekezletet.",
        "id": "Kita berhenti rapat di sini.",
        "it": "Fermiamo la riunione qui.",
        "ja": "会議はここで中断します。",
        "nb": "Vi stopper møtet her.",
        "nl": "We stoppen de vergadering hier.",
        "pl": "Zatrzymamy spotkanie tutaj.",
        "pt": "Vamos parar a reunião aqui.",
        "ro": "Oprim ședința aici.",
        "ru": "Мы остановим встречу здесь.",
        "sv": "Vi stoppar mötet här.",
        "tr": "Toplantıyı burada bitireceğiz.",
        "uk": "Ми припинимо зустріч тут.",
        "vi": "Chúng tôi sẽ dừng cuộc họp ở đây.",
        "yue": "我哋喺呢度停止會議。",
        "zh-Hans": "我们在这里结束会议。"
      },
