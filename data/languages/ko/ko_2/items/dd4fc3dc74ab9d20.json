    {
      "target": "저는 매일 한국어를 배우려고 노력해요.",
      "reading": "저는 매일 한국어를 배우려고 노력해요.",
      "translations": {
        "en": "I try hard to learn Korean every day.",
        "ko": "저는 매일 한국어를 배우려고 노력해요.",
        "ipa": "저는 매일 한국어를 배우려고 노력해요.",
        "ar": "أحاول بجد أن أتعلم الكورية كل يوم.",
        "cs": "Snažím se každý den tvrdě učit korejsky.",
        "da": "Jeg prøver hårdt på at lære koreansk hver dag.",
        "de": "Ich bemühe mich jeden Tag sehr, Koreanisch zu lernen.",
        "el": "Προσπαθώ σκληρά να μάθω κορεατικά κάθε μέρα.",
        "es": "Me esfuerzo mucho por aprender coreano todos los días.",
        "fi": "Yritän kovasti oppia koreaa joka päivä.",
        "fr": "J'essaie très fort d'apprendre le coréen tous les jours.",
        "he": "אני מנסה מאוד ללמוד קוריאנית כל יום.",
        "hi": "मैं हर दिन कोरियन सीखने की बहुत कोशिश करता हूँ।",
        "hu": "Minden nap nagyon igyekszem koreaiul tanulni.",
        "id": "Saya berusaha keras untuk belajar bahasa Korea setiap hari.",
        "it": "Cerco di impegnarmi molto per imparare il coreano ogni giorno.",
        "ja": "私は毎日、韓国語を一生懸命勉強しようとしています。",
        "nb": "Jeg prøver hardt å lære koreansk hver dag.",
        "nl": "Ik doe elke dag mijn best om Koreaans te leren.",
        "pl": "Bardzo się staram uczyć koreańskiego każdego dnia.",
        "pt": "Eu me esforço muito para aprender coreano todos os dias.",
        "ro": "Mă străduiesc din greu să învăț coreeană în fiecare zi.",
        "ru": "Я каждый день очень стараюсь учить корейский.",
        "sv": "Jag försöker hårt att lära mig koreanska varje dag.",
        "tr": "Her gün Korece öğrenmek için çok uğraşıyorum.",
        "uk": "Я щодня дуже стараюся вчити корейську.",
        "vi": "Tôi cố gắng học tiếng Hàn mỗi ngày.",
        "yue": "我每日都努力學韓文。",
        "zh-Hans": "我每天都努力学习韩语。"
