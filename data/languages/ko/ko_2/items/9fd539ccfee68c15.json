  "sentences": [
    {
      "target": "비가 오더니 이내 그쳤어요.",
      "reading": "biga odeoni inae geuchyeosseoyo",
      "translations": {
        "en": "It rained, then soon stopped.",
        "ko": "비가 오더니 이내 그쳤어요.",
        "ipa": "biga odeoni inae geuchyeosseoyo",
        "ar": "هطل المطر ثم توقف قريبًا.",
        "cs": "Pršelo a pak to brzy přestalo.",
        "da": "Det regnede, og så stoppede det snart.",
        "de": "Es regnete, dann hörte es bald auf.",
        "el": "Έβρεξε και μετά σταμάτησε σύντομα.",
        "es": "Llovió y luego paró pronto.",
        "fi": "Satoi, ja sitten se loppui pian.",
        "fr": "Il a plu, puis ça s’est vite arrêté.",
        "he": "ירד גשם ואז הוא נפסק מהר.",
        "hi": "बारिश हुई, फिर जल्दी ही रुक गई।",
        "hu": "Esett az eső, aztán hamar elállt.",
        "id": "Hujan turun, lalu segera berhenti.",
        "it": "Pioveva, poi si è fermato presto.",
        "ja": "雨が降ったが、すぐにやみました。",
        "nb": "Det regnet, og så stoppet det snart.",
        "nl": "Het regende en toen stopte het snel.",
        "pl": "Padał deszcz, a potem szybko przestał.",
        "pt": "Choveu e depois parou logo.",
        "ro": "A plouat, apoi s-a oprit curând.",
        "ru": "Пошёл дождь, а потом скоро прекратился.",
        "sv": "Det regnade, och sedan slutade det snart.",
        "tr": "Yağmur yağdı, sonra hemen dindi.",
        "uk": "Почався дощ, а потім незабаром припинився.",
        "vi": "Trời mưa rồi sau đó tạnh ngay.",
        "yue": "落咗雨，跟住好快停咗。",
        "zh-Hans": "下了雨，很快就停了。"
      },
