  "sentences": [
    {
      "target": "저는 언젠가 백두산에 가 보고 싶어요.",
      "reading": "jeoneun eonjenga baekdusan-e ga bogo sipeoyo.",
      "translations": {
        "en": "I want to visit Mt. Paekdu someday.",
        "ko": "저는 언젠가 백두산에 가 보고 싶어요.",
        "ipa": "jeoneun eonjenga baekdusan-e ga bogo sipeoyo.",
        "ar": "أريد أن أزور جبل بايكتو يومًا ما.",
        "cs": "Chtěl bych někdy navštívit horu Pektu.",
        "da": "Jeg vil gerne besøge Paektusan en dag.",
        "de": "Ich möchte irgendwann einmal den Paektu-san besuchen.",
        "el": "Θέλω να επισκεφτώ το όρος Πεκτού κάποια μέρα.",
        "es": "Quiero visitar el monte Paektu algún día.",
        "fi": "Haluan joskus käydä Paektu-vuorella.",
        "fr": "Je veux visiter le mont Paektu un jour.",
        "he": "אני רוצה לבקר בהר פאקטו יום אחד.",
        "hi": "मैं कभी न कभी पेकदू पर्वत जाना चाहता हूँ।",
        "hu": "Egyszer szeretnék elmenni a Pekdú-hegyre.",
        "id": "Saya ingin mengunjungi Gunung Paektu suatu hari nanti.",
        "it": "Voglio visitare il monte Paektu un giorno.",
        "ja": "いつか白頭山に行ってみたいです。",
        "nb": "Jeg vil gjerne besøke Paektusan en dag.",
        "nl": "Ik wil ooit naar de Paektusan gaan.",
        "pl": "Chciałbym kiedyś odwiedzić górę Pektu.",
        "pt": "Quero visitar o monte Paektu um dia.",
        "ro": "Vreau să vizitez muntele Paektu într-o zi.",
        "ru": "Я хочу когда-нибудь побывать на горе Пэкту.",
        "sv": "Jag vill besöka Paektusan någon gång.",
        "tr": "Bir gün Paektu Dağı'nı ziyaret etmek istiyorum.",
        "uk": "Я хочу колись відвідати гору Пекту.",
        "vi": "Tôi muốn đến núi Paektu vào một ngày nào đó.",
        "yue": "我想有一日去白頭山睇下。",
        "zh-Hans": "我想有一天去白头山看看。"
      },
