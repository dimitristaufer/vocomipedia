  "sentences": [
    {
      "target": "새 회사 적응이 생각보다 빨랐어요.",
      "reading": "sae hoesa jeogeungi saenggakboda ppallasseoyo.",
      "translations": {
        "en": "I adapted to the new company faster than I expected.",
        "ko": "새 회사 적응이 생각보다 빨랐어요.",
        "ipa": "sae hoesa jeogeungi saenggakboda ppallasseoyo.",
        "ar": "تأقلمت مع الشركة الجديدة أسرع مما توقعت.",
        "cs": "Na novou firmu jsem si zvykl rychleji, než jsem čekal.",
        "da": "Jeg vænnede mig til den nye virksomhed hurtigere, end jeg havde forventet.",
        "de": "Ich habe mich schneller an die neue Firma gewöhnt, als ich erwartet hatte.",
        "el": "Προσαρμόστηκα στη νέα εταιρεία πιο γρήγορα απ' ό,τι περίμενα.",
        "es": "Me adapté a la nueva empresa más rápido de lo que esperaba.",
        "fi": "Sopeuduin uuteen yritykseen nopeammin kuin odotin.",
        "fr": "Je me suis adapté à la nouvelle entreprise plus vite que je ne le pensais.",
        "he": "הסתגלתי לחברה החדשה מהר יותר ממה שחשבתי.",
        "hi": "मैंने नई कंपनी के साथ उम्मीद से जल्दी तालमेल बिठा लिया।",
        "hu": "Gyorsabban megszoktam az új céget, mint vártam.",
        "id": "Saya beradaptasi dengan perusahaan baru lebih cepat dari yang saya kira.",
        "it": "Mi sono adattato alla nuova azienda più in fretta di quanto pensassi.",
        "ja": "新しい会社に思ったより早くなじみました。",
        "nb": "Jeg venner meg til det nye firmaet raskere enn jeg hadde trodd.",
        "nl": "Ik paste me sneller aan het nieuwe bedrijf aan dan ik had verwacht.",
        "pl": "Przyzwyczaiłem się do nowej firmy szybciej, niż się spodziewałem.",
        "pt": "Adaptei-me à nova empresa mais rápido do que esperava.",
        "ro": "M-am adaptat la noua companie mai repede decât mă așteptam.",
        "ru": "Я привык к новой компании быстрее, чем ожидал.",
        "sv": "Jag vänjde mig vid det nya företaget snabbare än jag trodde.",
        "tr": "Yeni şirkete beklediğimden daha hızlı alıştım.",
        "uk": "Я звик до нової компанії швидше, ніж очікував.",
        "vi": "Tôi thích nghi với công ty mới nhanh hơn tôi nghĩ.",
        "yue": "我適應新公司比我預期中快。",
        "zh-Hans": "我适应新公司的速度比我想象中快。"
      },
