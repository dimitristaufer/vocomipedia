    {
      "target": "우리 언니는 무용가예요.",
      "reading": "uri eonnineun muyongga-yeyo.",
      "translations": {
        "en": "My older sister is a dancer.",
        "ko": "우리 언니는 무용가예요.",
        "ipa": "uri eonnineun muyongga-yeyo.",
        "ar": "أختي الكبرى راقصة.",
        "cs": "Moje starší sestra je tanečnice.",
        "da": "Min storesøster er danser.",
        "de": "Meine große Schwester ist Tänzerin.",
        "el": "Η μεγάλη μου αδελφή είναι χορεύτρια.",
        "es": "Mi hermana mayor es bailarina.",
        "fi": "Isosiskoni on tanssija.",
        "fr": "Ma grande sœur est danseuse.",
        "he": "אחותי הגדולה היא רקדנית.",
        "hi": "मेरी बड़ी बहन नृत्यांगना है।",
        "hu": "A nővérem táncos.",
        "id": "Kakak perempuan saya adalah penari.",
        "it": "Mia sorella maggiore è una ballerina.",
        "ja": "姉はダンサーです。",
        "nb": "Storesøsteren min er danser.",
        "nl": "Mijn oudere zus is danseres.",
        "pl": "Moja starsza siostra jest tancerką.",
        "pt": "Minha irmã mais velha é bailarina.",
        "ro": "Sora mea mai mare este dansatoare.",
        "ru": "Моя старшая сестра — танцовщица.",
        "sv": "Min storasyster är dansare.",
        "tr": "Abla'm bir dansçı.",
        "uk": "Моя старша сестра — танцівниця.",
        "vi": "Chị gái tôi là một vũ công.",
        "yue": "我家家姐係舞蹈員。",
        "zh-Hans": "我姐姐是舞蹈家。"
