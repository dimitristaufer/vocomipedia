  "sentences": [
    {
      "target": "아이들이 선물을 받고 정말 즐거워해요.",
      "reading": "aidulei seonmureul batgo jeongmal jeulgeowohaeyo.",
      "translations": {
        "en": "The children are really delighted when they receive gifts.",
        "ko": "아이들이 선물을 받고 정말 즐거워해요.",
        "ipa": "aidulei seonmureul batgo jeongmal jeulgeowohaeyo.",
        "ar": "الأطفال يفرحون كثيرًا عندما يحصلون على الهدايا.",
        "cs": "Děti mají velkou radost, když dostanou dárky.",
        "da": "Børnene bliver rigtig glade, når de får gaver.",
        "de": "Die Kinder freuen sich sehr, wenn sie Geschenke bekommen.",
        "el": "Τα παιδιά χαίρονται πολύ όταν παίρνουν δώρα.",
        "es": "A los niños les encanta recibir regalos.",
        "fi": "Lapset ilahtuvat kovasti, kun he saavat lahjoja.",
        "fr": "Les enfants sont vraiment contents quand ils reçoivent des cadeaux.",
        "he": "הילדים שמחים מאוד כשהם מקבלים מתנות.",
        "hi": "बच्चे उपहार पाकर बहुत खुश होते हैं।",
        "hu": "A gyerekek nagyon örülnek, amikor ajándékot kapnak.",
        "id": "Anak-anak sangat senang saat mendapat hadiah.",
        "it": "I bambini sono davvero felici quando ricevono regali.",
        "ja": "子どもたちはプレゼントをもらってとても喜んでいます。",
        "nb": "Barna blir veldig glade når de får gaver.",
        "nl": "De kinderen zijn heel blij als ze cadeautjes krijgen.",
        "pl": "Dzieci bardzo się cieszą, gdy dostają prezenty.",
        "pt": "As crianças ficam muito felizes quando recebem presentes.",
        "ro": "Copiii se bucură foarte mult când primesc cadouri.",
        "ru": "Дети очень радуются, когда получают подарки.",
        "sv": "Barnen blir jätteglada när de får presenter.",
        "tr": "Çocuklar hediyeleri alınca çok seviniyor.",
        "uk": "Діти дуже радіють, коли отримують подарунки.",
        "vi": "Bọn trẻ rất vui khi nhận quà.",
        "yue": "小朋友收到禮物時都好開心。",
        "zh-Hans": "孩子们收到礼物时都很高兴。"
      },
