  "sentences": [
    {
      "target": "저는 국에 된장을 조금 넣었어요.",
      "reading": "Jeoneun guk-e doenjang-eul jogeum neoeosseoyo.",
      "translations": {
        "en": "I added a little soybean paste to the soup.",
        "ko": "저는 국에 된장을 조금 넣었어요.",
        "ipa": "Jeoneun guk-e doenjang-eul jogeum neoeosseoyo.",
        "ar": "أضفتُ قليلًا من معجون فول الصويا إلى الشوربة.",
        "cs": "Do polévky jsem přidal trochu sójové pasty.",
        "da": "Jeg kom lidt sojabønnepasta i suppen.",
        "de": "Ich habe ein bisschen Sojabohnenpaste in die Suppe getan.",
        "el": "Έβαλα λίγη πάστα σόγιας στη σούπα.",
        "es": "Le puse un poco de pasta de soja a la sopa.",
        "fi": "Lisäsin keittoon vähän soijapaputahnaa.",
        "fr": "J’ai ajouté un peu de pâte de soja à la soupe.",
        "he": "הוספתי קצת משחת סויה למרק.",
        "hi": "मैंने सूप में थोड़ा सा सोया पेस्ट डाला।",
        "hu": "Tettem egy kis szójamasszát a levesbe.",
        "id": "Saya menambahkan sedikit pasta kedelai ke dalam sup.",
        "it": "Ho aggiunto un po' di pasta di soia alla zuppa.",
        "ja": "私はスープにテンジャンを少し入れました。",
        "nb": "Jeg tilsatte litt soyabønnepasta i suppen.",
        "nl": "Ik deed een beetje sojabonenpasta in de soep.",
        "pl": "Dodałem trochę pasty sojowej do zupy.",
        "pt": "Coloquei um pouco de pasta de soja na sopa.",
        "ro": "Am pus puțin pastă de soia în supă.",
        "ru": "Я добавил немного соевой пасты в суп.",
        "sv": "Jag lade i lite sojabönspasta i soppan.",
        "tr": "Çorbaya biraz soya fasulyesi ezmesi ekledim.",
        "uk": "Я додав трохи соєвої пасти до супу.",
        "vi": "Tôi đã cho một ít tương đậu nành vào canh.",
        "yue": "我落咗少少大醬喺湯入面。",
        "zh-Hans": "我在汤里加了一点大酱。"
      },
