  "sentences": [
    {
      "target": "다리를 건너오면 역이 보여요.",
      "reading": "darireul geonneoomyeon yeogi boyeoyo.",
      "translations": {
        "en": "If you come across the bridge, you can see the station.",
        "ko": "다리를 건너오면 역이 보여요.",
        "ipa": "darireul geonneoomyeon yeogi boyeoyo.",
        "ar": "إذا عبرت الجسر، سترى المحطة.",
        "cs": "Když přejdete most, uvidíte nádraží.",
        "da": "Hvis du går over broen, kan du se stationen.",
        "de": "Wenn du über die Brücke gehst, siehst du den Bahnhof.",
        "el": "Αν περάσεις τη γέφυρα, θα δεις τον σταθμό.",
        "es": "Si cruzas el puente, verás la estación.",
        "fi": "Jos menet sillan yli, näet aseman.",
        "fr": "Si tu traverses le pont, tu verras la gare.",
        "he": "אם תחצה את הגשר, תראה את התחנה.",
        "hi": "अगर आप पुल पार करेंगे, तो स्टेशन दिखेगा।",
        "hu": "Ha átmész a hídon, látni fogod az állomást.",
        "id": "Kalau kamu menyeberangi jembatan, stasiunnya kelihatan.",
        "it": "Se attraversi il ponte, vedi la stazione.",
        "ja": "橋を渡ると駅が見えます。",
        "nb": "Hvis du går over broen, ser du stasjonen.",
        "nl": "Als je over de brug gaat, zie je het station.",
        "pl": "Jeśli przejdziesz przez most, zobaczysz stację.",
        "pt": "Se você atravessar a ponte, vai ver a estação.",
        "ro": "Dacă treci podul, vei vedea gara.",
        "ru": "Если вы перейдёте мост, увидите вокзал.",
        "sv": "Om du går över bron ser du stationen.",
        "tr": "Köprüyü geçersen istasyonu görürsün.",
        "uk": "Якщо перейдеш міст, побачиш вокзал.",
        "vi": "Nếu bạn đi qua cầu, bạn sẽ thấy ga tàu.",
        "yue": "如果你過咗條橋，就會見到車站。",
        "zh-Hans": "如果你过了桥，就能看到车站。"
      },
