  "sentences": [
    {
      "target": "친구의 말이 큰 위로가 됐어요.",
      "reading": "chinguui mali keun wiroga dwaesseoyo.",
      "translations": {
        "en": "My friend's words became a great comfort.",
        "ko": "친구의 말이 큰 위로가 됐어요.",
        "ipa": "chinguui mali keun wiroga dwaesseoyo.",
        "ar": "كلمات صديقي كانت عزاءً كبيرًا.",
        "cs": "Slova mého kamaráda byla velkou útěchou.",
        "da": "Min vens ord blev en stor trøst.",
        "de": "Die Worte meines Freundes waren ein großer Trost.",
        "el": "Τα λόγια του φίλου μου ήταν μεγάλη παρηγοριά.",
        "es": "Las palabras de mi amigo fueron un gran consuelo.",
        "fi": "Ystäväni sanat olivat suuri lohtu.",
        "fr": "Les mots de mon ami m'ont beaucoup réconforté.",
        "he": "המילים של החבר שלי היו נחמה גדולה.",
        "hi": "मेरे दोस्त की बातों से बहुत सांत्वना मिली।",
        "hu": "A barátom szavai nagy vigaszt nyújtottak.",
        "id": "Kata-kata teman saya sangat menghibur.",
        "it": "Le parole del mio amico sono state un grande conforto.",
        "ja": "友達の言葉にとても慰められました。",
        "nb": "Vennens ord var en stor trøst.",
        "nl": "De woorden van mijn vriend waren een grote troost.",
        "pl": "Słowa mojego przyjaciela były wielkim pocieszeniem.",
        "pt": "As palavras do meu amigo foram um grande conforto.",
        "ro": "Cuvintele prietenului meu au fost o mare mângâiere.",
        "ru": "Слова моего друга стали большим утешением.",
        "sv": "Min väns ord blev en stor tröst.",
        "tr": "Arkadaşımın sözleri bana büyük bir teselli oldu.",
        "uk": "Слова мого друга стали великою втіхою.",
        "vi": "Lời của bạn tôi là một an ủi lớn.",
        "yue": "朋友嘅說話真係好安慰。",
        "zh-Hans": "朋友的话给了我很大的安慰。"
      },
