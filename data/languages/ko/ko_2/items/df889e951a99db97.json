    {
      "target": "어느새 저녁이 되었네요.",
      "reading": "eoneusae jeonyeogi doeeonneyo.",
      "translations": {
        "en": "It’s already evening.",
        "ko": "어느새 저녁이 되었네요.",
        "ipa": "eoneusae jeonyeogi doeeonneyo.",
        "ar": "لقد أصبح المساء بالفعل.",
        "cs": "Už je večer.",
        "da": "Det er allerede blevet aften.",
        "de": "Es ist schon Abend geworden.",
        "el": "Έγινε κιόλας βράδυ.",
        "es": "Ya es de noche.",
        "fi": "On jo ilta.",
        "fr": "C'est déjà le soir.",
        "he": "כבר ערב.",
        "hi": "अब शाम हो गई है।",
        "hu": "Már este van.",
        "id": "Tanpa terasa, sudah sore.",
        "it": "È già sera.",
        "ja": "いつの間にか夕方になりました。",
        "nb": "Det har allerede blitt kveld.",
        "nl": "Het is al avond.",
        "pl": "Już zrobił się wieczór.",
        "pt": "Já é noite.",
        "ro": "Deja s-a făcut seară.",
        "ru": "Уже вечер.",
        "sv": "Det har redan blivit kväll.",
        "tr": "Bir bakmışım, akşam olmuş.",
        "uk": "Уже вечір.",
        "vi": "Thoáng chốc đã đến tối.",
        "yue": "轉眼間已經夜晚。",
        "zh-Hans": "不知不觉天都黑了。"
