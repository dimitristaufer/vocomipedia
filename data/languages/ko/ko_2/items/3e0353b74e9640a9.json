  "sentences": [
    {
      "target": "사장님은 이번 일에서 물러나겠다고 했어요.",
      "reading": "sajangnimeun ibeon ileseo mulleonagetdago haesseoyo.",
      "translations": {
        "en": "The boss said he would step back from this matter.",
        "ko": "사장님은 이번 일에서 물러나겠다고 했어요.",
        "ipa": "sajangnimeun ibeon ileseo mulleonagetdago haesseoyo.",
        "ar": "قال المدير إنه سيتنحى عن هذا الأمر.",
        "cs": "Šéf řekl, že se od té záležitosti stáhne.",
        "da": "Chefen sagde, at han ville trække sig fra sagen.",
        "de": "Der Chef sagte, er werde sich aus dieser Angelegenheit zurückziehen.",
        "el": "Ο διευθυντής είπε ότι θα αποσυρθεί από αυτό το θέμα.",
        "es": "El jefe dijo que se apartaría de este asunto.",
        "fi": "Pomo sanoi, että hän vetäytyy tästä asiasta.",
        "fr": "Le patron a dit qu'il se retirerait de cette affaire.",
        "he": "הבוס אמר שהוא ייסוג מהעניין הזה.",
        "hi": "बॉस ने कहा कि वह इस मामले से हट जाएगा।",
        "hu": "A főnök azt mondta, hogy visszalép ettől az ügytől.",
        "id": "Bos itu bilang dia akan mundur dari masalah ini.",
        "it": "Il capo ha detto che si sarebbe ritirato da questa questione.",
        "ja": "社長は今回の件から手を引くと言いました。",
        "nb": "Sjefen sa at han ville trekke seg fra denne saken.",
        "nl": "De baas zei dat hij zich uit deze zaak zou terugtrekken.",
        "pl": "Szef powiedział, że wycofa się z tej sprawy.",
        "pt": "O chefe disse que vai se afastar deste assunto.",
        "ro": "Șeful a spus că se va retrage din această chestiune.",
        "ru": "Босс сказал, что отойдёт от этого дела.",
        "sv": "Chefen sa att han skulle dra sig tillbaka från det här ärendet.",
        "tr": "Patron, bu işten çekileceğini söyledi.",
        "uk": "Бос сказав, що він відступить від цієї справи.",
        "vi": "Ông chủ nói rằng ông ấy sẽ rút khỏi việc này.",
        "yue": "老闆話佢會喺呢件事上退後一步。",
        "zh-Hans": "老板说他会从这件事中退出来。"
      },
