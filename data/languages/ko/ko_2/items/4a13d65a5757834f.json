  "sentences": [
    {
      "target": "아침이 되니 하늘이 밝아졌어요.",
      "reading": "Achimi doeni haneuri balkajyeosseoyo.",
      "translations": {
        "en": "As morning came, the sky brightened.",
        "ko": "아침이 되니 하늘이 밝아졌어요.",
        "ipa": "Achimi doeni haneuri balkajyeosseoyo.",
        "ar": "عندما أصبح الصباح، أضاءت السماء.",
        "cs": "Když nastalo ráno, obloha se rozjasnila.",
        "da": "Da morgenen kom, blev himlen lysere.",
        "de": "Als der Morgen kam, wurde der Himmel heller.",
        "el": "Όταν ξημέρωσε, ο ουρανός άρχισε να φωτίζεται.",
        "es": "Cuando llegó la mañana, el cielo se aclaró.",
        "fi": "Kun aamu koitti, taivas kirkastui.",
        "fr": "Quand le matin est arrivé, le ciel s'est éclairci.",
        "he": "כשהגיע הבוקר, השמיים התבהרו.",
        "hi": "जब सुबह हुई, आसमान उजला हो गया।",
        "hu": "Amikor reggel lett, az ég kivilágosodott.",
        "id": "Saat pagi tiba, langit menjadi lebih terang.",
        "it": "Quando arrivò il mattino, il cielo si schiarì.",
        "ja": "朝になると、空が明るくなりました。",
        "nb": "Da morgenen kom, ble himmelen lysere.",
        "nl": "Toen de ochtend aanbrak, werd de lucht lichter.",
        "pl": "Kiedy nastał ranek, niebo się rozjaśniło.",
        "pt": "Quando amanheceu, o céu ficou mais claro.",
        "ro": "Când s-a făcut dimineață, cerul s-a luminat.",
        "ru": "Когда наступило утро, небо посветлело.",
        "sv": "När morgonen kom blev himlen ljusare.",
        "tr": "Sabah olunca gökyüzü aydınlandı.",
        "uk": "Коли настав ранок, небо посвітлішало.",
        "vi": "Khi trời sáng, bầu trời sáng hơn.",
        "yue": "朝頭早一到，天空亮咗。",
        "zh-Hans": "到了早晨，天空变亮了。"
      },
