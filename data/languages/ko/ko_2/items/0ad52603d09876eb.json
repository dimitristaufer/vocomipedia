  "sentences": [
    {
      "target": "그 소설은 죽음을 조용히 이야기해요.",
      "reading": "geu soseoneun jugeumeul joyonghi iyagihaeyo.",
      "translations": {
        "en": "That novel talks about death quietly.",
        "ko": "그 소설은 죽음을 조용히 이야기해요.",
        "ipa": "geu soseoneun jugeumeul joyonghi iyagihaeyo.",
        "ar": "تتحدث تلك الرواية عن الموت بهدوء.",
        "cs": "Ten román tiše vypráví o smrti.",
        "da": "Den roman taler stille om døden.",
        "de": "Der Roman spricht leise über den Tod.",
        "el": "Αυτό το μυθιστόρημα μιλάει ήρεμα για τον θάνατο.",
        "es": "Esa novela habla de la muerte con calma.",
        "fi": "Tuo romaani kertoo kuolemasta rauhallisesti.",
        "fr": "Ce roman parle de la mort avec calme.",
        "he": "הרומן הזה מדבר על המוות בשקט.",
        "hi": "वह उपन्यास मौत के बारे में शांत तरीके से बात करता है।",
        "hu": "Az a regény csendesen beszél a halálról.",
        "id": "Novel itu membicarakan kematian dengan tenang.",
        "it": "Quel romanzo parla della morte con calma.",
        "ja": "その小説は死について静かに語っています。",
        "nb": "Den romanen snakker stille om døden.",
        "nl": "Die roman gaat rustig over de dood.",
        "pl": "Ta powieść opowiada spokojnie o śmierci.",
        "pt": "Esse romance fala da morte com calma.",
        "ro": "Romanul acela vorbește liniștit despre moarte.",
        "ru": "Этот роман тихо говорит о смерти.",
        "sv": "Den romanen handlar lugnt om döden.",
        "tr": "O roman ölümü sakin bir şekilde anlatıyor.",
        "uk": "Той роман спокійно розповідає про смерть.",
        "vi": "Cuốn tiểu thuyết đó kể về cái chết một cách nhẹ nhàng.",
        "yue": "嗰本小說平靜咁講死亡。",
        "zh-Hans": "那本小说平静地谈论死亡。"
      },
