  "sentences": [
    {
      "target": "우리 집은 골목 안에 있어요.",
      "reading": "Uri jibeun golmok ane isseoyo.",
      "translations": {
        "en": "Our house is in the alley.",
        "ko": "우리 집은 골목 안에 있어요.",
        "ipa": "Uri jibeun golmok ane isseoyo.",
        "ar": "بيتنا في الزقاق.",
        "cs": "Náš dům je v uličce.",
        "da": "Vores hus ligger i en gyde.",
        "de": "Unser Haus liegt in einer Gasse.",
        "el": "Το σπίτι μας είναι σε ένα στενό.",
        "es": "Nuestra casa está en un callejón.",
        "fi": "Talomme on kujalla.",
        "fr": "Notre maison est dans la ruelle.",
        "he": "הבית שלנו נמצא בסמטה.",
        "hi": "हमारा घर गली में है।",
        "hu": "A házunk egy sikátorban van.",
        "id": "Rumah kami ada di gang.",
        "it": "La nostra casa è in un vicolo.",
        "ja": "うちの家は路地の中にあります。",
        "nb": "Huset vårt ligger i en smal gate.",
        "nl": "Ons huis ligt in een steegje.",
        "pl": "Nasz dom jest w zaułku.",
        "pt": "Nossa casa fica numa viela.",
        "ro": "Casa noastră este pe o alee.",
        "ru": "Наш дом находится в переулке.",
        "sv": "Vårt hus ligger i en gränd.",
        "tr": "Evimiz bir sokakta.",
        "uk": "Наш дім у провулку.",
        "vi": "Nhà chúng tôi ở trong một con hẻm.",
        "yue": "我哋屋企喺條巷入面。",
        "zh-Hans": "我们家在巷子里。"
      },
