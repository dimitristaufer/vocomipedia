    {
      "target": "아기가 엄마 뺨에 뽀뽀했어요.",
      "reading": "agiga eomma ppyame ppoppohasseoyo.",
      "translations": {
        "en": "The baby kissed mom's cheek.",
        "ko": "아기가 엄마 뺨에 뽀뽀했어요.",
        "ipa": "agiga eomma ppyame ppoppohasseoyo.",
        "ar": "قبّل الطفل خدّ أمه.",
        "cs": "Dítě políbilo maminku na tvář.",
        "da": "Babyen kyssede sin mors kind.",
        "de": "Das Baby küsste die Wange seiner Mutter.",
        "el": "Το μωρό φίλησε το μάγουλο της μαμάς του.",
        "es": "El bebé besó la mejilla de su mamá.",
        "fi": "Vauva suuteli äitinsä poskea.",
        "fr": "Le bébé a embrassé la joue de sa maman.",
        "he": "התינוק נישק את הלחי של אמא שלו.",
        "hi": "बच्चे ने अपनी माँ के गाल पर चुंबन दिया।",
        "hu": "A baba megcsókolta az anyukája arcát.",
        "id": "Bayi itu mencium pipi ibunya.",
        "it": "Il bambino ha baciato la guancia della mamma.",
        "ja": "赤ちゃんがママのほおにキスしました。",
        "nb": "Babyen kysset kinnet til mammaen sin.",
        "nl": "De baby gaf zijn moeder een kus op de wang.",
        "pl": "Dziecko pocałowało mamę w policzek.",
        "pt": "O bebê beijou a bochecha da mãe.",
        "ro": "Bebelușul a sărutat obrazul mamei sale.",
        "ru": "Малыш поцеловал маму в щёку.",
        "sv": "Bebisen pussade sin mammas kind.",
        "tr": "Bebek annesinin yanağını öptü.",
        "uk": "Дитина поцілувала мамину щоку.",
        "vi": "Em bé hôn má của mẹ.",
        "yue": "BB錫咗媽咪嘅面珠。",
        "zh-Hans": "宝宝亲了妈妈的脸颊。"
      },
