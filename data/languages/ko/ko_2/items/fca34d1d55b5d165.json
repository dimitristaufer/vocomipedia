      "בוא נסיים מהר ונצא יחד."
    ],
    "hi": [
      "जल्दी आइए।",
      "चावल ठंडा होने से पहले जल्दी खा लो।",
      "बारिश हो रही है, इसलिए जल्दी अंदर जाओ।",
      "चलो जल्दी खत्म करते हैं और फिर साथ बाहर चलते हैं।"
    ],
    "hu": [
      "Jöjjön gyorsan.",
      "Edd meg gyorsan, mielőtt kihűl a rizs.",
      "Esik az eső, úgyhogy gyere be gyorsan.",
      "Fejezzük be gyorsan, és menjünk ki együtt."
    ],
    "id": [
      "Cepat datang.",
