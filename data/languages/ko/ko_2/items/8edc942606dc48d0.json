  "sentences": [
    {
      "target": "오늘은 전화한 횟수가 세 번이에요.",
      "reading": "oneureun jeonhwan hoessuga se beonieyo.",
      "translations": {
        "en": "Today, I called three times.",
        "ko": "오늘은 전화한 횟수가 세 번이에요.",
        "ipa": "oneureun jeonhwan hoessuga se beonieyo.",
        "ar": "اليوم اتصلت ثلاث مرات.",
        "cs": "Dnes jsem volal třikrát.",
        "da": "I dag ringede jeg tre gange.",
        "de": "Heute habe ich dreimal angerufen.",
        "el": "Σήμερα τηλεφώνησα τρεις φορές.",
        "es": "Hoy llamé tres veces.",
        "fi": "Soitin tänään kolme kertaa.",
        "fr": "Aujourd'hui, j'ai appelé trois fois.",
        "he": "היום התקשרתי שלוש פעמים.",
        "hi": "आज मैंने तीन बार फ़ोन किया।",
        "hu": "Ma háromszor telefonáltam.",
        "id": "Hari ini saya menelepon tiga kali.",
        "it": "Oggi ho telefonato tre volte.",
        "ja": "今日は三回電話しました。",
        "nb": "I dag ringte jeg tre ganger.",
        "nl": "Vandaag heb ik drie keer gebeld.",
        "pl": "Dzisiaj zadzwoniłem trzy razy.",
        "pt": "Hoje liguei três vezes.",
        "ro": "Astăzi am sunat de trei ori.",
        "ru": "Сегодня я звонил три раза.",
        "sv": "I dag ringde jag tre gånger.",
        "tr": "Bugün üç kere telefon ettim.",
        "uk": "Сьогодні я телефонував тричі.",
        "vi": "Hôm nay tôi đã gọi điện ba lần.",
        "yue": "今日我打咗三次電話。",
        "zh-Hans": "今天我打了三次电话。"
      },
