  "sentences": [
    {
      "target": "아침에 따뜻한 설렁탕을 먹었어요.",
      "reading": "achim-e ttatteuthan seolleongtang-eul meogeosseoyo.",
      "translations": {
        "en": "I ate warm seolleongtang in the morning.",
        "ko": "아침에 따뜻한 설렁탕을 먹었어요.",
        "ipa": "achim-e ttatteuthan seolleongtang-eul meogeosseoyo.",
        "ar": "أكلتُ سولونغتانغ دافئًا في الصباح.",
        "cs": "Ráno jsem jedl teplý seolleongtang.",
        "da": "Jeg spiste varm seolleongtang om morgenen.",
        "de": "Ich habe morgens warmen Seolleongtang gegessen.",
        "el": "Έφαγα ζεστό σεολεονγκτάν το πρωί.",
        "es": "Comí seolleongtang caliente por la mañana.",
        "fi": "Söin aamulla lämmintä seolleongtangia.",
        "fr": "J'ai mangé du seolleongtang chaud le matin.",
        "he": "אכלתי סולטונג חם בבוקר.",
