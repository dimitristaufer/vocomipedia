  "sentences": [
    {
      "target": "할머니가 옛날이야기를 들려주셨어요.",
      "reading": "halmeoniga yesnariyagireul deullyeojusyeosseoyo.",
      "translations": {
        "en": "My grandmother told us an old story.",
        "ko": "할머니가 옛날이야기를 들려주셨어요.",
        "ipa": "halmeoniga yesnariyagireul deullyeojusyeosseoyo.",
        "ar": "جدتي روت لنا قصة قديمة.",
        "cs": "Babička nám vyprávěla starý příběh.",
        "da": "Min bedstemor fortalte os en gammel historie.",
        "de": "Meine Großmutter hat uns eine alte Geschichte erzählt.",
        "el": "Η γιαγιά μου μάς είπε μια παλιά ιστορία.",
        "es": "Mi abuela nos contó una historia antigua.",
        "fi": "Isoäitini kertoi meille vanhan tarinan.",
        "fr": "Ma grand-mère nous a raconté une vieille histoire.",
        "he": "סבתא שלי סיפרה לנו סיפור ישן.",
        "hi": "मेरी दादी ने हमें एक पुरानी कहानी सुनाई।",
        "hu": "A nagymamám elmesélt nekünk egy régi történetet.",
        "id": "Nenekku menceritakan dongeng lama kepada kami.",
        "it": "Mia nonna ci ha raccontato una storia antica.",
        "ja": "祖母が昔話を聞かせてくれました。",
        "nb": "Bestemoren min fortalte oss en gammel historie.",
        "nl": "Mijn oma vertelde ons een oud verhaal.",
        "pl": "Babcia opowiedziała nam starą historię.",
        "pt": "Minha avó nos contou uma história antiga.",
        "ro": "Bunica ne-a spus o poveste veche.",
        "ru": "Моя бабушка рассказала нам старую историю.",
        "sv": "Min mormor berättade en gammal saga för oss.",
        "tr": "Büyükannem bize eski bir hikâye anlattı.",
        "uk": "Моя бабуся розповіла нам стару історію.",
        "vi": "Bà tôi kể cho chúng tôi nghe một câu chuyện cổ.",
        "yue": "嫲嫲同我哋講咗個古老嘅故事。",
        "zh-Hans": "奶奶给我们讲了一个古老的故事。"
      },
