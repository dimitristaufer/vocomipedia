    {
      "target": "모두 박수를 쳤어요.",
      "reading": "modu baksureul chyeosseoyo.",
      "translations": {
        "en": "Everyone clapped.",
        "ko": "모두 박수를 쳤어요.",
        "ipa": "modu baksureul chyeosseoyo.",
        "ar": "صفق الجميع.",
        "cs": "Všichni tleskali.",
        "da": "Alle klappede.",
        "de": "Alle klatschten.",
        "el": "Όλοι χειροκρότησαν.",
        "es": "Todos aplaudieron.",
        "fi": "Kaikki taputtivat.",
        "fr": "Tout le monde a applaudi.",
        "he": "כולם מחאו כפיים.",
        "hi": "सबने ताली बजाई।",
        "hu": "Mindenki tapsolt.",
        "id": "Semua bertepuk tangan.",
        "it": "Tutti applaudirono.",
        "ja": "みんなが拍手をしました。",
        "nb": "Alle klappet.",
        "nl": "Iedereen applaudisseerde.",
        "pl": "Wszyscy klaskali.",
        "pt": "Todos aplaudiram.",
        "ro": "Toată lumea a aplaudat.",
        "ru": "Все аплодировали.",
        "sv": "Alla applåderade.",
        "tr": "Herkes alkışladı.",
        "uk": "Усі плескали.",
        "vi": "Mọi người đều vỗ tay.",
        "yue": "大家都拍手。",
        "zh-Hans": "大家都鼓掌了。"
      },
