    {
      "target": "그분은 제 스승이세요.",
      "reading": "geubuneun je seuseung-iseyo.",
      "translations": {
        "en": "That person is my teacher.",
        "ko": "그분은 제 스승이세요.",
        "ipa": "geubuneun je seuseung-iseyo.",
        "ar": "ذلك الشخص هو معلمي.",
        "cs": "Ten člověk je můj učitel.",
        "da": "Den person er min lærer.",
        "de": "Diese Person ist mein Lehrer.",
        "el": "Αυτό το άτομο είναι ο δάσκαλός μου.",
        "es": "Esa persona es mi maestro.",
        "fi": "Hän on minun opettajani.",
        "fr": "Cette personne est mon professeur.",
        "he": "הוא המורה שלי.",
        "hi": "वह मेरे गुरु हैं।",
        "hu": "Az az ember a mesterem.",
        "id": "Orang itu adalah guru saya.",
