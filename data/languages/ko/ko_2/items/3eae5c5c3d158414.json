  "sentences": [
    {
      "target": "오늘도 친구 신세를 졌어요.",
      "reading": "오늘도 친구 신세를 저써요.",
      "translations": {
        "en": "I relied on a friend again today.",
        "ko": "오늘도 친구 신세를 졌어요.",
        "ipa": "오늘도 친구 신세를 저써요.",
        "ar": "اعتمدت على صديق مرة أخرى اليوم.",
        "cs": "Dnes jsem se zase spoléhal na kamaráda.",
        "da": "Jeg var igen afhængig af en ven i dag.",
        "de": "Ich war heute wieder auf einen Freund angewiesen.",
        "el": "Σήμερα πάλι βασίστηκα σε έναν φίλο.",
        "es": "Hoy también dependí de un amigo.",
        "fi": "Tukeuduin taas tänään ystävään.",
        "fr": "J'ai encore compté sur un ami aujourd'hui.",
        "he": "הסתמכתי שוב היום על חבר.",
        "hi": "मैंने आज भी एक दोस्त पर भरोसा किया।",
        "hu": "Ma megint egy barátra támaszkodtam.",
        "id": "Saya bergantung pada teman lagi hari ini.",
        "it": "Oggi ho dovuto contare di nuovo su un amico.",
        "ja": "今日も友達に世話になった。",
        "nb": "Jeg var avhengig av en venn igjen i dag.",
        "nl": "Ik was vandaag weer afhankelijk van een vriend.",
        "pl": "Dzisiaj znowu polegałem na przyjacielu.",
        "pt": "Hoje, de novo, contei com um amigo.",
        "ro": "Și azi m-am bazat pe un prieten.",
        "ru": "Сегодня я снова полагался на друга.",
        "sv": "Jag var beroende av en vän igen i dag.",
        "tr": "Bugün yine bir dosta muhtaç oldum.",
        "uk": "Сьогодні я знову покладався на друга.",
        "vi": "Hôm nay tôi lại nhờ một người bạn.",
        "yue": "今日我又要靠朋友幫忙。",
        "zh-Hans": "今天我又靠朋友帮忙了。"
      },
