  "sentences": [
    {
      "target": "할머니는 그 사진을 오래도록 바라보셨어요.",
      "reading": "Halmeonineun geu sajineul oraedorok barabosyeosseoyo.",
      "translations": {
        "en": "Grandma looked at the photo for a long time.",
        "ko": "할머니는 그 사진을 오래도록 바라보셨어요.",
        "ipa": "Halmeonineun geu sajineul oraedorok barabosyeosseoyo.",
        "ar": "ظلت الجدة تنظر إلى تلك الصورة طويلًا.",
        "cs": "Babička se na tu fotku dlouho dívala.",
        "da": "Bedstemor kiggede længe på billedet.",
        "de": "Oma schaute sich das Foto lange an.",
        "el": "Η γιαγιά κοίταζε τη φωτογραφία για ώρα.",
        "es": "La abuela miró la foto durante mucho tiempo.",
        "fi": "Mummo katseli valokuvaa pitkään.",
        "fr": "Grand-mère a regardé la photo pendant longtemps.",
        "he": "סבתא הביטה בתמונה זמן רב.",
        "hi": "दादी उस फोटो को बहुत देर तक देखती रहीं।",
        "hu": "Nagymama sokáig nézte a fényképet.",
        "id": "Nenek terus memandangi foto itu dalam waktu lama.",
        "it": "La nonna ha guardato a lungo quella foto.",
        "ja": "おばあさんはその写真を長い間見つめていました。",
        "nb": "Bestemor så lenge på bildet.",
        "nl": "Oma keek lang naar de foto.",
        "pl": "Babcia długo patrzyła na to zdjęcie.",
        "pt": "A avó ficou olhando a foto por muito tempo.",
        "ro": "Bunica s-a uitat mult timp la fotografia aceea.",
        "ru": "Бабушка долго смотрела на ту фотографию.",
        "sv": "Mormor tittade länge på fotot.",
        "tr": "Büyükanne fotoğrafa uzun süre baktı.",
        "uk": "Бабуся довго дивилася на те фото.",
        "vi": "Bà nhìn bức ảnh rất lâu.",
        "yue": "婆婆望住張相好耐。",
        "zh-Hans": "奶奶久久地看着那张照片。"
      },
