  "sentences": [
    {
      "target": "엄마는 제가 게으르다고 하셨어요.",
      "reading": "eommaneun jega geeureudago hasyeosseoyo.",
      "translations": {
        "en": "My mom said that I was lazy.",
        "ko": "엄마는 제가 게으르다고 하셨어요.",
        "ipa": "eommaneun jega geeureudago hasyeosseoyo.",
        "ar": "قالت أمي إنني كنت كسولًا.",
        "cs": "Maminka řekla, že jsem líný.",
        "da": "Min mor sagde, at jeg var doven.",
        "de": "Meine Mutter sagte, dass ich faul sei.",
        "el": "Η μαμά μου είπε ότι ήμουν τεμπέλης.",
        "es": "Mi mamá dijo que yo era vago.",
        "fi": "Äitini sanoi, että olin laiska.",
        "fr": "Ma mère a dit que j'étais paresseux.",
        "he": "אמא שלי אמרה שאני עצלן.",
        "hi": "मेरी माँ ने कहा कि मैं आलसी था।",
        "hu": "Anyukám azt mondta, hogy lusta vagyok.",
        "id": "Ibu bilang aku malas.",
        "it": "Mia madre ha detto che ero pigro.",
        "ja": "母は私が怠け者だと言いました。",
        "nb": "Mamma sa at jeg var lat.",
        "nl": "Mijn moeder zei dat ik lui was.",
        "pl": "Mama powiedziała, że jestem leniwy.",
        "pt": "Minha mãe disse que eu era preguiçoso.",
        "ro": "Mama a spus că eram leneș.",
        "ru": "Мама сказала, что я ленивый.",
        "sv": "Mamma sa att jag var lat.",
        "tr": "Annem tembel olduğumu söyledi.",
        "uk": "Мама сказала, що я лінивий.",
        "vi": "Mẹ tôi nói tôi lười.",
        "yue": "阿媽話我懶。",
        "zh-Hans": "妈妈说我很懒。"
      },
