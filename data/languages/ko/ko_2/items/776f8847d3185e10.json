    {
      "target": "좋은 소식이 가족에게 전달되었어요.",
      "reading": "joeun sosigi gajogege jeondaldoeeosseoyo.",
      "translations": {
        "en": "The good news was delivered to my family.",
        "ko": "좋은 소식이 가족에게 전달되었어요.",
        "ipa": "joeun sosigi gajogege jeondaldoeeosseoyo.",
        "ar": "وصلت الأخبار السارة إلى عائلتي.",
        "cs": "Dobré zprávy se dostaly k mé rodině.",
        "da": "De gode nyheder blev leveret til min familie.",
        "de": "Die guten Nachrichten wurden an meine Familie weitergegeben.",
        "el": "Τα καλά νέα μεταφέρθηκαν στην οικογένειά μου.",
        "es": "Las buenas noticias se comunicaron a mi familia.",
        "fi": "Hyvät uutiset välitettiin perheelleni.",
        "fr": "Les bonnes nouvelles ont été transmises à ma famille.",
        "he": "החדשות הטובות הועברו למשפחה שלי.",
        "hi": "अच्छी खबर मेरे परिवार तक पहुँचा दी गई।",
        "hu": "A jó hírt eljuttatták a családomhoz.",
        "id": "Kabar baik itu sudah disampaikan kepada keluargaku.",
        "it": "Le buone notizie sono state comunicate alla mia famiglia.",
        "ja": "いい知らせが家族に伝えられました。",
        "nb": "De gode nyhetene ble formidlet til familien min.",
        "nl": "Het goede nieuws is aan mijn familie doorgegeven.",
        "pl": "Dobre wieści zostały przekazane mojej rodzinie.",
        "pt": "As boas notícias foram transmitidas à minha família.",
        "ro": "Vestea bună a fost transmisă familiei mele.",
        "ru": "Хорошие новости передали моей семье.",
        "sv": "De goda nyheterna förmedlades till min familj.",
        "tr": "Güzel haber aileme iletildi.",
        "uk": "Хороші новини передали моїй родині.",
        "vi": "Tin tốt đã được chuyển đến gia đình tôi.",
        "yue": "好消息已經傳達俾我屋企人。",
        "zh-Hans": "好消息已经传达给我的家人了。"
      },
