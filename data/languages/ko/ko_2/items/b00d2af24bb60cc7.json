    "de": [
      "Die Morgensonne ging auf.",
      "Rauch steigt aus dem Schornstein auf.",
      "Wasser sprudelte aus dem Brunnen.",
      "Der Berg ragt über die Wolken hinaus."
    ],
    "el": [
      "Ο πρωινός ήλιος ανέτειλε.",
      "Βγαίνει καπνός από την καμινάδα.",
      "Το νερό πετάχτηκε από το σιντριβάνι.",
      "Εκείνο το βουνό υψώνεται πάνω από τα σύννεφα."
    ],
    "es": [
      "Salió el sol de la mañana.",
      "Sale humo de la chimenea.",
      "El agua brotó de la fuente.",
      "Esa montaña se eleva por encima de las nubes."
    ],
    "fi": [
      "Aamuaurinko nousi.",
      "Savua nousee savupiipusta.",
      "Vesi pulppusi suihkulähteestä.",
      "Tuo vuori kohoaa pilvien yläpuolelle."
    ],
    "fr": [
      "Le soleil du matin s'est levé.",
      "De la fumée s'élève de la cheminée.",
      "De l'eau a jailli de la fontaine.",
      "Cette montagne s'élève au-dessus des nuages."
    ],
    "he": [
      "שמש הבוקר זרחה.",
      "עשן עולה מהארובה.",
      "מים פרצו מהמזרקה.",
      "ההר הזה מתנשא מעל העננים."
    ],
    "hi": [
      "सुबह का सूरज उग आया।",
      "चिमनी से धुआँ उठ रहा है।",
      "फव्वारे से पानी उछला।",
      "वह पहाड़ बादलों के ऊपर उठा हुआ है।"
    ],
    "hu": [
      "Felkelt a reggeli nap.",
      "Füst száll fel a kéményből.",
      "Víz tört fel a szökőkútból.",
      "Az a hegy a felhők fölé magasodik."
    ],
    "id": [
      "Matahari pagi telah terbit.",
      "Asap naik dari cerobong.",
      "Air memancar dari air mancur.",
      "Gunung itu menjulang di atas awan."
    ],
    "it": [
      "È sorto il sole del mattino.",
      "Il fumo sale dal camino.",
      "L'acqua è sgorgata dalla fontana.",
      "Quella montagna si erge sopra le nuvole."
    ],
    "ja": [
      "朝日が昇りました。",
      "煙突から煙が立ちのぼります。",
      "噴水から水が吹き上がりました。",
      "あの山は雲の上にそびえています。"
    ],
    "nb": [
      "Morgensolen sto opp.",
      "Røyk stiger opp fra skorsteinen.",
      "Vann sprutet opp fra fontenen.",
      "Det fjellet ruver over skyene."
    ],
    "nl": [
      "De ochtendzon kwam op.",
      "Er komt rook uit de schoorsteen.",
      "Er spoot water uit de fontein omhoog.",
      "Die berg steekt boven de wolken uit."
    ],
    "pl": [
      "Wzeszło poranne słońce.",
      "Z komina unosi się dym.",
      "Woda wytrysnęła z fontanny.",
      "Tamta góra wznosi się ponad chmurami."
    ],
    "pt": [
      "O sol da manhã nasceu.",
      "Sai fumaça da chaminé.",
      "A água jorrou da fonte.",
      "Aquela montanha se eleva acima das nuvens."
    ],
    "ro": [
      "A răsărit soarele de dimineață.",
      "Iese fum pe coș.",
      "Apa a țâșnit din fântână.",
      "Muntele acela se înalță deasupra norilor."
    ],
    "ru": [
      "Взошло утреннее солнце.",
      "Из трубы идёт дым.",
      "Из фонтана била вода.",
      "Та гора возвышается над облаками."
    ],
    "sv": [
      "Morgonsolen steg upp.",
      "Det stiger rök ur skorstenen.",
      "Vatten sprutade upp ur fontänen.",
      "Det där berget reser sig över molnen."
    ],
    "tr": [
      "Sabah güneşi doğdu.",
      "Bacadan duman yükseliyor.",
      "Suyla fışkırdı.",
      "Şu dağ bulutların üzerine yükseliyor."
    ],
    "uk": [
      "Зійшло ранкове сонце.",
      "Із димоходу йде дим.",
      "Із фонтану била вода.",
      "Той горб підноситься над хмарами."
    ],
    "vi": [
      "Mặt trời buổi sáng đã mọc.",
      "Khói bốc lên từ ống khói.",
      "Nước phun lên từ đài phun nước.",
      "Ngọn núi đó vươn lên trên những đám mây."
    ],
    "yue": [
      "朝早嘅太陽升起咗。",
      "煙由煙囪度升起。",
      "噴泉度噴出水。",
      "嗰座山高過雲層。"
    ],
    "zh-Hans": [
      "早晨的太阳升起来了。",
      "烟从烟囱里冒出来。",
      "水从喷泉里喷出来了。",
      "那座山耸立在云层之上。"
    ],
