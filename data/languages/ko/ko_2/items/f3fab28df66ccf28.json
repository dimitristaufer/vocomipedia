    {
      "target": "여고생이 버스를 타고 학교에 갑니다.",
      "reading": "yeogosaengi beoseureul tago hakgyoe gamnida.",
      "translations": {
        "en": "The female high school student takes the bus to school.",
        "ko": "여고생이 버스를 타고 학교에 갑니다.",
        "ipa": "yeogosaengi beoseureul tago hakgyoe gamnida.",
        "ar": "تستقل طالبة الثانوية الحافلة إلى المدرسة.",
        "cs": "Studentka střední školy jede autobusem do školy.",
        "da": "En gymnasiepige tager bussen til skolen.",
        "de": "Eine Schülerin fährt mit dem Bus zur Schule.",
        "el": "Μια μαθήτρια λυκείου παίρνει το λεωφορείο για το σχολείο.",
        "es": "Una estudiante de secundaria toma el autobús para ir a la escuela.",
        "fi": "Lukiolaistyttö menee bussilla kouluun.",
        "fr": "Une lycéenne prend le bus pour aller à l'école.",
        "he": "תלמידת תיכון נוסעת באוטובוס לבית הספר.",
        "hi": "एक हाई स्कूल की छात्रा बस से स्कूल जा रही है।",
        "hu": "Egy középiskolás lány busszal megy az iskolába.",
        "id": "Seorang siswi SMA naik bus ke sekolah.",
        "it": "Una studentessa delle superiori prende l'autobus per andare a scuola.",
        "ja": "女子高生がバスで学校に行きます。",
        "nb": "En videregåendeelev tar bussen til skolen.",
        "nl": "Een middelbare scholier neemt de bus naar school.",
        "pl": "Uczennica liceum jedzie autobusem do szkoły.",
        "pt": "Uma estudante do ensino médio pega o ônibus para a escola.",
        "ro": "O elevă de liceu ia autobuzul spre școală.",
        "ru": "Ученица старшей школы едет в школу на автобусе.",
        "sv": "En gymnasietjej åker buss till skolan.",
        "tr": "Bir lise öğrencisi otobüsle okula gidiyor.",
        "uk": "Учениця старшої школи їде до школи автобусом.",
        "vi": "Một nữ sinh trung học đi xe buýt đến trường.",
        "yue": "一個女高中生搭巴士返學。",
        "zh-Hans": "一名女高中生乘公交车去学校。"
      },
