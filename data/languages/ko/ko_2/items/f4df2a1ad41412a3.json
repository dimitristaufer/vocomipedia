    {
      "target": "그는 제 말을 의심했어요.",
      "reading": "geuneun je mareul uisimhasseoyo.",
      "translations": {
        "en": "He doubted what I said.",
        "ko": "그는 제 말을 의심했어요.",
        "ipa": "geuneun je mareul uisimhasseoyo.",
        "ar": "شكك في كلامي.",
        "cs": "Pochyboval o tom, co jsem řekl.",
        "da": "Han tvivlede på det, jeg sagde.",
        "de": "Er zweifelte an dem, was ich sagte.",
        "el": "Αμφέβαλε για ό,τι είπα.",
        "es": "Él dudó de lo que dije.",
