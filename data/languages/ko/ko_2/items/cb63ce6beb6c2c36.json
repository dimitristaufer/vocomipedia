      "لا أعرف لماذا ما زال يبكي."
    ],
    "cs": [
      "Prosím, řekněte mi, proč jste přišel pozdě.",
      "Rozčílil se bez důvodu.",
      "Je na to nějaký dobrý důvod?",
      "Nevím, proč pořád pláče."
    ],
    "da": [
      "Fortæl mig, hvorfor du kom for sent.",
      "Han blev vred uden grund.",
      "Er der en god grund til det?",
      "Jeg ved ikke, hvorfor han stadig græder."
    ],
    "de": [
      "Bitte sagen Sie mir, warum Sie zu spät gekommen sind.",
      "Er wurde ohne Grund wütend.",
      "Gibt es dafür einen guten Grund?",
      "Ich weiß nicht, warum er immer noch weint."
    ],
    "el": [
      "Πείτε μου γιατί αργήσατε.",
      "Θύμωσε χωρίς λόγο.",
      "Υπάρχει κάποιος καλός λόγος γι' αυτό;",
      "Δεν ξέρω γιατί συνεχίζει να κλαίει."
    ],
    "es": [
      "Dime por qué llegaste tarde.",
      "Se enfadó sin motivo.",
      "¿Hay una buena razón para eso?",
      "No sé por qué sigue llorando."
    ],
    "fi": [
      "Kerro, miksi myöhästyit.",
      "Hän suuttui ilman syytä.",
      "Onko siihen jokin hyvä syy?",
      "En tiedä, miksi hän itkee edelleen."
    ],
    "fr": [
      "Dites-moi pourquoi vous êtes arrivé en retard.",
      "Il s'est mis en colère sans raison.",
      "Y a-t-il une bonne raison à cela ?",
      "Je ne sais pas pourquoi il pleure encore."
    ],
    "he": [
      "תגיד לי למה איחרת.",
      "הוא כעס בלי סיבה.",
      "יש לזה סיבה טובה?",
      "אני לא יודע למה הוא עדיין בוכה."
    ],
    "hi": [
      "कृपया बताइए कि आप देर से क्यों आए।",
      "वह बिना वजह गुस्सा हो गया।",
      "क्या इसके लिए कोई अच्छा कारण है?",
      "मुझे नहीं पता कि वह अभी भी क्यों रो रहा है।"
    ],
    "hu": [
      "Kérlek, mondd el, miért késtél.",
      "Indokolatlanul mérges lett.",
      "Van rá valami jó ok?",
      "Nem tudom, miért sír még mindig."
    ],
    "id": [
      "Tolong beri tahu saya mengapa kamu terlambat.",
      "Dia marah tanpa alasan.",
      "Apakah ada alasan yang baik untuk itu?",
      "Saya tidak tahu kenapa dia masih menangis."
    ],
    "it": [
      "Dimmi perché sei arrivato in ritardo.",
      "Si è arrabbiato senza motivo.",
      "C'è un buon motivo per questo?",
      "Non so perché stia ancora piangendo."
    ],
    "ja": [
      "遅れた理由を話してください。",
      "彼は理由もなく怒りました。",
      "それには何かいい理由がありますか。",
      "なぜ彼がまだ泣いているのかわかりません。"
    ],
    "nb": [
      "Fortell meg hvorfor du kom for sent.",
      "Han ble sint uten grunn.",
      "Er det en god grunn til det?",
      "Jeg vet ikke hvorfor han fortsatt gråter."
    ],
    "nl": [
      "Vertel me waarom je te laat kwam.",
      "Hij werd zonder reden boos.",
      "Is daar een goede reden voor?",
      "Ik weet niet waarom hij nog steeds huilt."
    ],
    "pl": [
      "Powiedz mi, dlaczego się spóźniłeś.",
      "Rozgniewał się bez powodu.",
      "Czy jest ku temu jakiś dobry powód?",
      "Nie wiem, dlaczego on nadal płacze."
    ],
    "pt": [
      "Diga-me por que você se atrasou.",
      "Ele ficou com raiva sem motivo.",
      "Há um bom motivo para isso?",
      "Não sei por que ele ainda está chorando."
    ],
    "ro": [
      "Spune-mi de ce ai întârziat.",
      "S-a enervat fără motiv.",
      "Există un motiv bun pentru asta?",
      "Nu știu de ce încă plânge."
    ],
    "ru": [
      "Скажите, почему вы опоздали.",
