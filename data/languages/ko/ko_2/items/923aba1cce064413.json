  "sentences": [
    {
      "target": "그 사람에 대한 편견을 버렸어요.",
      "reading": "geu sarame daehan pyeon-gyeoneul beoryeosseoyo.",
      "translations": {
        "en": "I let go of my prejudice against that person.",
        "ko": "그 사람에 대한 편견을 버렸어요.",
        "ipa": "geu sarame daehan pyeon-gyeoneul beoryeosseoyo.",
        "ar": "تخلّيتُ عن أحكامي المسبقة تجاه ذلك الشخص.",
        "cs": "Zbavil jsem se předsudků vůči tomu člověku.",
        "da": "Jeg slap mine fordomme mod den person.",
        "de": "Ich habe meine Vorurteile gegenüber dieser Person abgelegt.",
        "el": "Άφησα τις προκαταλήψεις μου για αυτόν τον άνθρωπο.",
        "es": "Dejé atrás mi prejuicio contra esa persona.",
        "fi": "Päästin irti ennakkoluuloistani sitä ihmistä kohtaan.",
        "fr": "J’ai abandonné mes préjugés envers cette personne.",
        "he": "ויתרתי על הדעה הקדומה שלי כלפי אותו אדם.",
        "hi": "मैंने उस व्यक्ति के बारे में अपना पूर्वाग्रह छोड़ दिया।",
        "hu": "Elvetettem az előítéleteimet azzal az emberrel kapcsolatban.",
        "id": "Saya melepaskan prasangka saya terhadap orang itu.",
        "it": "Ho abbandonato il mio pregiudizio verso quella persona.",
        "ja": "その人に対する偏見を捨てました。",
        "nb": "Jeg slapp fordommene mine mot den personen.",
        "nl": "Ik heb mijn vooroordelen over die persoon losgelaten.",
        "pl": "Pozbyłem się uprzedzeń wobec tamtej osoby.",
        "pt": "Deixei de lado meu preconceito contra aquela pessoa.",
        "ro": "Mi-am lăsat deoparte prejudecățile față de acea persoană.",
        "ru": "Я избавился от предвзятого отношения к тому человеку.",
        "sv": "Jag släppte mina fördomar mot den personen.",
        "tr": "O kişiye karşı önyargımı bıraktım.",
        "uk": "Я позбувся упередження щодо тієї людини.",
        "vi": "Tôi đã bỏ thành kiến đối với người đó.",
        "yue": "我放低咗對嗰個人嘅偏見。",
        "zh-Hans": "我放下了对那个人的偏见。"
      },
