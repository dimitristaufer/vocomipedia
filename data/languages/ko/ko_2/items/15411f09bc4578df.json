  "sentences": [
    {
      "target": "저는 그 책을 아예 안 읽었어요.",
      "reading": "저는 그 책을 아예 안 읽었어요.",
      "translations": {
        "en": "I didn’t read that book at all.",
        "ko": "저는 그 책을 아예 안 읽었어요.",
        "ipa": "저는 그 책을 아예 안 읽었어요.",
        "ar": "لم أقرأ ذلك الكتاب إطلاقًا.",
        "cs": "Tu knihu jsem vůbec nečetl.",
        "da": "Jeg læste slet ikke den bog.",
        "de": "Ich habe das Buch gar nicht gelesen.",
        "el": "Δεν διάβασα καθόλου εκείνο το βιβλίο.",
        "es": "No leí ese libro en absoluto.",
        "fi": "En lukenut sitä kirjaa lainkaan.",
        "fr": "Je n’ai pas du tout lu ce livre.",
        "he": "לא קראתי את הספר הזה בכלל.",
        "hi": "मैंने वह किताब बिल्कुल नहीं पढ़ी।",
        "hu": "Ezt a könyvet egyáltalán nem olvastam el.",
        "id": "Saya sama sekali tidak membaca buku itu.",
        "it": "Non ho letto affatto quel libro.",
        "ja": "私はその本を全然読みませんでした。",
        "nb": "Jeg leste ikke den boka i det hele tatt.",
        "nl": "Ik heb dat boek helemaal niet gelezen.",
        "pl": "W ogóle nie przeczytałem tej książki.",
        "pt": "Não li esse livro de jeito nenhum.",
        "ro": "Nu am citit deloc cartea aceea.",
        "ru": "Я вообще не читал эту книгу.",
        "sv": "Jag läste inte alls den boken.",
        "tr": "O kitabı hiç okumadım.",
        "uk": "Я взагалі не читав цю книжку.",
        "vi": "Tôi không đọc cuốn sách đó chút nào.",
        "yue": "我完全冇睇過嗰本書。",
        "zh-Hans": "我根本没读那本书。"
      },
