  "sentences": [
    {
      "target": "이 일은 제 적성에 잘 맞아요.",
      "reading": "i ireun je jeokseonge jal majayo.",
      "translations": {
        "en": "This job suits my aptitude well.",
        "ko": "이 일은 제 적성에 잘 맞아요.",
        "ipa": "i ireun je jeokseonge jal majayo.",
        "ar": "هذه الوظيفة تناسب مواهبي جيدًا.",
        "cs": "Tato práce se k mým schopnostem hodí dobře.",
        "da": "Det her job passer godt til mine evner.",
        "de": "Dieser Job passt gut zu meinen Fähigkeiten.",
        "el": "Αυτή η δουλειά ταιριάζει πολύ στις ικανότητές μου.",
        "es": "Este trabajo encaja bien con mi aptitud.",
        "fi": "Tämä työ sopii hyvin minun taitoihini.",
        "fr": "Ce travail correspond bien à mes aptitudes.",
        "he": "העבודה הזאת מתאימה מאוד לכישרון שלי.",
        "hi": "यह काम मेरी क्षमता के लिए बहुत अच्छा है।",
        "hu": "Ez a munka jól illik a képességeimhez.",
        "id": "Pekerjaan ini sangat cocok dengan bakat saya.",
        "it": "Questo lavoro si adatta bene alle mie capacità.",
        "ja": "この仕事は私の適性によく合っています。",
        "nb": "Denne jobben passer godt til mine evner.",
        "nl": "Dit werk past goed bij mijn aanleg.",
        "pl": "Ta praca dobrze pasuje do moich predyspozycji.",
        "pt": "Este trabalho combina bem com a minha aptidão.",
        "ro": "Munca asta se potrivește bine cu aptitudinile mele.",
        "ru": "Эта работа хорошо подходит моим способностям.",
        "sv": "Det här jobbet passar bra för mina förmågor.",
        "tr": "Bu iş yeteneklerime çok uygun.",
        "uk": "Ця робота добре підходить моїм здібностям.",
        "vi": "Công việc này rất hợp với năng khiếu của tôi.",
        "yue": "呢份工作好適合我嘅才能。",
        "zh-Hans": "这份工作很适合我的特长。"
      },
