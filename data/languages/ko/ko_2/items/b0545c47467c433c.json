    {
      "target": "아침에 재채기가 났어요.",
      "reading": "achim-e jaechaegiga nasseoyo.",
      "translations": {
        "en": "I sneezed in the morning.",
        "ko": "아침에 재채기가 났어요.",
        "ipa": "achim-e jaechaegiga nasseoyo.",
        "ar": "عطستُ في الصباح.",
        "cs": "Ráno jsem kýchl.",
        "da": "Jeg nøs om morgenen.",
        "de": "Ich musste am Morgen niesen.",
        "el": "Φτέρνισα το πρωί.",
        "es": "Estornudé por la mañana.",
        "fi": "Aivastin aamulla.",
        "fr": "J'ai éternué le matin.",
        "he": "התעטשתי בבוקר.",
        "hi": "मैंने सुबह छींक मारी।",
        "hu": "Reggel tüsszentettem.",
        "id": "Saya bersin pagi tadi.",
        "it": "Ho starnutito stamattina.",
        "ja": "朝にくしゃみが出ました。",
        "nb": "Jeg nøs om morgenen.",
        "nl": "Ik moest 's ochtends niezen.",
        "pl": "Kichałem rano.",
        "pt": "Espirrei de manhã.",
        "ro": "Am strănutat dimineața.",
        "ru": "Я чихнул утром.",
        "sv": "Jag nös på morgonen.",
        "tr": "Sabah hapşırdım.",
        "uk": "Я чхнув вранці.",
        "vi": "Tôi đã hắt hơi vào buổi sáng.",
        "yue": "我朝早打咗個乞嚏。",
        "zh-Hans": "我早上打了个喷嚏。"
