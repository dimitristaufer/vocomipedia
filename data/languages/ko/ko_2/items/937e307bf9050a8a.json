  "sentences": [
    {
      "target": "엄마가 주전자에 물을 끓여요.",
      "reading": "eommaga jujeonjae mulleul kkeulhyeoyo.",
      "translations": {
        "en": "Mom boils water in the kettle.",
        "ko": "엄마가 주전자에 물을 끓여요.",
        "ipa": "eommaga jujeonjae mulleul kkeulhyeoyo.",
        "ar": "تغلي أمي الماء في الإبريق.",
        "cs": "Maminka vaří v konvici vodu.",
        "da": "Mor koger vand i kedlen.",
        "de": "Mama kocht Wasser im Wasserkocher.",
        "el": "Η μαμά βράζει νερό στον βραστήρα.",
        "es": "Mamá hierve agua en el hervidor.",
        "fi": "Äiti keittää vettä vedenkeittimessä.",
        "fr": "Maman fait bouillir de l'eau dans la bouilloire.",
        "he": "אמא מרתיחה מים בקומקום.",
        "hi": "माँ केतली में पानी उबाल रही है।",
        "hu": "Anya vizet forral a vízforralóban.",
        "id": "Ibu merebus air di dalam ketel.",
        "it": "Mamma fa bollire l'acqua nel bollitore.",
        "ja": "お母さんがやかんでお湯を沸かしています。",
        "nb": "Mamma koker vann i kjelen.",
        "nl": "Mama kookt water in de waterkoker.",
        "pl": "Mama gotuje wodę w czajniku.",
        "pt": "A mãe ferve água na chaleira.",
        "ro": "Mama fierbe apă în ceainic.",
        "ru": "Мама кипятит воду в чайнике.",
        "sv": "Mamma kokar vatten i vattenkokaren.",
        "tr": "Anne suyu su ısıtıcısında kaynatıyor.",
        "uk": "Мама кип’ятить воду в чайнику.",
        "vi": "Mẹ đang đun nước trong ấm.",
        "yue": "阿媽喺煲水壺入面煲水。",
        "zh-Hans": "妈妈在烧水壶里烧水。"
      },
