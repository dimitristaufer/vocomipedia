  "sentences": [
    {
      "target": "아침에 한 끼를 꼭 먹어요.",
      "reading": "아치메 한 끼를 꼭 머거요.",
      "translations": {
        "en": "I make sure to eat one meal in the morning.",
        "ko": "아침에 한 끼를 꼭 먹어요.",
        "ipa": "아치메 한 끼를 꼭 머거요.",
        "ar": "أتناول وجبة واحدة في الصباح دائمًا.",
        "cs": "Ráno si vždycky dám jedno jídlo.",
        "da": "Jeg sørger altid for at spise ét måltid om morgenen.",
        "de": "Ich esse morgens immer eine Mahlzeit.",
        "el": "Φροντίζω πάντα να τρώω ένα γεύμα το πρωί.",
        "es": "Siempre me aseguro de comer una comida por la mañana.",
        "fi": "Syön aina yhden aterian aamulla.",
        "fr": "Je m'assure toujours de prendre un repas le matin.",
        "he": "אני מקפיד לאכול ארוחה אחת בבוקר.",
        "hi": "मैं सुबह एक बार जरूर खाना खाता हूँ।",
        "hu": "Reggel mindig megeszem egy étkezést.",
        "id": "Saya selalu makan satu kali di pagi hari.",
        "it": "La mattina mangio sempre un pasto.",
        "ja": "朝は必ず一食食べます。",
        "nb": "Jeg sørger alltid for å spise ett måltid om morgenen.",
        "nl": "Ik zorg er altijd voor dat ik ’s ochtends een maaltijd eet.",
        "pl": "Zawsze jem rano jeden posiłek.",
        "pt": "Eu sempre como uma refeição de manhã.",
        "ro": "Mă asigur mereu că mănânc o masă dimineața.",
        "ru": "Я всегда ем утром один раз.",
        "sv": "Jag ser alltid till att äta en måltid på morgonen.",
        "tr": "Sabahları mutlaka bir öğün yerim.",
        "uk": "Я завжди снідаю один раз вранці.",
        "vi": "Tôi luôn ăn một bữa vào buổi sáng.",
        "yue": "我朝早一定會食一餐。",
        "zh-Hans": "我早上一定吃一餐。"
      },
