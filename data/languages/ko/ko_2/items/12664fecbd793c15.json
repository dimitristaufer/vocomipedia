    {
      "target": "엄마가 야채를 넣고 국을 끓여요.",
      "reading": "eommaga yachaereul neohgo gukeul kkeulhyeoyo.",
      "translations": {
        "en": "Mom puts vegetables in and cooks soup.",
        "ko": "엄마가 야채를 넣고 국을 끓여요.",
        "ipa": "eommaga yachaereul neohgo gukeul kkeulhyeoyo.",
        "ar": "تضع أمي الخضار وتطبخ الحساء.",
        "cs": "Máma dává do polévky zeleninu a vaří ji.",
        "da": "Mor putter grøntsager i og laver suppe.",
        "de": "Mama gibt Gemüse hinein und kocht Suppe.",
        "el": "Η μαμά βάζει λαχανικά και μαγειρεύει σούπα.",
        "es": "Mamá pone verduras y prepara sopa.",
        "fi": "Äiti laittaa vihanneksia ja keittää keittoa.",
        "fr": "Maman met des légumes et prépare de la soupe.",
        "he": "אמא שמה ירקות ומבשלת מרק.",
        "hi": "माँ सब्ज़ियाँ डालकर सूप पकाती हैं।",
        "hu": "Anya zöldséget tesz bele, és levest főz.",
        "id": "Ibu memasukkan sayuran dan memasak sup.",
        "it": "La mamma mette le verdure e cucina la zuppa.",
        "ja": "お母さんが野菜を入れてスープを作ります。",
        "nb": "Mamma har i grønnsaker og koker suppe.",
        "nl": "Mama doet groente in de soep en kookt die.",
        "pl": "Mama wkłada warzywa i gotuje zupę.",
        "pt": "A minha mãe põe legumes e faz sopa.",
        "ro": "Mama pune legume și gătește supă.",
        "ru": "Мама кладёт овощи и варит суп.",
        "sv": "Mamma lägger i grönsaker och kokar soppa.",
        "tr": "Annem sebze koyup çorba yapıyor.",
        "uk": "Мама кладе овочі й варить суп.",
        "vi": "Mẹ cho rau vào và nấu súp.",
        "yue": "媽媽放菜入去煲湯。",
        "zh-Hans": "妈妈放了蔬菜煮汤。"
      },
