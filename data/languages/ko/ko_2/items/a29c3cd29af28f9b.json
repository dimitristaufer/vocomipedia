    {
      "target": "회의를 내일로 연기했어요.",
      "reading": "hoeuireul naeilro yeongihaesseoyo.",
      "translations": {
        "en": "We postponed the meeting until tomorrow.",
        "ko": "회의를 내일로 연기했어요.",
        "ipa": "hoeuireul naeilro yeongihaesseoyo.",
        "ar": "أجلنا الاجتماع إلى الغد.",
        "cs": "Schůzku jsme odložili na zítřek.",
        "da": "Vi udsatte mødet til i morgen.",
        "de": "Wir haben das Treffen auf morgen verschoben.",
        "el": "Αναβάλαμε τη συνάντηση για αύριο.",
        "es": "Pospusimos la reunión para mañana.",
        "fi": "Siirsimme kokouksen huomiseksi.",
        "fr": "Nous avons reporté la réunion à demain.",
        "he": "דחינו את הפגישה למחר.",
        "hi": "हमने बैठक कल के लिए टाल दी।",
        "hu": "Holnapra halasztottuk a megbeszélést.",
        "id": "Kami menunda rapat sampai besok.",
        "it": "Abbiamo rimandato la riunione a domani.",
        "ja": "会議を明日に延期しました。",
        "nb": "Vi utsatte møtet til i morgen.",
        "nl": "We hebben de vergadering uitgesteld tot morgen.",
        "pl": "Przełożyliśmy spotkanie na jutro.",
        "pt": "Adiamos a reunião para amanhã.",
        "ro": "Am amânat ședința pentru mâine.",
        "ru": "Мы перенесли встречу на завтра.",
        "sv": "Vi sköt upp mötet till i morgon.",
        "tr": "Toplantıyı yarına erteledik.",
        "uk": "Ми перенесли зустріч на завтра.",
        "vi": "Chúng tôi đã hoãn cuộc họp đến ngày mai.",
        "yue": "我哋將會議延到聽日。",
        "zh-Hans": "我们把会议推迟到明天了。"
      },
