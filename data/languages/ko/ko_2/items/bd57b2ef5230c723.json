  "sentences": [
    {
      "target": "같은 실수가 반복되면 안 돼요.",
      "reading": "gateun silsuga banbokdoemyeon an dwaeyo.",
      "translations": {
        "en": "The same mistake must not be repeated.",
        "ko": "같은 실수가 반복되면 안 돼요.",
        "ipa": "gateun silsuga banbokdoemyeon an dwaeyo.",
        "ar": "لا يجب أن يتكرر الخطأ نفسه.",
        "cs": "Stejná chyba se nesmí opakovat.",
        "da": "Den samme fejl må ikke gentages.",
        "de": "Der gleiche Fehler darf nicht wiederholt werden.",
        "el": "Το ίδιο λάθος δεν πρέπει να επαναληφθεί.",
        "es": "No se debe repetir el mismo error.",
        "fi": "Samaa virhettä ei saa toistaa.",
        "fr": "La même erreur ne doit pas se répéter.",
        "he": "אסור לחזור על אותה טעות.",
        "hi": "वही गलती दोहराई नहीं जानी चाहिए।",
        "hu": "Ugyanazt a hibát nem szabad megismételni.",
        "id": "Kesalahan yang sama tidak boleh diulangi.",
        "it": "Lo stesso errore non deve essere ripetuto.",
        "ja": "同じ間違いを繰り返してはいけません。",
        "nb": "Den samme feilen må ikke gjentas.",
        "nl": "Dezelfde fout mag niet worden herhaald.",
        "pl": "Ten sam błąd nie może się powtórzyć.",
        "pt": "O mesmo erro não pode ser repetido.",
        "ro": "Aceeași greșeală nu trebuie repetată.",
        "ru": "Одна и та же ошибка не должна повторяться.",
        "sv": "Samma misstag får inte upprepas.",
        "tr": "Aynı hata tekrarlanmamalı.",
        "uk": "Та сама помилка не повинна повторюватися.",
        "vi": "Lỗi giống nhau không được lặp lại.",
        "yue": "同樣嘅錯誤唔可以再重複。",
        "zh-Hans": "同样的错误不能再重复。"
