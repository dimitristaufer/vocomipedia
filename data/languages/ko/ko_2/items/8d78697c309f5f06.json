    {
      "target": "아이가 금방 잠들었어요.",
      "reading": "aiga geumbang jamdeureosseoyo.",
      "translations": {
        "en": "The child fell asleep quickly.",
        "ko": "아이가 금방 잠들었어요.",
        "ipa": "aiga geumbang jamdeureosseoyo.",
        "ar": "نام الطفل بسرعة.",
        "cs": "Dítě usnulo hned.",
        "da": "Barnet faldt hurtigt i søvn.",
        "de": "Das Kind ist schnell eingeschlafen.",
        "el": "Το παιδί αποκοιμήθηκε γρήγορα.",
        "es": "El niño se durmió enseguida.",
        "fi": "Lapsi nukahti nopeasti.",
