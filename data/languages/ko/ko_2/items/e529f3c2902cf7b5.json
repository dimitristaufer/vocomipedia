        "ipa": "geuneun goeroumeul honja chamasseoyo.",
        "ar": "تحمّل هو الألم وحده.",
        "cs": "Snášel tu tíseň sám.",
        "da": "Han holdt sin smerte ud alene.",
        "de": "Er ertrug den Schmerz allein.",
