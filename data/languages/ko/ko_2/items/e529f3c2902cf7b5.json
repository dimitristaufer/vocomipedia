  "sentences": [
    {
      "target": "그 괴로움이 아직도 남아 있어요.",
      "reading": "geu goeroumi ajikdo nama isseoyo.",
      "translations": {
        "en": "That distress still lingers.",
        "ko": "그 괴로움이 아직도 남아 있어요.",
        "ipa": "geu goeroumi ajikdo nama isseoyo.",
        "ar": "ما زال ذلك الألم العميق باقيًا.",
        "cs": "Ta bolestivá tíseň pořád přetrvává.",
        "da": "Den sorg er der stadig.",
        "de": "Dieser Schmerz ist immer noch da.",
        "el": "Αυτός ο πόνος υπάρχει ακόμα.",
        "es": "Ese sufrimiento todavía sigue ahí.",
        "fi": "Se tuska on yhä jäljellä.",
        "fr": "Cette souffrance est toujours là.",
        "he": "הסבל הזה עדיין נשאר.",
        "hi": "वह पीड़ा अभी भी बाकी है।",
        "hu": "Az a gyötrelem még mindig megmaradt.",
        "id": "Penderitaan itu masih ada.",
        "it": "Quel dolore è ancora lì.",
        "ja": "その苦しみはまだ残っています。",
        "nb": "Den smerten er der fremdeles.",
        "nl": "Dat leed is er nog steeds.",
        "pl": "To cierpienie wciąż tam jest.",
        "pt": "Esse sofrimento ainda continua.",
        "ro": "Suferința aceea încă persistă.",
        "ru": "Такая мука всё ещё осталась.",
        "sv": "Den där smärtan finns kvar än.",
        "tr": "O sıkıntı hâlâ duruyor.",
        "uk": "Такий біль і досі лишається.",
        "vi": "Nỗi đau đó vẫn còn đó.",
        "yue": "嗰種痛苦到而家都仲喺度。",
        "zh-Hans": "那种痛苦到现在还在。"
      },
