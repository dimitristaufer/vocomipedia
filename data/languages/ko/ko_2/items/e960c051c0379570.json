  "sentences": [
    {
      "target": "이 조건이면 할 수 있어요.",
      "reading": "I jogeonimyeon hal su isseoyo.",
      "translations": {
        "en": "I can do it if these are the conditions.",
        "ko": "이 조건이면 할 수 있어요.",
        "ipa": "I jogeonimyeon hal su isseoyo.",
        "ar": "أستطيع فعل ذلك إذا كانت هذه هي الشروط.",
        "cs": "Můžu to udělat, pokud jsou tohle podmínky.",
        "da": "Jeg kan gøre det, hvis det er betingelserne.",
        "de": "Ich kann es machen, wenn das die Bedingungen sind.",
        "el": "Μπορώ να το κάνω αν ισχύουν αυτές οι συνθήκες.",
        "es": "Puedo hacerlo si estas son las condiciones.",
        "fi": "Voin tehdä sen, jos nämä ovat ehdot.",
        "fr": "Je peux le faire si ce sont les conditions.",
        "he": "אני יכול לעשות את זה אם אלה התנאים.",
        "hi": "अगर ये शर्तें हैं, तो मैं यह कर सकता हूँ।",
        "hu": "Meg tudom csinálni, ha ezek a feltételek.",
        "id": "Saya bisa melakukannya kalau ini syaratnya.",
        "it": "Posso farlo se queste sono le condizioni.",
        "ja": "この条件ならできます。",
        "nb": "Jeg kan gjøre det hvis dette er vilkårene.",
        "nl": "Ik kan het doen als dit de voorwaarden zijn.",
        "pl": "Mogę to zrobić, jeśli to są warunki.",
        "pt": "Posso fazer isso se estas forem as condições.",
        "ro": "Pot să fac asta dacă acestea sunt condițiile.",
        "ru": "Я могу это сделать, если это условия.",
        "sv": "Jag kan göra det om det är villkoren.",
        "tr": "Bunlar şartlarsa bunu yapabilirim.",
        "uk": "Я можу це зробити, якщо це умови.",
        "vi": "Tôi có thể làm việc đó nếu đây là các điều kiện.",
        "yue": "如果係呢啲條件，我可以做到。",
        "zh-Hans": "如果是这些条件，我可以做到。"
      },
