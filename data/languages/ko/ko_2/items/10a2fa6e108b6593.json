  "sentences": [
    {
      "target": "그는 요즘 정말 불행하다고 느껴요.",
      "reading": "geuneun yojeum jeongmal bulhaenghadago neukkyeoyo.",
      "translations": {
        "en": "He feels really unhappy these days.",
        "ko": "그는 요즘 정말 불행하다고 느껴요.",
        "ipa": "geuneun yojeum jeongmal bulhaenghadago neukkyeoyo.",
        "ar": "هو يشعر بعدم السعادة حقا هذه الأيام.",
        "cs": "V poslední době se cítí opravdu nešťastný.",
        "da": "Han føler sig virkelig ulykkelig for tiden.",
        "de": "Er fühlt sich in letzter Zeit wirklich unglücklich.",
        "el": "Αισθάνεται πραγματικά δυστυχισμένος αυτές τις μέρες.",
        "es": "Se siente realmente infeliz estos días.",
        "fi": "Hän tuntee olonsa todella onnettomaksi nykyään.",
        "fr": "Il se sent vraiment malheureux ces jours-ci.",
        "he": "הוא מרגיש ממש אומלל בימים האלה.",
        "hi": "वह इन दिनों सचमुच दुखी महसूस करता है।",
        "hu": "Mostanában igazán boldogtalan.",
        "id": "Dia merasa sangat tidak bahagia akhir-akhir ini.",
        "it": "Si sente davvero infelice in questi giorni.",
        "ja": "彼は最近、本当に不幸だと感じています。",
        "nb": "Han føler seg virkelig ulykkelig i disse dager.",
        "nl": "Hij voelt zich de laatste tijd echt ongelukkig.",
        "pl": "On czuje się ostatnio naprawdę nieszczęśliwy.",
        "pt": "Ele se sente realmente infeliz ultimamente.",
        "ro": "Se simte cu adevărat nefericit în zilele astea.",
        "ru": "В последнее время он чувствует себя очень несчастным.",
        "sv": "Han känner sig verkligen olycklig nuförtiden.",
        "tr": "Son zamanlarda gerçekten mutsuz hissediyor.",
        "uk": "Останнім часом він почувається дуже нещасним.",
        "vi": "Anh ấy cảm thấy rất không hạnh phúc dạo này.",
        "yue": "佢呢排真係覺得好唔開心。",
        "zh-Hans": "他最近真的感到很不幸福。"
      },
