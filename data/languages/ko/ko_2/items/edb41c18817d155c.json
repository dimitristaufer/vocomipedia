    {
      "target": "차가 길가에 잠시 멈췄어요.",
      "reading": "chaga gilgae jamsi meomchwosseoyo.",
      "translations": {
        "en": "The car stopped by the roadside for a moment.",
        "ko": "차가 길가에 잠시 멈췄어요.",
        "ipa": "chaga gilgae jamsi meomchwosseoyo.",
        "ar": "توقفت السيارة بجانب الطريق للحظة.",
        "cs": "Auto na chvíli zastavilo u silnice.",
        "da": "Bilen stoppede et øjeblik ved vejkanten.",
        "de": "Das Auto hielt kurz am Straßenrand an.",
        "el": "Το αυτοκίνητο σταμάτησε για λίγο στην άκρη του δρόμου.",
        "es": "El coche se detuvo un momento al borde de la carretera.",
        "fi": "Auto pysähtyi hetkeksi tien reunaan.",
        "fr": "La voiture s'est arrêtée un moment au bord de la route.",
        "he": "המכונית עצרה לרגע בצד הדרך.",
        "hi": "कार थोड़ी देर के लिए सड़क किनारे रुकी।",
        "hu": "Az autó egy pillanatra megállt az út szélén.",
        "id": "Mobil itu berhenti sebentar di pinggir jalan.",
        "it": "L'auto si è fermata per un momento sul ciglio della strada.",
        "ja": "車が道ばたに少し止まりました。",
        "nb": "Bilen stoppet et øyeblikk ved veikanten.",
        "nl": "De auto stopte even langs de weg.",
        "pl": "Samochód na chwilę zatrzymał się przy drodze.",
        "pt": "O carro parou por um momento à beira da estrada.",
        "ro": "Mașina s-a oprit pentru un moment pe marginea drumului.",
        "ru": "Машина на минуту остановилась у дороги.",
        "sv": "Bilen stannade en stund vid vägkanten.",
        "tr": "Araba yol kenarında bir süre durdu.",
        "uk": "Автомобіль на мить зупинився біля дороги.",
        "vi": "Chiếc xe dừng lại bên đường một lát.",
        "yue": "架車喺路邊停咗一陣。",
        "zh-Hans": "汽车在路边停了一会儿。"
      },
