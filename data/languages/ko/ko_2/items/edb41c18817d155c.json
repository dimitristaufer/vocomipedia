  "sentences": [
    {
      "target": "아이는 길가에 앉아 쉬고 있어요.",
      "reading": "aineun gilgae anja swigo isseoyo.",
      "translations": {
        "en": "The child is sitting by the roadside and resting.",
        "ko": "아이는 길가에 앉아 쉬고 있어요.",
        "ipa": "aineun gilgae anja swigo isseoyo.",
        "ar": "يجلس الطفل بجانب الطريق ويرتاح.",
        "cs": "Dítě sedí u silnice a odpočívá.",
        "da": "Barnet sidder ved vejkanten og hviler sig.",
        "de": "Das Kind sitzt am Straßenrand und ruht sich aus.",
        "el": "Το παιδί κάθεται στην άκρη του δρόμου και ξεκουράζεται.",
        "es": "El niño está sentado al borde de la carretera y descansa.",
        "fi": "Lapsi istuu tien reunassa ja lepää.",
        "fr": "L'enfant est assis au bord de la route et se repose.",
        "he": "הילד יושב בצד הדרך ונח.",
        "hi": "बच्चा सड़क किनारे बैठकर आराम कर रहा है।",
        "hu": "A gyerek az út szélén ül és pihen.",
        "id": "Anak itu duduk di pinggir jalan dan beristirahat.",
        "it": "Il bambino è seduto sul ciglio della strada e si riposa.",
        "ja": "子どもが道ばたに座って休んでいます。",
        "nb": "Barnet sitter ved veikanten og hviler seg.",
        "nl": "Het kind zit langs de weg en rust uit.",
        "pl": "Dziecko siedzi przy drodze i odpoczywa.",
        "pt": "A criança está sentada à beira da estrada e descansando.",
        "ro": "Copilul stă pe marginea drumului și se odihnește.",
        "ru": "Ребёнок сидит у дороги и отдыхает.",
        "sv": "Barnet sitter vid vägkanten och vilar sig.",
        "tr": "Çocuk yol kenarında oturup dinleniyor.",
        "uk": "Дитина сидить біля дороги й відпочиває.",
        "vi": "Đứa trẻ đang ngồi nghỉ bên đường.",
        "yue": "個細路坐喺路邊休息。",
        "zh-Hans": "孩子坐在路边休息。"
      },
