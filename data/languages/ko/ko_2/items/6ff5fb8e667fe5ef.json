  "sentences": [
    {
      "target": "그런 존재는 본 적이 없어요.",
      "reading": "geureon jonjaeneun bon jeogi eopseoyo",
      "translations": {
        "en": "I've never seen such a being.",
        "ko": "그런 존재는 본 적이 없어요.",
        "ipa": "geureon jonjaeneun bon jeogi eopseoyo",
        "ar": "لم أرَ مخلوقًا كهذا من قبل.",
        "cs": "Takovou bytost jsem nikdy neviděl.",
        "da": "Jeg har aldrig set sådan et væsen før.",
        "de": "So ein Wesen habe ich noch nie gesehen.",
        "el": "Δεν έχω δει ποτέ ένα τέτοιο ον.",
        "es": "Nunca he visto un ser así.",
        "fi": "En ole koskaan nähnyt tuollaista olentoa.",
        "fr": "Je n'ai jamais vu un être pareil.",
        "he": "מעולם לא ראיתי יצור כזה.",
        "hi": "मैंने ऐसा कोई जीव कभी नहीं देखा।",
        "hu": "Még soha nem láttam ilyen lényt.",
        "id": "Saya belum pernah melihat makhluk seperti itu.",
        "it": "Non ho mai visto una creatura del genere.",
        "ja": "そんな存在は見たことがありません。",
        "nb": "Jeg har aldri sett et slikt vesen.",
        "nl": "Ik heb nog nooit zo'n wezen gezien.",
        "pl": "Nigdy nie widziałem takiej istoty.",
        "pt": "Nunca vi um ser assim.",
        "ro": "Nu am văzut niciodată o ființă ca asta.",
        "ru": "Я никогда не видел такого существа.",
        "sv": "Jag har aldrig sett en sådan varelse.",
        "tr": "Böyle bir varlık hiç görmedim.",
        "uk": "Я ніколи не бачив такої істоти.",
        "vi": "Tôi chưa từng thấy một sinh vật như thế.",
        "yue": "我未見過咁嘅存在。",
        "zh-Hans": "我从没见过那样的存在。"
      },
