  "sentences": [
    {
      "target": "선생님은 학생의 실수를 부드럽게 비판했다.",
      "reading": "seonsaengnimeun haksaengui silsureul bu-deubge bipanhaetda.",
      "translations": {
        "en": "The teacher criticized the student's mistake gently.",
        "ko": "선생님은 학생의 실수를 부드럽게 비판했다.",
        "ipa": "seonsaengnimeun haksaengui silsureul bu-deubge bipanhaetda.",
        "ar": "انتقد المعلم خطأ الطالب بلطف.",
        "cs": "Učitel jemně zkritizoval studentovu chybu.",
        "da": "Læreren kritiserede elevens fejl blidt.",
        "de": "Der Lehrer kritisierte den Fehler des Schülers sanft.",
        "el": "Ο δάσκαλος επέκρινε απαλά το λάθος του μαθητή.",
        "es": "El profesor criticó con suavidad el error del alumno.",
        "fi": "Opettaja arvosteli lempeästi oppilaan virhettä.",
        "fr": "Le professeur a critiqué doucement l'erreur de l'élève.",
        "he": "המורה ביקר בעדינות את הטעות של התלמיד.",
