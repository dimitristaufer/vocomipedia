  "sentences": [
    {
      "target": "밤에는 소음이 거의 없어요.",
      "reading": "bameneun soeumi geoui eopseoyo.",
      "translations": {
        "en": "There is hardly any noise at night.",
        "ko": "밤에는 소음이 거의 없어요.",
        "ipa": "bameneun soeumi geoui eopseoyo.",
        "ar": "يكاد لا يكون هناك أي ضجيج ليلًا.",
        "cs": "V noci je tu skoro žádný hluk.",
        "da": "Der er næsten ingen støj om natten.",
        "de": "Nachts gibt es kaum Lärm.",
        "el": "Τη νύχτα σχεδόν δεν υπάρχει θόρυβος.",
        "es": "Por la noche casi no hay ruido.",
        "fi": "Yöllä on melkein ei melua.",
        "fr": "La nuit, il y a presque pas de bruit.",
        "he": "בלילה כמעט אין רעש.",
        "hi": "रात में लगभग कोई शोर नहीं होता।",
        "hu": "Éjjel szinte nincs zaj.",
        "id": "Di malam hari hampir tidak ada suara bising.",
        "it": "Di notte c'è quasi nessun rumore.",
        "ja": "夜はほとんど騒音がありません。",
        "nb": "Det er nesten ingen støy om natten.",
        "nl": "'s Nachts is er bijna geen lawaai.",
        "pl": "W nocy prawie nie ma hałasu.",
        "pt": "À noite, quase não há barulho.",
        "ro": "Noaptea, aproape că nu este zgomot.",
        "ru": "Ночью почти нет шума.",
        "sv": "På natten är det nästan inget oväsen.",
        "tr": "Gece neredeyse hiç gürültü yok.",
        "uk": "Уночі майже немає шуму.",
        "vi": "Ban đêm hầu như không có tiếng ồn.",
        "yue": "夜晚幾乎冇乜噪音。",
        "zh-Hans": "晚上几乎没有噪音。"
      },
