  "sentences": [
    {
      "target": "병원에서 태아의 심장 소리를 들었어요.",
      "reading": "byeongwoneseo taeaui simjang sorireul deureosseoyo.",
      "translations": {
        "en": "I heard the fetus's heartbeat at the hospital.",
        "ko": "병원에서 태아의 심장 소리를 들었어요.",
        "ipa": "byeongwoneseo taeaui simjang sorireul deureosseoyo.",
        "ar": "سمعت نبض قلب الجنين في المستشفى.",
        "cs": "V nemocnici jsem slyšel tlukot srdce plodu.",
        "da": "Jeg hørte fosterets hjerteslag på hospitalet.",
        "de": "Im Krankenhaus hörte ich den Herzschlag des Fötus.",
        "el": "Άκουσα τον καρδιακό παλμό του εμβρύου στο νοσοκομείο.",
        "es": "Escuché los latidos del feto en el hospital.",
        "fi": "Kuulin sikiön sydämenlyönnit sairaalassa.",
        "fr": "J'ai entendu les battements du cœur du fœtus à l'hôpital.",
        "he": "שמעתי את דופק הלב של העובר בבית החולים.",
        "hi": "मैंने अस्पताल में भ्रूण की धड़कन सुनी।",
        "hu": "A kórházban hallottam a magzat szívverését.",
        "id": "Saya mendengar detak jantung janin di rumah sakit.",
        "it": "Ho sentito il battito del feto in ospedale.",
        "ja": "病院で胎児の心音を聞きました。",
        "nb": "Jeg hørte fosterets hjerteslag på sykehuset.",
        "nl": "Ik hoorde in het ziekenhuis de hartslag van de foetus.",
        "pl": "W szpitalu usłyszałem bicie serca płodu.",
        "pt": "Ouvi os batimentos cardíacos do feto no hospital.",
        "ro": "Am auzit bătăile inimii fătului la spital.",
        "ru": "В больнице я услышал(а) сердцебиение плода.",
        "sv": "Jag hörde fostrets hjärtslag på sjukhuset.",
        "tr": "Hastanede fetüsün kalp atışını duydum.",
        "uk": "У лікарні я почув(ла) серцебиття плода.",
        "vi": "Tôi đã nghe tim thai của thai nhi ở bệnh viện.",
        "yue": "我喺醫院聽到胎兒嘅心跳。",
        "zh-Hans": "我在医院听到了胎儿的心跳。"
      },
