  "sentences": [
    {
      "target": "대합실에서 기차를 기다리고 있어요.",
      "reading": "daehapsileseo gichareul gidaligo isseoyo.",
      "translations": {
        "en": "I'm waiting for the train in the waiting room.",
        "ko": "대합실에서 기차를 기다리고 있어요.",
        "ipa": "daehapsileseo gichareul gidaligo isseoyo.",
        "ar": "أنا أنتظر القطار في قاعة الانتظار.",
        "cs": "Čekám na vlak v čekárně.",
        "da": "Jeg venter på toget i venteværelset.",
        "de": "Ich warte im Warteraum auf den Zug.",
        "el": "Περιμένω το τρένο στην αίθουσα αναμονής.",
        "es": "Estoy esperando el tren en la sala de espera.",
        "fi": "Odotan junaa odotushuoneessa.",
        "fr": "J'attends le train dans la salle d'attente.",
        "he": "אני מחכה לרכבת בחדר ההמתנה.",
        "hi": "मैं प्रतीक्षालय में ट्रेन का इंतज़ार कर रहा हूँ।",
        "hu": "A váróteremben várom a vonatot.",
        "id": "Saya sedang menunggu kereta di ruang tunggu.",
        "it": "Sto aspettando il treno in sala d'attesa.",
        "ja": "待合室で電車を待っています。",
        "nb": "Jeg venter på toget i venterommet.",
        "nl": "Ik wacht in de wachtkamer op de trein.",
        "pl": "Czekam na pociąg w poczekalni.",
        "pt": "Estou esperando o trem na sala de espera.",
        "ro": "Aștept trenul în sala de așteptare.",
        "ru": "Я жду поезд в зале ожидания.",
        "sv": "Jag väntar på tåget i väntrummet.",
        "tr": "Bekleme salonunda treni bekliyorum.",
        "uk": "Я чекаю на поїзд у залі очікування.",
        "vi": "Tôi đang đợi tàu ở phòng chờ.",
        "yue": "我喺候車室等緊火車。",
        "zh-Hans": "我在候车室等火车。"
      },
