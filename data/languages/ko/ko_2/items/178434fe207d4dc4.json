  "sentences": [
    {
      "target": "추운 바람에 코끝이 빨개졌어요.",
      "reading": "chuun barame kokkeuti ppalgaejyeosseoyo.",
      "translations": {
        "en": "My nose tip turned red in the cold wind.",
        "ko": "추운 바람에 코끝이 빨개졌어요.",
        "ipa": "chuun barame kokkeuti ppalgaejyeosseoyo.",
        "ar": "أصبح طرف أنفي أحمر بسبب الرياح الباردة.",
        "cs": "Na špičce nosu mi v chladném větru zčervenala kůže.",
        "da": "Min næsetip blev rød af den kolde vind.",
        "de": "Meine Nasenspitze wurde in dem kalten Wind rot.",
        "el": "Η άκρη της μύτης μου κοκκίνισε από το κρύο αεράκι.",
        "es": "La punta de mi nariz se puso roja con el viento frío.",
        "fi": "Nenäni kärki punastui kylmässä tuulessa.",
        "fr": "Le bout de mon nez est devenu rouge à cause du vent froid.",
        "he": "קצה האף שלי האדים מהרוח הקרה.",
        "hi": "ठंडी हवा से मेरी नाक की नोक लाल हो गई।",
        "hu": "A hideg szélben kipirosodott az orrom hegye.",
        "id": "Ujung hidungku memerah karena angin dingin.",
        "it": "La punta del mio naso è diventata rossa per il vento freddo.",
        "ja": "寒い風で鼻先が赤くなりました。",
        "nb": "Nesetippen min ble rød av den kalde vinden.",
        "nl": "Mijn neuspunt werd rood van de koude wind.",
        "pl": "Czubek mojego nosa zrobił się czerwony na zimnym wietrze.",
        "pt": "A ponta do meu nariz ficou vermelha com o vento frio.",
        "ro": "Vârful nasului mi s-a înroșit din cauza vântului rece.",
        "ru": "От холодного ветра у меня покраснел кончик носа.",
        "sv": "Min nästipp blev röd av den kalla vinden.",
        "tr": "Soğuk rüzgârda burnumun ucu kızardı.",
        "uk": "Від холодного вітру в мене почервонів кінчик носа.",
        "vi": "Đầu mũi tôi đỏ lên vì gió lạnh.",
        "yue": "寒風令我個鼻尖紅咗。",
        "zh-Hans": "寒风把我的鼻尖吹红了。"
      },
