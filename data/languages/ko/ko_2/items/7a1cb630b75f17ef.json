  "sentences": [
    {
      "target": "커피가 순식간에 식었어요.",
      "reading": "keopiga sunsikgane sigeosseoyo.",
      "translations": {
        "en": "The coffee cooled in an instant.",
        "ko": "커피가 순식간에 식었어요.",
        "ipa": "keopiga sunsikgane sigeosseoyo.",
        "ar": "برد القهوة في لحظة.",
        "cs": "Káva vychladla během okamžiku.",
        "da": "Kaffen blev kold på et øjeblik.",
        "de": "Der Kaffee war in einem Augenblick kalt.",
        "el": "Ο καφές κρύωσε σε μια στιγμή.",
        "es": "El café se enfrió en un instante.",
        "fi": "Kahvi jäähtyi hetkessä.",
        "fr": "Le café a refroidi en un instant.",
        "he": "הקפה התקרר בן רגע.",
        "hi": "कॉफी पल भर में ठंडी हो गई।",
        "hu": "A kávé egy pillanat alatt kihűlt.",
        "id": "Kopinya dingin seketika.",
        "it": "Il caffè si è raffreddato in un attimo.",
        "ja": "コーヒーはあっという間に冷めました。",
        "nb": "Kaffen ble kald på et øyeblikk.",
        "nl": "De koffie werd in een oogwenk koud.",
        "pl": "Kawa w mgnieniu oka wystygła.",
        "pt": "O café esfriou num instante.",
        "ro": "Cafeaua s-a răcit într-o clipă.",
        "ru": "Кофе мгновенно остыл.",
        "sv": "Kaffet blev kallt på en sekund.",
        "tr": "Kahve bir anda soğudu.",
        "uk": "Кава миттєво охолола.",
        "vi": "Cà phê nguội đi trong chớp mắt.",
        "yue": "咖啡一瞬間就凍咗。",
        "zh-Hans": "咖啡一下子就凉了。"
      },
