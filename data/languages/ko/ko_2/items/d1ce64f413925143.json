    {
      "target": "저는 주말마다 봉사 활동을 해요.",
      "reading": "jeoneun jumalmada bongsa hwaldongeul haeyo.",
      "translations": {
        "en": "I do volunteer work every weekend.",
        "ko": "저는 주말마다 봉사 활동을 해요.",
        "ipa": "jeoneun jumalmada bongsa hwaldongeul haeyo.",
        "ar": "أقوم بالعمل التطوعي كل عطلة نهاية أسبوع.",
        "cs": "Každý víkend dělám dobrovolnickou činnost.",
        "da": "Jeg laver frivilligt arbejde hver weekend.",
        "de": "Ich mache jedes Wochenende Freiwilligenarbeit.",
        "el": "Κάθε Σαββατοκύριακο κάνω εθελοντική εργασία.",
        "es": "Hago voluntariado todos los fines de semana.",
        "fi": "Teen vapaaehtoistyötä joka viikonloppu.",
        "fr": "Je fais du bénévolat tous les week-ends.",
        "he": "אני עושה עבודת התנדבות כל סוף שבוע.",
        "hi": "मैं हर वीकेंड स्वयंसेवा करता हूँ।",
        "hu": "Minden hétvégén önkéntes munkát végzek.",
        "id": "Saya melakukan kerja sukarela setiap akhir pekan.",
        "it": "Faccio volontariato ogni fine settimana.",
        "ja": "私は毎週末ボランティア活動をしています。",
        "nb": "Jeg driver med frivillig arbeid hver helg.",
        "nl": "Ik doe elk weekend vrijwilligerswerk.",
        "pl": "Co weekend robię wolontariat.",
        "pt": "Faço trabalho voluntário todos os fins de semana.",
        "ro": "Fac voluntariat în fiecare weekend.",
        "ru": "Каждые выходные я занимаюсь волонтёрством.",
        "sv": "Jag gör volontärarbete varje helg.",
        "tr": "Her hafta sonu gönüllü çalışma yapıyorum.",
        "uk": "Щовихідних я займаюся волонтерством.",
        "vi": "Tôi làm tình nguyện mỗi cuối tuần.",
        "yue": "我每個週末都做義工。",
        "zh-Hans": "我每个周末都做志愿活动。"
      },
