  "sentences": [
    {
      "target": "저는 상금을 받고 너무 기뻤어요.",
      "reading": "jeoneun sanggeumeul batgo neomu gippeosseoyo.",
      "translations": {
        "en": "I was so happy to receive the prize money.",
        "ko": "저는 상금을 받고 너무 기뻤어요.",
        "ipa": "jeoneun sanggeumeul batgo neomu gippeosseoyo.",
        "ar": "كنت سعيدًا جدًا عندما تلقيت الجائزة المالية.",
        "cs": "Když jsem dostal peněžní odměnu, měl jsem velkou radost.",
        "da": "Jeg blev så glad, da jeg fik præmiepengene.",
        "de": "Ich habe mich sehr gefreut, als ich das Preisgeld bekommen habe.",
        "el": "Χάρηκα πάρα πολύ όταν πήρα το χρηματικό έπαθλο.",
        "es": "Estuve muy feliz de recibir el premio en dinero.",
        "fi": "Olin tosi iloinen, kun sain palkintorahat.",
        "fr": "J’étais tellement content d’avoir reçu l’argent du prix.",
        "he": "הייתי כל כך שמח שקיבלתי את כספי הפרס.",
        "hi": "मुझे इनाम की रकम मिलने पर बहुत खुशी हुई।",
        "hu": "Nagyon örültem, hogy megkaptam a pénzjutalmat.",
        "id": "Saya sangat senang saat menerima uang hadiah.",
        "it": "Sono stato molto felice di ricevere il premio in denaro.",
        "ja": "賞金をもらってとても嬉しかったです。",
        "nb": "Jeg ble så glad da jeg fikk premiepengene.",
        "nl": "Ik was zo blij toen ik het prijzengeld kreeg.",
        "pl": "Byłem tak szczęśliwy, kiedy dostałem nagrodę pieniężną.",
        "pt": "Fiquei muito feliz ao receber o prêmio em dinheiro.",
        "ro": "Am fost foarte fericit când am primit premiul în bani.",
        "ru": "Я был так рад, когда получил денежный приз.",
        "sv": "Jag blev så glad när jag fick prispengarna.",
        "tr": "Ödül parasını alınca çok mutlu oldum.",
        "uk": "Я був такий радий, коли отримав грошовий приз.",
        "vi": "Tôi rất vui khi nhận được tiền thưởng.",
        "yue": "我攞到獎金嗰陣好開心。",
        "zh-Hans": "我拿到奖金时非常高兴。"
      },
