    {
      "target": "제 핸드백 안에 지갑이 있어요.",
      "reading": "je haendeubaek ane jigabi isseoyo.",
      "translations": {
        "en": "My wallet is in my handbag.",
        "ko": "제 핸드백 안에 지갑이 있어요.",
        "ipa": "je haendeubaek ane jigabi isseoyo.",
        "ar": "محفظتي في حقيبة يدي.",
        "cs": "Moje peněženka je v mé kabelce.",
        "da": "Min pung ligger i min håndtaske.",
        "de": "Meine Geldbörse ist in meiner Handtasche.",
        "el": "Το πορτοφόλι μου είναι μέσα στην τσάντα μου.",
        "es": "Mi cartera está en mi bolso.",
        "fi": "Lompakkoni on käsilaukussani.",
        "fr": "Mon portefeuille est dans mon sac à main.",
        "he": "הארנק שלי נמצא בתיק היד שלי.",
        "hi": "मेरा बटुआ मेरे हैंडबैग में है।",
        "hu": "A pénztárcám a kézitáskámban van.",
        "id": "Dompet saya ada di dalam tas tangan saya.",
        "it": "Il mio portafoglio è nella mia borsa.",
        "ja": "私のハンドバッグの中に財布があります。",
        "nb": "Lommeboken min ligger i håndvesken min.",
        "nl": "Mijn portemonnee zit in mijn handtas.",
        "pl": "Mój portfel jest w mojej torebce.",
        "pt": "Minha carteira está na minha bolsa.",
        "ro": "Portofelul meu este în geanta mea.",
        "ru": "Мой кошелёк в моей сумочке.",
        "sv": "Min plånbok ligger i min handväska.",
        "tr": "Cüzdanım çantamın içinde.",
        "uk": "Мій гаманець у моїй сумочці.",
        "vi": "Ví của tôi ở trong túi xách của tôi.",
        "yue": "我個銀包喺我個手袋入面。",
        "zh-Hans": "我的钱包在我的手提包里。"
      },
