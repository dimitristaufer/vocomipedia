    {
      "target": "엄마가 새 핸드백을 선물해 주셨어요.",
      "reading": "eommaga sae haendeubaeg-eul seonmulhae jusyeosseoyo.",
      "translations": {
        "en": "My mom gave me a new handbag as a gift.",
        "ko": "엄마가 새 핸드백을 선물해 주셨어요.",
        "ipa": "eommaga sae haendeubaeg-eul seonmulhae jusyeosseoyo.",
        "ar": "أهدتني أمي حقيبة يد جديدة.",
        "cs": "Maminka mi dala novou kabelku jako dárek.",
        "da": "Min mor gav mig en ny håndtaske i gave.",
        "de": "Meine Mutter hat mir eine neue Handtasche geschenkt.",
        "el": "Η μαμά μου μού χάρισε μια καινούρια τσάντα.",
        "es": "Mi mamá me regaló un bolso nuevo.",
        "fi": "Äitini antoi minulle lahjaksi uuden käsilaukun.",
        "fr": "Ma mère m'a offert un nouveau sac à main.",
        "he": "אמא שלי נתנה לי תיק יד חדש במתנה.",
        "hi": "मेरी माँ ने मुझे एक नया हैंडबैग उपहार में दिया।",
        "hu": "Anyukám egy új kézitáskát adott nekem ajándékba.",
        "id": "Ibu saya memberi saya tas tangan baru sebagai hadiah.",
        "it": "Mia madre mi ha regalato una borsa nuova.",
        "ja": "母が新しいハンドバッグをプレゼントしてくれました。",
        "nb": "Mamma ga meg en ny håndveske i gave.",
        "nl": "Mijn moeder heeft me een nieuwe handtas cadeau gedaan.",
        "pl": "Mama podarowała mi nową torebkę.",
        "pt": "Minha mãe me deu uma bolsa nova de presente.",
        "ro": "Mama mi-a dăruit o geantă nouă.",
        "ru": "Мама подарила мне новую сумочку.",
        "sv": "Min mamma gav mig en ny handväska i present.",
        "tr": "Annem bana yeni bir çanta hediye etti.",
        "uk": "Мама подарувала мені нову сумочку.",
        "vi": "Mẹ tôi đã tặng tôi một cái túi xách mới.",
        "yue": "我媽媽送咗個新手袋畀我。",
        "zh-Hans": "妈妈送了我一个新手提包。"
      },
