    {
      "target": "가게에서 핸드백을 샀어요.",
      "reading": "gageeseo haendeubaeg-eul sasseoyo.",
      "translations": {
        "en": "I bought a handbag at the store.",
        "ko": "가게에서 핸드백을 샀어요.",
        "ipa": "gageeseo haendeubaeg-eul sasseoyo.",
        "ar": "اشتريت حقيبة يد من المتجر.",
        "cs": "Koupil jsem si v obchodě kabelku.",
        "da": "Jeg købte en håndtaske i butikken.",
        "de": "Ich habe im Laden eine Handtasche gekauft.",
        "el": "Αγόρασα μια τσάντα από το μαγαζί.",
        "es": "Compré un bolso en la tienda.",
        "fi": "Ostin käsilaukun kaupasta.",
        "fr": "J'ai acheté un sac à main au magasin.",
        "he": "קניתי תיק יד בחנות.",
        "hi": "मैंने दुकान से एक हैंडबैग खरीदा।",
        "hu": "Vettem egy kézitáskát az üzletben.",
        "id": "Saya membeli tas tangan di toko.",
        "it": "Ho comprato una borsa al negozio.",
        "ja": "店でハンドバッグを買いました。",
        "nb": "Jeg kjøpte en håndveske i butikken.",
        "nl": "Ik heb een handtas gekocht in de winkel.",
        "pl": "Kupiłem torebkę w sklepie.",
        "pt": "Comprei uma bolsa na loja.",
        "ro": "Am cumpărat o geantă de mână de la magazin.",
        "ru": "Я купил сумочку в магазине.",
        "sv": "Jag köpte en handväska i butiken.",
        "tr": "Mağazadan bir çanta aldım.",
        "uk": "Я купив сумочку в магазині.",
        "vi": "Tôi đã mua một cái túi xách ở cửa hàng.",
        "yue": "我喺舖頭買咗個手袋。",
        "zh-Hans": "我在店里买了一个手提包。"
      },
