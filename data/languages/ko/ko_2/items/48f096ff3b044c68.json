  "sentences": [
    {
      "target": "저는 셔츠를 세탁소에 맡겼어요.",
      "reading": "jeoneun syeoteureul setaksoe majgyeosseoyo.",
      "translations": {
        "en": "I left my shirt at the laundromat.",
        "ko": "저는 셔츠를 세탁소에 맡겼어요.",
        "ipa": "jeoneun syeoteureul setaksoe majgyeosseoyo.",
        "ar": "تركت قميصي في المغسلة.",
        "cs": "Nechal jsem košili v prádelně.",
        "da": "Jeg afleverede min skjorte på vaskeriet.",
        "de": "Ich habe mein Hemd in die Reinigung gebracht.",
        "el": "Άφησα το πουκάμισό μου στο καθαριστήριο.",
        "es": "Dejé mi camisa en la tintorería.",
        "fi": "Jätin paitani pesulaan.",
        "fr": "J'ai laissé ma chemise au pressing.",
        "he": "השארתי את החולצה שלי במכבסה.",
        "hi": "मैंने अपनी शर्ट लॉन्ड्री में छोड़ दी।",
        "hu": "Otthagytam az ingemet a tisztítóban.",
        "id": "Saya meninggalkan kemeja saya di penatu.",
        "it": "Ho lasciato la mia camicia in lavanderia.",
        "ja": "私はシャツをクリーニング店に預けました。",
        "nb": "Jeg leverte skjorten min på renseriet.",
        "nl": "Ik heb mijn overhemd bij de stomerij afgegeven.",
        "pl": "Zostawiłem koszulę w pralni.",
        "pt": "Deixei minha camisa na lavanderia.",
        "ro": "Mi-am lăsat cămașa la curățătorie.",
        "ru": "Я оставил рубашку в прачечной.",
        "sv": "Jag lämnade in min skjorta på tvättomaten.",
        "tr": "Gömleğimi çamaşırhaneye bıraktım.",
        "uk": "Я залишив свою сорочку в пральні.",
        "vi": "Tôi đã để áo sơ mi ở tiệm giặt.",
        "yue": "我將件恤衫放咗喺洗衣店。",
        "zh-Hans": "我把衬衫放在洗衣店了。"
      },
