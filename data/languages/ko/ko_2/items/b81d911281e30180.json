  "sentences": [
    {
      "target": "정신이 없어서 지갑을 놓고 왔어요.",
      "reading": "jeongsini eopseoseo jigabeul nohgo wasseoyo.",
      "translations": {
        "en": "I was so distracted that I left my wallet behind.",
        "ko": "정신이 없어서 지갑을 놓고 왔어요.",
        "ipa": "jeongsini eopseoseo jigabeul nohgo wasseoyo.",
        "ar": "كنت مشتتًا جدًا حتى إنني تركت محفظتي ورائي.",
        "cs": "Byl jsem tak rozptýlený, že jsem nechal peněženku doma.",
        "da": "Jeg var så distraheret, at jeg glemte min pung.",
        "de": "Ich war so abgelenkt, dass ich meine Brieftasche liegen gelassen habe.",
        "el": "Ήμουν τόσο αφηρημένος που άφησα το πορτοφόλι μου πίσω.",
        "es": "Estaba tan distraído que me dejé la cartera.",
        "fi": "Olin niin hajamielinen, että jätin lompakkoni kotiin.",
        "fr": "J'étais tellement distrait que j'ai oublié mon portefeuille.",
        "he": "הייתי כל כך מוסח דעת שהשארתי את הארנק מאחור.",
        "hi": "मैं इतना ध्यान भटका हुआ था कि अपना बटुआ वहीं छोड़ आया।",
        "hu": "Annyira szétszórt voltam, hogy otthon hagytam a pénztárcámat.",
        "id": "Saya begitu teralihkan sampai-sampai saya meninggalkan dompet saya.",
        "it": "Ero così distratto che ho lasciato il portafoglio a casa.",
        "ja": "ぼんやりしていて財布を置いてきてしまいました。",
        "nb": "Jeg var så distré at jeg glemte lommeboken min.",
        "nl": "Ik was zo afgeleid dat ik mijn portemonnee had laten liggen.",
        "pl": "Byłem tak roztargniony, że zostawiłem portfel w domu.",
        "pt": "Eu estava tão distraído que deixei a carteira para trás.",
        "ro": "Eram atât de distras, încât mi-am lăsat portofelul acasă.",
        "ru": "Я был так рассеян, что оставил кошелёк дома.",
        "sv": "Jag var så disträ att jag glömde min plånbok.",
        "tr": "O kadar dalgındım ki cüzdanımı unutup geldim.",
        "uk": "Я був такий розсіяний, що залишив гаманець удома.",
        "vi": "Tôi đã quá đãng trí nên để quên ví ở nhà.",
        "yue": "我太分心，攞漏咗銀包。",
        "zh-Hans": "我太分心了，把钱包落下了。"
      },
