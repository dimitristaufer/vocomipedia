  "sentences": [
    {
      "target": "산책을 하면 스트레스 해소에 좋아요.",
      "reading": "sanchaeg-eul hamyeon seuteureseu haesoe joh-ayo.",
      "translations": {
        "en": "A walk is good for relieving stress.",
        "ko": "산책을 하면 스트레스 해소에 좋아요.",
        "ipa": "sanchaeg-eul hamyeon seuteureseu haesoe joh-ayo.",
        "ar": "المشي مفيد لتخفيف التوتر.",
        "cs": "Procházka je dobrá na odbourání stresu.",
        "da": "En gåtur er god til at afstresse.",
        "de": "Ein Spaziergang ist gut, um Stress abzubauen.",
        "el": "Η βόλτα είναι καλή για να μειώνει το στρες.",
        "es": "Un paseo es bueno para aliviar el estrés.",
        "fi": "Kävely on hyväksi stressin helpottamiseen.",
        "fr": "Une promenade est bonne pour se détendre.",
        "he": "הליכה טובה להפגת מתחים.",
        "hi": "टहलना तनाव कम करने के लिए अच्छा है।",
        "hu": "A séta jó a stressz oldására.",
        "id": "Jalan-jalan baik untuk menghilangkan stres.",
        "it": "Una passeggiata fa bene per scaricare lo stress.",
        "ja": "散歩をするとストレス解消になります。",
        "nb": "En spasertur er bra for å redusere stress.",
        "nl": "Een wandeling is goed om stress te verminderen.",
        "pl": "Spacer jest dobry na stres.",
        "pt": "Uma caminhada é boa para aliviar o estresse.",
        "ro": "O plimbare este bună pentru a reduce stresul.",
        "ru": "Прогулка помогает снять стресс.",
        "sv": "En promenad är bra för att minska stress.",
        "tr": "Yürüyüş, stresi azaltmak için iyidir.",
        "uk": "Прогулянка допомагає зняти стрес.",
        "vi": "Đi bộ rất tốt để giảm căng thẳng.",
        "yue": "散步有助舒緩壓力。",
        "zh-Hans": "散步有助于缓解压力。"
      },
