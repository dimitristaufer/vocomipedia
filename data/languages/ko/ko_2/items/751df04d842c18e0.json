  "sentences": [
    {
      "target": "이 뉴스는 전국적 관심을 끌었어요.",
      "reading": "i nyuseuneun jeongukjeok gwansimeul kkeureosseoyo.",
      "translations": {
        "en": "This news drew nationwide attention.",
        "ko": "이 뉴스는 전국적 관심을 끌었어요.",
        "ipa": "i nyuseuneun jeongukjeok gwansimeul kkeureosseoyo.",
        "ar": "هذا الخبر جذب اهتمامًا على مستوى البلاد.",
        "cs": "Tato zpráva vzbudila celostátní pozornost.",
        "da": "Denne nyhed vakte landsdækkende opmærksomhed.",
        "de": "Diese Nachricht erregte landesweite Aufmerksamkeit.",
        "el": "Αυτή η είδηση τράβηξε το ενδιαφέρον σε όλη τη χώρα.",
        "es": "Esta noticia atrajo la atención en todo el país.",
        "fi": "Tämä uutinen herätti valtakunnallista huomiota.",
        "fr": "Cette nouvelle a attiré l'attention dans tout le pays.",
        "he": "החדשות האלה משכו תשומת לב בכל רחבי הארץ.",
        "hi": "इस खबर ने पूरे देश का ध्यान खींचा।",
        "hu": "Ez a hír országos figyelmet keltett.",
        "id": "Berita ini menarik perhatian nasional.",
        "it": "Questa notizia ha attirato l'attenzione in tutto il paese.",
        "ja": "このニュースは全国的な関心を集めました。",
        "nb": "Denne nyheten vakte oppmerksomhet over hele landet.",
        "nl": "Dit nieuws trok landelijke aandacht.",
        "pl": "Ta wiadomość wzbudziła ogólnokrajowe zainteresowanie.",
        "pt": "Esta notícia chamou a atenção em todo o país.",
        "ro": "Această știre a atras atenția în toată țara.",
        "ru": "Эта новость привлекла внимание по всей стране.",
        "sv": "Den här nyheten väckte uppmärksamhet i hela landet.",
        "tr": "Bu haber ülke çapında ilgi çekti.",
        "uk": "Ця новина привернула увагу по всій країні.",
        "vi": "Tin tức này đã thu hút sự chú ý trên toàn quốc.",
        "yue": "呢單新聞引起咗全國關注。",
        "zh-Hans": "这条新闻引起了全国关注。"
      },
