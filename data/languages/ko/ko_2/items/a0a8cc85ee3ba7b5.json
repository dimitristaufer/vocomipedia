  "sentences": [
    {
      "target": "어제부터 눈병에 걸렸어요.",
      "reading": "eojebuteo nunbyeonge geollyeosseoyo.",
      "translations": {
        "en": "I got an eye infection yesterday.",
        "ko": "어제부터 눈병에 걸렸어요.",
        "ipa": "eojebuteo nunbyeonge geollyeosseoyo.",
        "ar": "أُصبتُ بعدوى في العين منذ أمس.",
        "cs": "Od včerejška mám zánět spojivek.",
        "da": "Jeg fik en øjeninfektion i går.",
        "de": "Ich habe seit gestern eine Augeninfektion.",
        "el": "Έπαθα μόλυνση στο μάτι από χθες.",
        "es": "Tengo una infección en el ojo desde ayer.",
        "fi": "Minulla on ollut silmätulehdus eilisestä asti.",
        "fr": "J'ai une infection à l'œil depuis hier.",
        "he": "יש לי דלקת עיניים מאתמול.",
        "hi": "मुझे कल से आँख का संक्रमण है।",
        "hu": "Tegnap óta szemfertőzésem van.",
        "id": "Saya terkena infeksi mata sejak kemarin.",
        "it": "Ho un'infezione agli occhi da ieri.",
        "ja": "昨日から目の感染症にかかっています。",
        "nb": "Jeg fikk en øyeinfeksjon i går.",
        "nl": "Ik heb sinds gisteren een ooginfectie.",
        "pl": "Mam infekcję oka od wczoraj.",
        "pt": "Estou com uma infecção no olho desde ontem.",
        "ro": "Am o infecție la ochi de ieri.",
        "ru": "У меня с вчерашнего дня инфекция глаза.",
        "sv": "Jag fick en ögoninfektion i går.",
        "tr": "Dünden beri göz enfeksiyonum var.",
        "uk": "У мене від учора інфекція ока.",
        "vi": "Tôi bị nhiễm trùng mắt từ hôm qua.",
        "yue": "我由噚日開始有眼部感染。",
        "zh-Hans": "我从昨天开始得了眼部感染。"
      },
