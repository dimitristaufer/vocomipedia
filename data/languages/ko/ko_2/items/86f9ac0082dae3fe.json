  "sentences": [
    {
      "target": "엄마가 제 실수를 용서했어요.",
      "reading": "eommaga je silsureul yongseohaesseoyo.",
      "translations": {
        "en": "Mom forgave my mistake.",
        "ko": "엄마가 제 실수를 용서했어요.",
        "ipa": "eommaga je silsureul yongseohaesseoyo.",
        "ar": "سامحت أمي على خطئي.",
        "cs": "Máma mi odpustila chybu.",
        "da": "Min mor tilgav min fejl.",
        "de": "Mama hat mir meinen Fehler verziehen.",
        "el": "Η μαμά συγχώρεσε το λάθος μου.",
        "es": "Mamá perdonó mi error.",
        "fi": "Äiti antoi virheeni anteeksi.",
        "fr": "Maman a pardonné ma faute.",
        "he": "אמא סלחה לי על הטעות שלי.",
        "hi": "माँ ने मेरी गलती माफ कर दी।",
        "hu": "Anya megbocsátotta a hibámat.",
        "id": "Ibu memaafkan kesalahan saya.",
        "it": "Mamma ha perdonato il mio errore.",
        "ja": "お母さんは私の失敗を許してくれました。",
        "nb": "Mamma tilga feilen min.",
        "nl": "Mijn moeder heeft mijn fout vergeven.",
        "pl": "Mama wybaczyła mój błąd.",
        "pt": "A minha mãe perdoou o meu erro.",
        "ro": "Mama mi-a iertat greșeala.",
        "ru": "Мама простила мне мою ошибку.",
        "sv": "Mamma förlät mitt misstag.",
        "tr": "Annem hatamı affetti.",
        "uk": "Мама пробачила мені мою помилку.",
        "vi": "Mẹ đã tha thứ cho lỗi lầm của tôi.",
        "yue": "媽媽原諒咗我嘅錯誤。",
        "zh-Hans": "妈妈原谅了我的错误。"
      },
