    {
      "target": "그는 분노를 꾹 참았다.",
      "reading": "geuneun bunnoreul kkok chamatda.",
      "translations": {
        "en": "He held back his anger.",
        "ko": "그는 분노를 꾹 참았다.",
        "ipa": "geuneun bunnoreul kkok chamatda.",
        "ar": "كبح غضبه بقوة.",
        "cs": "Držel svůj hněv na uzdě.",
        "da": "Han holdt sin vrede tilbage.",
        "de": "Er hielt seine Wut zurück.",
        "el": "Κράτησε με κόπο τον θυμό του.",
        "es": "Contuvo su rabia.",
        "fi": "Hän pidätti vihansa.",
        "fr": "Il a réprimé sa colère.",
        "he": "הוא עצר את הכעס שלו בכוח.",
        "hi": "उसने अपना गुस्सा रोक लिया।",
        "hu": "Nagy nehezen visszafojtotta a dühét.",
        "id": "Dia menahan amarahnya.",
        "it": "Trattenne a fatica la sua rabbia.",
        "ja": "彼は怒りをぐっとこらえた。",
        "nb": "Han holdt igjen vreden sin.",
        "nl": "Hij hield zijn woede in.",
        "pl": "Powstrzymał swój gniew.",
        "pt": "Ele conteve sua raiva.",
        "ro": "Și-a stăpânit cu greu furia.",
        "ru": "Он сдержал свой гнев.",
        "sv": "Han höll tillbaka sin ilska.",
        "tr": "Öfkesini zor tuttu.",
        "uk": "Він стримав свій гнів.",
        "vi": "Anh ấy kìm nén cơn giận.",
        "yue": "佢忍住咗怒火。",
        "zh-Hans": "他强忍着怒火。"
      },
