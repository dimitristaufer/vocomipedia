    {
      "target": "오늘은 버스 정비를 합니다.",
      "reading": "oneureun beoseu jeongbireul hamnida.",
      "translations": {
        "en": "We’re maintaining the bus today.",
        "ko": "오늘은 버스 정비를 합니다.",
        "ipa": "oneureun beoseu jeongbireul hamnida.",
        "ar": "نقوم بصيانة الحافلة اليوم.",
        "cs": "Dnes provádíme údržbu autobusu.",
        "da": "Vi vedligeholder bussen i dag.",
        "de": "Heute warten wir den Bus.",
        "el": "Σήμερα κάνουμε συντήρηση στο λεωφορείο.",
        "es": "Hoy hacemos mantenimiento al autobús.",
        "fi": "Huollamme bussia tänään.",
        "fr": "Nous faisons l'entretien du bus aujourd'hui.",
        "he": "אנחנו מתחזקים היום את האוטובוס.",
        "hi": "आज हम बस की मरम्मत कर रहे हैं।",
        "hu": "Ma az autóbusz karbantartását végezzük.",
        "id": "Kami sedang merawat bus hari ini.",
        "it": "Oggi facciamo la manutenzione dell'autobus.",
        "ja": "今日はバスの整備をします。",
        "nb": "Vi utfører vedlikehold på bussen i dag.",
        "nl": "We onderhouden de bus vandaag.",
        "pl": "Dziś robimy przegląd autobusu.",
        "pt": "Hoje vamos fazer a manutenção do ônibus.",
        "ro": "Astăzi facem întreținerea autobuzului.",
        "ru": "Сегодня мы обслуживаем автобус.",
        "sv": "Vi servar bussen i dag.",
        "tr": "Bugün otobüsün bakımını yapıyoruz.",
        "uk": "Сьогодні ми обслуговуємо автобус.",
        "vi": "Hôm nay chúng tôi bảo dưỡng xe buýt.",
        "yue": "我哋今日維修巴士。",
        "zh-Hans": "我们今天保养公交车。"
      },
