  "sentences": [
    {
      "target": "어제 이모가 잠깐 다녀가셨어요.",
      "reading": "eoje imoga jamkkan danyeogaseosseoyo.",
      "translations": {
        "en": "My aunt stopped by briefly yesterday.",
        "ko": "어제 이모가 잠깐 다녀가셨어요.",
        "ipa": "eoje imoga jamkkan danyeogaseosseoyo.",
        "ar": "زارتني عمتي أمس زيارة قصيرة.",
        "cs": "Teta se včera na chvíli zastavila.",
        "da": "Min tante kiggede forbi i går et øjeblik.",
        "de": "Meine Tante hat gestern kurz vorbeigeschaut.",
        "el": "Η θεία μου πέρασε χτες για λίγο.",
        "es": "Mi tía pasó un momento ayer.",
        "fi": "Tätini kävi eilen hetkisen.",
        "fr": "Ma tante est passée un moment hier.",
        "he": "הדודה שלי קפצה לביקור קצר אתמול.",
        "hi": "मेरी मौसी कल थोड़ी देर के लिए आई थीं।",
        "hu": "A nagynéném tegnap rövid időre benézett.",
        "id": "Bibi saya mampir sebentar kemarin.",
        "it": "Mia zia è passata un attimo ieri.",
        "ja": "おばが昨日少し寄っていきました。",
        "nb": "Tanten min stakk innom en kort tur i går.",
        "nl": "Mijn tante kwam gisteren even langs.",
        "pl": "Moja ciotka wpadła wczoraj na chwilę.",
        "pt": "Minha tia passou aqui ontem por um instante.",
        "ro": "Mătușa mea a trecut ieri pe la noi pentru puțin timp.",
        "ru": "Моя тётя вчера ненадолго заглянула.",
        "sv": "Min moster tittade förbi en stund i går.",
        "tr": "Halam dün kısa bir süreliğine uğradı.",
        "uk": "Моя тітка вчора ненадовго заходила.",
        "vi": "Dì tôi ghé qua một lát hôm qua.",
        "yue": "我阿姨噚日順便嚟咗一陣。",
        "zh-Hans": "我姨妈昨天顺路来了一会儿。"
      },
