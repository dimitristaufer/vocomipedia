  "sentences": [
    {
      "target": "어제 어떤 사람이 길에서 저를 욕했어요.",
      "reading": "eoje eotteon sarami gileseo jeoreul yokhaesseoyo",
      "translations": {
        "en": "Yesterday, someone insulted me on the street.",
        "ko": "어제 어떤 사람이 길에서 저를 욕했어요.",
        "ipa": "eoje eotteon sarami gileseo jeoreul yokhaesseoyo",
        "ar": "أمس، شتمني شخص في الشارع.",
        "cs": "Včera mě na ulici nějaký člověk urazil.",
        "da": "I går fornærmede en person mig på gaden.",
        "de": "Gestern hat mich jemand auf der Straße beleidigt.",
        "el": "Χθες κάποιος με έβρισε στον δρόμο.",
        "es": "Ayer, alguien me insultó en la calle.",
        "fi": "Eilen joku haukkui minua kadulla.",
        "fr": "Hier, quelqu'un m'a insulté dans la rue.",
        "he": "אתמול מישהו קילל אותי ברחוב.",
        "hi": "कल किसी ने मुझे सड़क पर गाली दी।",
        "hu": "Tegnap valaki megsértett az utcán.",
        "id": "Kemarin, seseorang menghina saya di jalan.",
        "it": "Ieri qualcuno mi ha insultato per strada.",
        "ja": "昨日、ある人が道で私をののしりました。",
        "nb": "I går fornærmet en person meg på gaten.",
        "nl": "Gisteren heeft iemand me op straat uitgescholden.",
        "pl": "Wczoraj ktoś mnie obraził na ulicy.",
        "pt": "Ontem, alguém me insultou na rua.",
        "ro": "Ieri, cineva m-a insultat pe stradă.",
        "ru": "Вчера кто-то оскорбил меня на улице.",
        "sv": "I går förolämpade någon mig på gatan.",
        "tr": "Dün birisi sokakta bana hakaret etti.",
        "uk": "Учора хтось образив мене на вулиці.",
        "vi": "Hôm qua, có người đã chửi tôi trên đường.",
        "yue": "噚日有個人喺街上鬧我。",
        "zh-Hans": "昨天有人在街上骂我。"
      },
