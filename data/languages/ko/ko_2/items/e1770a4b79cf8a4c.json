  "sentences": [
    {
      "target": "주말에 가족과 유적을 보러 갔어요.",
      "reading": "jumare gajokgwa yujeogeul boreo gasseoyo.",
      "translations": {
        "en": "I went to see the ruins with my family on the weekend.",
        "ko": "주말에 가족과 유적을 보러 갔어요.",
        "ipa": "jumare gajokgwa yujeogeul boreo gasseoyo.",
        "ar": "ذهبت مع عائلتي في عطلة نهاية الأسبوع لرؤية الآثار.",
        "cs": "O víkendu jsem šel s rodinou podívat se na ruiny.",
        "da": "Jeg tog med min familie for at se ruinerne i weekenden.",
        "de": "Ich bin am Wochenende mit meiner Familie zu den Ruinen gegangen.",
        "el": "Πήγα με την οικογένειά μου να δω τα ερείπια το Σαββατοκύριακο.",
        "es": "Fui a ver las ruinas con mi familia el fin de semana.",
        "fi": "Lähdin viikonloppuna perheeni kanssa katsomaan raunioita.",
        "fr": "Je suis allé voir les ruines avec ma famille le week-end.",
        "he": "הלכתי לראות את השרידים עם המשפחה שלי בסוף השבוע.",
        "hi": "मैं सप्ताहांत में अपने परिवार के साथ खंडहर देखने गया।",
        "hu": "Hétvégén a családommal elmentem megnézni a romokat.",
        "id": "Saya pergi melihat reruntuhan bersama keluarga pada akhir pekan.",
        "it": "Sono andato a vedere le rovine con la mia famiglia nel fine settimana.",
        "ja": "週末に家族と遺跡を見に行きました。",
        "nb": "Jeg dro for å se ruinene med familien min i helgen.",
        "nl": "Ik ging in het weekend met mijn gezin de ruïnes bekijken.",
        "pl": "Pojechałem z rodziną zobaczyć ruiny w weekend.",
        "pt": "Fui ver as ruínas com a minha família no fim de semana.",
        "ro": "Am mers cu familia să văd ruinele în weekend.",
        "ru": "Я пошёл с семьёй смотреть на руины в выходные.",
        "sv": "Jag åkte med min familj för att titta på ruinerna i helgen.",
        "tr": "Hafta sonu ailemle kalıntıları görmeye gittim.",
        "uk": "Я пішов із сім’єю подивитися на руїни на вихідних.",
        "vi": "Tôi đã đi xem di tích cùng gia đình vào cuối tuần.",
        "yue": "我週末同屋企人去睇遺跡。",
        "zh-Hans": "周末我和家人去看了遗迹。"
      },
