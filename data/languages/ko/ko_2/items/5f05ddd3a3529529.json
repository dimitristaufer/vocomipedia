    {
      "target": "아이의 노랫소리가 방 안에 퍼져요.",
      "reading": "aiui noraetsoriga bang ane peojyeoyo.",
      "translations": {
        "en": "The child's singing voice fills the room.",
        "ko": "아이의 노랫소리가 방 안에 퍼져요.",
        "ipa": "aiui noraetsoriga bang ane peojyeoyo.",
        "ar": "يملأ صوت غناء الطفل الغرفة.",
        "cs": "Dětský zpěv zaplní celou místnost.",
        "da": "Barnets sangstemme fylder rummet.",
        "de": "Die Singstimme des Kindes erfüllt den Raum.",
        "el": "Η τραγουδιστική φωνή του παιδιού γεμίζει το δωμάτιο.",
        "es": "La voz cantando del niño llena la habitación.",
        "fi": "Lapsen lauluääni täyttää huoneen.",
        "fr": "La voix chantante de l'enfant remplit la pièce.",
        "he": "קול השירה של הילד ממלא את החדר.",
        "hi": "बच्चे की गाने की आवाज़ कमरे में फैल जाती है।",
        "hu": "A gyerek énekhangja betölti a szobát.",
        "id": "Suara nyanyian anak itu memenuhi ruangan.",
        "it": "La voce cantata del bambino riempie la stanza.",
        "ja": "子どもの歌声が部屋に広がります。",
        "nb": "Barnets sangstemme fyller rommet.",
        "nl": "De zangstem van het kind vult de kamer.",
        "pl": "Głos śpiewającego dziecka wypełnia pokój.",
        "pt": "A voz cantada da criança enche o quarto.",
        "ro": "Vocea de cântat a copilului umple camera.",
        "ru": "Пение ребёнка наполняет комнату.",
        "sv": "Barnets sångröst fyller rummet.",
        "tr": "Çocuğun şarkı sesi odayı dolduruyor.",
        "uk": "Спів дитини наповнює кімнату.",
        "vi": "Giọng hát của đứa trẻ lan khắp phòng.",
        "yue": "小朋友嘅歌聲傳滿咗成間房。",
        "zh-Hans": "孩子的歌声充满了房间。"
      },
