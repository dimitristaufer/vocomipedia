    {
      "target": "저녁때 가족이 같이 밥을 먹어요.",
      "reading": "jeonyeokttae gajogi gachi babeul meogeoyo.",
      "translations": {
        "en": "My family eats dinner together in the evening.",
        "ko": "저녁때 가족이 같이 밥을 먹어요.",
        "ipa": "jeonyeokttae gajogi gachi babeul meogeoyo.",
        "ar": "تأكل عائلتي العشاء معًا في المساء.",
        "cs": "Moje rodina večeří spolu večer.",
        "da": "Min familie spiser aftensmad sammen om aftenen.",
        "de": "Meine Familie isst abends zusammen zu Abend.",
        "el": "Η οικογένειά μου τρώει μαζί το βράδυ.",
        "es": "Mi familia cena junta por la noche.",
        "fi": "Perheeni syö illallista yhdessä illalla.",
        "fr": "Ma famille dîne ensemble le soir.",
        "he": "המשפחה שלי אוכלת יחד ארוחת ערב בערב.",
        "hi": "मेरा परिवार शाम को साथ में खाना खाता है।",
        "hu": "A családom este együtt vacsorázik.",
        "id": "Keluarga saya makan malam bersama pada malam hari.",
        "it": "La mia famiglia cena insieme la sera.",
        "ja": "夕方に家族でいっしょにご飯を食べます。",
        "nb": "Familien min spiser middag sammen om kvelden.",
        "nl": "Mijn familie eet 's avonds samen eten.",
        "pl": "Moja rodzina je razem kolację wieczorem.",
        "pt": "Minha família janta junta à noite.",
        "ro": "Familia mea ia cina împreună seara.",
        "ru": "Моя семья ужинает вместе вечером.",
        "sv": "Min familj äter middag tillsammans på kvällen.",
        "tr": "Ailem akşamları birlikte yemek yer.",
        "uk": "Моя родина вечеряє разом увечері.",
        "vi": "Gia đình tôi ăn tối cùng nhau vào buổi tối.",
        "yue": "我哋屋企人黃昏時一齊食晚飯。",
        "zh-Hans": "我的家人晚上一起吃饭。"
      },
