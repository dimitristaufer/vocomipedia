    "he": [
      "אני אשלם על הסיבוב הזה.",
      "בואו ננסה שוב בסיבוב הבא.",
      "זה נגמר בשלושה סיבובים.",
      "אם נעשה עוד סיבוב אחד, ננצח."
    ],
    "hi": [
      "इस बार मैं पैसे दूँगा।",
      "चलो अगली बारी में फिर कोशिश करते हैं।",
      "यह तीन पारियों में खत्म हो गया।",
      "अगर हम एक और बारी खेलें, तो हम जीतेंगे।"
    ],
    "hu": [
      "Ezt a kört én fizetem.",
      "Próbáljuk meg újra a következő körben.",
      "Három menetben véget ért.",
      "Ha még egy kört játszunk, nyerünk."
    ],
    "id": [
      "Kali ini saya yang bayar.",
      "Ayo coba lagi di putaran berikutnya.",
      "Itu berakhir dalam tiga inning.",
      "Kalau kita main satu ronde lagi, kita akan menang."
    ],
    "it": [
      "Offro io questo giro.",
      "Riproviamo al prossimo turno.",
      "È finita in tre inning.",
      "Se facciamo un altro giro, vinciamo."
    ],
    "ja": [
      "今回は私が払います。",
      "次の回でまたやってみましょう。",
      "三回で終わりました。",
      "あと一回やれば勝てます。"
    ],
    "nb": [
      "Jeg betaler denne runden.",
      "La oss prøve igjen i neste runde.",
      "Det endte i tre omganger.",
      "Hvis vi tar én runde til, vinner vi."
    ],
    "nl": [
      "Ik betaal deze ronde.",
