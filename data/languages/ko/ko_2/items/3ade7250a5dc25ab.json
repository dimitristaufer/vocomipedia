    "cs": [
      "Tentokrát zaplatím já.",
      "Zkusme to znovu v dalším kole.",
      "Skončilo to ve třech směnách.",
      "Když dáme ještě jedno kolo, vyhrajeme."
    ],
    "da": [
      "Jeg betaler denne gang.",
      "Lad os prøve igen i næste runde.",
      "Det sluttede i tre innings.",
      "Hvis vi tager én runde mere, vinder vi."
    ],
    "de": [
      "Diesmal zahle ich.",
      "Lass es uns in der nächsten Runde noch mal versuchen.",
      "Es war nach drei Innings vorbei.",
      "Wenn wir noch eine Runde spielen, gewinnen wir."
    ],
    "el": [
      "Αυτή τη φορά θα πληρώσω εγώ.",
      "Ας το δοκιμάσουμε ξανά στον επόμενο γύρο.",
      "Τελείωσε σε τρεις περιόδους.",
      "Αν κάνουμε έναν γύρο ακόμα, θα κερδίσουμε."
    ],
    "es": [
      "Esta ronda la pago yo.",
      "Vamos a intentarlo otra vez en la siguiente ronda.",
      "Terminó en tres entradas.",
      "Si hacemos una ronda más, ganaremos."
    ],
    "fi": [
      "Minä maksan tällä kertaa.",
      "Yritetään uudelleen seuraavalla kierroksella.",
      "Se päättyi kolmeen vuoroon.",
