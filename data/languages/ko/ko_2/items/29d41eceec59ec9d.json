    {
      "target": "오늘 점심으로 일식을 먹었어요.",
      "reading": "oneul jeomsimeuro ilsigeul meogeosseoyo.",
      "translations": {
        "en": "I ate Japanese food for lunch today.",
        "ko": "오늘 점심으로 일식을 먹었어요.",
        "ipa": "oneul jeomsimeuro ilsigeul meogeosseoyo.",
        "ar": "أكلت طعامًا يابانيًا على الغداء اليوم.",
        "cs": "Dnes jsem měl k obědu japonské jídlo.",
        "da": "Jeg spiste japansk mad til frokost i dag.",
        "de": "Ich habe heute zum Mittagessen japanisches Essen gegessen.",
        "el": "Έφαγα ιαπωνικό φαγητό για μεσημεριανό σήμερα.",
        "es": "Hoy comí comida japonesa para almorzar.",
        "fi": "Söin tänään lounaaksi japanilaista ruokaa.",
        "fr": "J'ai mangé de la cuisine japonaise pour le déjeuner aujourd'hui.",
        "he": "אכלתי אוכל יפני לארוחת צהריים היום.",
        "hi": "आज दोपहर के खाने में मैंने जापानी खाना खाया।",
        "hu": "Ma japán ételt ettem ebédre.",
        "id": "Saya makan makanan Jepang untuk makan siang hari ini.",
        "it": "Oggi ho mangiato cibo giapponese a pranzo.",
        "ja": "今日は昼ごはんに和食を食べました。",
        "nb": "Jeg spiste japansk mat til lunsj i dag.",
        "nl": "Ik heb vandaag Japanse gerechten gegeten als lunch.",
        "pl": "Zjadłem dziś na obiad japońskie jedzenie.",
        "pt": "Comi comida japonesa no almoço hoje.",
        "ro": "Am mâncat mâncare japoneză la prânz astăzi.",
        "ru": "Сегодня я ел японскую еду на обед.",
        "sv": "Jag åt japansk mat till lunch i dag.",
        "tr": "Bugün öğle yemeğinde Japon yemeği yedim.",
        "uk": "Сьогодні я їв японську їжу на обід.",
        "vi": "Hôm nay tôi đã ăn đồ Nhật vào bữa trưa.",
        "yue": "今日午飯我食咗日本菜。",
        "zh-Hans": "我今天午饭吃了日本菜。"
      },
