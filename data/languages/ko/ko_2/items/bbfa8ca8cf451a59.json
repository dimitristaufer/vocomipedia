  "sentences": [
    {
      "target": "독감에 걸려서 학교에 못 갔어요.",
      "reading": "dokgame geollyeoseo hakgyoe mot gasseoyo.",
      "translations": {
        "en": "I got the flu, so I couldn't go to school.",
        "ko": "독감에 걸려서 학교에 못 갔어요.",
        "ipa": "dokgame geollyeoseo hakgyoe mot gasseoyo.",
        "ar": "أُصبتُ بالإنفلونزا، فلم أستطع الذهاب إلى المدرسة.",
        "cs": "Dostal jsem chřipku, takže jsem nemohl do školy.",
        "da": "Jeg fik influenza, så jeg kunne ikke komme i skole.",
        "de": "Ich habe Grippe bekommen, deshalb konnte ich nicht zur Schule gehen.",
        "el": "Έπαθα γρίπη, οπότε δεν μπόρεσα να πάω σχολείο.",
        "es": "Me dio gripe, así que no pude ir a la escuela.",
        "fi": "Sain influenssan, joten en voinut mennä kouluun.",
        "fr": "J’ai eu la grippe, alors je n’ai pas pu aller à l’école.",
        "he": "חליתי בשפעת, אז לא יכולתי ללכת לבית הספר.",
        "hi": "मुझे फ्लू हो गया, इसलिए मैं स्कूल नहीं जा सका।",
        "hu": "Elkaptam az influenzát, ezért nem tudtam iskolába menni.",
        "id": "Saya kena flu, jadi saya tidak bisa pergi ke sekolah.",
        "it": "Ho preso l'influenza, quindi non sono potuto andare a scuola.",
        "ja": "インフルエンザにかかって、学校に行けませんでした。",
        "nb": "Jeg fikk influensa, så jeg kunne ikke gå på skolen.",
        "nl": "Ik heb griep gehad, dus ik kon niet naar school.",
        "pl": "Dostałem grypę, więc nie mogłem iść do szkoły.",
        "pt": "Fiquei com gripe, então não pude ir à escola.",
        "ro": "Am făcut gripă, așa că n-am putut merge la școală.",
        "ru": "Я заболел гриппом, поэтому не смог пойти в школу.",
        "sv": "Jag fick influensa, så jag kunde inte gå till skolan.",
        "tr": "Gribe yakalandım, bu yüzden okula gidemedim.",
        "uk": "Я захворів на грип, тому не зміг піти до школи.",
        "vi": "Tôi bị cúm nên không thể đến trường.",
        "yue": "我患咗流感，所以冇得返學。",
        "zh-Hans": "我得了流感，所以没能去学校。"
      },
