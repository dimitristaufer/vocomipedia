  "sentences": [
    {
      "target": "가게는 오늘 이익이 많이 났어요.",
      "reading": "가게는 오늘 이익이 많이 났어요.",
      "translations": {
        "en": "The store made a big profit today.",
        "ko": "가게는 오늘 이익이 많이 났어요.",
        "ipa": "가게는 오늘 이익이 많이 났어요.",
        "ar": "حقّق المتجر ربحًا كبيرًا اليوم.",
        "cs": "Obchod dnes dosáhl velkého zisku.",
        "da": "Butikken fik stort overskud i dag.",
        "de": "Der Laden hat heute viel Gewinn gemacht.",
        "el": "Το μαγαζί είχε σήμερα μεγάλο κέρδος.",
        "es": "La tienda tuvo muchas ganancias hoy.",
        "fi": "Kauppa teki tänään paljon voittoa.",
        "fr": "Le magasin a fait beaucoup de profit aujourd'hui.",
        "he": "החנות הרוויחה היום הרבה.",
        "hi": "दुकान ने आज बहुत मुनाफा कमाया।",
        "hu": "Az üzlet ma nagy nyereséget ért el.",
        "id": "Toko itu mendapat untung besar hari ini.",
        "it": "Il negozio oggi ha fatto un grande guadagno.",
        "ja": "その店は今日、たくさん利益が出ました。",
        "nb": "Butikken tjente mye i dag.",
        "nl": "De winkel maakte vandaag veel winst.",
        "pl": "Sklep dziś osiągnął duży zysk.",
        "pt": "A loja teve muito lucro hoje.",
        "ro": "Magazinul a făcut astăzi un profit mare.",
        "ru": "Сегодня магазин получил большую прибыль.",
        "sv": "Butiken gjorde stor vinst i dag.",
        "tr": "Dükkan bugün çok kâr etti.",
        "uk": "Сьогодні магазин отримав великий прибуток.",
        "vi": "Cửa hàng hôm nay lãi nhiều.",
        "yue": "舖頭今日賺咗好多錢。",
        "zh-Hans": "这家店今天赚了很多。"
      },
