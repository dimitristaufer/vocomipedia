  "sentences": [
    {
      "target": "시험 전에는 불안이 커져요.",
      "reading": "siheom jeoneneun burani keojyeoyo.",
      "translations": {
        "en": "My anxiety grows before the test.",
        "ko": "시험 전에는 불안이 커져요.",
        "ipa": "siheom jeoneneun burani keojyeoyo.",
        "ar": "يزداد قلقي قبل الامتحان.",
        "cs": "Před testem mi roste úzkost.",
        "da": "Min uro vokser før prøven.",
        "de": "Vor der Prüfung wird meine Angst größer.",
        "el": "Το άγχος μου μεγαλώνει πριν από το τεστ.",
        "es": "Mi ansiedad aumenta antes del examen.",
        "fi": "Jännitykseni kasvaa ennen koetta.",
        "fr": "Mon anxiété augmente avant le contrôle.",
        "he": "החרדה שלי גוברת לפני המבחן.",
        "hi": "परीक्षा से पहले मेरी घबराहट बढ़ जाती है।",
        "hu": "A vizsga előtt egyre jobban szorongok.",
        "id": "Kecemasan saya bertambah sebelum ujian.",
        "it": "L'ansia mi aumenta prima dell'esame.",
        "ja": "テストの前は不安が強くなります。",
        "nb": "Uroen min vokser før prøven.",
        "nl": "Mijn angst wordt groter voor de toets.",
        "pl": "Mój niepokój rośnie przed testem.",
        "pt": "A minha ansiedade aumenta antes da prova.",
        "ro": "Anxietatea mea crește înainte de test.",
        "ru": "Перед тестом моя тревога усиливается.",
        "sv": "Min oro växer före provet.",
        "tr": "Sınavdan önce kaygım artıyor.",
        "uk": "Перед тестом моя тривога посилюється.",
        "vi": "Trước bài kiểm tra, tôi càng lo hơn.",
        "yue": "考試前，我會越來越不安。",
        "zh-Hans": "考试前，我会越来越不安。"
      },
