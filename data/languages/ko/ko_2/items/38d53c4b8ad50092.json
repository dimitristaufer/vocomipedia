  "sentences": [
    {
      "target": "다행히 버스가 아직 안 갔어요.",
      "reading": "dahaenghi beoseuga ajik an gasseoyo.",
      "translations": {
        "en": "Fortunately, the bus hasn't left yet.",
        "ko": "다행히 버스가 아직 안 갔어요.",
        "ipa": "dahaenghi beoseuga ajik an gasseoyo.",
        "ar": "لحسن الحظ، لم يغادر الحافلة بعد.",
        "cs": "Naštěstí autobus ještě neodjel.",
        "da": "Heldigvis er bussen ikke kørt endnu.",
        "de": "Zum Glück ist der Bus noch nicht weg.",
        "el": "Ευτυχώς, το λεωφορείο δεν έχει φύγει ακόμα.",
        "es": "Por suerte, el autobús todavía no se ha ido.",
        "fi": "Onneksi bussi ei ole vielä lähtenyt.",
        "fr": "Heureusement, le bus n'est pas encore parti.",
        "he": "למזלי, האוטובוס עוד לא יצא.",
        "hi": "सौभाग्य से, बस अभी तक नहीं गई है।",
        "hu": "Szerencsére a busz még nem ment el.",
        "id": "Untungnya, busnya belum berangkat.",
        "it": "Per fortuna, l'autobus non è ancora partito.",
        "ja": "よかった、バスはまだ行っていません。",
        "nb": "Heldigvis har bussen ikke dratt ennå.",
        "nl": "Gelukkig is de bus nog niet vertrokken.",
        "pl": "Na szczęście autobus jeszcze nie odjechał.",
        "pt": "Felizmente, o ônibus ainda não foi embora.",
        "ro": "Din fericire, autobuzul nu a plecat încă.",
        "ru": "К счастью, автобус ещё не уехал.",
        "sv": "Som tur är har bussen inte åkt än.",
        "tr": "Neyse ki otobüs henüz gitmedi.",
        "uk": "На щастя, автобус ще не поїхав.",
        "vi": "May mà xe buýt vẫn chưa đi.",
        "yue": "好彩巴士仲未走。",
        "zh-Hans": "幸好，公交车还没走。"
      },
