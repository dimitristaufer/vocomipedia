    {
      "target": "할머니가 손수 김치를 담그셨어요.",
      "reading": "할머니가 손쑤 김치를 담그셔써요.",
      "translations": {
        "en": "My grandmother personally made kimchi.",
        "ko": "할머니가 손수 김치를 담그셨어요.",
        "ipa": "할머니가 손쑤 김치를 담그셔써요.",
        "ar": "جدتي صنعت الكيمتشي بنفسها.",
        "cs": "Moje babička sama připravila kimči.",
        "da": "Min bedstemor lavede kimchi selv.",
        "de": "Meine Großmutter hat Kimchi selbst gemacht.",
        "el": "Η γιαγιά μου έφτιαξε μόνη της το κιμτσί.",
        "es": "Mi abuela hizo kimchi ella misma.",
        "fi": "Isoäitini teki kimchiä itse.",
        "fr": "Ma grand-mère a préparé elle-même du kimchi.",
        "he": "הסבתא שלי הכינה קימצ'י בעצמה.",
        "hi": "मेरी दादी ने खुद किमची बनाई।",
        "hu": "A nagymamám maga készítette a kimcsit.",
        "id": "Nenekku membuat kimchi sendiri.",
        "it": "Mia nonna ha fatto il kimchi da sola.",
        "ja": "おばあさんが自分でキムチを作りました。",
        "nb": "Bestemoren min laget kimchi selv.",
        "nl": "Mijn oma maakte zelf kimchi.",
        "pl": "Moja babcia sama zrobiła kimchi.",
        "pt": "Minha avó fez kimchi sozinha.",
        "ro": "Bunica mea a făcut kimchi singură.",
        "ru": "Моя бабушка сама приготовила кимчи.",
        "sv": "Min mormor gjorde kimchi själv.",
        "tr": "Büyükannem kimchiyi kendi yaptı.",
        "uk": "Моя бабуся сама приготувала кімчі.",
        "vi": "Bà tôi tự làm kimchi.",
        "yue": "我嫲嫲親手整咗泡菜。",
        "zh-Hans": "我奶奶亲手做了泡菜。"
      },
