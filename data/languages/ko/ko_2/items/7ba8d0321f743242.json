      "Am Fenster hat sich Tau gebildet.",
      "Meine Schuhe wurden vom Tau nass."
    ],
    "el": [
      "Η πρωινή δροσιά μούσκεψε το γρασίδι.",
      "Η δροσιά λαμπυρίζει την αυγή.",
      "Έπεσε δροσιά στο παράθυρο.",
      "Τα παπούτσια μου βράχηκαν από τη δροσιά."
    ],
    "es": [
      "El rocío de la mañana empapó la hierba.",
      "El rocío brilla al amanecer.",
      "Se formó rocío en la ventana.",
      "Mis zapatos se mojaron por el rocío."
    ],
    "fi": [
      "Aamukaste kasteli ruohon.",
      "Kaste kimaltaa aamunkoitteessa.",
      "Ikkunaan on muodostunut kastetta.",
      "Kengät kastuivat kasteesta."
    ],
    "fr": [
      "La rosée du matin a trempé l'herbe.",
      "La rosée scintille à l'aube.",
      "De la rosée s'est formée sur la fenêtre.",
      "Mes chaussures ont été mouillées par la rosée."
    ],
    "he": [
      "טל הבוקר הרטיב את הדשא.",
      "הטל מנצנץ עם שחר.",
      "הצטבר טל על החלון.",
      "הנעליים שלי נרטבו בגלל הטל."
    ],
    "hi": [
      "सुबह की ओस ने घास भिगो दी।",
      "भोर में ओस चमक रही है।",
      "खिड़की पर ओस जमी है।",
      "ओस की वजह से मेरे जूते भीग गए।"
    ],
    "hu": [
      "A reggeli harmat átáztatta a füvet.",
      "A harmat ragyog hajnalban.",
      "Harmat csapódott le az ablakra.",
      "A cipőm elázott a harmattól."
    ],
    "id": [
      "Embun pagi membasahi rumput.",
      "Embun berkilau saat fajar.",
      "Embun terbentuk di jendela.",
      "Sepatuku basah karena embun."
    ],
    "it": [
      "La rugiada del mattino ha bagnato l'erba.",
      "La rugiada brilla all'alba.",
      "Si è formata della rugiada sulla finestra.",
      "Le mie scarpe si sono bagnate per la rugiada."
    ],
    "ja": [
      "朝露が芝生を濡らしました。",
      "夜明けに露がきらきら光ります。",
      "窓に露がつきました。",
      "露で靴がぬれました。"
    ],
    "nb": [
      "Morgenduggen gjorde gresset vått.",
      "Duggen glitrer i gryningen.",
      "Det har dannet seg dugg på vinduet.",
      "Skoene mine ble våte av duggen."
    ],
    "nl": [
      "De ochtenddauw maakte het gras nat.",
      "De dauw glinstert in de dageraad.",
      "Er heeft zich dauw op het raam gevormd.",
      "Mijn schoenen werden nat door de dauw."
    ],
    "pl": [
      "Poranna rosa zmoczyła trawę.",
      "O świcie rosa lśni.",
      "Na oknie osiadła rosa.",
      "Buty zmokły mi od rosy."
    ],
    "pt": [
      "O orvalho da manhã encharcou a grama.",
      "O orvalho brilha ao amanhecer.",
      "Formou-se orvalho na janela.",
      "Meus sapatos ficaram molhados por causa do orvalho."
    ],
    "ro": [
      "Roua de dimineață a udat iarba.",
      "Roua sclipește în zori.",
      "S-a format rouă pe fereastră.",
      "Pantofii mei s-au udat din cauza rouăi."
    ],
    "ru": [
      "Утренняя роса намочила траву.",
      "Роса сверкает на рассвете.",
      "На окне появилась роса.",
      "Из-за росы мои ботинки промокли."
    ],
    "sv": [
      "Morgondaggen gjorde gräset vått.",
      "Dagg glittrar i gryningen.",
      "Det har bildats dagg på fönstret.",
      "Mina skor blev våta av daggen."
    ],
    "tr": [
      "Sabah çiyi çimleri ıslattı.",
      "Çiy şafakta parlıyor.",
      "Pencereye çiy oluştu.",
      "Çiy yüzünden ayakkabılarım ıslandı."
    ],
    "uk": [
      "Ранкова роса намочила траву.",
      "Роса виблискує на світанку.",
      "На вікні з’явилася роса.",
      "Черевики намокли через росу."
    ],
    "vi": [
      "Sương sớm đã làm ướt cỏ.",
      "Sương lấp lánh lúc bình minh.",
      "Sương đọng trên cửa sổ.",
      "Giày của tôi bị ướt vì sương."
    ],
    "yue": [
      "晨露將草地打濕咗。",
      "晨曦下嘅露水閃閃發光。",
      "窗上凝結咗露水。",
      "因為露水，我對鞋濕咗。"
    ],
