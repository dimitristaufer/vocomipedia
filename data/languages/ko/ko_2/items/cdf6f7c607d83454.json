  "sentences": [
    {
      "target": "저는 저녁에 포도주 한 잔을 마셨어요.",
      "reading": "jeoneun jeonyeoge podoju han janeul masyeosseoyo.",
      "translations": {
        "en": "I drank a glass of grape wine in the evening.",
        "ko": "저는 저녁에 포도주 한 잔을 마셨어요.",
        "ipa": "jeoneun jeonyeoge podoju han janeul masyeosseoyo.",
        "ar": "شربتُ كأسًا من نبيذ العنب في المساء.",
        "cs": "Večer jsem vypila sklenku hroznového vína.",
        "da": "Jeg drak et glas druevin om aftenen.",
        "de": "Ich habe abends ein Glas Traubenwein getrunken.",
        "el": "Ήπια ένα ποτήρι κρασί σταφυλιού το βράδυ.",
        "es": "Me bebí una copa de vino de uva por la noche.",
        "fi": "Join illalla lasin rypäleviiniä.",
        "fr": "J'ai bu un verre de vin de raisin le soir.",
        "he": "שתיתי כוס יין ענבים בערב.",
        "hi": "मैंने शाम को अंगूर की शराब का एक गिलास पिया।",
        "hu": "Este ittam egy pohár szőlőbort.",
        "id": "Saya minum segelas anggur anggur pada malam hari.",
        "it": "Ho bevuto un bicchiere di vino d'uva la sera.",
        "ja": "私は夕方にグレープワインを一杯飲みました。",
        "nb": "Jeg drakk et glass druevin om kvelden.",
        "nl": "Ik heb 's avonds een glas druivenwijn gedronken.",
        "pl": "Wieczorem wypiłem kieliszek wina gronowego.",
        "pt": "Bebi uma taça de vinho de uva à noite.",
        "ro": "Am băut un pahar de vin de struguri seara.",
        "ru": "Вечером я выпил бокал виноградного вина.",
        "sv": "Jag drack ett glas druvvin på kvällen.",
        "tr": "Akşam bir kadeh üzüm şarabı içtim.",
        "uk": "Увечері я випив склянку виноградного вина.",
        "vi": "Tôi đã uống một ly rượu nho vào buổi tối.",
        "yue": "我喺夜晚飲咗一杯葡萄酒。",
        "zh-Hans": "我晚上喝了一杯葡萄酒。"
      },
