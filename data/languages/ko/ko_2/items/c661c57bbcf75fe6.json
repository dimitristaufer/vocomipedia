  "sentences": [
    {
      "target": "저는 지방에 사는 친구를 만났어요.",
      "reading": "Jeoneun jibange saneun chingureul mannatseoyo.",
      "translations": {
        "en": "I met a friend who lives in the province.",
        "ko": "저는 지방에 사는 친구를 만났어요.",
        "ipa": "Jeoneun jibange saneun chingureul mannatseoyo.",
        "ar": "التقيت بصديق يعيش في الريف.",
        "cs": "Potkal jsem kamaráda, který žije na venkově.",
        "da": "Jeg mødte en ven, der bor på landet.",
        "de": "Ich habe einen Freund getroffen, der auf dem Land lebt.",
        "el": "Γνώρισα έναν φίλο που μένει στην επαρχία.",
        "es": "Conocí a un amigo que vive en la provincia.",
        "fi": "Tapasin ystävän, joka asuu maaseudulla.",
        "fr": "J'ai rencontré un ami qui habite en province.",
        "he": "פגשתי חבר שגר בכפר.",
        "hi": "मैंने एक दोस्त से मुलाकात की जो गाँव में रहता है।",
        "hu": "Találkoztam egy barátommal, aki vidéken él.",
        "id": "Saya bertemu seorang teman yang tinggal di daerah.",
        "it": "Ho incontrato un amico che vive in provincia.",
        "ja": "私は地方に住んでいる友達に会いました。",
        "nb": "Jeg møtte en venn som bor på landsbygda.",
        "nl": "Ik ontmoette een vriend die op het platteland woont.",
        "pl": "Poznałem przyjaciela, który mieszka na wsi.",
        "pt": "Encontrei um amigo que mora no interior.",
        "ro": "Am întâlnit un prieten care locuiește la țară.",
        "ru": "Я встретил друга, который живёт в провинции.",
        "sv": "Jag träffade en vän som bor på landet.",
        "tr": "Köyde yaşayan bir arkadaşımı gördüm.",
        "uk": "Я зустрів друга, який живе в сільській місцевості.",
        "vi": "Tôi đã gặp một người bạn sống ở vùng quê.",
        "yue": "我識咗個住喺鄉下嘅朋友。",
        "zh-Hans": "我认识了一位住在乡下的朋友。"
      },
