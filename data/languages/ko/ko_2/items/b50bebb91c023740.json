  "sentences": [
    {
      "target": "저는 오늘부터 일찍 일어나기로 마음먹었어요.",
      "reading": "jeoneun oneulbuteo iljjik ileonagiro maeummeokeosseoyo.",
      "translations": {
        "en": "I decided to get up early starting today.",
        "ko": "저는 오늘부터 일찍 일어나기로 마음먹었어요.",
        "ipa": "jeoneun oneulbuteo iljjik ileonagiro maeummeokeosseoyo.",
        "ar": "قررت أن أنهض مبكرًا بدءًا من اليوم.",
        "cs": "Rozhodl jsem se od dneška vstávat brzy.",
        "da": "Jeg besluttede at stå tidligt op fra i dag.",
        "de": "Ich habe beschlossen, ab heute früh aufzustehen.",
        "el": "Αποφάσισα να ξυπνάω νωρίς από σήμερα.",
        "es": "Decidí levantarme temprano a partir de hoy.",
        "fi": "Päätin herätä aikaisin tästä päivästä lähtien.",
        "fr": "J’ai décidé de me lever tôt à partir d’aujourd’hui.",
        "he": "החלטתי לקום מוקדם מהיום.",
        "hi": "मैंने आज से जल्दी उठने का फैसला किया।",
        "hu": "Úgy döntöttem, hogy mától korán kelek.",
        "id": "Saya memutuskan untuk bangun pagi mulai hari ini.",
        "it": "Ho deciso di alzarmi presto da oggi.",
        "ja": "私は今日から早起きすると決めました。",
        "nb": "Jeg bestemte meg for å stå opp tidlig fra i dag.",
        "nl": "Ik heb besloten om vanaf vandaag vroeg op te staan.",
        "pl": "Postanowiłem wstawać wcześnie od dziś.",
        "pt": "Decidi acordar cedo a partir de hoje.",
        "ro": "Am decis să mă trezesc devreme începând de azi.",
        "ru": "Я решил вставать рано с сегодняшнего дня.",
        "sv": "Jag bestämde mig för att gå upp tidigt från och med i dag.",
        "tr": "Bugünden itibaren erken kalkmaya karar verdim.",
        "uk": "Я вирішив вставати рано, починаючи від сьогодні.",
        "vi": "Tôi quyết định dậy sớm từ hôm nay.",
        "yue": "我決定由今日開始早啲起身。",
        "zh-Hans": "我决定从今天开始早起。"
      },
