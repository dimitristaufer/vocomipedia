    {
      "target": "그에게 사과하는 게 마땅하다.",
      "reading": "geuege sagwahaneun ge mattanghada.",
      "translations": {
        "en": "It is right to apologize to him.",
        "ko": "그에게 사과하는 게 마땅하다.",
        "ipa": "geuege sagwahaneun ge mattanghada.",
        "ar": "من الصواب أن أعتذر له.",
        "cs": "Je správné se mu omluvit.",
        "da": "Det er rigtigt at undskylde over for ham.",
        "de": "Es ist richtig, sich bei ihm zu entschuldigen.",
        "el": "Είναι σωστό να του ζητήσω συγγνώμη.",
        "es": "Es correcto disculparse con él.",
        "fi": "On oikein pyytää häneltä anteeksi.",
        "fr": "Il est juste de lui présenter des excuses.",
        "he": "נכון להתנצל בפניו.",
        "hi": "उससे माफ़ी माँगना सही है।",
        "hu": "Helyes, ha bocsánatot kérek tőle.",
        "id": "Salah jika tidak minta maaf kepadanya.",
        "it": "È giusto scusarsi con lui.",
        "ja": "彼に謝るのが当然です。",
        "nb": "Det er riktig å be ham om unnskyldning.",
        "nl": "Het is juist om hem mijn excuses aan te bieden.",
        "pl": "Słusznie jest go przeprosić.",
        "pt": "É certo pedir desculpas a ele.",
        "ro": "Este corect să-mi cer scuze în fața lui.",
        "ru": "Правильно извиниться перед ним.",
        "sv": "Det är rätt att be honom om ursäkt.",
        "tr": "Ondan özür dilemek doğru olur.",
        "uk": "Правильно вибачитися перед ним.",
        "vi": "Xin lỗi anh ấy là điều đúng đắn.",
        "yue": "向佢道歉係啱嘅。",
        "zh-Hans": "向他道歉是对的。"
      },
