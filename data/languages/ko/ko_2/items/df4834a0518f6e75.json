  "sentences": [
    {
      "target": "우리 동아리 부회장이 회의를 준비했어요.",
      "reading": "uri dongari buhoejangi hoeuireul junbihaesseoyo.",
      "translations": {
        "en": "Our club's vice president prepared the meeting.",
        "ko": "우리 동아리 부회장이 회의를 준비했어요.",
        "ipa": "uri dongari buhoejangi hoeuireul junbihaesseoyo.",
        "ar": "أعدّ نائب رئيس نادينا الاجتماع.",
        "cs": "Náš místopředseda připravil schůzi.",
        "da": "Vores klubs næstformand forberedte mødet.",
        "de": "Unser Vereinsvize hat das Treffen vorbereitet.",
        "el": "Ο αντιπρόεδρος του συλλόγου μας ετοίμασε τη συνάντηση.",
        "es": "El vicepresidente de nuestro club preparó la reunión.",
        "fi": "Kerhomme varapuheenjohtaja valmisti kokouksen.",
        "fr": "Le vice-président de notre club a préparé la réunion.",
        "he": "סגן נשיא המועדון שלנו הכין את הישיבה.",
        "hi": "हमारे क्लब के उपाध्यक्ष ने बैठक तैयार की।",
        "hu": "A klubunk alelnöke készítette elő a megbeszélést.",
        "id": "Wakil ketua klub kami menyiapkan rapat.",
        "it": "Il vicepresidente del nostro club ha preparato la riunione.",
        "ja": "うちのサークルの副会長が会議を準備しました。",
        "nb": "Viselederen i klubben vår forberedte møtet.",
        "nl": "De vicevoorzitter van onze club heeft de vergadering voorbereid.",
        "pl": "Wiceprzewodniczący naszego klubu przygotował spotkanie.",
        "pt": "O vice-presidente do nosso clube preparou a reunião.",
        "ro": "Vicepreședintele clubului nostru a pregătit ședința.",
        "ru": "Вице-президент нашего клуба подготовил собрание.",
        "sv": "Vår klubbs vice ordförande förberedde mötet.",
        "tr": "Kulübümüzün başkan yardımcısı toplantıyı hazırladı.",
        "uk": "Заступник голови нашого клубу підготував збори.",
        "vi": "Phó chủ tịch của câu lạc bộ chúng tôi đã chuẩn bị cuộc họp.",
        "yue": "我哋嘅社團副會長準備咗會議。",
        "zh-Hans": "我们俱乐部的副会长准备了会议。"
      },
