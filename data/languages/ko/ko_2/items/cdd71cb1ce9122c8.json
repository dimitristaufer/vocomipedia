  "sentences": [
    {
      "target": "회사 간부가 회의실에 들어갔어요.",
      "reading": "hoesa ganbuga hoeuisil-e deureogatseoyo.",
      "translations": {
        "en": "A company executive went into the conference room.",
        "ko": "회사 간부가 회의실에 들어갔어요.",
        "ipa": "hoesa ganbuga hoeuisil-e deureogatseoyo.",
        "ar": "دخل مسؤول في الشركة إلى غرفة الاجتماعات.",
        "cs": "Firemní manažer vešel do zasedací místnosti.",
        "da": "En leder i firmaet gik ind i mødelokalet.",
        "de": "Ein Firmenleiter ging in den Konferenzraum.",
        "el": "Ένα στέλεχος της εταιρείας μπήκε στην αίθουσα συσκέψεων.",
        "es": "Un directivo de la empresa entró en la sala de reuniones.",
        "fi": "Yrityksen johtaja meni kokoushuoneeseen.",
        "fr": "Un cadre de l'entreprise est entré dans la salle de réunion.",
        "he": "מנהל בחברה נכנס לחדר הישיבות.",
        "hi": "कंपनी का एक अधिकारी मीटिंग रूम में गया।",
        "hu": "A cég egyik vezetője bement a tárgyalóba.",
        "id": "Seorang manajer perusahaan masuk ke ruang rapat.",
        "it": "Un dirigente dell'azienda è entrato nella sala riunioni.",
        "ja": "会社の幹部が会議室に入りました。",
        "nb": "En leder i selskapet gikk inn i møterommet.",
        "nl": "Een leidinggevende van het bedrijf ging de vergaderruimte in.",
        "pl": "Jeden z kierowników firmy wszedł do sali konferencyjnej.",
        "pt": "Um executivo da empresa entrou na sala de reuniões.",
        "ro": "Un director al companiei a intrat în sala de ședințe.",
        "ru": "Руководитель компании вошёл в конференц-зал.",
        "sv": "En chef på företaget gick in i konferensrummet.",
        "tr": "Şirketten bir yönetici toplantı odasına girdi.",
        "uk": "Керівник компанії зайшов до кімнати для нарад.",
        "vi": "Một giám đốc công ty đã vào phòng họp.",
        "yue": "公司主管入咗會議室。",
        "zh-Hans": "公司主管进了会议室。"
      },
