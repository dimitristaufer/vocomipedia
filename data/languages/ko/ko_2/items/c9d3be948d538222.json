  "sentences": [
    {
      "target": "할아버지는 오래된 타자기를 아직도 쓰세요.",
      "reading": "harabeojineun oraedoen tajagireul ajikdo sseuseyo.",
      "translations": {
        "en": "My grandfather still uses an old typewriter.",
        "ko": "할아버지는 오래된 타자기를 아직도 쓰세요.",
        "ipa": "harabeojineun oraedoen tajagireul ajikdo sseuseyo.",
        "ar": "لا يزال جدي يستخدم آلة كاتبة قديمة.",
        "cs": "Můj dědeček pořád používá starý psací stroj.",
        "da": "Min bedstefar bruger stadig en gammel skrivemaskine.",
        "de": "Mein Großvater benutzt immer noch eine alte Schreibmaschine.",
        "el": "Ο παππούς μου χρησιμοποιεί ακόμα μια παλιά γραφομηχανή.",
        "es": "Mi abuelo todavía usa una vieja máquina de escribir.",
        "fi": "Isoisäni käyttää yhä vanhaa kirjoituskonetta.",
        "fr": "Mon grand-père utilise encore une vieille machine à écrire.",
        "he": "סבא שלי עדיין משתמש במכונת כתיבה ישנה.",
        "hi": "मेरे दादा अभी भी एक पुरानी टाइपराइटर इस्तेमाल करते हैं।",
        "hu": "A nagyapám még mindig használ egy régi írógépet.",
        "id": "Kakek saya masih memakai mesin tik tua.",
        "it": "Mio nonno usa ancora una vecchia macchina da scrivere.",
        "ja": "祖父は古いタイプライターを今でも使っています。",
        "nb": "Bestefaren min bruker fortsatt en gammel skrivemaskin.",
        "nl": "Mijn grootvader gebruikt nog steeds een oude typemachine.",
        "pl": "Mój dziadek nadal używa starej maszyny do pisania.",
        "pt": "Meu avô ainda usa uma máquina de escrever antiga.",
        "ro": "Bunicul meu încă folosește o mașină de scris veche.",
        "ru": "Мой дедушка до сих пор пользуется старой печатной машинкой.",
        "sv": "Min farfar använder fortfarande en gammal skrivmaskin.",
        "tr": "Dedem hâlâ eski bir daktilo kullanıyor.",
        "uk": "Мій дідусь досі користується старою друкарською машинкою.",
        "vi": "Ông tôi vẫn dùng một chiếc máy đánh chữ cũ.",
        "yue": "我爺爺仲用緊一部舊打字機。",
        "zh-Hans": "我爷爷还在用一台旧打字机。"
      },
