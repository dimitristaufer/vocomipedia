    {
      "target": "서두르지 말고 천천히 해요.",
      "reading": "seodureuji malgo cheoncheonhi haeyo.",
      "translations": {
        "en": "Don't rush; take it slowly.",
        "ko": "서두르지 말고 천천히 해요.",
        "ipa": "seodureuji malgo cheoncheonhi haeyo.",
        "ar": "لا تستعجل، وخذها ببطء.",
        "cs": "Nespěchej a dělej to pomalu.",
        "da": "Skynd dig ikke, tag det roligt.",
        "de": "Beeil dich nicht, mach es langsam.",
        "el": "Μην βιάζεσαι, πήγαινε σιγά.",
        "es": "No te apures y hazlo despacio.",
        "fi": "Älä kiirehdi, ota rauhassa.",
        "fr": "Ne te dépêche pas, vas-y doucement.",
        "he": "אל תמהר, קח את זה לאט.",
        "hi": "जल्दी मत करो, धीरे-धीरे करो।",
        "hu": "Ne kapkodj, csináld lassan.",
        "id": "Jangan buru-buru, lakukan pelan-pelan.",
        "it": "Non avere fretta, fallo piano piano.",
        "ja": "急がないで、ゆっくりやってください。",
        "nb": "Ikke stress, ta det rolig.",
        "nl": "Haast je niet, doe het rustig aan.",
        "pl": "Nie spiesz się i rób to powoli.",
        "pt": "Não tenha pressa, vá devagar.",
        "ro": "Nu te grăbi, fă-o încet.",
        "ru": "Не торопись, делай медленно.",
        "sv": "Skynda dig inte, ta det lugnt.",
        "tr": "Acele etme, yavaş yavaş yap.",
        "uk": "Не поспішай, роби повільно.",
        "vi": "Đừng vội, cứ làm từ từ.",
        "yue": "唔好咁趕，慢慢嚟。",
        "zh-Hans": "别着急，慢慢来。"
      },
