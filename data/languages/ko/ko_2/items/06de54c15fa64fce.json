  "sentences": [
    {
      "target": "버스는 집 앞에서 학교까지 20분 내지 30분 걸려요.",
      "reading": "beoseuneun jip apeseo hakkyo kkaji isipbun naeji samsibbun geollyeoyo",
      "translations": {
        "en": "The bus ride from my house to school takes 20 to 30 minutes.",
        "ko": "버스는 집 앞에서 학교까지 20분 내지 30분 걸려요.",
        "ipa": "beoseuneun jip apeseo hakkyo kkaji isipbun naeji samsibbun geollyeoyo",
        "ar": "تستغرق رحلة الحافلة من بيتي إلى المدرسة 20 إلى 30 دقيقة.",
        "cs": "Cesta autobusem z mého domu do školy trvá 20 až 30 minut.",
        "da": "Busturen fra mit hjem til skolen tager 20 til 30 minutter.",
        "de": "Die Busfahrt von meinem Haus zur Schule dauert 20 bis 30 Minuten.",
        "el": "Η διαδρομή με το λεωφορείο από το σπίτι μου ως το σχολείο διαρκεί 20 έως 30 λεπτά.",
        "es": "El viaje en autobús desde mi casa hasta la escuela tarda entre 20 y 30 minutos.",
        "fi": "Bussimatka kodistani kouluun kestää 20–30 minuuttia.",
        "fr": "Le trajet en bus de chez moi à l'école prend 20 à 30 minutes.",
        "he": "הנסיעה באוטובוס מהבית שלי לבית הספר אורכת 20 עד 30 דקות.",
        "hi": "मेरे घर से स्कूल तक बस से 20 से 30 मिनट लगते हैं।",
        "hu": "A buszút az otthonomtól az iskoláig 20-30 percig tart.",
        "id": "Perjalanan dengan bus dari rumah saya ke sekolah memakan waktu 20 sampai 30 menit.",
        "it": "Il viaggio in autobus da casa mia a scuola dura 20-30 minuti.",
        "ja": "家から学校までのバスは20分から30分かかります。",
        "nb": "Bussreisen fra hjemmet mitt til skolen tar 20 til 30 minutter.",
        "nl": "De busrit van mijn huis naar school duurt 20 tot 30 minuten.",
        "pl": "Jazda autobusem z mojego domu do szkoły trwa 20 do 30 minut.",
        "pt": "A viagem de ônibus da minha casa até a escola leva de 20 a 30 minutos.",
        "ro": "Drumul cu autobuzul de la casa mea până la școală durează 20 până la 30 de minute.",
        "ru": "Поездка на автобусе от моего дома до школы занимает 20–30 минут.",
        "sv": "Bussresan från mitt hem till skolan tar 20 till 30 minuter.",
        "tr": "Evimden okula otobüsle yolculuk 20 ila 30 dakika sürüyor.",
        "uk": "Поїздка автобусом від мого дому до школи триває 20–30 хвилин.",
        "vi": "Chuyến đi xe buýt từ nhà tôi đến trường mất 20 đến 30 phút.",
        "yue": "由我屋企去學校嘅巴士車程要20至30分鐘。",
        "zh-Hans": "从我家到学校的公交车要20到30分钟。"
      },
