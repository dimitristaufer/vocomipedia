    {
      "target": "저는 불평 없이 일을 했어요.",
      "reading": "Jeoneun bulpyeong eopsi ireul haesseoyo.",
      "translations": {
        "en": "I worked without complaining.",
        "ko": "저는 불평 없이 일을 했어요.",
        "ipa": "Jeoneun bulpyeong eopsi ireul haesseoyo.",
        "ar": "عملتُ من دون شكوى.",
        "cs": "Pracoval jsem bez stížností.",
        "da": "Jeg arbejdede uden at klage.",
        "de": "Ich habe ohne zu klagen gearbeitet.",
        "el": "Δούλεψα χωρίς παράπονα.",
        "es": "Trabajé sin quejarme.",
        "fi": "Työskentelin valittamatta.",
        "fr": "J'ai travaillé sans me plaindre.",
        "he": "עבדתי בלי להתלונן.",
        "hi": "मैंने बिना शिकायत किए काम किया।",
        "hu": "Úgy dolgoztam, hogy nem panaszkodtam.",
        "id": "Saya bekerja tanpa mengeluh.",
        "it": "Ho lavorato senza lamentarmi.",
        "ja": "私は文句を言わずに働きました。",
        "nb": "Jeg jobbet uten å klage.",
        "nl": "Ik heb zonder te klagen gewerkt.",
        "pl": "Pracowałem bez narzekania.",
        "pt": "Eu trabalhei sem reclamar.",
        "ro": "Am lucrat fără să mă plâng.",
        "ru": "Я работал без жалоб.",
        "sv": "Jag arbetade utan att klaga.",
        "tr": "Şikâyet etmeden çalıştım.",
        "uk": "Я працював без скарг.",
        "vi": "Tôi đã làm việc mà không than phiền.",
        "yue": "我做嘢冇投訴。",
        "zh-Hans": "我工作时没有抱怨。"
      },
