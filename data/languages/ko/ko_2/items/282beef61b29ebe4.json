  "sentences": [
    {
      "target": "불평만 하지 말고 같이 해요.",
      "reading": "Bulpyeongman hajimargo gachi haeyo.",
      "translations": {
        "en": "Don't just complain; let's do it together.",
        "ko": "불평만 하지 말고 같이 해요.",
        "ipa": "Bulpyeongman hajimargo gachi haeyo.",
        "ar": "لا تكتفِ بالشكوى، بل لِنفعل ذلك معًا.",
        "cs": "Neskuč jenom a pojďme na tom spolu.",
        "da": "Lad være med bare at klage, og lad os gøre det sammen.",
        "de": "Beschwer dich nicht nur, sondern lass uns das zusammen machen.",
        "el": "Μην κάνεις μόνο παράπονα, έλα να το κάνουμε μαζί.",
        "es": "No te quejes solo; hagámoslo juntos.",
        "fi": "Älä vain valita, vaan tehdään tämä yhdessä.",
        "fr": "Ne te plains pas seulement ; faisons-le ensemble.",
        "he": "אל תתלונן רק, בוא נעשה את זה יחד.",
        "hi": "बस शिकायत मत करो, चलो इसे साथ में करते हैं।",
        "hu": "Ne csak panaszkodj, csináljuk együtt.",
        "id": "Jangan cuma mengeluh; ayo kita kerjakan bersama.",
        "it": "Non lamentarti e basta; facciamolo insieme.",
        "ja": "文句ばかり言わないで、一緒にやりましょう。",
        "nb": "Ikke bare klag, la oss gjøre det sammen.",
        "nl": "Niet alleen klagen; laten we het samen doen.",
        "pl": "Nie tylko narzekaj, zróbmy to razem.",
        "pt": "Não fique só reclamando; vamos fazer isso juntos.",
        "ro": "Nu te mai plânge, hai să facem asta împreună.",
        "ru": "Не жалуйся только, давай сделаем это вместе.",
        "sv": "Klaga inte bara, utan låt oss göra det tillsammans.",
        "tr": "Sadece şikâyet etme, hadi bunu birlikte yapalım.",
        "uk": "Не просто скаржся, давай зробимо це разом.",
        "vi": "Đừng chỉ than phiền, hãy cùng làm nhé.",
        "yue": "唔好淨係投訴，一齊做啦。",
        "zh-Hans": "别光抱怨了，我们一起做吧。"
      },
