  "sentences": [
    {
      "target": "아버지가 담벼락을 파란색으로 칠했어요.",
      "reading": "abeojiga dambyeorageul paransaegeuro chilhaesseoyo",
      "translations": {
        "en": "My father painted the wall blue.",
        "ko": "아버지가 담벼락을 파란색으로 칠했어요.",
        "ipa": "abeojiga dambyeorageul paransaegeuro chilhaesseoyo",
        "ar": "قام أبي بطلاء الجدار باللون الأزرق.",
        "cs": "Táta natřel zeď na modro.",
        "da": "Min far malede muren blå.",
        "de": "Mein Vater hat die Mauer blau gestrichen.",
        "el": "Ο πατέρας μου έβαψε τον τοίχο μπλε.",
        "es": "Mi padre pintó la pared de azul.",
        "fi": "Isäni maalasi seinän siniseksi.",
        "fr": "Mon père a peint le mur en bleu.",
        "he": "אבא שלי צבע את הקיר בכחול.",
        "hi": "मेरे पिता ने दीवार नीली रंगी।",
        "hu": "Az apám kékre festette a falat.",
        "id": "Ayah saya mengecat tembok itu biru.",
        "it": "Mio padre ha dipinto il muro di blu.",
        "ja": "父が壁を青く塗りました。",
        "nb": "Faren min malte veggen blå.",
        "nl": "Mijn vader schilderde de muur blauw.",
        "pl": "Mój tata pomalował ścianę na niebiesko.",
        "pt": "Meu pai pintou a parede de azul.",
        "ro": "Tatăl meu a vopsit peretele în albastru.",
        "ru": "Мой отец покрасил стену в синий цвет.",
        "sv": "Min pappa målade väggen blå.",
        "tr": "Babam duvarı maviye boyadı.",
        "uk": "Мій тато пофарбував стіну в синій колір.",
        "vi": "Bố tôi đã sơn bức tường màu xanh lam.",
        "yue": "我爸爸將牆漆咗藍色。",
        "zh-Hans": "我爸爸把墙刷成了蓝色。"
      },
