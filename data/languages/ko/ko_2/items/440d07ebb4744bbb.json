  "sentences": [
    {
      "target": "그는 중요한 경기에서 실력을 발휘했어요.",
      "reading": "geuneun jungyohan gyeonggi-eseo sireuryeog-eul balhwihaesseoyo.",
      "translations": {
        "en": "He showed his skills in an important match.",
        "ko": "그는 중요한 경기에서 실력을 발휘했어요.",
        "ipa": "geuneun jungyohan gyeonggi-eseo sireuryeog-eul balhwihaesseoyo.",
        "ar": "أظهر مهارته في مباراة مهمة.",
        "cs": "V důležitém zápase ukázal své schopnosti.",
        "da": "Han viste sine evner i en vigtig kamp.",
        "de": "Er zeigte in einem wichtigen Spiel sein Können.",
        "el": "Έδειξε τις ικανότητές του σε έναν σημαντικό αγώνα.",
        "es": "Demostró su habilidad en un partido importante.",
        "fi": "Hän näytti taitonsa tärkeässä ottelussa.",
        "fr": "Il a montré ses compétences lors d'un match important.",
        "he": "הוא הפגין את היכולת שלו במשחק חשוב.",
        "hi": "उसने एक अहम मैच में अपनी क्षमता दिखाई।",
        "hu": "Egy fontos meccsen megmutatta a tudását.",
        "id": "Dia menunjukkan kemampuannya dalam pertandingan penting.",
        "it": "Ha mostrato le sue capacità in una partita importante.",
        "ja": "彼は大事な試合で実力を発揮しました。",
        "nb": "Han viste ferdighetene sine i en viktig kamp.",
        "nl": "Hij liet in een belangrijke wedstrijd zien wat hij kon.",
        "pl": "W ważnym meczu pokazał swoje umiejętności.",
        "pt": "Ele mostrou sua habilidade em uma partida importante.",
        "ro": "El și-a arătat abilitățile într-un meci important.",
        "ru": "Он проявил свое мастерство в важном матче.",
        "sv": "Han visade sina färdigheter i en viktig match.",
        "tr": "Önemli bir maçta hünerini gösterdi.",
        "uk": "Він показав свої вміння у важливому матчі.",
        "vi": "Anh ấy đã thể hiện khả năng của mình trong một trận đấu quan trọng.",
        "yue": "佢喺一場重要嘅比賽入面發揮咗佢嘅實力。",
        "zh-Hans": "他在一场重要的比赛中发挥了实力。"
      },
