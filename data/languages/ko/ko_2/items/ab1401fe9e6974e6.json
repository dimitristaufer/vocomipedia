    {
      "target": "그는 끝내 사과했어요.",
      "reading": "geuneun kkeutnae sagwahesseoyo.",
      "translations": {
        "en": "He finally apologized.",
        "ko": "그는 끝내 사과했어요.",
        "ipa": "geuneun kkeutnae sagwahesseoyo.",
        "ar": "اعتذر أخيرًا.",
        "cs": "Nakonec se omluvil.",
        "da": "Han undskyldte endelig.",
        "de": "Er hat sich endlich entschuldigt.",
        "el": "Τελικά ζήτησε συγγνώμη.",
        "es": "Por fin se disculpó.",
        "fi": "Hän pyysi vihdoin anteeksi.",
        "fr": "Il s'est finalement excusé.",
        "he": "הוא התנצל סוף סוף.",
        "hi": "उसने आखिरकार माफ़ी माँगी।",
        "hu": "Végül bocsánatot kért.",
        "id": "Dia akhirnya meminta maaf.",
        "it": "Alla fine si è scusato.",
        "ja": "彼はようやく謝りました。",
        "nb": "Han ba endelig om unnskyldning.",
        "nl": "Hij heeft uiteindelijk zijn excuses aangeboden.",
        "pl": "W końcu przeprosił.",
        "pt": "Ele finalmente pediu desculpas.",
        "ro": "A cerut în sfârșit scuze.",
        "ru": "Он наконец извинился.",
        "sv": "Han bad äntligen om ursäkt.",
        "tr": "O da sonunda özür diledi.",
        "uk": "Він нарешті вибачився.",
        "vi": "Anh ấy cuối cùng cũng xin lỗi.",
        "yue": "佢終於道咗歉。",
        "zh-Hans": "他终于道歉了。"
      },
