  "sentences": [
    {
      "target": "나는 끝내 약속 장소에 도착했어요.",
      "reading": "naneun kkeutnae yaksok jangsoe dochakhaesseoyo.",
      "translations": {
        "en": "I finally arrived at the meeting place.",
        "ko": "나는 끝내 약속 장소에 도착했어요.",
        "ipa": "naneun kkeutnae yaksok jangsoe dochakhaesseoyo.",
        "ar": "وصلتُ أخيرًا إلى مكان اللقاء.",
        "cs": "Nakonec jsem dorazil na místo setkání.",
        "da": "Jeg nåede endelig frem til mødestedet.",
        "de": "Ich bin endlich am Treffpunkt angekommen.",
        "el": "Έφτασα επιτέλους στο σημείο συνάντησης.",
        "es": "Por fin llegué al lugar de encuentro.",
        "fi": "Pääsin vihdoin tapaamispaikalle.",
        "fr": "Je suis finalement arrivé au lieu de rendez-vous.",
        "he": "הגעתי סוף סוף למקום המפגש.",
        "hi": "मैं आखिरकार मिलने की जगह पहुँच गया।",
        "hu": "Végre megérkeztem a találkozóhelyre.",
        "id": "Saya akhirnya tiba di tempat pertemuan.",
        "it": "Alla fine sono arrivato al punto d'incontro.",
        "ja": "私はようやく待ち合わせ場所に着きました。",
        "nb": "Jeg kom endelig fram til møtestedet.",
        "nl": "Ik ben uiteindelijk op de ontmoetingsplek aangekomen.",
        "pl": "W końcu dotarłem na miejsce spotkania.",
        "pt": "Finalmente cheguei ao local do encontro.",
        "ro": "Am ajuns în sfârșit la locul întâlnirii.",
        "ru": "Я наконец добрался до места встречи.",
        "sv": "Jag kom äntligen fram till mötesplatsen.",
        "tr": "Sonunda buluşma yerine vardım.",
        "uk": "Я нарешті дістався до місця зустрічі.",
        "vi": "Tôi cuối cùng cũng đến được chỗ hẹn.",
        "yue": "我終於到咗見面地點。",
        "zh-Hans": "我终于到达了见面地点。"
      },
