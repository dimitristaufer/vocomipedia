  "sentences": [
    {
      "target": "아이가 놀라서 크게 질렀어요.",
      "reading": "aiga nollaseo keuge jilleosseoyo.",
      "translations": {
        "en": "The child screamed loudly in surprise.",
        "ko": "아이가 놀라서 크게 질렀어요.",
        "ipa": "aiga nollaseo keuge jilleosseoyo.",
        "ar": "صرخ الطفل بصوت عالٍ من شدة المفاجأة.",
        "cs": "Dítě vyděšeně hlasitě vykřiklo.",
        "da": "Barnet skreg højt af forskrækkelse.",
        "de": "Das Kind schrie laut vor Schreck.",
        "el": "Το παιδί έβαλε μια δυνατή φωνή από την τρομάρα του.",
        "es": "El niño gritó fuerte del susto.",
        "fi": "Lapsi kiljaisi kovaa säikähdyksestä.",
        "fr": "L'enfant a crié très fort de surprise.",
        "he": "הילד צעק בקול רם מרוב בהלה.",
        "hi": "बच्चा घबराकर जोर से चिल्लाया।",
        "hu": "A gyerek ijedtében hangosan felsikoltott.",
        "id": "Anak itu menjerit keras karena kaget.",
        "it": "Il bambino ha urlato forte per lo spavento.",
        "ja": "子どもは驚いて大きな声で叫びました。",
        "nb": "Barnet skrek høyt av skrekk.",
        "nl": "Het kind gilde hard van schrik.",
        "pl": "Dziecko głośno krzyknęło ze strachu.",
        "pt": "A criança gritou alto de susto.",
        "ro": "Copilul a țipat tare de sperietură.",
        "ru": "Ребёнок громко закричал от испуга.",
        "sv": "Barnet skrek högt av rädsla.",
        "tr": "Çocuk korkudan yüksek sesle çığlık attı.",
        "uk": "Дитина голосно закричала від переляку.",
        "vi": "Đứa trẻ hét lên to vì sợ.",
        "yue": "小朋友驚到大聲尖叫。",
        "zh-Hans": "孩子受到惊吓，大声尖叫了。"
      },
