  "sentences": [
    {
      "target": "일이 많아서 너무 지쳤어요.",
      "reading": "ili manaseo neomu jichyeosseoyo.",
      "translations": {
        "en": "I’m really exhausted because I have so much work.",
        "ko": "일이 많아서 너무 지쳤어요.",
        "ipa": "ili manaseo neomu jichyeosseoyo.",
        "ar": "أنا مرهق جدًا لأن لدي الكثير من العمل.",
        "cs": "Jsem opravdu vyčerpaný, protože mám hodně práce.",
        "da": "Jeg er virkelig udmattet, fordi jeg har så meget arbejde.",
        "de": "Ich bin total erschöpft, weil ich so viel Arbeit habe.",
        "el": "Είμαι πολύ εξαντλημένος, γιατί έχω πολλή δουλειά.",
        "es": "Estoy muy cansado porque tengo mucho trabajo.",
        "fi": "Olen todella uupunut, koska minulla on niin paljon töitä.",
        "fr": "Je suis vraiment épuisé parce que j’ai beaucoup de travail.",
        "he": "אני מותש ממש כי יש לי הרבה עבודה.",
        "hi": "मेरे पास बहुत काम है, इसलिए मैं बहुत थक गया हूँ।",
        "hu": "Nagyon kimerültem, mert nagyon sok a munkám.",
        "id": "Saya sangat lelah karena saya punya banyak pekerjaan.",
        "it": "Sono davvero sfinito perché ho tanto lavoro.",
        "ja": "仕事が多くて、とても疲れました。",
        "nb": "Jeg er skikkelig utslitt fordi jeg har så mye å gjøre.",
        "nl": "Ik ben echt uitgeput omdat ik zoveel werk heb.",
        "pl": "Jestem naprawdę wyczerpany, bo mam tyle pracy.",
        "pt": "Estou muito cansado porque tenho muito trabalho.",
        "ro": "Sunt foarte obosit pentru că am mult de lucru.",
        "ru": "Я очень устал, потому что у меня много работы.",
        "sv": "Jag är jätteutsliten eftersom jag har så mycket att göra.",
        "tr": "Çok işim olduğu için çok yoruldum.",
        "uk": "Я дуже втомився, бо в мене багато роботи.",
        "vi": "Tôi rất mệt vì tôi có quá nhiều việc.",
        "yue": "因為我有好多工作，所以我好攰。",
        "zh-Hans": "因为我有很多工作，所以我很累。"
      },
