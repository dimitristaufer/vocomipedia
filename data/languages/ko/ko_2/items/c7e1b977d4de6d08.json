  "sentences": [
    {
      "target": "친구는 포기하는 말을 싫어해요.",
      "reading": "Chinguneun pogihaneun mareul silheohaeyo.",
      "translations": {
        "en": "My friend hates the word “giving up.”",
        "ko": "친구는 포기하는 말을 싫어해요.",
        "ipa": "Chinguneun pogihaneun mareul silheohaeyo.",
        "ar": "صديقي يكره كلمة «الاستسلام».",
        "cs": "Můj přítel nesnáší slovo „vzdát se“.",
        "da": "Min ven hader ordet “at give op”.",
        "de": "Mein Freund hasst das Wort „aufgeben“.",
        "el": "Ο φίλος μου μισεί τη λέξη «παρατάω».",
        "es": "A mi amigo le disgusta la palabra «rendirse».",
        "fi": "Ystäväni inhoaa sanaa ”luovuttaa”.",
        "fr": "Mon ami déteste le mot « abandonner ».",
        "he": "החבר שלי שונא את המילה ״לוותר״.",
        "hi": "मेरा दोस्त “हार मानना” शब्द से नफ़रत करता है।",
        "hu": "A barátom utálja a „feladni” szót.",
        "id": "Teman saya benci kata “menyerah”.",
        "it": "Il mio amico odia la parola «arrendersi».",
        "ja": "友だちは「諦める」という言葉が嫌いです。",
        "nb": "Vennen min hater ordet «å gi opp».",
        "nl": "Mijn vriend haat het woord ‘opgeven’.",
        "pl": "Mój przyjaciel nienawidzi słowa „poddawać się”.",
        "pt": "Meu amigo odeia a palavra “desistir”.",
        "ro": "Prietenul meu urăște cuvântul „a renunța”.",
        "ru": "Мой друг ненавидит слово «сдаваться».",
        "sv": "Min vän hatar ordet ”ge upp”.",
        "tr": "Arkadaşım “vazgeçmek” kelimesinden nefret eder.",
        "uk": "Мій друг ненавидить слово «здаватися».",
        "vi": "Bạn tôi ghét từ “bỏ cuộc”.",
        "yue": "我朋友討厭「放棄」呢個詞。",
        "zh-Hans": "我朋友讨厌“放弃”这个词。"
      },
