    {
      "target": "오늘은 제가 밥값을 치를게요.",
      "reading": "oneureun jega bapkkabeul chireulgeyo.",
      "translations": {
        "en": "I'll pay for the meal today.",
        "ko": "오늘은 제가 밥값을 치를게요.",
        "ipa": "oneureun jega bapkkabeul chireulgeyo.",
        "ar": "سأدفع ثمن الوجبة اليوم.",
        "cs": "Dnes zaplatím jídlo já.",
        "da": "Jeg betaler for maden i dag.",
        "de": "Heute bezahle ich das Essen.",
        "el": "Σήμερα εγώ θα πληρώσω για το φαγητό.",
        "es": "Hoy invito yo a comer.",
        "fi": "Minä maksan ruoan tänään.",
        "fr": "C'est moi qui paie le repas aujourd'hui.",
        "he": "אני אשלם היום על הארוחה.",
        "hi": "आज मैं खाने का बिल दूँगा।",
        "hu": "Ma én fizetem az ételt.",
        "id": "Hari ini saya yang bayar makanannya.",
        "it": "Oggi offro io il pranzo.",
        "ja": "今日は私が食事代を払います。",
        "nb": "I dag betaler jeg for maten.",
        "nl": "Vandaag betaal ik voor de maaltijd.",
        "pl": "Dziś ja stawiam za jedzenie.",
        "pt": "Hoje eu pago a comida.",
        "ro": "Azi plătesc eu masa.",
        "ru": "Сегодня за еду плачу я.",
        "sv": "I dag betalar jag för maten.",
        "tr": "Bugün yemeğin parasını ben ödeyeceğim.",
        "uk": "Сьогодні я заплачу за їжу.",
        "vi": "Hôm nay tôi sẽ trả tiền bữa ăn.",
        "yue": "今日我請食飯。",
        "zh-Hans": "今天我来付饭钱。"
      },
