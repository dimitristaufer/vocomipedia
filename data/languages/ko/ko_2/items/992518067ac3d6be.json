  "sentences": [
    {
      "target": "저는 미술관에서 작품을 감상했어요.",
      "reading": "jeoneun misulgwaneseo jakpumeul gamsanghaesseoyo.",
      "translations": {
        "en": "I appreciated the artwork at the museum.",
        "ko": "저는 미술관에서 작품을 감상했어요.",
        "ipa": "jeoneun misulgwaneseo jakpumeul gamsanghaesseoyo.",
        "ar": "استمتعتُ بالأعمال الفنية في المتحف.",
        "cs": "V galerii jsem si prohlížel díla.",
        "da": "Jeg betragtede værkerne på museet med interesse.",
        "de": "Ich habe mir im Museum die Kunstwerke angesehen.",
        "el": "Θαύμασα τα έργα στο μουσείο.",
        "es": "Disfruté de las obras de arte en el museo.",
        "fi": "Pysähdyin ihailemaan taideteoksia museossa.",
        "fr": "J'ai admiré les œuvres au musée.",
        "he": "התפעלתי מהיצירות במוזיאון.",
        "hi": "मैंने संग्रहालय में कलाकृतियों का आनंद लिया।",
        "hu": "A múzeumban megnéztem a műalkotásokat.",
        "id": "Saya menikmati karya seni di museum.",
        "it": "Ho ammirato le opere al museo.",
        "ja": "私は美術館で作品を鑑賞しました。",
        "nb": "Jeg så på kunstverkene på museet med interesse.",
        "nl": "Ik heb in het museum naar de kunstwerken gekeken.",
        "pl": "Podziwiałem dzieła w muzeum.",
        "pt": "Eu admirei as obras de arte no museu.",
        "ro": "Am admirat lucrările de la muzeu.",
        "ru": "Я любовался произведениями искусства в музее.",
        "sv": "Jag betraktade konstverken på museet med intresse.",
        "tr": "Müzede eserleri hayranlıkla inceledim.",
        "uk": "Я милувався творами в музеї.",
        "vi": "Tôi đã thưởng thức các tác phẩm ở bảo tàng.",
        "yue": "我喺博物館欣賞咗啲作品。",
        "zh-Hans": "我在博物馆欣赏了作品。"
      },
