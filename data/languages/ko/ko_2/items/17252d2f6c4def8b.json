    {
      "target": "민수 씨는 일에 열정이 있어요.",
      "reading": "Minsu ssineun ire yeoljeongi isseoyo.",
      "translations": {
        "en": "Min-su is passionate about his work.",
        "ko": "민수 씨는 일에 열정이 있어요.",
        "ipa": "Minsu ssineun ire yeoljeongi isseoyo.",
        "ar": "مينسو شغوف بعمله.",
        "cs": "Min-su je nadšený pro svou práci.",
        "da": "Min-su brænder for sit arbejde.",
        "de": "Min-su ist leidenschaftlich bei der Arbeit.",
        "el": "Ο Μιν-σου έχει πάθος για τη δουλειά του.",
        "es": "Min-su siente pasión por su trabajo.",
        "fi": "Min-su on innostunut työstään.",
        "fr": "Min-su est passionné par son travail.",
        "he": "מין-סו נלהב מהעבודה שלו.",
        "hi": "मिन-सू अपने काम को लेकर बहुत उत्साही है।",
        "hu": "Min-su lelkes a munkájában.",
        "id": "Min-su sangat bersemangat dalam pekerjaannya.",
        "it": "Min-su è appassionato del suo lavoro.",
        "ja": "ミンスさんは仕事に情熱があります。",
        "nb": "Min-su er lidenskapelig opptatt av jobben sin.",
        "nl": "Min-su is gepassioneerd over zijn werk.",
        "pl": "Min-su jest pełen pasji do swojej pracy.",
        "pt": "Min-su tem paixão pelo trabalho.",
        "ro": "Min-su este pasionat de munca lui.",
        "ru": "Мин-су увлечён своей работой.",
        "sv": "Min-su brinner för sitt arbete.",
        "tr": "Min-su işine tutkuyla bağlı.",
        "uk": "Мін-су захоплений своєю роботою.",
        "vi": "Min-su rất đam mê công việc của mình.",
        "yue": "敏洙對自己嘅工作好有熱誠。",
        "zh-Hans": "敏洙对自己的工作很有热情。"
      },
