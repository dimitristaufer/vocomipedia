  "sentences": [
    {
      "target": "친구 덕분에 숙제를 빨리 끝냈어요.",
      "reading": "chin-gu deok-bune sukje-reul ppalli kkeutnaesseoyo.",
      "translations": {
        "en": "Thanks to my friend, I finished my homework quickly.",
        "ko": "친구 덕분에 숙제를 빨리 끝냈어요.",
        "ipa": "chin-gu deok-bune sukje-reul ppalli kkeutnaesseoyo.",
        "ar": "بفضل صديقي أنهيت واجبي المنزلي بسرعة.",
        "cs": "Díky kamarádovi jsem rychle dokončil domácí úkol.",
        "da": "Takket være min ven blev jeg hurtigt færdig med lektierne.",
        "de": "Dank meines Freundes habe ich meine Hausaufgaben schnell beendet.",
        "el": "Χάρη στον φίλο μου τελείωσα γρήγορα τις εργασίες μου.",
        "es": "Gracias a mi amigo, terminé rápido la tarea.",
        "fi": "Ystäväni ansiosta sain läksyt nopeasti valmiiksi.",
        "fr": "Grâce à mon ami, j'ai fini mes devoirs rapidement.",
        "he": "בזכות החבר שלי סיימתי את שיעורי הבית מהר.",
        "hi": "दोस्त की वजह से मैंने अपना होमवर्क जल्दी खत्म कर लिया।",
        "hu": "A barátomnak köszönhetően gyorsan befejeztem a házi feladatomat.",
        "id": "Berkat teman saya, saya cepat menyelesaikan pekerjaan rumah.",
        "it": "Grazie al mio amico, ho finito i compiti in fretta.",
        "ja": "友だちのおかげで、宿題を早く終えました。",
        "nb": "Takket være vennen min ble jeg raskt ferdig med leksene.",
        "nl": "Dankzij mijn vriend was ik snel klaar met mijn huiswerk.",
        "pl": "Dzięki mojemu przyjacielowi szybko skończyłem pracę domową.",
        "pt": "Graças ao meu amigo, terminei o dever de casa rapidamente.",
        "ro": "Datorită prietenului meu, mi-am terminat repede temele.",
        "ru": "Благодаря другу я быстро закончил домашнее задание.",
        "sv": "Tack vare min vän blev jag snabbt klar med läxorna.",
        "tr": "Arkadaşım sayesinde ödevimi çabucak bitirdim.",
        "uk": "Завдяки другу я швидко закінчив домашнє завдання.",
        "vi": "Nhờ bạn tôi, tôi đã làm xong bài tập về nhà rất nhanh.",
        "yue": "多得我個朋友，我好快就做完功課。",
        "zh-Hans": "多亏了我的朋友，我很快就做完了作业。"
      },
