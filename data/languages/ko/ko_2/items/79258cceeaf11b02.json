  "sentences": [
    {
      "target": "‘도망가다’는 위험할 때 빨리 달아나는 것을 뜻해요.",
      "reading": "domanggadaneun wiheomhal ttae ppalli dalarananeun geoseul tteuseyo.",
      "translations": {
        "en": "‘도망가다’ means to run away quickly when something is dangerous.",
        "ko": "‘도망가다’는 위험할 때 빨리 달아나는 것을 뜻해요.",
        "ipa": "domanggadaneun wiheomhal ttae ppalli dalarananeun geoseul tteuseyo.",
        "ar": "تعني كلمة «الهروب» الجريّ بعيدًا بسرعة عندما يكون هناك خطر.",
        "cs": "„Utéct“ znamená rychle utíkat, když je něco nebezpečné.",
        "da": "„Flygte“ betyder at løbe hurtigt væk, når noget er farligt.",
        "de": "„Weglaufen“ bedeutet, bei Gefahr schnell davonzulaufen.",
        "el": "Το «δραπετεύω» σημαίνει να τρέχεις μακριά γρήγορα όταν υπάρχει κίνδυνος.",
        "es": "«Huir» significa correr rápido para alejarse cuando hay peligro.",
        "fi": "”Paeta” tarkoittaa juosta nopeasti karkuun, kun on vaarallista.",
        "fr": "« S’enfuir » signifie courir vite pour partir quand c’est dangereux.",
        "he": "„לברוח” פירושו לרוץ מהר כדי להתרחק כשיש סכנה.",
        "hi": "‘भाग जाना’ का मतलब है खतरा होने पर जल्दी से भागना।",
        "hu": "A „menekülni” azt jelenti, hogy veszély esetén gyorsan elrohanni.",
        "id": "“Kabur” berarti lari cepat menjauh saat ada bahaya.",
        "it": "«Scappare» significa correre via velocemente quando c’è pericolo.",
        "ja": "「逃げる」は、危ないときにすぐ走って逃げることを意味します。",
        "nb": "«Å rømme» betyr å løpe fort bort når noe er farlig.",
        "nl": "“Wegrennen” betekent snel wegrennen als iets gevaarlijk is.",
        "pl": "„Uciekać” znaczy szybko biec, gdy jest niebezpiecznie.",
        "pt": "“Fugir” significa correr rápido para longe quando há perigo.",
        "ro": "„A fugi” înseamnă a alerga repede când e pericol.",
        "ru": "«Убегать» значит быстро бежать, когда опасно.",
        "sv": "”Fly” betyder att springa bort snabbt när något är farligt.",
        "tr": "“Kaçmak”, bir şey tehlikeliyken hızlıca koşup uzaklaşmak demektir.",
        "uk": "«Тікати» означає швидко бігти геть, коли небезпечно.",
        "vi": "“Chạy trốn” nghĩa là chạy nhanh đi khi có nguy hiểm.",
        "yue": "「走佬」係指有危險嗰陣快啲走開。",
        "zh-Hans": "“逃跑”是指在危险的时候快速跑开。"
      },
