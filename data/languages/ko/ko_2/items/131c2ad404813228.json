  "sentences": [
    {
      "target": "반장이 오늘 공지를 전했어요.",
      "reading": "banjangi oneul gongjireul jeonhaesseoyo.",
      "translations": {
        "en": "The class representative passed on the notice today.",
        "ko": "반장이 오늘 공지를 전했어요.",
        "ipa": "banjangi oneul gongjireul jeonhaesseoyo.",
        "ar": "نقل مندوب الصف الإشعار اليوم.",
        "cs": "Třídní zástupce dnes předal oznámení.",
        "da": "Klassens repræsentant gav beskeden videre i dag.",
        "de": "Der Klassensprecher hat heute die Mitteilung weitergegeben.",
        "el": "Ο εκπρόσωπος της τάξης μετέφερε σήμερα την ανακοίνωση.",
        "es": "El delegado de la clase pasó el aviso hoy.",
        "fi": "Luokan edustaja välitti ilmoituksen tänään.",
        "fr": "Le délégué de la classe a transmis l'annonce aujourd'hui.",
        "he": "נציג הכיתה מסר היום את ההודעה.",
        "hi": "कक्षा प्रतिनिधि ने आज सूचना दी।",
        "hu": "Az osztály képviselője ma átadta a közleményt.",
        "id": "Ketua kelas menyampaikan pemberitahuan itu hari ini.",
        "it": "Il rappresentante di classe ha dato l'avviso oggi.",
        "ja": "学級委員が今日お知らせを伝えました。",
        "nb": "Klassens tillitsvalgte ga beskjeden i dag.",
        "nl": "De klassenvertegenwoordiger gaf de mededeling vandaag door.",
        "pl": "Przedstawiciel klasy przekazał dziś ogłoszenie.",
        "pt": "O representante da turma avisou hoje.",
        "ro": "Reprezentantul clasei a transmis anunțul azi.",
        "ru": "Староста класса сегодня передал объявление.",
        "sv": "Klassrepresentanten vidarebefordrade meddelandet i dag.",
        "tr": "Sınıf başkanı bugün duyuruyu iletti.",
        "uk": "Староста класу сьогодні передав оголошення.",
        "vi": "Lớp trưởng đã báo lại thông báo hôm nay.",
        "yue": "班長今日傳達咗通知。",
        "zh-Hans": "班长今天传达了通知。"
      },
