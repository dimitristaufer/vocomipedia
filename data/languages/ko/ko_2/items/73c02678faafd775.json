  "sentences": [
    {
      "target": "그 부족은 강 근처에 살아요.",
      "reading": "geu bujogeun gang geuncheoe sarayo.",
      "translations": {
        "en": "That tribe lives near the river.",
        "ko": "그 부족은 강 근처에 살아요.",
        "ipa": "geu bujogeun gang geuncheoe sarayo.",
        "ar": "تعيش تلك القبيلة قرب النهر.",
        "cs": "Ten kmen žije poblíž řeky.",
        "da": "Den stamme bor nær floden.",
        "de": "Dieser Stamm lebt in der Nähe des Flusses.",
        "el": "Αυτή η φυλή ζει κοντά στο ποτάμι.",
        "es": "Esa tribu vive cerca del río.",
        "fi": "Se heimo asuu lähellä jokea.",
        "fr": "Cette tribu vit près de la rivière.",
        "he": "השבט הזה גר ליד הנהר.",
        "hi": "यह जनजाति नदी के पास रहती है।",
        "hu": "Ez a törzs a folyó közelében él.",
        "id": "Suku itu tinggal di dekat sungai.",
        "it": "Quella tribù vive vicino al fiume.",
        "ja": "その部族は川の近くに住んでいます。",
        "nb": "Den stammen bor nær elven.",
        "nl": "Die stam woont vlak bij de rivier.",
        "pl": "To plemię mieszka blisko rzeki.",
        "pt": "Essa tribo mora perto do rio.",
        "ro": "Tribul acela trăiește aproape de râu.",
        "ru": "Это племя живёт рядом с рекой.",
        "sv": "Den stammen bor nära floden.",
        "tr": "O kabile nehrin yakınında yaşıyor.",
        "uk": "Це плем'я живе біля річки.",
        "vi": "Bộ tộc đó sống gần sông.",
        "yue": "嗰個部族住喺河邊。",
        "zh-Hans": "那个部族住在河边。"
      },
