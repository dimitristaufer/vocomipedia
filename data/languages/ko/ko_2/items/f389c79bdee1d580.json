  "sentences": [
    {
      "target": "어머님께서는 오늘 병원에 가셨어요.",
      "reading": "eomeonimkkeseoneun oneul byeongwone gasyeosseoyo.",
      "translations": {
        "en": "Your mother went to the hospital today.",
        "ko": "어머님께서는 오늘 병원에 가셨어요.",
        "ipa": "eomeonimkkeseoneun oneul byeongwone gasyeosseoyo.",
        "ar": "ذهبت والدتك إلى المستشفى اليوم.",
        "cs": "Vaše matka dnes šla do nemocnice.",
        "da": "Din mor tog på hospitalet i dag.",
        "de": "Ihre Mutter ist heute ins Krankenhaus gegangen.",
        "el": "Η μητέρα σας πήγε σήμερα στο νοσοκομείο.",
        "es": "Su madre fue al hospital hoy.",
        "fi": "Äitinne meni tänään sairaalaan.",
        "fr": "Votre mère est allée à l'hôpital aujourd'hui.",
        "he": "אמא שלך הלכה היום לבית החולים.",
        "hi": "आपकी माँ आज अस्पताल गईं।",
        "hu": "Az édesanyja ma elment a kórházba.",
        "id": "Ibu Anda pergi ke rumah sakit hari ini.",
        "it": "Sua madre è andata in ospedale oggi.",
        "ja": "お母さまは今日病院へ行かれました。",
        "nb": "Moren din dro til sykehuset i dag.",
        "nl": "Uw moeder is vandaag naar het ziekenhuis gegaan.",
        "pl": "Twoja mama poszła dziś do szpitala.",
        "pt": "A sua mãe foi ao hospital hoje.",
        "ro": "Mama dumneavoastră a mers azi la spital.",
        "ru": "Ваша мама сегодня пошла в больницу.",
        "sv": "Din mamma åkte till sjukhuset i dag.",
        "tr": "Anneniz bugün hastaneye gitti.",
        "uk": "Ваша мама сьогодні пішла до лікарні.",
        "vi": "Mẹ của bạn đã đến bệnh viện hôm nay.",
        "yue": "你阿媽今日去咗醫院。",
        "zh-Hans": "您母亲今天去医院了。"
      },
