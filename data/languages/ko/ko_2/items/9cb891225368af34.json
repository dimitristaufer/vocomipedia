  "sentences": [
    {
      "target": "어젯밤에는 친구 집에 머물렀어요.",
      "reading": "eojetbam-eneun chingu jip-e meomulleosseoyo.",
      "translations": {
        "en": "I stayed at a friend's house last night.",
        "ko": "어젯밤에는 친구 집에 머물렀어요.",
        "ipa": "eojetbam-eneun chingu jip-e meomulleosseoyo.",
        "ar": "مكثت في بيت صديقي الليلة الماضية.",
        "cs": "Včera v noci jsem zůstal u kamaráda doma.",
        "da": "Jeg overnattede hos en ven i går nat.",
        "de": "Ich habe letzte Nacht bei einem Freund übernachtet.",
        "el": "Έμεινα στο σπίτι ενός φίλου χθες το βράδυ.",
        "es": "Anoche me quedé en casa de un amigo.",
        "fi": "Yövyin viime yönä ystäväni luona.",
        "fr": "J’ai dormi chez un ami la nuit dernière.",
        "he": "נשארתי לישון אצל חבר אתמול בלילה.",
        "hi": "मैं कल रात एक दोस्त के घर रुका।",
        "hu": "Tegnap éjjel egy barátomnál aludtam.",
        "id": "Saya menginap di rumah teman tadi malam.",
        "it": "Ieri notte ho dormito a casa di un amico.",
        "ja": "昨夜は友達の家に泊まりました。",
        "nb": "Jeg overnattet hos en venn i går kveld.",
        "nl": "Ik heb vannacht bij een vriend gelogeerd.",
        "pl": "Zostałem wczoraj na noc u przyjaciela.",
        "pt": "Passei a noite na casa de um amigo ontem.",
        "ro": "Am rămas peste noapte la un prieten aseară.",
        "ru": "Прошлой ночью я ночевал у друга.",
        "sv": "Jag sov över hos en vän i går natt.",
        "tr": "Dün gece bir arkadaşımda kaldım.",
        "uk": "Минулої ночі я ночував у друга.",
        "vi": "Tối qua tôi ngủ lại nhà một người bạn.",
        "yue": "我噚晚瞓咗喺朋友屋企。",
        "zh-Hans": "我昨晚住在朋友家。"
      },
