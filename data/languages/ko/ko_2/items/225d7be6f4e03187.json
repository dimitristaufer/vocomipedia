    {
      "target": "제 생활은 규칙적이에요.",
      "reading": "je saenghwareun gyuchikjeogieyo.",
      "translations": {
        "en": "My daily life is regular.",
        "ko": "제 생활은 규칙적이에요.",
        "ipa": "je saenghwareun gyuchikjeogieyo.",
        "ar": "حياتي اليومية منتظمة.",
        "cs": "Můj každodenní život je pravidelný.",
        "da": "Min hverdag er regelmæssig.",
        "de": "Mein Alltag ist regelmäßig.",
        "el": "Η καθημερινότητά μου είναι τακτική.",
        "es": "Mi vida diaria es regular.",
        "fi": "Arkeni on säännöllinen.",
        "fr": "Ma vie quotidienne est régulière.",
        "he": "החיים היומיומיים שלי סדירים.",
        "hi": "मेरी दिनचर्या नियमित है।",
        "hu": "A mindennapjaim rendszeresek.",
        "id": "Kehidupan saya teratur.",
        "it": "La mia vita quotidiana è regolare.",
        "ja": "私の生活は規則的です。",
        "nb": "Hverdagen min er regelmessig.",
        "nl": "Mijn dagelijks leven is regelmatig.",
        "pl": "Moje codzienne życie jest regularne.",
        "pt": "Minha rotina diária é regular.",
        "ro": "Viața mea de zi cu zi este regulată.",
        "ru": "Моя повседневная жизнь регулярная.",
        "sv": "Min vardag är regelbunden.",
        "tr": "Günlük hayatım düzenlidir.",
        "uk": "Моє повсякденне життя регулярне.",
        "vi": "Cuộc sống hằng ngày của tôi rất đều đặn.",
        "yue": "我嘅日常生活好規律。",
        "zh-Hans": "我的日常生活很有规律。"
      },
