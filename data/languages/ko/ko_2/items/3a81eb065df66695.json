  "sentences": [
    {
      "target": "그 아이의 상상은 정말 끝이 없어요.",
      "reading": "geu ai-ui sangsang-eun jeongmal kkeuti eopseoyo.",
      "translations": {
        "en": "That child's imagination seems endless.",
        "ko": "그 아이의 상상은 정말 끝이 없어요.",
        "ipa": "geu ai-ui sangsang-eun jeongmal kkeuti eopseoyo.",
        "ar": "خيال ذلك الطفل لا ينتهي أبدًا.",
        "cs": "Dětská představivost je opravdu nekonečná.",
        "da": "Det barns fantasi ser ud til at være uendelig.",
        "de": "Die Fantasie dieses Kindes scheint keine Grenzen zu haben.",
        "el": "Η φαντασία αυτού του παιδιού φαίνεται ατελείωτη.",
        "es": "La imaginación de ese niño parece no tener fin.",
        "fi": "Tuon lapsen mielikuvitus tuntuu loputtomalta.",
        "fr": "L'imagination de cet enfant semble sans fin.",
        "he": "הדמיון של הילד הזה נראה אינסופי.",
        "hi": "उस बच्चे की कल्पना सचमुच अनंत लगती है।",
        "hu": "Ennek a gyereknek a fantáziája végtelennek tűnik.",
        "id": "Imajinasi anak itu sepertinya tak ada habisnya.",
        "it": "La fantasia di quel bambino sembra infinita.",
        "ja": "あの子の想像力は本当に尽きません。",
        "nb": "Fantasien til det barnet virker uendelig.",
        "nl": "De fantasie van dat kind lijkt eindeloos.",
        "pl": "Wyobraźnia tego dziecka wydaje się nie mieć końca.",
        "pt": "A imaginação daquela criança parece não ter fim.",
        "ro": "Imaginația acelui copil pare fără sfârșit.",
        "ru": "У этого ребёнка, кажется, безграничное воображение.",
        "sv": "Det där barnets fantasi verkar oändlig.",
        "tr": "O çocuğun hayal gücü sonsuz gibi görünüyor.",
        "uk": "У цієї дитини, здається, безмежна уява.",
        "vi": "Trí tưởng tượng của đứa trẻ đó dường như vô tận.",
        "yue": "嗰個細路嘅想像力好似冇盡頭。",
        "zh-Hans": "那个孩子的想象力似乎没有尽头。"
      },
