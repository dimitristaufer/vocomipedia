  "sentences": [
    {
      "target": "그는 동네에서 유명한 지식인입니다.",
      "reading": "geuneun dongne-eseo yumyeonghan jisigin-imnida.",
      "translations": {
        "en": "He is a well-known intellectual in the neighborhood.",
        "ko": "그는 동네에서 유명한 지식인입니다.",
        "ipa": "geuneun dongne-eseo yumyeonghan jisigin-imnida.",
        "ar": "هو مثقف معروف في الحي.",
        "cs": "Je to známý intelektuál v sousedství.",
        "da": "Han er en kendt intellektuel i kvarteret.",
        "de": "Er ist ein bekannter Intellektueller in der Nachbarschaft.",
        "el": "Είναι ένας γνωστός διανοούμενος στη γειτονιά.",
        "es": "Es un intelectual muy conocido en el vecindario.",
        "fi": "Hän on tunnettu älymystön edustaja kaupunginosassa.",
        "fr": "C'est un intellectuel connu dans le quartier.",
        "he": "הוא אינטלקטואל מפורסם בשכונה.",
        "hi": "वह मोहल्ले का एक मशहूर बुद्धिजीवी है।",
        "hu": "Ő egy ismert értelmiségi a környéken.",
        "id": "Dia seorang intelektual terkenal di lingkungan itu.",
        "it": "È un intellettuale famoso nel quartiere.",
        "ja": "彼は近所で有名な知識人です。",
        "nb": "Han er en kjent intellektuell i nabolaget.",
        "nl": "Hij is een bekende intellectueel in de buurt.",
        "pl": "Jest znanym intelektualistą w okolicy.",
        "pt": "Ele é um intelectual famoso no bairro.",
        "ro": "Este un intelectual cunoscut în cartier.",
        "ru": "Он известный интеллектуал в районе.",
        "sv": "Han är en känd intellektuell i kvarteret.",
        "tr": "O, mahallede tanınan bir aydındır.",
        "uk": "Він відомий інтелектуал у районі.",
        "vi": "Anh ấy là một trí thức nổi tiếng trong khu phố.",
        "yue": "佢係屋企附近好出名嘅知識分子。",
        "zh-Hans": "他是附近有名的知识分子。"
      },
