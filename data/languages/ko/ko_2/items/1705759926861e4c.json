  "sentences": [
    {
      "target": "오늘은 환경 문제에 대해 토론해요.",
      "reading": "oneureun hwanggyeong munjee daehae toronhaeyo.",
      "translations": {
        "en": "We discuss environmental issues today.",
        "ko": "오늘은 환경 문제에 대해 토론해요.",
        "ipa": "oneureun hwanggyeong munjee daehae toronhaeyo.",
        "ar": "نناقش اليوم القضايا البيئية.",
        "cs": "Dnes probíráme otázky životního prostředí.",
        "da": "I dag taler vi om miljøspørgsmål.",
        "de": "Heute diskutieren wir über Umweltfragen.",
        "el": "Σήμερα συζητάμε για περιβαλλοντικά θέματα.",
        "es": "Hoy hablamos sobre temas medioambientales.",
        "fi": "Keskustelemme tänään ympäristöasioista.",
        "fr": "Nous discutons des questions environnementales aujourd'hui.",
        "he": "אנחנו דנים היום בנושאי סביבה.",
        "hi": "आज हम पर्यावरण के मुद्दों पर चर्चा करते हैं।",
        "hu": "Ma környezetvédelmi kérdésekről beszélgetünk.",
        "id": "Hari ini kami membahas masalah lingkungan.",
        "it": "Oggi discutiamo di questioni ambientali.",
        "ja": "今日は環境問題について話し合います。",
        "nb": "I dag diskuterer vi miljøspørsmål.",
        "nl": "Vandaag bespreken we milieukwesties.",
        "pl": "Dziś dyskutujemy o kwestiach środowiskowych.",
        "pt": "Hoje discutimos questões ambientais.",
        "ro": "Astăzi discutăm despre problemele de mediu.",
        "ru": "Сегодня мы обсуждаем экологические проблемы.",
        "sv": "I dag diskuterar vi miljöfrågor.",
        "tr": "Bugün çevre sorunlarını tartışıyoruz.",
        "uk": "Сьогодні ми обговорюємо екологічні проблеми.",
        "vi": "Hôm nay chúng tôi thảo luận về các vấn đề môi trường.",
        "yue": "今日我哋討論環境問題。",
        "zh-Hans": "今天我们讨论环境问题。"
      },
