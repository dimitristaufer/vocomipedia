  "sentences": [
    {
      "target": "저 사람은 동네 깡패로 유명했어요.",
      "reading": "jeo sarameun dongne kkangpaero yumyeonghaesseoyo.",
      "translations": {
        "en": "That man was famous as a neighborhood thug.",
        "ko": "저 사람은 동네 깡패로 유명했어요.",
        "ipa": "jeo sarameun dongne kkangpaero yumyeonghaesseoyo.",
        "ar": "كان ذلك الرجل مشهورًا بأنه فتوة الحي.",
        "cs": "Ten muž byl známý jako místní gangster.",
        "da": "Den mand var kendt som kvarterets bølle.",
        "de": "Der Mann war als Schläger aus der Nachbarschaft bekannt.",
        "el": "Εκείνος ο άντρας ήταν γνωστός ως νταής της γειτονιάς.",
        "es": "Ese hombre era famoso como matón del barrio.",
        "fi": "Se mies oli kuuluisa korttelin kovanaamana.",
        "fr": "Cet homme était connu comme le voyou du quartier.",
        "he": "האיש הזה היה ידוע כבריון של השכונה.",
        "hi": "वह आदमी इलाके के गुंडे के तौर पर मशहूर था।",
        "hu": "Az a férfi a környék vagányaként volt ismert.",
        "id": "Pria itu terkenal sebagai preman kampung.",
        "it": "Quell'uomo era famoso come teppista del quartiere.",
        "ja": "あの男は地元のチンピラとして有名でした。",
        "nb": "Den mannen var kjent som nabolagets bølle.",
        "nl": "Die man stond bekend als de buurtboef.",
        "pl": "Ten mężczyzna był znany jako osiedlowy bandyta.",
        "pt": "Aquele homem era famoso como o valentão do bairro.",
        "ro": "Bărbatul acela era cunoscut ca golanul cartierului.",
        "ru": "Этот мужчина был известен как местный бандит.",
        "sv": "Den mannen var känd som kvarterets buse.",
        "tr": "O adam mahalle kabadayısı olarak ünlüydü.",
        "uk": "Той чоловік був відомий як місцевий бандит.",
        "vi": "Người đàn ông đó nổi tiếng là giang hồ trong khu phố.",
        "yue": "嗰個男人出名係街坊惡霸。",
        "zh-Hans": "那个男人以街头混混出名。"
      },
