  "sentences": [
    {
      "target": "오늘은 흰 티셔츠를 입었어요.",
      "reading": "oneureun huin tisyeocheureul ibeosseoyo.",
      "translations": {
        "en": "I wore a white T-shirt today.",
        "ko": "오늘은 흰 티셔츠를 입었어요.",
        "ipa": "oneureun huin tisyeocheureul ibeosseoyo.",
        "ar": "ارتديتُ قميصًا أبيض اليوم.",
        "cs": "Dnes jsem měl bílé tričko.",
        "da": "Jeg havde en hvid T-shirt på i dag.",
        "de": "Heute hatte ich ein weißes T-Shirt an.",
        "el": "Φόρεσα ένα λευκό T-shirt σήμερα.",
        "es": "Hoy me puse una camiseta blanca.",
        "fi": "Minulla oli tänään valkoinen t-paita.",
        "fr": "Aujourd'hui, j'ai mis un T-shirt blanc.",
        "he": "לבשתי היום חולצת טריקו לבנה.",
        "hi": "मैंने आज सफेद टी-शर्ट पहनी।",
        "hu": "Ma fehér pólót vettem fel.",
        "id": "Hari ini saya memakai kaus putih.",
        "it": "Oggi ho indossato una maglietta bianca.",
        "ja": "今日は白いTシャツを着ました。",
        "nb": "I dag hadde jeg på meg en hvit T-skjorte.",
        "nl": "Vandaag droeg ik een wit T-shirt.",
        "pl": "Dziś miałem na sobie białą koszulkę.",
        "pt": "Hoje usei uma camiseta branca.",
        "ro": "Azi am purtat un tricou alb.",
        "ru": "Сегодня я надел белую футболку.",
        "sv": "I dag hade jag på mig en vit T-shirt.",
        "tr": "Bugün beyaz bir tişört giydim.",
        "uk": "Сьогодні я вдягнув білу футболку.",
        "vi": "Hôm nay tôi mặc một chiếc áo thun trắng.",
        "yue": "今日我著咗件白色T恤。",
        "zh-Hans": "今天我穿了一件白色T恤。"
      },
