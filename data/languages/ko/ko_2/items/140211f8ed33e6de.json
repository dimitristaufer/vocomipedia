  "sentences": [
    {
      "target": "부모님의 애정을 느꼈어요.",
      "reading": "bumo-nim-ui aejeong-eul neukkyeosseoyo.",
      "translations": {
        "en": "I felt my parents' affection.",
        "ko": "부모님의 애정을 느꼈어요.",
        "ipa": "bumo-nim-ui aejeong-eul neukkyeosseoyo.",
        "ar": "شعرت بعاطفة والديّ.",
        "cs": "Cítila jsem lásku svých rodičů.",
        "da": "Jeg mærkede mine forældres kærlighed.",
        "de": "Ich spürte die Zuneigung meiner Eltern.",
        "el": "Ένιωσα τη στοργή των γονιών μου.",
        "es": "Sentí el cariño de mis padres.",
        "fi": "Tunsin vanhempieni rakkauden.",
        "fr": "J’ai senti l’affection de mes parents.",
        "he": "הרגשתי את האהבה של ההורים שלי.",
        "hi": "मुझे अपने माता-पिता का प्यार महसूस हुआ।",
        "hu": "Éreztem a szüleim szeretetét.",
        "id": "Saya merasakan kasih sayang orang tua saya.",
        "it": "Ho sentito l'affetto dei miei genitori.",
        "ja": "両親の愛情を感じました。",
        "nb": "Jeg kjente foreldrenes kjærlighet.",
        "nl": "Ik voelde de liefde van mijn ouders.",
        "pl": "Poczułem miłość moich rodziców.",
        "pt": "Senti o carinho dos meus pais.",
        "ro": "Am simțit dragostea părinților mei.",
        "ru": "Я почувствовал любовь родителей.",
        "sv": "Jag kände mina föräldrars kärlek.",
        "tr": "Ailemin sevgisini hissettim.",
        "uk": "Я відчув любов батьків.",
        "vi": "Tôi cảm nhận được tình yêu của bố mẹ mình.",
        "yue": "我感受到父母嘅愛意。",
        "zh-Hans": "我感受到了父母的爱意。"
      },
