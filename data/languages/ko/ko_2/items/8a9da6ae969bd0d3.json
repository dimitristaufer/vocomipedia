    {
      "target": "부모님의 건강을 빌어요.",
      "reading": "bumonimui geongangeul bireoyo.",
      "translations": {
        "en": "I pray for my parents’ health.",
        "ko": "부모님의 건강을 빌어요.",
        "ipa": "bumonimui geongangeul bireoyo.",
        "ar": "أدعو لسلامة والديّ.",
        "cs": "Modlím se za zdraví svých rodičů.",
        "da": "Jeg beder for mine forældres helbred.",
        "de": "Ich bete für die Gesundheit meiner Eltern.",
        "el": "Προσεύχομαι για την υγεία των γονιών μου.",
        "es": "Rezo por la salud de mis padres.",
        "fi": "Rukoilen vanhempieni terveyden puolesta.",
        "fr": "Je prie pour la santé de mes parents.",
        "he": "אני מתפלל לבריאות של ההורים שלי.",
        "hi": "मैं अपने माता-पिता के स्वास्थ्य के लिए प्रार्थना करता हूँ।",
        "hu": "Imádkozom a szüleim egészségéért.",
        "id": "Saya berdoa untuk kesehatan orang tua saya.",
        "it": "Prego per la salute dei miei genitori.",
        "ja": "両親の健康を祈ります。",
        "nb": "Jeg ber for foreldrenes helse.",
        "nl": "Ik bid voor de gezondheid van mijn ouders.",
        "pl": "Modlę się o zdrowie moich rodziców.",
        "pt": "Rezo pela saúde dos meus pais.",
        "ro": "Mă rog pentru sănătatea părinților mei.",
        "ru": "Я молюсь о здоровье моих родителей.",
        "sv": "Jag ber för mina föräldrars hälsa.",
        "tr": "Ailemin sağlığı için dua ediyorum.",
        "uk": "Я молюся за здоров’я своїх батьків.",
        "vi": "Tôi cầu nguyện cho sức khỏe của bố mẹ tôi.",
        "yue": "我為父母嘅健康祈禱。",
        "zh-Hans": "我为父母的健康祈祷。"
      },
