    {
      "target": "두 의자가 창가에 나란히 있어요.",
      "reading": "du uijaga changgae naranhi isseoyo.",
      "translations": {
        "en": "The two chairs are side by side by the window.",
        "ko": "두 의자가 창가에 나란히 있어요.",
        "ipa": "du uijaga changgae naranhi isseoyo.",
        "ar": "الكرسيان بجانب النافذة.",
        "cs": "Dvě židle jsou vedle sebe u okna.",
        "da": "De to stole står side om side ved vinduet.",
        "de": "Die beiden Stühle stehen nebeneinander am Fenster.",
        "el": "Οι δύο καρέκλες είναι η μία δίπλα στην άλλη δίπλα στο παράθυρο.",
        "es": "Las dos sillas están una al lado de la otra junto a la ventana.",
        "fi": "Kaksi tuolia on vierekkäin ikkunan äärellä.",
        "fr": "Les deux chaises sont côte à côte près de la fenêtre.",
        "he": "שני הכיסאות זה ליד זה ליד החלון.",
        "hi": "दो कुर्सियाँ खिड़की के पास बगल-बगल हैं।",
        "hu": "A két szék egymás mellett van az ablaknál.",
        "id": "Dua kursi itu berdampingan di dekat jendela.",
        "it": "Le due sedie sono una accanto all'altra vicino alla finestra.",
        "ja": "二つの椅子は窓のそばに並んでいます。",
        "nb": "De to stolene står ved siden av hverandre ved vinduet.",
        "nl": "De twee stoelen staan naast elkaar bij het raam.",
        "pl": "Dwa krzesła stoją obok siebie przy oknie.",
        "pt": "As duas cadeiras estão lado a lado perto da janela.",
        "ro": "Cele două scaune sunt unul lângă altul lângă fereastră.",
        "ru": "Два стула стоят рядом у окна.",
        "sv": "De två stolarna står bredvid varandra vid fönstret.",
        "tr": "İki sandalye pencerenin yanında yan yana duruyor.",
        "uk": "Два стільці стоять поруч біля вікна.",
        "vi": "Hai chiếc ghế đứng cạnh nhau bên cửa sổ.",
        "yue": "兩張櫈喺窗邊並排。",
        "zh-Hans": "两把椅子并排放在窗边。"
      },
