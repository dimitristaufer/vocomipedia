    {
      "target": "형부는 아이를 안고 있어요.",
      "reading": "hyeongbu-neun aireul ango isseoyo.",
      "translations": {
        "en": "My brother-in-law is holding a child.",
        "ko": "형부는 아이를 안고 있어요.",
        "ipa": "hyeongbu-neun aireul ango isseoyo.",
        "ar": "يحمل صهري طفلًا.",
        "cs": "Můj švagr drží dítě.",
        "da": "Min svoger holder et barn.",
        "de": "Mein Schwager hält ein Kind im Arm.",
        "el": "Ο κουνιάδος μου κρατάει ένα παιδί.",
        "es": "Mi cuñado sostiene a un niño.",
