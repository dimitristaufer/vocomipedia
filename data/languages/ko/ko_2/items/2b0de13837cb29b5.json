  "sentences": [
    {
      "target": "저는 매일 운동하겠다고 다짐했어요.",
      "reading": "jeoneun maeil undonghagettago dajimhaesseoyo.",
      "translations": {
        "en": "I promised myself I would exercise every day.",
        "ko": "저는 매일 운동하겠다고 다짐했어요.",
        "ipa": "jeoneun maeil undonghagettago dajimhaesseoyo.",
        "ar": "تعهدتُ أن أمارس الرياضة كل يوم.",
        "cs": "Slibovala jsem si, že budu cvičit každý den.",
        "da": "Jeg lovede mig selv, at jeg ville træne hver dag.",
        "de": "Ich habe mir vorgenommen, jeden Tag Sport zu machen.",
        "el": "Υποσχέθηκα στον εαυτό μου ότι θα γυμνάζομαι κάθε μέρα.",
        "es": "Me prometí hacer ejercicio todos los días.",
        "fi": "Lupasin itselleni, että liikkuisin joka päivä.",
        "fr": "Je me suis promis de faire de l'exercice tous les jours.",
        "he": "הבטחתי לעצמי שאעשה ספורט כל יום.",
        "hi": "मैंने खुद से वादा किया कि मैं हर दिन व्यायाम करूँगा।",
        "hu": "Megfogadtam, hogy minden nap edzeni fogok.",
        "id": "Saya berjanji pada diri sendiri bahwa saya akan berolahraga setiap hari.",
        "it": "Mi sono promesso che avrei fatto esercizio ogni giorno.",
        "ja": "私は毎日運動すると自分に誓いました。",
        "nb": "Jeg lovet meg selv at jeg skulle trene hver dag.",
        "nl": "Ik beloofde mezelf dat ik elke dag zou sporten.",
        "pl": "Przyrzekłam sobie, że będę ćwiczyć codziennie.",
        "pt": "Prometi a mim mesma que faria exercício todos os dias.",
        "ro": "Mi-am promis că voi face exerciții în fiecare zi.",
        "ru": "Я пообещала себе, что буду заниматься спортом каждый день.",
        "sv": "Jag lovade mig själv att träna varje dag.",
        "tr": "Her gün spor yapacağıma kendime söz verdim.",
        "uk": "Я пообіцяла собі, що займатимуся спортом щодня.",
        "vi": "Tôi đã tự hứa sẽ tập thể dục mỗi ngày.",
        "yue": "我答應咗自己每日都做運動。",
        "zh-Hans": "我答应自己每天都运动。"
      },
