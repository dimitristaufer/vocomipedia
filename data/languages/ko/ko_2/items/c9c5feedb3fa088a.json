  "sentences": [
    {
      "target": "선생님이 숙제를 빨리 내라고 요구하셨어요.",
      "reading": "seonsaengnim-i sukjereul ppalli naerago yoguhasyeosseoyo.",
      "translations": {
        "en": "The teacher asked us to turn in the homework quickly.",
        "ko": "선생님이 숙제를 빨리 내라고 요구하셨어요.",
        "ipa": "seonsaengnim-i sukjereul ppalli naerago yoguhasyeosseoyo.",
        "ar": "طلب المعلم أن نسلم الواجب بسرعة.",
        "cs": "Učitel požadoval, abychom odevzdali úkol rychle.",
        "da": "Læreren bad os om at aflevere lektierne hurtigt.",
        "de": "Der Lehrer hat verlangt, dass wir die Hausaufgaben schnell abgeben.",
        "el": "Ο δάσκαλος ζήτησε να παραδώσουμε γρήγορα τις εργασίες για το σπίτι.",
        "es": "El profesor nos pidió que entregáramos rápido la tarea.",
        "fi": "Opettaja pyysi meitä palauttamaan läksyt nopeasti.",
        "fr": "Le professeur nous a demandé de rendre les devoirs rapidement.",
        "he": "המורה ביקש שנגיש את שיעורי הבית מהר.",
        "hi": "शिक्षक ने हमें होमवर्क जल्दी जमा करने को कहा।",
        "hu": "A tanár azt kérte, hogy gyorsan adjuk be a házi feladatot.",
        "id": "Guru meminta kami mengumpulkan PR dengan cepat.",
        "it": "L'insegnante ci ha chiesto di consegnare i compiti in fretta.",
        "ja": "先生は宿題を早く提出するようにと言いました。",
        "nb": "Læreren ba oss om å levere inn leksene raskt.",
        "nl": "De leraar vroeg ons het huiswerk snel in te leveren.",
        "pl": "Nauczyciel poprosił, żebyśmy szybko oddali pracę domową.",
        "pt": "O professor pediu que entregássemos o dever de casa rápido.",
        "ro": "Profesorul ne-a cerut să predăm repede tema.",
        "ru": "Учитель попросил нас быстро сдать домашнее задание.",
        "sv": "Läraren bad oss att lämna in läxan snabbt.",
        "tr": "Öğretmen, ödevi hemen teslim etmemizi istedi.",
        "uk": "Учитель попросив нас швидко здати домашнє завдання.",
        "vi": "Giáo viên yêu cầu chúng tôi nộp bài tập về nhà nhanh.",
        "yue": "老師叫我哋快啲交功課。",
        "zh-Hans": "老师要求我们尽快交作业。"
      },
