  "sentences": [
    {
      "target": "길을 잘못 들었어요. 그러다 늦었어요.",
      "reading": "gireul jalmot deureosseoyo. geureoda neujeosseoyo.",
      "translations": {
        "en": "I took the wrong road, and then I was late.",
        "ko": "길을 잘못 들었어요. 그러다 늦었어요.",
        "ipa": "gireul jalmot deureosseoyo. geureoda neujeosseoyo.",
        "ar": "ضللت الطريق، ثم تأخرت.",
        "cs": "Ztratil jsem se na cestě, a pak jsem přišel pozdě.",
        "da": "Jeg kom på den forkerte vej, og så kom jeg for sent.",
        "de": "Ich bin falsch abgebogen, und dann bin ich zu spät gekommen.",
        "el": "Πήρα λάθος δρόμο, και μετά άργησα.",
        "es": "Tomé el camino equivocado, y entonces llegué tarde.",
        "fi": "Eksyin tieltä, ja sitten myöhästyin.",
        "fr": "Je me suis trompé de route, et puis je suis arrivé en retard.",
        "he": "לקחתי את הדרך הלא נכונה, ואז איחרתי.",
        "hi": "मैं गलत रास्ते पर चला गया, और फिर मैं देर से पहुँचा।",
        "hu": "Eltévedtem az úton, aztán elkéstem.",
        "id": "Saya salah jalan, lalu saya terlambat.",
        "it": "Ho sbagliato strada, e poi sono arrivato in ritardo.",
        "ja": "道を間違えました。それで遅れました。",
        "nb": "Jeg tok feil vei, og så ble jeg sen.",
        "nl": "Ik slo de verkeerde weg in, en toen kwam ik te laat.",
        "pl": "Poszedłem złą drogą, a potem się spóźniłem.",
        "pt": "Peguei o caminho errado e, então, me atrasei.",
        "ro": "Am luat-o pe drumul greșit, apoi am întârziat.",
        "ru": "Я свернул не туда, а потом опоздал.",
        "sv": "Jag tog fel väg, och sedan blev jag sen.",
        "tr": "Yanlış yola saptım, sonra da geç kaldım.",
        "uk": "Я звернув не туди, а потім запізнився.",
        "vi": "Tôi đi nhầm đường, rồi tôi bị muộn.",
        "yue": "我行錯路，跟住遲到咗。",
        "zh-Hans": "我走错路了，然后迟到了。"
      },
