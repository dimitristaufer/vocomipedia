  "sentences": [
    {
      "target": "저는 그 말을 해서 지금도 후회해요.",
      "reading": "Jeoneun geu mareul haeseo jigeumdo huhoehaeyo.",
      "translations": {
        "en": "I still regret saying that.",
        "ko": "저는 그 말을 해서 지금도 후회해요.",
        "ipa": "Jeoneun geu mareul haeseo jigeumdo huhoehaeyo.",
        "ar": "ما زلت أندم على قول ذلك.",
        "cs": "Stále lituji, že jsem to řekl.",
        "da": "Jeg fortryder stadig, at jeg sagde det.",
        "de": "Ich bereue immer noch, das gesagt zu haben.",
        "el": "Το μετανιώνω ακόμα που το είπα.",
        "es": "Todavía me arrepiento de haber dicho eso.",
        "fi": "Kadun yhä, että sanoin sen.",
        "fr": "Je regrette encore d’avoir dit ça.",
        "he": "אני עדיין מתחרט שאמרתי את זה.",
        "hi": "मुझे अब भी यह कहने का पछतावा है।",
        "hu": "Még most is bánom, hogy azt mondtam.",
        "id": "Saya masih menyesal telah mengatakan itu.",
        "it": "Mi pento ancora di averlo detto.",
        "ja": "私は今でもそれを言ったことを後悔しています。",
        "nb": "Jeg angrer fortsatt på at jeg sa det.",
        "nl": "Ik heb er nog steeds spijt van dat ik dat heb gezegd.",
        "pl": "Nadal żałuję, że to powiedziałem.",
        "pt": "Ainda me arrependo de ter dito isso.",
        "ro": "Încă regret că am spus asta.",
        "ru": "Я до сих пор жалею, что сказал это.",
        "sv": "Jag ångrar fortfarande att jag sa det.",
        "tr": "Bunu söylediğime hâlâ pişmanım.",
        "uk": "Я досі шкодую, що сказав це.",
        "vi": "Tôi vẫn hối hận vì đã nói vậy.",
        "yue": "我而家都後悔講咗嗰句說話。",
        "zh-Hans": "我现在还后悔说了那句话。"
      },
