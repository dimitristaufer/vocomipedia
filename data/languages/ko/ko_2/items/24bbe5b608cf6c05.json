    {
      "target": "나중에 후회하지 마세요.",
      "reading": "Najunge huhoehaji maseyo.",
      "translations": {
        "en": "Don't regret it later.",
        "ko": "나중에 후회하지 마세요.",
        "ipa": "Najunge huhoehaji maseyo.",
        "ar": "لا تندم على ذلك لاحقًا.",
        "cs": "Později toho nebudete litovat.",
        "da": "Fortryd det ikke senere.",
        "de": "Bereuen Sie es nicht später.",
        "el": "Μην το μετανιώσετε αργότερα.",
        "es": "No te arrepientas luego.",
        "fi": "Älä kadu sitä myöhemmin.",
        "fr": "Ne le regrettez pas plus tard.",
        "he": "אל תתחרט על זה אחר כך.",
        "hi": "बाद में पछताना मत।",
        "hu": "Ne bánd meg később.",
        "id": "Jangan menyesal nanti.",
        "it": "Non te ne pentire più tardi.",
        "ja": "あとで後悔しないでください。",
        "nb": "Ikke angre på det senere.",
        "nl": "Heb er later geen spijt van.",
        "pl": "Nie żałuj tego później.",
        "pt": "Não se arrependa depois.",
        "ro": "Nu regreta mai târziu.",
        "ru": "Не жалейте об этом потом.",
        "sv": "Ångra det inte senare.",
        "tr": "Sonra pişman olma.",
        "uk": "Не шкодуйте про це потім.",
        "vi": "Đừng hối hận sau này.",
        "yue": "唔好之後先後悔。",
        "zh-Hans": "别以后再后悔。"
      },
