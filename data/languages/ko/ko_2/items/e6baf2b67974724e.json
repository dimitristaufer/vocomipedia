    {
      "target": "아이가 악몽을 꾸고 울었어요.",
      "reading": "aiga angmong-eul kkugo ureosseoyo.",
      "translations": {
        "en": "The child had a nightmare and cried.",
        "ko": "아이가 악몽을 꾸고 울었어요.",
        "ipa": "aiga angmong-eul kkugo ureosseoyo.",
        "ar": "رأى الطفل كابوسًا وبكى.",
        "cs": "Dítě mělo noční můru a plakalo.",
        "da": "Barnet havde et mareridt og græd.",
        "de": "Das Kind hatte einen Albtraum und weinte.",
        "el": "Το παιδί είδε έναν εφιάλτη και έκλαψε.",
        "es": "El niño tuvo una pesadilla y lloró.",
        "fi": "Lapsella oli painajainen, ja hän itki.",
        "fr": "L'enfant a fait un cauchemar et a pleuré.",
        "he": "הילד חלם חלום בלהות ובכה.",
        "hi": "बच्चे को बुरा सपना आया और वह रो पड़ा।",
        "hu": "A gyereknek rémálma volt, és sírt.",
        "id": "Anak itu mimpi buruk dan menangis.",
        "it": "Il bambino ha avuto un incubo e ha pianto.",
        "ja": "子どもが悪夢を見て泣きました。",
        "nb": "Barnet hadde et mareritt og gråt.",
        "nl": "Het kind had een nachtmerrie en huilde.",
        "pl": "Dziecko miało koszmar i płakało.",
        "pt": "A criança teve um pesadelo e chorou.",
        "ro": "Copilul a avut un coșmar și a plâns.",
        "ru": "У ребёнка был кошмар, и он заплакал.",
        "sv": "Barnet hade en mardröm och grät.",
        "tr": "Çocuğun kabusu vardı ve ağladı.",
        "uk": "У дитини був кошмар, і вона заплакала.",
        "vi": "Đứa trẻ bị ác mộng và khóc.",
        "yue": "個細路發噩夢，仲喊咗。",
        "zh-Hans": "孩子做了噩梦，哭了。"
      },
