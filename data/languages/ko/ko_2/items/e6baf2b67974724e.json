  "sentences": [
    {
      "target": "어젯밤에 악몽을 꿨어요.",
      "reading": "eojetbame angmong-eul kkwosseoyo.",
      "translations": {
        "en": "I had a nightmare last night.",
        "ko": "어젯밤에 악몽을 꿨어요.",
        "ipa": "eojetbame angmong-eul kkwosseoyo.",
        "ar": "رأيت كابوسًا الليلة الماضية.",
        "cs": "V noci se mi zdál noční můra.",
        "da": "Jeg havde et mareridt i går nat.",
        "de": "Ich hatte letzte Nacht einen Albtraum.",
        "el": "Είδα έναν εφιάλτη χθες το βράδυ.",
        "es": "Anoche tuve una pesadilla.",
        "fi": "Näin viime yönä painajaista.",
        "fr": "J'ai fait un cauchemar hier soir.",
        "he": "חלמתי חלום בלהות אתמול בלילה.",
        "hi": "मैंने कल रात बुरा सपना देखा।",
        "hu": "Tegnap éjjel rémálmom volt.",
        "id": "Saya mimpi buruk tadi malam.",
        "it": "Ho fatto un incubo la scorsa notte.",
        "ja": "昨夜、悪夢を見ました。",
        "nb": "Jeg hadde et mareritt i natt.",
        "nl": "Ik had vannacht een nachtmerrie.",
        "pl": "Miałem dziś w nocy koszmar.",
        "pt": "Tive um pesadelo ontem à noite.",
        "ro": "Am avut un coșmar aseară.",
        "ru": "Мне снился кошмар прошлой ночью.",
        "sv": "Jag hade en mardröm i natt.",
        "tr": "Dün gece kabus gördüm.",
        "uk": "Мені наснився кошмар минулої ночі.",
        "vi": "Tối qua tôi bị ác mộng.",
        "yue": "我尋晚發咗個噩夢。",
        "zh-Hans": "我昨晚做了个噩梦。"
      },
