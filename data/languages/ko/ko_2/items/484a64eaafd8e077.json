  "sentences": [
    {
      "target": "그녀의 슬픔이 얼굴에 드러났어요.",
      "reading": "geunyeoui seulpeumi eolgure deurannasseoyo.",
      "translations": {
        "en": "Her sorrow was visible on her face.",
        "ko": "그녀의 슬픔이 얼굴에 드러났어요.",
        "ipa": "geunyeoui seulpeumi eolgure deurannasseoyo.",
        "ar": "ظهر الحزن على وجهها.",
        "cs": "Její smutek byl vidět na tváři.",
        "da": "Hendes sorg kunne ses i ansigtet.",
        "de": "Ihr Schmerz war in ihrem Gesicht zu sehen.",
        "el": "Η θλίψη της φαινόταν στο πρόσωπό της.",
        "es": "Su tristeza se notaba en la cara.",
        "fi": "Hänen surunsa näkyi kasvoilla.",
        "fr": "Sa tristesse se lisait sur son visage.",
        "he": "העצב שלה היה ניכר בפניה.",
        "hi": "उसके चेहरे पर उसका दुख झलक रहा था।",
        "hu": "Az arcán látszott a szomorúsága.",
        "id": "Kesedihannya terlihat di wajahnya.",
        "it": "La sua tristezza si vedeva sul viso.",
        "ja": "彼女の悲しみが顔に表れていました。",
        "nb": "Sorgen hennes syntes i ansiktet.",
        "nl": "Haar verdriet was op haar gezicht te zien.",
        "pl": "Jej smutek był widoczny na twarzy.",
        "pt": "A tristeza dela estava visível no rosto.",
        "ro": "Tristețea ei se vedea pe față.",
        "ru": "Её печаль была видна на лице.",
        "sv": "Hennes sorg syntes i ansiktet.",
        "tr": "Üzüntüsü yüzünden belli oluyordu.",
        "uk": "Її смуток був помітний на обличчі.",
        "vi": "Nỗi buồn của cô ấy hiện rõ trên khuôn mặt.",
        "yue": "佢嘅悲傷喺塊面上睇得出。",
        "zh-Hans": "她脸上流露出悲伤。"
      },
