  "sentences": [
    {
      "target": "할머니는 안방에서 쉬고 계세요.",
      "reading": "halmeonineun anbangeseo swigo gyeseyo.",
      "translations": {
        "en": "Grandma is resting in the inner room.",
        "ko": "할머니는 안방에서 쉬고 계세요.",
        "ipa": "halmeonineun anbangeseo swigo gyeseyo.",
        "ar": "تستريح الجدة في الغرفة الداخلية.",
        "cs": "Babička odpočívá ve vnitřním pokoji.",
        "da": "Bedstemor hviler sig i det inderste værelse.",
        "de": "Oma ruht sich im inneren Zimmer aus.",
        "el": "Η γιαγιά ξεκουράζεται στο εσωτερικό δωμάτιο.",
        "es": "La abuela está descansando en la habitación interior.",
        "fi": "Mummo lepää sisähuoneessa.",
        "fr": "Grand-mère se repose dans la pièce du fond.",
        "he": "סבתא נחה בחדר הפנימי.",
        "hi": "दादी अंदर वाले कमरे में आराम कर रही हैं।",
        "hu": "A nagymama a belső szobában pihen.",
        "id": "Nenek sedang beristirahat di kamar dalam.",
        "it": "La nonna si riposa nella stanza interna.",
        "ja": "おばあさんは奥の部屋で休んでいます。",
        "nb": "Bestemor hviler seg i innerrommet.",
        "nl": "Oma rust in de binnenkamer.",
        "pl": "Babcia odpoczywa w wewnętrznym pokoju.",
        "pt": "A avó está descansando no quarto de dentro.",
        "ro": "Bunica se odihnește în camera din spate.",
        "ru": "Бабушка отдыхает во внутренней комнате.",
        "sv": "Mormor vilar i inre rummet.",
        "tr": "Büyükanne iç odada dinleniyor.",
        "uk": "Бабуся відпочиває у внутрішній кімнаті.",
        "vi": "Bà đang nghỉ trong phòng trong.",
        "yue": "嫲嫲喺內房休息。",
        "zh-Hans": "奶奶在里屋休息。"
      },
