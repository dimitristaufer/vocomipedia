    {
      "target": "신발이 진흙에 가라앉았어요.",
      "reading": "sinbari jinheuge garaanjasseoyo.",
      "translations": {
        "en": "My shoe sank into the mud.",
        "ko": "신발이 진흙에 가라앉았어요.",
        "ipa": "sinbari jinheuge garaanjasseoyo.",
        "ar": "غرقت حذائي في الطين.",
        "cs": "Moje bota se zabořila do bláta.",
        "da": "Min sko sank ned i mudderet.",
        "de": "Mein Schuh sank in den Schlamm ein.",
        "el": "Το παπούτσι μου βούλιαξε στη λάσπη.",
        "es": "Mi zapato se hundió en el barro.",
        "fi": "Kenkeni upposi mutaan.",
        "fr": "Ma chaussure s'est enfoncée dans la boue.",
        "he": "הנעל שלי שקעה בבוץ.",
        "hi": "मेरी जूती कीचड़ में धँस गई।",
        "hu": "A cipőm belesüppedt a sárba.",
        "id": "Sepatuku tenggelam ke dalam lumpur.",
        "it": "La mia scarpa è affondata nel fango.",
        "ja": "靴が泥に沈みました。",
        "nb": "Skoen min sank ned i gjørma.",
        "nl": "Mijn schoen zonk weg in de modder.",
        "pl": "Mój but zapadł się w błoto.",
        "pt": "Meu sapato afundou na lama.",
        "ro": "Pantoful meu s-a afundat în noroi.",
        "ru": "Мой ботинок увяз в грязи.",
        "sv": "Min sko sjönk ner i leran.",
        "tr": "Ayakkabım çamura battı.",
        "uk": "Моє взуття загрузло в багнюці.",
        "vi": "Giày của tôi bị lún vào bùn.",
        "yue": "我對鞋沉咗喺泥入面。",
        "zh-Hans": "我的鞋陷进了泥里。"
      },
