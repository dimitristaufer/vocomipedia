  "sentences": [
    {
      "target": "비가 그쳐서 엄마가 빨래를 거두셨어요.",
      "reading": "biga geuchyeoseo eommaga ppallaereul geoduseosseoyo.",
      "translations": {
        "en": "The rain stopped, so Mom took in the laundry.",
        "ko": "비가 그쳐서 엄마가 빨래를 거두셨어요.",
        "ipa": "biga geuchyeoseo eommaga ppallaereul geoduseosseoyo.",
        "ar": "انقطع المطر، فأخذت أمي الغسيل من على الحبل.",
        "cs": "Přestalo pršet, tak maminka sundala prádlo.",
        "da": "Det stoppede med at regne, så mor tog vasketøjet ind.",
        "de": "Es hat aufgehört zu regnen, also hat Mama die Wäsche reingeholt.",
        "el": "Η βροχή σταμάτησε, οπότε η μαμά μάζεψε τα ρούχα.",
        "es": "Dejó de llover, así que mamá recogió la ropa.",
        "fi": "Sade lakkasi, joten äiti otti pyykit sisään.",
        "fr": "La pluie s’est arrêtée, alors maman a rentré le linge.",
        "he": "הגשם פסק, אז אמא הכניסה את הכביסה.",
        "hi": "बारिश रुक गई, तो माँ ने कपड़े अंदर ले लिए।",
        "hu": "Elállt az eső, úgyhogy anya behozta a ruhákat.",
        "id": "Hujan sudah berhenti, jadi Ibu mengambil jemuran.",
        "it": "Ha smesso di piovere, così mamma ha ritirato il bucato.",
        "ja": "雨がやんだので、母が洗濯物を取り込みました。",
        "nb": "Det sluttet å regne, så mamma tok inn klesvasken.",
        "nl": "Het stopte met regenen, dus mama haalde de was binnen.",
        "pl": "Przestało padać, więc mama zabrała pranie z balkonu.",
        "pt": "A chuva parou, então a mãe recolheu a roupa.",
        "ro": "A încetat să plouă, așa că mama a luat rufele.",
        "ru": "Дождь прекратился, и мама забрала белье.",
        "sv": "Det slutade regna, så mamma tog in tvätten.",
        "tr": "Yağmur dindi, bu yüzden annem çamaşırları içeri aldı.",
        "uk": "Дощ припинився, тож мама занесла білизну.",
        "vi": "Mưa đã tạnh nên mẹ đã cất quần áo vào.",
        "yue": "雨停咗，所以媽咪將晾緊嘅衫收返入屋。",
        "zh-Hans": "雨停了，所以妈妈把晾着的衣服收进来了。"
      },
