  "sentences": [
    {
      "target": "아이가 울어도 그는 외면했어요.",
      "reading": "aiga ureodo geuneun oemyeonhaesseoyo.",
      "translations": {
        "en": "Even though the child was crying, he ignored it.",
        "ko": "아이가 울어도 그는 외면했어요.",
        "ipa": "aiga ureodo geuneun oemyeonhaesseoyo.",
        "ar": "حتى عندما كان الطفل يبكي، تجاهله.",
        "cs": "I když dítě plakalo, ignoroval ho.",
        "da": "Selv om barnet græd, ignorerede han det.",
        "de": "Auch wenn das Kind weinte, ignorierte er es.",
        "el": "Παρόλο που το παιδί έκλαιγε, εκείνος το αγνόησε.",
        "es": "Aunque el niño lloraba, él lo ignoró.",
        "fi": "Vaikka lapsi itki, hän ei välittänyt siitä.",
        "fr": "Même si l'enfant pleurait, il l'a ignoré.",
        "he": "גם כשהילד בכה, הוא התעלם ממנו.",
        "hi": "बच्चा रो रहा था, फिर भी उसने उसे अनदेखा किया।",
        "hu": "Bár a gyerek sírt, ő figyelmen kívül hagyta.",
        "id": "Meski anak itu menangis, dia mengabaikannya.",
        "it": "Anche se il bambino piangeva, lui lo ignorò.",
        "ja": "子どもが泣いていても、彼は無視しました。",
        "nb": "Selv om barnet gråt, ignorerte han det.",
        "nl": "Zelfs al huilde het kind, hij negeerde het.",
        "pl": "Nawet gdy dziecko płakało, on je zignorował.",
        "pt": "Mesmo que a criança estivesse chorando, ele a ignorou.",
        "ro": "Chiar dacă copilul plângea, el l-a ignorat.",
        "ru": "Хотя ребёнок плакал, он его проигнорировал.",
        "sv": "Trots att barnet grät ignorerade han det.",
        "tr": "Çocuk ağlasa da onu görmezden geldi.",
        "uk": "Хоча дитина плакала, він її проігнорував.",
        "vi": "Dù đứa trẻ đang khóc, anh ta vẫn phớt lờ nó.",
        "yue": "就算個細路喺度喊，佢都無理會。",
        "zh-Hans": "即使孩子在哭，他还是不理会。"
      },
