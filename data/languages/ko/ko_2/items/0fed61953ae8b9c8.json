    {
      "target": "그는 잠시 의식을 잃었습니다.",
      "reading": "geuneun jamsi uisik-eul ilheosseumnida",
      "translations": {
        "en": "He briefly lost consciousness.",
        "ko": "그는 잠시 의식을 잃었습니다.",
        "ipa": "geuneun jamsi uisik-eul ilheosseumnida",
        "ar": "فقد وعيه للحظة.",
        "cs": "Na chvíli ztratil vědomí.",
        "da": "Han mistede kortvarigt bevidstheden.",
        "de": "Er verlor kurz das Bewusstsein.",
        "el": "Έχασε τις αισθήσεις του για λίγο.",
        "es": "Perdió el conocimiento por un momento.",
        "fi": "Hän menetti hetkeksi tajuntansa.",
        "fr": "Il a perdu connaissance pendant un instant.",
        "he": "הוא איבד את הכרתו לרגע.",
        "hi": "उसने थोड़ी देर के लिए होश खो दिया।",
        "hu": "Egy pillanatra elvesztette az eszméletét.",
        "id": "Dia sempat kehilangan kesadaran.",
        "it": "Ha perso conoscenza per un momento.",
        "ja": "彼は少しの間、意識を失いました。",
        "nb": "Han mistet bevisstheten et øyeblikk.",
        "nl": "Hij verloor even het bewustzijn.",
        "pl": "Na chwilę stracił przytomność.",
        "pt": "Ele perdeu a consciência por um momento.",
        "ro": "Și-a pierdut cunoștința pentru puțin timp.",
        "ru": "Он на мгновение потерял сознание.",
        "sv": "Han tappade medvetandet för en stund.",
        "tr": "Bir anlığına bilincini kaybetti.",
        "uk": "Він на мить втратив свідомість.",
        "vi": "Anh ấy đã mất ý thức trong chốc lát.",
        "yue": "佢暫時失去咗知覺。",
        "zh-Hans": "他短暂失去了意识。"
      },
