    {
      "target": "커피 대신 차를 마실게요.",
      "reading": "keopi daesin chareul masilgeyo.",
      "translations": {
        "en": "I'll drink tea instead of coffee.",
        "ko": "커피 대신 차를 마실게요.",
        "ipa": "keopi daesin chareul masilgeyo.",
        "ar": "سأشرب الشاي بدلًا من القهوة.",
        "cs": "Dám si čaj místo kávy.",
        "da": "Jeg vil drikke te i stedet for kaffe.",
        "de": "Ich trinke Tee statt Kaffee.",
        "el": "Θα πιω τσάι αντί για καφέ.",
        "es": "Tomaré té en vez de café.",
        "fi": "Juon teetä kahvin sijaan.",
        "fr": "Je vais boire du thé au lieu du café.",
        "he": "אני אשתה תה במקום קפה.",
        "hi": "मैं कॉफी की बजाय चाय पिऊँगा।",
        "hu": "Kávé helyett teát iszom.",
        "id": "Saya akan minum teh kopi.",
        "it": "Berò il tè al posto del caffè.",
        "ja": "コーヒーの代わりにお茶を飲みます。",
        "nb": "Jeg skal drikke te i stedet for kaffe.",
        "nl": "Ik ga thee drinken in plaats van koffie.",
        "pl": "Wypiję herbatę zamiast kawy.",
        "pt": "Vou beber chá em vez de café.",
        "ro": "O să beau ceai în loc de cafea.",
        "ru": "Я буду пить чай вместо кофе.",
        "sv": "Jag ska dricka te i stället för kaffe.",
        "tr": "Kahve yerine çay içeceğim.",
        "uk": "Я питиму чай замість кави.",
        "vi": "Tôi sẽ uống trà thay vì cà phê.",
        "yue": "我會飲茶唔飲咖啡。",
        "zh-Hans": "我会喝茶，不喝咖啡。"
      },
