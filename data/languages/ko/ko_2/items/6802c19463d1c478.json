  "sentences": [
    {
      "target": "유교는 예절을 중요하게 여겨요.",
      "reading": "yugyoneun yejeoreul jungyohage yeogyeoyo.",
      "translations": {
        "en": "Confucianism values etiquette.",
        "ko": "유교는 예절을 중요하게 여겨요.",
        "ipa": "yugyoneun yejeoreul jungyohage yeogyeoyo.",
        "ar": "تولي الكونفوشيوسية أهمية كبيرة للأدب والاحترام.",
        "cs": "Konfucianismus klade velký důraz na zdvořilost.",
        "da": "Konfucianisme lægger stor vægt på etikette.",
        "de": "Der Konfuzianismus legt großen Wert auf Etikette.",
        "el": "Ο κομφουκιανισμός δίνει μεγάλη σημασία στην ευγένεια.",
        "es": "El confucianismo da mucha importancia a la etiqueta.",
        "fi": "Kungfutselaisuus pitää etikettiä tärkeänä.",
        "fr": "Le confucianisme accorde une grande importance aux bonnes manières.",
        "he": "הקונפוציאניזם מייחס חשיבות רבה לנימוסים.",
        "hi": "कन्फ्यूशियसवाद शिष्टाचार को बहुत महत्व देता है।",
        "hu": "A konfucianizmus nagy jelentőséget tulajdonít az illemnek.",
        "id": "Konfusianisme sangat mementingkan tata krama.",
        "it": "Il confucianesimo dà grande importanza all'etichetta.",
        "ja": "儒教は礼儀を大切にします。",
        "nb": "Konfucianismen legger stor vekt på etikette.",
        "nl": "Het confucianisme hecht veel waarde aan etiquette.",
        "pl": "Konfucjanizm przywiązuje dużą wagę do dobrych manier.",
        "pt": "O confucionismo dá muita importância à etiqueta.",
        "ro": "Confucianismul pune mare preț pe etichetă.",
        "ru": "Конфуцианство придаёт большое значение этикету.",
        "sv": "Konfucianismen lägger stor vikt vid etikett.",
        "tr": "Konfüçyüsçülük görgü kurallarına büyük önem verir.",
        "uk": "Конфуціанство надає великого значення етикету.",
        "vi": "Nho giáo rất coi trọng lễ nghi.",
        "yue": "儒家好重視禮儀。",
        "zh-Hans": "儒家很重视礼仪。"
      },
