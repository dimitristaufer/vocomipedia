    {
      "target": "바람이 제 모자를 날려 버렸어요.",
      "reading": "Barami je mojareul nallyeo beoryeosseoyo.",
      "translations": {
        "en": "The wind blew my hat away.",
        "ko": "바람이 제 모자를 날려 버렸어요.",
        "ipa": "Barami je mojareul nallyeo beoryeosseoyo.",
        "ar": "أطاحت الرياح بقبعتي.",
        "cs": "Vítr mi odfoukl klobouk.",
        "da": "Vinden blæste min hat væk.",
        "de": "Der Wind hat meinen Hut weggeweht.",
        "el": "Ο αέρας πήρε το καπέλο μου.",
        "es": "El viento se llevó mi sombrero.",
        "fi": "Tuuli vei hattuni.",
        "fr": "Le vent a emporté mon chapeau.",
        "he": "הרוח העיפה את הכובע שלי.",
        "hi": "हवा मेरा टोपी उड़ा ले गई।",
        "hu": "A szél elfújta a kalapomat.",
        "id": "Angin menerbangkan topi saya.",
        "it": "Il vento mi ha portato via il cappello.",
        "ja": "風で私の帽子が飛ばされてしまいました。",
        "nb": "Vinden blåste hatten min bort.",
        "nl": "De wind blies mijn hoed weg.",
        "pl": "Wiatr porwał mój kapelusz.",
        "pt": "O vento levou meu chapéu.",
        "ro": "Vântul mi-a luat pălăria.",
        "ru": "Ветер унес мою шляпу.",
        "sv": "Vinden blåste bort min hatt.",
        "tr": "Rüzgâr şapkamı uçurdu.",
        "uk": "Вітер зірвав мою шапку.",
        "vi": "Gió thổi bay chiếc mũ của tôi.",
        "yue": "風將我頂帽吹走咗。",
        "zh-Hans": "风把我的帽子吹走了。"
      },
