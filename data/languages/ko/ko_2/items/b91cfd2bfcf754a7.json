    {
      "target": "할머니를 위해 매일 간호를 해요.",
      "reading": "halmeonireul wihae maeil ganhoreul haeyo.",
      "translations": {
        "en": "I care for my grandmother every day.",
        "ko": "할머니를 위해 매일 간호를 해요.",
        "ipa": "halmeonireul wihae maeil ganhoreul haeyo.",
        "ar": "أعتني بجدتي كل يوم.",
        "cs": "Každý den se starám o svou babičku.",
        "da": "Jeg passer min bedstemor hver dag.",
        "de": "Ich kümmere mich jeden Tag um meine Großmutter.",
        "el": "Φροντίζω τη γιαγιά μου κάθε μέρα.",
        "es": "Cuido de mi abuela todos los días.",
        "fi": "Pidän huolta isoäidistäni joka päivä.",
        "fr": "Je m'occupe de ma grand-mère tous les jours.",
        "he": "אני מטפל בסבתא שלי כל יום.",
        "hi": "मैं हर दिन अपनी दादी की देखभाल करता हूँ।",
        "hu": "Minden nap gondoskodom a nagymamámról.",
        "id": "Saya merawat nenek saya setiap hari.",
        "it": "Mi prendo cura di mia nonna ogni giorno.",
        "ja": "私は毎日祖母の世話をしています。",
        "nb": "Jeg tar meg av bestemoren min hver dag.",
        "nl": "Ik zorg elke dag voor mijn oma.",
        "pl": "Codziennie opiekuję się moją babcią.",
        "pt": "Cuido da minha avó todos os dias.",
        "ro": "Am grijă de bunica mea în fiecare zi.",
        "ru": "Я каждый день забочусь о своей бабушке.",
        "sv": "Jag tar hand om min mormor varje dag.",
        "tr": "Her gün büyükanneme bakıyorum.",
        "uk": "Я щодня дбаю про свою бабусю.",
        "vi": "Tôi chăm sóc bà tôi mỗi ngày.",
        "yue": "我每日都照顧我嫲嫲。",
        "zh-Hans": "我每天都照顾我的奶奶。"
      },
