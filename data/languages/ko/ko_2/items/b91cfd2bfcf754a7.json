  "sentences": [
    {
      "target": "어머니는 집에서 간호를 받으셨어요.",
      "reading": "eomeonineun jibeseo ganhoreul badeusyeosseoyo.",
      "translations": {
        "en": "My mother received nursing care at home.",
        "ko": "어머니는 집에서 간호를 받으셨어요.",
        "ipa": "eomeonineun jibeseo ganhoreul badeusyeosseoyo.",
        "ar": "تلقت والدتي رعاية تمريضية في المنزل.",
        "cs": "Moje matka dostávala doma ošetřovatelskou péči.",
        "da": "Min mor fik sygepleje derhjemme.",
        "de": "Meine Mutter wurde zu Hause gepflegt.",
        "el": "Η μητέρα μου έλαβε νοσηλευτική φροντίδα στο σπίτι.",
        "es": "Mi madre recibió atención de enfermería en casa.",
        "fi": "Äitini sai hoitoa kotona.",
        "fr": "Ma mère a reçu des soins infirmiers à la maison.",
        "he": "אמא שלי קיבלה טיפול סיעודי בבית.",
        "hi": "मेरी माँ ने घर पर नर्सिंग देखभाल ली।",
        "hu": "Anyám otthon ápolásban részesült.",
        "id": "Ibu saya menerima perawatan di rumah.",
        "it": "Mia madre ha ricevuto assistenza infermieristica a casa.",
        "ja": "母は家で看護を受けました。",
        "nb": "Moren min fikk pleie hjemme.",
        "nl": "Mijn moeder kreeg thuis verpleging.",
        "pl": "Moja mama otrzymała opiekę pielęgniarską w domu.",
        "pt": "Minha mãe recebeu cuidados de enfermagem em casa.",
        "ro": "Mama mea a primit îngrijire la domiciliu.",
        "ru": "Моей маме оказывали уход дома.",
        "sv": "Min mamma fick omvårdnad hemma.",
        "tr": "Annem evde bakım aldı.",
        "uk": "Моїй мамі надавали догляд удома.",
        "vi": "Mẹ tôi đã được chăm sóc tại nhà.",
        "yue": "我媽媽喺屋企接受咗護理。",
        "zh-Hans": "我妈妈在家里接受了护理。"
      },
