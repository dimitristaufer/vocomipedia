  "sentences": [
    {
      "target": "장모와 함께 시장에 갔어요.",
      "reading": "jangmo-wa hamkke sijange gasseoyo.",
      "translations": {
        "en": "I went to the market with my mother-in-law.",
        "ko": "장모와 함께 시장에 갔어요.",
        "ipa": "jangmo-wa hamkke sijange gasseoyo.",
        "ar": "ذهبت إلى السوق مع حماتي.",
        "cs": "Šel jsem na trh s tchyní.",
        "da": "Jeg tog på marked med min svigermor.",
        "de": "Ich bin mit meiner Schwiegermutter zum Markt gegangen.",
        "el": "Πήγα στην αγορά με την πεθερά μου.",
        "es": "Fui al mercado con mi suegra.",
        "fi": "Menin torille anoppini kanssa.",
        "fr": "Je suis allé au marché avec ma belle-mère.",
        "he": "הלכתי לשוק עם חמותי.",
        "hi": "मैं अपनी सास के साथ बाज़ार गया।",
        "hu": "Elmentem a piacra az anyósommal.",
        "id": "Saya pergi ke pasar dengan ibu mertua saya.",
        "it": "Sono andato al mercato con mia suocera.",
        "ja": "義母といっしょに市場へ行きました。",
        "nb": "Jeg dro på markedet med svigermoren min.",
        "nl": "Ik ging met mijn schoonmoeder naar de markt.",
        "pl": "Poszedłem na targ z moją teściową.",
        "pt": "Fui ao mercado com a minha sogra.",
        "ro": "Am mers la piață cu soacra mea.",
        "ru": "Я пошёл на рынок с тёщей.",
        "sv": "Jag gick till marknaden med min svärmor.",
        "tr": "Kayınvalidemle pazara gittim.",
        "uk": "Я пішов на ринок із тещею.",
        "vi": "Tôi đã đi chợ với mẹ vợ.",
        "yue": "我同我外母去咗街市。",
        "zh-Hans": "我和岳母一起去了市场。"
      },
