  "sentences": [
    {
      "target": "할아버지는 오래 아프다가 집에서 숨지셨어요.",
      "reading": "harabojineun orae apeudaga jibeseo sumjisyeosseoyo.",
      "translations": {
        "en": "My grandfather had been ill for a long time and passed away at home.",
        "ko": "할아버지는 오래 아프다가 집에서 숨지셨어요.",
        "ipa": "harabojineun orae apeudaga jibeseo sumjisyeosseoyo.",
        "ar": "كان جدي مريضًا لفترة طويلة وتوفي في البيت.",
        "cs": "Můj dědeček byl dlouho nemocný a zemřel doma.",
        "da": "Min bedstefar var syg i lang tid og døde derhjemme.",
        "de": "Mein Großvater war lange krank und ist zu Hause gestorben.",
        "el": "Ο παππούς μου ήταν άρρωστος για πολύ καιρό και πέθανε στο σπίτι.",
        "es": "Mi abuelo estuvo enfermo mucho tiempo y falleció en casa.",
        "fi": "Isoisäni oli pitkään sairaana ja kuoli kotona.",
        "fr": "Mon grand-père était malade depuis longtemps et il est mort à la maison.",
        "he": "סבא שלי היה חולה הרבה זמן ונפטר בבית.",
        "hi": "मेरे दादाजी लंबे समय से बीमार थे और घर पर ही उनका देहांत हो गया।",
        "hu": "A nagyapám hosszú ideig beteg volt, és otthon hunyt el.",
        "id": "Kakek saya sakit lama dan meninggal di rumah.",
        "it": "Mio nonno è stato malato a lungo ed è morto a casa.",
        "ja": "祖父は長い間病気で、家で亡くなりました。",
        "nb": "Bestefaren min var syk lenge og døde hjemme.",
        "nl": "Mijn opa was al lang ziek en is thuis gestorven.",
        "pl": "Mój dziadek był długo chory i zmarł w domu.",
        "pt": "Meu avô ficou doente por muito tempo e morreu em casa.",
        "ro": "Bunicul meu a fost bolnav mult timp și a murit acasă.",
        "ru": "Мой дедушка долго болел и умер дома.",
        "sv": "Min farfar var sjuk länge och dog hemma.",
        "tr": "Dedem uzun süre hastaydı ve evde öldü.",
        "uk": "Мій дідусь довго хворів і помер удома.",
        "vi": "Ông tôi đã ốm lâu và qua đời ở nhà.",
        "yue": "我爺爺病咗好耐，喺屋企過咗身。",
        "zh-Hans": "我爷爷病了很久，在家去世了。"
      },
