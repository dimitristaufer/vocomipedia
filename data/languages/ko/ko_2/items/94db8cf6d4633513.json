  "sentences": [
    {
      "target": "그는 상대의 심리를 잘 읽어요.",
      "reading": "Geuneun sangdaeui simrireul jal ilgeoyo.",
      "translations": {
        "en": "He is good at reading other people's minds.",
        "ko": "그는 상대의 심리를 잘 읽어요.",
        "ipa": "Geuneun sangdaeui simrireul jal ilgeoyo.",
        "ar": "هو يجيد قراءة ما يفكر فيه الآخرون.",
        "cs": "Dobře umí odhadnout, co si druzí myslí.",
        "da": "Han er god til at aflæse andre menneskers tanker.",
        "de": "Er kann gut lesen, was andere denken.",
        "el": "Μπορεί να διαβάζει καλά τι σκέφτονται οι άλλοι.",
        "es": "Él sabe leer muy bien lo que piensan los demás.",
        "fi": "Hän osaa lukea hyvin, mitä muut ajattelevat.",
        "fr": "Il lit très bien dans les pensées des autres.",
        "he": "הוא קורא היטב את מחשבותיהם של אחרים.",
        "hi": "उसे दूसरों के मन की बात अच्छी तरह समझ आती है।",
        "hu": "Jól le tudja olvasni, mire gondolnak mások.",
        "id": "Dia pandai membaca pikiran orang lain.",
        "it": "Sa leggere bene nella mente degli altri.",
        "ja": "彼は相手の気持ちをうまく読みます。",
        "nb": "Han er flink til å lese hva andre tenker.",
        "nl": "Hij kan goed aanvoelen wat anderen denken.",
        "pl": "On dobrze wyczuwa, co myślą inni.",
        "pt": "Ele sabe ler bem o que os outros pensam.",
        "ro": "El știe să citească bine ce gândesc ceilalți.",
        "ru": "Он хорошо понимает, о чём думают другие.",
        "sv": "Han är bra på att läsa vad andra tänker.",
        "tr": "Başkalarının ne düşündüğünü iyi anlıyor.",
        "uk": "Він добре розуміє, про що думають інші.",
        "vi": "Anh ấy rất giỏi đoán suy nghĩ của người khác.",
        "yue": "佢好識睇人哋諗乜。",
        "zh-Hans": "他很会揣摩别人的想法。"
      },
