    {
      "target": "그는 소리를 듣고 벌떡 돌아섰어요.",
      "reading": "geuneun sorireul deutgo beoltteok doraseosseoyo.",
      "translations": {
        "en": "He turned around abruptly after hearing the sound.",
        "ko": "그는 소리를 듣고 벌떡 돌아섰어요.",
        "ipa": "geuneun sorireul deutgo beoltteok doraseosseoyo.",
        "ar": "استدار بسرعة بعد أن سمع الصوت.",
        "cs": "Po zaslechnutí zvuku se prudce otočil.",
        "da": "Han vendte sig brat om, da han hørte lyden.",
        "de": "Er drehte sich abrupt um, als er das Geräusch hörte.",
        "el": "Γύρισε απότομα όταν άκουσε τον ήχο.",
        "es": "Se dio la vuelta bruscamente al oír el ruido.",
        "fi": "Hän kääntyi äkisti kuultuaan äänen.",
        "fr": "Il s'est retourné brusquement en entendant le bruit.",
        "he": "הוא הסתובב בפתאומיות כששמע את הרעש.",
        "hi": "वह आवाज़ सुनकर अचानक मुड़ा।",
        "hu": "A hangra hirtelen megfordult.",
        "id": "Dia berbalik dengan cepat setelah mendengar suara itu.",
        "it": "Si è voltato di scatto dopo aver sentito il rumore.",
        "ja": "彼は音を聞いてぱっと振り向きました。",
        "nb": "Han snudde seg brått da han hørte lyden.",
        "nl": "Hij draaide zich plotseling om toen hij het geluid hoorde.",
        "pl": "On gwałtownie się odwrócił, gdy usłyszał dźwięk.",
        "pt": "Ele se virou de repente ao ouvir o som.",
        "ro": "S-a întors brusc când a auzit zgomotul.",
        "ru": "Он резко обернулся, услышав звук.",
        "sv": "Han vände sig hastigt om när han hörde ljudet.",
        "tr": "Sesi duyunca birden arkasını döndü.",
        "uk": "Він різко озирнувся, почувши звук.",
        "vi": "Anh ấy quay phắt lại khi nghe thấy tiếng động.",
        "yue": "佢聽到聲音之後，突然轉身。",
        "zh-Hans": "他听到声音后突然转过身来。"
      },
