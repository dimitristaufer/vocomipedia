  "sentences": [
    {
      "target": "아이가 벌떡 일어났어요.",
      "reading": "ai-ga beoltteok ireonasseoyo.",
      "translations": {
        "en": "The child suddenly stood up.",
        "ko": "아이가 벌떡 일어났어요.",
        "ipa": "ai-ga beoltteok ireonasseoyo.",
        "ar": "وقف الطفل فجأة.",
        "cs": "Dítě se najednou postavilo.",
        "da": "Barnet rejste sig pludselig.",
        "de": "Das Kind stand plötzlich auf.",
        "el": "Το παιδί σηκώθηκε ξαφνικά.",
        "es": "El niño se levantó de golpe.",
        "fi": "Lapsi nousi äkkiä ylös.",
        "fr": "L'enfant s'est levé d'un coup.",
        "he": "הילד קם פתאום.",
        "hi": "बच्चा अचानक उठ खड़ा हुआ।",
        "hu": "A gyerek hirtelen felugrott.",
        "id": "Anak itu tiba-tiba berdiri.",
        "it": "Il bambino si è alzato di scatto.",
        "ja": "子どもがぱっと立ち上がりました。",
        "nb": "Barnet spratt plutselig opp.",
        "nl": "Het kind sprong ineens op.",
        "pl": "Dziecko nagle się podniosło.",
        "pt": "A criança se levantou de repente.",
        "ro": "Copilul s-a ridicat brusc.",
        "ru": "Ребёнок вдруг встал.",
        "sv": "Barnet satte sig plötsligt upp.",
        "tr": "Çocuk birden ayağa kalktı.",
        "uk": "Дитина раптом встала.",
        "vi": "Đứa trẻ đột ngột đứng dậy.",
        "yue": "個細路突然站起身。",
        "zh-Hans": "孩子突然站了起来。"
      },
