  "sentences": [
    {
      "target": "목소리가 작아서 잘 안 들려요.",
      "reading": "moksoriga jagaseo jal an deullyeoyo.",
      "translations": {
        "en": "Your voice is so quiet that I can’t hear it well.",
        "ko": "목소리가 작아서 잘 안 들려요.",
        "ipa": "moksoriga jagaseo jal an deullyeoyo.",
        "ar": "صوتك منخفض جدًا، لذلك لا أسمعه جيدًا.",
        "cs": "Máš tak tichý hlas, že tě moc neslyším.",
        "da": "Din stemme er så lav, at jeg ikke kan høre den ordentligt.",
        "de": "Deine Stimme ist so leise, dass ich dich nicht gut hören kann.",
        "el": "Η φωνή σου είναι τόσο χαμηλή που δεν σε ακούω καλά.",
        "es": "Tu voz es tan baja que no te oigo bien.",
        "fi": "Äänesi on niin hiljainen, etten kuule sitä hyvin.",
        "fr": "Ta voix est si basse que je ne t'entends pas bien.",
        "he": "הקול שלך כל כך חלש שאני לא שומע אותו טוב.",
        "hi": "तुम्हारी आवाज़ इतनी धीमी है कि मैं उसे ठीक से सुन नहीं पा रहा हूँ।",
        "hu": "Olyan halk a hangod, hogy nem hallak jól.",
        "id": "Suaramu terlalu pelan, jadi aku tidak bisa mendengarnya dengan baik.",
        "it": "La tua voce è così bassa che non ti sento bene.",
        "ja": "声が小さいので、よく聞こえません。",
        "nb": "Du snakker så lavt at jeg ikke hører deg godt.",
        "nl": "Je stem is zo zacht dat ik je niet goed hoor.",
        "pl": "Mówisz tak cicho, że nie słyszę cię dobrze.",
        "pt": "Sua voz é tão baixa que não consigo ouvir bem.",
        "ro": "Vocea ta e atât de joasă, că nu te aud bine.",
        "ru": "У тебя такой тихий голос, что я тебя плохо слышу.",
        "sv": "Du pratar så lågt att jag inte hör dig ordentligt.",
        "tr": "Sesin o kadar kısık ki seni iyi duyamıyorum.",
        "uk": "У тебе такий тихий голос, що я тебе погано чую.",
        "vi": "Giọng bạn nhỏ quá, tôi không nghe rõ.",
        "yue": "你把聲咁細，我聽唔清。",
        "zh-Hans": "你的声音太小了，我听不太清。"
      },
