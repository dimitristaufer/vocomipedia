  "sentences": [
    {
      "target": "저는 장을 볼 때 비닐봉투를 안 받아요.",
      "reading": "jeoneun jang-eul bol ttae binilbongtureul an badayo.",
      "translations": {
        "en": "I don't take plastic bags when I go shopping.",
        "ko": "저는 장을 볼 때 비닐봉투를 안 받아요.",
        "ipa": "jeoneun jang-eul bol ttae binilbongtureul an badayo.",
        "ar": "لا آخذ أكياسًا بلاستيكية عندما أذهب للتسوق.",
        "cs": "Když jdu nakupovat, neberu si plastové tašky.",
        "da": "Jeg tager ikke plastposer, når jeg handler.",
        "de": "Ich nehme beim Einkaufen keine Plastiktüten.",
        "el": "Δεν παίρνω πλαστικές σακούλες όταν ψωνίζω.",
        "es": "No cojo bolsas de plástico cuando voy de compras.",
        "fi": "En ota muovipusseja, kun käyn ostoksilla.",
        "fr": "Je ne prends pas de sacs en plastique quand je fais les courses.",
        "he": "אני לא לוקח שקיות פלסטיק כשאני הולך לקניות.",
        "hi": "मैं खरीदारी करते समय प्लास्टिक की थैलियाँ नहीं लेता।",
        "hu": "Amikor vásárolok, nem veszek műanyag szatyrot.",
        "id": "Saya tidak mengambil kantong plastik saat belanja.",
        "it": "Quando faccio la spesa, non prendo i sacchetti di plastica.",
        "ja": "買い物をするとき、私はビニール袋をもらいません。",
        "nb": "Jeg tar ikke plastposer når jeg handler.",
        "nl": "Ik neem geen plastic tasjes als ik boodschappen doe.",
        "pl": "Kiedy robię zakupy, nie biorę plastikowych toreb.",
        "pt": "Eu não pego sacolas plásticas quando vou às compras.",
        "ro": "Nu iau pungi de plastic când merg la cumpărături.",
        "ru": "Я не беру пластиковые пакеты, когда иду за покупками.",
        "sv": "Jag tar inga plastpåsar när jag handlar.",
        "tr": "Alışveriş yaparken plastik poşet almam.",
        "uk": "Коли я ходжу по магазинах, я не беру пластикові пакети.",
        "vi": "Tôi không lấy túi ni lông khi đi mua sắm.",
        "yue": "我去買嘢嗰陣唔攞膠袋。",
        "zh-Hans": "我去购物时不拿塑料袋。"
      },
