  "sentences": [
    {
      "target": "오늘은 친구 집에서 하룻밤 묵을 거예요.",
      "reading": "오늘은 친구 지베서 하룯빰 묵을 거예요.",
      "translations": {
        "en": "I'm going to stay at a friend's house for one night.",
        "ko": "오늘은 친구 집에서 하룻밤 묵을 거예요.",
        "ipa": "오늘은 친구 지베서 하룯빰 묵을 거예요.",
        "ar": "سأبيت الليلة في بيت صديقي.",
        "cs": "Dneska přespím u kamaráda.",
        "da": "Jeg skal overnatte hos en ven i nat.",
        "de": "Ich übernachte heute bei einem Freund.",
        "el": "Θα μείνω απόψε ένα βράδυ στο σπίτι ενός φίλου.",
        "es": "Me voy a quedar una noche en casa de un amigo.",
        "fi": "Menen yöksi ystävän luo.",
        "fr": "Je vais passer une nuit chez un ami.",
        "he": "אני אשן הלילה אצל חבר.",
        "hi": "मैं आज रात एक दोस्त के घर रुकूँगा।",
        "hu": "Ma egy éjszakát egy barátomnál alszom.",
        "id": "Saya akan menginap semalam di rumah teman.",
        "it": "Dormirò una notte a casa di un amico.",
        "ja": "今日は友だちの家に一晩泊まります。",
        "nb": "Jeg skal overnatte hos en venn i natt.",
        "nl": "Ik blijf vannacht een nacht bij een vriend.",
        "pl": "Zostanę dziś na noc u przyjaciela.",
        "pt": "Vou passar uma noite na casa de um amigo.",
        "ro": "Voi dormi o noapte la un prieten.",
        "ru": "Я переночую сегодня у друга.",
        "sv": "Jag ska sova över hos en vän i natt.",
        "tr": "Bu gece bir arkadaşımda kalacağım.",
        "uk": "Я переночую сьогодні в друга.",
        "vi": "Tôi sẽ ở lại nhà một người bạn một đêm.",
        "yue": "我今晚會喺朋友屋企瞓一晚。",
        "zh-Hans": "我今晚会在朋友家住一晚。"
      },
