  "sentences": [
    {
      "target": "저는 희곡을 읽고 감동했어요.",
      "reading": "jeoneun huigokeul ilggo gamdonghaesseoyo.",
      "translations": {
        "en": "I read the play and was moved.",
        "ko": "저는 희곡을 읽고 감동했어요.",
        "ipa": "jeoneun huigokeul ilggo gamdonghaesseoyo.",
        "ar": "قرأت المسرحية وتأثرت.",
        "cs": "Přečetl jsem si tu hru a byl jsem dojatý.",
        "da": "Jeg læste stykket og blev rørt.",
        "de": "Ich habe das Stück gelesen und war gerührt.",
        "el": "Διάβασα το θεατρικό έργο και συγκινήθηκα.",
        "es": "Leí la obra y me emocioné.",
        "fi": "Luin näytelmän ja liikutuin.",
        "fr": "J'ai lu la pièce et j'ai été ému.",
        "he": "קראתי את המחזה והתרגשתי.",
        "hi": "मैंने नाटक पढ़ा और मैं बहुत भावुक हो गया।",
        "hu": "Elolvastam a darabot, és meghatódtam.",
        "id": "Saya membaca drama itu dan terharu.",
        "it": "Ho letto la commedia e mi sono commosso.",
        "ja": "私はその劇を読んで感動しました。",
        "nb": "Jeg leste stykket og ble rørt.",
        "nl": "Ik las het toneelstuk en werd geraakt.",
        "pl": "Przeczytałem sztukę i byłem wzruszony.",
        "pt": "Li a peça e fiquei emocionado.",
        "ro": "Am citit piesa și m-am emoționat.",
        "ru": "Я прочитал пьесу и был тронут.",
        "sv": "Jag läste pjäsen och blev rörd.",
        "tr": "Oyunu okudum ve duygulandım.",
        "uk": "Я прочитав п'єсу і був зворушений.",
        "vi": "Tôi đã đọc vở kịch đó và rất xúc động.",
        "yue": "我睇咗呢個劇本，好感動。",
        "zh-Hans": "我读了这部剧本，深受感动。"
      },
