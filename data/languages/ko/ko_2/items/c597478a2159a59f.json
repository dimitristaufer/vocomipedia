  "sentences": [
    {
      "target": "가상은 현실과 조금 달라요.",
      "reading": "gasang-eun hyeonsilgwa jogeum dallayo.",
      "translations": {
        "en": "Imagination is a little different from reality.",
        "ko": "가상은 현실과 조금 달라요.",
        "ipa": "gasang-eun hyeonsilgwa jogeum dallayo.",
        "ar": "الخيال يختلف قليلًا عن الواقع.",
        "cs": "Představivost se trochu liší od reality.",
        "da": "Fantasi er lidt anderledes end virkeligheden.",
        "de": "Vorstellungskraft ist ein bisschen anders als die Realität.",
        "el": "Η φαντασία είναι λίγο διαφορετική από την πραγματικότητα.",
        "es": "La imaginación es un poco diferente de la realidad.",
        "fi": "Mielikuvitus on vähän erilainen kuin todellisuus.",
        "fr": "L'imagination est un peu différente de la réalité.",
        "he": "דמיון שונה קצת מהמציאות.",
        "hi": "कल्पना वास्तविकता से थोड़ी अलग होती है।",
        "hu": "A képzelet egy kicsit más, mint a valóság.",
        "id": "Imajinasi sedikit berbeda dari kenyataan.",
        "it": "L'immaginazione è un po' diversa dalla realtà.",
        "ja": "想像は現実と少し違います。",
        "nb": "Fantasi er litt annerledes enn virkeligheten.",
        "nl": "Verbeelding is een beetje anders dan de werkelijkheid.",
        "pl": "Wyobraźnia trochę różni się od rzeczywistości.",
        "pt": "A imaginação é um pouco diferente da realidade.",
        "ro": "Imaginația este puțin diferită de realitate.",
        "ru": "Воображение немного отличается от реальности.",
        "sv": "Fantasi är lite annorlunda än verkligheten.",
        "tr": "Hayal gücü gerçeklikten biraz farklıdır.",
        "uk": "Уява трохи відрізняється від реальності.",
        "vi": "Trí tưởng tượng khác thực tế một chút.",
        "yue": "想像同現實有少少唔同。",
        "zh-Hans": "想象和现实有一点不同。"
      },
