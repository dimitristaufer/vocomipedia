  "sentences": [
    {
      "target": "초저녁에는 바람이 시원해요.",
      "reading": "초저녀게는 바람이 시원해요.",
      "translations": {
        "en": "The breeze is nice in the early evening.",
        "ko": "초저녁에는 바람이 시원해요.",
        "ipa": "초저녀게는 바람이 시원해요.",
        "ar": "في أوائل المساء يكون النسيم لطيفًا.",
        "cs": "Na začátku večera je vánek příjemný.",
        "da": "I den tidlige aften er brisen dejlig.",
        "de": "Am frühen Abend ist die Brise angenehm.",
        "el": "Στην αρχή του βραδιού έχει δροσερό αεράκι.",
        "es": "Al atardecer, la brisa es agradable.",
        "fi": "Varhaisillassa tuuli on miellyttävä.",
        "fr": "En début de soirée, la brise est agréable.",
        "he": "בשעות המוקדמות של הערב הרוח נעימה.",
        "hi": "शाम के शुरुआती समय में हवा अच्छी लगती है।",
        "hu": "Kora este kellemes a szellő.",
        "id": "Sore hari anginnya sejuk.",
        "it": "Nelle prime ore della sera c'è una piacevole brezza.",
        "ja": "夕方早くは風が気持ちいいです。",
        "nb": "Tidlig på kvelden er det behagelig vind.",
        "nl": "In de vroege avond is het briesje lekker.",
        "pl": "Wczesnym wieczorem wiatr jest przyjemny.",
        "pt": "No início da noite, a brisa é agradável.",
        "ro": "La începutul serii, adierea este plăcută.",
        "ru": "Ранним вечером дует приятный ветерок.",
        "sv": "Tidigt på kvällen är det skönt med en bris.",
        "tr": "Akşamın erken saatlerinde hafif bir esinti oluyor.",
        "uk": "Раннього вечора вітерець приємний.",
        "vi": "Vào đầu buổi tối, gió rất dễ chịu.",
        "yue": "黃昏初時，陣風好舒服。",
        "zh-Hans": "傍晚刚开始的时候，风很凉爽。"
      },
