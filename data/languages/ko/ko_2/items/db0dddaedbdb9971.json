  "sentences": [
    {
      "target": "산에서 약수를 한 컵 마셨어요.",
      "reading": "san-eseo yaksureul han keop masyeosseoyo.",
      "translations": {
        "en": "I drank a cup of mineral water in the mountains.",
        "ko": "산에서 약수를 한 컵 마셨어요.",
        "ipa": "san-eseo yaksureul han keop masyeosseoyo.",
        "ar": "شربت كوبًا من الماء المعدني في الجبال.",
        "cs": "V horách jsem vypil jeden šálek minerální vody.",
        "da": "Jeg drak en kop mineralvand i bjergene.",
        "de": "Ich habe in den Bergen eine Tasse Mineralwasser getrunken.",
        "el": "Ήπια ένα φλιτζάνι μεταλλικό νερό στο βουνό.",
        "es": "Bebí una taza de agua mineral en las montañas.",
        "fi": "Join kupin kivennäisvettä vuorilla.",
        "fr": "J’ai bu une tasse d’eau minérale à la montagne.",
        "he": "שתיתי כוס מים מינרליים בהרים.",
        "hi": "मैंने पहाड़ों में एक कप खनिज जल पिया।",
        "hu": "Ittam egy csésze ásványvizet a hegyekben.",
        "id": "Saya minum segelas air mineral di gunung.",
        "it": "Ho bevuto una tazza di acqua minerale in montagna.",
        "ja": "山で一杯のミネラルウォーターを飲みました。",
        "nb": "Jeg drakk en kopp mineralvann i fjellet.",
        "nl": "Ik heb in de bergen een kop mineraalwater gedronken.",
        "pl": "W górach wypiłem kubek wody mineralnej.",
        "pt": "Bebi uma xícara de água mineral na montanha.",
        "ro": "Am băut o cană de apă minerală la munte.",
        "ru": "Я выпил чашку минеральной воды в горах.",
        "sv": "Jag drack en kopp mineralvatten i bergen.",
        "tr": "Dağlarda bir bardak maden suyu içtim.",
        "uk": "Я випив чашку мінеральної води в горах.",
        "vi": "Tôi đã uống một cốc nước khoáng ở trên núi.",
        "yue": "我喺山度飲咗一杯礦泉水。",
        "zh-Hans": "我在山里喝了一杯矿泉水。"
      },
