    {
      "target": "할아버지는 아침마다 약수를 받아 오세요.",
      "reading": "harabeojineun achimmada yaksureul bada oseyo.",
      "translations": {
        "en": "Grandpa brings back mineral water every morning.",
        "ko": "할아버지는 아침마다 약수를 받아 오세요.",
        "ipa": "harabeojineun achimmada yaksureul bada oseyo.",
        "ar": "يحضر الجد الماء المعدني كل صباح.",
        "cs": "Dědeček nosí každé ráno minerální vodu.",
        "da": "Bedstefar henter mineralvand hver morgen.",
        "de": "Opa holt jeden Morgen Mineralwasser.",
        "el": "Ο παππούς φέρνει μεταλλικό νερό κάθε πρωί.",
        "es": "El abuelo trae agua mineral cada mañana.",
        "fi": "Isoisä hakee kivennäisvettä joka aamu.",
        "fr": "Grand-père rapporte de l’eau minérale tous les matins.",
        "he": "סבא מביא מים מינרליים כל בוקר.",
        "hi": "दादाजी हर सुबह खनिज जल लाते हैं।",
        "hu": "A nagyapa minden reggel ásványvizet hoz.",
        "id": "Kakek mengambil air mineral setiap pagi.",
        "it": "Il nonno porta acqua minerale ogni mattina.",
        "ja": "おじいさんは毎朝ミネラルウォーターを取ってきます。",
        "nb": "Bestefar henter mineralvann hver morgen.",
        "nl": "Opa haalt elke ochtend mineraalwater.",
        "pl": "Dziadek przynosi wodę mineralną każdego ranka.",
        "pt": "O avô traz água mineral toda manhã.",
        "ro": "Bunicul aduce apă minerală în fiecare dimineață.",
        "ru": "Дедушка каждое утро приносит минеральную воду.",
        "sv": "Farfar hämtar mineralvatten varje morgon.",
        "tr": "Dede her sabah maden suyu getiriyor.",
        "uk": "Дідусь щоранку приносить мінеральну воду.",
        "vi": "Ông tôi mang nước khoáng về mỗi sáng.",
        "yue": "爺爺每日朝早都會拎礦泉水返嚟。",
        "zh-Hans": "爷爷每天早上都会打矿泉水回来。"
      },
