    {
      "target": "민수는 다음 달에 제대해요.",
      "reading": "Minsuneun daeum dare jedaehaeyo.",
      "translations": {
        "en": "Minsu is getting discharged next month.",
        "ko": "민수는 다음 달에 제대해요.",
        "ipa": "Minsuneun daeum dare jedaehaeyo.",
        "ar": "سيُسرَّح مينسو الشهر القادم.",
        "cs": "Minsu bude propuštěn z armády příští měsíc.",
        "da": "Minsu bliver dimitteret næste måned.",
        "de": "Minsu wird nächsten Monat entlassen.",
        "el": "Ο Μινσού θα απολυθεί τον επόμενο μήνα.",
        "es": "Minsu será dado de baja el mes que viene.",
        "fi": "Minsu vapautetaan armeijasta ensi kuussa.",
        "fr": "Minsu sera libéré de l'armée le mois prochain.",
        "he": "מינסו ישתחרר בחודש הבא.",
        "hi": "मिनसु अगले महीने सेना से छुट्टी पाएगा।",
        "hu": "Minsu jövő hónapban szerel le.",
        "id": "Minsu akan keluar dari militer bulan depan.",
        "it": "Minsu sarà congedato il mese prossimo.",
        "ja": "ミンスは来月除隊します。",
        "nb": "Minsu blir dimittert neste måned.",
        "nl": "Minsu wordt volgende maand ontslagen uit militaire dienst.",
        "pl": "Minsu zostanie zwolniony z wojska w przyszłym miesiącu.",
        "pt": "Minsu será dispensado do serviço militar no mês que vem.",
        "ro": "Minsu va fi lăsat la vatră luna viitoare.",
        "ru": "Минсу уволится из армии в следующем месяце.",
        "sv": "Minsu muckar nästa månad.",
        "tr": "Minsu gelecek ay terhis oluyor.",
        "uk": "Мінсу буде звільнений з армії наступного місяця.",
        "vi": "Minsu sẽ xuất ngũ vào tháng sau.",
        "yue": "敏洙下個月退伍。",
        "zh-Hans": "敏洙下个月退伍。"
      },
