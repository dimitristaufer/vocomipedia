  "sentences": [
    {
      "target": "오빠가 어제 제대했어요.",
      "reading": "oppaga eoje jedaehaesseoyo.",
      "translations": {
        "en": "My older brother was discharged from the military yesterday.",
        "ko": "오빠가 어제 제대했어요.",
        "ipa": "oppaga eoje jedaehaesseoyo.",
        "ar": "تم تسريح أخي أمس من الجيش.",
        "cs": "Můj starší bratr byl včera propuštěn z armády.",
        "da": "Min storebror blev dimitteret fra militæret i går.",
        "de": "Mein großer Bruder wurde gestern aus dem Militär entlassen.",
        "el": "Ο μεγάλος μου αδερφός απολύθηκε από τον στρατό χθες.",
        "es": "Mi hermano mayor fue dado de baja del ejército ayer.",
        "fi": "Isoveljeni vapautettiin armeijasta eilen.",
        "fr": "Mon grand frère a été libéré de l'armée hier.",
        "he": "אחי הגדול השתחרר אתמול מהצבא.",
        "hi": "मेरे बड़े भाई को कल सेना से छुट्टी मिली।",
        "hu": "A bátyám tegnap leszerelt a hadseregből.",
        "id": "Kakak laki-laki saya keluar dari militer kemarin.",
        "it": "Mio fratello maggiore è stato congedato dall'esercito ieri.",
        "ja": "兄は昨日除隊しました。",
        "nb": "Storebroren min ble dimittert fra militæret i går.",
        "nl": "Mijn oudere broer is gisteren uit militaire dienst ontslagen.",
        "pl": "Mój starszy brat został wczoraj zwolniony z wojska.",
        "pt": "Meu irmão mais velho foi dispensado do serviço militar ontem.",
        "ro": "Fratele meu mai mare a fost lăsat la vatră ieri.",
        "ru": "Моего старшего брата вчера уволили из армии.",
        "sv": "Min storebror muckade från militären igår.",
        "tr": "Abim dün askerlikten terhis oldu.",
        "uk": "Мого старшого брата вчора звільнили з армії.",
        "vi": "Anh trai tôi xuất ngũ hôm qua.",
        "yue": "我哥哥噚日退伍咗。",
        "zh-Hans": "我哥哥昨天退伍了。"
      },
