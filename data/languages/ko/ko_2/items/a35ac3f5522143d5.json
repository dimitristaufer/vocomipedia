  "sentences": [
    {
      "target": "우리 담임 선생님은 친절하세요.",
      "reading": "uri damim seonsaengnim-eun chinjeolhaseyo.",
      "translations": {
        "en": "Our homeroom teacher is kind.",
        "ko": "우리 담임 선생님은 친절하세요.",
        "ipa": "uri damim seonsaengnim-eun chinjeolhaseyo.",
        "ar": "معلم صفنا لطيف.",
        "cs": "Naše třídní učitelka je milá.",
        "da": "Vores klasselærer er venlig.",
        "de": "Unsere Klassenlehrerin ist nett.",
        "el": "Η δασκάλα της τάξης μας είναι πολύ καλή.",
        "es": "Nuestra tutora es amable.",
        "fi": "Luokanopettajamme on ystävällinen.",
        "fr": "Notre professeure principale est gentille.",
        "he": "המורה שלנו בכיתה נחמדה.",
        "hi": "हमारी कक्षा की अध्यापिका बहुत अच्छी हैं।",
        "hu": "Az osztályfőnökünk kedves.",
        "id": "Wali kelas kami ramah.",
        "it": "La nostra maestra è gentile.",
        "ja": "私たちの担任の先生は親切です。",
        "nb": "Kontaktlæreren vår er snill.",
        "nl": "Onze klassenleraar is aardig.",
        "pl": "Nasz wychowawca jest miły.",
        "pt": "A nossa professora é simpática.",
        "ro": "Doamna învățătoare este drăguță.",
        "ru": "Наш классный руководитель добрый.",
        "sv": "Vår klasslärare är snäll.",
        "tr": "Sınıf öğretmenimiz çok nazik.",
        "uk": "Наш класний керівник добрий.",
        "vi": "Cô giáo chủ nhiệm của chúng tôi rất tốt.",
        "yue": "我哋班主任好親切。",
        "zh-Hans": "我们的班主任很亲切。"
      },
