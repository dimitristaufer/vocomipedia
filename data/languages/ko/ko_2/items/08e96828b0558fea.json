  "sentences": [
    {
      "target": "의사가 입을 크게 벌리라고 했어요.",
      "reading": "uisaga ibeul keuge beollirago haesseoyo.",
      "translations": {
        "en": "The doctor said to open your mouth wide.",
        "ko": "의사가 입을 크게 벌리라고 했어요.",
        "ipa": "uisaga ibeul keuge beollirago haesseoyo.",
        "ar": "قال الطبيب أن تفتح فمك على اتساعه.",
        "cs": "Lékař řekl, ať otevřeš ústa dokořán.",
        "da": "Lægen sagde, at du skulle åbne munden helt.",
        "de": "Der Arzt sagte, dass du den Mund weit öffnen sollst.",
        "el": "Ο γιατρός είπε να ανοίξεις πολύ το στόμα σου.",
        "es": "El médico dijo que abrieras la boca bien grande.",
        "fi": "Lääkäri sanoi, että avaa suusi isoksi.",
        "fr": "Le médecin a dit d'ouvrir grand la bouche.",
        "he": "הרופא אמר לפתוח את הפה לרווחה.",
        "hi": "डॉक्टर ने मुंह बहुत खोलने को कहा।",
        "hu": "Az orvos azt mondta, hogy tágra kell nyitnod a szád.",
        "id": "Dokter itu bilang untuk membuka mulut lebar-lebar.",
        "it": "Il dottore ha detto di aprire bene la bocca.",
        "ja": "医者は、口を大きく開けるようにと言いました。",
        "nb": "Legen sa at du skulle åpne munnen godt.",
        "nl": "De dokter zei dat je je mond wijd moest open doen.",
        "pl": "Lekarz powiedział, żebyś szeroko otworzył usta.",
        "pt": "O médico disse para abrir bem a boca.",
        "ro": "Doctorul a spus să deschizi gura larg.",
        "ru": "Врач сказал широко открыть рот.",
        "sv": "Läkaren sa att du skulle öppna munnen stort.",
        "tr": "Doktor ağzını iyice açmanı söyledi.",
        "uk": "Лікар сказав широко відкрити рота.",
        "vi": "Bác sĩ bảo mở miệng thật to.",
        "yue": "醫生叫你張大個口。",
        "zh-Hans": "医生说要把嘴张大。"
      },
