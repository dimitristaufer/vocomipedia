  "sentences": [
    {
      "target": "외부인은 일체 출입 금지예요.",
      "reading": "oebuin-eun ilche churip geumjiyeyo.",
      "translations": {
        "en": "Outsiders are not allowed to enter at all.",
        "ko": "외부인은 일체 출입 금지예요.",
        "ipa": "oebuin-eun ilche churip geumjiyeyo.",
        "ar": "يُمنع دخول الغرباء منعًا باتًا.",
        "cs": "Pro cizí osoby je vstup úplně zakázán.",
        "da": "Uvedkommende må slet ikke komme ind.",
        "de": "Außenstehende dürfen auf keinen Fall eintreten.",
        "el": "Απαγορεύεται αυστηρά η είσοδος σε μη εξουσιοδοτημένα άτομα.",
        "es": "No se permite en absoluto la entrada a personas ajenas.",
        "fi": "Sivullisilta on ehdottomasti kielletty pääsy.",
        "fr": "Les personnes non autorisées n'ont absolument pas le droit d'entrer.",
        "he": "לאנשים זרים אסור להיכנס בכלל.",
        "hi": "बाहरी लोगों का अंदर आना बिल्कुल मना है।",
        "hu": "Kívülállók számára a belépés teljesen tilos.",
        "id": "Orang luar sama sekali tidak boleh masuk.",
        "it": "Alle persone estranee è assolutamente vietato entrare.",
        "ja": "部外者は一切立ち入り禁止です。",
        "nb": "Uvedkommende har ikke adgang i det hele tatt.",
        "nl": "Buitenstaanders mogen helemaal niet naar binnen.",
        "pl": "Osobom postronnym nie wolno wchodzić w ogóle.",
        "pt": "Pessoas de fora não podem entrar de jeito nenhum.",
        "ro": "Persoanele din afară nu au voie să intre deloc.",
        "ru": "Посторонним входить вообще запрещено.",
        "sv": "Obehöriga får absolut inte gå in.",
        "tr": "Yabancıların içeri girmesi kesinlikle yasaktır.",
        "uk": "Стороннім вхід суворо заборонено.",
        "vi": "Người ngoài tuyệt đối không được vào.",
        "yue": "外人一律唔准入內。",
        "zh-Hans": "外人一律不准进入。"
      },
