  "sentences": [
    {
      "target": "아침에 커피를 마시는 버릇이 있어요.",
      "reading": "Achim-e keopireul masineun beoreusi isseoyo.",
      "translations": {
        "en": "I have a habit of drinking coffee in the morning.",
        "ko": "아침에 커피를 마시는 버릇이 있어요.",
        "ipa": "Achim-e keopireul masineun beoreusi isseoyo.",
        "ar": "لدي عادة شرب القهوة في الصباح.",
        "cs": "Mám ve zvyku pít ráno kávu.",
        "da": "Jeg har for vane at drikke kaffe om morgenen.",
        "de": "Ich habe die Gewohnheit, morgens Kaffee zu trinken.",
        "el": "Έχω τη συνήθεια να πίνω καφέ το πρωί.",
        "es": "Tengo el hábito de tomar café por la mañana.",
        "fi": "Minulla on tapana juoda kahvia aamuisin.",
        "fr": "J’ai l’habitude de boire du café le matin.",
        "he": "יש לי הרגל לשתות קפה בבוקר.",
        "hi": "मुझे सुबह कॉफी पीने की आदत है।",
        "hu": "Szokásom reggel kávét inni.",
        "id": "Saya punya kebiasaan minum kopi di pagi hari.",
        "it": "Ho l'abitudine di bere il caffè la mattina.",
        "ja": "私は朝にコーヒーを飲む習慣があります。",
        "nb": "Jeg har for vane å drikke kaffe om morgenen.",
        "nl": "Ik heb de gewoonte om 's ochtends koffie te drinken.",
        "pl": "Mam zwyczaj pić rano kawę.",
        "pt": "Tenho o hábito de beber café de manhã.",
        "ro": "Am obiceiul să beau cafea dimineața.",
        "ru": "У меня есть привычка пить кофе по утрам.",
        "sv": "Jag har för vana att dricka kaffe på morgonen.",
        "tr": "Sabahları kahve içme alışkanlığım var.",
        "uk": "У мене є звичка пити каву вранці.",
        "vi": "Tôi có thói quen uống cà phê vào buổi sáng.",
        "yue": "我有朝早飲咖啡嘅習慣。",
        "zh-Hans": "我有早上喝咖啡的习惯。"
      },
