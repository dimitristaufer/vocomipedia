  "sentences": [
    {
      "target": "그 편지는 정말 감동적이었어요.",
      "reading": "geu pyeonjineun jeongmal gamdongjeogiyeosseoyo.",
      "translations": {
        "en": "That letter was really moving.",
        "ko": "그 편지는 정말 감동적이었어요.",
        "ipa": "geu pyeonjineun jeongmal gamdongjeogiyeosseoyo.",
        "ar": "كانت تلك الرسالة مؤثرة جدًا.",
        "cs": "Ten dopis byl opravdu dojemný.",
        "da": "Det brev var virkelig rørende.",
        "de": "Der Brief war wirklich bewegend.",
        "el": "Εκείνο το γράμμα ήταν πραγματικά συγκινητικό.",
        "es": "Esa carta fue realmente conmovedora.",
        "fi": "Se kirje oli todella koskettava.",
        "fr": "Cette lettre était vraiment touchante.",
        "he": "המכתב הזה היה ממש מרגש.",
        "hi": "वह पत्र सच में बहुत भावुक करने वाला था।",
        "hu": "Az a levél igazán megható volt.",
        "id": "Surat itu benar-benar mengharukan.",
        "it": "Quella lettera era davvero commovente.",
        "ja": "その手紙は本当に感動的でした。",
        "nb": "Det brevet var virkelig rørende.",
        "nl": "Die brief was echt ontroerend.",
        "pl": "Ten list był naprawdę wzruszający.",
        "pt": "Aquela carta foi realmente comovente.",
        "ro": "Scrisoarea aceea a fost cu adevărat emoționantă.",
        "ru": "То письмо было правда очень трогательным.",
        "sv": "Det brevet var verkligen rörande.",
        "tr": "O mektup gerçekten çok duygusaldı.",
        "uk": "Того листа було справді дуже зворушливо читати.",
        "vi": "Bức thư đó thật sự rất cảm động.",
        "yue": "嗰封信真係好感動。",
        "zh-Hans": "那封信真的很感人。"
      },
