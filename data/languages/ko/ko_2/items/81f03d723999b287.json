  "sentences": [
    {
      "target": "비가 그치고 이어 해가 났어요.",
      "reading": "biga geutgo, ieo haega nasseoyo.",
      "translations": {
        "en": "The rain stopped, and then the sun came out.",
        "ko": "비가 그치고 이어 해가 났어요.",
        "ipa": "biga geutgo, ieo haega nasseoyo.",
        "ar": "توقفت الأمطار، ثم خرجت الشمس.",
        "cs": "Déšť ustal a pak vykouklo slunce.",
        "da": "Regnen stoppede, og så kom solen frem.",
        "de": "Der Regen hörte auf, und dann kam die Sonne heraus.",
        "el": "Η βροχή σταμάτησε και μετά βγήκε ο ήλιος.",
        "es": "La lluvia paró y luego salió el sol.",
        "fi": "Sade loppui, ja sitten aurinko tuli esiin.",
        "fr": "La pluie s'est arrêtée, puis le soleil est sorti.",
        "he": "הגשם פסק, ואז השמש יצאה.",
        "hi": "बारिश रुक गई, और फिर धूप निकल आई।",
        "hu": "Elállt az eső, aztán kisütött a nap.",
        "id": "Hujan berhenti, lalu matahari muncul.",
        "it": "La pioggia è cessata e poi è uscito il sole.",
        "ja": "雨がやんで、そして日が差しました。",
        "nb": "Regnet sluttet, og så kom solen frem.",
        "nl": "De regen stopte en toen kwam de zon tevoorschijn.",
        "pl": "Deszcz ustał, a potem wyszło słońce.",
        "pt": "A chuva parou e depois o sol apareceu.",
        "ro": "Ploaia s-a oprit și apoi a ieșit soarele.",
        "ru": "Дождь перестал, и потом вышло солнце.",
        "sv": "Regnet slutade, och sedan kom solen fram.",
        "tr": "Yağmur dindi, sonra güneş çıktı.",
        "uk": "Дощ припинився, а потім вийшло сонце.",
        "vi": "Mưa tạnh, rồi mặt trời ló ra.",
        "yue": "雨停咗，之後出咗太陽。",
        "zh-Hans": "雨停了，接着太阳出来了。"
      },
