  "sentences": [
    {
      "target": "부장님은 아랫사람에게 늘 친절해요.",
      "reading": "Bujang-nimeun araessaram-ege neul chinjeolhaeyo.",
      "translations": {
        "en": "The department head is always kind to subordinates.",
        "ko": "부장님은 아랫사람에게 늘 친절해요.",
        "ipa": "Bujang-nimeun araessaram-ege neul chinjeolhaeyo.",
        "ar": "مدير القسم لطيف دائمًا مع مرؤوسيه.",
        "cs": "Vedoucí oddělení je k podřízeným vždy milý.",
        "da": "Afdelingschefen er altid venlig over for sine underordnede.",
        "de": "Der Abteilungsleiter ist zu seinen Untergebenen immer freundlich.",
        "el": "Ο προϊστάμενος του τμήματος είναι πάντα ευγενικός με τους υφισταμένους.",
        "es": "El jefe de departamento siempre es amable con sus subordinados.",
        "fi": "Osastonjohtaja on aina ystävällinen alaisilleen.",
        "fr": "Le chef de service est toujours gentil avec ses subordonnés.",
        "he": "ראש המחלקה תמיד אדיב אל הכפופים לו.",
        "hi": "विभाग प्रमुख अपने अधीनस्थों के साथ हमेशा दयालु होते हैं।",
        "hu": "Az osztályvezető mindig kedves a beosztottjaival.",
        "id": "Kepala bagian selalu ramah kepada bawahannya.",
        "it": "Il capo reparto è sempre gentile con i suoi subordinati.",
        "ja": "部長は部下にいつも親切です。",
        "nb": "Avdelingslederen er alltid snill mot underordnede.",
        "nl": "De afdelingsleider is altijd vriendelijk tegen zijn ondergeschikten.",
        "pl": "Kierownik działu zawsze jest uprzejmy wobec swoich podwładnych.",
        "pt": "O chefe de departamento é sempre gentil com os subordinados.",
        "ro": "Șeful de departament este mereu amabil cu subordonații.",
        "ru": "Начальник отдела всегда добр к подчинённым.",
        "sv": "Avdelningschefen är alltid snäll mot sina underordnade.",
        "tr": "Bölüm müdürü astlarına karşı hep naziktir.",
        "uk": "Начальник відділу завжди добрий до підлеглих.",
        "vi": "Trưởng phòng lúc nào cũng tử tế với cấp dưới.",
        "yue": "部長對下屬一直都好親切。",
        "zh-Hans": "部门经理总是对下属很亲切。"
      },
