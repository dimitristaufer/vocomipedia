    {
      "target": "간호사가 환자 옷을 벗겼어요.",
      "reading": "ganhosaga hwanja oseul beotgyeosseoyo.",
      "translations": {
        "en": "The nurse took the patient's clothes off.",
        "ko": "간호사가 환자 옷을 벗겼어요.",
        "ipa": "ganhosaga hwanja oseul beotgyeosseoyo.",
        "ar": "نزعت الممرضة ملابس المريض.",
        "cs": "Sestra svlékla pacientovi oblečení.",
        "da": "Sygeplejersken tog patientens tøj af.",
        "de": "Die Krankenschwester zog dem Patienten die Kleidung aus.",
        "el": "Η νοσοκόμα έβγαλε τα ρούχα του ασθενούς.",
        "es": "La enfermera le quitó la ropa al paciente.",
        "fi": "Sairaanhoitaja riisui potilaalta vaatteet.",
        "fr": "L'infirmière a enlevé les vêtements du patient.",
        "he": "האחות הורידה למטופל את הבגדים.",
        "hi": "नर्स ने मरीज के कपड़े उतारे।",
        "hu": "A nővér levette a beteg ruháját.",
        "id": "Perawat menanggalkan pakaian pasien.",
        "it": "L'infermiera ha tolto i vestiti al paziente.",
        "ja": "看護師が患者の服を脱がせました。",
        "nb": "Sykepleieren tok av pasientens klær.",
        "nl": "De verpleegster deed de kleren van de patiënt uit.",
        "pl": "Pielęgniarka zdjęła pacjentowi ubranie.",
        "pt": "A enfermeira tirou a roupa do paciente.",
        "ro": "Asistenta i-a scos hainele pacientului.",
        "ru": "Медсестра сняла с пациента одежду.",
        "sv": "Sjuksköterskan tog av patientens kläder.",
        "tr": "Hemşire hastanın kıyafetlerini çıkardı.",
        "uk": "Медсестра зняла з пацієнта одяг.",
        "vi": "Y tá cởi quần áo cho bệnh nhân.",
        "yue": "護士幫病人除咗衫。",
        "zh-Hans": "护士给病人脱了衣服。"
      },
