  "sentences": [
    {
      "target": "엄마가 아기 옷을 벗겼어요.",
      "reading": "eommaga agi oseul beotgyeosseoyo.",
      "translations": {
        "en": "Mom took the baby's clothes off.",
        "ko": "엄마가 아기 옷을 벗겼어요.",
        "ipa": "eommaga agi oseul beotgyeosseoyo.",
        "ar": "أمٌّ نزعت ملابس الطفل.",
        "cs": "Maminka svlékla miminku oblečení.",
        "da": "Mor tog babyens tøj af.",
        "de": "Die Mutter zog dem Baby die Kleidung aus.",
        "el": "Η μαμά έβγαλε τα ρούχα του μωρού.",
        "es": "Mamá le quitó la ropa al bebé.",
        "fi": "Äiti riisui vauvalta vaatteet.",
        "fr": "Maman a enlevé les vêtements du bébé.",
        "he": "אמא הורידה לתינוק את הבגדים.",
        "hi": "माँ ने बच्चे के कपड़े उतारे।",
        "hu": "Anya levette a baba ruháját.",
        "id": "Ibu menanggalkan pakaian bayi itu.",
        "it": "Mamma ha tolto i vestiti al bambino.",
        "ja": "お母さんが赤ちゃんの服を脱がせました。",
        "nb": "Mamma tok av babyens klær.",
        "nl": "Mama deed de kleren van de baby uit.",
        "pl": "Mama zdjęła dziecku ubranie.",
        "pt": "A mãe tirou a roupa do bebê.",
        "ro": "Mama i-a scos hainele bebelușului.",
        "ru": "Мама сняла с ребёнка одежду.",
        "sv": "Mamma tog av bebisens kläder.",
        "tr": "Anne, bebeğin kıyafetlerini çıkardı.",
        "uk": "Мама зняла з дитини одяг.",
        "vi": "Mẹ cởi quần áo cho em bé.",
        "yue": "媽媽幫嬰兒除咗衫。",
        "zh-Hans": "妈妈给婴儿脱了衣服。"
      },
