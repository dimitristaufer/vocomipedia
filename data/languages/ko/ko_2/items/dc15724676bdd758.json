    {
      "target": "아이에게 먼저 다가가 보세요.",
      "reading": "aiege meonjeo dagaga boseyo.",
      "translations": {
        "en": "Try approaching the child first.",
        "ko": "아이에게 먼저 다가가 보세요.",
        "ipa": "aiege meonjeo dagaga boseyo.",
        "ar": "حاول أن تقترب من الطفل أولًا.",
        "cs": "Zkuste k dítěti nejdřív přijít vy.",
        "da": "Prøv at gå hen til barnet først.",
        "de": "Versuchen Sie, zuerst auf das Kind zuzugehen.",
        "el": "Προσπαθήστε να πλησιάσετε πρώτα το παιδί.",
        "es": "Intenta acercarte primero al niño.",
        "fi": "Yritä ensin mennä lähelle lasta.",
        "fr": "Essayez d'abord d'approcher l'enfant.",
        "he": "נסה להתקרב קודם לילד.",
        "hi": "पहले बच्चे के पास जाने की कोशिश करें।",
        "hu": "Próbáljon először a gyerekhez odamenni.",
        "id": "Cobalah mendekati anak itu lebih dulu.",
        "it": "Prova ad avvicinarti prima al bambino.",
        "ja": "まず子どもに近づいてみてください。",
        "nb": "Prøv å gå bort til barnet først.",
        "nl": "Probeer eerst naar het kind toe te gaan.",
        "pl": "Spróbuj najpierw podejść do dziecka.",
        "pt": "Tente se aproximar da criança primeiro.",
        "ro": "Încearcă să te apropii mai întâi de copil.",
        "ru": "Попробуйте сначала подойти к ребёнку.",
        "sv": "Försök gå fram till barnet först.",
        "tr": "Önce çocuğa yaklaşmayı deneyin.",
        "uk": "Спробуйте спочатку підійти до дитини.",
        "vi": "Hãy thử lại gần đứa trẻ trước.",
        "yue": "你試吓先行近個小朋友。",
        "zh-Hans": "先试着走近孩子。"
      },
