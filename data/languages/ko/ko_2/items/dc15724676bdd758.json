  "sentences": [
    {
      "target": "강아지가 낯선 사람에게 천천히 다가갔어요.",
      "reading": "gangajiga natseon saramege cheoncheonhi dagagasseoyo.",
      "translations": {
        "en": "The dog slowly approached a stranger.",
        "ko": "강아지가 낯선 사람에게 천천히 다가갔어요.",
        "ipa": "gangajiga natseon saramege cheoncheonhi dagagasseoyo.",
        "ar": "اقترب الجرو ببطء من شخص غريب.",
        "cs": "Štěně pomalu přistoupilo k cizímu člověku.",
        "da": "Hvalpen gik langsomt hen til en fremmed.",
        "de": "Der Welpe ging langsam auf einen Fremden zu.",
        "el": "Το κουτάβι πλησίασε αργά έναν άγνωστο.",
        "es": "El cachorro se acercó lentamente a un desconocido.",
        "fi": "Pentuko lähestyi hitaasti vierasta ihmistä.",
        "fr": "Le chiot s'est lentement approché d'un inconnu.",
        "he": "הגור התקרב לאט לאדם זר.",
        "hi": "पिल्ला धीरे-धीरे एक अजनबी के पास गया।",
        "hu": "A kölyökkutya lassan odament egy idegenhez.",
        "id": "Anak anjing itu perlahan mendekati orang asing.",
        "it": "Il cucciolo si è avvicinato lentamente a uno sconosciuto.",
        "ja": "子犬が見知らぬ人にゆっくり近づきました。",
        "nb": "Valpen gikk sakte bort til en fremmed.",
        "nl": "De puppy liep langzaam naar een vreemde toe.",
        "pl": "Szczeniak powoli podszedł do obcej osoby.",
        "pt": "O filhote se aproximou devagar de um estranho.",
        "ro": "Cățelul s-a apropiat încet de un străin.",
        "ru": "Щенок медленно подошёл к незнакомцу.",
        "sv": "Valpen gick långsamt fram till en främling.",
        "tr": "Yavru köpek yabancıya yavaşça yaklaştı.",
        "uk": "Цуценя повільно підійшло до незнайомця.",
        "vi": "Con chó con từ từ lại gần một người lạ.",
        "yue": "小狗慢慢咁行近一個陌生人。",
        "zh-Hans": "小狗慢慢地走近一个陌生人。"
      },
