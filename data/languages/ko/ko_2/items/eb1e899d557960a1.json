  "sentences": [
    {
      "target": "오늘은 오후에 진료가 있어요.",
      "reading": "oneureun ohu-e jillyoga isseoyo.",
      "translations": {
        "en": "I have a medical appointment this afternoon.",
        "ko": "오늘은 오후에 진료가 있어요.",
        "ipa": "oneureun ohu-e jillyoga isseoyo.",
        "ar": "لدي موعد طبي بعد الظهر اليوم.",
        "cs": "Dnes odpoledne mám lékařskou prohlídku.",
        "da": "Jeg har en lægetid i eftermiddag.",
        "de": "Ich habe heute Nachmittag einen Arzttermin.",
        "el": "Έχω ραντεβού για εξέταση σήμερα το απόγευμα.",
        "es": "Tengo cita médica esta tarde.",
        "fi": "Minulla on lääkäriaika tänä iltapäivänä.",
        "fr": "J'ai un rendez-vous médical cet après-midi.",
        "he": "יש לי תור לבדיקה רפואית אחר הצהריים.",
        "hi": "आज दोपहर मेरी मेडिकल अपॉइंटमेंट है।",
        "hu": "Ma délután van egy orvosi vizsgálatom.",
        "id": "Saya ada janji dokter sore ini.",
        "it": "Ho una visita medica questo pomeriggio.",
        "ja": "今日は午後に診察があります。",
        "nb": "Jeg har en legetime i ettermiddag.",
        "nl": "Ik heb vanmiddag een doktersafspraak.",
        "pl": "Mam dziś po południu wizytę lekarską.",
        "pt": "Tenho uma consulta médica esta tarde.",
        "ro": "Am o consultație medicală după-amiază.",
        "ru": "У меня сегодня после обеда приём у врача.",
        "sv": "Jag har en läkartid i eftermiddag.",
        "tr": "Bugün öğleden sonra doktor randevum var.",
        "uk": "Сьогодні після обіду в мене прийом у лікаря.",
        "vi": "Tôi có lịch khám vào chiều nay.",
        "yue": "我今日下晝有醫生睇症。",
        "zh-Hans": "我今天下午有门诊。"
      },
