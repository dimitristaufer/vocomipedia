  "sentences": [
    {
      "target": "잠수함이 바다 아래로 천천히 내려갔어요.",
      "reading": "jamsuhami bada araero cheoncheonhi naeryeogatseoyo.",
      "translations": {
        "en": "The submarine slowly went down below the sea.",
        "ko": "잠수함이 바다 아래로 천천히 내려갔어요.",
        "ipa": "jamsuhami bada araero cheoncheonhi naeryeogatseoyo.",
        "ar": "غاصت الغواصة ببطء تحت البحر.",
        "cs": "Ponorka pomalu klesala pod moře.",
        "da": "Ubåden gik langsomt ned under havet.",
        "de": "Das U-Boot sank langsam unter das Meer.",
        "el": "Το υποβρύχιο κατέβηκε αργά κάτω από τη θάλασσα.",
        "es": "El submarino bajó lentamente bajo el mar.",
        "fi": "Sukellusvene laski hitaasti meren alle.",
        "fr": "Le sous-marin est descendu lentement sous la mer.",
        "he": "הצוללת ירדה לאט מתחת לים.",
        "hi": "पनडुब्बी धीरे-धीरे समुद्र के नीचे गई।",
        "hu": "A tengeralattjáró lassan süllyedt a tenger alá.",
        "id": "Kapal selam itu perlahan turun ke bawah laut.",
        "it": "Il sottomarino è sceso lentamente sotto il mare.",
        "ja": "潜水艦がゆっくり海の下へ潜りました。",
        "nb": "Ubåten sank sakte ned under havet.",
        "nl": "De onderzeeboot ging langzaam onder de zee.",
        "pl": "Okręt podwodny powoli zanurzył się pod morze.",
        "pt": "O submarino desceu lentamente sob o mar.",
        "ro": "Submarinul a coborât încet sub mare.",
        "ru": "Подводная лодка медленно опустилась под воду.",
        "sv": "Ubåten gick långsamt ner under havet.",
        "tr": "Denizaltı yavaşça denizin altına indi.",
        "uk": "Підводний човен повільно опустився під море.",
        "vi": "Tàu ngầm từ từ lặn xuống dưới biển.",
        "yue": "潛艇慢慢沉落喺海底。",
        "zh-Hans": "潜艇慢慢下沉到海面下。"
      },
