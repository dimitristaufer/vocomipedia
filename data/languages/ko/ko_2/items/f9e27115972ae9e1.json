  "sentences": [
    {
      "target": "우리 둘은 공통점이 많아요.",
      "reading": "uri dureun gongtongjeomi manayo.",
      "translations": {
        "en": "The two of us have a lot in common.",
        "ko": "우리 둘은 공통점이 많아요.",
        "ipa": "uri dureun gongtongjeomi manayo.",
        "ar": "لدينا الكثير من القواسم المشتركة.",
        "cs": "Máme toho hodně společného.",
        "da": "Vi har meget til fælles.",
        "de": "Wir haben viel gemeinsam.",
        "el": "Έχουμε πολλά κοινά.",
        "es": "Tenemos muchas cosas en común.",
        "fi": "Meillä on paljon yhteistä.",
        "fr": "Nous avons beaucoup de points communs.",
        "he": "יש לנו הרבה במשותף.",
        "hi": "हममें बहुत कुछ समान है।",
        "hu": "Sok közös van bennünk.",
        "id": "Kami punya banyak kesamaan.",
        "it": "Abbiamo molto in comune.",
        "ja": "私たちは共通点がたくさんあります。",
        "nb": "Vi har mye til felles.",
        "nl": "We hebben veel gemeen.",
        "pl": "Mamy ze sobą wiele wspólnego.",
        "pt": "Temos muito em comum.",
        "ro": "Avem multe în comun.",
        "ru": "У нас много общего.",
        "sv": "Vi har mycket gemensamt.",
        "tr": "İkimizin çok ortak yanı var.",
        "uk": "У нас багато спільного.",
        "vi": "Chúng tôi có rất nhiều điểm chung.",
        "yue": "我哋兩個有好多共通點。",
        "zh-Hans": "我们俩有很多共同点。"
      },
