    {
      "target": "초여름 바람이 시원해요.",
      "reading": "choyeoreum barami siwonhaeyo.",
      "translations": {
        "en": "The early-summer breeze feels cool.",
        "ko": "초여름 바람이 시원해요.",
        "ipa": "choyeoreum barami siwonhaeyo.",
        "ar": "نسيم أوائل الصيف منعش.",
        "cs": "Vánek na začátku léta je příjemně chladný.",
        "da": "Den tidlige sommervind føles kølig.",
        "de": "Die frühe Sommerbrise fühlt sich kühl an.",
        "el": "Το αεράκι στις αρχές του καλοκαιριού είναι δροσερό.",
        "es": "La brisa de principios del verano es fresca.",
        "fi": "Alkukesän tuuli tuntuu viileältä.",
        "fr": "La brise du début de l'été est fraîche.",
        "he": "רוח תחילת הקיץ נעימה וקרירה.",
        "hi": "शुरुआती गर्मियों की हवा ठंडी लगती है।",
        "hu": "A kora nyári szellő hűvösnek érződik.",
        "id": "Angin awal musim panas terasa sejuk.",
        "it": "La brezza di inizio estate è fresca.",
        "ja": "初夏の風が涼しいです。",
        "nb": "Den tidlige sommerbrisen føles sval.",
        "nl": "De vroege zomerbries voelt koel aan.",
        "pl": "Wczesnoletni wiatr jest przyjemnie chłodny.",
        "pt": "A brisa do começo do verão é fresca.",
        "ro": "Briza de la începutul verii este răcoroasă.",
        "ru": "Летний ветерок в начале лета приятно прохладный.",
        "sv": "Den tidiga sommarnvinden känns sval.",
        "tr": "İlk yaz esintisi serin geliyor.",
        "uk": "Початковий літній вітерець приємно прохолодний.",
        "vi": "Gió đầu hè mát mẻ.",
        "yue": "初夏嘅風吹落嚟好涼爽。",
        "zh-Hans": "初夏的风很凉爽。"
      },
