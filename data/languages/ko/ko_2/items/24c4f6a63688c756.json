  "sentences": [
    {
      "target": "오늘은 컨디션이 좋아요.",
      "reading": "oneureun keondisyeoni joayo.",
      "translations": {
        "en": "I feel good today.",
        "ko": "오늘은 컨디션이 좋아요.",
        "ipa": "oneureun keondisyeoni joayo.",
        "ar": "أشعر أنني بخير اليوم.",
        "cs": "Dnes se cítím dobře.",
        "da": "Jeg har det godt i dag.",
        "de": "Mir geht es heute gut.",
        "el": "Νιώθω καλά σήμερα.",
        "es": "Me siento bien hoy.",
        "fi": "Minulla on tänään hyvä olo.",
        "fr": "Je me sens bien aujourd'hui.",
        "he": "אני מרגיש טוב היום.",
        "hi": "आज मैं ठीक महसूस कर रहा हूँ।",
        "hu": "Ma jól érzem magam.",
        "id": "Saya merasa baik hari ini.",
        "it": "Oggi mi sento bene.",
        "ja": "今日は体調がいいです。",
        "nb": "Jeg føler meg bra i dag.",
        "nl": "Ik voel me vandaag goed.",
        "pl": "Czuję się dziś dobrze.",
        "pt": "Hoje estou me sentindo bem.",
        "ro": "Mă simt bine astăzi.",
        "ru": "Сегодня я хорошо себя чувствую.",
        "sv": "Jag mår bra i dag.",
        "tr": "Bugün kendimi iyi hissediyorum.",
        "uk": "Сьогодні я добре почуваюся.",
        "vi": "Hôm nay tôi thấy khỏe.",
        "yue": "我今日狀態幾好。",
        "zh-Hans": "我今天状态很好。"
      },
