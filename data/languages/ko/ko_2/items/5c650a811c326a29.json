    {
      "target": "아침에 안개가 짙게 끼었어요.",
      "reading": "achime an-gaega jitege kkieosseoyo.",
      "translations": {
        "en": "There was thick fog in the morning.",
        "ko": "아침에 안개가 짙게 끼었어요.",
        "ipa": "achime an-gaega jitege kkieosseoyo.",
        "ar": "كان هناك ضباب كثيف في الصباح.",
        "cs": "Ráno byla hustá mlha.",
        "da": "Der var tæt tåge om morgenen.",
        "de": "Am Morgen gab es dichten Nebel.",
        "el": "Το πρωί είχε πυκνή ομίχλη.",
        "es": "Por la mañana había niebla densa.",
        "fi": "Aamulla oli sakea sumu.",
        "fr": "Il y avait un épais brouillard ce matin.",
        "he": "בבוקר היה ערפל כבד.",
        "hi": "सुबह घना कोहरा था।",
        "hu": "Reggel sűrű köd volt.",
        "id": "Pagi itu ada kabut tebal.",
        "it": "Al mattino c'era una fitta nebbia.",
        "ja": "朝は濃い霧が出ていました。",
        "nb": "Det var tett tåke om morgenen.",
        "nl": "Er was 's ochtends dichte mist.",
        "pl": "Rano była gęsta mgła.",
        "pt": "Havia nevoeiro denso de manhã.",
        "ro": "Dimineața a fost ceață deasă.",
        "ru": "Утром был густой туман.",
        "sv": "Det var tät dimma på morgonen.",
        "tr": "Sabah yoğun sis vardı.",
        "uk": "Уранці був густий туман.",
        "vi": "Sáng sớm có sương mù dày đặc.",
        "yue": "朝早有好濃嘅霧。",
        "zh-Hans": "早上有很浓的雾。"
      },
