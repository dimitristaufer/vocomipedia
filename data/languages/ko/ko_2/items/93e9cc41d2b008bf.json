  "sentences": [
    {
      "target": "사진만 보고 판단하다가 실수했어요.",
      "reading": "sajinman bogo pandanhadaga silsuhaesseoyo.",
      "translations": {
        "en": "I made a mistake by judging just from the photo.",
        "ko": "사진만 보고 판단하다가 실수했어요.",
        "ipa": "sajinman bogo pandanhadaga silsuhaesseoyo.",
        "ar": "ارتكبتُ خطأً لأنني حكمتُ من الصورة فقط.",
        "cs": "Udělal jsem chybu, protože jsem soudil jen podle fotky.",
        "da": "Jeg tog fejl, fordi jeg dømte ud fra billedet alene.",
        "de": "Ich habe einen Fehler gemacht, weil ich nur nach dem Foto beurteilt habe.",
        "el": "Έκανα λάθος επειδή έκρινα μόνο από τη φωτογραφία.",
        "es": "Me equivoqué porque juzgué solo por la foto.",
        "fi": "Tein virheen, koska arvioin vain kuvan perusteella.",
        "fr": "J’ai fait une erreur en jugeant seulement d’après la photo.",
        "he": "עשיתי טעות כי שפטתי רק לפי התמונה.",
        "hi": "मैंने सिर्फ तस्वीर देखकर फैसला किया और गलती कर दी।",
        "hu": "Hibáztam, mert csak a kép alapján ítéltem.",
        "id": "Saya salah karena menilai hanya dari foto.",
        "it": "Ho sbagliato perché ho giudicato solo dalla foto.",
        "ja": "写真だけで判断してしまって、失敗しました。",
        "nb": "Jeg gjorde en feil fordi jeg vurderte bare ut fra bildet.",
        "nl": "Ik maakte een fout omdat ik alleen op de foto afging.",
        "pl": "Popełniłem błąd, bo oceniłem tylko na podstawie zdjęcia.",
        "pt": "Cometi um erro porque julguei só pela foto.",
        "ro": "Am greșit pentru că am judecat doar după fotografie.",
        "ru": "Я ошибся, потому что судил только по фото.",
        "sv": "Jag gjorde ett misstag eftersom jag dömde bara utifrån bilden.",
        "tr": "Sadece fotoğrafa bakarak yargıladığım için hata yaptım.",
        "uk": "Я помилився, бо судив лише за фото.",
        "vi": "Tôi đã sai vì chỉ đánh giá qua bức ảnh.",
        "yue": "我淨係睇相就判斷，結果出咗錯。",
        "zh-Hans": "我只看照片就判断，结果出错了。"
      },
