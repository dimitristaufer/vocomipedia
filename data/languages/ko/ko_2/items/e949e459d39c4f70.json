  "sentences": [
    {
      "target": "제 동생은 성격이 밝아요.",
      "reading": "Je dongsaengeun seonggyeogi balgayo.",
      "translations": {
        "en": "My younger sibling has a cheerful personality.",
        "ko": "제 동생은 성격이 밝아요.",
        "ipa": "Je dongsaengeun seonggyeogi balgayo.",
        "ar": "أخي الأصغر شخص مرح.",
        "cs": "Můj mladší sourozenec má veselou povahu.",
        "da": "Min lillebror har et glad sind.",
        "de": "Mein kleiner Bruder ist fröhlich.",
        "el": "Το μικρό μου αδερφάκι είναι χαρούμενο.",
        "es": "Mi hermano menor tiene un carácter alegre.",
        "fi": "Pikkusisarukseni on iloinen.",
        "fr": "Mon petit frère a un caractère joyeux.",
        "he": "לאח הקטן שלי יש אופי עליז.",
        "hi": "मेरे छोटे भाई का स्वभाव खुशमिज़ाज है।",
        "hu": "A kisebbik testvérem vidám természetű.",
        "id": "Adik saya periang.",
        "it": "Mio fratellino ha un carattere allegro.",
        "ja": "弟は明るい性格です。",
        "nb": "Lillebroren min er blid.",
        "nl": "Mijn jongere broer is vrolijk.",
        "pl": "Mój młodszy brat jest pogodny.",
        "pt": "Meu irmão mais novo é alegre.",
        "ro": "Fratele meu mai mic are o fire veselă.",
        "ru": "Мой младший брат веселый.",
        "sv": "Min yngre bror är glad av sig.",
        "tr": "Küçük kardeşim neşeli biri.",
        "uk": "Мій молодший брат веселий.",
        "vi": "Em tôi có tính vui vẻ.",
        "yue": "我細佬性格好開朗。",
        "zh-Hans": "我弟弟性格开朗。"
      },
