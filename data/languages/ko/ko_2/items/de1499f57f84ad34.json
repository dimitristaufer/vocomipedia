  "sentences": [
    {
      "target": "할아버지는 일생 동안 바다에서 일하셨어요.",
      "reading": "harabeojineun ilsaeng dongan badaeseo ilhaseosseoyo.",
      "translations": {
        "en": "My grandfather worked at sea all his life.",
        "ko": "할아버지는 일생 동안 바다에서 일하셨어요.",
        "ipa": "harabeojineun ilsaeng dongan badaeseo ilhaseosseoyo.",
        "ar": "عمل جدي في البحر طوال حياته.",
        "cs": "Dědeček pracoval celý život na moři.",
        "da": "Min bedstefar arbejdede på havet hele sit liv.",
        "de": "Mein Großvater arbeitete sein ganzes Leben lang auf See.",
        "el": "Ο παππούς μου δούλεψε στη θάλασσα όλη του τη ζωή.",
        "es": "Mi abuelo trabajó en el mar toda su vida.",
        "fi": "Isoisäni työskenteli koko elämänsä merellä.",
        "fr": "Mon grand-père a travaillé en mer toute sa vie.",
        "he": "סבא שלי עבד בים כל חייו.",
        "hi": "मेरे दादाजी ने सारी उम्र समुद्र में काम किया।",
        "hu": "A nagyapám egész életében a tengeren dolgozott.",
        "id": "Kakek saya bekerja di laut sepanjang hidupnya.",
        "it": "Mio nonno ha lavorato in mare per tutta la vita.",
        "ja": "祖父は一生を海で働いて過ごしました。",
        "nb": "Bestefaren min jobbet på havet hele livet.",
        "nl": "Mijn grootvader werkte zijn hele leven op zee.",
        "pl": "Mój dziadek pracował na morzu przez całe życie.",
        "pt": "Meu avô trabalhou no mar a vida toda.",
        "ro": "Bunicul meu a lucrat pe mare toată viața.",
        "ru": "Мой дедушка всю жизнь работал в море.",
        "sv": "Min farfar arbetade till havs hela sitt liv.",
        "tr": "Dedem bütün hayatı boyunca denizde çalıştı.",
        "uk": "Мій дідусь усе життя працював у морі.",
        "vi": "Ông tôi đã làm việc trên biển cả đời.",
        "yue": "我爺爺成世都喺海上做嘢。",
        "zh-Hans": "我爷爷一辈子都在海上工作。"
      },
