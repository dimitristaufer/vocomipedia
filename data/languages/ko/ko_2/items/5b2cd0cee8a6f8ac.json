  "sentences": [
    {
      "target": "오늘 미용실에 가서 머리를 잘랐어요.",
      "reading": "oneul miyongsire gaseo meorireul jallasseoyo.",
      "translations": {
        "en": "I went to the hair salon and got a haircut today.",
        "ko": "오늘 미용실에 가서 머리를 잘랐어요.",
        "ipa": "oneul miyongsire gaseo meorireul jallasseoyo.",
        "ar": "ذهبت إلى صالون التجميل اليوم وقصصت شعري.",
        "cs": "Dnes jsem šel do salonu a nechal si ostříhat vlasy.",
        "da": "Jeg tog til frisøren i dag og blev klippet.",
        "de": "Ich bin heute zum Friseursalon gegangen und habe mir die Haare schneiden lassen.",
        "el": "Πήγα σήμερα στο κομμωτήριο και κουρεύτηκα.",
        "es": "Hoy fui a la peluquería y me corté el pelo.",
        "fi": "Kävin tänään parturissa ja leikkautin hiukseni.",
        "fr": "Je suis allé chez le coiffeur aujourd'hui et je me suis fait couper les cheveux.",
        "he": "הלכתי היום למספרה והסתפרתי.",
        "hi": "मैं आज सैलून गया और मैंने अपने बाल कटवाए।",
        "hu": "Ma elmentem a fodrászhoz, és levágattam a hajamat.",
        "id": "Hari ini saya pergi ke salon dan memotong rambut.",
        "it": "Oggi sono andato dal parrucchiere e mi sono tagliato i capelli.",
        "ja": "今日は美容院に行って髪を切りました。",
        "nb": "Jeg dro til frisørsalongen i dag og klippet meg.",
        "nl": "Ik ben vandaag naar de kapper gegaan en heb mijn haar laten knippen.",
        "pl": "Poszedłem dziś do salonu i obciąłem włosy.",
        "pt": "Hoje fui ao salão de beleza e cortei o cabelo.",
        "ro": "Astăzi am fost la salon și m-am tuns.",
        "ru": "Сегодня я сходил в салон и постригся.",
        "sv": "Jag gick till frisersalongen i dag och klippte mig.",
        "tr": "Bugün kuaföre gittim ve saçımı kestirdim.",
        "uk": "Сьогодні я пішов у салон і постригся.",
        "vi": "Hôm nay tôi đã đi đến tiệm làm tóc và cắt tóc.",
        "yue": "我今日去咗美容院剪頭髮。",
        "zh-Hans": "我今天去美容院剪了头发。"
      },
