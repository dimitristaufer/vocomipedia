  "sentences": [
    {
      "target": "저는 선생님께 숙제를 건네줬어요.",
      "reading": "jeoneun seonsaengnimkke sukjereul geonnejwosseoyo.",
      "translations": {
        "en": "I handed the homework to the teacher.",
        "ko": "저는 선생님께 숙제를 건네줬어요.",
        "ipa": "jeoneun seonsaengnimkke sukjereul geonnejwosseoyo.",
        "ar": "أعطيتُ الواجب للمعلم.",
        "cs": "Podal jsem úkol učiteli.",
        "da": "Jeg gav lektien til læreren.",
        "de": "Ich habe dem Lehrer die Hausaufgaben gegeben.",
        "el": "Έδωσα την εργασία στον δάσκαλο.",
        "es": "Le entregué la tarea al profesor.",
        "fi": "Annan tehtävän opettajalle.",
        "fr": "J'ai remis le devoir au professeur.",
        "he": "מסרתי את שיעורי הבית למורה.",
        "hi": "मैंने शिक्षक को होमवर्क दिया।",
        "hu": "Átadtam a házi feladatot a tanárnak.",
        "id": "Saya menyerahkan PR kepada guru.",
        "it": "Ho consegnato i compiti all'insegnante.",
        "ja": "先生に宿題を渡しました。",
        "nb": "Jeg ga leksene til læreren.",
        "nl": "Ik heb het huiswerk aan de leraar gegeven.",
        "pl": "Podałem nauczycielowi pracę domową.",
        "pt": "Entreguei o dever de casa ao professor.",
        "ro": "I-am dat profesorului tema.",
        "ru": "Я передал домашнее задание учителю.",
        "sv": "Jag gav läxan till läraren.",
        "tr": "Ödevi öğretmene verdim.",
        "uk": "Я передав домашнє завдання вчителю.",
        "vi": "Tôi đã đưa bài tập cho thầy giáo.",
        "yue": "我將功課交咗俾老師。",
        "zh-Hans": "我把作业交给了老师。"
      },
