  "sentences": [
    {
      "target": "저는 오늘 운동하겠다는 결심을 했어요.",
      "reading": "jeoneun oneul undonghagessdaneun gyeolsimeul haesseoyo",
      "translations": {
        "en": "I made a resolution to exercise today.",
        "ko": "저는 오늘 운동하겠다는 결심을 했어요.",
        "ipa": "jeoneun oneul undonghagessdaneun gyeolsimeul haesseoyo",
        "ar": "اتخذت قرارًا بأن أمارس الرياضة اليوم.",
        "cs": "Rozhodl jsem se, že dnes budu cvičit.",
        "da": "Jeg besluttede at træne i dag.",
        "de": "Ich habe den Entschluss gefasst, heute Sport zu treiben.",
        "el": "Πήρα την απόφαση να γυμναστώ σήμερα.",
        "es": "Tomé la decisión de hacer ejercicio hoy.",
        "fi": "Päätin, että liikun tänään.",
        "fr": "J’ai pris la décision de faire du sport aujourd’hui.",
        "he": "החלטתי לעשות ספורט היום.",
        "hi": "मैंने आज व्यायाम करने का फैसला किया।",
        "hu": "Elhatároztam, hogy ma sportolok.",
        "id": "Saya memutuskan untuk berolahraga hari ini.",
        "it": "Ho deciso di fare esercizio oggi.",
        "ja": "私は今日運動することに決めました。",
        "nb": "Jeg bestemte meg for å trene i dag.",
        "nl": "Ik heb besloten om vandaag te gaan sporten.",
        "pl": "Postanowiłem, że dziś będę ćwiczyć.",
        "pt": "Tomei a decisão de fazer exercício hoje.",
        "ro": "Am hotărât să fac mișcare azi.",
        "ru": "Я решил сегодня заняться спортом.",
        "sv": "Jag bestämde mig för att träna i dag.",
        "tr": "Bugün spor yapmaya karar verdim.",
        "uk": "Я вирішив сьогодні зайнятися спортом.",
        "vi": "Tôi đã quyết định sẽ tập thể dục hôm nay.",
        "yue": "我決定咗今日做運動。",
        "zh-Hans": "我决定今天运动。"
