  "sentences": [
    {
      "target": "이 감기의 원인을 아직 몰라요.",
      "reading": "i gamgiui wonineul ajik mollayo.",
      "translations": {
        "en": "I still don’t know the cause of this cold.",
        "ko": "이 감기의 원인을 아직 몰라요.",
        "ipa": "i gamgiui wonineul ajik mollayo.",
        "ar": "ما زلت لا أعرف سبب هذا الزكام.",
        "cs": "Stále nevím příčinu téhle rýmy.",
        "da": "Jeg ved stadig ikke, hvad årsagen til den her forkølelse er.",
        "de": "Ich kenne die Ursache für diese Erkältung noch nicht.",
        "el": "Δεν ξέρω ακόμα την αιτία αυτού του κρυολογήματος.",
        "es": "Todavía no sé la causa de este resfriado.",
        "fi": "En vielä tiedä tämän flunssan syytä.",
        "fr": "Je ne connais pas encore la cause de ce rhume.",
        "he": "אני עדיין לא יודע מה הסיבה להצטננות הזו.",
        "hi": "मुझे अभी तक इस जुकाम का कारण नहीं पता।",
        "hu": "Még nem tudom, mi az oka ennek a megfázásnak.",
        "id": "Saya masih belum tahu penyebab pilek ini.",
        "it": "Non so ancora qual è la causa di questo raffreddore.",
        "ja": "この風邪の原因はまだわかりません。",
        "nb": "Jeg vet fortsatt ikke årsaken til denne forkjølelsen.",
        "nl": "Ik weet nog niet wat de oorzaak van deze verkoudheid is.",
        "pl": "Nadal nie znam przyczyny tego przeziębienia.",
        "pt": "Ainda não sei a causa deste resfriado.",
        "ro": "Încă nu știu cauza acestei răceli.",
        "ru": "Я всё ещё не знаю причину этой простуды.",
        "sv": "Jag vet fortfarande inte orsaken till den här förkylningen.",
        "tr": "Bu nezlenin nedenini hâlâ bilmiyorum.",
        "uk": "Я досі не знаю причини цієї застуди.",
        "vi": "Tôi vẫn chưa biết nguyên nhân của cơn cảm này.",
        "yue": "我仲未知道呢次感冒嘅原因。",
        "zh-Hans": "我还不知道这次感冒的原因。"
      },
