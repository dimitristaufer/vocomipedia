    {
      "target": "꿈속에서 엄마를 만났어요.",
      "reading": "kkumsokeseo eommareul mannasseoyo.",
      "translations": {
        "en": "I met my mom in a dream.",
        "ko": "꿈속에서 엄마를 만났어요.",
        "ipa": "kkumsokeseo eommareul mannasseoyo.",
        "ar": "التقيت بأمي في حلم.",
        "cs": "Ve snu jsem potkal svou mámu.",
        "da": "Jeg mødte min mor i en drøm.",
        "de": "Ich habe meine Mutter im Traum getroffen.",
        "el": "Στο όνειρό μου συνάντησα τη μαμά μου.",
        "es": "Conocí a mi mamá en un sueño.",
        "fi": "Tapasin äitini unessa.",
        "fr": "J'ai rencontré ma mère dans un rêve.",
        "he": "פגשתי את אמא שלי בחלום.",
        "hi": "मैंने सपने में अपनी माँ से मुलाकात की।",
        "hu": "Álmomban találkoztam anyával.",
        "id": "Saya bertemu ibu saya dalam mimpi.",
        "it": "Ho incontrato mia madre in sogno.",
        "ja": "夢の中でお母さんに会いました。",
        "nb": "Jeg møtte mamma i en drøm.",
        "nl": "Ik heb mijn moeder in een droom ontmoet.",
        "pl": "Spotkałem mamę we śnie.",
        "pt": "Conheci minha mãe em um sonho.",
        "ro": "Mi-am întâlnit mama în vis.",
        "ru": "Во сне я встретил маму.",
        "sv": "Jag träffade min mamma i en dröm.",
        "tr": "Rüyamda annemi gördüm.",
        "uk": "Уві сні я зустрів маму.",
        "vi": "Tôi đã gặp mẹ trong mơ.",
        "yue": "喺夢入面我見到媽媽。",
        "zh-Hans": "我在梦里见到了妈妈。"
      },
