  "sentences": [
    {
      "target": "처음엔 부끄러움이 컸어요.",
      "reading": "cheoeumen bukkeureoumi keosseoyo.",
      "translations": {
        "en": "At first, I was very embarrassed.",
        "ko": "처음엔 부끄러움이 컸어요.",
        "ipa": "cheoeumen bukkeureoumi keosseoyo.",
        "ar": "في البداية، كنت أشعر بالخجل الشديد.",
        "cs": "Zpočátku mi bylo hodně trapně.",
        "da": "Til at begynde med var jeg meget genert.",
        "de": "Am Anfang war ich sehr verlegen.",
        "el": "Στην αρχή ντρεπόμουν πολύ.",
        "es": "Al principio, estaba muy avergonzado.",
        "fi": "Aluksi olin todella ujo.",
        "fr": "Au début, j’étais très gêné.",
        "he": "בהתחלה הייתי נבוך מאוד.",
        "hi": "शुरू में मुझे बहुत शर्म आई।",
        "hu": "Eleinte nagyon zavarban voltam.",
        "id": "Awalnya, aku sangat malu.",
        "it": "All'inizio ero molto in imbarazzo.",
        "ja": "最初はとても恥ずかしかったです。",
        "nb": "I begynnelsen var jeg veldig flau.",
        "nl": "In het begin was ik erg verlegen.",
        "pl": "Na początku byłem bardzo zawstydzony.",
        "pt": "No começo, eu fiquei com muita vergonha.",
        "ro": "La început, eram foarte jenat.",
        "ru": "Сначала мне было очень стыдно.",
        "sv": "Först var jag väldigt blyg.",
        "tr": "Başta çok utandım.",
        "uk": "Спочатку мені було дуже соромно.",
        "vi": "Lúc đầu, tôi rất ngại.",
        "yue": "起初，我好尷尬。",
        "zh-Hans": "一开始，我很害羞。"
      },
