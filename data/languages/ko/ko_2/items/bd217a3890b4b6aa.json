  "sentences": [
    {
      "target": "저는 샌드위치에 겨자를 조금 넣어요.",
      "reading": "jeoneun saendeuwichi-e gyeojareul jogeum neureoyo.",
      "translations": {
        "en": "I put a little mustard on my sandwich.",
        "ko": "저는 샌드위치에 겨자를 조금 넣어요.",
        "ipa": "jeoneun saendeuwichi-e gyeojareul jogeum neureoyo.",
        "ar": "أضع قليلًا من الخردل على شطيرتي.",
        "cs": "Dávám si na sendvič trochu hořčice.",
        "da": "Jeg kommer lidt sennep på min sandwich.",
        "de": "Ich mache etwas Senf auf mein Sandwich.",
        "el": "Βάζω λίγο μουστάρδα στο σάντουιτς μου.",
        "es": "Pongo un poco de mostaza en mi sándwich.",
        "fi": "Laitan sandwichiini vähän sinappia.",
        "fr": "Je mets un peu de moutarde dans mon sandwich.",
        "he": "אני שם קצת חרדל על הסנדוויץ' שלי.",
        "hi": "मैं अपने सैंडविच में थोड़ा सा सरसों डालता हूँ।",
        "hu": "Teszek egy kis mustárt a szendvicsemre.",
        "id": "Saya menaruh sedikit mustard di sandwich saya.",
        "it": "Metto un po' di senape nel mio panino.",
        "ja": "私はサンドイッチにマスタードを少し入れます。",
        "nb": "Jeg har litt sennep på sandwichen min.",
        "nl": "Ik doe een beetje mosterd op mijn sandwich.",
        "pl": "Daję trochę musztardy na moją kanapkę.",
        "pt": "Eu coloco um pouco de mostarda no meu sanduíche.",
        "ro": "Pun puțin muștar în sandvișul meu.",
        "ru": "Я кладу немного горчицы в свой сэндвич.",
        "sv": "Jag har lite senap på min smörgås.",
        "tr": "Sandviçime biraz hardal koyuyorum.",
        "uk": "Я кладу трохи гірчиці в свій сендвіч.",
        "vi": "Tôi cho một ít mù tạt vào bánh sandwich của mình.",
        "yue": "我喺三文治上面加咗少少芥末。",
        "zh-Hans": "我在三明治里放一点芥末。"
      },
