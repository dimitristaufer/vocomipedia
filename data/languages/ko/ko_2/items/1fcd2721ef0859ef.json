  "sentences": [
    {
      "target": "이 놀이공원은 성인만 입장할 수 있어요.",
      "reading": "i norigong-woneun seonginman ipjanghal su isseoyo",
      "translations": {
        "en": "Only adults can enter this amusement park.",
        "ko": "이 놀이공원은 성인만 입장할 수 있어요.",
        "ipa": "i norigong-woneun seonginman ipjanghal su isseoyo",
        "ar": "هذه مدينة ألعاب لا يُسمح بدخولها إلا للبالغين.",
        "cs": "Do tohoto lunaparku mohou jen dospělí.",
        "da": "Kun voksne kan komme ind i forlystelsesparken.",
        "de": "In diesen Freizeitpark dürfen nur Erwachsene.",
        "el": "Μόνο οι ενήλικες μπορούν να μπουν σε αυτό το λούνα παρκ.",
        "es": "Solo pueden entrar adultos en este parque de atracciones.",
        "fi": "Tähän huvipuistoon pääsevät vain aikuiset.",
        "fr": "Seuls les adultes peuvent entrer dans ce parc d'attractions.",
        "he": "רק מבוגרים יכולים להיכנס לפארק השעשועים הזה.",
        "hi": "इस मनोरंजन पार्क में सिर्फ़ वयस्क ही प्रवेश कर सकते हैं।",
        "hu": "Ebben a vidámparkban csak felnőttek léphetnek be.",
        "id": "Taman bermain ini hanya boleh dimasuki orang dewasa.",
        "it": "In questo parco divertimenti possono entrare solo gli adulti.",
        "ja": "この遊園地には大人しか入れません。",
        "nb": "Bare voksne kan gå inn i denne fornøyelsesparken.",
        "nl": "Alleen volwassenen mogen dit pretpark in.",
        "pl": "Do tego parku rozrywki mogą wejść tylko dorośli.",
        "pt": "Só adultos podem entrar neste parque de diversões.",
        "ro": "În acest parc de distracții pot intra doar adulții.",
        "ru": "В этот парк аттракционов могут входить только взрослые.",
        "sv": "Det här nöjesfältet får bara vuxna gå in på.",
        "tr": "Bu lunaparka sadece yetişkinler girebilir.",
        "uk": "У цей парк розваг можуть заходити лише дорослі.",
        "vi": "Chỉ người lớn mới được vào công viên giải trí này.",
        "yue": "呢個遊樂場只限成人入場。",
        "zh-Hans": "这个游乐园只允许成人进入。"
      },
