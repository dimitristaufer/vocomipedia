    {
      "target": "한밤중에 전화가 울렸어요.",
      "reading": "hanbamjunge jeonhwaga ullyeosseoyo.",
      "translations": {
        "en": "The phone rang in the middle of the night.",
        "ko": "한밤중에 전화가 울렸어요.",
        "ipa": "hanbamjunge jeonhwaga ullyeosseoyo.",
        "ar": "رنّ الهاتف في منتصف الليل.",
        "cs": "Telefon zazvonil uprostřed noci.",
        "da": "Telefonen ringede midt om natten.",
        "de": "Das Telefon klingelte mitten in der Nacht.",
        "el": "Το τηλέφωνο χτύπησε μέσα στη νύχτα.",
        "es": "El teléfono sonó en plena noche.",
        "fi": "Puhelin soi keskellä yötä.",
        "fr": "Le téléphone a sonné au milieu de la nuit.",
        "he": "הטלפון צלצל באמצע הלילה.",
        "hi": "रात के बीच फोन बजा।",
        "hu": "Éjfélkor megszólalt a telefon.",
        "id": "Telepon berdering di tengah malam.",
        "it": "Il telefono ha squillato nel cuore della notte.",
        "ja": "真夜中に電話が鳴りました。",
        "nb": "Telefonen ringte midt på natten.",
        "nl": "De telefoon ging midden in de nacht over.",
        "pl": "Telefon zadzwonił w środku nocy.",
        "pt": "O telefone tocou no meio da noite.",
        "ro": "Telefonul a sunat în toiul nopții.",
        "ru": "Телефон зазвонил среди ночи.",
        "sv": "Telefonen ringde mitt i natten.",
        "tr": "Telefon gecenin bir yarısı çaldı.",
        "uk": "Телефон задзвонив серед ночі.",
        "vi": "Điện thoại reo vào nửa đêm.",
        "yue": "半夜電話響咗。",
        "zh-Hans": "半夜电话响了。"
      },
