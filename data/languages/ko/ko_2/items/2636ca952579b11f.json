    {
      "target": "아기가 한밤중에 깨서 울었어요.",
      "reading": "agiga hanbamjunge kkaeseo ureosseoyo.",
      "translations": {
        "en": "The baby woke up and cried in the middle of the night.",
        "ko": "아기가 한밤중에 깨서 울었어요.",
        "ipa": "agiga hanbamjunge kkaeseo ureosseoyo.",
        "ar": "استيقظ الطفل وبكى في منتصف الليل.",
        "cs": "Dítě se uprostřed noci probudilo a začalo plakat.",
        "da": "Barnet vågnede midt om natten og græd.",
        "de": "Das Baby wachte mitten in der Nacht auf und weinte.",
        "el": "Το μωρό ξύπνησε και έκλαψε μέσα στη νύχτα.",
        "es": "El bebé se despertó y lloró en plena noche.",
        "fi": "Vauva heräsi keskellä yötä ja itki.",
        "fr": "Le bébé s'est réveillé et a pleuré au milieu de la nuit.",
        "he": "התינוק התעורר ובכה באמצע הלילה.",
        "hi": "बच्चा रात के बीच में जाग गया और रोने लगा।",
        "hu": "A baba felébredt és sírt az éjszaka közepén.",
        "id": "Bayi itu terbangun dan menangis di tengah malam.",
        "it": "Il bambino si è svegliato e ha pianto nel cuore della notte.",
        "ja": "赤ちゃんが真夜中に起きて泣きました。",
        "nb": "Babyen våknet og gråt midt på natten.",
        "nl": "De baby werd midden in de nacht wakker en huilde.",
        "pl": "Dziecko obudziło się w środku nocy i płakało.",
        "pt": "O bebê acordou e chorou no meio da noite.",
        "ro": "Bebelușul s-a trezit și a plâns în toiul nopții.",
        "ru": "Ребёнок проснулся среди ночи и заплакал.",
        "sv": "Bebisen vaknade och grät mitt i natten.",
        "tr": "Bebek gecenin bir yarısında uyandı ve ağladı.",
        "uk": "Дитина прокинулася серед ночі й заплакала.",
        "vi": "Em bé tỉnh dậy và khóc vào giữa đêm.",
        "yue": "BB半夜醒咗，仲喊咗。",
        "zh-Hans": "宝宝半夜醒了，还哭了。"
      },
