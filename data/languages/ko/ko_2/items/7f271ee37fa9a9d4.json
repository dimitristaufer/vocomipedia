  "sentences": [
    {
      "target": "아이의 눈빛에 호기심이 가득해요.",
      "reading": "ai-ui nunbich-e hogisim-i gadeukhaeyo.",
      "translations": {
        "en": "The child’s curiosity is written all over their eyes.",
        "ko": "아이의 눈빛에 호기심이 가득해요.",
        "ipa": "ai-ui nunbich-e hogisim-i gadeukhaeyo.",
        "ar": "الفضول يملأ عيني الطفل.",
        "cs": "V očích dítěte je vidět zvědavost.",
        "da": "Barnets øjne er fulde af nysgerrighed.",
        "de": "In den Augen des Kindes liegt lauter Neugier.",
        "el": "Τα μάτια του παιδιού είναι γεμάτα περιέργεια.",
        "es": "La curiosidad le brilla en los ojos al niño.",
        "fi": "Lapsen silmät ovat täynnä uteliaisuutta.",
        "fr": "La curiosité se lit dans les yeux de l'enfant.",
        "he": "הסקרנות ניכרת בעיני הילד.",
        "hi": "बच्चे की आँखों में जिज्ञासा झलकती है।",
        "hu": "A gyerek szemében ott csillog a kíváncsiság.",
        "id": "Rasa ingin tahu terpancar di mata anak itu.",
        "it": "La curiosità si legge negli occhi del bambino.",
        "ja": "子どもの目には好奇心があふれています。",
        "nb": "Barnets øyne er fulle av nysgjerrighet.",
        "nl": "In de ogen van het kind is pure nieuwsgierigheid te zien.",
        "pl": "W oczach dziecka widać ciekawość.",
        "pt": "A curiosidade está escrita nos olhos da criança.",
        "ro": "Curiozitatea se vede în ochii copilului.",
        "ru": "В глазах ребёнка видна любознательность.",
        "sv": "Barnets ögon är fulla av nyfikenhet.",
        "tr": "Çocuğun gözleri merakla parlıyor.",
        "uk": "В очах дитини видно цікавість.",
        "vi": "Sự tò mò hiện rõ trong mắt đứa trẻ.",
        "yue": "小朋友眼裡充滿好奇。",
        "zh-Hans": "孩子的眼睛里充满了好奇心。"
      },
