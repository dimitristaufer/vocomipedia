  "sentences": [
    {
      "target": "아버지가 손님을 집 안으로 들입니다.",
      "reading": "Abeojiga sonnim-eul jip aneuro deurimnida.",
      "translations": {
        "en": "My father lets the guest into the house.",
        "ko": "아버지가 손님을 집 안으로 들입니다.",
        "ipa": "Abeojiga sonnim-eul jip aneuro deurimnida.",
        "ar": "أبي يُدخل الضيف إلى البيت.",
        "cs": "Otec pouští hosta do domu.",
        "da": "Min far lukker gæsten ind i huset.",
        "de": "Mein Vater lässt den Gast ins Haus.",
        "el": "Ο πατέρας μου βάζει τον επισκέπτη μέσα στο σπίτι.",
        "es": "Mi padre deja entrar al invitado en la casa.",
        "fi": "Isäni päästää vieraan sisään taloon.",
        "fr": "Mon père fait entrer l'invité dans la maison.",
        "he": "אבא שלי מכניס את האורח לבית.",
        "hi": "मेरे पिता मेहमान को घर में आने देते हैं।",
        "hu": "Apám beengedi a vendéget a házba.",
        "id": "Ayah saya mempersilakan tamu masuk ke rumah.",
        "it": "Mio padre fa entrare l'ospite in casa.",
        "ja": "父が客を家の中に入れます。",
        "nb": "Faren min slipper gjesten inn i huset.",
        "nl": "Mijn vader laat de gast het huis in.",
        "pl": "Mój ojciec wpuszcza gościa do domu.",
        "pt": "Meu pai deixa o convidado entrar em casa.",
        "ro": "Tatăl meu îl lasă pe oaspete să intre în casă.",
        "ru": "Мой отец впускает гостя в дом.",
        "sv": "Min pappa släpper in gästen i huset.",
        "tr": "Babam misafiri eve alıyor.",
        "uk": "Мій батько впускає гостя до будинку.",
        "vi": "Bố tôi cho vị khách vào nhà.",
        "yue": "我爸爸請客人入屋。",
        "zh-Hans": "我爸爸请客人进屋。"
      },
