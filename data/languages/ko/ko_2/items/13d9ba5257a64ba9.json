  "sentences": [
    {
      "target": "창밖으로 바다가 넓게 펼쳐졌어요.",
      "reading": "changbakk-euro badaga neolbge pyeolchyeojyeosseoyo",
      "translations": {
        "en": "The sea stretched wide beyond the window.",
        "ko": "창밖으로 바다가 넓게 펼쳐졌어요.",
        "ipa": "changbakk-euro badaga neolbge pyeolchyeojyeosseoyo",
        "ar": "امتد البحر على اتساعه خلف النافذة.",
        "cs": "Za oknem se široce rozprostíralo moře.",
        "da": "Havet bredte sig langt ud bag vinduet.",
        "de": "Hinter dem Fenster erstreckte sich das Meer weit.",
        "el": "Η θάλασσα απλωνόταν πλατιά πέρα από το παράθυρο.",
        "es": "El mar se extendía más allá de la ventana.",
        "fi": "Meri levisi leveänä ikkunan takana.",
        "fr": "La mer s'étendait largement au-delà de la fenêtre.",
        "he": "הים השתרע לרוחב מעבר לחלון.",
        "hi": "खिड़की के बाहर समुद्र दूर तक फैला हुआ था।",
        "hu": "Az ablakon túl szélesen terült el a tenger.",
        "id": "Laut membentang luas di luar jendela.",
        "it": "Il mare si stendeva oltre la finestra.",
        "ja": "窓の向こうに海が広く広がっていました。",
        "nb": "Havet strakte seg vidt utenfor vinduet.",
        "nl": "De zee strekte zich wijd uit achter het raam.",
        "pl": "Morze rozciągało się szeroko za oknem.",
        "pt": "O mar se estendia amplo além da janela.",
        "ro": "Marea se întindea larg dincolo de fereastră.",
        "ru": "Море широко раскинулось за окном.",
        "sv": "Havet bredde ut sig långt bortom fönstret.",
        "tr": "Deniz pencerenin ötesine doğru uzanıyordu.",
        "uk": "Море широко простяглося за вікном.",
        "vi": "Biển trải rộng ra bên ngoài cửa sổ.",
        "yue": "窗外面嘅海廣闊咁伸展開。",
        "zh-Hans": "窗外的大海广阔地伸展开来。"
      },
