    {
      "target": "할머니께서 아직 주무세요.",
      "reading": "halmeonikkeseo ajik jumuseyo.",
      "translations": {
        "en": "My grandmother is still sleeping.",
        "ko": "할머니께서 아직 주무세요.",
        "ipa": "halmeonikkeseo ajik jumuseyo.",
        "ar": "جدتي ما زالت نائمة.",
        "cs": "Babička ještě spí.",
