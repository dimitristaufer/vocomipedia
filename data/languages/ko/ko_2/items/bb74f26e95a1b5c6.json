  "sentences": [
    {
      "target": "그 아이는 정말 순수하다.",
      "reading": "geu aineun jeongmal sunsuhada.",
      "translations": {
        "en": "That child is really pure.",
        "ko": "그 아이는 정말 순수하다.",
        "ipa": "geu aineun jeongmal sunsuhada.",
        "ar": "ذلك الطفل نقيّ جدًا.",
        "cs": "To dítě je opravdu čisté.",
        "da": "Det barn er virkelig rent.",
        "de": "Das Kind ist wirklich rein.",
        "el": "Αυτό το παιδί είναι πραγματικά αγνό.",
        "es": "Ese niño es realmente puro.",
        "fi": "Tuo lapsi on todella puhdas.",
        "fr": "Cet enfant est vraiment pur.",
        "he": "הילד הזה ממש טהור.",
        "hi": "वह बच्चा सचमुच मासूम है।",
        "hu": "Az a gyerek tényleg ártatlan.",
        "id": "Anak itu benar-benar polos.",
        "it": "Quel bambino è davvero puro.",
        "ja": "あの子は本当に純粋だ。",
        "nb": "Det barnet er virkelig uskyldig.",
        "nl": "Dat kind is echt puur.",
        "pl": "To dziecko jest naprawdę niewinne.",
        "pt": "Essa criança é realmente pura.",
        "ro": "Copilul acela este cu adevărat pur.",
        "ru": "Этот ребёнок правда чистый.",
        "sv": "Det barnet är verkligen oskyldigt.",
        "tr": "O çocuk gerçekten saf.",
        "uk": "Та дитина справді чиста.",
        "vi": "Đứa bé đó thật trong sáng.",
        "yue": "嗰個細路真係好純真。",
        "zh-Hans": "那个孩子真的很纯真。"
      },
