    ],
    "hi": [
      "कृपया दरवाज़ा खींचिए।",
      "मैंने परदा थोड़ा सा खींचा।",
      "अगर तुम रस्सी को जोर से खींचोगे, तो घंटी बजेगी।",
      "मुझे उस केक की बार-बार इच्छा होती है।"
    ],
    "hu": [
      "Kérlek, húzd be az ajtót.",
      "Kicsit elhúztam a függönyt.",
