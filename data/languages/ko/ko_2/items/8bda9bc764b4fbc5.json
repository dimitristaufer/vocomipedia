  "sentences": [
    {
      "target": "그녀는 발끝으로 소리 없이 걸었어요.",
      "reading": "geunyeoneun balkkeuteuro sori eopsi georeosseoyo.",
      "translations": {
        "en": "She walked silently on tiptoes.",
        "ko": "그녀는 발끝으로 소리 없이 걸었어요.",
        "ipa": "geunyeoneun balkkeuteuro sori eopsi georeosseoyo.",
        "ar": "مشيتْ بصمتٍ على أطراف أصابعها.",
        "cs": "Šla potichu po špičkách.",
        "da": "Hun gik lydløst på tå.",
        "de": "Sie ging lautlos auf Zehenspitzen.",
        "el": "Περπάτησε αθόρυβα στις μύτες των ποδιών της.",
        "es": "Ella caminó en puntillas sin hacer ruido.",
        "fi": "Hän käveli varpaillaan äänettömästi.",
        "fr": "Elle a marché sur la pointe des pieds sans faire de bruit.",
        "he": "היא הלכה בשקט על קצות האצבעות.",
        "hi": "वह पंजों के बल चुपचाप चली।",
        "hu": "Lábujjhegyen, nesztelenül járt.",
        "id": "Dia berjalan tanpa suara dengan berjinjit.",
        "it": "Camminava in punta di piedi senza fare rumore.",
        "ja": "彼女はつま先立ちで静かに歩きました。",
        "nb": "Hun gikk lydløst på tå.",
        "nl": "Ze liep stilletjes op haar tenen.",
        "pl": "Szła cicho na palcach.",
        "pt": "Ela caminhou em silêncio na ponta dos pés.",
        "ro": "Ea a mers în liniște pe vârfuri.",
        "ru": "Она тихо шла на цыпочках.",
        "sv": "Hon gick ljudlöst på tå.",
        "tr": "O, parmak uçlarında sessizce yürüdü.",
        "uk": "Вона тихо йшла навшпиньках.",
        "vi": "Cô ấy đi nhẹ nhàng bằng đầu ngón chân.",
        "yue": "佢喺腳尖上靜靜地行路。",
        "zh-Hans": "她踮着脚尖悄悄地走路。"
      },
