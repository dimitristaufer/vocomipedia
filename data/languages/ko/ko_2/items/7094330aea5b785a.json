  "sentences": [
    {
      "target": "할머니는 곡식을 햇볕에 말리셨어요.",
      "reading": "halmeonineun goksigeul haetbyeoteu mallisyeosseoyo.",
      "translations": {
        "en": "Grandma dried the grain in the sun.",
        "ko": "할머니는 곡식을 햇볕에 말리셨어요.",
        "ipa": "halmeonineun goksigeul haetbyeoteu mallisyeosseoyo.",
        "ar": "جدتي جففت الحبوب تحت الشمس.",
        "cs": "Babička sušila obilí na slunci.",
        "da": "Bedstemor tørrede korn i solen.",
        "de": "Oma trocknete das Getreide in der Sonne.",
        "el": "Η γιαγιά άπλωσε τα σιτηρά να στεγνώσουν στον ήλιο.",
        "es": "La abuela secó el grano al sol.",
        "fi": "Isoäiti kuivasi viljaa auringossa.",
        "fr": "Grand-mère a fait sécher le grain au soleil.",
        "he": "סבתא ייבשה את התבואה בשמש.",
        "hi": "दादी ने अनाज को धूप में सुखाया।",
        "hu": "A nagymama a napon szárította a gabonát.",
        "id": "Nenek mengeringkan gandum di bawah sinar matahari.",
        "it": "La nonna ha fatto essiccare il grano al sole.",
        "ja": "おばあさんは穀物を日に干しました。",
        "nb": "Bestemor tørket kornet i solen.",
        "nl": "Oma droogde het graan in de zon.",
        "pl": "Babcia suszyła zboże na słońcu.",
        "pt": "A avó secou o cereal ao sol.",
        "ro": "Bunica a uscat cerealele la soare.",
        "ru": "Бабушка сушила зерно на солнце.",
        "sv": "Mormor torkade säden i solen.",
        "tr": "Büyükanne tahılı güneşte kuruttu.",
        "uk": "Бабуся сушила зерно на сонці.",
        "vi": "Bà đã phơi ngũ cốc dưới nắng.",
        "yue": "婆婆喺陽光下曬穀物。",
        "zh-Hans": "奶奶把谷物晒在太阳下。"
      },
