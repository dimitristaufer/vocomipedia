  "sentences": [
    {
      "target": "부장이 회의 시간을 앞당겼어요.",
      "reading": "bujangi hoeui siganeul apdanggyeosseoyo.",
      "translations": {
        "en": "The department head moved the meeting time up.",
        "ko": "부장이 회의 시간을 앞당겼어요.",
        "ipa": "bujangi hoeui siganeul apdanggyeosseoyo.",
        "ar": "قدّم رئيس القسم موعد الاجتماع.",
        "cs": "Vedoucí oddělení posunul schůzku dřív.",
        "da": "Afdelingslederen rykkede mødet frem.",
        "de": "Der Abteilungsleiter hat die Besprechung vorverlegt.",
        "el": "Ο προϊστάμενος του τμήματος έφερε τη συνάντηση νωρίτερα.",
        "es": "El jefe del departamento adelantó la reunión.",
        "fi": "Osastopäällikkö aikaisti kokousta.",
        "fr": "Le chef de service a avancé l'heure de la réunion.",
        "he": "ראש המחלקה הקדים את שעת הישיבה.",
        "hi": "विभाग प्रमुख ने बैठक का समय पहले कर दिया।",
        "hu": "Az osztályvezető előbbre hozta az értekezletet.",
        "id": "Kepala departemen memajukan waktu rapat.",
        "it": "Il capo reparto ha anticipato l'orario della riunione.",
        "ja": "部長が会議の時間を早めました。",
        "nb": "Avdelingslederen flyttet møtet frem.",
        "nl": "De afdelingschef heeft de vergadering vervroegd.",
        "pl": "Kierownik działu przyspieszył spotkanie.",
        "pt": "O chefe do departamento antecipou a reunião.",
        "ro": "Șeful departamentului a devansat întâlnirea.",
        "ru": "Начальник отдела перенёс совещание на более раннее время.",
        "sv": "Avdelningschefen flyttade fram mötet.",
        "tr": "Bölüm şefi toplantıyı öne aldı.",
        "uk": "Керівник відділу переніс зустріч на раніше.",
        "vi": "Trưởng phòng đã dời giờ họp lên sớm hơn.",
        "yue": "部長提早咗會議時間。",
        "zh-Hans": "部门经理把会议时间提前了。"
      },
