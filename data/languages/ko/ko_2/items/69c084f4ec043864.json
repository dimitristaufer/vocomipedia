  "sentences": [
    {
      "target": "감독님이 오늘 촬영을 빨리 끝냈어요.",
      "reading": "gamdoknim-i oneul chwalyeongeul ppalige kkeutnaesseoyo.",
      "translations": {
        "en": "The director finished the shoot early today.",
        "ko": "감독님이 오늘 촬영을 빨리 끝냈어요.",
        "ipa": "gamdoknim-i oneul chwalyeongeul ppalige kkeutnaesseoyo.",
        "ar": "أنهى المخرج التصوير مبكرًا اليوم.",
        "cs": "Režisér dnes dokončil natáčení brzy.",
        "da": "Instruktøren blev færdig med optagelserne tidligt i dag.",
        "de": "Der Regisseur hat heute die Dreharbeiten früh beendet.",
        "el": "Ο σκηνοθέτης τελείωσε σήμερα τα γυρίσματα νωρίς.",
        "es": "El director terminó la filmación temprano hoy.",
        "fi": "Ohjaaja sai kuvaukset valmiiksi aikaisin tänään.",
        "fr": "Le réalisateur a terminé le tournage tôt aujourd'hui.",
        "he": "הבמאי סיים את הצילומים מוקדם היום.",
        "hi": "निर्देशक ने आज शूटिंग जल्दी खत्म कर दी।",
        "hu": "A rendező ma korán befejezte a forgatást.",
        "id": "Sutradara menyelesaikan syuting lebih awal hari ini.",
        "it": "Il regista ha finito le riprese presto oggi.",
        "ja": "監督は今日、撮影を早く終えました。",
        "nb": "Regissøren ble ferdig med opptakene tidlig i dag.",
        "nl": "De regisseur was vandaag vroeg klaar met filmen.",
        "pl": "Reżyser skończył dziś zdjęcia wcześniej.",
        "pt": "O diretor terminou as filmagens cedo hoje.",
        "ro": "Regizorul a terminat filmarea devreme astăzi.",
        "ru": "Режиссёр сегодня рано закончил съёмку.",
        "sv": "Regissören blev klar med inspelningen tidigt i dag.",
        "tr": "Yönetmen bugün çekimi erken bitirdi.",
        "uk": "Режисер сьогодні рано закінчив знімання.",
        "vi": "Đạo diễn đã kết thúc quay phim sớm hôm nay.",
        "yue": "導演今日早咗完成拍攝。",
        "zh-Hans": "导演今天很早就结束了拍摄。"
      },
