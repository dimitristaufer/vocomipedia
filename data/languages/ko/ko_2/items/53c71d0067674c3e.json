  "sentences": [
    {
      "target": "저기 들에 소가 풀을 뜯고 있어요.",
      "reading": "jeogi deure soga puleul tteutgo isseoyo.",
      "translations": {
        "en": "A cow is grazing in the field over there.",
        "ko": "저기 들에 소가 풀을 뜯고 있어요.",
        "ipa": "jeogi deure soga puleul tteutgo isseoyo.",
        "ar": "هناك بقرة ترعى في الحقل هناك.",
        "cs": "Tam na poli se pase kráva.",
        "da": "Der græsser en ko ude på marken.",
        "de": "Dort auf der Wiese grast eine Kuh.",
        "el": "Εκεί μια αγελάδα βόσκει στο λιβάδι.",
        "es": "Allí una vaca pasta en el campo.",
        "fi": "Tuolla niityllä lehmä syö ruohoa.",
        "fr": "Là-bas, une vache broute dans le pré.",
        "he": "שם פרה רועה בשדה.",
        "hi": "वहाँ मैदान में एक गाय घास चर रही है।",
        "hu": "Ott a mezőn egy tehén legel.",
        "id": "Di sana seekor sapi sedang merumput di padang.",
        "it": "Là, una mucca bruca nel prato.",
        "ja": "あそこにある野原で牛が草を食べています。",
        "nb": "Der borte beiter en ku på enga.",
        "nl": "Daar in het veld graast een koe.",
        "pl": "Tam na łące pasie się krowa.",
        "pt": "Ali, uma vaca pasta no campo.",
        "ro": "Acolo, o vacă paște pe câmp.",
        "ru": "Там на лугу корова пасётся.",
        "sv": "Där ute på ängen betar en ko.",
        "tr": "Şurada tarlada bir inek otluyor.",
        "uk": "Он там на лузі корова пасеться.",
        "vi": "Ngoài kia, một con bò đang gặm cỏ trên đồng.",
        "yue": "嗰邊嘅草原上有隻牛喺度食草。",
        "zh-Hans": "那边的草地上有一头牛在吃草。"
      },
