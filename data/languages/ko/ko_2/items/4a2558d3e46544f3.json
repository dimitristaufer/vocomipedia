    {
      "target": "우리 할아버지는 농사를 지어요.",
      "reading": "uri harabeojineun nongsareul jiwoyo.",
      "translations": {
        "en": "My grandfather farms.",
        "ko": "우리 할아버지는 농사를 지어요.",
        "ipa": "uri harabeojineun nongsareul jiwoyo.",
        "ar": "يعمل جدي في الزراعة.",
        "cs": "Můj dědeček hospodaří.",
        "da": "Min bedstefar er landmand.",
        "de": "Mein Großvater ist Bauer.",
        "el": "Ο παππούς μου είναι αγρότης.",
        "es": "Mi abuelo trabaja en el campo.",
        "fi": "Isoisäni on maanviljelijä.",
        "fr": "Mon grand-père fait de l'agriculture.",
        "he": "הסבא שלי חקלאי.",
        "hi": "मेरे दादाजी खेती करते हैं।",
        "hu": "A nagyapám gazdálkodik.",
        "id": "Kakek saya bertani.",
        "it": "Mio nonno fa il contadino.",
        "ja": "祖父は農業をしています。",
        "nb": "Bestefaren min driver med jordbruk.",
        "nl": "Mijn opa is boer.",
        "pl": "Mój dziadek jest rolnikiem.",
        "pt": "Meu avô trabalha na agricultura.",
        "ro": "Bunicul meu este fermier.",
        "ru": "Мой дедушка занимается сельским хозяйством.",
        "sv": "Min morfar är bonde.",
        "tr": "Dedem çiftçilik yapıyor.",
        "uk": "Мій дідусь займається сільським господарством.",
        "vi": "Ông tôi làm nông.",
        "yue": "我公公做農夫。",
        "zh-Hans": "我爷爷务农。"
      },
