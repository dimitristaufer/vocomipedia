  "sentences": [
    {
      "target": "선생님이 문제의 해답을 알려 주셨어요.",
      "reading": "seonsaengnimi munjeui haedabeul allyeo jusyeosseoyo.",
      "translations": {
        "en": "The teacher told us the answer to the problem.",
        "ko": "선생님이 문제의 해답을 알려 주셨어요.",
        "ipa": "seonsaengnimi munjeui haedabeul allyeo jusyeosseoyo.",
        "ar": "أخبرنا المعلم بإجابة المسألة.",
        "cs": "Učitel nám řekl řešení problému.",
        "da": "Læreren fortalte os svaret på opgaven.",
        "de": "Der Lehrer sagte uns die Lösung der Aufgabe.",
        "el": "Ο δάσκαλος μάς είπε τη λύση του προβλήματος.",
        "es": "El profesor nos dijo la respuesta al problema.",
        "fi": "Opettaja kertoi meille tehtävän ratkaisun.",
        "fr": "Le professeur nous a donné la réponse au problème.",
        "he": "המורה אמר לנו את הפתרון לבעיה.",
        "hi": "शिक्षक ने हमें समस्या का जवाब बताया।",
        "hu": "A tanár megmondta nekünk a feladat megoldását.",
        "id": "Guru memberi tahu kami jawaban atas soal itu.",
        "it": "L’insegnante ci ha detto la risposta al problema.",
        "ja": "先生は問題の答えを教えてくれました。",
        "nb": "Læreren fortalte oss svaret på oppgaven.",
        "nl": "De leraar vertelde ons het antwoord op de opgave.",
        "pl": "Nauczyciel powiedział nam odpowiedź na zadanie.",
        "pt": "O professor nos disse a resposta do problema.",
        "ro": "Profesorul ne-a spus răspunsul la problemă.",
        "ru": "Учитель сказал нам ответ на задачу.",
        "sv": "Läraren berättade svaret på uppgiften för oss.",
        "tr": "Öğretmen bize problemin cevabını söyledi.",
        "uk": "Учитель сказав нам відповідь на задачу.",
        "vi": "Giáo viên đã nói cho chúng tôi lời giải của bài toán.",
        "yue": "老師話畀我哋知呢條題目嘅答案。",
        "zh-Hans": "老师告诉了我们这道题的答案。"
      },
