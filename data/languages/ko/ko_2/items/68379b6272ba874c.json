  "sentences": [
    {
      "target": "친구들과 술잔을 부딪쳤어요.",
      "reading": "chingudeulgwa suljaneul buditchyeosseoyo.",
      "translations": {
        "en": "I clinked glasses with my friends.",
        "ko": "친구들과 술잔을 부딪쳤어요.",
        "ipa": "chingudeulgwa suljaneul buditchyeosseoyo.",
        "ar": "اصطدمتُ بالكؤوس مع أصدقائي.",
        "cs": "Ťukl jsem si se svými přáteli.",
        "da": "Jeg skålede med mine venner.",
        "de": "Ich stieß mit meinen Freunden an.",
        "el": "Τσουγκρίσαμε τα ποτήρια μας με τους φίλους μου.",
        "es": "Brindé con mis amigos.",
        "fi": "Kohotin lasini ystävieni kanssa.",
        "fr": "J'ai trinqué avec mes amis.",
        "he": "הרמתי כוסית עם החברים שלי.",
        "hi": "मैंने अपने दोस्तों के साथ जाम टकराया।",
        "hu": "Koccintottam a barátaimmal.",
        "id": "Aku bersulang dengan teman-temanku.",
        "it": "Ho brindato con i miei amici.",
        "ja": "友達とグラスを合わせました。",
        "nb": "Jeg skålte med vennene mine.",
        "nl": "Ik proostte met mijn vrienden.",
        "pl": "Wznieśliśmy toast z moimi przyjaciółmi.",
        "pt": "Brindei com meus amigos.",
        "ro": "Am ciocnit paharele cu prietenii mei.",
        "ru": "Я чокнулся с друзьями.",
        "sv": "Jag skålade med mina vänner.",
        "tr": "Arkadaşlarımla kadeh tokuşturdum.",
        "uk": "Я цокнувся з друзями.",
        "vi": "Tôi cụng ly với bạn bè.",
        "yue": "我同朋友夾杯。",
        "zh-Hans": "我和朋友们碰了杯。"
      },
