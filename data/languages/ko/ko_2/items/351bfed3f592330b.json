  "sentences": [
    {
      "target": "목표에 도달하면 축하해 드릴게요.",
      "reading": "mokpyeoe dodalhamyeon chukhae deurilgeyo.",
      "translations": {
        "en": "If you reach the goal, I’ll congratulate you.",
        "ko": "목표에 도달하면 축하해 드릴게요.",
        "ipa": "mokpyeoe dodalhamyeon chukhae deurilgeyo.",
        "ar": "إذا وصلت إلى الهدف، فسأهنئك.",
        "cs": "Když dosáhnete cíle, pogratuluji vám.",
        "da": "Hvis du når målet, vil jeg lykønske dig.",
        "de": "Wenn du das Ziel erreichst, gratuliere ich dir.",
        "el": "Αν φτάσεις στον στόχο, θα σε συγχαρώ.",
        "es": "Si alcanzas la meta, te felicitaré.",
        "fi": "Jos saavutat tavoitteen, onnittelen sinua.",
        "fr": "Si tu atteins l'objectif, je te féliciterai.",
        "he": "אם תגיע למטרה, אני אברך אותך.",
        "hi": "अगर आप लक्ष्य तक पहुँचते हैं, तो मैं आपको बधाई दूँगा।",
        "hu": "Ha eléred a célt, gratulálni fogok.",
        "id": "Kalau kamu mencapai tujuan, aku akan mengucapkan selamat.",
        "it": "Se raggiungi l'obiettivo, ti farò i complimenti.",
        "ja": "目標に達したら、お祝いします。",
        "nb": "Hvis du når målet, skal jeg gratulere deg.",
        "nl": "Als je het doel bereikt, feliciteer ik je.",
        "pl": "Jeśli osiągniesz cel, pogratuluję ci.",
        "pt": "Se você alcançar a meta, eu vou te parabenizar.",
        "ro": "Dacă ajungi la obiectiv, te voi felicita.",
        "ru": "Если вы достигнете цели, я вас поздравлю.",
        "sv": "Om du når målet kommer jag att gratulera dig.",
        "tr": "Hedefe ulaşırsan seni tebrik ederim.",
        "uk": "Якщо ви досягнете мети, я вас привітаю.",
        "vi": "Nếu bạn đạt được mục tiêu, tôi sẽ chúc mừng bạn.",
        "yue": "如果你達到目標，我會恭喜你。",
        "zh-Hans": "如果你达到目标，我会祝贺你。"
      },
