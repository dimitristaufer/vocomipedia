    {
      "target": "민수랑 금방 친해졌어요.",
      "reading": "Minsurang geumbang chinhaejyeosseoyo.",
      "translations": {
        "en": "I got close with Minsu quickly.",
        "ko": "민수랑 금방 친해졌어요.",
        "ipa": "Minsurang geumbang chinhaejyeosseoyo.",
        "ar": "تقرّبت من مينسو بسرعة.",
        "cs": "S Minsuem jsem si rychle padl do oka.",
        "da": "Jeg kom hurtigt godt ud af det med Minsu.",
        "de": "Ich bin schnell mit Minsu warm geworden.",
        "el": "Δέθηκα γρήγορα με τον Μινσού.",
        "es": "Me hice amigo de Minsu enseguida.",
        "fi": "Tulin nopeasti sinuiksi Minsun kanssa.",
        "fr": "Je me suis vite lié avec Minsu.",
        "he": "התקרבתי מהר למינסו.",
        "hi": "मैं मिनसू के साथ जल्दी घुल-मिल गया।",
        "hu": "Gyorsan összebarátkoztam Minszuval.",
        "id": "Saya cepat akrab dengan Minsu.",
        "it": "Ho fatto presto amicizia con Minsu.",
        "ja": "ミンスとすぐに仲良くなりました。",
        "nb": "Jeg ble fort god venn med Minsu.",
        "nl": "Ik raakte snel bevriend met Minsu.",
        "pl": "Szybko się z Minsu zakumplowałem.",
        "pt": "Fiquei amigo do Minsu rapidamente.",
        "ro": "M-am împrietenit repede cu Minsu.",
        "ru": "Я быстро подружился с Минсу.",
        "sv": "Jag blev snabbt kompis med Minsu.",
        "tr": "Minsu ile çabucak yakın arkadaş oldum.",
        "uk": "Я швидко потоваришував із Мінсу.",
        "vi": "Tôi nhanh chóng thân với Minsu.",
        "yue": "我好快同民秀熟落咗。",
        "zh-Hans": "我很快和民秀熟了。"
      },
