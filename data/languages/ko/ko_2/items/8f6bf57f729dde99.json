  "sentences": [
    {
      "target": "마음속으로는 아직 포기하지 않았어요.",
      "reading": "maeumsogeuroneun ajik pogihaji anasseoyo.",
      "translations": {
        "en": "Deep down, I still haven’t given up.",
        "ko": "마음속으로는 아직 포기하지 않았어요.",
        "ipa": "maeumsogeuroneun ajik pogihaji anasseoyo.",
        "ar": "في قرارة نفسي، لم أستسلم بعد.",
        "cs": "V hloubi duše jsem se ještě nevzdal.",
        "da": "Dybest set har jeg stadig ikke givet op.",
        "de": "Tief in mir habe ich noch nicht aufgegeben.",
        "el": "Βαθιά μέσα μου δεν έχω ακόμα παραιτηθεί.",
        "es": "En el fondo, todavía no me he rendido.",
        "fi": "Pohjimmiltani en ole vieläkään luovuttanut.",
        "fr": "Au fond de moi, je n’ai pas encore abandonné.",
        "he": "עמוק בלבי, עדיין לא ויתרתי.",
        "hi": "दिल की गहराई में, मैंने अभी तक हार नहीं मानी है।",
        "hu": "Legbelül még nem adtam fel.",
        "id": "Di dalam hati, aku belum menyerah.",
        "it": "In cuor mio non ho ancora rinunciato.",
        "ja": "心の中では、まだあきらめていません。",
        "nb": "Innerst inne har jeg ennå ikke gitt opp.",
        "nl": "Diep vanbinnen heb ik nog niet opgegeven.",
        "pl": "Głęboko w środku jeszcze się nie poddałem.",
        "pt": "No fundo, ainda não desisti.",
        "ro": "În adâncul sufletului, încă nu am renunțat.",
        "ru": "В глубине души я ещё не сдался.",
        "sv": "Innerst inne har jag inte gett upp än.",
        "tr": "İçimden henüz vazgeçmedim.",
        "uk": "У глибині душі я ще не здався.",
        "vi": "Trong lòng, tôi vẫn chưa bỏ cuộc.",
        "yue": "喺心入面，我仲未放棄。",
        "zh-Hans": "在心里，我还没有放弃。"
      },
