  "sentences": [
    {
      "target": "오늘은 잠옷을 새로 샀어요.",
      "reading": "oneureun jamos-eul saero sasseoyo.",
      "translations": {
        "en": "I bought new pajamas today.",
        "ko": "오늘은 잠옷을 새로 샀어요.",
        "ipa": "oneureun jamos-eul saero sasseoyo.",
        "ar": "اشتريتُ بيجامةً جديدة اليوم.",
        "cs": "Dnes jsem si koupil nové pyžamo.",
        "da": "Jeg købte nye pyjamas i dag.",
        "de": "Ich habe heute neue Schlafanzüge gekauft.",
        "el": "Σήμερα αγόρασα καινούρια πιτζάμα.",
        "es": "Hoy compré un pijama nuevo.",
        "fi": "Ostin tänään uudet pyjamat.",
        "fr": "J'ai acheté un nouveau pyjama aujourd'hui.",
        "he": "קניתי היום פיג'מה חדשה.",
        "hi": "मैंने आज नई पायजामा खरीदी।",
        "hu": "Ma új pizsamát vettem.",
        "id": "Hari ini saya membeli piyama baru.",
        "it": "Oggi ho comprato un pigiama nuovo.",
        "ja": "今日は新しいパジャマを買いました。",
        "nb": "Jeg kjøpte en ny pysjamas i dag.",
        "nl": "Ik heb vandaag een nieuwe pyjama gekocht.",
        "pl": "Kupiłem dziś nową piżamę.",
        "pt": "Comprei um pijama novo hoje.",
        "ro": "Am cumpărat azi o pijama nouă.",
        "ru": "Сегодня я купил новую пижаму.",
        "sv": "Jag köpte en ny pyjamas i dag.",
        "tr": "Bugün yeni bir pijama aldım.",
        "uk": "Сьогодні я купив нову піжаму.",
        "vi": "Hôm nay tôi đã mua một bộ đồ ngủ mới.",
        "yue": "我今日買咗套新睡衣。",
        "zh-Hans": "我今天买了新睡衣。"
      },
