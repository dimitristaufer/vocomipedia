  "sentences": [
    {
      "target": "우리 식구는 저녁을 같이 먹어요.",
      "reading": "uri sikguneun jeonyeogeul gachi meogeoyo.",
      "translations": {
        "en": "My family eats dinner together.",
        "ko": "우리 식구는 저녁을 같이 먹어요.",
        "ipa": "uri sikguneun jeonyeogeul gachi meogeoyo.",
        "ar": "تتناول عائلتنا العشاء معًا.",
        "cs": "Naše rodina večeří spolu.",
        "da": "Vores familie spiser aftensmad sammen.",
        "de": "Unsere Familie isst abends zusammen.",
        "el": "Η οικογένειά μας τρώει μαζί βραδινό.",
        "es": "Nuestra familia cena junta.",
        "fi": "Meidän perheemme syö illallista yhdessä.",
        "fr": "Notre famille dîne ensemble.",
        "he": "המשפחה שלנו אוכלת יחד ארוחת ערב.",
        "hi": "हमारा परिवार साथ में रात का खाना खाता है।",
        "hu": "A családunk együtt vacsorázik.",
        "id": "Keluarga kami makan malam bersama.",
        "it": "La nostra famiglia cena insieme.",
        "ja": "うちは家族みんなで夕食を食べます。",
        "nb": "Familien vår spiser middag sammen.",
        "nl": "Ons gezin eet samen avondeten.",
        "pl": "Nasza rodzina je razem kolację.",
        "pt": "Nossa família janta junta.",
        "ro": "Familia noastră ia cina împreună.",
        "ru": "Наша семья ужинает вместе.",
        "sv": "Vår familj äter middag tillsammans.",
        "tr": "Ailemizin akşam yemeğini birlikte yer.",
        "uk": "Наша сім'я вечеряє разом.",
        "vi": "Gia đình tôi ăn tối cùng nhau.",
        "yue": "我哋一家人一齊食晚飯。",
        "zh-Hans": "我们一家人一起吃晚饭。"
      },
