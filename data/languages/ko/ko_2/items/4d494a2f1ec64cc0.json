  "sentences": [
    {
      "target": "비가 올 거라고 예상해요.",
      "reading": "biga ol georago yesanghaeyo",
      "translations": {
        "en": "I expect it will rain.",
        "ko": "비가 올 거라고 예상해요.",
        "ipa": "biga ol georago yesanghaeyo",
        "ar": "أتوقع أن تمطر.",
        "cs": "Očekávám, že bude pršet.",
        "da": "Jeg forventer, at det regner.",
        "de": "Ich erwarte, dass es regnet.",
        "el": "Περιμένω να βρέξει.",
        "es": "Espero que llueva.",
        "fi": "Odotan, että sataa.",
        "fr": "Je pense qu'il va pleuvoir.",
        "he": "אני מצפה שירד גשם.",
        "hi": "मुझे लगता है कि बारिश होगी।",
        "hu": "Azt várom, hogy esni fog az eső.",
        "id": "Saya memperkirakan akan hujan.",
        "it": "Penso che pioverà.",
        "ja": "雨が降ると予想しています。",
        "nb": "Jeg forventer at det vil regne.",
        "nl": "Ik verwacht dat het gaat regenen.",
        "pl": "Spodziewam się, że będzie padać.",
        "pt": "Espero que chova.",
        "ro": "Mă aștept să plouă.",
        "ru": "Я ожидаю, что пойдёт дождь.",
        "sv": "Jag tror att det kommer att regna.",
        "tr": "Yağmur yağacağını tahmin ediyorum.",
        "uk": "Я очікую, що піде дощ.",
        "vi": "Tôi đoán trời sẽ mưa.",
        "yue": "我估會落雨。",
        "zh-Hans": "我预计会下雨。"
      },
