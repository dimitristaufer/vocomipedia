    {
      "target": "사랑은 영원하다고 믿어요.",
      "reading": "sarang-eun yeongwonhadago mideoyo.",
      "translations": {
        "en": "I believe love is eternal.",
        "ko": "사랑은 영원하다고 믿어요.",
        "ipa": "sarang-eun yeongwonhadago mideoyo.",
        "ar": "أؤمن أن الحب أبدي.",
        "cs": "Věřím, že láska je věčná.",
        "da": "Jeg tror, at kærlighed er evig.",
        "de": "Ich glaube, Liebe ist ewig.",
        "el": "Πιστεύω ότι η αγάπη είναι αιώνια.",
        "es": "Creo que el amor es eterno.",
        "fi": "Uskon, että rakkaus on ikuista.",
        "fr": "Je crois que l'amour est éternel.",
        "he": "אני מאמין שהאהבה נצחית.",
        "hi": "मुझे लगता है कि प्यार हमेशा रहता है।",
        "hu": "Hiszem, hogy a szerelem örök.",
        "id": "Saya percaya cinta itu abadi.",
        "it": "Credo che l'amore sia eterno.",
        "ja": "愛は永遠だと信じています。",
        "nb": "Jeg tror at kjærligheten er evig.",
        "nl": "Ik geloof dat liefde eeuwig is.",
        "pl": "Wierzę, że miłość jest wieczna.",
        "pt": "Acredito que o amor é eterno.",
        "ro": "Cred că dragostea este eternă.",
        "ru": "Я верю, что любовь вечна.",
        "sv": "Jag tror att kärleken är evig.",
        "tr": "Aşkın sonsuz olduğuna inanıyorum.",
        "uk": "Я вірю, що кохання вічне.",
        "vi": "Tôi tin rằng tình yêu là vĩnh cửu.",
        "yue": "我相信愛係永恆嘅。",
        "zh-Hans": "我相信爱情是永恒的。"
      },
