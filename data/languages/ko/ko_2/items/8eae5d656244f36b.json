  "sentences": [
    {
      "target": "선생님은 학생의 태도가 좋아서 칭찬했어요.",
      "reading": "seonsaengnimeun haksaengui taedoga joaseo chingchanhaesseoyo.",
      "translations": {
        "en": "The teacher praised the student for his good attitude.",
        "ko": "선생님은 학생의 태도가 좋아서 칭찬했어요.",
        "ipa": "seonsaengnimeun haksaengui taedoga joaseo chingchanhaesseoyo.",
        "ar": "أثنى المعلم على الطالب بسبب حسن سلوكه.",
        "cs": "Učitel pochválil žáka za jeho dobré chování.",
        "da": "Læreren roste eleven for hans gode opførsel.",
        "de": "Der Lehrer lobte den Schüler für sein gutes Verhalten.",
        "el": "Ο δάσκαλος επαίνεσε τον μαθητή για την καλή του συμπεριφορά.",
        "es": "El profesor elogió al estudiante por su buena actitud.",
        "fi": "Opettaja kehui oppilasta hänen hyvästä käytöksestään.",
        "fr": "Le professeur a félicité l'élève pour sa bonne attitude.",
        "he": "המורה שיבח את התלמיד על ההתנהגות הטובה שלו.",
        "hi": "शिक्षक ने छात्र के अच्छे व्यवहार की प्रशंसा की।",
        "hu": "A tanár megdicsérte a diákot a jó viselkedéséért.",
        "id": "Guru memuji siswa itu karena sikapnya yang baik.",
        "it": "L'insegnante ha elogiato lo studente per il suo buon atteggiamento.",
        "ja": "先生は学生の態度がよいのでほめました。",
        "nb": "Læreren roste eleven for den gode oppførselen hans.",
        "nl": "De leraar prees de leerling voor zijn goede houding.",
        "pl": "Nauczyciel pochwalił ucznia za jego dobre zachowanie.",
        "pt": "O professor elogiou o aluno pelo seu bom comportamento.",
        "ro": "Profesorul l-a lăudat pe elev pentru atitudinea lui bună.",
        "ru": "Учитель похвалил ученика за его хорошее поведение.",
        "sv": "Läraren berömde eleven för hans goda uppförande.",
        "tr": "Öğretmen, öğrenciyi iyi tavrı için övdü.",
        "uk": "Учитель похвалив учня за його гарну поведінку.",
        "vi": "Giáo viên khen học sinh vì thái độ tốt của em ấy.",
        "yue": "老師讚賞學生嘅態度好。",
        "zh-Hans": "老师因为学生态度好而表扬了他。"
      },
