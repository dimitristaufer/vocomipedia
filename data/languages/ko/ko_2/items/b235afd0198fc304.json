  "sentences": [
    {
      "target": "선생님은 발표할 때 침착하다.",
      "reading": "seonsaengnimeun balpyohal ttae chimchakada.",
      "translations": {
        "en": "The teacher is calm when giving a presentation.",
        "ko": "선생님은 발표할 때 침착하다.",
        "ipa": "seonsaengnimeun balpyohal ttae chimchakada.",
        "ar": "المعلم هادئ عندما يلقي عرضًا.",
        "cs": "Učitel je klidný, když prezentuje.",
        "da": "Læreren er rolig, når han holder en præsentation.",
        "de": "Der Lehrer ist ruhig, wenn er einen Vortrag hält.",
        "el": "Ο δάσκαλος είναι ψύχραιμος όταν κάνει παρουσίαση.",
        "es": "El profesor está tranquilo cuando da una presentación.",
        "fi": "Opettaja on rauhallinen, kun hän pitää esitelmän.",
        "fr": "Le professeur est calme quand il fait une présentation.",
        "he": "המורה רגוע כשהוא מציג.",
        "hi": "शिक्षक प्रस्तुति देते समय शांत रहते हैं।",
        "hu": "A tanár nyugodt, amikor előadást tart.",
        "id": "Guru tetap tenang saat presentasi.",
        "it": "L'insegnante è tranquillo quando fa una presentazione.",
        "ja": "先生は発表するときも落ち着いている。",
        "nb": "Læreren er rolig når han holder en presentasjon.",
        "nl": "De leraar blijft rustig als hij een presentatie geeft.",
        "pl": "Nauczyciel jest spokojny, kiedy prowadzi prezentację.",
        "pt": "O professor fica calmo quando faz uma apresentação.",
        "ro": "Profesorul este calm când ține o prezentare.",
        "ru": "Учитель спокоен, когда делает презентацию.",
        "sv": "Läraren är lugn när han håller en presentation.",
        "tr": "Öğretmen sunum yaparken sakindir.",
        "uk": "Учитель спокійний, коли робить презентацію.",
        "vi": "Giáo viên rất bình tĩnh khi thuyết trình.",
        "yue": "老師做報告嗰陣好鎮定。",
        "zh-Hans": "老师做报告时很镇定。"
      },
