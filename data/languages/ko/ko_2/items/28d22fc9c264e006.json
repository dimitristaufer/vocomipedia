  "sentences": [
    {
      "target": "오늘 생방송을 봤어요.",
      "reading": "oneul saengbangsong-eul bwasseoyo.",
      "translations": {
        "en": "I watched the live broadcast today.",
        "ko": "오늘 생방송을 봤어요.",
        "ipa": "oneul saengbangsong-eul bwasseoyo.",
        "ar": "شاهدت البث المباشر اليوم.",
        "cs": "Dnes jsem sledoval živé vysílání.",
        "da": "Jeg så liveudsendelsen i dag.",
        "de": "Ich habe heute die Liveübertragung gesehen.",
        "el": "Παρακολούθησα τη ζωντανή μετάδοση σήμερα.",
        "es": "Hoy vi la transmisión en vivo.",
        "fi": "Katsoin suoran lähetyksen tänään.",
        "fr": "J'ai regardé le direct aujourd'hui.",
        "he": "צפיתי בשידור החי היום.",
        "hi": "मैंने आज सीधा प्रसारण देखा।",
        "hu": "Ma megnéztem az élő adást.",
        "id": "Saya menonton siaran langsung hari ini.",
        "it": "Oggi ho guardato la diretta.",
        "ja": "今日は生放送を見ました。",
        "nb": "Jeg så direktesendingen i dag.",
        "nl": "Ik heb vandaag de live-uitzending bekeken.",
        "pl": "Dziś oglądałem transmisję na żywo.",
        "pt": "Hoje eu vi a transmissão ao vivo.",
        "ro": "Am urmărit transmisiunea în direct azi.",
        "ru": "Сегодня я посмотрел прямую трансляцию.",
        "sv": "Jag såg direktsändningen i dag.",
        "tr": "Bugün canlı yayını izledim.",
        "uk": "Сьогодні я подивився пряму трансляцію.",
        "vi": "Hôm nay tôi đã xem buổi phát trực tiếp.",
        "yue": "我今日睇咗直播。",
        "zh-Hans": "我今天看了直播。"
      },
