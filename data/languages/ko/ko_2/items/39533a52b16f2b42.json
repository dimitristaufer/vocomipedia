    {
      "target": "비서가 회의 일정을 정리했어요.",
      "reading": "biseoga hoeui iljeongeul jeongrihaesseoyo.",
      "translations": {
        "en": "The secretary organized the meeting schedule.",
        "ko": "비서가 회의 일정을 정리했어요.",
        "ipa": "biseoga hoeui iljeongeul jeongrihaesseoyo.",
        "ar": "نظمت السكرتيرة جدول الاجتماع.",
        "cs": "Sekretářka uspořádala program porady.",
        "da": "Sekretæren organiserede mødeplanen.",
        "de": "Die Sekretärin hat den Terminplan für die Besprechung organisiert.",
        "el": "Η γραμματέας οργάνωσε το πρόγραμμα της σύσκεψης.",
        "es": "La secretaria organizó el horario de la reunión.",
        "fi": "Sihteeri järjesti kokouksen aikataulun.",
        "fr": "La secrétaire a organisé l'horaire de la réunion.",
        "he": "המזכירה ארגנה את לוח הזמנים של הפגישה.",
        "hi": "सेक्रेटरी ने बैठक का समय तय कर दिया।",
        "hu": "A titkárnő elrendezte az értekezlet időbeosztását.",
        "id": "Sekretaris itu mengatur jadwal rapat.",
        "it": "La segretaria ha organizzato l'orario della riunione.",
        "ja": "秘書が会議の日程をまとめました。",
        "nb": "Sekretæren organiserte møteplanen.",
        "nl": "De secretaresse heeft de vergaderplanning geregeld.",
        "pl": "Sekretarka uporządkowała plan spotkania.",
        "pt": "A secretária organizou o horário da reunião.",
        "ro": "Secretara a organizat programul ședinței.",
        "ru": "Секретарь организовал график совещания.",
        "sv": "Sekreteraren ordnade mötets schema.",
        "tr": "Sekreter toplantı programını düzenledi.",
        "uk": "Секретарка впорядкувала графік наради.",
        "vi": "Thư ký đã sắp xếp lịch họp.",
        "yue": "秘書整理咗會議日程。",
        "zh-Hans": "秘书整理了会议日程。"
