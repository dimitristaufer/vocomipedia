  "sentences": [
    {
      "target": "오늘 배우가 텔레비전 프로그램에 출연했어요.",
      "reading": "Oneul baewuga tellebijeon peurogeuraeme churyeonhaesseoyo.",
      "translations": {
        "en": "The actor appeared on a TV program today.",
        "ko": "오늘 배우가 텔레비전 프로그램에 출연했어요.",
        "ipa": "Oneul baewuga tellebijeon peurogeuraeme churyeonhaesseoyo.",
        "ar": "ظهر الممثل في برنامج تلفزيوني اليوم.",
        "cs": "Herec se dnes objevil v televizním pořadu.",
        "da": "Skuespilleren optrådte i et tv-program i dag.",
        "de": "Der Schauspieler trat heute in einer Fernsehsendung auf.",
        "el": "Ο ηθοποιός εμφανίστηκε σήμερα σε μια τηλεοπτική εκπομπή.",
        "es": "El actor apareció hoy en un programa de televisión.",
        "fi": "Näyttelijä esiintyi tänään tv-ohjelmassa.",
        "fr": "L'acteur est apparu aujourd'hui dans une émission de télévision.",
        "he": "השחקן הופיע היום בתוכנית טלוויזיה.",
        "hi": "अभिनेता आज एक टीवी कार्यक्रम में दिखाई दिया।",
        "hu": "A színész ma egy tévéműsorban szerepelt.",
        "id": "Aktor itu tampil di acara televisi hari ini.",
        "it": "L'attore è apparso oggi in un programma televisivo.",
        "ja": "今日、俳優がテレビ番組に出演しました。",
        "nb": "Skuespilleren var med i et TV-program i dag.",
        "nl": "De acteur verscheen vandaag in een televisieprogramma.",
        "pl": "Aktor wystąpił dziś w programie telewizyjnym.",
        "pt": "O ator apareceu hoje em um programa de televisão.",
        "ro": "Actorul a apărut azi la o emisiune TV.",
        "ru": "Актёр сегодня появился в телепередаче.",
        "sv": "Skådespelaren medverkade i ett tv-program i dag.",
        "tr": "Oyuncu bugün bir televizyon programında yer aldı.",
        "uk": "Актор сьогодні з'явився в телевізійній програмі.",
