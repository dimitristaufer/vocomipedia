    {
      "target": "이웃이 아침마다 인사해요.",
      "reading": "iusi achimmada insahaeyo.",
      "translations": {
        "en": "My neighbor says hello every morning.",
        "ko": "이웃이 아침마다 인사해요.",
        "ipa": "iusi achimmada insahaeyo.",
        "ar": "يلقي جاري التحية كل صباح.",
        "cs": "Můj soused mě každé ráno zdraví.",
        "da": "Min nabo siger godmorgen hver morgen.",
        "de": "Mein Nachbar sagt jeden Morgen Hallo.",
        "el": "Ο γείτονάς μου με χαιρετά κάθε πρωί.",
        "es": "Mi vecino me saluda cada mañana.",
        "fi": "Naapurini tervehtii minua joka aamu.",
        "fr": "Mon voisin me salue tous les matins.",
        "he": "השכן שלי אומר שלום כל בוקר.",
        "hi": "मेरा पड़ोसी हर सुबह नमस्ते कहता है।",
        "hu": "A szomszédom minden reggel köszön.",
        "id": "Tetangga saya menyapa setiap pagi.",
        "it": "Il mio vicino mi saluta ogni mattina.",
        "ja": "近所の人が毎朝あいさつしてくれます。",
        "nb": "Naboen min sier hei hver morgen.",
        "nl": "Mijn buurman zegt elke ochtend gedag.",
        "pl": "Mój sąsiad mówi dzień dobry każdego ranka.",
        "pt": "Meu vizinho me cumprimenta toda manhã.",
        "ro": "Vecinul meu mă salută în fiecare dimineață.",
        "ru": "Мой сосед здоровается каждое утро.",
        "sv": "Min granne säger hej varje morgon.",
        "tr": "Komşum her sabah selam verir.",
        "uk": "Мій сусід вітається щоранку.",
        "vi": "Hàng xóm của tôi chào tôi mỗi sáng.",
        "yue": "我鄰居每日朝早都同我打招呼。",
        "zh-Hans": "我的邻居每天早上都跟我打招呼。"
      },
