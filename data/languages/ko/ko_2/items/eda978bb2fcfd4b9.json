  "sentences": [
    {
      "target": "현관에 신발을 벗어 두세요.",
      "reading": "hyeongwan-e sinbareul beoseo duseyo.",
      "translations": {
        "en": "Please take off your shoes at the entrance.",
        "ko": "현관에 신발을 벗어 두세요.",
        "ipa": "hyeongwan-e sinbareul beoseo duseyo.",
        "ar": "من فضلك اخلع حذاءك عند المدخل.",
        "cs": "Prosím, zout si boty u vchodu.",
        "da": "Tag venligst skoene af ved indgangen.",
        "de": "Bitte zieh dir am Eingang die Schuhe aus.",
        "el": "Βγάλτε τα παπούτσια σας στην είσοδο, παρακαλώ.",
        "es": "Por favor, quítate los zapatos en la entrada.",
        "fi": "Riisu kengät eteisessä, kiitos.",
        "fr": "Veuillez enlever vos chaussures à l'entrée.",
        "he": "בבקשה תורידו את הנעליים בכניסה.",
        "hi": "कृपया जूते प्रवेश द्वार पर उतार दें।",
        "hu": "Kérlek, vedd le a cipődet a bejáratnál.",
        "id": "Tolong lepas sepatu di pintu masuk.",
        "it": "Per favore, togli le scarpe all'ingresso.",
        "ja": "玄関で靴を脱いでください。",
        "nb": "Vær så snill og ta av deg skoene ved inngangen.",
        "nl": "Trek je schoenen uit bij de ingang, alsjeblieft.",
        "pl": "Proszę, zdejmij buty przy wejściu.",
        "pt": "Por favor, tire os sapatos na entrada.",
        "ro": "Te rog să te descalți la intrare.",
        "ru": "Пожалуйста, снимите обувь у входа.",
        "sv": "Ta av dig skorna vid entrén, tack.",
        "tr": "Lütfen ayakkabılarını girişte çıkar.",
        "uk": "Будь ласка, зніміть взуття біля входу.",
        "vi": "Làm ơn cởi giày ở lối vào.",
        "yue": "請喺門口除鞋。",
        "zh-Hans": "请在门口脱鞋。"
      },
