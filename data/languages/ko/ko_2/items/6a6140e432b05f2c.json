  "sentences": [
    {
      "target": "시장에서 장사꾼이 손님을 불렀어요.",
      "reading": "Sijangeseo jangsakkuni sonnim-eul bulleosseoyo.",
      "translations": {
        "en": "At the market, a merchant called out to customers.",
        "ko": "시장에서 장사꾼이 손님을 불렀어요.",
        "ipa": "Sijangeseo jangsakkuni sonnim-eul bulleosseoyo.",
        "ar": "في السوق، نادى تاجرٌ على الزبائن.",
        "cs": "Na trhu volal jeden obchodník na zákazníky.",
        "da": "På markedet råbte en købmand til kunderne.",
        "de": "Auf dem Markt rief ein Händler die Kunden herbei.",
        "el": "Στην αγορά, ένας έμπορος φώναζε στους πελάτες.",
        "es": "En el mercado, un vendedor llamó a los clientes.",
        "fi": "Torilla kauppias kutsui asiakkaita.",
        "fr": "Au marché, un marchand a appelé les clients.",
        "he": "בשוק, סוחר קרא ללקוחות.",
        "hi": "बाजार में, एक व्यापारी ने ग्राहकों को पुकारा।",
        "hu": "A piacon egy kereskedő odahívta a vevőket.",
        "id": "Di pasar, seorang pedagang memanggil para pelanggan.",
        "it": "Al mercato, un mercante chiamava i clienti.",
        "ja": "市場で、商人が客を呼んでいました。",
        "nb": "På markedet ropte en kjøpmann på kundene.",
        "nl": "Op de markt riep een koopman naar de klanten.",
        "pl": "Na targu kupiec wołał do klientów.",
        "pt": "No mercado, um comerciante chamou os clientes.",
        "ro": "La piață, un negustor a strigat la clienți.",
        "ru": "На рынке торговец окликал покупателей.",
        "sv": "På marknaden ropade en köpman på kunderna.",
        "tr": "Pazarda bir tüccar müşterilere seslendi.",
        "uk": "На ринку торговець кликав покупців.",
        "vi": "Ở chợ, một người buôn đã gọi khách hàng.",
        "yue": "喺街市度，一個商人叫顧客。",
        "zh-Hans": "在市场上，一个商人招呼顾客。"
      },
