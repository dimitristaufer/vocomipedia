  "sentences": [
    {
      "target": "이전에는 버스를 타고 학교에 갔어요.",
      "reading": "ijeon-eneun beoseureul tago hakgyoe gasseoyo.",
      "translations": {
        "en": "In the past, I went to school by bus.",
        "ko": "이전에는 버스를 타고 학교에 갔어요.",
        "ipa": "ijeon-eneun beoseureul tago hakgyoe gasseoyo.",
        "ar": "في السابق، كنت أذهب إلى المدرسة بالحافلة.",
        "cs": "Dřív jsem jezdil do školy autobusem.",
        "da": "Før tog jeg bussen i skole.",
        "de": "Früher bin ich mit dem Bus zur Schule gefahren.",
        "el": "Παλιά πήγαινα σχολείο με το λεωφορείο.",
        "es": "Antes iba a la escuela en autobús.",
        "fi": "Aiemmin menin kouluun bussilla.",
        "fr": "Avant, j'allais à l'école en bus.",
        "he": "בעבר נסעתי לבית הספר באוטובוס.",
        "hi": "पहले मैं बस से स्कूल जाता था।",
        "hu": "Régebben busszal jártam iskolába.",
        "id": "Dulu saya pergi ke sekolah naik bus.",
        "it": "Prima andavo a scuola in autobus.",
        "ja": "前はバスで学校に通っていました。",
        "nb": "Før tok jeg bussen til skolen.",
        "nl": "Vroeger ging ik met de bus naar school.",
        "pl": "Kiedyś jeździłem do szkoły autobusem.",
        "pt": "Antes eu ia para a escola de ônibus.",
        "ro": "Înainte mergeam la școală cu autobuzul.",
        "ru": "Раньше я ездил в школу на автобусе.",
        "sv": "Förut åkte jag buss till skolan.",
        "tr": "Eskiden okula otobüsle giderdim.",
        "uk": "Раніше я їздив до школи автобусом.",
        "vi": "Trước đây tôi đi học bằng xe buýt.",
        "yue": "以前，我搭巴士返學。",
        "zh-Hans": "以前，我坐公交车去学校。"
      },
