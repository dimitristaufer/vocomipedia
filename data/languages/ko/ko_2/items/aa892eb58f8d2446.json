  "sentences": [
    {
      "target": "가루를 물에 타서 마셨어요.",
      "reading": "garureul mul-e taseo masyeosseoyo.",
      "translations": {
        "en": "I mixed the powder into water and drank it.",
        "ko": "가루를 물에 타서 마셨어요.",
        "ipa": "garureul mul-e taseo masyeosseoyo.",
        "ar": "خلطتُ المسحوق بالماء وشربته.",
        "cs": "Smíchal jsem prášek s vodou a vypil ho.",
        "da": "Jeg blandede pulveret i vand og drak det.",
        "de": "Ich habe das Pulver in Wasser gemischt und getrunken.",
        "el": "Ανακάτεψα τη σκόνη με νερό και την ήπια.",
        "es": "Mezclé el polvo con agua y me lo bebí.",
        "fi": "Sekoitin jauheen veteen ja join sen.",
        "fr": "J'ai mélangé la poudre avec de l'eau et je l'ai bue.",
        "he": "ערבבתי את האבקה במים ושתיתי.",
        "hi": "मैंने पाउडर को पानी में मिलाकर पी लिया।",
        "hu": "Vízbe kevertem a port, és megittam.",
        "id": "Saya mencampur bubuk itu ke dalam air lalu meminumnya.",
        "it": "Ho mescolato la polvere nell'acqua e l'ho bevuta.",
        "ja": "粉を水に混ぜて飲みました。",
        "nb": "Jeg blandet pulveret i vann og drakk det.",
        "nl": "Ik mengde het poeder met water en dronk het.",
        "pl": "Wymieszałem proszek z wodą i wypiłem.",
        "pt": "Misturei o pó na água e bebi.",
        "ro": "Am amestecat praful cu apă și l-am băut.",
        "ru": "Я размешал порошок в воде и выпил.",
        "sv": "Jag blandade pulvret i vatten och drack det.",
        "tr": "Tozu suya karıştırıp içtim.",
        "uk": "Я змішав порошок з водою і випив.",
        "vi": "Tôi trộn bột vào nước rồi uống.",
        "yue": "我將粉末攞落水度拌勻，然後飲咗。",
        "zh-Hans": "我把粉末放进水里搅拌后喝了。"
      },
