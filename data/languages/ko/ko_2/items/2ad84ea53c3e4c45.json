  "sentences": [
    {
      "target": "우리는 운동장에서 마주 앉았어요.",
      "reading": "urineun undongjang-eseo maju anjasseoyo.",
      "translations": {
        "en": "We sat facing each other in the playground.",
        "ko": "우리는 운동장에서 마주 앉았어요.",
        "ipa": "urineun undongjang-eseo maju anjasseoyo.",
        "ar": "جلسنا متقابلين في الملعب.",
        "cs": "Seděli jsme naproti sobě na hřišti.",
        "da": "Vi sad over for hinanden på legepladsen.",
        "de": "Wir saßen uns auf dem Spielplatz gegenüber.",
        "el": "Καθίσαμε ο ένας απέναντι στον άλλον στην παιδική χαρά.",
        "es": "Nos sentamos frente a frente en el patio de recreo.",
        "fi": "Istumme vastakkain leikkikentällä.",
        "fr": "Nous étions assis face à face dans la cour de récréation.",
        "he": "ישבנו זה מול זה במגרש המשחקים.",
        "hi": "हम खेल के मैदान में आमने-सामने बैठे।",
        "hu": "Az udvaron egymással szemben ültünk.",
        "id": "Kami duduk berhadapan di lapangan bermain.",
        "it": "Siamo seduti uno di fronte all'altro nel parco giochi.",
        "ja": "私たちは運動場で向かい合って座りました。",
        "nb": "Vi satt ansikt til ansikt på lekeplassen.",
        "nl": "We zaten tegenover elkaar op het speelplein.",
        "pl": "Siedzieliśmy naprzeciwko siebie na placu zabaw.",
        "pt": "Sentamo-nos frente a frente no pátio da escola.",
        "ro": "Ne-am așezat față în față în locul de joacă.",
        "ru": "Мы сели друг напротив друга на детской площадке.",
        "sv": "Vi satt mitt emot varandra på lekplatsen.",
        "tr": "Oyun alanında birbirimize dönük oturduk.",
        "uk": "Ми сиділи одне навпроти одного на дитячому майданчику.",
        "vi": "Chúng tôi ngồi đối diện nhau ở sân chơi.",
        "yue": "我哋喺遊樂場面對面坐咗。",
        "zh-Hans": "我们在操场上面对面坐着。"
      },
