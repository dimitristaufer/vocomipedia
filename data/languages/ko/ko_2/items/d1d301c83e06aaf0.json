  "sentences": [
    {
      "target": "점심때가 되면 식당이 정말 붐벼요.",
      "reading": "jeomsimttae-ga doemyeon sikdangi jeongmal bumbyeoyo.",
      "translations": {
        "en": "Around lunchtime, the restaurant gets really crowded.",
        "ko": "점심때가 되면 식당이 정말 붐벼요.",
        "ipa": "jeomsimttae-ga doemyeon sikdangi jeongmal bumbyeoyo.",
        "ar": "عندما يحين وقت الغداء، يمتلئ المطعم كثيرًا.",
        "cs": "Kolem oběda je v restauraci opravdu plno.",
        "da": "Ved frokosttid er restauranten virkelig fyldt.",
        "de": "Gegen Mittag ist das Restaurant richtig voll.",
        "el": "Προς το μεσημέρι το εστιατόριο έχει πολύ κόσμο.",
        "es": "A la hora del almuerzo, el restaurante se llena mucho.",
        "fi": "Lounasaikaan ravintolassa on todella paljon väkeä.",
        "fr": "À l'heure du déjeuner, le restaurant est vraiment bondé.",
        "he": "בשעת הצהריים המסעדה ממש עמוסה.",
        "hi": "दोपहर के समय रेस्टोरेंट बहुत भीड़भाड़ वाला हो जाता है।",
        "hu": "Ebédidőben az étterem nagyon zsúfolt.",
        "id": "Saat makan siang, restoran itu sangat ramai.",
        "it": "A pranzo il ristorante è davvero affollato.",
        "ja": "昼食時になると、そのレストランは本当に混みます。",
        "nb": "Ved lunsjtider blir restauranten veldig full.",
        "nl": "Rond lunchtijd is het restaurant heel druk.",
        "pl": "Około południa w restauracji jest naprawdę tłoczno.",
        "pt": "Na hora do almoço, o restaurante fica muito cheio.",
        "ro": "La prânz, restaurantul este foarte aglomerat.",
        "ru": "В обеденное время в ресторане очень много народу.",
        "sv": "Vid lunchtid är det väldigt mycket folk på restaurangen.",
        "tr": "Öğle vakti restoran çok kalabalık oluyor.",
        "uk": "Опівдні в ресторані дуже людно.",
        "vi": "Vào giờ ăn trưa, nhà hàng rất đông.",
        "yue": "到咗午飯時間，嗰間餐廳真係好多人。",
        "zh-Hans": "到了午饭时间，那家餐厅真的很拥挤。"
      },
