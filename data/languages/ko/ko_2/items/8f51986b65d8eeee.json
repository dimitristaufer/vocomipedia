  "sentences": [
    {
      "target": "레시피대로 분량을 맞춰 주세요.",
      "reading": "Resipi daero bunryangeul matchwo juseyo.",
      "translations": {
        "en": "Please measure the amount according to the recipe.",
        "ko": "레시피대로 분량을 맞춰 주세요.",
        "ipa": "Resipi daero bunryangeul matchwo juseyo.",
        "ar": "من فضلك اضبط الكمية حسب الوصفة.",
        "cs": "Prosím, odměřte množství podle receptu.",
        "da": "Mål mængden efter opskriften, tak.",
        "de": "Bitte messe die Menge nach dem Rezept ab.",
        "el": "Παρακαλώ μετρήστε την ποσότητα σύμφωνα με τη συνταγή.",
        "es": "Mide la cantidad según la receta, por favor.",
        "fi": "Mittaa määrä reseptin mukaan, ole hyvä.",
        "fr": "Veuillez mesurer la quantité selon la recette.",
        "he": "נא למדוד את הכמות לפי המתכון.",
        "hi": "कृपया रेसिपी के अनुसार मात्रा नापें।",
        "hu": "Kérlek, mérd ki az adagot a recept szerint.",
        "id": "Tolong takar ukurannya sesuai resep.",
        "it": "Misura la quantità secondo la ricetta, per favore.",
        "ja": "レシピどおりに分量を合わせてください。",
        "nb": "Mål opp mengden etter oppskriften.",
        "nl": "Meet de hoeveelheid volgens het recept.",
        "pl": "Odmierz ilość według przepisu.",
        "pt": "Meça a quantidade de acordo com a receita, por favor.",
        "ro": "Măsoară cantitatea conform rețetei, te rog.",
        "ru": "Пожалуйста, отмерьте количество по рецепту.",
        "sv": "Mät upp mängden enligt receptet, tack.",
        "tr": "Lütfen miktarı tarife göre ayarlayın.",
        "uk": "Будь ласка, відміряйте кількість за рецептом.",
        "vi": "Làm ơn đo lượng theo công thức.",
        "yue": "請跟住食譜去量好份量。",
        "zh-Hans": "请按照食谱把分量量好。"
      },
