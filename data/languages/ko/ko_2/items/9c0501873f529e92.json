  "sentences": [
    {
      "target": "그 설명은 아직 이론적이에요.",
      "reading": "geu seolmyeongeun ajik ironjeogieyo.",
      "translations": {
        "en": "That explanation is still theoretical.",
        "ko": "그 설명은 아직 이론적이에요.",
        "ipa": "geu seolmyeongeun ajik ironjeogieyo.",
        "ar": "هذا الشرح ما زال نظريًا.",
        "cs": "To vysvětlení je zatím jen teoretické.",
        "da": "Forklaringen er stadig teoretisk.",
        "de": "Die Erklärung ist noch theoretisch.",
        "el": "Η εξήγηση αυτή είναι ακόμα θεωρητική.",
        "es": "Esa explicación todavía es teórica.",
        "fi": "Tuo selitys on vielä teoreettinen.",
        "fr": "Cette explication est encore théorique.",
        "he": "ההסבר הזה עדיין תיאורטי.",
        "hi": "यह व्याख्या अभी भी सैद्धांतिक है।",
        "hu": "Ez a magyarázat még elméleti.",
        "id": "Penjelasan itu masih bersifat teoritis.",
        "it": "Questa spiegazione è ancora teorica.",
        "ja": "その説明はまだ理論的です。",
        "nb": "Den forklaringen er fortsatt teoretisk.",
        "nl": "Die uitleg is nog theoretisch.",
        "pl": "To wyjaśnienie jest jeszcze teoretyczne.",
        "pt": "Essa explicação ainda é teórica.",
        "ro": "Explicația asta este încă teoretică.",
        "ru": "Это объяснение пока теоретическое.",
        "sv": "Den förklaringen är fortfarande teoretisk.",
        "tr": "Bu açıklama hâlâ teorik.",
        "uk": "Це пояснення поки що теоретичне.",
        "vi": "Lời giải thích đó vẫn còn mang tính lý thuyết.",
        "yue": "呢個解釋仲係理論上嘅。",
        "zh-Hans": "这个解释还是理论上的。"
      },
