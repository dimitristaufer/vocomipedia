  "sentences": [
    {
      "target": "비가 멎고, 이윽고 해가 떴어요.",
      "reading": "Biga meotgo, ieukgo haega tteosseoyo.",
      "translations": {
        "en": "The rain stopped, and after a while the sun came out.",
        "ko": "비가 멎고, 이윽고 해가 떴어요.",
        "ipa": "Biga meotgo, ieukgo haega tteosseoyo.",
        "ar": "توقّف المطر، وبعد قليل أشرقت الشمس.",
        "cs": "Přestal déšť a po chvíli vykouklo slunce.",
        "da": "Regnen stoppede, og efter et stykke tid kom solen frem.",
        "de": "Der Regen hörte auf, und nach einer Weile kam die Sonne heraus.",
        "el": "Η βροχή σταμάτησε και ύστερα από λίγο βγήκε ο ήλιος.",
        "es": "La lluvia paró y, al poco, salió el sol.",
        "fi": "Sade lakkasi, ja hetken kuluttua aurinko tuli esiin.",
        "fr": "La pluie s'est arrêtée, puis le soleil est sorti peu après.",
        "he": "הגשם פסק, ואחרי זמן קצר השמש יצאה.",
        "hi": "बारिश रुक गई, और थोड़ी देर बाद धूप निकल आई।",
        "hu": "Elállt az eső, és egy idő múlva kisütött a nap.",
        "id": "Hujan berhenti, lalu tak lama kemudian matahari muncul.",
        "it": "La pioggia è cessata e poco dopo è uscito il sole.",
        "ja": "雨がやんで、やがて日が差しました。",
        "nb": "Regnet stanset, og etter en stund kom solen frem.",
        "nl": "De regen stopte en even later kwam de zon tevoorschijn.",
        "pl": "Deszcz ustał i po chwili wyszło słońce.",
        "pt": "A chuva parou e, pouco depois, o sol apareceu.",
        "ro": "Ploaia s-a oprit, iar după un timp a ieșit soarele.",
        "ru": "Дождь прекратился, и вскоре вышло солнце.",
        "sv": "Regnet upphörde, och efter en stund kom solen fram.",
        "tr": "Yağmur dindi ve biraz sonra güneş açtı.",
        "uk": "Дощ припинився, і невдовзі вийшло сонце.",
        "vi": "Mưa ngớt, rồi một lúc sau mặt trời ló ra.",
        "yue": "雨停咗，過咗一陣太陽就出嚟喇。",
        "zh-Hans": "雨停了，过了一会儿太阳出来了。"
      },
