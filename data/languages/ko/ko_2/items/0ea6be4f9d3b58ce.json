    {
      "target": "주말에 목욕탕에 갔어요.",
      "reading": "jumare mogyoktange gasseoyo.",
      "translations": {
        "en": "I went to the bathhouse on the weekend.",
        "ko": "주말에 목욕탕에 갔어요.",
        "ipa": "jumare mogyoktange gasseoyo.",
        "ar": "ذهبتُ إلى الحمام في عطلة نهاية الأسبوع.",
        "cs": "O víkendu jsem šel do lázní.",
        "da": "Jeg tog i badehuset i weekenden.",
        "de": "Ich bin am Wochenende ins Badehaus gegangen.",
        "el": "Πήγα στο λουτρό το Σαββατοκύριακο.",
        "es": "Fui al baño público el fin de semana.",
        "fi": "Kävin kylpylässä viikonloppuna.",
        "fr": "Je suis allé aux bains publics le week-end.",
        "he": "הלכתי לבית המרחץ בסוף השבוע.",
        "hi": "मैं वीकेंड पर स्नानघर गया।",
        "hu": "Hétvégén elmentem a fürdőbe.",
        "id": "Saya pergi ke pemandian umum pada akhir pekan.",
        "it": "Sono andato allo stabilimento balneare nel fine settimana.",
        "ja": "週末に銭湯に行きました。",
        "nb": "Jeg gikk til badstuen i helgen.",
        "nl": "Ik ging in het weekend naar het badhuis.",
        "pl": "Poszedłem w weekend do łaźni.",
        "pt": "Fui ao banho público no fim de semana.",
        "ro": "Am mers la baie în weekend.",
        "ru": "Я ходил в баню на выходных.",
        "sv": "Jag gick till badhuset i helgen.",
        "tr": "Hafta sonu hamama gittim.",
        "uk": "Я ходив у лазню на вихідних.",
        "vi": "Tôi đã đi đến nhà tắm công cộng vào cuối tuần.",
        "yue": "我週末去咗浴堂。",
        "zh-Hans": "我周末去了澡堂。"
      },
