  "sentences": [
    {
      "target": "집 앞에 은행나무가 있어요.",
      "reading": "jip ape eunhaengnamuga isseoyo.",
      "translations": {
        "en": "There is a ginkgo tree in front of my house.",
        "ko": "집 앞에 은행나무가 있어요.",
        "ipa": "jip ape eunhaengnamuga isseoyo.",
        "ar": "يوجد شجرة جنكو أمام منزلي.",
        "cs": "Před mým domem je jinan.",
        "da": "Der står et ginkgotræ foran mit hus.",
        "de": "Vor meinem Haus steht ein Ginkgobaum.",
        "el": "Υπάρχει ένα δέντρο γκίνγκο μπροστά από το σπίτι μου.",
        "es": "Hay un ginkgo delante de mi casa.",
        "fi": "Taloni edessä on neidonhiuspuu.",
        "fr": "Il y a un ginkgo devant ma maison.",
        "he": "יש עץ גינקו מול הבית שלי.",
        "hi": "मेरे घर के सामने एक जिन्को का पेड़ है।",
        "hu": "Van egy páfrányfenyő a házam előtt.",
        "id": "Ada pohon ginkgo di depan rumah saya.",
        "it": "C'è un ginkgo davanti a casa mia.",
        "ja": "家の前にイチョウの木があります。",
        "nb": "Det står et ginkgotre foran huset mitt.",
        "nl": "Er staat een ginkgo voor mijn huis.",
        "pl": "Przed moim domem rośnie miłorząb.",
        "pt": "Há uma árvore de ginkgo em frente à minha casa.",
        "ro": "Este un ginkgo în fața casei mele.",
        "ru": "Перед моим домом растёт гинкго.",
        "sv": "Det står ett ginkgoträd framför mitt hus.",
        "tr": "Evimin önünde bir ginkgo ağacı var.",
        "uk": "Перед моїм будинком росте гінкго.",
        "vi": "Có một cây bạch quả trước nhà tôi.",
        "yue": "我屋企前面有棵銀杏樹。",
        "zh-Hans": "我家前面有一棵银杏树。"
      },
