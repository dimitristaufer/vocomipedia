  "sentences": [
    {
      "target": "‘찌다’는 김으로 음식을 익히는 뜻이에요.",
      "reading": "'jjida' neun gimeuro eumsigeul ikhineun tteusieyo.",
      "translations": {
        "en": "“찌다” means to cook food with steam.",
        "ko": "‘찌다’는 김으로 음식을 익히는 뜻이에요.",
        "ipa": "'jjida' neun gimeuro eumsigeul ikhineun tteusieyo.",
        "ar": "تعني كلمة \"찌다\" طهي الطعام بالبخار.",
        "cs": "Sloveso znamená vařit jídlo v páře.",
        "da": "betyder at tilberede mad med damp.",
        "de": "bedeutet, Essen mit Dampf zu garen.",
        "el": "Το «찌다» σημαίνει να μαγειρεύεις το φαγητό στον ατμό.",
        "es": "significa cocinar la comida al vapor.",
        "fi": "tarkoittaa ruoan kypsentämistä höyryssä.",
        "fr": "signifie cuire les aliments à la vapeur.",
        "he": "הפועל \"찌다\" פירושו לבשל אוכל באדים.",
        "hi": "\"찌다\" का मतलब है खाने को भाप में पकाना।",
        "hu": "azt jelenti, hogy az ételt gőzben főzzük.",
        "id": "berarti memasak makanan dengan uap.",
        "it": "significa cuocere il cibo al vapore.",
        "ja": "「찌다」は、食べ物を蒸して火を通すという意味です。",
        "nb": "betyr å tilberede mat med damp.",
        "nl": "betekent eten met stoom gaar maken.",
        "pl": "oznacza gotować jedzenie na parze.",
        "pt": "significa cozinhar alimentos no vapor.",
        "ro": "înseamnă să gătești mâncarea la abur.",
        "ru": "«찌다» означает готовить еду на пару.",
        "sv": "betyder att tillaga mat med ånga.",
        "tr": "yiyeceği buharda pişirmek demektir.",
        "uk": "«찌다» означає готувати їжу на парі.",
        "vi": "có nghĩa là làm chín thức ăn bằng hơi nước.",
        "yue": "「찌다」係用蒸氣去整熟食物嘅意思。",
        "zh-Hans": "“찌다”是用蒸汽把食物煮熟的意思。"
      },
