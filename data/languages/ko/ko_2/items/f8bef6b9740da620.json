  "sentences": [
    {
      "target": "그 영화에는 흑인 배우가 나와요.",
      "reading": "geu yeonghwaneun heugin baewuga naywayo.",
      "translations": {
        "en": "That movie has a Black actor in it.",
        "ko": "그 영화에는 흑인 배우가 나와요.",
        "ipa": "geu yeonghwaneun heugin baewuga naywayo.",
        "ar": "يوجد ممثل أسود في ذلك الفيلم.",
        "cs": "V tom filmu hraje černošský herec.",
        "da": "Der er en sort skuespiller i den film.",
        "de": "In dem Film spielt ein schwarzer Schauspieler mit.",
        "el": "Σε εκείνη την ταινία παίζει ένας μαύρος ηθοποιός.",
        "es": "En esa película sale un actor negro.",
        "fi": "Siinä elokuvassa on musta näyttelijä.",
        "fr": "Il y a un acteur noir dans ce film.",
        "he": "יש בסרט הזה שחקן שחור.",
        "hi": "उस फिल्म में एक अश्वेत अभिनेता है।",
        "hu": "Abban a filmben egy fekete színész szerepel.",
        "id": "Ada aktor kulit hitam di film itu.",
        "it": "In quel film c’è un attore nero.",
        "ja": "あの映画には黒人の俳優が出ています。",
        "nb": "Det er en svart skuespiller i den filmen.",
        "nl": "In die film speelt een zwarte acteur mee.",
        "pl": "W tym filmie występuje czarnoskóry aktor.",
        "pt": "Nesse filme há um ator negro.",
        "ro": "În filmul acela apare un actor de culoare.",
        "ru": "В том фильме снимается чернокожий актёр.",
        "sv": "Det finns en svart skådespelare i den filmen.",
        "tr": "O filmde siyah bir oyuncu var.",
        "uk": "У тому фільмі грає темношкірий актор.",
        "vi": "Trong bộ phim đó có một diễn viên da đen.",
        "yue": "嗰套戲入面有一個黑人演員。",
        "zh-Hans": "那部电影里有一位黑人演员。"
      },
