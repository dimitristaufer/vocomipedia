    {
      "target": "흑인 친구가 한국말을 잘해요.",
      "reading": "heugin chinguga hangungmareul jalhaeyo.",
      "translations": {
        "en": "My Black friend speaks Korean well.",
        "ko": "흑인 친구가 한국말을 잘해요.",
        "ipa": "heugin chinguga hangungmareul jalhaeyo.",
        "ar": "صديقي الأسود يتكلم الكورية جيدًا.",
        "cs": "Můj černošský kamarád mluví korejsky dobře.",
        "da": "Min sorte ven taler godt koreansk.",
        "de": "Mein schwarzer Freund spricht gut Koreanisch.",
        "el": "Ο μαύρος φίλος μου μιλάει καλά κορεατικά.",
        "es": "Mi amigo negro habla coreano muy bien.",
        "fi": "Musta ystäväni puhuu koreaa hyvin.",
        "fr": "Mon ami noir parle bien coréen.",
        "he": "החבר השחור שלי מדבר קוריאנית טוב.",
        "hi": "मेरा अश्वेत दोस्त कोरियाई अच्छी तरह बोलता है।",
        "hu": "Az én fekete barátom jól beszél koreaiul.",
        "id": "Teman kulit hitam saya bisa berbahasa Korea dengan baik.",
        "it": "Il mio amico nero parla bene coreano.",
        "ja": "黒人の友だちは韓国語が上手です。",
        "nb": "Min svarte venn snakker koreansk godt.",
        "nl": "Mijn zwarte vriend spreekt goed Koreaans.",
        "pl": "Mój czarnoskóry przyjaciel dobrze mówi po koreańsku.",
        "pt": "Meu amigo negro fala coreano bem.",
        "ro": "Prietenul meu de culoare vorbește bine coreeană.",
        "ru": "Мой чернокожий друг хорошо говорит по-корейски.",
        "sv": "Min svarta vän pratar bra koreanska.",
        "tr": "Siyah arkadaşım Koreceyi iyi konuşur.",
        "uk": "Мій темношкірий друг добре говорить корейською.",
        "vi": "Người bạn da đen của tôi nói tiếng Hàn rất giỏi.",
        "yue": "我個黑人朋友韓文講得好好。",
        "zh-Hans": "我的黑人朋友韩语说得很好。"
      },
