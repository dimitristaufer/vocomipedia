  "sentences": [
    {
      "target": "번호를 실수해서 다시 물어봤어요.",
      "reading": "beonhoreul silsuhaeseo dasi muoreobwasseoyo.",
      "translations": {
        "en": "I made a mistake with the number, so I asked again.",
        "ko": "번호를 실수해서 다시 물어봤어요.",
        "ipa": "beonhoreul silsuhaeseo dasi muoreobwasseoyo.",
        "ar": "أخطأت في الرقم، فسألت مرة أخرى.",
        "cs": "Mýlil jsem se v čísle, tak jsem se zeptal znovu.",
        "da": "Jeg tog fejl af nummeret, så jeg spurgte igen.",
        "de": "Ich habe mich bei der Nummer vertan, also habe ich nochmal nachgefragt.",
        "el": "Έκανα λάθος με τον αριθμό, οπότε ρώτησα ξανά.",
        "es": "Me equivoqué con el número, así que pregunté otra vez.",
        "fi": "Menin numerossa sekaisin, joten kysyin uudelleen.",
        "fr": "Je me suis trompé de numéro, alors j'ai redemandé.",
        "he": "טעיתי במספר, אז שאלתי שוב.",
        "hi": "मैंने नंबर गलत लिया, इसलिए मैंने फिर से पूछा।",
        "hu": "Eltévesztettem a számot, ezért újra megkérdeztem.",
        "id": "Saya salah nomor, jadi saya bertanya lagi.",
        "it": "Ho sbagliato numero, così ho chiesto di nuovo.",
        "ja": "番号を間違えたので、もう一度聞きました。",
        "nb": "Jeg tok feil av nummeret, så jeg spurte en gang til.",
        "nl": "Ik had het nummer verkeerd, dus ik vroeg het nog een keer.",
        "pl": "Pomyliłem numer, więc zapytałem jeszcze raz.",
        "pt": "Eu errei o número, então perguntei de novo.",
        "ro": "Am greșit numărul, așa că am întrebat din nou.",
        "ru": "Я ошибся с номером, поэтому спросил ещё раз.",
        "sv": "Jag tog fel på numret, så jag frågade igen.",
        "tr": "Numarayı yanlış söyledim, bu yüzden tekrar sordum.",
        "uk": "Я помилився з номером, тому перепитав.",
        "vi": "Tôi nhầm số nên hỏi lại.",
        "yue": "我搞錯咗個號碼，所以再問咗一次。",
        "zh-Hans": "我把号码弄错了，所以又问了一次。"
      },
