    {
      "target": "할아버지는 희망을 잃지 않았어요.",
      "reading": "harabeojineun huimangeul ilji anasseoyo.",
      "translations": {
        "en": "Grandfather didn't lose hope.",
        "ko": "할아버지는 희망을 잃지 않았어요.",
        "ipa": "harabeojineun huimangeul ilji anasseoyo.",
        "ar": "الجد لم يفقد الأمل.",
        "cs": "Dědeček neztratil naději.",
        "da": "Bedstefar mistede ikke håbet.",
        "de": "Der Großvater hat die Hoffnung nicht verloren.",
        "el": "Ο παππούς δεν έχασε την ελπίδα του.",
        "es": "El abuelo no perdió la esperanza.",
        "fi": "Isoisä ei menettänyt toivoaan.",
        "fr": "Grand-père n'a pas perdu espoir.",
        "he": "סבא לא איבד תקווה.",
        "hi": "दादाजी ने उम्मीद नहीं खोई।",
        "hu": "A nagypapa nem veszítette el a reményt.",
        "id": "Kakek tidak kehilangan harapan.",
        "it": "Il nonno non ha perso la speranza.",
        "ja": "おじいさんは希望を失いませんでした。",
        "nb": "Bestefar mistet ikke håpet.",
        "nl": "Opa verloor de hoop niet.",
        "pl": "Dziadek nie stracił nadziei.",
        "pt": "O avô não perdeu a esperança.",
        "ro": "Bunicul nu și-a pierdut speranța.",
        "ru": "Дедушка не терял надежды.",
        "sv": "Farfar förlorade inte hoppet.",
        "tr": "Dede umudunu kaybetmedi.",
        "uk": "Дідусь не втрачав надії.",
        "vi": "Ông tôi không mất hy vọng.",
        "yue": "公公冇失去希望。",
        "zh-Hans": "爷爷没有失去希望。"
