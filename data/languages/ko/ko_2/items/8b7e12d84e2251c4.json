    {
      "target": "멀리서 불빛이 반짝였어요.",
      "reading": "meolliseo bulbiti banjjakyeosseoyo.",
      "translations": {
        "en": "A light sparkled in the distance.",
        "ko": "멀리서 불빛이 반짝였어요.",
        "ipa": "meolliseo bulbiti banjjakyeosseoyo.",
        "ar": "تلألأ ضوء من بعيد.",
        "cs": "V dálce se zalesklo světlo.",
        "da": "Et lys blinkede i det fjerne.",
        "de": "In der Ferne blitzte ein Licht auf.",
        "el": "Ένα φως λαμπύρισε μακριά.",
        "es": "Una luz brilló a lo lejos.",
        "fi": "Valo välähti kaukana.",
        "fr": "Une lumière a scintillé au loin.",
        "he": "אור נצנץ מרחוק.",
        "hi": "दूर से एक रोशनी चमकी।",
        "hu": "Egy fény felvillant a távolban.",
        "id": "Sebuah cahaya berkilat di kejauhan.",
        "it": "Una luce ha brillato in lontananza.",
        "ja": "遠くで光がきらめきました。",
        "nb": "Et lys glitret i det fjerne.",
        "nl": "In de verte schitterde een licht.",
        "pl": "W oddali zamigotało światło.",
        "pt": "Uma luz brilhou ao longe.",
        "ro": "O lumină a sclipit în depărtare.",
        "ru": "Вдали замерцал огонёк.",
        "sv": "Ett ljus glimmade i fjärran.",
        "tr": "Uzakta bir ışık parladı.",
        "uk": "Удалині спалахнуло світло.",
        "vi": "Một ánh sáng lấp lánh ở phía xa.",
        "yue": "遠處有道光閃爍。",
        "zh-Hans": "远处有一道光闪烁。"
