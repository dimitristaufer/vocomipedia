  "sentences": [
    {
      "target": "어머니가 선물을 보자기에 싸셨어요.",
      "reading": "eomeoniga seonmureul bojagie ssasyeosseoyo.",
      "translations": {
        "en": "My mother wrapped the gift in a bojagi.",
        "ko": "어머니가 선물을 보자기에 싸셨어요.",
        "ipa": "eomeoniga seonmureul bojagie ssasyeosseoyo.",
        "ar": "لفّت أمي الهدية ببوزاجي.",
        "cs": "Maminka zabalila dárek do bojagi.",
        "da": "Min mor pakkede gaven ind i en bojagi.",
        "de": "Meine Mutter hat das Geschenk in ein bojagi gewickelt.",
        "el": "Η μαμά μου τύλιξε το δώρο σε ένα μποτζάγκι.",
        "es": "Mi madre envolvió el regalo en un bojagi.",
        "fi": "Äitini kääri lahjan bojagiin.",
        "fr": "Ma mère a enveloppé le cadeau dans un bojagi.",
        "he": "אמא שלי עטפה את המתנה בבוזאגי.",
        "hi": "मेरी माँ ने उपहार को बोजागी में लपेटा।",
        "hu": "Anyukám bojagiba csomagolta az ajándékot.",
        "id": "Ibu membungkus hadiah itu dengan bojagi.",
        "it": "Mia madre ha avvolto il regalo in un bojagi.",
        "ja": "母はプレゼントをボジャギで包みました。",
        "nb": "Moren min pakket inn gaven i en bojagi.",
        "nl": "Mijn moeder wikkelde het cadeau in een bojagi.",
        "pl": "Mama zawinęła prezent w bojagi.",
        "pt": "Minha mãe embrulhou o presente em um bojagi.",
        "ro": "Mama a împachetat cadoul într-un bojagi.",
        "ru": "Мама завернула подарок в бочаги.",
        "sv": "Mamma slog in presenten i en bojagi.",
        "tr": "Annem hediyeyi bir bojagiye sardı.",
        "uk": "Мама загорнула подарунок у бочагі.",
        "vi": "Mẹ tôi gói quà bằng bojagi.",
        "yue": "媽媽用包袱布包咗份禮物。",
        "zh-Hans": "妈妈用包袱布包了礼物。"
      },
