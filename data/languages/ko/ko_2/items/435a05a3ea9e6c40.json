  "sentences": [
    {
      "target": "저는 아직 연애 경험이 없어요.",
      "reading": "jeoneun ajik yeonae gyeongheomi eopseoyo.",
      "translations": {
        "en": "I don't have any dating experience yet.",
        "ko": "저는 아직 연애 경험이 없어요.",
        "ipa": "jeoneun ajik yeonae gyeongheomi eopseoyo.",
        "ar": "ليس لدي أي خبرة في المواعدة بعد.",
        "cs": "Ještě nemám žádné zkušenosti s randěním.",
        "da": "Jeg har ikke nogen erfaring med at date endnu.",
        "de": "Ich habe noch keine Dating-Erfahrung.",
        "el": "Δεν έχω ακόμα καθόλου εμπειρία στα ραντεβού.",
        "es": "Todavía no tengo experiencia saliendo con alguien.",
        "fi": "Minulla ei ole vielä lainkaan seurustelukokemusta.",
        "fr": "Je n'ai pas encore d'expérience en matière de rendez-vous.",
        "he": "עדיין אין לי שום ניסיון בדייטים.",
        "hi": "मुझे अभी तक डेटिंग का कोई अनुभव नहीं है।",
        "hu": "Még nincs semmi randizási tapasztalatom.",
        "id": "Saya belum punya pengalaman pacaran.",
        "it": "Non ho ancora esperienza con gli appuntamenti.",
        "ja": "私はまだ恋愛経験がありません。",
        "nb": "Jeg har ikke noe dating-erfaring ennå.",
        "nl": "Ik heb nog geen ervaring met daten.",
        "pl": "Nie mam jeszcze żadnego doświadczenia w randkowaniu.",
        "pt": "Ainda não tenho nenhuma experiência com namoro.",
        "ro": "Nu am încă deloc experiență în relații.",
        "ru": "У меня ещё нет опыта в отношениях.",
        "sv": "Jag har ingen dejtingerfarenhet än.",
        "tr": "Henüz hiç flört deneyimim yok.",
        "uk": "У мене ще немає досвіду в стосунках.",
        "vi": "Tôi vẫn chưa có kinh nghiệm hẹn hò.",
        "yue": "我而家仲未有拍拖經驗。",
        "zh-Hans": "我还没有恋爱经验。"
      },
