    {
      "target": "두 사람은 비밀 연애를 시작했어요.",
      "reading": "du sarameun bimil yeonaereul sijakaesseoyo.",
      "translations": {
        "en": "The two started dating in secret.",
        "ko": "두 사람은 비밀 연애를 시작했어요.",
        "ipa": "du sarameun bimil yeonaereul sijakaesseoyo.",
        "ar": "بدأ الاثنان علاقة سرية.",
        "cs": "Ti dva začali tajný vztah.",
        "da": "De to begyndte at gå i hemmelighed.",
        "de": "Die beiden haben heimlich angefangen, sich zu treffen.",
        "el": "Οι δύο τους άρχισαν να βγαίνουν κρυφά.",
        "es": "Los dos empezaron a salir en secreto.",
        "fi": "Nuo kaksi alkoivat seurustella salaa.",
        "fr": "Ils ont commencé à sortir ensemble en secret.",
        "he": "השניים התחילו לצאת בסתר.",
        "hi": "दोनों ने छिपकर डेट करना शुरू किया।",
        "hu": "A két ember titokban kezdett el járni.",
        "id": "Mereka berdua mulai berpacaran secara diam-diam.",
        "it": "I due hanno iniziato a frequentarsi di nascosto.",
        "ja": "二人は秘密の交際を始めました。",
        "nb": "De to begynte å date i hemmelighet.",
        "nl": "Die twee zijn in het geheim gaan daten.",
        "pl": "Ci dwoje zaczęli się potajemnie spotykać.",
        "pt": "Os dois começaram a namorar em segredo.",
        "ro": "Cei doi au început să se întâlnească în secret.",
        "ru": "Они начали тайно встречаться.",
        "sv": "De två började dejta i hemlighet.",
        "tr": "İkisi gizlice çıkmaya başladı.",
        "uk": "Вони почали таємно зустрічатися.",
        "vi": "Hai người đã bắt đầu hẹn hò bí mật.",
        "yue": "兩個人開始咗秘密拍拖。",
        "zh-Hans": "两个人开始了秘密恋爱。"
      },
