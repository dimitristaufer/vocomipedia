    {
      "target": "그 배우는 멋이 있어요.",
      "reading": "geu baeuneun meosi isseoyo.",
      "translations": {
        "en": "That actor has style.",
        "ko": "그 배우는 멋이 있어요.",
        "ipa": "geu baeuneun meosi isseoyo.",
        "ar": "ذلك الممثل أنيق.",
        "cs": "Ten herec má styl.",
        "da": "Den skuespiller har stil.",
