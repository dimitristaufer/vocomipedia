    {
      "target": "계획이 갑자기 바뀌었어요.",
      "reading": "gyehoegi gapjagi bakkwieosseoyo.",
      "translations": {
        "en": "The plans suddenly changed.",
        "ko": "계획이 갑자기 바뀌었어요.",
        "ipa": "gyehoegi gapjagi bakkwieosseoyo.",
        "ar": "تغيّرت الخطط فجأة.",
        "cs": "Plány se najednou změnily.",
        "da": "Planerne ændrede sig pludseligt.",
        "de": "Die Pläne haben sich plötzlich geändert.",
        "el": "Τα σχέδια άλλαξαν ξαφνικά.",
        "es": "Los planes cambiaron de repente.",
        "fi": "Suunnitelmat muuttuivat yhtäkkiä.",
        "fr": "Les plans ont changé soudainement.",
        "he": "התוכניות השתנו פתאום.",
        "hi": "योजनाएँ अचानक बदल गईं।",
        "hu": "A tervek hirtelen megváltoztak.",
        "id": "Rencananya tiba-tiba berubah.",
        "it": "I piani sono cambiati all'improvviso.",
        "ja": "予定が急に変わりました。",
        "nb": "Planene endret seg plutselig.",
        "nl": "De plannen veranderden ineens.",
        "pl": "Plany nagle się zmieniły.",
        "pt": "Os planos mudaram de repente.",
        "ro": "Planurile s-au schimbat brusc.",
        "ru": "Планы внезапно изменились.",
        "sv": "Planerna ändrades plötsligt.",
        "tr": "Planlar birden değişti.",
        "uk": "Плани раптово змінилися.",
        "vi": "Kế hoạch đã thay đổi đột ngột.",
        "yue": "計劃突然變咗。",
        "zh-Hans": "计划突然变了。"
      },
