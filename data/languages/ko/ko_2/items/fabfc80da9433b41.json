  "sentences": [
    {
      "target": "우리 동네 다방은 아직도 조용해요.",
      "reading": "uri dongne dabang-eun ajikdo joyonghaeyo.",
      "translations": {
        "en": "The tea room in our neighborhood is still quiet.",
        "ko": "우리 동네 다방은 아직도 조용해요.",
        "ipa": "uri dongne dabang-eun ajikdo joyonghaeyo.",
        "ar": "المقهى في حيّنا لا يزال هادئًا.",
        "cs": "Čajovna v naší čtvrti je pořád klidná.",
        "da": "Tehuset i vores kvarter er stadig stille.",
        "de": "Das Teehaus in unserer Nachbarschaft ist immer noch ruhig.",
        "el": "Το τσαγκαράδικο στη γειτονιά μας είναι ακόμα ήσυχο.",
        "es": "La tetería de nuestro barrio sigue tranquila.",
        "fi": "Naapurustomme teehuone on vieläkin rauhallinen.",
        "fr": "Le salon de thé de notre quartier est encore calme.",
        "he": "בית התה בשכונה שלנו עדיין שקט.",
        "hi": "हमारे मोहल्ले का चायघर अभी भी शांत है।",
        "hu": "A mi környékünkön a teaház még mindig csendes.",
        "id": "Rumah teh di lingkungan kami masih sepi.",
        "it": "La sala da tè nel nostro quartiere è ancora tranquilla.",
        "ja": "うちの近所の喫茶店は、まだ静かです。",
        "nb": "Tehuset i nabolaget vårt er fortsatt stille.",
        "nl": "Het theehuis in onze buurt is nog steeds rustig.",
        "pl": "Herbaciarnia w naszej okolicy nadal jest spokojna.",
        "pt": "A casa de chá no nosso bairro ainda está tranquila.",
        "ro": "Ceainăria din cartierul nostru este încă liniștită.",
        "ru": "Чайная в нашем районе все еще тихая.",
        "sv": "Tehuset i vårt kvarter är fortfarande lugnt.",
        "tr": "Mahallemizdeki çay evi hâlâ sakin.",
        "uk": "Чайна в нашому районі все ще тиха.",
        "vi": "Quán trà ở khu nhà tôi vẫn còn yên tĩnh.",
        "yue": "我哋屋企附近嗰間茶室仲係好靜。",
        "zh-Hans": "我们附近的茶室还是很安静。"
      },
