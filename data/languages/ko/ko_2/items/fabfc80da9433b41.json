    {
      "target": "엄마는 친구를 다방에서 만났어요.",
      "reading": "eommaneun chingureul dabangeseo mannasseoyo.",
      "translations": {
        "en": "Mom met a friend at the tea room.",
        "ko": "엄마는 친구를 다방에서 만났어요.",
        "ipa": "eommaneun chingureul dabangeseo mannasseoyo.",
        "ar": "قابلت أمي صديقةً في المقهى.",
        "cs": "Máma se setkala s kamarádkou v čajovně.",
        "da": "Mor mødte en veninde i tehuset.",
        "de": "Mama hat sich in einem Teehaus mit einer Freundin getroffen.",
        "el": "Η μαμά συνάντησε μια φίλη στο τσαγκαράδικο.",
        "es": "Mamá se encontró con una amiga en la tetería.",
        "fi": "Äiti tapasi ystävän teehuoneessa.",
        "fr": "Maman a rencontré une amie au salon de thé.",
        "he": "אמא פגשה חברה בבית התה.",
        "hi": "माँ ने एक दोस्त से चायघर में मुलाकात की।",
        "hu": "Anya egy barátnőjével találkozott a teaházban.",
        "id": "Ibu bertemu seorang teman di rumah teh.",
        "it": "Mamma ha incontrato un'amica in sala da tè.",
        "ja": "母は喫茶店で友だちに会いました。",
        "nb": "Mamma møtte en venninne på tehuset.",
        "nl": "Mama ontmoette een vriendin in het theehuis.",
        "pl": "Mama spotkała się z koleżanką w herbaciarni.",
        "pt": "A mãe encontrou uma amiga na casa de chá.",
        "ro": "Mama s-a întâlnit cu o prietenă la ceainărie.",
        "ru": "Мама встретилась с подругой в чайной.",
        "sv": "Mamma träffade en vän i tehuset.",
        "tr": "Annem bir arkadaşıyla çay evinde buluştu.",
        "uk": "Мама зустріла подругу в чайній.",
        "vi": "Mẹ đã gặp một người bạn ở quán trà.",
        "yue": "媽媽喺茶室見咗個朋友。",
        "zh-Hans": "妈妈在茶室见了一个朋友。"
      },
