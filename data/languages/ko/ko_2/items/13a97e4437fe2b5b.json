    {
      "target": "할머니가 실로 단추를 달았어요.",
      "reading": "halmeoniga sillo danchureul darasseoyo.",
      "translations": {
        "en": "Grandma sewed the button on with thread.",
        "ko": "할머니가 실로 단추를 달았어요.",
        "ipa": "halmeoniga sillo danchureul darasseoyo.",
        "ar": "خيطت الجدة الزر بالخيط.",
        "cs": "Babička přišila knoflík nití.",
        "da": "Bedstemor syede knappen fast med tråd.",
        "de": "Oma hat den Knopf mit Faden angenäht.",
        "el": "Η γιαγιά έραψε το κουμπί με κλωστή.",
        "es": "La abuela cosió el botón con hilo.",
        "fi": "Mummo ompeli napin kiinni langalla.",
        "fr": "Ma grand-mère a cousu le bouton avec du fil.",
        "he": "סבתא תפרה את הכפתור בחוט.",
        "hi": "दादी ने धागे से बटन टाँका।",
        "hu": "A nagyi cérnával varrta fel a gombot.",
        "id": "Nenek menjahit kancing itu dengan benang.",
        "it": "La nonna ha cucito il bottone con il filo.",
        "ja": "おばあさんが糸でボタンを付けました。",
        "nb": "Bestemor sydde på knappen med tråd.",
        "nl": "Oma heeft de knoop vastgenaaid met draad.",
        "pl": "Babcia przyszyła guzik nitką.",
        "pt": "A vovó pregou o botão com linha.",
        "ro": "Bunica a cusut nasturele cu ață.",
        "ru": "Бабушка пришила пуговицу ниткой.",
        "sv": "Mormor sydde fast knappen med tråd.",
        "tr": "Büyükanne düğmeyi iplikle dikti.",
        "uk": "Бабуся пришила ґудзик ниткою.",
        "vi": "Bà tôi đã khâu nút áo bằng chỉ.",
        "yue": "婆婆用線縫咗粒鈕。",
        "zh-Hans": "奶奶用线把扣子缝上了。"
