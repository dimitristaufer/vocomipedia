  "sentences": [
    {
      "target": "저는 실을 사러 문구점에 갔어요.",
      "reading": "jeoneun sireul sareo mungujeome gasseoyo.",
      "translations": {
        "en": "I went to the stationery store to buy thread.",
        "ko": "저는 실을 사러 문구점에 갔어요.",
        "ipa": "jeoneun sireul sareo mungujeome gasseoyo.",
        "ar": "ذهبت إلى متجر الأدوات المكتبية لأشتري خيطًا.",
        "cs": "Šel jsem koupit nit do papírnictví.",
        "da": "Jeg gik i papirhandlen for at købe tråd.",
        "de": "Ich bin in den Schreibwarenladen gegangen, um Faden zu kaufen.",
        "el": "Πήγα στο χαρτοπωλείο για να αγοράσω κλωστή.",
        "es": "Fui a la papelería a comprar hilo.",
        "fi": "Kävin paperikaupassa ostamassa lankaa.",
        "fr": "Je suis allé à la papeterie pour acheter du fil.",
        "he": "הלכתי לחנות למכשירי כתיבה כדי לקנות חוט.",
        "hi": "मैं धागा खरीदने के लिए स्टेशनरी की दुकान गया।",
        "hu": "Elmentem a papírboltba, hogy cérnát vegyek.",
        "id": "Saya pergi ke toko alat tulis untuk membeli benang.",
        "it": "Sono andato in cartoleria per comprare del filo.",
        "ja": "私は糸を買いに文房具店へ行きました。",
        "nb": "Jeg dro til papirhandelen for å kjøpe tråd.",
        "nl": "Ik ging naar de kantoorboekhandel om draad te kopen.",
        "pl": "Poszedłem do papierniczego kupić nitkę.",
        "pt": "Fui à papelaria comprar linha.",
        "ro": "M-am dus la papetărie să cumpăr ață.",
        "ru": "Я пошёл в канцтовары купить нитки.",
        "sv": "Jag gick till pappersbutiken för att köpa tråd.",
        "tr": "İp almak için kırtasiyeye gittim.",
        "uk": "Я пішов у канцелярський магазин купити нитки.",
        "vi": "Tôi đã đến cửa hàng văn phòng phẩm để mua chỉ.",
        "yue": "我去咗文具店買線。",
        "zh-Hans": "我去文具店买线。"
      },
