  "sentences": [
    {
      "target": "용기를 갖다 보면 길이 보여요.",
      "reading": "yonggireul gajda bomyeon giri boyeoyo.",
      "translations": {
        "en": "If you have courage, a way will appear.",
        "ko": "용기를 갖다 보면 길이 보여요.",
        "ipa": "yonggireul gajda bomyeon giri boyeoyo.",
        "ar": "إذا تحليت بالشجاعة، ستظهر لك طريق.",
        "cs": "Když budeš mít odvahu, objeví se cesta.",
        "da": "Hvis du har mod, viser der sig en vej.",
        "de": "Wenn du Mut hast, zeigt sich ein Weg.",
        "el": "Αν έχεις θάρρος, θα φανεί ένας δρόμος.",
        "es": "Si tienes valor, aparecerá un camino.",
        "fi": "Jos sinulla on rohkeutta, tie avautuu.",
        "fr": "Si tu as du courage, un chemin apparaîtra.",
        "he": "אם יהיה לך אומץ, תופיע דרך.",
        "hi": "अगर तुममें हिम्मत होगी, तो रास्ता दिखेगा।",
        "hu": "Ha van bátorságod, majd mutatkozik egy út.",
        "id": "Kalau kamu punya keberanian, jalan akan terlihat.",
        "it": "Se hai coraggio, vedrai una strada.",
        "ja": "勇気を持てば、道が見えてきます。",
        "nb": "Hvis du har mot, vil det vise seg en vei.",
        "nl": "Als je moed hebt, zal er een weg verschijnen.",
        "pl": "Jeśli masz odwagę, pojawi się droga.",
        "pt": "Se você tiver coragem, um caminho aparecerá.",
        "ro": "Dacă ai curaj, va apărea un drum.",
        "ru": "Если у тебя хватит смелости, появится путь.",
        "sv": "Om du har mod, kommer en väg att visa sig.",
        "tr": "Cesaretin varsa, bir yol görünür.",
        "uk": "Якщо в тебе буде сміливість, з’явиться шлях.",
        "vi": "Nếu bạn có dũng khí, con đường sẽ hiện ra.",
        "yue": "如果你有勇氣，就會看到一條路。",
        "zh-Hans": "如果你有勇气，就会看到一条路。"
      },
