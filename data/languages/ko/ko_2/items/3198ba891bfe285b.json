  "sentences": [
    {
      "target": "공부하는 사이사이 잠깐 쉬어요.",
      "reading": "gongbuhaneun saisai jamkkan swieoyo",
      "translations": {
        "en": "I take a short break in between studying.",
        "ko": "공부하는 사이사이 잠깐 쉬어요.",
        "ipa": "gongbuhaneun saisai jamkkan swieoyo",
        "ar": "آخذ استراحة قصيرة بين فترات الدراسة.",
        "cs": "Během učení si na chvíli odpočinu.",
        "da": "Jeg holder en kort pause indimellem, mens jeg læser.",
        "de": "Ich mache beim Lernen zwischendurch eine kurze Pause.",
        "el": "Κάνω ένα σύντομο διάλειμμα ανάμεσα στο διάβασμα.",
        "es": "Hago un descanso corto entre estudio y estudio.",
        "fi": "Pidän pienen tauon opiskelun lomassa.",
        "fr": "Je fais une petite pause entre mes moments d'étude.",
        "he": "אני עושה הפסקה קצרה מדי פעם בין הלימודים.",
        "hi": "मैं पढ़ाई के बीच-बीच में थोड़ी देर आराम करता हूँ।",
        "hu": "Tanulás közben néha tartok egy rövid szünetet.",
        "id": "Saya beristirahat sebentar di sela-sela belajar.",
        "it": "Faccio una breve pausa tra uno studio e l'altro.",
        "ja": "勉強の合間に少し休みます。",
        "nb": "Jeg tar en kort pause innimellom når jeg studerer.",
        "nl": "Ik neem af en toe een korte pauze tijdens het studeren.",
        "pl": "Robię krótką przerwę od czasu do czasu podczas nauki.",
        "pt": "Faço uma pausa curta de vez em quando enquanto estudo.",
        "ro": "Fac o pauză scurtă din când în când când învăț.",
        "ru": "Я иногда делаю короткий перерыв во время учёбы.",
        "sv": "Jag tar en kort paus då och då när jag pluggar.",
        "tr": "Ders çalışırken arada kısa bir mola veriyorum.",
        "uk": "Я час від часу роблю коротку перерву під час навчання.",
        "vi": "Tôi nghỉ một lát giữa lúc học.",
        "yue": "我喺溫書嘅時候間中休息一陣。",
        "zh-Hans": "我学习的时候会偶尔休息一下。"
      },
