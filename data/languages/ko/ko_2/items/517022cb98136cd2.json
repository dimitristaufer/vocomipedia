  "sentences": [
    {
      "target": "세월이 참 빠르네요.",
      "reading": "sewol-i cham ppareune-yo.",
      "translations": {
        "en": "Time really flies.",
        "ko": "세월이 참 빠르네요.",
        "ipa": "sewol-i cham ppareune-yo.",
        "ar": "الوقت يمر سريعًا حقًا.",
        "cs": "Čas opravdu letí.",
        "da": "Tiden flyver virkelig.",
        "de": "Die Zeit vergeht wirklich schnell.",
        "el": "Ο χρόνος περνάει πραγματικά γρήγορα.",
        "es": "El tiempo pasa volando.",
        "fi": "Aika todella kuluu nopeasti.",
        "fr": "Le temps passe vraiment vite.",
        "he": "הזמן באמת עף.",
        "hi": "समय सच में बहुत जल्दी बीत जाता है।",
        "hu": "Az idő tényleg gyorsan repül.",
        "id": "Waktu benar-benar cepat berlalu.",
        "it": "Il tempo vola davvero.",
        "ja": "時間が本当に早く過ぎます。",
        "nb": "Tiden går virkelig fort.",
        "nl": "De tijd vliegt echt voorbij.",
        "pl": "Czas naprawdę szybko płynie.",
        "pt": "O tempo passa muito rápido.",
        "ro": "Timpul trece foarte repede.",
        "ru": "Время действительно летит.",
        "sv": "Tiden går verkligen fort.",
        "tr": "Zaman gerçekten çok hızlı geçiyor.",
        "uk": "Час справді летить.",
        "vi": "Thời gian trôi nhanh thật.",
        "yue": "時間真係過得好快。",
        "zh-Hans": "时间过得真快。"
      },
