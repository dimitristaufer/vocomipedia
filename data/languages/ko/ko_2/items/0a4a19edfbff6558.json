    {
      "target": "저는 방과 후에 학원에 갑니다.",
      "reading": "Jeoneun banggwa hue hagwone gamnida.",
      "translations": {
        "en": "I go to an academy after school.",
        "ko": "저는 방과 후에 학원에 갑니다.",
        "ipa": "Jeoneun banggwa hue hagwone gamnida.",
        "ar": "أنا أذهب إلى المعهد بعد المدرسة.",
        "cs": "Po škole chodím do kurzu.",
        "da": "Jeg går på akademiet efter skole.",
        "de": "Ich gehe nach der Schule zur Nachhilfeschule.",
        "el": "Πηγαίνω στο φροντιστήριο μετά το σχολείο.",
        "es": "Voy a la academia después de la escuela.",
        "fi": "Käyn koulun jälkeen oppilaitoksessa.",
        "fr": "Je vais à l'académie après l'école.",
        "he": "אני הולך לאקדמיה אחרי בית הספר.",
        "hi": "मैं स्कूल के बाद कोचिंग जाता हूँ।",
        "hu": "Iskola után járok az előkészítőre.",
        "id": "Saya pergi ke tempat les sepulang sekolah.",
        "it": "Vado all'accademia dopo la scuola.",
        "ja": "私は放課後に塾に行きます。",
        "nb": "Jeg går på instituttet etter skolen.",
        "nl": "Ik ga na school naar de bijlesacademie.",
        "pl": "Po szkole chodzę do akademii.",
        "pt": "Eu vou para a academia depois da escola.",
        "ro": "Mă duc la academie după școală.",
        "ru": "После школы я хожу в академию.",
        "sv": "Jag går till akademin efter skolan.",
        "tr": "Okuldan sonra dershaneye gidiyorum.",
        "uk": "Після школи я ходжу до академії.",
        "vi": "Tôi đi học ở trung tâm sau giờ học.",
        "yue": "我放學之後去補習社。",
        "zh-Hans": "我放学后去辅导班。"
      },
