  "sentences": [
    {
      "target": "국에 후춧가루를 조금 넣었어요.",
      "reading": "Guge huchutgarureul jogeum neoeosseoyo.",
      "translations": {
        "en": "I added a little ground pepper to the soup.",
        "ko": "국에 후춧가루를 조금 넣었어요.",
        "ipa": "Guge huchutgarureul jogeum neoeosseoyo.",
        "ar": "أضفتُ قليلًا من الفلفل المطحون إلى الحساء.",
        "cs": "Do polévky jsem přidal trochu mletého pepře.",
        "da": "Jeg tilsatte lidt sort peber i suppen.",
        "de": "Ich habe ein wenig gemahlenen Pfeffer in die Suppe gegeben.",
        "el": "Έβαλα λίγο τριμμένο πιπέρι στη σούπα.",
        "es": "Le eché un poco de pimienta molida a la sopa.",
        "fi": "Lisäsin keittoon vähän jauhettua pippuria.",
        "fr": "J'ai ajouté un peu de poivre moulu dans la soupe.",
        "he": "הוספתי קצת פלפל שחור טחון למרק.",
        "hi": "मैंने सूप में थोड़ा पिसी हुई काली मिर्च डाली।",
        "hu": "Tettem egy kevés őrölt borsot a levesbe.",
        "id": "Saya menambahkan sedikit lada bubuk ke dalam sup.",
        "it": "Ho aggiunto un po' di pepe macinato nella zuppa.",
        "ja": "スープに少し挽いたこしょうを入れました。",
        "nb": "Jeg hadde litt nykvernet pepper i suppen.",
        "nl": "Ik deed wat gemalen peper in de soep.",
        "pl": "Dodałem trochę mielonego pieprzu do zupy.",
        "pt": "Coloquei um pouco de pimenta-do-reino moída na sopa.",
        "ro": "Am pus puțin piper măcinat în supă.",
        "ru": "Я добавил немного молотого перца в суп.",
        "sv": "Jag lade lite malen peppar i soppan.",
        "tr": "Çorbaya biraz çekilmiş karabiber kattım.",
        "uk": "Я додав трохи меленого перцю до супу.",
        "vi": "Tôi cho một ít tiêu xay vào súp.",
        "yue": "我喺湯入面加咗少少黑胡椒粉。",
        "zh-Hans": "我在汤里加了点黑胡椒粉。"
      },
