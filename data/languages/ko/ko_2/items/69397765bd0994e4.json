  "sentences": [
    {
      "target": "우리 리에는 작은 우체국이 있어요.",
      "reading": "우리 리에는 작은 우체국이 있어요.",
      "translations": {
        "en": "Our village has a small post office.",
        "ko": "우리 리에는 작은 우체국이 있어요.",
        "ipa": "우리 리에는 작은 우체국이 있어요.",
        "ar": "في قريتنا مكتب بريد صغير.",
        "cs": "V naší vesnici je malá pošta.",
        "da": "Vores landsby har et lille posthus.",
        "de": "Unser Dorf hat ein kleines Postamt.",
        "el": "Το χωριό μας έχει ένα μικρό ταχυδρομείο.",
        "es": "Nuestro pueblo tiene una oficina de correos pequeña.",
        "fi": "Meidän kylässämme on pieni posti.",
        "fr": "Notre village a un petit bureau de poste.",
        "he": "בכפר שלנו יש סניף דואר קטן.",
        "hi": "हमारे गांव में एक छोटा डाकघर है।",
        "hu": "A falunkban van egy kis posta.",
        "id": "Desa kami punya kantor pos kecil.",
        "it": "Nel nostro villaggio c'è un piccolo ufficio postale.",
        "ja": "私たちの里には小さな郵便局があります。",
        "nb": "Bygda vår har et lite postkontor.",
        "nl": "Ons dorp heeft een klein postkantoor.",
        "pl": "W naszej wsi jest mały urząd pocztowy.",
        "pt": "Nossa aldeia tem uma agência de correios pequena.",
        "ro": "Satul nostru are un oficiu poștal mic.",
        "ru": "В нашей деревне есть маленькое почтовое отделение.",
        "sv": "Vår by har ett litet postkontor.",
        "tr": "Köyümüzde küçük bir postane var.",
        "uk": "У нашому селі є маленьке поштове відділення.",
        "vi": "Làng chúng tôi có một bưu điện nhỏ.",
        "yue": "我哋條鄉有一間好細嘅郵局。",
        "zh-Hans": "我们村里有一个小邮局。"
      },
