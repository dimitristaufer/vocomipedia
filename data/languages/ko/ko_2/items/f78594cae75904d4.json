    {
      "target": "아이가 공을 잡다가 넘어졌어요.",
      "reading": "aiga gongeul japdaga neomeojyeosseoyo",
      "translations": {
        "en": "The child fell down while catching the ball.",
        "ko": "아이가 공을 잡다가 넘어졌어요.",
        "ipa": "aiga gongeul japdaga neomeojyeosseoyo",
        "ar": "سقط الطفل وهو يلتقط الكرة.",
        "cs": "Dítě upadlo, když chytalo míč.",
        "da": "Barnet faldt, mens det greb bolden.",
        "de": "Das Kind ist hingefallen, als es den Ball fangen wollte.",
        "el": "Το παιδί έπεσε ενώ έπιανε την μπάλα.",
        "es": "El niño se cayó mientras atrapaba la pelota.",
        "fi": "Lapsi kaatui, kun hän yritti ottaa pallon kiinni.",
        "fr": "L'enfant est tombé en attrapant la balle.",
        "he": "הילד נפל כשהוא תפס את הכדור.",
        "hi": "बच्चा गेंद पकड़ते समय गिर गया।",
        "hu": "A gyerek elesett, miközben a labdát kapta el.",
        "id": "Anak itu jatuh saat menangkap bola.",
        "it": "Il bambino è caduto mentre prendeva la palla.",
        "ja": "子どもはボールを取ろうとして転びました。",
        "nb": "Barnet falt mens det tok imot ballen.",
        "nl": "Het kind viel terwijl het de bal ving.",
        "pl": "Dziecko przewróciło się, gdy łapało piłkę.",
        "pt": "A criança caiu enquanto pegava a bola.",
        "ro": "Copilul a căzut în timp ce prindea mingea.",
        "ru": "Ребёнок упал, когда ловил мяч.",
        "sv": "Barnet föll när det skulle ta emot bollen.",
        "tr": "Çocuk topu tutarken düştü.",
        "uk": "Дитина впала, коли ловила м’яч.",
        "vi": "Đứa trẻ bị ngã khi bắt bóng.",
        "yue": "個小朋友接波嗰陣跌倒咗。",
        "zh-Hans": "孩子接球时摔倒了。"
      },
