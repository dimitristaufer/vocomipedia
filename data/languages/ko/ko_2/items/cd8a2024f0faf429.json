    {
      "target": "형님, 오늘 저녁에 시간 있으세요?",
      "reading": "hyeongnim, oneul jeonyeoge sigan isseuseyo?",
      "translations": {
        "en": "Older friend, do you have time tonight?",
        "ko": "형님, 오늘 저녁에 시간 있으세요?",
        "ipa": "hyeongnim, oneul jeonyeoge sigan isseuseyo?",
        "ar": "يا أخي الكبير، هل لديك وقت هذا المساء؟",
        "cs": "Starší příteli, máte dnes večer čas?",
        "da": "Ældre ven, har du tid i aften?",
        "de": "Älterer Freund, hast du heute Abend Zeit?",
        "el": "Μεγάλε, έχεις χρόνο απόψε;",
        "es": "Amigo mayor, ¿tienes tiempo esta noche?",
        "fi": "Vanhempi ystävä, onko sinulla aikaa tänä iltana?",
        "fr": "Grand frère, tu as le temps ce soir ?",
        "he": "אחי הגדול, יש לך זמן הערב?",
        "hi": "बड़े भाई, क्या आपके पास आज शाम समय है?",
        "hu": "Nagy testvér, van időd ma este?",
        "id": "Kakak, apa Anda ada waktu malam ini?",
        "it": "Fratello maggiore, hai tempo stasera?",
        "ja": "お兄さん、今夜お時間ありますか。",
        "nb": "Store venn, har du tid i kveld?",
        "nl": "Oudere vriend, heb je vanavond tijd?",
        "pl": "Starszy bracie, masz dziś wieczorem czas?",
        "pt": "Irmão mais velho, você tem tempo hoje à noite?",
        "ro": "Frate mai mare, ai timp diseară?",
        "ru": "Старший брат, у тебя есть время сегодня вечером?",
        "sv": "Store vän, har du tid i kväll?",
        "tr": "Ağabey, bu akşam zamanın var mı?",
        "uk": "Старший брате, у вас є час сьогодні ввечері?",
        "vi": "Anh lớn, tối nay anh có thời gian không?",
        "yue": "阿哥，你今晚有冇時間呀？",
        "zh-Hans": "大哥，你今晚有时间吗？"
      },
