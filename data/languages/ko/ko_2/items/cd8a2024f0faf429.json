    {
      "target": "형님, 먼저 드세요.",
      "reading": "hyeongnim, meonjeo deuseyo.",
      "translations": {
        "en": "Older friend, please eat first.",
        "ko": "형님, 먼저 드세요.",
        "ipa": "hyeongnim, meonjeo deuseyo.",
        "ar": "يا أخي الكبير، تفضل كل أولًا.",
        "cs": "Starší příteli, dejte si prosím nejdřív.",
        "da": "Ældre ven, spis venligst først.",
        "de": "Älterer Freund, bitte essen Sie zuerst.",
        "el": "Μεγάλε, φάε πρώτος, παρακαλώ.",
        "es": "Amigo mayor, por favor come primero.",
        "fi": "Vanhempi ystävä, syö sinä ensin.",
        "fr": "Grand frère, mange d'abord, s'il te plaît.",
        "he": "אחי הגדול, תאכל קודם, בבקשה.",
        "hi": "बड़े भाई, पहले आप खाइए।",
        "hu": "Nagy testvér, egyél előbb, kérlek.",
        "id": "Kakak, silakan makan dulu.",
        "it": "Fratello maggiore, mangia prima, per favore.",
        "ja": "お兄さん、先にどうぞ。",
        "nb": "Store venn, spis først.",
        "nl": "Oudere vriend, eet eerst maar.",
        "pl": "Starszy bracie, jedz pierwszy.",
        "pt": "Irmão mais velho, coma primeiro, por favor.",
        "ro": "Frate mai mare, mănâncă tu primul, te rog.",
        "ru": "Старший брат, поешь первым, пожалуйста.",
        "sv": "Store vän, ät först.",
        "tr": "Ağabey, önce sen ye lütfen.",
        "uk": "Старший брате, їжте першим, будь ласка.",
        "vi": "Anh lớn, anh ăn trước đi.",
        "yue": "阿哥，請你先食。",
        "zh-Hans": "大哥，请先吃。"
      },
