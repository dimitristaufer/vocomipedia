  "sentences": [
    {
      "target": "올가을에는 단풍을 보러 갈 거예요.",
      "reading": "올가을에는 단풍을 보러 갈 거예요.",
      "translations": {
        "en": "This fall, I'm going to see the autumn leaves.",
        "ko": "올가을에는 단풍을 보러 갈 거예요.",
        "ipa": "올가을에는 단풍을 보러 갈 거예요.",
        "ar": "سأذهب لرؤية أوراق الخريف هذا الخريف.",
        "cs": "Tento podzim se půjdu podívat na listí.",
        "da": "Jeg skal se efterårsbladene i efteråret.",
        "de": "Ich gehe diesen Herbst die Herbstblätter anschauen.",
        "el": "Αυτό το φθινόπωρο θα πάω να δω τα φθινοπωρινά φύλλα.",
        "es": "Este otoño voy a ver las hojas de otoño.",
        "fi": "Aion mennä katsomaan syksyn lehtiä tänä syksynä.",
        "fr": "Je vais aller voir les feuilles d'automne cet automne.",
        "he": "אני אלך לראות את שלכת הסתיו בסתיו הזה.",
        "hi": "इस पतझड़ में मैं पतझड़ के पत्ते देखने जाऊँगा।",
        "hu": "Idén ősszel elmegyek megnézni az őszi faleveleket.",
        "id": "Musim gugur ini saya akan pergi melihat daun-daun musim gugur.",
        "it": "Questo autunno andrò a vedere le foglie autunnali.",
        "ja": "この秋は紅葉を見に行きます。",
        "nb": "Jeg skal se på høstfargene i høst.",
        "nl": "Ik ga deze herfst de herfstbladeren bekijken.",
        "pl": "Jesienią pójdę oglądać jesienne liście.",
        "pt": "Este outono vou ver as folhas de outono.",
        "ro": "Toamna aceasta voi merge să văd frunzele de toamnă.",
        "ru": "Этой осенью я пойду смотреть на осенние листья.",
        "sv": "Jag ska gå och titta på höstlöven i höst.",
        "tr": "Bu sonbaharda sonbahar yapraklarını görmeye gideceğim.",
        "uk": "Цієї осені я піду дивитися на осіннє листя.",
        "vi": "Mùa thu này tôi sẽ đi ngắm lá mùa thu.",
        "yue": "今個秋天我會去睇紅葉。",
        "zh-Hans": "今年秋天我要去看红叶。"
      },
