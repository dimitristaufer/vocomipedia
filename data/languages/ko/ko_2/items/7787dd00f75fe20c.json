    {
      "target": "경찰이 도둑을 바로 잡았어요.",
      "reading": "gyeongchali dodugeul baro jabasseoyo.",
      "translations": {
        "en": "The police caught the thief right away.",
        "ko": "경찰이 도둑을 바로 잡았어요.",
        "ipa": "gyeongchali dodugeul baro jabasseoyo.",
        "ar": "أمسكت الشرطة باللص فورًا.",
        "cs": "Policie zloděje hned chytila.",
        "da": "Politiet fangede tyven med det samme.",
        "de": "Die Polizei hat den Dieb sofort gefasst.",
        "el": "Η αστυνομία έπιασε αμέσως τον κλέφτη.",
        "es": "La policía atrapó al ladrón enseguida.",
        "fi": "Poliisi sai varkaan kiinni heti.",
        "fr": "La police a attrapé le voleur tout de suite.",
        "he": "המשטרה תפסה את הגנב מיד.",
        "hi": "पुलिस ने चोर को तुरंत पकड़ लिया।",
        "hu": "A rendőrség azonnal elkapta a tolvajt.",
        "id": "Polisi langsung menangkap pencuri itu.",
        "it": "La polizia ha preso subito il ladro.",
        "ja": "警察がすぐに泥棒を捕まえました。",
        "nb": "Politiet tok tyven med en gang.",
        "nl": "De politie pakte de dief meteen.",
        "pl": "Policja od razu złapała złodzieja.",
        "pt": "A polícia pegou o ladrão na hora.",
        "ro": "Poliția l-a prins imediat pe hoț.",
        "ru": "Полиция сразу поймала вора.",
        "sv": "Polisen tog tjuven direkt.",
        "tr": "Polis hırsızı hemen yakaladı.",
        "uk": "Поліція одразу спіймала злодія.",
        "vi": "Cảnh sát đã bắt tên trộm ngay lập tức.",
        "yue": "警察即刻捉咗個賊。",
        "zh-Hans": "警察马上抓住了小偷。"
      },
