  "sentences": [
    {
      "target": "도둑이 밤에 집에 들어왔어요.",
      "reading": "dodugi bame jibe deureowasseoyo.",
      "translations": {
        "en": "A thief came into the house at night.",
        "ko": "도둑이 밤에 집에 들어왔어요.",
        "ipa": "dodugi bame jibe deureowasseoyo.",
        "ar": "دخل اللص إلى البيت ليلاً.",
        "cs": "Zloděj přišel v noci do domu.",
        "da": "Tyven kom ind i huset om natten.",
        "de": "Der Dieb kam nachts ins Haus.",
        "el": "Ο κλέφτης μπήκε στο σπίτι τη νύχτα.",
        "es": "El ladrón entró en la casa por la noche.",
        "fi": "Varas tuli taloon yöllä.",
        "fr": "Le voleur est entré dans la maison la nuit.",
        "he": "הגנב נכנס לבית בלילה.",
        "hi": "चोर रात में घर में घुस आया।",
        "hu": "A tolvaj éjjel bejött a házba.",
        "id": "Pencuri itu masuk ke rumah pada malam hari.",
        "it": "Il ladro è entrato in casa di notte.",
        "ja": "泥棒が夜に家に入ってきました。",
        "nb": "Tyven kom inn i huset om natten.",
        "nl": "De dief kwam 's nachts het huis binnen.",
        "pl": "Złodziej wszedł do domu w nocy.",
        "pt": "O ladrão entrou na casa à noite.",
        "ro": "Hoțul a intrat în casă noaptea.",
        "ru": "Ночью в дом вошёл вор.",
        "sv": "Tjuven kom in i huset på natten.",
        "tr": "Hırsız gece eve girdi.",
        "uk": "Уночі злодій зайшов у дім.",
        "vi": "Tên trộm đã vào nhà vào ban đêm.",
        "yue": "賊喺夜晚入咗屋。",
        "zh-Hans": "小偷在晚上进了家里。"
      },
