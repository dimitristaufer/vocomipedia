  "sentences": [
    {
      "target": "신혼부부가 작은 집으로 이사했어요.",
      "reading": "sinhonbubuga jageun jibeuro isahaesseoyo.",
      "translations": {
        "en": "The newlyweds moved into a small house.",
        "ko": "신혼부부가 작은 집으로 이사했어요.",
        "ipa": "sinhonbubuga jageun jibeuro isahaesseoyo.",
        "ar": "انتقل العروسان إلى بيت صغير.",
        "cs": "Novomanželé se přestěhovali do malého domu.",
        "da": "Brudeparret flyttede ind i et lille hus.",
        "de": "Das frisch verheiratete Paar ist in ein kleines Haus gezogen.",
        "el": "Οι νεόνυμφοι μετακόμισαν σε ένα μικρό σπίτι.",
        "es": "Los recién casados se mudaron a una casa pequeña.",
        "fi": "Juuri avioitunut pari muutti pieneen taloon.",
        "fr": "Les jeunes mariés ont emménagé dans une petite maison.",
        "he": "הזוג הטרי עבר לבית קטן.",
        "hi": "नवविवाहित जोड़ा एक छोटे घर में शिफ्ट हो गया।",
        "hu": "Az ifjú házasok beköltöztek egy kis házba.",
        "id": "Pasangan pengantin baru pindah ke rumah kecil.",
        "it": "Gli sposi si sono trasferiti in una casa piccola.",
        "ja": "新婚夫婦が小さな家に引っ越しました。",
        "nb": "Det nygifte paret flyttet inn i et lite hus.",
        "nl": "Het pasgetrouwde stel is naar een klein huis verhuisd.",
        "pl": "Nowożeńcy wprowadzili się do małego domu.",
        "pt": "Os recém-casados mudaram-se para uma casa pequena.",
        "ro": "Tinerii căsătoriți s-au mutat într-o casă mică.",
        "ru": "Молодожёны переехали в маленький дом.",
        "sv": "Det nygifta paret flyttade in i ett litet hus.",
        "tr": "Yeni evli çift küçük bir eve taşındı.",
        "uk": "Молодята переїхали в маленький будинок.",
        "vi": "Cặp vợ chồng mới cưới đã chuyển vào một ngôi nhà nhỏ.",
        "yue": "新婚夫婦搬咗入一間細屋。",
        "zh-Hans": "新婚夫妇搬进了一间小房子。"
      },
