  "sentences": [
    {
      "target": "할아버지는 남조선 이야기를 자주 하셨어요.",
      "reading": "harabeojineun namjoseon iyagireul jaju hasyeosseoyo.",
      "translations": {
        "en": "My grandfather often talked about South Korea.",
        "ko": "할아버지는 남조선 이야기를 자주 하셨어요.",
        "ipa": "harabeojineun namjoseon iyagireul jaju hasyeosseoyo.",
        "ar": "كان جدي يتحدث كثيرًا عن كوريا الجنوبية.",
        "cs": "Dědeček často mluvil o Jižní Koreji.",
        "da": "Min bedstefar talte ofte om Sydkorea.",
        "de": "Mein Großvater hat oft über Südkorea gesprochen.",
        "el": "Ο παππούς μου μιλούσε συχνά για τη Νότια Κορέα.",
        "es": "Mi abuelo hablaba a menudo de Corea del Sur.",
        "fi": "Isoisäni puhui usein Etelä-Koreasta.",
        "fr": "Mon grand-père parlait souvent de la Corée du Sud.",
        "he": "הסבא שלי דיבר הרבה על דרום קוריאה.",
        "hi": "मेरे दादा अक्सर दक्षिण कोरिया के बारे में बात करते थे।",
        "hu": "A nagyapám gyakran beszélt Dél-Koreáról.",
        "id": "Kakek saya sering bercerita tentang Korea Selatan.",
        "it": "Mio nonno parlava spesso della Corea del Sud.",
        "ja": "祖父は韓国の話をよくしていました。",
        "nb": "Bestefaren min snakket ofte om Sør-Korea.",
        "nl": "Mijn grootvader sprak vaak over Zuid-Korea.",
        "pl": "Mój dziadek często mówił o Korei Południowej.",
        "pt": "Meu avô falava muito sobre a Coreia do Sul.",
        "ro": "Bunicul meu vorbea des despre Coreea de Sud.",
        "ru": "Мой дедушка часто говорил о Южной Корее.",
        "sv": "Min farfar pratade ofta om Sydkorea.",
        "tr": "Dedem Güney Kore hakkında sık sık konuşurdu.",
        "uk": "Мій дідусь часто говорив про Південну Корею.",
        "vi": "Ông tôi thường nói về Hàn Quốc.",
        "yue": "我公公成日講南韓嘅事。",
        "zh-Hans": "我爷爷经常谈起韩国。"
      },
