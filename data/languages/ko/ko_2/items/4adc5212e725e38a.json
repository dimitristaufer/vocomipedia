  "sentences": [
    {
      "target": "친구의 지원이 정말 든든했어요.",
      "reading": "chingu-ui jiwoni jeongmal deundeunhaesseoyo.",
      "translations": {
        "en": "My friend’s support was really reassuring.",
        "ko": "친구의 지원이 정말 든든했어요.",
        "ipa": "chingu-ui jiwoni jeongmal deundeunhaesseoyo.",
        "ar": "كان دعم صديقي مطمئنًا جدًا.",
        "cs": "Podpora mého přítele mě opravdu uklidnila.",
        "da": "Min vens støtte var virkelig beroligende.",
        "de": "Die Unterstützung meines Freundes war wirklich beruhigend.",
        "el": "Η υποστήριξη του φίλου μου ήταν πραγματικά καθησυχαστική.",
        "es": "El apoyo de mi amigo fue realmente reconfortante.",
        "fi": "Ystäväni tuki oli todella lohduttavaa.",
        "fr": "Le soutien de mon ami m'a vraiment rassuré.",
        "he": "התמיכה של החבר שלי הייתה ממש מרגיעה.",
        "hi": "मेरे दोस्त का समर्थन बहुत सुकून देने वाला था।",
        "hu": "A barátom támogatása igazán megnyugtató volt.",
        "id": "Dukungan teman saya benar-benar melegakan.",
        "it": "Il sostegno del mio amico è stato davvero rassicurante.",
        "ja": "友達の支援は本当に心強かったです。",
        "nb": "Støtten fra vennen min var virkelig betryggende.",
        "nl": "De steun van mijn vriend stelde me echt gerust.",
        "pl": "Wsparcie mojego przyjaciela naprawdę mnie uspokoiło.",
        "pt": "O apoio do meu amigo foi realmente reconfortante.",
        "ro": "Sprijinul prietenului meu a fost chiar liniștitor.",
        "ru": "Поддержка моего друга очень успокаивала.",
        "sv": "Min väns stöd var verkligen lugnande.",
        "tr": "Arkadaşımın desteği gerçekten içimi rahatlattı.",
        "uk": "Підтримка мого друга справді заспокоювала.",
        "vi": "Sự hỗ trợ của bạn tôi thật sự rất an tâm.",
        "yue": "朋友嘅支持真係好令人安心。",
        "zh-Hans": "朋友的支持真的很让人安心。"
      },
