  "sentences": [
    {
      "target": "어머니는 아들의 병을 괴로워해요.",
      "reading": "eomunineun adeurui byeongeul goerowohaeyo.",
      "translations": {
        "en": "The mother is distressed by her son's illness.",
        "ko": "어머니는 아들의 병을 괴로워해요.",
        "ipa": "eomunineun adeurui byeongeul goerowohaeyo.",
        "ar": "الأم متضايقة من مرض ابنها.",
        "cs": "Matka je zarmoucená synovou nemocí.",
        "da": "Moderen er ked af det over sin søns sygdom.",
        "de": "Die Mutter ist über die Krankheit ihres Sohnes sehr bekümmert.",
        "el": "Η μητέρα στενοχωριέται για την αρρώστια του γιου της.",
        "es": "La madre está angustiada por la enfermedad de su hijo.",
        "fi": "Äiti on ahdistunut poikansa sairaudesta.",
        "fr": "La mère est bouleversée par la maladie de son fils.",
        "he": "האם מודאגת ממחלתו של בנה.",
        "hi": "माँ अपने बेटे की बीमारी से बहुत दुखी है।",
        "hu": "Az anya szomorú a fia betegsége miatt.",
        "id": "Ibu sedih karena penyakit anaknya.",
        "it": "La madre è addolorata per la malattia di suo figlio.",
        "ja": "母親は息子の病気をつらく思っています。",
        "nb": "Mor er fortvilet over sønnens sykdom.",
        "nl": "De moeder is verdrietig om de ziekte van haar zoon.",
        "pl": "Matka martwi się chorobą swojego syna.",
        "pt": "A mãe está angustiada com a doença do filho.",
        "ro": "Mama este îndurerată de boala fiului ei.",
        "ru": "Мама переживает из-за болезни сына.",
        "sv": "Mamman är ledsen över sin sons sjukdom.",
        "tr": "Anne, oğlunun hastalığı yüzünden çok üzgün.",
        "uk": "Мама переживає через хворобу сина.",
        "vi": "Người mẹ đau buồn vì căn bệnh của con trai mình.",
        "yue": "媽媽因為個仔嘅病而好難過。",
        "zh-Hans": "母亲为儿子的病感到难过。"
      },
