  "sentences": [
    {
      "target": "오늘 옷차림이 참 편해 보여요.",
      "reading": "Oneul otcharimi cham pyunhae boyeo.",
      "translations": {
        "en": "Your outfit looks very comfortable today.",
        "ko": "오늘 옷차림이 참 편해 보여요.",
        "ipa": "Oneul otcharimi cham pyunhae boyeo.",
        "ar": "ملابسك اليوم مريحة جدًا.",
        "cs": "Dnes vypadáš v pohodlném oblečení.",
        "da": "Dit tøj ser meget behageligt ud i dag.",
        "de": "Dein Outfit sieht heute sehr bequem aus.",
        "el": "Το ντύσιμό σου σήμερα φαίνεται πολύ άνετο.",
        "es": "Tu ropa de hoy se ve muy cómoda.",
        "fi": "Asusi näyttää tänään tosi mukavalta.",
        "fr": "Ta tenue a l'air très confortable aujourd'hui.",
        "he": "הבגדים שלך נראים היום נוחים מאוד.",
        "hi": "आज तुम्हारा पहनावा बहुत आरामदायक लग रहा है।",
        "hu": "A mai öltözéked nagyon kényelmesnek tűnik.",
        "id": "Pakaianmu hari ini terlihat sangat nyaman.",
        "it": "Il tuo abbigliamento oggi sembra molto comodo.",
        "ja": "今日の服装はとても楽そうですね。",
        "nb": "Antrekket ditt ser veldig behagelig ut i dag.",
        "nl": "Je outfit ziet er vandaag erg comfortabel uit.",
        "pl": "Twój strój wygląda dziś bardzo wygodnie.",
        "pt": "Seu look hoje parece muito confortável.",
        "ro": "Ținuta ta arată foarte comod azi.",
        "ru": "Сегодня ты очень удобно одет.",
        "sv": "Din outfit ser väldigt bekväm ut i dag.",
        "tr": "Bugünkü kıyafetin çok rahat görünüyor.",
        "uk": "Сьогодні твій одяг виглядає дуже зручним.",
        "vi": "Trang phục của bạn hôm nay trông rất thoải mái.",
        "yue": "你今日件衫睇落好舒服。",
        "zh-Hans": "你今天的穿着看起来很舒服。"
      },
