    {
      "target": "먼저 간단한 소개를 할게요.",
      "reading": "meonjeo gandanhan sogaereul halgeyo.",
      "translations": {
        "en": "First, I'll give a brief introduction.",
        "ko": "먼저 간단한 소개를 할게요.",
        "ipa": "meonjeo gandanhan sogaereul halgeyo.",
        "ar": "سأقدم مقدمة قصيرة أولًا.",
        "cs": "Nejprve udělám krátké představení.",
        "da": "Først vil jeg give en kort introduktion.",
        "de": "Zuerst gebe ich eine kurze Einführung.",
        "el": "Πρώτα θα κάνω μια σύντομη παρουσίαση.",
        "es": "Primero, haré una breve presentación.",
        "fi": "Ensin teen lyhyen esittelyn.",
        "fr": "Je vais d'abord faire une brève présentation.",
        "he": "קודם כול, אעשה היכרות קצרה.",
        "hi": "पहले, मैं संक्षिप्त परिचय दूँगा।",
        "hu": "Először egy rövid bemutatkozást tartok.",
        "id": "Pertama, saya akan memberi pengenalan singkat.",
        "it": "Prima farò una breve presentazione.",
        "ja": "まず、簡単に自己紹介します。",
        "nb": "Først skal jeg gi en kort presentasjon.",
        "nl": "Eerst geef ik een korte introductie.",
        "pl": "Najpierw zrobię krótkie wprowadzenie.",
        "pt": "Primeiro, vou fazer uma breve apresentação.",
        "ro": "Mai întâi, voi face o scurtă prezentare.",
        "ru": "Сначала я сделаю короткое представление.",
        "sv": "Först ska jag ge en kort introduktion.",
        "tr": "Önce kısa bir tanıtım yapacağım.",
        "uk": "Спочатку я зроблю коротке представлення.",
        "vi": "Trước hết, tôi sẽ giới thiệu ngắn gọn.",
        "yue": "首先，我會作一個簡單嘅介紹。",
        "zh-Hans": "首先，我会做一个简单的介绍。"
      },
