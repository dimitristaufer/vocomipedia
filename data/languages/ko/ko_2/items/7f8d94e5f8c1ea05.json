    {
      "target": "면접 전에 짧게 소개를 했어요.",
      "reading": "myeonjeop jeone jjalge sogaereul haesseoyo.",
      "translations": {
        "en": "I gave a brief introduction before the interview.",
        "ko": "면접 전에 짧게 소개를 했어요.",
        "ipa": "myeonjeop jeone jjalge sogaereul haesseoyo.",
        "ar": "قدمت مقدمة قصيرة قبل المقابلة.",
        "cs": "Před pohovorem jsem se krátce představil.",
        "da": "Jeg gav en kort præsentation før samtalen.",
        "de": "Vor dem Vorstellungsgespräch habe ich mich kurz vorgestellt.",
        "el": "Έκανα μια σύντομη παρουσίαση πριν από τη συνέντευξη.",
        "es": "Hice una breve presentación antes de la entrevista.",
        "fi": "Pidin lyhyen esittelyn ennen haastattelua.",
        "fr": "J'ai fait une brève présentation avant l'entretien.",
        "he": "עשיתי היכרות קצרה לפני הריאיון.",
        "hi": "मैंने इंटरव्यू से पहले संक्षिप्त परिचय दिया।",
        "hu": "Röviden bemutatkoztam az interjú előtt.",
        "id": "Saya memberi pengenalan singkat sebelum wawancara.",
        "it": "Ho fatto una breve presentazione prima del colloquio.",
        "ja": "面接の前に簡単に自己紹介をしました。",
        "nb": "Jeg ga en kort presentasjon før intervjuet.",
        "nl": "Voor het gesprek stelde ik me kort voor.",
        "pl": "Przed rozmową kwalifikacyjną krótko się przedstawiłem.",
        "pt": "Fiz uma breve apresentação antes da entrevista.",
        "ro": "Am făcut o scurtă prezentare înainte de interviu.",
        "ru": "Перед собеседованием я коротко представился.",
        "sv": "Jag gav en kort presentation före intervjun.",
        "tr": "Mülakattan önce kısa bir tanıtım yaptım.",
        "uk": "Перед співбесідою я коротко представився.",
        "vi": "Trước buổi phỏng vấn, tôi đã giới thiệu ngắn gọn.",
        "yue": "面試前，我做咗一個簡短介紹。",
        "zh-Hans": "面试前，我做了一个简短的介绍。"
      },
