    {
      "target": "우리는 역에서 헤어졌어요.",
      "reading": "urineun yeogeseo he-eojyeosseoyo.",
      "translations": {
        "en": "We parted at the station.",
        "ko": "우리는 역에서 헤어졌어요.",
        "ipa": "urineun yeogeseo he-eojyeosseoyo.",
        "ar": "افترقنا في المحطة.",
        "cs": "Rozešli jsme se na nádraží.",
        "da": "Vi skiltes på stationen.",
        "de": "Wir haben uns am Bahnhof getrennt.",
        "el": "Χωρίσαμε στον σταθμό.",
        "es": "Nos despedimos en la estación.",
        "fi": "Erosimme asemalla.",
        "fr": "Nous nous sommes séparés à la gare.",
        "he": "נפרדנו בתחנה.",
        "hi": "हम स्टेशन पर अलग हो गए।",
        "hu": "Az állomáson váltunk el.",
        "id": "Kami berpisah di stasiun.",
        "it": "Ci siamo separati alla stazione.",
        "ja": "私たちは駅で別れました。",
        "nb": "Vi tok farvel på stasjonen.",
        "nl": "We namen afscheid op het station.",
        "pl": "Rozstaliśmy się na stacji.",
        "pt": "Nós nos despedimos na estação.",
        "ro": "Ne-am despărțit la gară.",
        "ru": "Мы расстались на станции.",
        "sv": "Vi skildes åt på stationen.",
        "tr": "İstasyonda ayrıldık.",
        "uk": "Ми розійшлися на вокзалі.",
        "vi": "Chúng tôi chia tay ở nhà ga.",
        "yue": "我哋喺車站分開咗。",
        "zh-Hans": "我们在车站分开了。"
      },
