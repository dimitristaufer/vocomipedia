  "sentences": [
    {
      "target": "아버지가 어제 한국으로 귀국했어요.",
      "reading": "abeojiga eoje hangug-euro gwigukhaesseoyo.",
      "translations": {
        "en": "My father returned to Korea yesterday.",
        "ko": "아버지가 어제 한국으로 귀국했어요.",
        "ipa": "abeojiga eoje hangug-euro gwigukhaesseoyo.",
        "ar": "عاد أبي إلى كوريا أمس.",
        "cs": "Můj otec se včera vrátil do Koreje.",
        "da": "Min far kom tilbage til Korea i går.",
        "de": "Mein Vater ist gestern nach Korea zurückgekehrt.",
        "el": "Ο πατέρας μου επέστρεψε χθες στην Κορέα.",
        "es": "Mi padre volvió a Corea ayer.",
        "fi": "Isäni palasi eilen Koreaan.",
        "fr": "Mon père est rentré en Corée hier.",
        "he": "אבא שלי חזר לקוריאה אתמול.",
        "hi": "मेरे पिता कल कोरिया लौट आए।",
        "hu": "Az apám tegnap hazatért Koreába.",
        "id": "Ayah saya kembali ke Korea kemarin.",
        "it": "Mio padre è tornato in Corea ieri.",
        "ja": "父が昨日韓国に帰国しました。",
        "nb": "Faren min kom tilbake til Korea i går.",
        "nl": "Mijn vader is gisteren teruggekeerd naar Korea.",
        "pl": "Mój ojciec wrócił wczoraj do Korei.",
        "pt": "Meu pai voltou para a Coreia ontem.",
        "ro": "Tatăl meu s-a întors ieri în Coreea.",
        "ru": "Мой отец вчера вернулся в Корею.",
        "sv": "Min pappa kom tillbaka till Korea igår.",
        "tr": "Babam dün Kore'ye geri döndü.",
        "uk": "Мій батько вчора повернувся до Кореї.",
        "vi": "Bố tôi đã về Hàn Quốc hôm qua.",
        "yue": "我爸爸噚日返咗韓國。",
        "zh-Hans": "我爸爸昨天回韩国了。"
      },
