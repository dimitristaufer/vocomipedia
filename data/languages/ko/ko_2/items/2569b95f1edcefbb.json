  "sentences": [
    {
      "target": "감기에 걸렸지만 지금은 많이 회복했어요.",
      "reading": "gamgie geollyeotjiman jigeumeun mani hoebokhaesseoyo.",
      "translations": {
        "en": "I caught a cold, but I'm much better now.",
        "ko": "감기에 걸렸지만 지금은 많이 회복했어요.",
        "ipa": "gamgie geollyeotjiman jigeumeun mani hoebokhaesseoyo.",
        "ar": "أصبتُ بالزكام، لكنني أصبحتُ أفضل بكثير الآن.",
        "cs": "Chytil jsem nachlazení, ale teď je mi mnohem lépe.",
        "da": "Jeg blev forkølet, men jeg har det meget bedre nu.",
        "de": "Ich habe mich erkältet, aber jetzt geht es mir viel besser.",
        "el": "Έχω κρυολογήσει, αλλά τώρα είμαι πολύ καλύτερα.",
        "es": "Me resfrié, pero ahora estoy mucho mejor.",
        "fi": "Sain flunssan, mutta voin nyt paljon paremmin.",
        "fr": "J'ai attrapé un rhume, mais je vais beaucoup mieux maintenant.",
        "he": "תפסתי הצטננות, אבל עכשיו אני מרגיש הרבה יותר טוב.",
        "hi": "मुझे सर्दी लग गई थी, लेकिन अब मैं काफी बेहतर हूँ।",
        "hu": "Megfáztam, de most már sokkal jobban vagyok.",
        "id": "Saya kena flu, tapi sekarang saya sudah jauh lebih baik.",
        "it": "Ho preso il raffreddore, ma ora sto molto meglio.",
        "ja": "風邪をひきましたが、今はだいぶ良くなりました。",
        "nb": "Jeg har blitt forkjølet, men jeg er mye bedre nå.",
        "nl": "Ik heb griep gekregen, maar het gaat nu veel beter met me.",
        "pl": "Przeziębiłem się, ale teraz czuję się dużo lepiej.",
        "pt": "Fiquei constipado, mas agora estou muito melhor.",
        "ro": "Am răcit, dar acum mă simt mult mai bine.",
        "ru": "Я простудился, но теперь мне уже намного лучше.",
        "sv": "Jag har blivit förkyld, men jag mår mycket bättre nu.",
        "tr": "Soğuk algınlığına yakalandım ama şimdi çok daha iyiyim.",
        "uk": "Я застудився, але тепер мені вже набагато краще.",
        "vi": "Tôi bị cảm, nhưng bây giờ tôi đỡ nhiều rồi.",
        "yue": "我感冒咗，但而家好咗好多。",
        "zh-Hans": "我感冒了，但现在好多了。"
      },
