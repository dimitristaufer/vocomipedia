  "sentences": [
    {
      "target": "그 청년은 버스에서 자리를 양보했어요.",
      "reading": "geu cheongnyeoneun beoseueseo jarireul yangbohaesseoyo.",
      "translations": {
        "en": "That young man gave up his seat on the bus.",
        "ko": "그 청년은 버스에서 자리를 양보했어요.",
        "ipa": "geu cheongnyeoneun beoseueseo jarireul yangbohaesseoyo.",
        "ar": "ذلك الشاب تنازل عن مقعده في الحافلة.",
        "cs": "Ten mladík v autobuse přepustil místo.",
        "da": "Den unge mand gav sin plads i bussen.",
        "de": "Der junge Mann hat im Bus seinen Platz angeboten.",
        "el": "Εκείνος ο νεαρός παραχώρησε τη θέση του στο λεωφορείο.",
        "es": "Ese joven le cedió el asiento en el autobús.",
        "fi": "Se nuorukainen luovutti paikkansa bussissa.",
        "fr": "Ce jeune homme a cédé sa place dans le bus.",
        "he": "הצעיר הזה ויתר על המושב שלו באוטובוס.",
        "hi": "उस युवक ने बस में अपनी सीट दे दी।",
        "hu": "Az a fiatalember átadta a helyét a buszon.",
        "id": "Pemuda itu memberikan tempat duduknya di bus.",
        "it": "Quel giovane ha ceduto il posto sull'autobus.",
        "ja": "その青年はバスで席を譲りました。",
        "nb": "Den unge mannen ga fra seg setet sitt på bussen.",
        "nl": "Die jongeman gaf zijn plek in de bus op.",
        "pl": "Ten młody mężczyzna ustąpił miejsca w autobusie.",
        "pt": "Aquele jovem cedeu o lugar no ônibus.",
        "ro": "Tânărul acela i-a cedat locul în autobuz.",
        "ru": "Тот молодой человек уступил место в автобусе.",
        "sv": "Den unge mannen gav upp sin plats på bussen.",
        "tr": "O genç adam otobüste yerini verdi.",
        "uk": "Той молодий чоловік поступився місцем в автобусі.",
        "vi": "Chàng trai đó đã nhường chỗ trên xe buýt.",
        "yue": "嗰個青年喺巴士上讓咗個位俾人。",
        "zh-Hans": "那个青年在公交车上让座了。"
      },
