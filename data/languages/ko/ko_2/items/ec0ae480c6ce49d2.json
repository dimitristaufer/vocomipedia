    {
      "target": "우리 언젠가 다시 만나요.",
      "reading": "uri eonjenga dasi mannayo.",
      "translations": {
        "en": "Let's meet again someday.",
        "ko": "우리 언젠가 다시 만나요.",
        "ipa": "uri eonjenga dasi mannayo.",
        "ar": "لِنلتقِ مجددا يوما ما.",
        "cs": "Setkejme se zase někdy.",
        "da": "Lad os mødes igen en dag.",
        "de": "Lass uns eines Tages wieder treffen.",
        "el": "Ας ξαναβρεθούμε κάποτε.",
        "es": "Volvamos a vernos algún día.",
        "fi": "Tavataan taas joskus.",
        "fr": "Retrouvons-nous un jour.",
        "he": "בואו ניפגש שוב מתישהו.",
        "hi": "चलो कभी फिर मिलते हैं।",
        "hu": "Találkozzunk még valamikor.",
        "id": "Mari kita bertemu lagi suatu hari nanti.",
        "it": "Rivediamoci un giorno.",
        "ja": "またいつか会いましょう。",
        "nb": "La oss møtes igjen en dag.",
        "nl": "Laten we elkaar ooit weer zien.",
        "pl": "Spotkajmy się kiedyś znowu.",
        "pt": "Vamos nos encontrar de novo algum dia.",
        "ro": "Să ne mai întâlnim cândva.",
        "ru": "Давай когда-нибудь снова встретимся.",
        "sv": "Vi kan väl ses igen någon gång.",
        "tr": "Bir gün yine buluşalım.",
        "uk": "Давай колись знову зустрінемося.",
        "vi": "Mình gặp lại nhau một ngày nào đó nhé.",
        "yue": "我哋改日再見啦。",
        "zh-Hans": "我们总有一天再见面吧。"
      },
