  "sentences": [
    {
      "target": "언젠가 제주도에 가 보고 싶어요.",
      "reading": "eonjenga jejudoe ga bogo sipeoyo.",
      "translations": {
        "en": "One day, I'd like to visit Jeju Island.",
        "ko": "언젠가 제주도에 가 보고 싶어요.",
        "ipa": "eonjenga jejudoe ga bogo sipeoyo.",
        "ar": "أود أن أزور جزيرة جيجو يوما ما.",
        "cs": "Někdy bych chtěl navštívit ostrov Jeju.",
        "da": "Jeg kunne godt tænke mig at besøge Jeju-øen en dag.",
        "de": "Eines Tages möchte ich die Insel Jeju besuchen.",
        "el": "Κάποτε θα ήθελα να επισκεφτώ το νησί Τζέτζου.",
        "es": "Algún día me gustaría visitar la isla de Jeju.",
        "fi": "Haluaisin joskus käydä Jejun saarella.",
        "fr": "J'aimerais visiter l'île de Jeju un jour.",
        "he": "אני רוצה לבקר באי ג'ג'ו יום אחד.",
        "hi": "कभी मैं जेजू द्वीप जाना चाहूंगा।",
        "hu": "Egyszer szeretnék ellátogatni Csedzsu szigetére.",
        "id": "Suatu hari nanti, saya ingin mengunjungi Pulau Jeju.",
        "it": "Un giorno vorrei visitare l'isola di Jeju.",
        "ja": "いつか済州島に行ってみたいです。",
        "nb": "Jeg har lyst til å besøke Jeju-øya en dag.",
        "nl": "Ik wil ooit eens naar Jejudo gaan.",
        "pl": "Kiedyś chciałbym odwiedzić wyspę Jeju.",
        "pt": "Um dia eu gostaria de visitar a ilha de Jeju.",
        "ro": "Aș vrea să vizitez insula Jeju într-o zi.",
        "ru": "Когда-нибудь я хотел бы побывать на острове Чеджу.",
        "sv": "Jag skulle gärna vilja besöka Jeju-ön någon gång.",
        "tr": "Bir gün Jeju Adası'nı ziyaret etmek istiyorum.",
        "uk": "Колись я хотів би побувати на острові Чеджу.",
        "vi": "Một ngày nào đó, tôi muốn đến thăm đảo Jeju.",
        "yue": "總有一日我想去濟州島睇吓。",
        "zh-Hans": "总有一天我想去济州岛看看。"
      },
