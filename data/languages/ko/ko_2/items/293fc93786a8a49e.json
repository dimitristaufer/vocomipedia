  "sentences": [
    {
      "target": "힘들어도 견디다 보면 끝이 보여요.",
      "reading": "힘드러도 견디다 보면 끄치 보여요.",
      "translations": {
        "en": "If you endure it, you'll see the end.",
        "ko": "힘들어도 견디다 보면 끝이 보여요.",
        "ipa": "힘드러도 견디다 보면 끄치 보여요.",
        "ar": "إذا صبرت، فسترى النهاية.",
        "cs": "Když to vydržíš, uvidíš konec.",
        "da": "Hvis du holder ud, ser du enden.",
        "de": "Wenn du es aushältst, siehst du das Ende.",
        "el": "Αν το αντέξεις, θα δεις το τέλος.",
        "es": "Si lo aguantas, verás el final.",
        "fi": "Jos kestät sen, näet lopun.",
        "fr": "Si tu tiens bon, tu verras la fin.",
        "he": "אם תתמיד, תראה את הסוף.",
        "hi": "अगर तुम इसे सहोगे, तो अंत दिखेगा।",
        "hu": "Ha kibírod, látni fogod a végét.",
        "id": "Kalau kamu bertahan, kamu akan melihat akhirnya.",
        "it": "Se resisti, vedrai la fine.",
        "ja": "がまんしていれば、終わりが見えてきます。",
        "nb": "Hvis du holder ut, ser du slutten.",
        "nl": "Als je het volhoudt, zie je het einde.",
        "pl": "Jeśli to wytrzymasz, zobaczysz koniec.",
        "pt": "Se você aguentar, vai ver o fim.",
        "ro": "Dacă reziști, vei vedea sfârșitul.",
        "ru": "Если вытерпишь, увидишь конец.",
        "sv": "Om du härdar ut ser du slutet.",
        "tr": "Dayanırsan sonunu göreceksin.",
        "uk": "Якщо витерпиш, побачиш кінець.",
        "vi": "Nếu chịu đựng thì bạn sẽ thấy điểm cuối.",
        "yue": "如果你捱得住，就會見到盡頭。",
        "zh-Hans": "如果你坚持下去，就会看到尽头。"
      },
