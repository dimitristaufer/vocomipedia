    {
      "target": "두 반을 통합해서 수업을 해요.",
      "reading": "du baneul tonghaphaseo sueobeul haeyo.",
      "translations": {
        "en": "We combine the two classes for the lesson.",
        "ko": "두 반을 통합해서 수업을 해요.",
        "ipa": "du baneul tonghaphaseo sueobeul haeyo.",
        "ar": "نجمع بين الصفين في الدرس.",
        "cs": "Na hodinu spojujeme dvě třídy.",
        "da": "Vi slår de to klasser sammen til timen.",
