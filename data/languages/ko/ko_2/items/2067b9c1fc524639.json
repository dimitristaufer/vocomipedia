  "sentences": [
    {
      "target": "어릴 때 동화를 자주 읽었어요.",
      "reading": "eoril ttae donghwareul jaju ilgeosseoyo.",
      "translations": {
        "en": "I used to read fairy tales often when I was young.",
        "ko": "어릴 때 동화를 자주 읽었어요.",
        "ipa": "eoril ttae donghwareul jaju ilgeosseoyo.",
        "ar": "كنت أقرأ الحكايات الخرافية كثيرًا عندما كنت صغيرًا.",
        "cs": "Když jsem byl malý, často jsem četl pohádky.",
        "da": "Jeg læste ofte eventyr, da jeg var lille.",
        "de": "Ich habe als Kind oft Märchen gelesen.",
        "el": "Όταν ήμουν μικρός, διάβαζα συχνά παραμύθια.",
        "es": "Leía cuentos de hadas a menudo cuando era pequeño.",
        "fi": "Luin usein satuja, kun olin pieni.",
        "fr": "Je lisais souvent des contes quand j'étais petit.",
        "he": "כשהייתי קטן, קראתי הרבה אגדות.",
        "hi": "जब मैं छोटा था, मैं अक्सर परीकथाएँ पढ़ता था।",
        "hu": "Gyerekkoromban gyakran olvastam meséket.",
        "id": "Saat masih kecil, saya sering membaca dongeng.",
        "it": "Da piccolo leggevo spesso le fiabe.",
        "ja": "子どものころ、よく童話を読みました。",
        "nb": "Jeg leste ofte eventyr da jeg var liten.",
        "nl": "Toen ik klein was, las ik vaak sprookjes.",
        "pl": "Kiedy byłem mały, często czytałem baśnie.",
        "pt": "Quando eu era pequeno, eu lia contos de fadas com frequência.",
        "ro": "Când eram mic, citeam des povești.",
        "ru": "Когда я был маленьким, я часто читал сказки.",
        "sv": "När jag var liten läste jag ofta sagor.",
        "tr": "Küçükken sık sık masal okurdum.",
        "uk": "Коли я був маленький, я часто читав казки.",
        "vi": "Hồi nhỏ, tôi thường đọc truyện cổ tích.",
        "yue": "細個嗰陣，我成日睇童話故事。",
        "zh-Hans": "我小时候经常读童话。"
      },
