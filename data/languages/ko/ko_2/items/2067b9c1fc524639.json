    {
      "target": "아이에게 동화를 읽어 줬어요.",
      "reading": "aiege donghwareul ilgeo jwosseoyo.",
      "translations": {
        "en": "I read a fairy tale to the child.",
        "ko": "아이에게 동화를 읽어 줬어요.",
        "ipa": "aiege donghwareul ilgeo jwosseoyo.",
        "ar": "قرأت للطفل حكاية خرافية.",
        "cs": "Přečetl jsem dítěti pohádku.",
        "da": "Jeg læste et eventyr for barnet.",
        "de": "Ich habe dem Kind ein Märchen vorgelesen.",
        "el": "Διάβασα ένα παραμύθι στο παιδί.",
        "es": "Le leí un cuento de hadas al niño.",
        "fi": "Luin lapselle sadun.",
        "fr": "J'ai lu un conte à l'enfant.",
        "he": "קראתי לילד סיפור אגדה.",
        "hi": "मैंने बच्चे को एक परीकथा सुनाई।",
        "hu": "Felolvastam a gyereknek egy mesét.",
        "id": "Saya membacakan dongeng untuk anak itu.",
        "it": "Ho letto una fiaba al bambino.",
        "ja": "子どもに童話を読んであげました。",
        "nb": "Jeg leste et eventyr for barnet.",
        "nl": "Ik las het kind een sprookje voor.",
        "pl": "Przeczytałem dziecku baśń.",
        "pt": "Li um conto de fadas para a criança.",
        "ro": "I-am citit o poveste copilului.",
        "ru": "Я прочитал ребёнку сказку.",
        "sv": "Jag läste en saga för barnet.",
        "tr": "Çocuğa bir masal okudum.",
        "uk": "Я прочитав дитині казку.",
        "vi": "Tôi đã đọc một câu chuyện cổ tích cho đứa trẻ nghe.",
        "yue": "我讀咗個童話故事畀個細路聽。",
        "zh-Hans": "我给孩子读了一个童话。"
      },
