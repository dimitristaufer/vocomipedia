  "sentences": [
    {
      "target": "회의 전에 짧은 인사말을 했어요.",
      "reading": "hoeui jeone jjalbeun insamareul haesseoyo.",
      "translations": {
        "en": "I gave a brief greeting before the meeting.",
        "ko": "회의 전에 짧은 인사말을 했어요.",
        "ipa": "hoeui jeone jjalbeun insamareul haesseoyo.",
        "ar": "ألقيت تحية قصيرة قبل الاجتماع.",
        "cs": "Před schůzkou jsem řekl krátký pozdrav.",
        "da": "Jeg gav en kort hilsen før mødet.",
        "de": "Ich habe vor dem Treffen kurz gegrüßt.",
        "el": "Έδωσα έναν σύντομο χαιρετισμό πριν από τη συνάντηση.",
        "es": "Dije un breve saludo antes de la reunión.",
        "fi": "Sanoin lyhyen tervehdyksen ennen kokousta.",
        "fr": "J'ai fait un bref salut avant la réunion.",
        "he": "אמרתי ברכה קצרה לפני הישיבה.",
        "hi": "मैंने बैठक से पहले एक छोटा-सा अभिवादन किया।",
        "hu": "Egy rövid köszöntést mondtam az értekezlet előtt.",
        "id": "Saya mengucapkan salam singkat sebelum rapat.",
        "it": "Ho fatto un breve saluto prima della riunione.",
        "ja": "会議の前に短いあいさつをしました。",
        "nb": "Jeg ga en kort hilsen før møtet.",
        "nl": "Ik hield een korte groet voor de vergadering.",
        "pl": "Wygłosiłem krótkie powitanie przed spotkaniem.",
        "pt": "Fiz uma breve saudação antes da reunião.",
        "ro": "Am spus un scurt salut înainte de ședință.",
        "ru": "Я сказал короткое приветствие перед совещанием.",
        "sv": "Jag gav en kort hälsning före mötet.",
        "tr": "Toplantıdan önce kısa bir selam verdim.",
        "uk": "Я сказав коротке привітання перед зустріччю.",
        "vi": "Tôi đã nói lời chào ngắn trước cuộc họp.",
        "yue": "會議前我講咗一句簡短嘅問候。",
        "zh-Hans": "我在会议前简短地问候了一下。"
      },
