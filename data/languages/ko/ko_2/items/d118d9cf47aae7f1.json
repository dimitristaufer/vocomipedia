  "sentences": [
    {
      "target": "내후년에는 새 집으로 이사할 거예요.",
      "reading": "naehunyeon-eneun sae jip-euro isa hal geoyeyo.",
      "translations": {
        "en": "I’m going to move into a new house the year after next.",
        "ko": "내후년에는 새 집으로 이사할 거예요.",
        "ipa": "naehunyeon-eneun sae jip-euro isa hal geoyeyo.",
        "ar": "سأنتقل إلى بيت جديد بعد العام القادم.",
        "cs": "Příští rok po příštím se stěhujeme do nového domu.",
        "da": "Vi flytter ind i et nyt hus om to år.",
        "de": "Übernächstes Jahr ziehe ich in ein neues Haus.",
        "el": "Μεθαύριο θα μετακομίσω σε καινούριο σπίτι.",
        "es": "Me mudaré a una casa nueva dentro de dos años.",
        "fi": "Muutan uuteen taloon ylihuomenna vuoden kuluttua.",
        "fr": "Je vais déménager dans une nouvelle maison dans deux ans.",
        "he": "אני אעבור לבית חדש בעוד שנתיים.",
        "hi": "मैं परसों के बाद वाले साल एक नए घर में शिफ्ट हो जाऊँगा।",
        "hu": "Két év múlva új házba költözöm.",
        "id": "Saya akan pindah ke rumah baru lusa tahun depan.",
        "it": "Tra due anni mi trasferirò in una casa nuova.",
        "ja": "再来年には新しい家に引っ越す予定です。",
        "nb": "Jeg skal flytte inn i et nytt hus om to år.",
        "nl": "Over twee jaar verhuis ik naar een nieuw huis.",
        "pl": "Za dwa lata przeprowadzę się do nowego domu.",
        "pt": "Daqui a dois anos, vou me mudar para uma casa nova.",
        "ro": "Peste doi ani mă voi muta într-o casă nouă.",
        "ru": "Через два года я перееду в новый дом.",
        "sv": "Om två år flyttar jag till ett nytt hus.",
        "tr": "Öbür sene yeni bir eve taşınacağım.",
        "uk": "За два роки я переїду в новий будинок.",
        "vi": "Hai năm nữa tôi sẽ chuyển vào một ngôi nhà mới.",
        "yue": "後年我會搬入新屋。",
        "zh-Hans": "后年我会搬进新房子。"
      },
