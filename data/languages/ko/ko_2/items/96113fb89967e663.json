    {
      "target": "저는 의류 매장에서 일해요.",
      "reading": "jeoneun uiryu maejangeseo ilhaeyo.",
      "translations": {
        "en": "I work at a clothing store.",
        "ko": "저는 의류 매장에서 일해요.",
        "ipa": "jeoneun uiryu maejangeseo ilhaeyo.",
        "ar": "أعمل في متجر ملابس.",
        "cs": "Pracuji v obchodě s oblečením.",
        "da": "Jeg arbejder i en tøjbutik.",
        "de": "Ich arbeite in einem Bekleidungsgeschäft.",
        "el": "Δουλεύω σε ένα κατάστημα ρούχων.",
        "es": "Trabajo en una tienda de ropa.",
        "fi": "Työskentelen vaatekaupassa.",
        "fr": "Je travaille dans un magasin de vêtements.",
        "he": "אני עובד בחנות בגדים.",
        "hi": "मैं कपड़ों की दुकान में काम करता हूँ।",
        "hu": "Egy ruhaboltban dolgozom.",
        "id": "Saya bekerja di toko pakaian.",
        "it": "Lavoro in un negozio di abbigliamento.",
        "ja": "私は衣料品店で働いています。",
        "nb": "Jeg jobber i en klesbutikk.",
        "nl": "Ik werk in een kledingwinkel.",
        "pl": "Pracuję w sklepie z odzieżą.",
        "pt": "Trabalho numa loja de roupas.",
        "ro": "Lucrez într-un magazin de haine.",
        "ru": "Я работаю в магазине одежды.",
        "sv": "Jag jobbar i en klädbutik.",
        "tr": "Bir giyim mağazasında çalışıyorum.",
        "uk": "Я працюю в магазині одягу.",
