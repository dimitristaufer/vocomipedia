  "sentences": [
    {
      "target": "오늘은 빌린 돈을 갚을게요.",
      "reading": "oneureun billin doneul gapeulgeyo.",
      "translations": {
        "en": "I'll pay back the money I borrowed today.",
        "ko": "오늘은 빌린 돈을 갚을게요.",
        "ipa": "oneureun billin doneul gapeulgeyo.",
        "ar": "سأعيد المال الذي اقترضته اليوم.",
        "cs": "Dnes vrátím peníze, které jsem si půjčil.",
        "da": "Jeg betaler pengene tilbage, som jeg lånte i dag.",
        "de": "Ich zahle das Geld zurück, das ich mir heute geliehen habe.",
        "el": "Θα ξεχρεώσω τα χρήματα που δανείστηκα σήμερα.",
        "es": "Hoy devolveré el dinero que pedí prestado.",
        "fi": "Maksan tänään takaisin lainatut rahat.",
        "fr": "Je vais rembourser l'argent que j'ai emprunté aujourd'hui.",
        "he": "אני אחזיר היום את הכסף שלוויתי.",
        "hi": "मैं आज उधार लिया हुआ पैसा वापस दूँगा।",
        "hu": "Ma visszafizetem a kölcsönkért pénzt.",
        "id": "Saya akan membayar kembali uang yang saya pinjam hari ini.",
        "it": "Oggi restituirò i soldi che ho preso in prestito.",
        "ja": "今日は借りたお金を返します。",
        "nb": "Jeg skal betale tilbake pengene jeg lånte i dag.",
        "nl": "Ik betaal het geld dat ik vandaag heb geleend terug.",
        "pl": "Dziś oddam pieniądze, które pożyczyłem.",
        "pt": "Hoje vou devolver o dinheiro que peguei emprestado.",
        "ro": "O să returnez banii pe care i-am împrumutat azi.",
        "ru": "Сегодня я верну деньги, которые занял.",
        "sv": "Jag ska betala tillbaka pengarna jag lånade i dag.",
        "tr": "Bugün borç aldığım parayı geri ödeyeceğim.",
        "uk": "Сьогодні я поверну гроші, які позичив.",
        "vi": "Hôm nay tôi sẽ trả lại số tiền đã mượn.",
        "yue": "我今日會還返我借咗嘅錢。",
        "zh-Hans": "我今天会还我借的钱。"
      },
