    {
      "target": "카운터에서 커피를 주문했어요.",
      "reading": "kaunteoeseo keopireul jumunhaesseoyo.",
      "translations": {
        "en": "I ordered coffee at the counter.",
        "ko": "카운터에서 커피를 주문했어요.",
        "ipa": "kaunteoeseo keopireul jumunhaesseoyo.",
        "ar": "طلبت قهوة عند الكاونتر.",
        "cs": "Objednal jsem si kávu u pultu.",
        "da": "Jeg bestilte kaffe ved disken.",
        "de": "Ich habe am Tresen Kaffee bestellt.",
        "el": "Παρήγγειλα καφέ στο γκισέ.",
        "es": "Pedí café en el mostrador.",
        "fi": "Tilasin kahvin tiskiltä.",
        "fr": "J'ai commandé un café au comptoir.",
        "he": "הזמנתי קפה בדלפק.",
        "hi": "मैंने काउंटर पर कॉफी ऑर्डर की।",
        "hu": "A pultnál kértem egy kávét.",
        "id": "Saya memesan kopi di konter.",
        "it": "Ho ordinato un caffè al bancone.",
        "ja": "カウンターでコーヒーを注文しました。",
        "nb": "Jeg bestilte kaffe ved disken.",
        "nl": "Ik bestelde koffie aan de balie.",
        "pl": "Zamówiłem kawę przy ladzie.",
        "pt": "Pedi um café no balcão.",
        "ro": "Am comandat o cafea la tejghea.",
        "ru": "Я заказал кофе у стойки.",
        "sv": "Jag beställde kaffe vid disken.",
        "tr": "Tezgahta kahve sipariş ettim.",
        "uk": "Я замовив каву біля прилавка.",
        "vi": "Tôi đã gọi cà phê ở quầy.",
        "yue": "我喺櫃檯叫咗杯咖啡。",
        "zh-Hans": "我在柜台点了咖啡。"
      },
