  "sentences": [
    {
      "target": "저는 이 음반을 자주 들어요.",
      "reading": "jeoneun i eumbaneul jaju deureoyo.",
      "translations": {
        "en": "I listen to this record often.",
        "ko": "저는 이 음반을 자주 들어요.",
        "ipa": "jeoneun i eumbaneul jaju deureoyo.",
        "ar": "أستمع إلى هذا الأسطوانة كثيرًا.",
        "cs": "Tuhle desku poslouchám často.",
        "da": "Jeg lytter ofte til denne plade.",
        "de": "Ich höre diese Platte oft.",
        "el": "Ακούω συχνά αυτόν τον δίσκο.",
        "es": "Escucho este disco a menudo.",
        "fi": "Kuuntelen tätä levyä usein.",
        "fr": "J'écoute souvent ce disque.",
        "he": "אני מקשיב לתקליט הזה לעיתים קרובות.",
        "hi": "मैं इस रिकॉर्ड को अक्सर सुनता हूँ।",
        "hu": "Gyakran hallgatom ezt a lemezt.",
        "id": "Saya sering mendengarkan piringan hitam ini.",
        "it": "Ascolto spesso questo disco.",
        "ja": "私はこのレコードをよく聴きます。",
        "nb": "Jeg hører ofte på denne platen.",
        "nl": "Ik luister vaak naar deze plaat.",
        "pl": "Często słucham tej płyty.",
        "pt": "Eu ouço este disco com frequência.",
        "ro": "Ascult des acest disc.",
        "ru": "Я часто слушаю эту пластинку.",
        "sv": "Jag lyssnar ofta på den här skivan.",
        "tr": "Bu plağı sık sık dinlerim.",
        "uk": "Я часто слухаю цю платівку.",
        "vi": "Tôi thường nghe đĩa nhạc này.",
        "yue": "我成日聽呢隻黑膠碟。",
        "zh-Hans": "我经常听这张唱片。"
      },
