    {
      "target": "아이가 창문 밖으로 고개를 내밀어요.",
      "reading": "aiga changmun bakkeuro gogaereul naemileoyo",
      "translations": {
        "en": "The child sticks his head out the window.",
        "ko": "아이가 창문 밖으로 고개를 내밀어요.",
        "ipa": "aiga changmun bakkeuro gogaereul naemileoyo",
        "ar": "أخرج الطفل رأسه من النافذة.",
        "cs": "Dítě vystrčí hlavu z okna.",
        "da": "Barnet stikker hovedet ud ad vinduet.",
        "de": "Das Kind steckt den Kopf aus dem Fenster.",
        "el": "Το παιδί βγάζει το κεφάλι του έξω από το παράθυρο.",
        "es": "El niño saca la cabeza por la ventana.",
        "fi": "Lapsi työntää päänsä ulos ikkunasta.",
        "fr": "L'enfant passe la tête par la fenêtre.",
        "he": "הילד מוציא את הראש שלו מהחלון.",
        "hi": "बच्चा खिड़की से अपना सिर बाहर निकालता है।",
        "hu": "A gyerek kidugja a fejét az ablakon.",
        "id": "Anak itu menjulurkan kepalanya ke luar jendela.",
        "it": "Il bambino sporge la testa dalla finestra.",
        "ja": "子どもが窓から頭を出します。",
        "nb": "Barnet stikker hodet ut av vinduet.",
        "nl": "Het kind steekt zijn hoofd uit het raam.",
        "pl": "Dziecko wychyla głowę przez okno.",
        "pt": "A criança põe a cabeça para fora da janela.",
        "ro": "Copilul își scoate capul pe fereastră.",
        "ru": "Ребёнок высунул голову из окна.",
        "sv": "Barnet sticker ut huvudet genom fönstret.",
        "tr": "Çocuk başını pencereden dışarı çıkarıyor.",
        "uk": "Дитина висовує голову з вікна.",
        "vi": "Đứa trẻ thò đầu ra ngoài cửa sổ.",
        "yue": "個小朋友將頭伸出窗外。",
        "zh-Hans": "孩子把头探出窗外。"
      },
