    {
      "target": "친구가 저에게 손을 내밀어요.",
      "reading": "chinguga jeoege soneul naemileoyo",
      "translations": {
        "en": "My friend reaches out a hand to me.",
        "ko": "친구가 저에게 손을 내밀어요.",
        "ipa": "chinguga jeoege soneul naemileoyo",
        "ar": "مدّ صديقي يده إليّ.",
        "cs": "Můj kamarád ke mně natáhne ruku.",
        "da": "Min ven rækker hånden ud til mig.",
        "de": "Mein Freund streckt mir die Hand entgegen.",
        "el": "Ο φίλος μου μου απλώνει το χέρι.",
        "es": "Mi amigo me tiende la mano.",
        "fi": "Ystäväni ojentaa minulle kätensä.",
        "fr": "Mon ami me tend la main.",
        "he": "החבר שלי מושיט לי יד.",
        "hi": "मेरा दोस्त मेरी ओर हाथ बढ़ाता है।",
        "hu": "A barátom felém nyújtja a kezét.",
        "id": "Teman saya mengulurkan tangannya kepada saya.",
        "it": "Il mio amico mi porge la mano.",
        "ja": "友達が私に手を差し伸べます。",
        "nb": "Vennen min rekker ut hånden til meg.",
        "nl": "Mijn vriend steekt zijn hand naar mij uit.",
        "pl": "Mój przyjaciel wyciąga do mnie rękę.",
        "pt": "Meu amigo estende a mão para mim.",
        "ro": "Prietenul meu îmi întinde mâna.",
        "ru": "Мой друг протягивает мне руку.",
        "sv": "Min vän räcker fram handen till mig.",
        "tr": "Arkadaşım bana elini uzatıyor.",
        "uk": "Мій друг простягає мені руку.",
        "vi": "Bạn tôi chìa tay ra với tôi.",
        "yue": "我朋友向我伸出手。",
        "zh-Hans": "我的朋友向我伸出手。"
      },
