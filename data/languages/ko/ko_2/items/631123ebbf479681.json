    {
      "target": "선생님이 먼저 손을 내밀어 악수했어요.",
      "reading": "seonsaengnimi meonjeo soneul naemireo aksuhaesseoyo",
      "translations": {
        "en": "The teacher reached out first and shook hands.",
        "ko": "선생님이 먼저 손을 내밀어 악수했어요.",
        "ipa": "seonsaengnimi meonjeo soneul naemireo aksuhaesseoyo",
        "ar": "مدّ المعلم يده أولًا وصافح.",
        "cs": "Učitel nejdřív natáhl ruku a podal si ji na pozdrav.",
        "da": "Læreren rakte først hånden frem og gav hånd.",
        "de": "Der Lehrer streckte zuerst die Hand aus und schüttelte die Hand.",
        "el": "Ο δάσκαλος άπλωσε πρώτος το χέρι και έσφιξαν τα χέρια.",
        "es": "El profesor tendió primero la mano y se dieron la mano.",
        "fi": "Opettaja ojensi ensin kätensä ja kätteli.",
        "fr": "Le professeur a tendu la main le premier et a serré la main.",
        "he": "המורה הושיט את ידו קודם ולחץ ידיים.",
        "hi": "शिक्षक ने पहले हाथ बढ़ाया और हाथ मिलाया।",
        "hu": "A tanár először nyújtotta a kezét, és kezet fogtak.",
        "id": "Guru itu lebih dulu mengulurkan tangan dan berjabat tangan.",
        "it": "L'insegnante ha teso per primo la mano e ha stretto la mano.",
        "ja": "先生が先に手を差し出して握手しました。",
        "nb": "Læreren rakte først ut hånden og tok hånd.",
        "nl": "De leraar stak eerst zijn hand uit en schudde handen.",
        "pl": "Nauczyciel pierwszy wyciągnął rękę i uścisnęli sobie dłonie.",
        "pt": "O professor estendeu a mão primeiro e apertou a mão.",
        "ro": "Profesorul a întins primul mâna și au dat mâna.",
        "ru": "Учитель первым протянул руку и поздоровался за руку.",
        "sv": "Läraren räckte först fram handen och skakade hand.",
        "tr": "Öğretmen önce elini uzattı ve tokalaştılar.",
        "uk": "Учитель першим простягнув руку й потиснув руку.",
        "vi": "Thầy giáo chìa tay ra trước và bắt tay.",
        "yue": "老師先伸出手，同人握手。",
        "zh-Hans": "老师先伸出手来握手了。"
      },
