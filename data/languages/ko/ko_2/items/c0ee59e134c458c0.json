  "sentences": [
    {
      "target": "손님을 따뜻하게 맞이해요.",
      "reading": "sonnimeul ttatteutage majihaeyo.",
      "translations": {
        "en": "I welcome guests warmly.",
        "ko": "손님을 따뜻하게 맞이해요.",
        "ipa": "sonnimeul ttatteutage majihaeyo.",
        "ar": "أرحب بالضيوف بحرارة.",
        "cs": "Vítám hosty srdečně.",
        "da": "Jeg byder gæster varmt velkommen.",
        "de": "Ich heiße Gäste herzlich willkommen.",
        "el": "Υποδέχομαι θερμά τους επισκέπτες.",
        "es": "Recibo a los invitados con calidez.",
        "fi": "Otamme vieraat lämpimästi vastaan.",
        "fr": "J'accueille les invités chaleureusement.",
        "he": "אני מקבל את פני האורחים בחום.",
        "hi": "मैं मेहमानों का गर्मजोशी से स्वागत करता हूँ.",
        "hu": "Melegen üdvözlöm a vendégeket.",
        "id": "Saya menyambut para tamu dengan hangat.",
        "it": "Accolgo gli ospiti calorosamente.",
        "ja": "お客さんを温かく迎えます。",
        "nb": "Jeg tar varmt imot gjestene.",
        "nl": "Ik heet gasten hartelijk welkom.",
        "pl": "Serdecznie witam gości.",
        "pt": "Eu recebo os convidados com carinho.",
        "ro": "Îi primesc pe oaspeți cu căldură.",
        "ru": "Я тепло встречаю гостей.",
        "sv": "Jag tar varmt emot gästerna.",
        "tr": "Konukları sıcak bir şekilde karşılarım.",
        "uk": "Я тепло вітаю гостей.",
        "vi": "Tôi đón tiếp khách một cách thân mật.",
        "yue": "我熱情咁招呼客人。",
        "zh-Hans": "我热情地招待客人。"
      },
