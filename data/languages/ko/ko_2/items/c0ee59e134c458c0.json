    {
      "target": "부모님이 공항에서 저를 맞이했어요.",
      "reading": "bumonimi gonghangeseo jeoreul majihaesseoyo.",
      "translations": {
        "en": "My parents met me at the airport.",
        "ko": "부모님이 공항에서 저를 맞이했어요.",
        "ipa": "bumonimi gonghangeseo jeoreul majihaesseoyo.",
        "ar": "استقبلني والداي في المطار.",
        "cs": "Rodiče mě přivítali na letišti.",
        "da": "Mine forældre tog imod mig i lufthavnen.",
        "de": "Meine Eltern haben mich am Flughafen abgeholt.",
        "el": "Οι γονείς μου με υποδέχτηκαν στο αεροδρόμιο.",
        "es": "Mis padres me recibieron en el aeropuerto.",
        "fi": "Vanhempani olivat minua vastassa lentokentällä.",
        "fr": "Mes parents m'ont accueilli à l'aéroport.",
        "he": "ההורים שלי קיבלו את פניי בשדה התעופה.",
        "hi": "मेरे माता-पिता ने मेरा एयरपोर्ट पर स्वागत किया।",
        "hu": "A szüleim a repülőtéren fogadtak.",
        "id": "Orang tua saya menjemput saya di bandara.",
        "it": "I miei genitori mi hanno accolto all'aeroporto.",
        "ja": "両親が空港で私を迎えてくれました。",
        "nb": "Foreldrene mine møtte meg på flyplassen.",
        "nl": "Mijn ouders hebben me op het vliegveld opgewacht.",
        "pl": "Moi rodzice przywitali mnie na lotnisku.",
        "pt": "Meus pais me receberam no aeroporto.",
        "ro": "Părinții mei m-au întâmpinat la aeroport.",
        "ru": "Родители встретили меня в аэропорту.",
        "sv": "Mina föräldrar mötte mig på flygplatsen.",
        "tr": "Ailem beni havaalanında karşıladı.",
        "uk": "Мої батьки зустріли мене в аеропорту.",
        "vi": "Bố mẹ tôi đón tôi ở sân bay.",
        "yue": "我父母喺機場接我。",
        "zh-Hans": "我的父母在机场接我。"
      },
