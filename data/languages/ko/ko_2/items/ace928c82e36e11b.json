  "sentences": [
    {
      "target": "부모님은 교육을 중요하게 생각하세요.",
      "reading": "bumonimeun gyoyugeul jungyohage saenggakaseyo.",
      "translations": {
        "en": "My parents value education.",
        "ko": "부모님은 교육을 중요하게 생각하세요.",
        "ipa": "bumonimeun gyoyugeul jungyohage saenggakaseyo.",
        "ar": "يقدّر والداي التعليم كثيرًا.",
        "cs": "Moji rodiče si cení vzdělání.",
        "da": "Mine forældre værdsætter uddannelse.",
        "de": "Meine Eltern halten Bildung für wichtig.",
        "el": "Οι γονείς μου δίνουν μεγάλη αξία στην εκπαίδευση.",
        "es": "Mis padres valoran la educación.",
        "fi": "Vanhempani arvostavat koulutusta.",
        "fr": "Mes parents accordent de l'importance à l'éducation.",
        "he": "ההורים שלי מעריכים חינוך.",
        "hi": "मेरे माता-पिता शिक्षा को बहुत महत्व देते हैं।",
        "hu": "A szüleim fontosnak tartják az oktatást.",
        "id": "Orang tua saya sangat menghargai pendidikan.",
        "it": "I miei genitori danno molta importanza all'istruzione.",
        "ja": "両親は教育を大切にしています。",
        "nb": "Foreldrene mine setter utdanning høyt.",
        "nl": "Mijn ouders hechten veel waarde aan onderwijs.",
        "pl": "Moi rodzice cenią edukację.",
        "pt": "Meus pais valorizam a educação.",
        "ro": "Părinții mei pun mare preț pe educație.",
        "ru": "Мои родители ценят образование.",
        "sv": "Mina föräldrar värdesätter utbildning.",
        "tr": "Ailem eğitime çok önem veriyor.",
        "uk": "Мої батьки цінують освіту.",
        "vi": "Bố mẹ tôi rất coi trọng giáo dục.",
        "yue": "我父母好重視教育。",
        "zh-Hans": "我父母很重视教育。"
