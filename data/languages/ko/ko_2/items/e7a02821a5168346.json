  "sentences": [
    {
      "target": "그는 친구를 잃고 슬퍼하다가 잠들었어요.",
      "reading": "geuneun chingureul ilggo seulpeohadaga jamdeureosseoyo",
      "translations": {
        "en": "He fell asleep after mourning his friend.",
        "ko": "그는 친구를 잃고 슬퍼하다가 잠들었어요.",
        "ipa": "geuneun chingureul ilggo seulpeohadaga jamdeureosseoyo",
        "ar": "نام بعد أن حزن على صديقه.",
        "cs": "Usnul poté, co truchlil pro svého přítele.",
        "da": "Han faldt i søvn efter at have sørget over sin ven.",
        "de": "Er schlief ein, nachdem er um seinen Freund getrauert hatte.",
        "el": "Κοιμήθηκε αφού θρήνησε τον φίλο του.",
        "es": "Se durmió después de lamentar la pérdida de su amigo.",
        "fi": "Hän nukahti surtuaan ystäväänsä.",
        "fr": "Il s’est endormi après avoir pleuré la mort de son ami.",
        "he": "הוא נרדם אחרי שהתאבל על חברו.",
        "hi": "वह अपने दोस्त को खोकर दुखी हुआ और फिर सो गया।",
        "hu": "A barátja elvesztése miatt szomorkodott, aztán elaludt.",
        "id": "Dia tertidur setelah berduka atas temannya.",
        "it": "Si è addormentato dopo aver pianto la morte del suo amico.",
        "ja": "彼は友達を失って悲しみ、そのまま眠ってしまいました。",
        "nb": "Han sovnet etter å ha sørget over vennen sin.",
        "nl": "Hij viel in slaap nadat hij om zijn vriend had gerouwd.",
        "pl": "Zasnął, opłakując swojego przyjaciela.",
        "pt": "Ele adormeceu depois de lamentar a morte do amigo.",
        "ro": "A adormit după ce l-a plâns pe prietenul său.",
        "ru": "Он заснул, скорбя по своему другу.",
        "sv": "Han somnade efter att ha sörjt sin vän.",
        "tr": "Arkadaşını kaybedince üzüldü ve sonra uyuyakaldı.",
        "uk": "Він заснув, сумуючи за своїм другом.",
        "vi": "Anh ấy ngủ thiếp đi sau khi đau buồn vì mất bạn.",
        "yue": "佢因為失去朋友而難過，跟住就瞓著咗。",
        "zh-Hans": "他因为失去朋友而难过，后来睡着了。"
      },
