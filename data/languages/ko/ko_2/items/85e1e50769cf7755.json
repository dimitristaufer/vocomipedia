    {
      "target": "아기가 갑자기 큰소리로 울었어요.",
      "reading": "agiga gapjagi keunsoriro ul-eosseoyo.",
      "translations": {
        "en": "The baby suddenly cried loudly.",
        "ko": "아기가 갑자기 큰소리로 울었어요.",
        "ipa": "agiga gapjagi keunsoriro ul-eosseoyo.",
        "ar": "بكى الطفل فجأة بصوت عالٍ.",
        "cs": "Dítě najednou začalo hlasitě plakat.",
        "da": "Babyen begyndte pludselig at græde højt.",
        "de": "Das Baby fing plötzlich laut an zu weinen.",
        "el": "Το μωρό έκλαψε ξαφνικά δυνατά.",
        "es": "El bebé empezó a llorar de repente en voz alta.",
        "fi": "Vauva alkoi yhtäkkiä itkeä kovaa.",
        "fr": "Le bébé s'est mis à pleurer fort tout à coup.",
        "he": "התינוק התחיל פתאום לבכות בקול רם.",
        "hi": "बच्चा अचानक ज़ोर से रोने लगा।",
        "hu": "A baba hirtelen hangosan sírni kezdett.",
        "id": "Bayi itu tiba-tiba menangis keras.",
        "it": "Il bambino ha pianto forte all'improvviso.",
        "ja": "赤ちゃんが急に大きな声で泣きました。",
        "nb": "Babyen begynte plutselig å gråte høyt.",
        "nl": "De baby begon ineens hard te huilen.",
        "pl": "Dziecko nagle zaczęło głośno płakać.",
        "pt": "O bebê começou a chorar alto de repente.",
        "ro": "Bebelușul a început să plângă tare dintr-odată.",
        "ru": "Ребёнок вдруг громко заплакал.",
        "sv": "Bebisen började plötsligt gråta högt.",
        "tr": "Bebek birden yüksek sesle ağladı.",
        "uk": "Дитина раптом голосно заплакала.",
        "vi": "Em bé bỗng nhiên khóc to.",
        "yue": "BB突然大聲喊咗。",
        "zh-Hans": "宝宝突然大声哭了。"
      },
