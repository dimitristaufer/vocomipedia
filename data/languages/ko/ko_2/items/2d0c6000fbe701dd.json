  "sentences": [
    {
      "target": "아이가 선생님 설명을 잘 알아듣어요.",
      "reading": "aiga seonsaengnim seolmyeongeul jal aradeureoyo.",
      "translations": {
        "en": "The child understands the teacher's explanation well.",
        "ko": "아이가 선생님 설명을 잘 알아듣어요.",
        "ipa": "aiga seonsaengnim seolmyeongeul jal aradeureoyo.",
        "ar": "يفهم الطفل شرح المعلمة جيدًا.",
        "cs": "Dítě dobře rozumí výkladu učitele.",
        "da": "Barnet forstår lærerens forklaring godt.",
        "de": "Das Kind versteht die Erklärung des Lehrers gut.",
        "el": "Το παιδί καταλαβαίνει καλά την εξήγηση του δασκάλου.",
        "es": "El niño entiende bien la explicación del profesor.",
        "fi": "Lapsi ymmärtää opettajan selityksen hyvin.",
        "fr": "L'enfant comprend bien l'explication du professeur.",
        "he": "הילד מבין היטב את ההסבר של המורה.",
        "hi": "बच्चा शिक्षक की व्याख्या अच्छी तरह समझता है।",
        "hu": "A gyerek jól megérti a tanár magyarázatát.",
        "id": "Anak itu memahami penjelasan guru dengan baik.",
        "it": "Il bambino capisce bene la spiegazione dell'insegnante.",
        "ja": "子どもは先生の説明をよく理解します。",
        "nb": "Barnet forstår lærerens forklaring godt.",
        "nl": "Het kind begrijpt de uitleg van de leraar goed.",
        "pl": "Dziecko dobrze rozumie wyjaśnienie nauczyciela.",
        "pt": "A criança entende bem a explicação do professor.",
        "ro": "Copilul înțelege bine explicația profesorului.",
        "ru": "Ребёнок хорошо понимает объяснение учителя.",
        "sv": "Barnet förstår lärarens förklaring bra.",
        "tr": "Çocuk öğretmenin açıklamasını iyi anlıyor.",
        "uk": "Дитина добре розуміє пояснення вчителя.",
        "vi": "Đứa trẻ hiểu bài giảng của thầy giáo rất tốt.",
        "yue": "個小朋友好明白老師嘅解釋。",
        "zh-Hans": "孩子很理解老师的讲解。"
      },
