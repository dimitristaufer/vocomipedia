  "sentences": [
    {
      "target": "그는 용기를 내서 발표를 했어요.",
      "reading": "geuneun yonggireul naeseo balpyoreul haesseoyo.",
      "translations": {
        "en": "He summoned up the courage and gave the presentation.",
        "ko": "그는 용기를 내서 발표를 했어요.",
        "ipa": "geuneun yonggireul naeseo balpyoreul haesseoyo.",
        "ar": "تجرأ على إلقاء العرض.",
        "cs": "Sebral odvahu a přednesl prezentaci.",
        "da": "Han tog mod til sig og holdt oplægget.",
        "de": "Er hat allen Mut zusammengenommen und den Vortrag gehalten.",
        "el": "Μάζεψε το θάρρος του και έκανε την παρουσίαση.",
        "es": "Reunió valor y dio la presentación.",
        "fi": "Hän keräsi rohkeutta ja piti esityksen.",
        "fr": "Il a pris son courage à deux mains et a fait sa présentation.",
        "he": "הוא אזר אומץ ועשה את המצגת.",
        "hi": "उसने हिम्मत जुटाकर प्रस्तुति दी।",
        "hu": "Összeszedte a bátorságát, és megtartotta az előadást.",
        "id": "Dia memberanikan diri dan mempresentasikan itu.",
        "it": "Si è fatto coraggio e ha fatto la presentazione.",
        "ja": "彼は勇気を出して発表しました。",
        "nb": "Han tok mot til seg og holdt presentasjonen.",
        "nl": "Hij heeft zijn moed verzameld en de presentatie gegeven.",
        "pl": "Zebrał się na odwagę i wygłosił prezentację.",
        "pt": "Ele criou coragem e fez a apresentação.",
        "ro": "Și-a făcut curaj și a ținut prezentarea.",
        "ru": "Он набрался смелости и выступил с презентацией.",
        "sv": "Han tog mod till sig och höll presentationen.",
        "tr": "Kendine cesaret edip sunumu yaptı.",
        "uk": "Він наважився й виступив із доповіддю.",
        "vi": "Anh ấy lấy hết can đảm và thuyết trình.",
        "yue": "佢鼓起勇氣做咗報告。",
        "zh-Hans": "他鼓起勇气做了演讲。"
      },
