  "sentences": [
    {
      "target": "점원이 친절하게 안내해 줬어요.",
      "reading": "jeomwoni chinjeolhage annaehae jwosseoyo.",
      "translations": {
        "en": "The shop assistant kindly guided me.",
        "ko": "점원이 친절하게 안내해 줬어요.",
        "ipa": "jeomwoni chinjeolhage annaehae jwosseoyo.",
        "ar": "أرشدني موظف المتجر بلطف.",
        "cs": "Prodavač mě ochotně navedl.",
        "da": "Ekspedienten viste mig venligt vej.",
        "de": "Der Verkäufer hat mich freundlich geführt.",
        "el": "Ο υπάλληλος του καταστήματος με καθοδήγησε ευγενικά.",
        "es": "El dependiente me guió amablemente.",
        "fi": "Myyjä opasti minua ystävällisesti.",
        "fr": "Le vendeur m’a gentiment guidé.",
        "he": "המוכר בחנות הסביר לי בסבלנות.",
        "hi": "दुकान के कर्मचारी ने मुझे नम्रता से रास्ता दिखाया।",
        "hu": "Az eladó kedvesen eligazított.",
        "id": "Pramuniaga itu dengan ramah menunjukkan jalan.",
        "it": "Il commesso mi ha indicato gentilmente la strada.",
        "ja": "店員が親切に案内してくれました。",
        "nb": "Butikkmedarbeideren viste meg vennlig veien.",
        "nl": "De winkelmedewerker hielp me vriendelijk.",
        "pl": "Sprzedawca uprzejmie mnie pokierował.",
        "pt": "O vendedor me mostrou o caminho com gentileza.",
        "ro": "Vânzătorul m-a îndrumat amabil.",
        "ru": "Продавец вежливо меня направил.",
        "sv": "Butiksbiträdet visade mig vänligt vägen.",
        "tr": "Mağaza görevlisi bana nazikçe yol gösterdi.",
        "uk": "Продавець привітно мене провів.",
        "vi": "Nhân viên cửa hàng đã nhiệt tình chỉ dẫn tôi.",
        "yue": "店員好有禮貌咁帶我行。",
        "zh-Hans": "店员亲切地给我指路。"
      },
