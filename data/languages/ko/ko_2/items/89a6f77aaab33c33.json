  "sentences": [
    {
      "target": "우리 며느리는 요리를 정말 잘해요.",
      "reading": "Uri myeoneurineun yorireul jeongmal jalhaeyo.",
      "translations": {
        "en": "Our daughter-in-law is a really good cook.",
        "ko": "우리 며느리는 요리를 정말 잘해요.",
        "ipa": "Uri myeoneurineun yorireul jeongmal jalhaeyo.",
        "ar": "كنّتنا تطبخ جيدًا جدًا.",
        "cs": "Naše snacha vaří opravdu dobře.",
        "da": "Vores svigerdatter er virkelig god til at lave mad.",
        "de": "Unsere Schwiegertochter kocht wirklich gut.",
        "el": "Η νύφη μας μαγειρεύει πολύ καλά.",
        "es": "Nuestra nuera cocina muy bien.",
        "fi": "Meidän miniämme laittaa todella hyvin ruokaa.",
        "fr": "Notre belle-fille cuisine très bien.",
        "he": "הכלה שלנו מבשלת ממש טוב.",
        "hi": "हमारी बहू बहुत अच्छा खाना बनाती है।",
        "hu": "A menyünk nagyon jól főz.",
        "id": "Menantu perempuan kami sangat pandai memasak.",
        "it": "La nostra nuora cucina davvero bene.",
        "ja": "うちの嫁は料理がとても上手です。",
        "nb": "Svigerdatteren vår er veldig flink til å lage mat.",
        "nl": "Onze schoondochter kan heel goed koken.",
        "pl": "Nasza synowa bardzo dobrze gotuje.",
        "pt": "Nossa nora cozinha muito bem.",
        "ro": "Nora noastră gătește foarte bine.",
        "ru": "Наша невестка очень хорошо готовит.",
        "sv": "Vår svärdotter lagar mat jättebra.",
        "tr": "Gelinimiz gerçekten çok iyi yemek yapar.",
        "uk": "Наша невістка дуже добре готує.",
        "vi": "Con dâu của tôi nấu ăn rất giỏi.",
        "yue": "我哋個新抱好識煮嘢食。",
        "zh-Hans": "我们的儿媳很会做饭。"
      },
