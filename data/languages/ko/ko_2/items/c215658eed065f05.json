    {
      "target": "공원에 큰 소나무 한 그루가 그늘을 만들어요.",
      "reading": "gongwon-e keun sonamu han geuruga geuneureul mandeureoyo.",
      "translations": {
        "en": "A big pine tree in the park makes shade.",
        "ko": "공원에 큰 소나무 한 그루가 그늘을 만들어요.",
        "ipa": "gongwon-e keun sonamu han geuruga geuneureul mandeureoyo.",
        "ar": "شجرة صنوبر كبيرة في الحديقة تصنع ظلاً.",
        "cs": "Velká borovice v parku vytváří stín.",
        "da": "Et stort fyrretræ i parken giver skygge.",
        "de": "Eine große Kiefer im Park spendet Schatten.",
        "el": "Ένα μεγάλο πεύκο στο πάρκο κάνει σκιά.",
        "es": "Un pino grande en el parque da sombra.",
        "fi": "Puutarhan suuri mänty tekee varjoa.",
        "fr": "Un grand pin dans le parc fait de l'ombre.",
        "he": "עץ אורן גדול בפארק יוצר צל.",
        "hi": "पार्क में एक बड़ा चीड़ का पेड़ छाया देता है।",
        "hu": "Egy nagy fenyőfa a parkban árnyékot ad.",
        "id": "Sebuah pohon pinus besar di taman membuat teduh.",
        "it": "Un grande pino nel parco fa ombra.",
        "ja": "公園の大きな松の木が日陰を作ります。",
        "nb": "Et stort furutre i parken gir skygge.",
        "nl": "Een grote dennenboom in het park geeft schaduw.",
        "pl": "W parku duża sosna daje cień.",
        "pt": "Um pinheiro grande no parque faz sombra.",
        "ro": "Un pin mare din parc face umbră.",
        "ru": "Большая сосна в парке даёт тень.",
        "sv": "En stor tall i parken ger skugga.",
        "tr": "Parktaki büyük bir çam ağacı gölge yapıyor.",
        "uk": "Велика сосна в парку дає тінь.",
        "vi": "Một cây thông lớn trong công viên tạo bóng râm.",
        "yue": "公園入面一棵大松樹擋住咗陰。",
        "zh-Hans": "公园里一棵大松树遮出了阴凉。"
      },
