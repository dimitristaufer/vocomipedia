  "sentences": [
    {
      "target": "햇볕이 따뜻해서 창문을 열었어요.",
      "reading": "haesbyeoti ttatteuthaeseo changmuneul yeoreosseoyo.",
      "translations": {
        "en": "The sunlight was warm, so I opened the window.",
        "ko": "햇볕이 따뜻해서 창문을 열었어요.",
        "ipa": "haesbyeoti ttatteuthaeseo changmuneul yeoreosseoyo.",
        "ar": "كانت أشعة الشمس دافئة، ففتحت النافذة.",
        "cs": "Sluneční svit byl teplý, tak jsem otevřel okno.",
        "da": "Sollyset var varmt, så jeg åbnede vinduet.",
        "de": "Das Sonnenlicht war warm, also habe ich das Fenster geöffnet.",
        "el": "Το φως του ήλιου ήταν ζεστό, οπότε άνοιξα το παράθυρο.",
        "es": "La luz del sol estaba cálida, así que abrí la ventana.",
        "fi": "Auringonvalo oli lämmintä, joten avasin ikkunan.",
        "fr": "Le soleil était chaud, alors j'ai ouvert la fenêtre.",
        "he": "אור השמש היה חמים, אז פתחתי את החלון.",
        "hi": "धूप गर्म थी, इसलिए मैंने खिड़की खोल दी।",
        "hu": "A napfény meleg volt, ezért kinyitottam az ablakot.",
        "id": "Sinar matahari terasa hangat, jadi saya membuka jendela.",
        "it": "Il sole era caldo, così ho aperto la finestra.",
        "ja": "日差しが暖かかったので、窓を開けました。",
        "nb": "Solfyret var varmt, så jeg åpnet vinduet.",
        "nl": "Het zonlicht was warm, dus ik heb het raam opengezet.",
        "pl": "Słońce było ciepłe, więc otworzyłem okno.",
        "pt": "A luz do sol estava quente, então abri a janela.",
        "ro": "Lumina soarelui era caldă, așa că am deschis fereastra.",
        "ru": "Солнечный свет был тёплым, поэтому я открыл окно.",
        "sv": "Solen var varm, så jag öppnade fönstret.",
        "tr": "Güneş sıcak olduğu için pencereyi açtım.",
        "uk": "Сонячне світло було тепле, тож я відчинив вікно.",
        "vi": "Nắng ấm nên tôi đã mở cửa sổ.",
        "yue": "陽光好暖，所以我打開咗窗。",
        "zh-Hans": "阳光很暖和，所以我打开了窗户。"
      },
