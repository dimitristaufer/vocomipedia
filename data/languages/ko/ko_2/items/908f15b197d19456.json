  "sentences": [
    {
      "target": "선생님이 문제를 빨리 파악했어요.",
      "reading": "seonsaengnimi munjereul ppalli paakhaesseoyo.",
      "translations": {
        "en": "The teacher quickly figured out the problem.",
        "ko": "선생님이 문제를 빨리 파악했어요.",
        "ipa": "seonsaengnimi munjereul ppalli paakhaesseoyo.",
        "ar": "فهم المعلم المشكلة بسرعة.",
        "cs": "Učitel rychle pochopil problém.",
        "da": "Læreren fandt hurtigt ud af problemet.",
        "de": "Der Lehrer hat das Problem schnell erkannt.",
        "el": "Ο δάσκαλος κατάλαβε γρήγορα το πρόβλημα.",
        "es": "El profesor entendió rápido el problema.",
        "fi": "Opettaja ymmärsi ongelman nopeasti.",
        "fr": "Le professeur a vite compris le problème.",
        "he": "המורה הבין את הבעיה במהירות.",
        "hi": "शिक्षक ने समस्या को जल्दी समझ लिया।",
        "hu": "A tanár gyorsan megértette a problémát.",
        "id": "Guru itu cepat memahami masalahnya.",
        "it": "L'insegnante ha capito subito il problema.",
        "ja": "先生は問題をすぐに把握しました。",
        "nb": "Læreren forsto problemet raskt.",
        "nl": "De leraar had het probleem snel door.",
        "pl": "Nauczyciel szybko zrozumiał problem.",
        "pt": "O professor percebeu o problema rápido.",
        "ro": "Profesorul a înțeles repede problema.",
        "ru": "Учитель быстро понял проблему.",
        "sv": "Läraren förstod problemet snabbt.",
        "tr": "Öğretmen sorunu hemen anladı.",
        "uk": "Учитель швидко зрозумів проблему.",
        "vi": "Thầy giáo đã nhanh chóng hiểu ra vấn đề.",
        "yue": "老師好快就明白咗問題。",
        "zh-Hans": "老师很快就明白了问题。"
      },
