  "sentences": [
    {
      "target": "아침 일찍 친구가 서울로 떠나갔어요.",
      "reading": "achim iljjik chinguga seoullo tteonagasseoyo",
      "translations": {
        "en": "My friend left for Seoul early in the morning.",
        "ko": "아침 일찍 친구가 서울로 떠나갔어요.",
        "ipa": "achim iljjik chinguga seoullo tteonagasseoyo",
        "ar": "غادر صديقي إلى سيول في وقت مبكر من الصباح.",
        "cs": "Můj kamarád odjel brzy ráno do Soulu.",
        "da": "Min ven tog tidligt om morgenen af sted til Seoul.",
        "de": "Mein Freund ist am frühen Morgen nach Seoul gefahren.",
        "el": "Ο φίλος μου έφυγε για τη Σεούλ νωρίς το πρωί.",
        "es": "Mi amigo se fue a Seúl temprano por la mañana.",
        "fi": "Ystäväni lähti Souliin varhain aamulla.",
        "fr": "Mon ami est parti pour Séoul tôt le matin.",
        "he": "החבר שלי נסע לסיאול מוקדם בבוקר.",
        "hi": "मेरा दोस्त सुबह जल्दी सियोल चला गया।",
        "hu": "A barátom kora reggel elment Szöulba.",
        "id": "Teman saya pergi ke Seoul pagi-pagi sekali.",
        "it": "Il mio amico è partito per Seul di prima mattina.",
        "ja": "友達は朝早くソウルへ行きました。",
        "nb": "Vennen min dro til Seoul tidlig om morgenen.",
        "nl": "Mijn vriend is vroeg in de ochtend naar Seoel vertrokken.",
        "pl": "Mój przyjaciel wyjechał wcześnie rano do Seulu.",
        "pt": "Meu amigo foi para Seul de manhã cedo.",
        "ro": "Prietenul meu a plecat spre Seul devreme dimineața.",
        "ru": "Мой друг рано утром уехал в Сеул.",
        "sv": "Min vän åkte till Seoul tidigt på morgonen.",
        "tr": "Arkadaşım sabah erken Seul'e gitti.",
        "uk": "Мій друг рано вранці поїхав до Сеула.",
        "vi": "Bạn tôi đã đi Seoul từ sáng sớm.",
        "yue": "我朋友朝早好早就去咗首爾。",
        "zh-Hans": "我朋友一大早就去首尔了。"
      },
