    {
      "target": "이 소파는 아주 오래됐어요.",
      "reading": "i sopaneun aju oraedwaesseoyo.",
      "translations": {
        "en": "This sofa is very old.",
        "ko": "이 소파는 아주 오래됐어요.",
        "ipa": "i sopaneun aju oraedwaesseoyo.",
        "ar": "هذه الأريكة قديمة جدًا.",
        "cs": "Tahle pohovka je moc stará.",
        "da": "Denne sofa er meget gammel.",
        "de": "Dieses Sofa ist sehr alt.",
        "el": "Αυτός ο καναπές είναι πολύ παλιός.",
        "es": "Este sofá es muy viejo.",
        "fi": "Tämä sohva on tosi vanha.",
        "fr": "Ce canapé est très vieux.",
        "he": "הספה הזאת ממש ישנה.",
        "hi": "यह सोफ़ा बहुत पुराना है।",
        "hu": "Ez a kanapé nagyon régi.",
        "id": "Sofa ini sudah sangat tua.",
        "it": "Questo divano è molto vecchio.",
        "ja": "このソファはとても古いです。",
        "nb": "Denne sofaen er veldig gammel.",
        "nl": "Deze bank is heel oud.",
        "pl": "Ta sofa jest bardzo stara.",
        "pt": "Este sofá é muito velho.",
        "ro": "Canapeaua asta este foarte veche.",
        "ru": "Этот диван очень старый.",
        "sv": "Den här soffan är väldigt gammal.",
        "tr": "Bu koltuk çok eski.",
        "uk": "Цей диван дуже старий.",
        "vi": "Cái ghế sofa này rất cũ.",
        "yue": "呢張梳化好舊。",
        "zh-Hans": "这张沙发很旧。"
      },
