  "sentences": [
    {
      "target": "지혜가 있는 사람은 말을 아껴요.",
      "reading": "jihyega inneun sarameun mareul akkyeoyo.",
      "translations": {
        "en": "A wise person chooses their words carefully.",
        "ko": "지혜가 있는 사람은 말을 아껴요.",
        "ipa": "jihyega inneun sarameun mareul akkyeoyo.",
        "ar": "الشخص الحكيم يختار كلماته بعناية.",
        "cs": "Moudrý člověk si pečlivě vybírá slova.",
        "da": "En klog person vælger sine ord med omhu.",
        "de": "Ein weiser Mensch wählt seine Worte sorgfältig.",
        "el": "Ένας σοφός άνθρωπος διαλέγει προσεκτικά τα λόγια του.",
        "es": "Una persona sabia elige sus palabras con cuidado.",
        "fi": "Viisas ihminen valitsee sanansa tarkasti.",
        "fr": "Une personne sage choisit ses mots avec soin.",
        "he": "אדם חכם בוחר את דבריו בקפידה.",
        "hi": "समझदार व्यक्ति अपने शब्द सोच-समझकर चुनता है।",
        "hu": "Egy bölcs ember gondosan választja meg a szavait.",
        "id": "Orang yang bijak memilih kata-katanya dengan hati-hati.",
        "it": "Una persona saggia sceglie con cura le sue parole.",
        "ja": "知恵のある人は言葉を慎重に選びます。",
        "nb": "En klok person velger ordene sine med omhu.",
        "nl": "Een wijs persoon kiest zijn woorden zorgvuldig.",
        "pl": "Mądra osoba dobiera słowa z rozwagą.",
        "pt": "Uma pessoa sábia escolhe bem as palavras.",
        "ro": "O persoană înțeleaptă își alege cu grijă cuvintele.",
        "ru": "Мудрый человек тщательно выбирает слова.",
        "sv": "En klok person väljer sina ord med omsorg.",
        "tr": "Akıllı bir insan sözlerini özenle seçer.",
        "uk": "Мудра людина ретельно добирає слова.",
        "vi": "Một người khôn ngoan sẽ chọn lời nói cẩn thận.",
        "yue": "有智慧嘅人會謹慎咁揀字眼。",
        "zh-Hans": "有智慧的人会谨慎地选择自己的话。"
      },
