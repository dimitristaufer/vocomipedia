    {
      "target": "담임 선생님이 학부모에게 전화를 했어요.",
      "reading": "담임 선생님이 학부모에게 전화를 했어요.",
      "translations": {
        "en": "The homeroom teacher called the parents.",
        "ko": "담임 선생님이 학부모에게 전화를 했어요.",
        "ipa": "담임 선생님이 학부모에게 전화를 했어요.",
        "ar": "اتصل معلم الصف بأولياء الأمور.",
        "cs": "Třídní učitel zavolal rodičům.",
        "da": "Klasselæreren ringede til forældrene.",
        "de": "Der Klassenlehrer hat die Eltern angerufen.",
        "el": "Ο δάσκαλος της τάξης τηλεφώνησε στους γονείς.",
        "es": "El tutor llamó a los padres.",
        "fi": "Luokanopettaja soitti vanhemmille.",
        "fr": "Le professeur principal a appelé les parents.",
        "he": "מחנך הכיתה התקשר להורים.",
        "hi": "कक्षा शिक्षक ने अभिभावकों को फ़ोन किया।",
        "hu": "Az osztályfőnök felhívta a szülőket.",
        "id": "Wali kelas menelepon orang tua.",
        "it": "L'insegnante di classe ha chiamato i genitori.",
        "ja": "担任の先生が保護者に電話をしました。",
        "nb": "Kontaktlæreren ringte foreldrene.",
        "nl": "De klassenleraar heeft de ouders gebeld.",
        "pl": "Wychowawca zadzwonił do rodziców.",
        "pt": "O professor da turma ligou para os pais.",
        "ro": "Dirigintele i-a sunat pe părinți.",
        "ru": "Классный руководитель позвонил родителям.",
        "sv": "Klassläraren ringde till föräldrarna.",
        "tr": "Sınıf öğretmeni velileri aradı.",
        "uk": "Класний керівник зателефонував батькам.",
        "vi": "Giáo viên chủ nhiệm đã gọi cho phụ huynh.",
        "yue": "班主任打咗電話畀家長。",
        "zh-Hans": "班主任给家长打了电话。"
      },
