    {
      "target": "오늘 학부모 회의가 있어요.",
      "reading": "오늘 학부모 회의가 있어요.",
      "translations": {
        "en": "There is a parents' meeting today.",
        "ko": "오늘 학부모 회의가 있어요.",
        "ipa": "오늘 학부모 회의가 있어요.",
        "ar": "هناك اجتماع لأولياء الأمور اليوم.",
        "cs": "Dnes je schůzka rodičů.",
        "da": "Der er forældremøde i dag.",
        "de": "Heute ist ein Elternabend.",
        "el": "Σήμερα υπάρχει συνάντηση γονέων.",
        "es": "Hoy hay reunión de padres.",
        "fi": "Tänään on vanhempainilta.",
        "fr": "Il y a une réunion de parents aujourd'hui.",
        "he": "יש היום אסיפת הורים.",
        "hi": "आज अभिभावक बैठक है।",
        "hu": "Ma szülői értekezlet van.",
        "id": "Hari ini ada rapat orang tua.",
        "it": "Oggi c'è un incontro con i genitori.",
        "ja": "今日は保護者会があります。",
        "nb": "Det er foreldremøte i dag.",
        "nl": "Vandaag is er een ouderavond.",
        "pl": "Dzisiaj jest zebranie rodziców.",
        "pt": "Hoje tem reunião de pais.",
        "ro": "Astăzi este ședință cu părinții.",
        "ru": "Сегодня собрание родителей.",
        "sv": "Det är föräldramöte i dag.",
        "tr": "Bugün veli toplantısı var.",
        "uk": "Сьогодні є батьківські збори.",
        "vi": "Hôm nay có họp phụ huynh.",
        "yue": "今日有家長會。",
        "zh-Hans": "今天有家长会。"
      },
