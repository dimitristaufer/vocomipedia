  "sentences": [
    {
      "target": "신문지로 창문 틈을 막았어요.",
      "reading": "sinmunjiro changmun teumeul magasseoyo.",
      "translations": {
        "en": "I blocked the window gap with newspaper.",
        "ko": "신문지로 창문 틈을 막았어요.",
        "ipa": "sinmunjiro changmun teumeul magasseoyo.",
        "ar": "سدَدتُ فجوة النافذة بالورق الجرائد.",
        "cs": "Zacpal jsem škvíru v okně novinami.",
        "da": "Jeg stoppede sprækken i vinduet med avispapir.",
        "de": "Ich habe den Spalt am Fenster mit Zeitungspapier zugestopft.",
        "el": "Έκλεισα το κενό στο παράθυρο με χαρτί εφημερίδας.",
        "es": "Tapé la rendija de la ventana con papel de periódico.",
        "fi": "Tukkisin ikkunan raon sanomalehdellä.",
        "fr": "J'ai bouché l'écart de la fenêtre avec du papier journal.",
        "he": "סתמתי את הרווח בחלון בנייר עיתון.",
        "hi": "मैंने खिड़की की दरार अख़बार से बंद कर दी।",
        "hu": "Újságpapírral tömtem be az ablak rését.",
        "id": "Saya menutup celah jendela dengan kertas koran.",
        "it": "Ho tappato la fessura della finestra con della carta di giornale.",
        "ja": "新聞紙で窓のすき間をふさぎました。",
        "nb": "Jeg tettet sprekken i vinduet med avispapir.",
        "nl": "Ik heb de kier van het raam dichtgestopt met krantenpapier.",
        "pl": "Zatkałem szczelinę w oknie gazetą.",
        "pt": "Tapei a fresta da janela com papel de jornal.",
        "ro": "Am astupat fanta ferestrei cu hârtie de ziar.",
        "ru": "Я заткнул щель в окне газетой.",
        "sv": "Jag täppte till springan i fönstret med tidningspapper.",
        "tr": "Pencerenin arasını gazeteyle kapattım.",
        "uk": "Я заткнув щілину в вікні газетою.",
        "vi": "Tôi đã bịt khe cửa sổ bằng giấy báo.",
        "yue": "我用報紙塞住咗窗嘅縫。",
        "zh-Hans": "我用报纸堵住了窗缝。"
      },
