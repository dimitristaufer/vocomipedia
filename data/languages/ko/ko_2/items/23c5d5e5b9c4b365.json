  "sentences": [
    {
      "target": "그는 끝까지 자신의 신념을 지켰다.",
      "reading": "Geuneun kkeutkkaji jasinui sinnyeomeul jikyeotda.",
      "translations": {
        "en": "He kept to his beliefs to the very end.",
        "ko": "그는 끝까지 자신의 신념을 지켰다.",
        "ipa": "Geuneun kkeutkkaji jasinui sinnyeomeul jikyeotda.",
        "ar": "تمسّك بمبادئه حتى النهاية.",
        "cs": "Držel se svých zásad až do konce.",
        "da": "Han holdt fast i sin overbevisning helt til det sidste.",
        "de": "Er hielt bis zum Schluss an seinen Überzeugungen fest.",
        "el": "Κράτησε τις πεποιθήσεις του μέχρι τέλους.",
        "es": "Se mantuvo fiel a sus creencias hasta el final.",
        "fi": "Hän piti kiinni vakaumuksestaan loppuun asti.",
        "fr": "Il est resté fidèle à ses convictions jusqu’au bout.",
        "he": "הוא נשאר נאמן לאמונותיו עד הסוף.",
        "hi": "वह आखिर तक अपने विश्वासों पर कायम रहा।",
        "hu": "Végig kitartott a meggyőződése mellett.",
        "id": "Dia tetap berpegang pada keyakinannya sampai akhir.",
        "it": "Ha mantenuto le sue convinzioni fino alla fine.",
        "ja": "彼は最後まで自分の信念を貫いた。",
        "nb": "Han holdt fast på sine overbevisninger helt til slutten.",
        "nl": "Hij hield tot het einde vast aan zijn overtuiging.",
        "pl": "Trzymał się swoich przekonań do samego końca.",
        "pt": "Ele manteve suas convicções até o fim.",
        "ro": "Și-a păstrat convingerile până la capăt.",
        "ru": "Он до конца придерживался своих убеждений.",
        "sv": "Han höll fast vid sin övertygelse ända till slutet.",
        "tr": "Sonuna kadar inancına sadık kaldı.",
        "uk": "Він до кінця тримався своїх переконань.",
        "vi": "Anh ấy giữ vững niềm tin của mình đến cùng.",
        "yue": "佢一直堅持自己嘅信念，直到最後。",
        "zh-Hans": "他一直坚持自己的信念，直到最后。"
      },
