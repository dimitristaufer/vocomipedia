    {
      "target": "항구에 배 두 척이 서 있어요.",
      "reading": "hanggue bae du cheogi seo isseoyo.",
      "translations": {
        "en": "Two ships are docked at the harbor.",
        "ko": "항구에 배 두 척이 서 있어요.",
        "ipa": "hanggue bae du cheogi seo isseoyo.",
        "ar": "ترسو سفينتان في الميناء.",
        "cs": "V přístavu stojí dvě lodě.",
        "da": "To skibe ligger ved havnen.",
        "de": "Im Hafen liegen zwei Schiffe.",
        "el": "Δύο πλοία είναι αραγμένα στο λιμάνι.",
        "es": "Hay dos barcos atracados en el puerto.",
        "fi": "Satamassa on kaksi laivaa.",
        "fr": "Deux bateaux sont amarrés au port.",
        "he": "שתי ספינות עוגנות בנמל.",
        "hi": "बंदरगाह में दो जहाज़ खड़े हैं।",
        "hu": "Két hajó áll a kikötőben.",
        "id": "Ada dua kapal yang berlabuh di pelabuhan.",
        "it": "Due navi sono attraccate al porto.",
        "ja": "港に船が二隻停泊しています。",
        "nb": "To skip ligger ved havnen.",
        "nl": "Twee schepen liggen in de haven.",
        "pl": "W porcie stoją dwa statki.",
        "pt": "Há dois navios atracados no porto.",
        "ro": "Sunt două nave acostate în port.",
        "ru": "В порту стоят два корабля.",
        "sv": "Två fartyg ligger i hamnen.",
        "tr": "Limanda iki gemi var.",
        "uk": "У порту стоять два кораблі.",
        "vi": "Có hai con tàu ở cảng.",
        "yue": "碼頭有兩隻船停泊緊。",
        "zh-Hans": "港口停着两艘船。"
