    {
      "target": "낚시배 한 척이 강가에 떠 있어요.",
      "reading": "naksi-bae han cheogi ganggaee tteo isseoyo.",
      "translations": {
        "en": "A fishing boat is floating by the river.",
        "ko": "낚시배 한 척이 강가에 떠 있어요.",
        "ipa": "naksi-bae han cheogi ganggaee tteo isseoyo.",
        "ar": "تطفو سفينة صيد واحدة عند النهر.",
        "cs": "U řeky pluje jedna rybářská loď.",
        "da": "En fiskerbåd driver ved floden.",
        "de": "Ein Fischerboot treibt am Flussufer.",
        "el": "Μια ψαρόβαρκα επιπλέει δίπλα στο ποτάμι.",
        "es": "Un barco de pesca flota junto al río.",
        "fi": "Yksi kalastusvene kelluu joen varrella.",
        "fr": "Un bateau de pêche flotte au bord de la rivière.",
        "he": "סירת דיג אחת צפה ליד הנהר.",
        "hi": "एक मछली पकड़ने वाली नाव नदी के किनारे तैर रही है।",
        "hu": "Egy halászhajó lebeg a folyó mellett.",
        "id": "Sebuah perahu nelayan mengapung di tepi sungai.",
        "it": "Un peschereccio galleggia vicino al fiume.",
        "ja": "釣り船が川のそばに浮かんでいます。",
        "nb": "En fiskebåt flyter ved elva.",
        "nl": "Een vissersboot drijft bij de rivier.",
        "pl": "Przy rzece unosi się jedna łódź rybacka.",
        "pt": "Um barco de pesca está à deriva perto do rio.",
        "ro": "O barcă de pescuit plutește lângă râu.",
        "ru": "Рыбацкая лодка плывёт у реки.",
        "sv": "En fiskebåt flyter vid floden.",
        "tr": "Bir balıkçı teknesi nehir kıyısında yüzüyor.",
        "uk": "Рибальський човен пливе біля річки.",
        "vi": "Một chiếc thuyền đánh cá đang trôi gần bờ sông.",
        "yue": "一隻釣魚船喺河邊浮住。",
        "zh-Hans": "一艘渔船漂在河边。"
      },
