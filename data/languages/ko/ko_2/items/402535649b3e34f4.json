  "sentences": [
    {
      "target": "우리는 이번 주말에 작은 행사를 벌였어요.",
      "reading": "urineun ibeon jumal-e jageun haengsareul beolyeosseoyo.",
      "translations": {
        "en": "We held a small event this weekend.",
        "ko": "우리는 이번 주말에 작은 행사를 벌였어요.",
        "ipa": "urineun ibeon jumal-e jageun haengsareul beolyeosseoyo.",
        "ar": "أقمنا فعالية صغيرة هذا الأسبوع.",
        "cs": "Tento víkend jsme uspořádali malou akci.",
        "da": "Vi holdt et lille arrangement i denne weekend.",
        "de": "Wir haben dieses Wochenende eine kleine Veranstaltung veranstaltet.",
        "el": "Κάναμε μια μικρή εκδήλωση αυτό το Σαββατοκύριακο.",
        "es": "Celebramos un pequeño evento este fin de semana.",
        "fi": "Pidimme pienen tapahtuman tänä viikonloppuna.",
        "fr": "Nous avons organisé une petite fête ce week-end.",
        "he": "ערכנו אירוע קטן בסוף השבוע הזה.",
        "hi": "हमने इस हफ़्ते के अंत में एक छोटा सा आयोजन किया।",
        "hu": "Ezen a hétvégén rendeztünk egy kis eseményt.",
        "id": "Kami mengadakan acara kecil akhir pekan ini.",
        "it": "Abbiamo organizzato un piccolo evento questo fine settimana.",
        "ja": "私たちは今週末に小さなイベントを開きました。",
        "nb": "Vi arrangerte et lite arrangement denne helgen.",
        "nl": "We hebben dit weekend een klein evenement georganiseerd.",
        "pl": "Zorganizowaliśmy w ten weekend małe wydarzenie.",
        "pt": "Nós organizamos um pequeno evento neste fim de semana.",
        "ro": "Am organizat un mic eveniment în weekendul acesta.",
        "ru": "Мы устроили небольшое мероприятие в эти выходные.",
        "sv": "Vi ordnade ett litet evenemang i helgen.",
        "tr": "Bu hafta sonu küçük bir etkinlik düzenledik.",
        "uk": "Ми влаштували невеликий захід цими вихідними.",
        "vi": "Chúng tôi đã tổ chức một sự kiện nhỏ vào cuối tuần này.",
        "yue": "我哋今個周末舉辦咗一個小型活動。",
        "zh-Hans": "我们这个周末举办了一个小活动。"
      },
