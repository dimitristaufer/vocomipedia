  "sentences": [
    {
      "target": "비가 와서 아빠를 마중하러 나갔어요.",
      "reading": "bi-ga waseo appaleul majunghareo nagasseoyo.",
      "translations": {
        "en": "It was raining, so I went out to meet my dad.",
        "ko": "비가 와서 아빠를 마중하러 나갔어요.",
        "ipa": "bi-ga waseo appaleul majunghareo nagasseoyo.",
        "ar": "خرجتُ لأستقبل أبي لأن المطر كان ينزل.",
        "cs": "Pršelo, tak jsem šel ven přivítat tátu.",
        "da": "Det regnede, så jeg gik ud for at møde min far.",
        "de": "Es hat geregnet, also bin ich rausgegangen, um meinen Vater abzuholen.",
        "el": "Έβρεχε, οπότε βγήκα να υποδεχτώ τον μπαμπά μου.",
        "es": "Llovía, así que salí a recibir a mi papá.",
        "fi": "Satoi, joten menin ulos hakemaan isääni.",
        "fr": "Il pleuvait, alors je suis sorti pour aller chercher mon père.",
        "he": "ירד גשם, אז יצאתי לקבל את אבא שלי.",
        "hi": "बारिश हो रही थी, इसलिए मैं अपने पापा को लेने बाहर गया।",
        "hu": "Esett az eső, ezért kimentem apám elé.",
        "id": "Hujan turun, jadi saya pergi keluar untuk menjemput ayah saya.",
        "it": "Pioveva, così sono uscito per andare a prendere mio padre.",
        "ja": "雨が降っていたので、父を迎えに外へ出ました。",
        "nb": "Det regnet, så jeg gikk ut for å møte pappa.",
        "nl": "Het regende, dus ik ging naar buiten om mijn vader op te halen.",
        "pl": "Padało, więc wyszedłem, żeby odebrać tatę.",
        "pt": "Estava chovendo, então saí para buscar meu pai.",
        "ro": "Ploua, așa că am ieșit să-l întâmpin pe tata.",
        "ru": "Шёл дождь, поэтому я вышел встретить папу.",
        "sv": "Det regnade, så jag gick ut för att möta pappa.",
        "tr": "Yağmur yağıyordu, bu yüzden babamı karşılamak için dışarı çıktım.",
        "uk": "Йшов дощ, тож я вийшов зустріти тата.",
        "vi": "Trời mưa, nên tôi ra ngoài đón bố.",
        "yue": "因為落雨，所以我出去接爸爸。",
        "zh-Hans": "因为下雨了，所以我出去接爸爸。"
      },
