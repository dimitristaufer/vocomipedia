  "sentences": [
    {
      "target": "부족한 부분은 제가 보완할게요.",
      "reading": "bujokhan bubuneun jega bowanhalkkeyo.",
      "translations": {
        "en": "I'll fill in the missing parts.",
        "ko": "부족한 부분은 제가 보완할게요.",
        "ipa": "bujokhan bubuneun jega bowanhalkkeyo.",
        "ar": "سأكمل الأجزاء الناقصة.",
        "cs": "Chybějící části doplním já.",
        "da": "Jeg udfylder de manglende dele.",
        "de": "Die fehlenden Teile fülle ich aus.",
        "el": "Θα συμπληρώσω τα μέρη που λείπουν.",
        "es": "Yo completaré las partes que faltan.",
        "fi": "Täydennän puuttuvat kohdat itse.",
        "fr": "Je compléterai les parties manquantes.",
        "he": "אני אשלים את החלקים החסרים.",
        "hi": "मैं खाली हिस्से भर दूँगा।",
        "hu": "Én kiegészítem a hiányzó részeket.",
        "id": "Saya akan melengkapi bagian yang kurang.",
        "it": "Completerò io le parti mancanti.",
        "ja": "足りない部分は私が補います。",
        "nb": "Jeg fyller inn de manglende delene.",
        "nl": "Ik vul de ontbrekende delen aan.",
        "pl": "Uzupełnię brakujące części.",
        "pt": "Vou completar as partes que faltam.",
        "ro": "Eu voi completa părțile lipsă.",
        "ru": "Я заполню недостающие части.",
        "sv": "Jag fyller i de delar som saknas.",
        "tr": "Eksik kısımları ben tamamlayacağım.",
        "uk": "Я доповню відсутні частини.",
        "vi": "Tôi sẽ bổ sung những phần còn thiếu.",
        "yue": "我會補充缺少嘅部分。",
        "zh-Hans": "我会补充缺少的部分。"
