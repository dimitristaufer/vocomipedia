  "sentences": [
    {
      "target": "그 사람은 옷 입는 감각이 좋아요.",
      "reading": "geu saram-eun ot ibn-neun gamgagi joayo.",
      "translations": {
        "en": "He has a good sense of style.",
        "ko": "그 사람은 옷 입는 감각이 좋아요.",
        "ipa": "geu saram-eun ot ibn-neun gamgagi joayo.",
        "ar": "لديه حس جيد في اختيار الملابس.",
        "cs": "Má dobrý vkus na oblečení.",
        "da": "Han har god stil.",
        "de": "Er hat ein gutes Gespür für Kleidung.",
        "el": "Έχει καλό γούστο στο ντύσιμο.",
        "es": "Tiene buen gusto para vestir.",
        "fi": "Hänellä on hyvä tyylitaju.",
        "fr": "Il a bon goût pour s'habiller.",
        "he": "יש לו חוש טוב לבגדים.",
        "hi": "कपड़े पहनने का उसका सेंस अच्छा है।",
        "hu": "Jó érzéke van az öltözködéshez.",
        "id": "Dia punya selera berpakaian yang bagus.",
        "it": "Ha buon gusto nel vestirsi.",
        "ja": "その人は服のセンスがいいです。",
        "nb": "Han har god smak når det gjelder klær.",
        "nl": "Hij heeft een goed gevoel voor kleding.",
        "pl": "Ma dobry gust do ubrań.",
        "pt": "Ele tem bom gosto para se vestir.",
        "ro": "Are bun gust la haine.",
        "ru": "У него хороший вкус в одежде.",
        "sv": "Han har bra stilkänsla.",
        "tr": "Giyinme konusunda iyi bir zevki var.",
        "uk": "Він має гарний смак в одязі.",
        "vi": "Anh ấy có gu ăn mặc rất tốt.",
        "yue": "佢著衫好有品味。",
        "zh-Hans": "他穿衣服很有品味。"
      },
