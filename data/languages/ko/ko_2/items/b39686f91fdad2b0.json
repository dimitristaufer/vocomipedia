  "sentences": [
    {
      "target": "회사에서 팩시밀리로 계약서를 보냈어요.",
      "reading": "hoesaeseo paeksimilliro gyeyakseoreul bonaesseoyo.",
      "translations": {
        "en": "I sent the contract by fax at work.",
        "ko": "회사에서 팩시밀리로 계약서를 보냈어요.",
        "ipa": "hoesaeseo paeksimilliro gyeyakseoreul bonaesseoyo.",
        "ar": "أرسلت العقد بالفاكس في العمل.",
        "cs": "Ve firmě jsem poslal smlouvu faxem.",
        "da": "Jeg sendte kontrakten med fax på arbejdet.",
        "de": "Ich habe den Vertrag bei der Arbeit per Fax geschickt.",
        "el": "Έστειλα το συμβόλαιο με φαξ στη δουλειά.",
        "es": "En la oficina envié el contrato por fax.",
        "fi": "Lähetin sopimuksen faksilla töissä.",
        "fr": "J’ai envoyé le contrat par fax au travail.",
        "he": "שלחתי את החוזה בפקס בעבודה.",
        "hi": "मैंने काम पर अनुबंध फैक्स से भेजा।",
        "hu": "A munkahelyen faxon küldtem el a szerződést.",
        "id": "Saya mengirim kontraknya lewat faks di kantor.",
        "it": "Ho inviato il contratto via fax al lavoro.",
        "ja": "会社でファックスで契約書を送りました。",
        "nb": "Jeg sendte kontrakten med faks på jobben.",
        "nl": "Ik heb het contract op mijn werk per fax verstuurd.",
        "pl": "W pracy wysłałem umowę faksem.",
        "pt": "Enviei o contrato por fax no trabalho.",
        "ro": "Am trimis contractul prin fax la serviciu.",
        "ru": "Я отправил договор по факсу на работе.",
        "sv": "Jag skickade kontraktet med fax på jobbet.",
        "tr": "İş yerinde sözleşmeyi faksla gönderdim.",
        "uk": "Я надіслав договір факсом на роботі.",
        "vi": "Tôi đã gửi hợp đồng bằng fax ở công ty.",
        "yue": "喺公司我用傳真寄咗份合約。",
        "zh-Hans": "我在公司用传真发了合同。"
      },
