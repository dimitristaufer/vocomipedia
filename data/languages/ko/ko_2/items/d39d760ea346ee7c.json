    {
      "target": "첫 만남이 아직도 기억돼요.",
      "reading": "Cheot mannami ajikdo gieokdwaeyo.",
      "translations": {
        "en": "I still remember our first meeting.",
        "ko": "첫 만남이 아직도 기억돼요.",
        "ipa": "Cheot mannami ajikdo gieokdwaeyo.",
        "ar": "ما زال لقاؤنا الأول في ذاكرتي.",
        "cs": "Naše první setkání si pořád pamatuju.",
        "da": "Jeg husker stadig vores første møde.",
        "de": "Ich erinnere mich noch immer an unser erstes Treffen.",
        "el": "Θυμάμαι ακόμα την πρώτη μας συνάντηση.",
        "es": "Todavía recuerdo nuestro primer encuentro.",
        "fi": "Muistan vieläkin ensimmäisen tapaamisemme.",
        "fr": "Je me souviens encore de notre première rencontre.",
        "he": "אני עדיין זוכר את המפגש הראשון שלנו.",
        "hi": "मुझे अभी भी हमारी पहली मुलाकात याद है।",
        "hu": "Még mindig emlékszem az első találkozásunkra.",
        "id": "Saya masih ingat pertemuan pertama kami.",
        "it": "Ricordo ancora il nostro primo incontro.",
        "ja": "初めて会った日のことを今でも覚えています。",
        "nb": "Jeg husker fortsatt vårt første møte.",
        "nl": "Ik herinner me onze eerste ontmoeting nog steeds.",
        "pl": "Nadal pamiętam nasze pierwsze spotkanie.",
        "pt": "Ainda me lembro do nosso primeiro encontro.",
        "ro": "Îmi amintesc încă de prima noastră întâlnire.",
        "ru": "Я до сих пор помню нашу первую встречу.",
        "sv": "Jag minns fortfarande vårt första möte.",
        "tr": "İlk karşılaşmamızı hâlâ hatırlıyorum.",
        "uk": "Я досі пам’ятаю нашу першу зустріч.",
        "vi": "Tôi vẫn nhớ lần gặp đầu tiên của chúng tôi.",
        "yue": "我到而家都仲記得我哋第一次見面。",
        "zh-Hans": "我到现在还记得我们的第一次见面。"
      },
