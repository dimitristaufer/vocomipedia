    {
      "target": "뼈를 넣고 국을 끓였어요.",
      "reading": "ppyeoreul neohgo gugeul kkeuryeosseoyo.",
      "translations": {
        "en": "I put bones in and boiled soup.",
        "ko": "뼈를 넣고 국을 끓였어요.",
        "ipa": "ppyeoreul neohgo gugeul kkeuryeosseoyo.",
        "ar": "وضعتُ العظام وطبختُ الشوربة.",
        "cs": "Dal jsem tam kosti a vařil jsem polévku.",
        "da": "Jeg puttede ben i og kogte suppe.",
        "de": "Ich habe Knochen hineingetan und Suppe gekocht.",
        "el": "Έβαλα κόκαλα και έβρασα σούπα.",
        "es": "Puse huesos y herví sopa.",
        "fi": "Laitoin luut sisään ja keitin keittoa.",
        "fr": "J'ai mis des os et j'ai fait bouillir de la soupe.",
        "he": "שמתי עצמות ובישלתי מרק.",
        "hi": "मैंने हड्डियाँ डालकर सूप उबाला।",
        "hu": "Beletettem a csontokat, és levest főztem.",
        "id": "Saya memasukkan tulang dan merebus sup.",
        "it": "Ho messo le ossa e ho fatto bollire la zuppa.",
        "ja": "骨を入れてスープを煮ました。",
        "nb": "Jeg la i bein og kokte suppe.",
        "nl": "Ik heb botten in de soep gedaan en die gekookt.",
        "pl": "Włożyłem kości i ugotowałem zupę.",
        "pt": "Coloquei ossos e cozinhei a sopa.",
        "ro": "Am pus oase și am fiert supă.",
        "ru": "Я положил кости и сварил суп.",
        "sv": "Jag lade i ben och kokade soppa.",
        "tr": "İçine kemik koyup çorba kaynattım.",
        "uk": "Я поклав кістки й зварив суп.",
        "vi": "Tôi cho xương vào và nấu súp.",
        "yue": "我落咗啲骨去煲湯。",
        "zh-Hans": "我把骨头放进去煮汤了。"
      },
