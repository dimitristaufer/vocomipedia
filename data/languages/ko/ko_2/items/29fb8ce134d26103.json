    {
      "target": "생선 가시랑 뼈를 골라 냈어요.",
      "reading": "saengseon gasirang ppyeoreul golla naesseoyo.",
      "translations": {
        "en": "I picked out the fish bones.",
        "ko": "생선 가시랑 뼈를 골라 냈어요.",
        "ipa": "saengseon gasirang ppyeoreul golla naesseoyo.",
        "ar": "انتقيتُ عظام السمك.",
        "cs": "Vybral jsem rybí kosti.",
        "da": "Jeg pillede fiskebenene ud.",
        "de": "Ich habe die Fischgräten herausgepickt.",
        "el": "Διάλεξα τα κόκαλα από το ψάρι.",
        "es": "Le quité las espinas al pescado.",
        "fi": "Nypin kalanruodot pois.",
        "fr": "J'ai enlevé les arêtes du poisson.",
        "he": "הוצאתי את העצמות מהדג.",
        "hi": "मैंने मछली की हड्डियाँ निकाल दीं।",
        "hu": "Kiszedegettem a hal szálkáit.",
        "id": "Saya sudah mengambil duri ikan dan tulangnya.",
        "it": "Ho tolto le lische dal pesce.",
        "ja": "魚の骨を取りました。",
        "nb": "Jeg plukket ut fiskebeinene.",
        "nl": "Ik heb de visgraten eruit gehaald.",
        "pl": "Wyjąłem ości z ryby.",
        "pt": "Tirei as espinhas do peixe.",
        "ro": "Am scos oasele din pește.",
        "ru": "Я вытащил кости из рыбы.",
        "sv": "Jag plockade bort fiskbenen.",
        "tr": "Balık kılçıklarını ve kemiklerini ayıkladım.",
        "uk": "Я витягнув кістки з риби.",
        "vi": "Tôi đã gỡ xương cá ra.",
        "yue": "我拎咗啲魚骨出嚟。",
        "zh-Hans": "我把鱼骨挑出来了。"
      },
