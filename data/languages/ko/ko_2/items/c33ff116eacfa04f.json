  "sentences": [
    {
      "target": "사냥은 옛날에는 흔한 일이었어요.",
      "reading": "sanyang-eun yetnaleneun heunhan irieosseoyo.",
      "translations": {
        "en": "Hunting was common in the old days.",
        "ko": "사냥은 옛날에는 흔한 일이었어요.",
        "ipa": "sanyang-eun yetnaleneun heunhan irieosseoyo.",
        "ar": "كانت الصيد شائعة في الماضي.",
        "cs": "Lov byl v minulosti běžný.",
        "da": "Jagt var almindeligt i gamle dage.",
        "de": "Jagen war früher etwas ganz Normales.",
        "el": "Το κυνήγι ήταν συνηθισμένο παλιά.",
        "es": "La caza era algo común en el pasado.",
        "fi": "Metsästys oli tavallista ennen vanhaan.",
        "fr": "La chasse était courante autrefois.",
        "he": "ציד היה דבר נפוץ בעבר.",
        "hi": "पुराने समय में शिकार आम था।",
        "hu": "A vadászat régen gyakori volt.",
        "id": "Berburu dulu adalah hal yang umum.",
        "it": "La caccia era comune un tempo.",
        "ja": "昔は狩猟はよくあることでした。",
        "nb": "Jakt var vanlig før i tiden.",
        "nl": "Jagen kwam vroeger vaak voor.",
        "pl": "Polowanie było kiedyś czymś powszechnym.",
        "pt": "A caça era comum antigamente.",
        "ro": "Vânătoarea era ceva obișnuit în trecut.",
        "ru": "Охота в старые времена была обычным делом.",
        "sv": "Jakt var vanligt förr i tiden.",
        "tr": "Eskiden avcılık yaygındı.",
        "uk": "Полювання в давні часи було звичайною справою.",
        "vi": "Ngày xưa, săn bắn rất phổ biến.",
        "yue": "以前打獵好常見。",
        "zh-Hans": "以前狩猎很常见。"
      },
