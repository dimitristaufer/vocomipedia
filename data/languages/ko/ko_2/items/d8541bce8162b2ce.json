  "sentences": [
    {
      "target": "저 뱃사람은 바다 일을 오래 했어요.",
      "reading": "jeo baessaram-eun bada ireul orae haesseoyo.",
      "translations": {
        "en": "That sailor has worked at sea for a long time.",
        "ko": "저 뱃사람은 바다 일을 오래 했어요.",
        "ipa": "jeo baessaram-eun bada ireul orae haesseoyo.",
        "ar": "ذلك البحار عمل في البحر مدة طويلة.",
        "cs": "Ten námořník pracuje na moři už dlouho.",
        "da": "Den sømand har arbejdet til søs i lang tid.",
        "de": "Der Seemann arbeitet schon seit langer Zeit auf dem Meer.",
        "el": "Αυτός ο ναυτικός δουλεύει στη θάλασσα εδώ και πολύ καιρό.",
        "es": "Ese marinero ha trabajado en el mar durante mucho tiempo.",
        "fi": "Tuo merimies on tehnyt töitä merellä pitkään.",
        "fr": "Ce marin travaille en mer depuis longtemps.",
        "he": "המלח ההוא עובד בים כבר הרבה זמן.",
        "hi": "वह नाविक बहुत लंबे समय से समुद्र में काम कर रहा है।",
        "hu": "Az a tengerész már régóta a tengeren dolgozik.",
        "id": "Pelaut itu sudah lama bekerja di laut.",
        "it": "Quel marinaio lavora in mare da molto tempo.",
        "ja": "あの船乗りは長いあいだ海で働いています。",
        "nb": "Den sjømannen har jobbet til sjøs lenge.",
        "nl": "Die zeeman werkt al heel lang op zee.",
        "pl": "Ten marynarz pracuje na morzu od dawna.",
        "pt": "Aquele marinheiro trabalha no mar há muito tempo.",
        "ro": "Marinarul acela lucrează pe mare de mult timp.",
        "ru": "Тот моряк уже давно работает в море.",
        "sv": "Den där sjömannen har arbetat till sjöss länge.",
        "tr": "O denizci uzun zamandır denizde çalışıyor.",
        "uk": "Той моряк уже давно працює в морі.",
        "vi": "Người thủy thủ đó đã làm việc trên biển lâu rồi.",
        "yue": "嗰個水手喺海上做咗好耐嘢。",
        "zh-Hans": "那个水手已经在海上工作很久了。"
      },
