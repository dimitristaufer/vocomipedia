  "sentences": [
    {
      "target": "이 마을에는 오랜 풍습이 있어요.",
      "reading": "i maeul-eneun oraeon pungseubi isseoyo.",
      "translations": {
        "en": "This village has long-standing customs.",
        "ko": "이 마을에는 오랜 풍습이 있어요.",
        "ipa": "i maeul-eneun oraeon pungseubi isseoyo.",
        "ar": "في هذه القرية عادات قديمة.",
        "cs": "V této vesnici jsou staré zvyky.",
        "da": "Der er gamle skikke i denne landsby.",
        "de": "In diesem Dorf gibt es alte Bräuche.",
        "el": "Σε αυτό το χωριό υπάρχουν παλιά έθιμα.",
        "es": "En este pueblo hay costumbres antiguas.",
        "fi": "Tässä kylässä on vanhoja tapoja.",
        "fr": "Dans ce village, il y a de vieilles coutumes.",
        "he": "בכפר הזה יש מנהגים עתיקים.",
        "hi": "इस गाँव में पुरानी परंपराएँ हैं।",
        "hu": "Ebben a faluban régi szokások vannak.",
        "id": "Di desa ini ada adat istiadat lama.",
        "it": "In questo villaggio ci sono antiche usanze.",
        "ja": "この村には古くからの風習があります。",
        "nb": "Det er gamle skikker i denne landsbyen.",
        "nl": "In dit dorp zijn oude gebruiken.",
        "pl": "W tej wiosce są stare zwyczaje.",
        "pt": "Nesta vila há costumes antigos.",
        "ro": "În acest sat există obiceiuri vechi.",
        "ru": "В этой деревне есть старинные обычаи.",
        "sv": "Det finns gamla seder i den här byn.",
        "tr": "Bu köyde eski gelenekler var.",
        "uk": "У цьому селі є давні звичаї.",
        "vi": "Ở ngôi làng này có những phong tục lâu đời.",
        "yue": "呢條村有好多老習俗。",
        "zh-Hans": "这个村子有古老的风俗。"
      },
