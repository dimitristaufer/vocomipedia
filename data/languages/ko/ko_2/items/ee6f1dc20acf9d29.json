  "sentences": [
    {
      "target": "오랜만에 친구를 만났어요.",
      "reading": "oraenmane chingureul mannasseoyo.",
      "translations": {
        "en": "I met a friend after a long time.",
        "ko": "오랜만에 친구를 만났어요.",
        "ipa": "oraenmane chingureul mannasseoyo.",
        "ar": "التقيت بصديق بعد فترة طويلة.",
        "cs": "Po dlouhé době jsem se setkal s přítelem.",
        "da": "Jeg mødte en ven efter lang tid.",
        "de": "Ich habe nach langer Zeit einen Freund getroffen.",
        "el": "Συνάντησα έναν φίλο μετά από πολύ καιρό.",
        "es": "Me encontré con un amigo después de mucho tiempo.",
        "fi": "Tapasin ystävän pitkän ajan jälkeen.",
        "fr": "J'ai retrouvé un ami après longtemps.",
        "he": "פגשתי חבר אחרי הרבה זמן.",
        "hi": "मैंने बहुत समय बाद एक दोस्त से मुलाकात की।",
        "hu": "Hosszú idő után találkoztam egy baráttal.",
        "id": "Saya bertemu teman setelah sekian lama.",
        "it": "Ho incontrato un amico dopo tanto tempo.",
        "ja": "久しぶりに友達に会いました。",
        "nb": "Jeg møtte en venn etter lang tid.",
        "nl": "Ik heb na lange tijd een vriend ontmoet.",
        "pl": "Spotkałem się z przyjacielem po długim czasie.",
        "pt": "Encontrei um amigo depois de muito tempo.",
        "ro": "M-am întâlnit cu un prieten după mult timp.",
        "ru": "Я встретился с другом после долгого времени.",
        "sv": "Jag träffade en vän efter lång tid.",
        "tr": "Uzun zamandır sonra bir arkadaşla buluştum.",
        "uk": "Я зустрівся з другом після довгого часу.",
        "vi": "Tôi đã gặp một người bạn sau một thời gian dài.",
        "yue": "好耐冇見，我同朋友見面。",
        "zh-Hans": "我很久没见朋友了。"
      },
