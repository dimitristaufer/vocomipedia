  "sentences": [
    {
      "target": "창밖으로 비 오는 광경이 보였어요.",
      "reading": "changbakk-euro bi oneun gwanggyeongi boyeosseoyo.",
      "translations": {
        "en": "I saw the sight of rain outside the window.",
        "ko": "창밖으로 비 오는 광경이 보였어요.",
        "ipa": "changbakk-euro bi oneun gwanggyeongi boyeosseoyo.",
        "ar": "رأيت منظر المطر من النافذة.",
        "cs": "Viděl jsem z okna, že prší.",
        "da": "Jeg så regnen uden for vinduet.",
        "de": "Ich sah den Regen vor dem Fenster.",
        "el": "Είδα τη βροχή έξω από το παράθυρο.",
        "es": "Vi la lluvia fuera de la ventana.",
        "fi": "Näin ikkunasta sateen ulkona.",
        "fr": "J’ai vu la pluie par la fenêtre.",
        "he": "ראיתי את הגשם מחוץ לחלון.",
        "hi": "मैंने खिड़की से बाहर बारिश का नज़ारा देखा।",
        "hu": "Láttam az esőt az ablakon túl.",
        "id": "Saya melihat hujan di luar jendela.",
        "it": "Ho visto la pioggia fuori dalla finestra.",
        "ja": "窓の外に雨が降っている様子が見えました。",
        "nb": "Jeg så regnet utenfor vinduet.",
        "nl": "Ik zag de regen buiten het raam.",
        "pl": "Zobaczyłem deszcz za oknem.",
        "pt": "Vi a chuva lá fora pela janela.",
        "ro": "Am văzut ploaia afară, pe fereastră.",
        "ru": "Я видел дождь за окном.",
        "sv": "Jag såg regnet utanför fönstret.",
        "tr": "Pencerenin dışındaki yağmuru gördüm.",
        "uk": "Я бачив дощ за вікном.",
        "vi": "Tôi thấy cảnh mưa ngoài cửa sổ.",
        "yue": "我喺窗外見到落雨嘅景象。",
        "zh-Hans": "我从窗外看见了下雨的景象。"
      },
