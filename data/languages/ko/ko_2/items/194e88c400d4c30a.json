  "sentences": [
    {
      "target": "사람들의 눈길이 제게 쏠렸어요.",
      "reading": "saramdeuri nun-giri jege ssollyeosseoyo.",
      "translations": {
        "en": "All eyes turned to me.",
        "ko": "사람들의 눈길이 제게 쏠렸어요.",
        "ipa": "saramdeuri nun-giri jege ssollyeosseoyo.",
        "ar": "توجهت كل الأنظار إليّ.",
        "cs": "Všechny pohledy se obrátily ke mně.",
        "da": "Alle øjne vendte sig mod mig.",
        "de": "Alle Augen richteten sich auf mich.",
        "el": "Όλα τα βλέμματα στράφηκαν σε μένα.",
        "es": "Todas las miradas se volvieron hacia mí.",
        "fi": "Kaikkien katseet kohdistuivat minuun.",
        "fr": "Tous les regards se sont tournés vers moi.",
        "he": "כל המבטים הופנו אליי.",
        "hi": "सभी की नज़रें मेरी तरफ मुड़ गईं।",
        "hu": "Minden tekintet rám szegeződött.",
        "id": "Semua mata tertuju pada saya.",
        "it": "Tutti gli occhi si sono rivolti verso di me.",
        "ja": "みんなの視線が私に集まりました。",
        "nb": "Alles blikk vendte seg mot meg.",
        "nl": "Alle blikken waren op mij gericht.",
        "pl": "Wszystkie spojrzenia zwróciły się na mnie.",
        "pt": "Todos os olhares se voltaram para mim.",
        "ro": "Toate privirile s-au întors spre mine.",
        "ru": "Все взгляды обратились ко мне.",
        "sv": "Allas blickar vändes mot mig.",
        "tr": "Herkesin bakışları bana döndü.",
        "uk": "Усі погляди звернулися до мене.",
        "vi": "Mọi ánh mắt đều đổ dồn vào tôi.",
        "yue": "所有人嘅目光都投向咗我。",
        "zh-Hans": "所有人的目光都落在我身上。"
      },
