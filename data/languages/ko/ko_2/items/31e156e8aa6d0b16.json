  "sentences": [
    {
      "target": "용기 있는 자만 먼저 들어갈 수 있어요.",
      "reading": "yonggi inneun jaman meonjeo deureogal su isseoyo.",
      "translations": {
        "en": "Only brave people can go in first.",
        "ko": "용기 있는 자만 먼저 들어갈 수 있어요.",
        "ipa": "yonggi inneun jaman meonjeo deureogal su isseoyo.",
        "ar": "فقط الشجعان يمكنهم الدخول أولًا.",
        "cs": "Jen odvážní lidé mohou jít dovnitř první.",
        "da": "Kun modige mennesker kan gå ind først.",
        "de": "Nur mutige Menschen dürfen zuerst hineingehen.",
        "el": "Μόνο οι γενναίοι μπορούν να μπουν πρώτοι.",
        "es": "Solo las personas valientes pueden entrar primero.",
        "fi": "Vain rohkeat voivat mennä sisään ensin.",
        "fr": "Seules les personnes courageuses peuvent entrer les premières.",
        "he": "רק אנשים אמיצים יכולים להיכנס ראשונים.",
        "hi": "सिर्फ़ बहादुर लोग ही पहले अंदर जा सकते हैं।",
        "hu": "Csak a bátor emberek mehetnek be először.",
        "id": "Hanya orang yang berani yang bisa masuk duluan.",
        "it": "Solo le persone coraggiose possono entrare per prime.",
        "ja": "勇気のある人だけが先に入れます。",
        "nb": "Bare modige mennesker kan gå inn først.",
        "nl": "Alleen moedige mensen mogen eerst naar binnen.",
        "pl": "Tylko odważni ludzie mogą wejść pierwsi.",
        "pt": "Só pessoas corajosas podem entrar primeiro.",
        "ro": "Doar oamenii curajoși pot intra primii.",
        "ru": "Только смелые люди могут войти первыми.",
        "sv": "Bara modiga människor kan gå in först.",
        "tr": "Sadece cesur insanlar önce içeri girebilir.",
        "uk": "Лише сміливі люди можуть увійти першими.",
        "vi": "Chỉ những người dũng cảm mới được vào trước.",
        "yue": "只有勇敢嘅人先可以入去。",
        "zh-Hans": "只有勇敢的人才能先进去。"
      },
