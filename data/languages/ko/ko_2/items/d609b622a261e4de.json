  "sentences": [
    {
      "target": "저는 파란색 색연필로 바다를 그렸어요.",
      "reading": "jeoneun paransaek saegyeonpillo badareul geuryeosseoyo.",
      "translations": {
        "en": "I drew the ocean with a blue colored pencil.",
        "ko": "저는 파란색 색연필로 바다를 그렸어요.",
        "ipa": "jeoneun paransaek saegyeonpillo badareul geuryeosseoyo.",
        "ar": "رسمتُ البحرَ بقلم تلوين أزرق.",
        "cs": "Nakreslil jsem moře modrou pastelkou.",
        "da": "Jeg tegnede havet med en blå farveblyant.",
        "de": "Ich habe das Meer mit einem blauen Buntstift gezeichnet.",
        "el": "Σχεδίασα τη θάλασσα με ένα μπλε ξυλομπογιά.",
        "es": "Dibujé el mar con un lápiz de color azul.",
        "fi": "Piirsin meren sinisellä värikynällä.",
        "fr": "J’ai dessiné la mer avec un crayon de couleur bleu.",
        "he": "ציירתי את הים בעיפרון צבעוני כחול.",
        "hi": "मैंने नीले रंग की रंगीन पेंसिल से समुद्र बनाया।",
        "hu": "Kék színes ceruzával rajzoltam meg a tengert.",
        "id": "Saya menggambar laut dengan pensil warna biru.",
        "it": "Ho disegnato il mare con una matita colorata blu.",
        "ja": "青い色鉛筆で海を描きました。",
        "nb": "Jeg tegnet havet med en blå fargeblyant.",
        "nl": "Ik tekende de zee met een blauw kleurpotlood.",
        "pl": "Narysowałem morze niebieskim ołówkiem kolorowym.",
        "pt": "Desenhei o mar com um lápis de cor azul.",
        "ro": "Am desenat marea cu un creion colorat albastru.",
        "ru": "Я нарисовал море синим цветным карандашом.",
        "sv": "Jag ritade havet med en blå färgpenna.",
        "tr": "Denizi mavi bir boya kalemiyle çizdim.",
        "uk": "Я намалював море синім кольоровим олівцем.",
        "vi": "Tôi đã vẽ biển bằng một cây bút chì màu xanh.",
        "yue": "我用咗支藍色嘅顏色鉛筆畫海。",
        "zh-Hans": "我用蓝色彩铅画了海。"
      },
