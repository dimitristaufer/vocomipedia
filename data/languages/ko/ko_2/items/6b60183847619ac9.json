    {
      "target": "할머니는 옛집을 그리워해요.",
      "reading": "Halmeonineun yetjibeul geuriwohaeyo.",
      "translations": {
        "en": "Grandma misses the old house.",
        "ko": "할머니는 옛집을 그리워해요.",
        "ipa": "Halmeonineun yetjibeul geuriwohaeyo.",
        "ar": "تشتاق الجدة إلى البيت القديم.",
        "cs": "Babička postrádá starý dům.",
        "da": "Bedstemor savner det gamle hus.",
        "de": "Oma vermisst das alte Haus.",
        "el": "Η γιαγιά νοσταλγεί το παλιό σπίτι.",
        "es": "La abuela añora la casa vieja.",
        "fi": "Mummi ikävöi vanhaa taloa.",
        "fr": "Mamie regrette la vieille maison.",
        "he": "סבתא מתגעגעת לבית הישן.",
        "hi": "दादी को पुराना घर याद आता है।",
        "hu": "A nagymama hiányolja a régi házat.",
        "id": "Nenek merindukan rumah lama.",
        "it": "La nonna sente la mancanza della vecchia casa.",
        "ja": "おばあさんは昔の家が恋しいです。",
        "nb": "Bestemor savner det gamle huset.",
        "nl": "Oma mist het oude huis.",
        "pl": "Babcia tęskni za starym domem.",
        "pt": "A avó sente saudades da casa antiga.",
        "ro": "Bunica tânjește după casa veche.",
        "ru": "Бабушка скучает по старому дому.",
        "sv": "Mormor saknar det gamla huset.",
        "tr": "Büyükanne eski evi özlüyor.",
        "uk": "Бабуся сумує за старим будинком.",
        "vi": "Bà nhớ ngôi nhà cũ.",
        "yue": "嫲嫲掛住舊屋。",
        "zh-Hans": "奶奶怀念老房子。"
      },
