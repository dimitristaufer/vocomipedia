    {
      "target": "우리는 손님을 환영합니다.",
      "reading": "urineun sonnim-eul hwanyeonghamnida.",
      "translations": {
        "en": "We welcome our guests.",
        "ko": "우리는 손님을 환영합니다.",
        "ipa": "urineun sonnim-eul hwanyeonghamnida.",
        "ar": "نحن نرحب بضيوفنا.",
        "cs": "Vítáme naše hosty.",
        "da": "Vi byder vores gæster velkommen.",
        "de": "Wir begrüßen unsere Gäste.",
        "el": "Υποδεχόμαστε τους καλεσμένους μας.",
        "es": "Damos la bienvenida a nuestros invitados.",
        "fi": "Toivotamme vieraamme tervetulleiksi.",
        "fr": "Nous accueillons nos invités.",
        "he": "אנו מקבלים את פני האורחים שלנו.",
        "hi": "हम अपने मेहमानों का स्वागत करते हैं।",
        "hu": "Üdvözöljük a vendégeinket.",
        "id": "Kami menyambut tamu kami.",
        "it": "Diamo il benvenuto ai nostri ospiti.",
        "ja": "私たちはお客さんを歓迎します。",
        "nb": "Vi ønsker gjestene våre velkommen.",
        "nl": "We heten onze gasten welkom.",
        "pl": "Witamy naszych gości.",
        "pt": "Nós damos as boas-vindas aos nossos convidados.",
        "ro": "Ne întâmpinăm oaspeții.",
        "ru": "Мы приветствуем наших гостей.",
        "sv": "Vi välkomnar våra gäster.",
        "tr": "Misafirlerimizi karşılıyoruz.",
        "uk": "Ми вітаємо наших гостей.",
        "vi": "Chúng tôi chào đón các vị khách của mình.",
        "yue": "我哋歡迎我哋嘅客人。",
        "zh-Hans": "我们欢迎我们的客人。"
