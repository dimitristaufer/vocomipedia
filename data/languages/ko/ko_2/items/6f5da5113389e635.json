  "sentences": [
    {
      "target": "선생님의 가르침을 잊지 않겠습니다.",
      "reading": "seonsaengnim-ui gareuchimeul itji anhgessseumnida",
      "translations": {
        "en": "I won't forget my teacher's teaching.",
        "ko": "선생님의 가르침을 잊지 않겠습니다.",
        "ipa": "seonsaengnim-ui gareuchimeul itji anhgessseumnida",
        "ar": "لن أنسى تعليم معلمتي.",
        "cs": "Nezapomenu na učení svého učitele.",
        "da": "Jeg vil ikke glemme min lærers undervisning.",
        "de": "Ich werde die Lehre meiner Lehrerin nicht vergessen.",
        "el": "Δεν θα ξεχάσω τη διδασκαλία της δασκάλας μου.",
        "es": "No olvidaré la enseñanza de mi profesora.",
        "fi": "En unohda opettajani opetusta.",
        "fr": "Je n'oublierai pas l'enseignement de ma professeure.",
        "he": "לא אשכח את ההוראה של המורה שלי.",
        "hi": "मैं अपनी शिक्षिका की सीख नहीं भूलूँगा।",
        "hu": "Nem fogom elfelejteni a tanárom tanítását.",
        "id": "Saya tidak akan melupakan ajaran guru saya.",
        "it": "Non dimenticherò l'insegnamento della mia insegnante.",
        "ja": "先生の教えを忘れません。",
        "nb": "Jeg vil ikke glemme lærerens undervisning.",
        "nl": "Ik zal de lessen van mijn leraar niet vergeten.",
        "pl": "Nie zapomnę nauki mojej nauczycielki.",
        "pt": "Não vou esquecer o ensinamento da minha professora.",
        "ro": "Nu voi uita învățătura profesoarei mele.",
        "ru": "Я не забуду наставления моей учительницы.",
        "sv": "Jag ska inte glömma min lärares undervisning.",
        "tr": "Öğretmenimin öğütlerini unutmayacağım.",
        "uk": "Я не забуду науку моєї вчительки.",
        "vi": "Tôi sẽ không quên lời dạy của cô giáo tôi.",
        "yue": "我唔會忘記老師嘅教誨。",
        "zh-Hans": "我不会忘记老师的教诲。"
      },
