  "sentences": [
    {
      "target": "그 사람은 서른 살쯤이라고 짐작했어요.",
      "reading": "geu saram-eun seoreun sal jjeum irago jimjakhaesseoyo",
      "translations": {
        "en": "I guessed he was around thirty.",
        "ko": "그 사람은 서른 살쯤이라고 짐작했어요.",
        "ipa": "geu saram-eun seoreun sal jjeum irago jimjakhaesseoyo",
        "ar": "قدّرتُ أنه في نحو الثلاثين من عمره.",
        "cs": "Odhadl jsem, že mu bylo kolem třiceti.",
        "da": "Jeg gættede på, at han var omkring tredive år.",
        "de": "Ich schätzte, dass er etwa dreißig war.",
        "el": "Μάντεψα ότι ήταν γύρω στα τριάντα.",
        "es": "Calculé que tenía unos treinta años.",
        "fi": "Arvasin, että hän oli noin kolmekymppinen.",
        "fr": "J’ai supposé qu’il avait la trentaine.",
        "he": "ניחשתי שהוא בערך בן שלושים.",
        "hi": "मुझे लगा कि वह लगभग तीस साल का था।",
        "hu": "Azt tippeltem, hogy körülbelül harmincéves.",
        "id": "Saya menebak dia berusia sekitar tiga puluh tahun.",
        "it": "Ho supposto che avesse circa trent'anni.",
        "ja": "その人は三十歳くらいだと見当をつけました。",
        "nb": "Jeg gjettet at han var rundt tretti år.",
        "nl": "Ik schatte dat hij rond de dertig was.",
        "pl": "Zgadłem, że ma około trzydziestu lat.",
        "pt": "Achei que ele tinha cerca de trinta anos.",
        "ro": "Am presupus că avea vreo treizeci de ani.",
        "ru": "Я подумал, что ему около тридцати.",
        "sv": "Jag gissade att han var runt trettio år.",
        "tr": "Onun otuz yaşlarında olduğunu tahmin ettim.",
        "uk": "Я припустив, що йому близько тридцяти.",
        "vi": "Tôi đoán anh ấy khoảng ba mươi tuổi.",
        "yue": "我估佢大概三十歲。",
        "zh-Hans": "我估他大约三十岁。"
      },
