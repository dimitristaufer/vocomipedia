  "sentences": [
    {
      "target": "우리는 옥상에 올라가 바람을 쐬었어요.",
      "reading": "urineun oksang-e ollaga baram-eul ssoeeosseoyo.",
      "translations": {
        "en": "We went up to the roof and got some fresh air.",
        "ko": "우리는 옥상에 올라가 바람을 쐬었어요.",
        "ipa": "urineun oksang-e ollaga baram-eul ssoeeosseoyo.",
        "ar": "صعدنا إلى السطح واستنشقنا بعض الهواء المنعش.",
        "cs": "Vyšli jsme na střechu a nadýchali se čerstvého vzduchu.",
        "da": "Vi gik op på taget og fik lidt frisk luft.",
        "de": "Wir gingen aufs Dach und atmeten etwas frische Luft.",
        "el": "Ανεβήκαμε στην ταράτσα και πήραμε λίγο καθαρό αέρα.",
        "es": "Subimos a la azotea y tomamos un poco de aire fresco.",
        "fi": "Menimme katolle ja saimme raitista ilmaa.",
        "fr": "Nous sommes montés sur le toit pour prendre l'air.",
        "he": "עלינו לגג ונשמנו קצת אוויר צח.",
        "hi": "हम छत पर गए और ताज़ी हवा ली।",
        "hu": "Felmentünk a tetőre, és szívtunk egy kis friss levegőt.",
        "id": "Kami naik ke atap dan menghirup udara segar.",
        "it": "Siamo saliti sul tetto e abbiamo preso un po' d'aria fresca.",
        "ja": "私たちは屋上に上がって、少し風にあたりました。",
        "nb": "Vi gikk opp på taket og fikk litt frisk luft.",
        "nl": "We gingen naar het dak en kregen wat frisse lucht.",
        "pl": "Weszliśmy na dach i pooddychaliśmy świeżym powietrzem.",
        "pt": "Subimos ao terraço e tomamos um pouco de ar fresco.",
        "ro": "Am urcat pe acoperiș și am respirat puțin aer curat.",
        "ru": "Мы поднялись на крышу и подышали свежим воздухом.",
        "sv": "Vi gick upp på taket och fick lite frisk luft.",
        "tr": "Çatıya çıktık ve biraz temiz hava aldık.",
        "uk": "Ми піднялися на дах і подихали свіжим повітрям.",
        "vi": "Chúng tôi lên sân thượng và hít thở không khí trong lành.",
        "yue": "我哋上咗天台，吹咗陣涼風。",
        "zh-Hans": "我们上了天台，吹了吹风。"
      },
