  "sentences": [
    {
      "target": "대학생 시절에는 아르바이트를 많이 했어요.",
      "reading": "daehaksaeng sijeoleneun areubaiteureul mani haesseoyo.",
      "translations": {
        "en": "I worked part-time a lot when I was in college.",
        "ko": "대학생 시절에는 아르바이트를 많이 했어요.",
        "ipa": "daehaksaeng sijeoleneun areubaiteureul mani haesseoyo.",
        "ar": "كنت أعمل كثيرًا بدوام جزئي في أيام الجامعة.",
        "cs": "Na vysoké škole jsem hodně pracoval na brigádě.",
        "da": "Jeg arbejdede meget ved siden af, da jeg gik på universitetet.",
        "de": "Ich habe in meiner Studienzeit oft nebenbei gearbeitet.",
        "el": "Στα φοιτητικά μου χρόνια δούλευα πολύ μερική απασχόληση.",
        "es": "Cuando estaba en la universidad, trabajaba mucho a tiempo parcial.",
        "fi": "Yliopistoaikoina tein paljon osa-aikatöitä.",
        "fr": "À l'université, je faisais souvent des petits boulots.",
        "he": "בימי האוניברסיטה עבדתי הרבה בעבודות חלקיות.",
        "hi": "कॉलेज के दिनों में मैं बहुत पार्ट-टाइम काम करता था।",
        "hu": "Egyetemi éveim alatt sokat dolgoztam részmunkaidőben.",
        "id": "Saat kuliah, saya sering bekerja paruh waktu.",
        "it": "Quando ero all'università, facevo spesso lavoretti part-time.",
        "ja": "大学生のころは、アルバイトをよくしていました。",
        "nb": "Da jeg gikk på universitetet, jobbet jeg mye deltid.",
        "nl": "Toen ik op de universiteit zat, werkte ik veel bij.",
        "pl": "Na studiach często pracowałem dorywczo.",
        "pt": "Na época da faculdade, eu fazia muito trabalho de meio período.",
        "ro": "Când eram la facultate, lucram mult part-time.",
        "ru": "В студенческие годы я много подрабатывал.",
        "sv": "När jag pluggade på universitetet jobbade jag mycket extra.",
        "tr": "Üniversite yıllarımda çok yarı zamanlı çalıştım.",
        "uk": "У студентські роки я багато підробляв.",
        "vi": "Hồi còn học đại học, tôi làm thêm rất nhiều.",
        "yue": "大學嗰陣，我做咗好多兼職。",
        "zh-Hans": "大学时候，我常常做兼职。"
      },
