  "sentences": [
    {
      "target": "그의 노력 덕분에 시험에 합격했어요.",
      "reading": "geuui noryeok deokbune siheome hapgyeokhaesseoyo.",
      "translations": {
        "en": "Thanks to his effort, he passed the exam.",
        "ko": "그의 노력 덕분에 시험에 합격했어요.",
        "ipa": "geuui noryeok deokbune siheome hapgyeokhaesseoyo.",
        "ar": "بفضل جهده نجح في الامتحان.",
        "cs": "Díky jeho úsilí u zkoušky uspěl.",
        "da": "Takket være hans indsats bestod han eksamen.",
        "de": "Dank seiner Mühe hat er die Prüfung bestanden.",
        "el": "Χάρη στην προσπάθειά του πέρασε τις εξετάσεις.",
        "es": "Gracias a su esfuerzo, aprobó el examen.",
        "fi": "Hänen ansiostaan hän läpäisi kokeen.",
        "fr": "Grâce à ses efforts, il a réussi l'examen.",
        "he": "בזכות המאמץ שלו הוא עבר את הבחינה.",
        "hi": "उसकी मेहनत की वजह से वह परीक्षा में पास हो गया।",
        "hu": "Az ő erőfeszítésének köszönhetően átment a vizsgán.",
        "id": "Berkat usahanya, dia lulus ujian.",
        "it": "Grazie al suo impegno, ha superato l'esame.",
        "ja": "彼の努力のおかげで、試験に合格しました。",
        "nb": "Takket være innsatsen hans bestod han eksamen.",
        "nl": "Dankzij zijn moeite slaagde hij voor het examen.",
        "pl": "Dzięki jego wysiłkowi zdał egzamin.",
        "pt": "Graças ao seu esforço, ele passou no exame.",
        "ro": "Datorită efortului lui, a trecut examenul.",
        "ru": "Благодаря его усилиям он сдал экзамен.",
        "sv": "Tack vare hans ansträngning klarade han provet.",
        "tr": "Onun çabası sayesinde sınavı geçti.",
        "uk": "Завдяки його зусиллям він склав іспит.",
        "vi": "Nhờ nỗ lực của anh ấy, anh ấy đã đỗ kỳ thi.",
        "yue": "多得佢嘅努力，佢合格咗考試。",
        "zh-Hans": "多亏了他的努力，他通过了考试。"
      },
