  "sentences": [
    {
      "target": "저는 학교 근처 하숙집에 살아요.",
      "reading": "jeoneun hakgyo geuncheo hasukjibe sarayo.",
      "translations": {
        "en": "I live in a boarding house near the school.",
        "ko": "저는 학교 근처 하숙집에 살아요.",
        "ipa": "jeoneun hakgyo geuncheo hasukjibe sarayo.",
        "ar": "أسكن في بيت ضيافة قرب المدرسة.",
        "cs": "Bydlím v podnájmu blízko školy.",
        "da": "Jeg bor på et pensionat nær skolen.",
        "de": "Ich wohne in einer Pension in der Nähe der Schule.",
        "el": "Μένω σε έναν ξενώνα κοντά στο σχολείο.",
        "es": "Vivo en una pensión cerca de la escuela.",
        "fi": "Asun pensionaatissa lähellä koulua.",
        "fr": "J'habite dans une pension près de l'école.",
        "he": "אני גר בפנסיון ליד בית הספר.",
        "hi": "मैं स्कूल के पास एक बोर्डिंग हाउस में रहता हूँ।",
        "hu": "Egy bentlakásos házban lakom az iskola közelében.",
        "id": "Saya tinggal di rumah indekos dekat sekolah.",
        "it": "Vivo in una pensione vicino alla scuola.",
        "ja": "私は学校の近くの下宿屋に住んでいます。",
        "nb": "Jeg bor på et pensjonat nær skolen.",
        "nl": "Ik woon in een pension vlak bij school.",
        "pl": "Mieszkam w pensjonacie niedaleko szkoły.",
        "pt": "Moro em uma pensão perto da escola.",
        "ro": "Locuiesc într-o pensiune aproape de școală.",
        "ru": "Я живу в пансионе рядом со школой.",
        "sv": "Jag bor på ett pensionat nära skolan.",
        "tr": "Okulun yakınındaki bir pansiyonda kalıyorum.",
        "uk": "Я живу в пансіонаті біля школи.",
        "vi": "Tôi sống ở một nhà trọ gần trường.",
        "yue": "我住喺學校附近嘅宿舍。",
        "zh-Hans": "我住在学校附近的宿舍。"
      },
