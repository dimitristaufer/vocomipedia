  "sentences": [
    {
      "target": "두 사람은 첫 키스를 했어요.",
      "reading": "du sarameun cheot kiseureul haesseoyo.",
      "translations": {
        "en": "The two people had their first kiss.",
        "ko": "두 사람은 첫 키스를 했어요.",
        "ipa": "du sarameun cheot kiseureul haesseoyo.",
        "ar": "قبل الشخصان قبلتهما الأولى.",
        "cs": "Dva lidé se políbili poprvé.",
        "da": "De to personer fik deres første kys.",
        "de": "Die beiden haben sich zum ersten Mal geküsst.",
        "el": "Οι δύο άνθρωποι είχαν το πρώτο τους φιλί.",
        "es": "Las dos personas se dieron su primer beso.",
        "fi": "Kaksi ihmistä suuteli ensimmäistä kertaa.",
        "fr": "Les deux personnes ont eu leur premier baiser.",
        "he": "שני האנשים התנשקו בפעם הראשונה.",
        "hi": "दोनों लोगों ने पहली बार किस किया।",
        "hu": "A két ember megcsókolta egymást először.",
        "id": "Dua orang itu berciuman untuk pertama kali.",
        "it": "I due si sono dati il primo bacio.",
        "ja": "二人は初めてキスをしました。",
        "nb": "De to hadde sitt første kyss.",
        "nl": "De twee mensen gaven elkaar hun eerste kus.",
        "pl": "Te dwie osoby pocałowały się po raz pierwszy.",
        "pt": "As duas pessoas deram seu primeiro beijo.",
        "ro": "Cei doi s-au sărutat pentru prima dată.",
        "ru": "Эти двое впервые поцеловались.",
        "sv": "De två hade sin första kyss.",
        "tr": "İki kişi ilk öpücüklerini aldı.",
        "uk": "Ці двоє вперше поцілувалися.",
        "vi": "Hai người đã hôn nhau lần đầu.",
        "yue": "兩個人第一次接吻。",
        "zh-Hans": "两个人第一次接吻。"
      },
