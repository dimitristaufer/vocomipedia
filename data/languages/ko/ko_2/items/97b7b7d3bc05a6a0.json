    {
      "target": "남의 시선이 부담스러워요.",
      "reading": "nam-eui siseoni budamseureowoyo",
      "translations": {
        "en": "Other people's gazes make me uncomfortable.",
        "ko": "남의 시선이 부담스러워요.",
        "ipa": "nam-eui siseoni budamseureowoyo",
        "ar": "نظرات الآخرين تزعجني.",
        "cs": "Pohledy ostatních mi jsou nepříjemné.",
        "da": "Andres blikke gør mig utilpas.",
        "de": "Die Blicke der anderen sind mir unangenehm.",
        "el": "Τα βλέμματα των άλλων με κάνουν να νιώθω άβολα.",
        "es": "Las miradas de los demás me incomodan.",
        "fi": "Muiden katseet saavat minut tuntemaan oloni epämukavaksi.",
        "fr": "Les regards des autres me gênent.",
        "he": "המבטים של אחרים מלחיצים אותי.",
        "hi": "दूसरों की नज़रें मुझे असहज करती हैं।",
        "hu": "Mások pillantásai kellemetlenül érintenek.",
        "id": "Tatapan orang lain membuat saya tidak nyaman.",
        "it": "Gli sguardi degli altri mi mettono a disagio.",
        "ja": "人の視線が気になります。",
        "nb": "Andres blikk gjør meg ukomfortabel.",
        "nl": "De blikken van anderen maken me ongemakkelijk.",
        "pl": "Spojrzenia innych są dla mnie krępujące.",
        "pt": "Os olhares dos outros me deixam desconfortável.",
        "ro": "Privirile celorlalți mă fac să mă simt inconfortabil.",
        "ru": "Меня смущают взгляды других.",
        "sv": "Andras blickar gör mig obekväm.",
        "tr": "Başkalarının bakışları beni rahatsız ediyor.",
        "uk": "Мене бентежать погляди інших.",
        "vi": "Ánh mắt của người khác làm tôi khó chịu.",
        "yue": "別人嘅目光令我好唔自在。",
        "zh-Hans": "别人的目光让我不自在。"
