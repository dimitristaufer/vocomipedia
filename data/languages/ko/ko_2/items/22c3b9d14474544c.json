  "sentences": [
    {
      "target": "그 가방은 밤색이에요.",
      "reading": "geu gabangeun bamsaeg-ieyo.",
      "translations": {
        "en": "That bag is chestnut brown.",
        "ko": "그 가방은 밤색이에요.",
        "ipa": "geu gabangeun bamsaeg-ieyo.",
        "ar": "الحقيبة تلك بنية كستنائية.",
        "cs": "Ta taška je kaštanově hnědá.",
        "da": "Den taske er kastanjebrun.",
        "de": "Die Tasche ist kastanienbraun.",
        "el": "Αυτή η τσάντα είναι καστανόχρωμη.",
        "es": "Ese bolso es marrón castaño.",
        "fi": "Se laukku on kastanjanruskea.",
        "fr": "Ce sac est marron châtain.",
        "he": "התיק הזה חום ערמוני.",
        "hi": "वह बैग चेस्टनट रंग का है।",
        "hu": "Az a táska gesztenyebarna.",
        "id": "Tas itu berwarna cokelat kastanye.",
        "it": "Quella borsa è marrone castagna.",
        "ja": "あのバッグは栗色です。",
        "nb": "Den vesken er kastanjebrun.",
        "nl": "Die tas is kastanjebruin.",
        "pl": "Ta torba jest kasztanowobrązowa.",
        "pt": "Essa bolsa é castanha.",
        "ro": "Geanta aceea este maro castaniu.",
        "ru": "Та сумка каштанового цвета.",
        "sv": "Väskan är kastanjebrun.",
        "tr": "O çanta kestane rengi.",
        "uk": "Та сумка каштанового кольору.",
        "vi": "Chiếc túi đó màu nâu hạt dẻ.",
        "yue": "個袋係啡紅色。",
        "zh-Hans": "那个包是栗色的。"
      },
