    {
      "target": "나는 밤색 코트를 자주 입어요.",
      "reading": "naneun bamsaek koteureul jaju ibeoyo.",
      "translations": {
        "en": "I often wear a chestnut-brown coat.",
        "ko": "나는 밤색 코트를 자주 입어요.",
        "ipa": "naneun bamsaek koteureul jaju ibeoyo.",
        "ar": "أرتدي معطفًا بنيًا كستنائيًا كثيرًا.",
        "cs": "Často nosím kaštanově hnědý kabát.",
        "da": "Jeg bruger ofte en kastanjebrun frakke.",
        "de": "Ich trage oft einen kastanienbraunen Mantel.",
        "el": "Φοράω συχνά ένα καστανό παλτό.",
        "es": "Suelo ponerme un abrigo marrón castaño.",
        "fi": "Pidän usein kastanjanruskeaa takkia.",
        "fr": "Je porte souvent un manteau marron châtain.",
        "he": "אני לובש לעיתים קרובות מעיל חום ערמוני.",
        "hi": "मैं अक्सर चेस्टनट रंग का कोट पहनता हूँ।",
        "hu": "Gyakran viselek gesztenyebarna kabátot.",
        "id": "Saya sering memakai mantel berwarna cokelat kastanye.",
        "it": "Indosso spesso un cappotto marrone castagna.",
        "ja": "私はよく栗色のコートを着ます。",
        "nb": "Jeg bruker ofte en kastanjebrun frakk.",
        "nl": "Ik draag vaak een kastanjebruine jas.",
        "pl": "Często noszę kasztanowobrązowy płaszcz.",
        "pt": "Eu uso um casaco castanho com frequência.",
        "ro": "Port des un palton maro castaniu.",
        "ru": "Я часто ношу каштановое пальто.",
        "sv": "Jag har ofta på mig en kastanjebrun kappa.",
        "tr": "Sık sık kestane rengi bir palto giyerim.",
        "uk": "Я часто ношу каштанове пальто.",
        "vi": "Tôi thường mặc một chiếc áo khoác màu nâu hạt dẻ.",
        "yue": "我成日著啡紅色大褸。",
        "zh-Hans": "我经常穿栗色外套。"
      },
