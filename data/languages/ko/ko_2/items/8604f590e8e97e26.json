  "sentences": [
    {
      "target": "고향에 대한 그리움이 커졌어요.",
      "reading": "gohyang-e daehan geuriumi keojyeosseoyo.",
      "translations": {
        "en": "My longing for my hometown grew.",
        "ko": "고향에 대한 그리움이 커졌어요.",
        "ipa": "gohyang-e daehan geuriumi keojyeosseoyo.",
        "ar": "ازداد شوقي إلى مسقط رأسي.",
        "cs": "Moje touha po domově zesílila.",
        "da": "Min længsel efter min hjemby voksede.",
        "de": "Meine Sehnsucht nach meiner Heimatstadt wurde größer.",
        "el": "Η νοσταλγία μου για τον τόπο μου μεγάλωσε.",
        "es": "Mi añoranza por mi ciudad natal creció.",
        "fi": "Kaipaukseni kotikaupunkiani kohtaan kasvoi.",
        "fr": "Mon désir du pays natal a grandi.",
        "he": "הגעגוע שלי לעיר הולדתי התחזק.",
        "hi": "अपने घर-गांव की याद और बढ़ गई।",
        "hu": "Nőtt a honvágyam a szülővárosom után.",
        "id": "Kerinduan saya pada kampung halaman saya semakin besar.",
        "it": "La mia nostalgia per la città natale è cresciuta.",
        "ja": "故郷への恋しさが強くなりました。",
        "nb": "Lengselen etter hjembyen min ble sterkere.",
        "nl": "Mijn verlangen naar mijn geboorteplaats werd groter.",
        "pl": "Moja tęsknota za rodzinnym miastem się nasiliła.",
        "pt": "A minha saudade da minha terra natal aumentou.",
        "ro": "Dorul meu de orașul natal a crescut.",
        "ru": "Моя тоска по родному городу стала сильнее.",
        "sv": "Min längtan efter hemstaden blev starkare.",
        "tr": "Memleket özlemim arttı.",
        "uk": "Моя туга за рідним містом стала сильнішою.",
        "vi": "Nỗi nhớ quê hương của tôi càng lớn hơn.",
        "yue": "我對故鄉嘅思念愈嚟愈深。",
        "zh-Hans": "我对故乡的思念越来越深了。"
      },
