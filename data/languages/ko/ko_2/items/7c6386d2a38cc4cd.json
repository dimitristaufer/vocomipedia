  "sentences": [
    {
      "target": "학원 원장이 직접 상담해 줬어요.",
      "reading": "hakwon wonjangi jikjeop sangdamhae jwosseoyo.",
      "translations": {
        "en": "The academy director spoke with us in person.",
        "ko": "학원 원장이 직접 상담해 줬어요.",
        "ipa": "hakwon wonjangi jikjeop sangdamhae jwosseoyo.",
        "ar": "تحدث مدير الأكاديمية معنا شخصيًا.",
        "cs": "Vedoucí akademie s námi mluvil osobně.",
        "da": "Akademidirektøren talte personligt med os.",
        "de": "Der Leiter der Akademie hat persönlich mit uns gesprochen.",
        "el": "Ο διευθυντής της ακαδημίας μίλησε μαζί μας αυτοπροσώπως.",
        "es": "El director de la academia habló con nosotros en persona.",
        "fi": "Akatemian johtaja puhui kanssamme itse.",
        "fr": "Le directeur de l'académie a parlé avec nous en personne.",
        "he": "מנהל האקדמיה דיבר איתנו בעצמו.",
        "hi": "अकादमी के निदेशक ने खुद हमसे बात की।",
        "hu": "Az akadémia vezetője személyesen beszélt velünk.",
        "id": "Kepala akademi berbicara langsung dengan kami.",
        "it": "Il direttore dell'accademia ha parlato con noi di persona.",
        "ja": "学院の院長が直接相談に乗ってくれました。",
        "nb": "Akademidirektøren snakket med oss personlig.",
        "nl": "De directeur van de academie sprak persoonlijk met ons.",
        "pl": "Dyrektor akademii rozmawiał z nami osobiście.",
        "pt": "O diretor da academia falou conosco pessoalmente.",
        "ro": "Directorul academiei a vorbit cu noi personal.",
        "ru": "Директор академии сам поговорил с нами.",
        "sv": "Akademins chef talade personligen med oss.",
        "tr": "Akademi müdürü bizimle bizzat konuştu.",
        "uk": "Директор академії сам поговорив із нами.",
        "vi": "Giám đốc học viện đã trực tiếp nói chuyện với chúng tôi.",
        "yue": "學院院長親自同我哋傾咗計。",
        "zh-Hans": "学院院长亲自跟我们谈了。"
      },
