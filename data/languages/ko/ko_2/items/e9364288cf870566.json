  "sentences": [
    {
      "target": "방 한구석에 책상이 있어요.",
      "reading": "bang han-guseok-e chaeksang-i isseoyo.",
      "translations": {
        "en": "There is a desk in the corner of the room.",
        "ko": "방 한구석에 책상이 있어요.",
        "ipa": "bang han-guseok-e chaeksang-i isseoyo.",
        "ar": "يوجد مكتب في زاوية الغرفة.",
        "cs": "V rohu pokoje je stůl.",
        "da": "Der står et skrivebord i hjørnet af værelset.",
        "de": "In der Ecke des Zimmers steht ein Schreibtisch.",
        "el": "Υπάρχει ένα γραφείο στη γωνία του δωματίου.",
        "es": "Hay un escritorio en la esquina de la habitación.",
        "fi": "Huoneen nurkassa on kirjoituspöytä.",
        "fr": "Il y a un bureau dans le coin de la chambre.",
        "he": "יש שולחן עבודה בפינת החדר.",
        "hi": "कमरे के कोने में एक मेज़ है।",
        "hu": "Van egy íróasztal a szoba sarkában.",
        "id": "Ada meja di sudut kamar.",
        "it": "C'è una scrivania nell'angolo della stanza.",
        "ja": "部屋の片隅に机があります。",
        "nb": "Det står et skrivebord i hjørnet av rommet.",
        "nl": "Er staat een bureau in de hoek van de kamer.",
        "pl": "W rogu pokoju stoi biurko.",
        "pt": "Há uma escrivaninha no canto do quarto.",
        "ro": "În colțul camerei este un birou.",
        "ru": "В углу комнаты стоит письменный стол.",
        "sv": "Det står ett skrivbord i hörnet av rummet.",
        "tr": "Odanın köşesinde bir çalışma masası var.",
        "uk": "У кутку кімнати стоїть письмовий стіл.",
        "vi": "Có một cái bàn ở góc phòng.",
        "yue": "房間個角落有張書枱。",
        "zh-Hans": "房间角落里有一张桌子。"
      },
