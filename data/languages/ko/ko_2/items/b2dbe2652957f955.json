    {
      "target": "장인께 저녁 식사를 대접했어요.",
      "reading": "janginkke jeonyeok siksareul daeeophaesseoyo.",
      "translations": {
        "en": "I treated my father-in-law to dinner.",
        "ko": "장인께 저녁 식사를 대접했어요.",
        "ipa": "janginkke jeonyeok siksareul daeeophaesseoyo.",
        "ar": "قدّمت العشاء لحمِي.",
        "cs": "Pozval jsem tchána na večeři.",
        "da": "Jeg bød min svigerfar på aftensmad.",
        "de": "Ich habe meinen Schwiegervater zum Abendessen eingeladen.",
        "el": "Πρόσφερα στον πεθερό μου δείπνο.",
        "es": "Invité a cenar a mi suegro.",
        "fi": "Tarjosin illallisen appiukolleni.",
        "fr": "J’ai offert le dîner à mon beau-père.",
        "he": "קניתי ארוחת ערב לחמִי.",
        "hi": "मैंने अपने ससुर को रात के खाने पर बुलाया।",
        "hu": "Vacsorával kínáltam az apósomat.",
        "id": "Saya mentraktir ayah mertua saya makan malam.",
        "it": "Ho offerto la cena a mio suocero.",
        "ja": "義父に夕食をごちそうしました。",
        "nb": "Jeg spanderte middag på svigerfaren min.",
        "nl": "Ik trakteerde mijn schoonvader op het avondeten.",
        "pl": "Postawiłem obiad mojemu teściowi.",
        "pt": "Convidei meu sogro para jantar.",
        "ro": "L-am invitat pe socrul meu la cină.",
        "ru": "Я угостил тестя ужином.",
        "sv": "Jag bjöd min svärfar på middag.",
        "tr": "Kayınbabamı akşam yemeğine götürdüm.",
        "uk": "Я пригостив свого тестя вечерею.",
        "vi": "Tôi đã đãi bố vợ bữa tối.",
        "yue": "我請咗我外父食晚飯。",
        "zh-Hans": "我请岳父吃了晚饭。"
      },
