    {
      "target": "저쪽 종업원에게 주문할게요.",
      "reading": "jeojjok jungeobwon-ege jumunhalgeyo.",
      "translations": {
        "en": "I’ll order from that waiter over there.",
        "ko": "저쪽 종업원에게 주문할게요.",
        "ipa": "jeojjok jungeobwon-ege jumunhalgeyo.",
        "ar": "سأطلب من ذلك النادل هناك.",
        "cs": "Objednám si u tamtoho číšníka.",
        "da": "Jeg bestiller hos den tjener derovre.",
        "de": "Ich bestelle bei dem Kellner dort drüben.",
        "el": "Θα παραγγείλω από εκείνον τον σερβιτόρο εκεί πέρα.",
        "es": "Voy a pedirle a ese camarero de allí.",
        "fi": "Tilaan tuolta tarjoilijalta.",
        "fr": "Je vais commander auprès de ce serveur là-bas.",
        "he": "אני אזמין מהמלצר שם.",
        "hi": "मैं वहाँ वाले वेटर से ऑर्डर दूँगा।",
        "hu": "Attól a pincértől rendelek ott.",
        "id": "Saya akan memesan ke pelayan yang di sana.",
        "it": "Ordinerò da quel cameriere lì.",
        "ja": "あの店員に注文します。",
        "nb": "Jeg skal bestille hos den servitøren der borte.",
        "nl": "Ik bestel bij die ober daar.",
        "pl": "Zamówię u tamtego kelnera.",
        "pt": "Vou pedir àquele garçom ali.",
        "ro": "O să comand de la chelnerul de acolo.",
        "ru": "Я закажу у того официанта.",
        "sv": "Jag beställer av den servitören där borta.",
        "tr": "Şuradaki garsona sipariş vereceğim.",
        "uk": "Я замовлю в того офіціанта там.",
        "vi": "Tôi sẽ gọi món với người phục vụ ở đằng kia.",
        "yue": "我會同嗰邊嗰個侍應落單。",
        "zh-Hans": "我会找那边那位服务员点餐。"
      },
