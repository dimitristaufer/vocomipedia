  "sentences": [
    {
      "target": "겨울에는 온돌 덕분에 방바닥이 따뜻해요.",
      "reading": "gyeoure-neun ondol deokbune bangbadagi ttatteuthaeyo.",
      "translations": {
        "en": "In winter, the floor is warm thanks to the ondol.",
        "ko": "겨울에는 온돌 덕분에 방바닥이 따뜻해요.",
        "ipa": "gyeoure-neun ondol deokbune bangbadagi ttatteuthaeyo.",
        "ar": "في الشتاء تكون الأرضية دافئة بفضل الأوندول.",
        "cs": "V zimě je díky ondolu podlaha teplá.",
        "da": "Om vinteren er gulvet varmt takket være ondol.",
        "de": "Im Winter ist der Boden dank der Ondol-Heizung warm.",
        "el": "Τον χειμώνα το πάτωμα είναι ζεστό χάρη στο οντόλ.",
        "es": "En invierno, el suelo está caliente gracias al ondol.",
        "fi": "Talvella lattia on lämmin ondolin ansiosta.",
        "fr": "En hiver, le sol est chaud grâce à l'ondol.",
        "he": "בחורף הרצפה חמה בזכות האונדול.",
        "hi": "सर्दियों में ओन्डोल की वजह से फर्श गर्म रहता है।",
        "hu": "Télen az ondolnak köszönhetően meleg a padló.",
        "id": "Di musim dingin, lantainya hangat berkat ondol.",
        "it": "In inverno, il pavimento è caldo grazie all'ondol.",
        "ja": "冬はオンドルのおかげで床が暖かいです。",
        "nb": "Om vinteren er gulvet varmt takket være ondol.",
        "nl": "In de winter is de vloer warm dankzij ondol.",
        "pl": "Zimą podłoga jest ciepła dzięki ondolowi.",
        "pt": "No inverno, o chão fica quente graças ao ondol.",
        "ro": "Iarna, podeaua este caldă datorită ondolului.",
        "ru": "Зимой пол тёплый благодаря ондолю.",
        "sv": "På vintern är golvet varmt tack vare ondol.",
        "tr": "Kışın ondol sayesinde zemin sıcak olur.",
        "uk": "Взимку підлога тепла завдяки ондолю.",
        "vi": "Vào mùa đông, sàn nhà ấm nhờ ondol.",
        "yue": "冬天因為暖炕，地板好暖。",
        "zh-Hans": "冬天因为炕床，地板很暖和。"
      },
