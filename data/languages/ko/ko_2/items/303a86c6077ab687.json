  "sentences": [
    {
      "target": "우리 마을은 농업이 중요한 곳이에요.",
      "reading": "uri maeureun nongeobi jungyohan gos-ieyo.",
      "translations": {
        "en": "Our village is a place where agriculture is important.",
        "ko": "우리 마을은 농업이 중요한 곳이에요.",
        "ipa": "uri maeureun nongeobi jungyohan gos-ieyo.",
        "ar": "قريتنا مكان مهم فيه الزراعة.",
        "cs": "Naše vesnice je místo, kde je zemědělství důležité.",
        "da": "Vores landsby er et sted, hvor landbrug er vigtigt.",
        "de": "Unser Dorf ist ein Ort, wo die Landwirtschaft wichtig ist.",
        "el": "Το χωριό μας είναι ένα μέρος όπου η γεωργία είναι σημαντική.",
        "es": "Nuestro pueblo es un lugar donde la agricultura es importante.",
        "fi": "Kylämme on paikka, jossa maatalous on tärkeää.",
        "fr": "Notre village est un endroit où l'agriculture est importante.",
        "he": "הכפר שלנו הוא מקום שבו החקלאות חשובה.",
        "hi": "हमारा गाँव एक ऐसा स्थान है जहाँ कृषि महत्वपूर्ण है।",
        "hu": "A falunk olyan hely, ahol a mezőgazdaság fontos.",
        "id": "Desa kami adalah tempat yang pertanian penting.",
        "it": "Il nostro villaggio è un posto in cui l'agricoltura è importante.",
        "ja": "私たちの村は農業が大切な場所です。",
        "nb": "Landsbyen vår er et sted der landbruk er viktig.",
        "nl": "Ons dorp is een plaats waar landbouw belangrijk is.",
        "pl": "Nasza wieś to miejsce, w którym rolnictwo jest ważne.",
        "pt": "A nossa vila é um lugar onde a agricultura é importante.",
        "ro": "Satul nostru este un loc în care agricultura este importantă.",
        "ru": "Наша деревня — это место, где сельское хозяйство важно.",
        "sv": "Vår by är en plats där jordbruk är viktigt.",
        "tr": "Köyümüz, tarımın önemli olduğu bir yer.",
        "uk": "Наше село — це місце, де сільське господарство важливе.",
        "vi": "Làng của chúng tôi là một nơi mà nông nghiệp rất quan trọng.",
        "yue": "我哋條村係一個農業好重要嘅地方。",
        "zh-Hans": "我们的村子是一个农业很重要的地方。"
      },
