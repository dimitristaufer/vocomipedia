  "sentences": [
    {
      "target": "오늘은 술자리가 길어졌어요.",
      "reading": "oneureun suljariga gireojeosseoyo.",
      "translations": {
        "en": "Tonight’s drinking gathering ran late.",
        "ko": "오늘은 술자리가 길어졌어요.",
        "ipa": "oneureun suljariga gireojeosseoyo.",
        "ar": "استمرّت سهرة الشرب الليلة طويلًا.",
        "cs": "Dnešní posezení u pití se protáhlo.",
        "da": "Drikkeselskabet trak ud i aften.",
        "de": "Die Trinkrunde heute Abend ging lange.",
        "el": "Η βραδιά με ποτό κράτησε πολύ απόψε.",
        "es": "La reunión para beber de hoy se alargó.",
        "fi": "Tämän illan juomistilaisuus venyi pitkäksi.",
        "fr": "La soirée autour de verres a duré tard ce soir.",
        "he": "מפגש השתייה של היום נמשך עד מאוחר.",
        "hi": "आज की शराब-पीने की बैठक बहुत देर तक चली।",
        "hu": "A mai iszogatás sokáig tartott.",
        "id": "Acara minum-minum malam ini berlangsung lama.",
        "it": "La serata alcolica di oggi è andata per le lunghe.",
        "ja": "今日は飲み会が長引きました。",
        "nb": "Drekkesamlingen i kveld dro ut i tid.",
        "nl": "De drinkbijeenkomst vanavond duurde lang.",
        "pl": "Dzisiejsze spotkanie przy piciu trwało długo.",
        "pt": "A confraternização de hoje se estendeu até tarde.",
        "ro": "Petrecerea de băut de azi s-a prelungit.",
        "ru": "Сегодняшняя пьянка затянулась.",
        "sv": "Dryckesrundan i kväll drog ut på tiden.",
        "tr": "Bu akşamki içki buluşması uzadı.",
        "uk": "Сьогоднішня пиятика затягнулася.",
        "vi": "Buổi nhậu hôm nay kéo dài.",
        "yue": "今晚個飲酒聚會搞到好夜。",
        "zh-Hans": "今天的饮酒聚会持续得很晚。"
      },
