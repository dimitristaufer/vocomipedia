  "sentences": [
    {
      "target": "그는 자료 요청을 했어요.",
      "reading": "geuneun jaryo yocheongeul haesseoyo.",
      "translations": {
        "en": "He made a request for the materials.",
        "ko": "그는 자료 요청을 했어요.",
        "ipa": "geuneun jaryo yocheongeul haesseoyo.",
        "ar": "قدم طلبًا للمواد.",
        "cs": "Podal žádost o materiály.",
        "da": "Han bad om materialerne.",
        "de": "Er stellte eine Anfrage nach den Unterlagen.",
        "el": "Έκανε αίτημα για τα υλικά.",
        "es": "Hizo una solicitud de los materiales.",
        "fi": "Hän teki pyynnön materiaaleista.",
        "fr": "Il a fait une demande pour les documents.",
        "he": "הוא הגיש בקשה לחומרים.",
        "hi": "उसने सामग्री के लिए अनुरोध किया।",
        "hu": "Kérést nyújtott be az anyagokra.",
        "id": "Dia membuat permintaan untuk bahan-bahan itu.",
        "it": "Ha fatto una richiesta per i materiali.",
        "ja": "彼は資料の依頼をしました。",
        "nb": "Han ba om materialene.",
        "nl": "Hij deed een verzoek om de materialen.",
        "pl": "Złożył prośbę o materiały.",
        "pt": "Ele fez um pedido pelos materiais.",
        "ro": "A făcut o cerere pentru materiale.",
        "ru": "Он сделал запрос на материалы.",
        "sv": "Han bad om materialet.",
        "tr": "Malzemeler için bir talepte bulundu.",
        "uk": "Він подав запит на матеріали.",
        "vi": "Anh ấy đã yêu cầu tài liệu.",
        "yue": "佢提出咗攞資料嘅要求。",
        "zh-Hans": "他提出了获取材料的请求。"
      },
