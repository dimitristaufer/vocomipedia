  "sentences": [
    {
      "target": "우리 생각은 정반대예요.",
      "reading": "uri saenggakeun jeongbandae-yeyo.",
      "translations": {
        "en": "Our opinions are the exact opposite.",
        "ko": "우리 생각은 정반대예요.",
        "ipa": "uri saenggakeun jeongbandae-yeyo.",
        "ar": "رأينا متعاكسان تمامًا.",
        "cs": "Naše názory jsou úplný opak.",
        "da": "Vores holdninger er stik modsatte.",
        "de": "Unsere Meinungen sind genau das Gegenteil.",
        "el": "Οι απόψεις μας είναι ακριβώς αντίθετες.",
        "es": "Nuestras opiniones son justo lo contrario.",
        "fi": "Mielipiteemme ovat aivan päinvastaiset.",
        "fr": "Nos opinions sont exactement opposées.",
        "he": "הדעות שלנו הן בדיוק ההפך.",
        "hi": "हमारी सोच एकदम उलट है।",
        "hu": "A véleményünk teljesen ellentétes.",
        "id": "Pendapat kami sangat bertolak belakang.",
        "it": "Le nostre opinioni sono esattamente opposte.",
        "ja": "私たちの考えは正反対です。",
        "nb": "Vi mener helt motsatt.",
        "nl": "Onze meningen zijn precies tegengesteld.",
        "pl": "Nasze opinie są dokładnie przeciwne.",
        "pt": "As nossas opiniões são exatamente opostas.",
        "ro": "Opiniile noastre sunt exact opuse.",
        "ru": "Наши мнения прямо противоположны.",
        "sv": "Våra åsikter är helt motsatta.",
        "tr": "Düşüncelerimiz tam zıttı.",
        "uk": "Наші думки — цілковита протилежність.",
        "vi": "Ý kiến của chúng tôi hoàn toàn trái ngược.",
        "yue": "我哋嘅想法完全相反。",
        "zh-Hans": "我们的想法完全相反。"
