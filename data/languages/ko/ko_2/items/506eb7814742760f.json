  "sentences": [
    {
      "target": "그는 친구의 비판을 받아들였어요.",
      "reading": "geuneun chingu-ui bipaneul badadeureosseoyo.",
      "translations": {
        "en": "He accepted his friend's criticism.",
        "ko": "그는 친구의 비판을 받아들였어요.",
        "ipa": "geuneun chingu-ui bipaneul badadeureosseoyo.",
        "ar": "تقبّل انتقاد صديقه.",
        "cs": "Přijal kritiku od svého přítele.",
        "da": "Han tog imod sin vens kritik.",
        "de": "Er nahm die Kritik seines Freundes an.",
        "el": "Δέχτηκε την κριτική του φίλου του.",
        "es": "Aceptó la crítica de su amigo.",
        "fi": "Hän hyväksyi ystävänsä kritiikin.",
        "fr": "Il a accepté la critique de son ami.",
        "he": "הוא קיבל את הביקורת של חברו.",
        "hi": "उसने अपने दोस्त की आलोचना स्वीकार कर ली।",
        "hu": "Elfogadta a barátja kritikáját.",
        "id": "Dia menerima kritik dari temannya.",
        "it": "Ha accettato la critica del suo amico.",
        "ja": "彼は友達の批判を受け入れました。",
        "nb": "Han godtok vennens kritikk.",
        "nl": "Hij accepteerde de kritiek van zijn vriend.",
        "pl": "Przyjął krytykę swojego przyjaciela.",
        "pt": "Ele aceitou a crítica do amigo.",
        "ro": "A acceptat critica prietenului său.",
        "ru": "Он принял критику своего друга.",
        "sv": "Han tog emot sin väns kritik.",
        "tr": "Arkadaşının eleştirisini kabul etti.",
        "uk": "Він прийняв критику свого друга.",
        "vi": "Anh ấy đã chấp nhận lời phê bình của bạn mình.",
        "yue": "佢接受咗朋友嘅批評。",
        "zh-Hans": "他接受了朋友的批评。"
      },
