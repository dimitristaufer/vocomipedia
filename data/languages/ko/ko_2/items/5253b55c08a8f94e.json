    {
      "target": "공원에서 달리다가 넘어졌어요.",
      "reading": "gongwoneseo dallidaga neomeojyeosseoyo.",
      "translations": {
        "en": "I fell while running in the park.",
        "ko": "공원에서 달리다가 넘어졌어요.",
        "ipa": "gongwoneseo dallidaga neomeojyeosseoyo.",
        "ar": "وقعت وأنا أركض في الحديقة.",
        "cs": "Spadl jsem, když jsem běžel v parku.",
        "da": "Jeg faldt, mens jeg løb i parken.",
        "de": "Ich bin im Park beim Laufen hingefallen.",
        "el": "Έπεσα ενώ έτρεχα στο πάρκο.",
        "es": "Me caí mientras corría en el parque.",
        "fi": "Kaaduin juostessani puistossa.",
        "fr": "Je suis tombé en courant dans le parc.",
        "he": "נפלתי כשצדתי בפארק.",
        "hi": "मैं पार्क में दौड़ते हुए गिर गया।",
        "hu": "Elestem, miközben a parkban futottam.",
        "id": "Saya jatuh saat berlari di taman.",
        "it": "Sono caduto mentre correvo nel parco.",
        "ja": "公園で走っていて転びました。",
        "nb": "Jeg falt mens jeg løp i parken.",
        "nl": "Ik viel terwijl ik in het park aan het hardlopen was.",
        "pl": "Upadłem, gdy biegałem w parku.",
        "pt": "Eu caí enquanto corria no parque.",
        "ro": "Am căzut în timp ce alergam în parc.",
        "ru": "Я упал, когда бежал в парке.",
        "sv": "Jag föll när jag sprang i parken.",
        "tr": "Parkta koşarken düştüm.",
        "uk": "Я впав, коли біг у парку.",
        "vi": "Tôi bị ngã khi đang chạy trong công viên.",
        "yue": "我喺公園跑步嗰陣跌咗。",
        "zh-Hans": "我在公园跑步时摔倒了。"
      },
