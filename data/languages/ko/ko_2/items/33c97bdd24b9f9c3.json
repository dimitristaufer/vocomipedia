  "sentences": [
    {
      "target": "왕비는 꽃 정원을 천천히 걸었어요.",
      "reading": "wangbineun kkot jeongwoneul cheoncheonhi georeosseoyo.",
      "translations": {
        "en": "The queen walked slowly through the flower garden.",
        "ko": "왕비는 꽃 정원을 천천히 걸었어요.",
        "ipa": "wangbineun kkot jeongwoneul cheoncheonhi georeosseoyo.",
        "ar": "سارت الملكة ببطء في حديقة الزهور.",
        "cs": "Královna šla pomalu květinovou zahradou.",
        "da": "Dronningen gik langsomt gennem blomsterhaven.",
        "de": "Die Königin ging langsam durch den Blumengarten.",
        "el": "Η βασίλισσα περπάτησε αργά στον κήπο με τα λουλούδια.",
        "es": "La reina caminó despacio por el jardín de flores.",
        "fi": "Kuningatar käveli hitaasti kukkapuutarhan läpi.",
        "fr": "La reine a marché lentement dans le jardin de fleurs.",
        "he": "המלכה הלכה לאט בגינת הפרחים.",
        "hi": "रानी फूलों के बगीचे में धीरे-धीरे चली।",
        "hu": "A királynő lassan sétált a virágoskertben.",
        "id": "Ratu berjalan perlahan di taman bunga.",
        "it": "La regina camminava lentamente nel giardino dei fiori.",
        "ja": "王妃は花の庭をゆっくり歩きました。",
        "nb": "Dronningen gikk sakte gjennom blomsterhagen.",
        "nl": "De koningin liep langzaam door de bloementuin.",
        "pl": "Królowa szła powoli przez ogród kwiatowy.",
        "pt": "A rainha caminhou devagar pelo jardim de flores.",
        "ro": "Regina a mers încet prin grădina de flori.",
        "ru": "Королева медленно шла по цветочному саду.",
        "sv": "Drottningen gick långsamt genom blomstergården.",
        "tr": "Kraliçe çiçek bahçesinde yavaşça yürüdü.",
        "uk": "Королева повільно йшла квітковим садом.",
        "vi": "Hoàng hậu đi chậm trong vườn hoa.",
        "yue": "王妃喺花園慢慢咁行。",
        "zh-Hans": "王妃在花园里慢慢走。"
      },
