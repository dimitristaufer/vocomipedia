    {
      "target": "저는 매일 걷기 운동을 해요.",
      "reading": "jeoneun maeil geotgi undongeul haeyo.",
      "translations": {
        "en": "I do walking exercise every day.",
        "ko": "저는 매일 걷기 운동을 해요.",
        "ipa": "jeoneun maeil geotgi undongeul haeyo.",
        "ar": "أمارس المشي كل يوم.",
        "cs": "Každý den chodím na procházku.",
        "da": "Jeg går en tur hver dag.",
        "de": "Ich mache jeden Tag Spaziergänge.",
        "el": "Κάνω περπάτημα κάθε μέρα.",
        "es": "Hago ejercicio caminando todos los días.",
        "fi": "Käyn kävelemässä joka päivä.",
        "fr": "Je fais de la marche tous les jours.",
        "he": "אני עושה הליכות כל יום.",
        "hi": "मैं हर दिन पैदल चलने का व्यायाम करता हूँ।",
        "hu": "Minden nap sétálok egyet.",
        "id": "Saya berolahraga jalan kaki setiap hari.",
        "it": "Faccio una passeggiata ogni giorno.",
        "ja": "私は毎日ウォーキングをします。",
        "nb": "Jeg går en tur hver dag.",
        "nl": "Ik ga elke dag wandelen.",
        "pl": "Codziennie chodzę na spacer.",
        "pt": "Eu faço caminhada todos os dias.",
        "ro": "Fac exerciții de mers pe jos în fiecare zi.",
        "ru": "Я каждый день хожу пешком.",
        "sv": "Jag går en promenad varje dag.",
        "tr": "Her gün yürüyüş yaparım.",
        "uk": "Я щодня ходжу пішки.",
        "vi": "Tôi đi bộ tập thể dục mỗi ngày.",
        "yue": "我每日都做步行運動。",
        "zh-Hans": "我每天都做步行锻炼。"
      },
