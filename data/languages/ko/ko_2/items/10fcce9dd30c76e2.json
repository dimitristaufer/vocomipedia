    {
      "target": "저는 친구를 설득했어요.",
      "reading": "jeoneun chingureul seoldeukhaesseoyo.",
      "translations": {
        "en": "I persuaded my friend.",
        "ko": "저는 친구를 설득했어요.",
        "ipa": "jeoneun chingureul seoldeukhaesseoyo.",
        "ar": "أقنعتُ صديقي.",
        "cs": "Přesvědčil jsem svého přítele.",
        "da": "Jeg overtalte min ven.",
        "de": "Ich habe meinen Freund überzeugt.",
        "el": "Έπεισα τον φίλο μου.",
        "es": "Convencí a mi amigo.",
        "fi": "Sain ystäväni suostuteltua.",
        "fr": "J'ai convaincu mon ami.",
        "he": "שכנעתי את החבר שלי.",
        "hi": "मैंने अपने दोस्त को मना लिया।",
        "hu": "Meggyőztem a barátomat.",
        "id": "Saya meyakinkan teman saya.",
        "it": "Ho convinto il mio amico.",
        "ja": "私は友達を説得しました。",
        "nb": "Jeg overbeviste vennen min.",
        "nl": "Ik heb mijn vriend overgehaald.",
        "pl": "Przekonałem mojego przyjaciela.",
        "pt": "Convenci meu amigo.",
        "ro": "Mi-am convins prietenul.",
        "ru": "Я убедил своего друга.",
        "sv": "Jag övertalade min vän.",
        "tr": "Arkadaşımı ikna ettim.",
        "uk": "Я переконав свого друга.",
        "vi": "Tôi đã thuyết phục bạn tôi.",
        "yue": "我說服咗我朋友。",
        "zh-Hans": "我说服了我的朋友。"
      },
