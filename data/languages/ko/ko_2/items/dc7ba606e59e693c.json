  "sentences": [
    {
      "target": "눈 위에 발자국 자취가 길게 남아 있어요.",
      "reading": "nun wie baljaguk jachwiga gilge nama isseoyo.",
      "translations": {
        "en": "Footprints are left long on the snow.",
        "ko": "눈 위에 발자국 자취가 길게 남아 있어요.",
        "ipa": "nun wie baljaguk jachwiga gilge nama isseoyo.",
        "ar": "تترك آثار الأقدام أثرًا طويلًا على الثلج.",
        "cs": "Na sněhu zůstávají dlouhé stopy.",
        "da": "Fodsporene bliver liggende langt på sneen.",
        "de": "Auf dem Schnee sind lange Fußspuren zu sehen.",
        "el": "Στο χιόνι μένουν μακριά πατήματα.",
        "es": "Quedan huellas largas sobre la nieve.",
        "fi": "Lumeen jää pitkät jalanjäljet.",
        "fr": "Des empreintes longues restent sur la neige.",
        "he": "עקבות נשארות ארוכות על השלג.",
        "hi": "बर्फ पर पैरों के निशान लंबे रह गए हैं।",
        "hu": "A hóban hosszú lábnyomok maradnak.",
        "id": "Jejak kaki tertinggal panjang di salju.",
        "it": "Sulla neve restano lunghe impronte.",
        "ja": "雪の上に長い足跡が残っています。",
        "nb": "Fotsporene ligger lenge i snøen.",
        "nl": "Op de sneeuw blijven lange voetstappen achter.",
        "pl": "Na śniegu zostają długie ślady stóp.",
        "pt": "Ficam pegadas compridas na neve.",
        "ro": "Pe zăpadă rămân urme lungi de pași.",
        "ru": "На снегу остаются длинные следы.",
        "sv": "Fotspåren ligger kvar länge i snön.",
        "tr": "Karda uzun ayak izleri kalıyor.",
        "uk": "На снігу лишаються довгі сліди.",
        "vi": "Dấu chân in dài trên tuyết.",
        "yue": "雪上面留低好長嘅腳印。",
        "zh-Hans": "雪地上留下了长长的脚印。"
      },
