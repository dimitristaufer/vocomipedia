    {
      "target": "저는 수학 가정교사를 찾고 있어요.",
      "reading": "jeoneun suhak gajeonggyosareul chatgo isseoyo.",
      "translations": {
        "en": "I'm looking for a math tutor.",
        "ko": "저는 수학 가정교사를 찾고 있어요.",
        "ipa": "jeoneun suhak gajeonggyosareul chatgo isseoyo.",
        "ar": "أبحث عن مدرس رياضيات خاص.",
        "cs": "Hledám doučovatele na matematiku.",
        "da": "Jeg leder efter en matematiklærer.",
        "de": "Ich suche einen Mathe-Nachhilfelehrer.",
        "el": "Ψάχνω για ιδιαίτερο δάσκαλο μαθηματικών.",
        "es": "Busco un tutor de matemáticas.",
        "fi": "Etsin matematiikan yksityisopettajaa.",
        "fr": "Je cherche un professeur particulier de maths.",
        "he": "אני מחפש מורה פרטי למתמטיקה.",
