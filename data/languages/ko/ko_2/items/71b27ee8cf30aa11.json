    {
      "target": "그는 비밀번호를 수시로 바꿔요.",
      "reading": "geuneun bimilbeonhoreul susiro bakkwoyo.",
      "translations": {
        "en": "He changes his password all the time.",
        "ko": "그는 비밀번호를 수시로 바꿔요.",
        "ipa": "geuneun bimilbeonhoreul susiro bakkwoyo.",
        "ar": "يغيّر كلمة مروره كثيرًا.",
        "cs": "Mění heslo pořád.",
        "da": "Han skifter sit kodeord hele tiden.",
        "de": "Er ändert ständig sein Passwort.",
        "el": "Αλλάζει συχνά τον κωδικό του.",
        "es": "Cambia su contraseña todo el tiempo.",
        "fi": "Hän vaihtaa salasanansa koko ajan.",
        "fr": "Il change son mot de passe tout le temps.",
        "he": "הוא מחליף את הסיסמה שלו כל הזמן.",
        "hi": "वह अपना पासवर्ड बार-बार बदलता है।",
        "hu": "Folyton változtatja a jelszavát.",
        "id": "Dia sering mengganti kata sandinya.",
        "it": "Cambia spesso la sua password.",
        "ja": "彼はいつもパスワードを変えます。",
        "nb": "Han bytter passord hele tiden.",
        "nl": "Hij verandert zijn wachtwoord de hele tijd.",
        "pl": "On cały czas zmienia hasło.",
        "pt": "Ele troca a senha o tempo todo.",
        "ro": "Își schimbă parola tot timpul.",
        "ru": "Он всё время меняет пароль.",
        "sv": "Han byter lösenord hela tiden.",
        "tr": "Şifresini sık sık değiştiriyor.",
        "uk": "Він увесь час змінює пароль.",
        "vi": "Anh ấy thường xuyên đổi mật khẩu.",
        "yue": "佢成日改密碼。",
        "zh-Hans": "他总是更改密码。"
      },
