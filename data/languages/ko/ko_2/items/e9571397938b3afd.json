    {
      "target": "할아버지는 매를 들고 말을 탔어요.",
      "reading": "harabeojineun maereul deulgo mareul tasseoyo.",
      "translations": {
        "en": "Grandfather rode the horse with a whip.",
        "ko": "할아버지는 매를 들고 말을 탔어요.",
        "ipa": "harabeojineun maereul deulgo mareul tasseoyo.",
        "ar": "ركب الجد الحصان وهو يحمل سوطًا.",
        "cs": "Dědeček jel na koni s bičem.",
        "da": "Bedstefar red på hesten med en pisk.",
        "de": "Der Großvater ritt mit einer Peitsche auf dem Pferd.",
        "el": "Ο παππούς καβάλησε το άλογο κρατώντας ένα μαστίγιο.",
        "es": "El abuelo montó el caballo con un látigo.",
        "fi": "Isoisä ratsasti hevosella piiska kädessään.",
        "fr": "Le grand-père est monté à cheval avec un fouet.",
        "he": "הסבא רכב על הסוס עם שוט.",
        "hi": "दादाजी ने चाबुक लेकर घोड़े की सवारी की।",
        "hu": "A nagypapa ostorral lovagolt a lovon.",
        "id": "Kakek menunggang kuda sambil membawa cambuk.",
        "it": "Il nonno cavalcava il cavallo con una frusta.",
        "ja": "おじいさんはむちを持って馬に乗りました。",
        "nb": "Bestefaren red på hesten med en pisk.",
        "nl": "Opa reed op het paard met een zweep.",
        "pl": "Dziadek jechał na koniu z biczem.",
        "pt": "O avô montou no cavalo com um chicote.",
        "ro": "Bunicul a călărit calul cu un bici.",
        "ru": "Дедушка ехал на лошади с плетью.",
        "sv": "Farfar red på hästen med en piska.",
        "tr": "Dede, elinde bir kırbaçla ata bindi.",
        "uk": "Дідусь їхав на коні з батогом.",
        "vi": "Ông nội cưỡi ngựa với một cái roi.",
        "yue": "爺爺攞住條鞭騎馬。",
        "zh-Hans": "爷爷拿着鞭子骑马。"
      },
