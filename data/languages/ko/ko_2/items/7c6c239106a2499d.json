  "sentences": [
    {
      "target": "주말에 친정에 갔어요.",
      "reading": "jumare chinjeonge gasseoyo.",
      "translations": {
        "en": "I went to my parents' home for the weekend.",
        "ko": "주말에 친정에 갔어요.",
        "ipa": "jumare chinjeonge gasseoyo.",
        "ar": "ذهبتُ إلى بيت أهلي في عطلة نهاية الأسبوع.",
        "cs": "O víkendu jsem byla u rodičů.",
        "da": "Jeg tog hjem til mine forældre i weekenden.",
        "de": "Ich bin am Wochenende zu meinen Eltern gefahren.",
        "el": "Πήγα στους γονείς μου το Σαββατοκύριακο.",
        "es": "Fui a casa de mis padres el fin de semana.",
        "fi": "Kävin viikonloppuna vanhempieni luona.",
        "fr": "Je suis allée chez mes parents le week-end.",
        "he": "הלכתי לבית של ההורים שלי בסוף השבוע.",
        "hi": "मैं वीकेंड पर अपने मायके गई।",
        "hu": "A hétvégén a szüleimhez mentem.",
        "id": "Saya pergi ke rumah orang tua saya saat akhir pekan.",
        "it": "Sono andata a casa dei miei genitori nel fine settimana.",
        "ja": "週末に実家へ行きました。",
        "nb": "Jeg dro hjem til foreldrene mine i helgen.",
        "nl": "Ik ging in het weekend naar mijn ouders.",
        "pl": "Pojechałam do rodziców na weekend.",
        "pt": "Fui para a casa dos meus pais no fim de semana.",
        "ro": "M-am dus la părinții mei în weekend.",
        "ru": "На выходных я ездила к родителям.",
        "sv": "Jag åkte hem till mina föräldrar i helgen.",
        "tr": "Hafta sonu ailemin evine gittim.",
        "uk": "На вихідних я їздила до батьків.",
        "vi": "Cuối tuần tôi về nhà ngoại.",
        "yue": "週末我返咗外家。",
        "zh-Hans": "周末我回了娘家。"
      },
