  "sentences": [
    {
      "target": "저는 오른손으로 글씨를 써요.",
      "reading": "jeoneun oreunson-euro geulssireul sseoyo.",
      "translations": {
        "en": "I write with my right hand.",
        "ko": "저는 오른손으로 글씨를 써요.",
        "ipa": "jeoneun oreunson-euro geulssireul sseoyo.",
        "ar": "أكتب بيدي اليمنى.",
        "cs": "Píšu pravou rukou.",
        "da": "Jeg skriver med højre hånd.",
        "de": "Ich schreibe mit der rechten Hand.",
        "el": "Γράφω με το δεξί μου χέρι.",
        "es": "Escribo con la mano derecha.",
        "fi": "Kirjoitan oikealla kädellä.",
        "fr": "J'écris de la main droite.",
        "he": "אני כותב ביד ימין.",
        "hi": "मैं दाहिने हाथ से लिखता हूँ।",
        "hu": "Jobb kézzel írok.",
        "id": "Saya menulis dengan tangan kanan.",
        "it": "Scrivo con la mano destra.",
        "ja": "私は右手で字を書きます。",
        "nb": "Jeg skriver med høyre hånd.",
        "nl": "Ik schrijf met mijn rechterhand.",
        "pl": "Piszę prawą ręką.",
        "pt": "Eu escrevo com a mão direita.",
        "ro": "Scriu cu mâna dreaptă.",
        "ru": "Я пишу правой рукой.",
        "sv": "Jag skriver med höger hand.",
        "tr": "Sağ elimle yazıyorum.",
        "uk": "Я пишу правою рукою.",
        "vi": "Tôi viết bằng tay phải.",
        "yue": "我用右手寫字。",
        "zh-Hans": "我用右手写字。"
      },
