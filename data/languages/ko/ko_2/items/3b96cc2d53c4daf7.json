    {
      "target": "우리는 각자 집에 갔어요.",
      "reading": "urineun gakja jibe gasseoyo.",
      "translations": {
        "en": "We each went home.",
        "ko": "우리는 각자 집에 갔어요.",
        "ipa": "urineun gakja jibe gasseoyo.",
        "ar": "ذهب كل واحد منا إلى بيته.",
        "cs": "Každý z nás šel domů.",
        "da": "Vi gik hver til sit hjem.",
        "de": "Wir gingen jeder nach Hause.",
        "el": "Πήγαμε ο καθένας σπίτι του.",
        "es": "Cada uno de nosotros se fue a casa.",
        "fi": "Me menimme kukin kotiin.",
        "fr": "Nous sommes chacun rentrés chez nous.",
        "he": "כולנו הלכנו כל אחד הביתה.",
        "hi": "हममें से हर कोई अपने घर गया।",
        "hu": "Mindannyian hazamentünk.",
        "id": "Kami masing-masing pulang ke rumah.",
        "it": "Siamo andati ciascuno a casa.",
        "ja": "私たちはそれぞれ家に帰りました。",
        "nb": "Vi gikk hver til vårt hjem.",
        "nl": "We gingen allemaal naar huis.",
        "pl": "Każdy z nas poszedł do domu.",
        "pt": "Cada um de nós foi para casa.",
        "ro": "Fiecare dintre noi a mers acasă.",
        "ru": "Мы каждый пошли домой.",
        "sv": "Vi gick hem var för sig.",
        "tr": "Hepimiz kendi evimize gittik.",
        "uk": "Ми кожен пішли додому.",
        "vi": "Chúng tôi mỗi người về nhà.",
        "yue": "我哋各自返屋企。",
        "zh-Hans": "我们各自回家了。"
      },
