  "sentences": [
    {
      "target": "채소를 썰다가 손을 베었어요.",
      "reading": "chaesoreul sseoldaga soneul beeosseoyo.",
      "translations": {
        "en": "I cut my hand while slicing vegetables.",
        "ko": "채소를 썰다가 손을 베었어요.",
        "ipa": "chaesoreul sseoldaga soneul beeosseoyo.",
        "ar": "جرحتُ يدي وأنا أقطّع الخضار.",
        "cs": "Při krájení zeleniny jsem si řízl do ruky.",
        "da": "Jeg skar mig i hånden, mens jeg skar grøntsager.",
        "de": "Ich habe mir beim Schneiden von Gemüse in die Hand geschnitten.",
        "el": "Κόπηκα στο χέρι μου ενώ έκοβα λαχανικά.",
        "es": "Me corté la mano mientras cortaba verduras.",
        "fi": "Viilsin käteeni vihanneksia pilkkoessani.",
        "fr": "Je me suis coupé la main en coupant des légumes.",
        "he": "חתכתי את היד בזמן שחתכתי ירקות.",
        "hi": "सब्ज़ियाँ काटते समय मैंने अपना हाथ काट लिया।",
        "hu": "Megvágtam a kezemet, miközben zöldséget szeleteltem.",
        "id": "Saya melukai tangan saya saat mengiris sayuran.",
        "it": "Mi sono tagliato la mano mentre tagliavo le verdure.",
        "ja": "野菜を切っていて手を切りました。",
        "nb": "Jeg skar meg i hånden mens jeg skar grønnsaker.",
        "nl": "Ik sneed in mijn hand terwijl ik groenten sneed.",
        "pl": "Zaciąłem się w rękę, kiedy kroiłem warzywa.",
        "pt": "Cortei a mão enquanto cortava legumes.",
        "ro": "M-am tăiat la mână în timp ce tăiam legume.",
        "ru": "Я порезал руку, когда резал овощи.",
        "sv": "Jag skar mig i handen när jag skar grönsaker.",
        "tr": "Sebze doğrarken elimi kestim.",
        "uk": "Я порізав руку, коли різав овочі.",
        "vi": "Tôi bị cứa vào tay khi cắt rau.",
        "yue": "我切緊蔬菜嗰陣整親隻手。",
        "zh-Hans": "我切菜的时候把手划伤了。"
      },
