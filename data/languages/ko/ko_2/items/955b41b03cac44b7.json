  "sentences": [
    {
      "target": "좋은 기억이 아직 남아 있어요.",
      "reading": "joeun gieogi ajik nama isseoyo.",
      "translations": {
        "en": "I still have a good memory.",
        "ko": "좋은 기억이 아직 남아 있어요.",
        "ipa": "joeun gieogi ajik nama isseoyo.",
        "ar": "ما زالت لديّ ذكرى جميلة.",
        "cs": "Stále mám hezkou vzpomínku.",
        "da": "Jeg har stadig et godt minde.",
        "de": "Ich habe noch eine schöne Erinnerung.",
        "el": "Έχω ακόμα μια ωραία ανάμνηση.",
        "es": "Todavía tengo un buen recuerdo.",
        "fi": "Minulla on yhä hyvä muisto.",
        "fr": "J’ai encore un bon souvenir.",
        "he": "נשאר לי עדיין זיכרון טוב.",
        "hi": "मेरे पास अभी भी एक अच्छी याद है।",
        "hu": "Még mindig van egy szép emlékem.",
        "id": "Saya masih punya kenangan indah.",
        "it": "Ho ancora un bel ricordo.",
        "ja": "まだいい思い出があります。",
        "nb": "Jeg har fortsatt et godt minne.",
        "nl": "Ik heb nog steeds een mooie herinnering.",
        "pl": "Nadal mam miłe wspomnienie.",
        "pt": "Ainda tenho uma boa lembrança.",
        "ro": "Încă am o amintire frumoasă.",
        "ru": "У меня до сих пор осталась хорошая память.",
        "sv": "Jag har fortfarande ett fint minne.",
        "tr": "Hâlâ güzel bir anım var.",
        "uk": "У мене досі є гарний спогад.",
        "vi": "Tôi vẫn còn một kỷ niệm đẹp.",
        "yue": "我仲有一個美好嘅回憶。",
        "zh-Hans": "我还有一段美好的回忆。"
      },
