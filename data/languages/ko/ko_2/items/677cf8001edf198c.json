  "sentences": [
    {
      "target": "헬기가 하늘에서 천천히 내려왔어요.",
      "reading": "helgi-ga haneul-eseo cheoncheonhi naeryeowasseoyo.",
      "translations": {
        "en": "The helicopter came down slowly from the sky.",
        "ko": "헬기가 하늘에서 천천히 내려왔어요.",
        "ipa": "helgi-ga haneul-eseo cheoncheonhi naeryeowasseoyo.",
        "ar": "نزلت المروحية ببطء من السماء.",
        "cs": "Vrtulník pomalu sestupoval z nebe.",
        "da": "Helikopteren kom langsomt ned fra himlen.",
        "de": "Der Hubschrauber kam langsam vom Himmel herunter.",
        "el": "Το ελικόπτερο κατέβηκε αργά από τον ουρανό.",
        "es": "El helicóptero bajó lentamente del cielo.",
        "fi": "Helikopteri laskeutui hitaasti taivaalta.",
        "fr": "L'hélicoptère est descendu lentement du ciel.",
        "he": "המסוק ירד לאט מהשמיים.",
        "hi": "हेलिकॉप्टर धीरे-धीरे आसमान से नीचे आया।",
        "hu": "A helikopter lassan ereszkedett le az égből.",
        "id": "Helikopter itu turun perlahan dari langit.",
        "it": "L'elicottero scese lentamente dal cielo.",
        "ja": "ヘリコプターが空からゆっくり下りてきました。",
        "nb": "Helikopteren kom sakte ned fra himmelen.",
        "nl": "De helikopter kwam langzaam uit de lucht naar beneden.",
        "pl": "Helikopter powoli zniżał się z nieba.",
        "pt": "O helicóptero desceu lentamente do céu.",
        "ro": "Elicopterul a coborât încet din cer.",
        "ru": "Вертолёт медленно опустился с неба.",
        "sv": "Helikoptern kom långsamt ner från himlen.",
        "tr": "Helikopter gökyüzünden yavaşça indi.",
        "uk": "Гелікоптер повільно спустився з неба.",
        "vi": "Trực thăng hạ xuống chậm từ trên trời.",
        "yue": "直升機慢慢咁由天空降落。",
        "zh-Hans": "直升机从天上慢慢降下来。"
      },
