  "sentences": [
    {
      "target": "우리는 산길을 따라 골짜기로 내려갔어요.",
      "reading": "urineun sanggireul ttara goljjakiro naeryeogasseoyo.",
      "translations": {
        "en": "We went down into the valley along the mountain path.",
        "ko": "우리는 산길을 따라 골짜기로 내려갔어요.",
        "ipa": "urineun sanggireul ttara goljjakiro naeryeogasseoyo.",
        "ar": "نزلنا إلى الوادي على طول الطريق الجبلي.",
        "cs": "Šli jsme dolů do údolí po horské stezce.",
        "da": "Vi gik ned i dalen ad bjergstien.",
        "de": "Wir gingen den Bergpfad entlang ins Tal hinunter.",
        "el": "Κατεβήκαμε στην κοιλάδα κατά μήκος του ορεινού μονοπατιού.",
        "es": "Bajamos al valle por el sendero de la montaña.",
        "fi": "Menimme alas laaksoon vuoripolkua pitkin.",
        "fr": "Nous sommes descendus dans la vallée le long du sentier de montagne.",
        "he": "ירדנו אל העמק לאורך שביל ההרים.",
        "hi": "हम पहाड़ी रास्ते से होकर घाटी में नीचे गए।",
        "hu": "A hegyi ösvényen lefelé mentünk a völgybe.",
        "id": "Kami turun ke lembah lewat jalan setapak di gunung.",
        "it": "Siamo scesi nella valle lungo il sentiero di montagna.",
        "ja": "私たちは山道に沿って谷へ下りました。",
        "nb": "Vi gikk ned i dalen langs fjellstien.",
        "nl": "We liepen langs het bergpad omlaag naar de vallei.",
        "pl": "Zeszliśmy do doliny górską ścieżką.",
        "pt": "Descemos até o vale pela trilha da montanha.",
        "ro": "Am coborât în vale pe poteca de munte.",
        "ru": "Мы спустились в долину по горной тропе.",
        "sv": "Vi gick ner i dalen längs bergsstigen.",
        "tr": "Dağ yolunu takip ederek vadiye indik.",
        "uk": "Ми спустилися в долину гірською стежкою.",
        "vi": "Chúng tôi đi xuống thung lũng theo con đường núi.",
        "yue": "我哋沿住山路落去山谷。",
        "zh-Hans": "我们沿着山路下到山谷里。"
      },
