  "sentences": [
    {
      "target": "오늘은 우리 아버지가 집안의 주인공이에요.",
      "reading": "oneureun uri abeojiga jiban-ui juingong-ieyo.",
      "translations": {
        "en": "Today, my father is the star of the family.",
        "ko": "오늘은 우리 아버지가 집안의 주인공이에요.",
        "ipa": "oneureun uri abeojiga jiban-ui juingong-ieyo.",
        "ar": "اليوم أبي هو محور العائلة.",
        "cs": "Dnes je můj táta středem rodiny.",
        "da": "I dag er min far familiens midtpunkt.",
        "de": "Heute ist mein Vater der Mittelpunkt der Familie.",
        "el": "Σήμερα ο πατέρας μου είναι το επίκεντρο της οικογένειας.",
        "es": "Hoy, mi padre es el centro de la familia.",
        "fi": "Tänään isäni on perheen keskipiste.",
        "fr": "Aujourd'hui, mon père est la vedette de la famille.",
        "he": "היום אבא שלי הוא מרכז המשפחה.",
        "hi": "आज मेरे पिताजी परिवार के केंद्र हैं।",
        "hu": "Ma az apám a család középpontja.",
        "id": "Hari ini ayah saya jadi pusat keluarga.",
        "it": "Oggi mio padre è il centro della famiglia.",
        "ja": "今日はうちの父が家族の中心です。",
        "nb": "I dag er faren min familiens midtpunkt.",
        "nl": "Vandaag is mijn vader het middelpunt van het gezin.",
        "pl": "Dziś mój tata jest centrum rodziny.",
        "pt": "Hoje, meu pai é o centro da família.",
        "ro": "Astăzi, tatăl meu este în centrul familiei.",
        "ru": "Сегодня мой отец — центр семьи.",
        "sv": "I dag är min pappa familjens mittpunkt.",
        "tr": "Bugün babam ailenin merkezinde.",
        "uk": "Сьогодні мій тато — центр родини.",
        "vi": "Hôm nay bố tôi là trung tâm của gia đình.",
        "yue": "今日我爸爸係屋企嘅主角。",
        "zh-Hans": "今天我爸爸是家里的主角。"
      },
