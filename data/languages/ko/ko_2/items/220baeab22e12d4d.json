  "sentences": [
    {
      "target": "선생님이 아이들을 박물관으로 이끌었어요.",
      "reading": "seonsaengnimi aideureul bakmulgwan-euro ikkeureosseoyo.",
      "translations": {
        "en": "The teacher led the children to the museum.",
        "ko": "선생님이 아이들을 박물관으로 이끌었어요.",
        "ipa": "seonsaengnimi aideureul bakmulgwan-euro ikkeureosseoyo.",
        "ar": "قادت المعلمة الأطفال إلى المتحف.",
        "cs": "Učitelka vedla děti do muzea.",
        "da": "Læreren førte børnene til museet.",
        "de": "Die Lehrerin führte die Kinder zum Museum.",
        "el": "Η δασκάλα οδήγησε τα παιδιά στο μουσείο.",
        "es": "La maestra llevó a los niños al museo.",
        "fi": "Opettaja vei lapset museoon.",
        "fr": "L'enseignante a emmené les enfants au musée.",
        "he": "המורה הובילה את הילדים אל המוזיאון.",
        "hi": "शिक्षिका बच्चों को संग्रहालय ले गईं।",
        "hu": "A tanárnő elvezette a gyerekeket a múzeumba.",
        "id": "Guru itu membawa anak-anak ke museum.",
        "it": "L'insegnante ha accompagnato i bambini al museo.",
        "ja": "先生が子どもたちを博物館へ連れていきました。",
        "nb": "Læreren ledet barna til museet.",
        "nl": "De lerares leidde de kinderen naar het museum.",
        "pl": "Nauczycielka zaprowadziła dzieci do muzeum.",
        "pt": "A professora levou as crianças ao museu.",
        "ro": "Profesoara i-a condus pe copii la muzeu.",
        "ru": "Учительница отвела детей в музей.",
        "sv": "Läraren ledde barnen till museet.",
        "tr": "Öğretmen çocukları müzeye götürdü.",
        "uk": "Учителька повела дітей до музею.",
        "vi": "Cô giáo đã dẫn bọn trẻ đến bảo tàng.",
        "yue": "老師帶咗啲小朋友去博物館。",
        "zh-Hans": "老师带着孩子们去了博物馆。"
      },
