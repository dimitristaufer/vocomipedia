  "sentences": [
    {
      "target": "주말에는 이것저것 하느라 바빠요.",
      "reading": "jumareneun igeosjeogeos haneura bappayo.",
      "translations": {
        "en": "I'm busy doing this and that on the weekend.",
        "ko": "주말에는 이것저것 하느라 바빠요.",
        "ipa": "jumareneun igeosjeogeos haneura bappayo.",
        "ar": "أنا مشغول في عطلة نهاية الأسبوع بعمل هذا وذاك.",
        "cs": "O víkendu jsem zaneprázdněný tím a oním.",
        "da": "I weekenden har jeg travlt med det ene og det andet.",
        "de": "Am Wochenende bin ich mit dies und das beschäftigt.",
        "el": "Το Σαββατοκύριακο είμαι απασχολημένος με το ένα και το άλλο.",
        "es": "Los fines de semana estoy ocupado con unas cosas y otras.",
        "fi": "Olen viikonloppuisin kiireinen kaikenlaisten askareiden kanssa.",
        "fr": "Le week-end, je suis occupé à faire ceci et cela.",
        "he": "בסוף השבוע אני עסוק בזה ובזה.",
        "hi": "मैं वीकेंड पर यह-वह करते हुए व्यस्त रहता हूँ।",
        "hu": "Hétvégén ezzel-azzal vagyok elfoglalva.",
        "id": "Akhir pekan saya sibuk dengan ini dan itu.",
        "it": "Nel fine settimana sono occupato con questo e quello.",
        "ja": "週末はあれこれしていて忙しいです。",
        "nb": "I helgene er jeg opptatt med ditt og datt.",
        "nl": "In het weekend ben ik druk met dit en dat.",
        "pl": "W weekend jestem zajęty tym i owym.",
        "pt": "No fim de semana, estou ocupado com uma coisa e outra.",
        "ro": "În weekend sunt ocupat cu una și alta.",
        "ru": "На выходных я занят тем и этим.",
        "sv": "På helgerna är jag upptagen med ditt och datt.",
        "tr": "Hafta sonları şunu bunu yaparak meşgul oluyorum.",
        "uk": "На вихідних я зайнятий тим і тим.",
        "vi": "Cuối tuần tôi bận làm việc này việc kia.",
        "yue": "週末我忙住做呢樣嗰樣。",
        "zh-Hans": "周末我忙着做这做那。"
      },
