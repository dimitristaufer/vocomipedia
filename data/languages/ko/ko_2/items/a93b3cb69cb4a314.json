  "sentences": [
    {
      "target": "그는 부채를 갚으려고 아르바이트를 해요.",
      "reading": "geuneun buchae-reul gap-euryeogo areubaiteureul haeyo.",
      "translations": {
        "en": "He works part-time to pay off his debt.",
        "ko": "그는 부채를 갚으려고 아르바이트를 해요.",
        "ipa": "geuneun buchae-reul gap-euryeogo areubaiteureul haeyo.",
        "ar": "يعمل بدوام جزئي لسداد دينه.",
        "cs": "Pracuje na částečný úvazek, aby splatil dluh.",
        "da": "Han arbejder deltid for at betale sin gæld af.",
        "de": "Er arbeitet nebenbei, um seine Schulden abzuzahlen.",
        "el": "Δουλεύει μερικής απασχόλησης για να ξεπληρώσει το χρέος του.",
        "es": "Trabaja a tiempo parcial para pagar su deuda.",
        "fi": "Hän tekee osa-aikatyötä maksaakseen velkansa takaisin.",
        "fr": "Il travaille à temps partiel pour rembourser sa dette.",
        "he": "הוא עובד במשרה חלקית כדי להחזיר את החוב שלו.",
        "hi": "वह अपना कर्ज चुकाने के लिए पार्ट-टाइम काम करता है।",
        "hu": "Részmunkaidőben dolgozik, hogy visszafizesse az adósságát.",
        "id": "Dia bekerja paruh waktu untuk melunasi utangnya.",
        "it": "Lavora part-time per ripagare il suo debito.",
        "ja": "彼は借金を返すためにアルバイトをしています。",
        "nb": "Han jobber deltid for å betale ned gjelden sin.",
        "nl": "Hij werkt parttime om zijn schuld af te betalen.",
        "pl": "Pracuje na pół etatu, żeby spłacić swój dług.",
        "pt": "Ele trabalha meio período para pagar sua dívida.",
        "ro": "Lucrează cu jumătate de normă ca să-și plătească datoria.",
        "ru": "Он работает неполный день, чтобы выплатить свой долг.",
        "sv": "Han jobbar deltid för att betala av sin skuld.",
        "tr": "Borcunu ödemek için yarı zamanlı çalışıyor.",
        "uk": "Він працює неповний день, щоб виплатити свій борг.",
        "vi": "Anh ấy làm bán thời gian để trả nợ.",
        "yue": "佢做兼職嚟還債。",
        "zh-Hans": "他做兼职来还债。"
      },
