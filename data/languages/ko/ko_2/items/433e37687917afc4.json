    {
      "target": "저는 위층에 삽니다.",
      "reading": "Jeoneun wicheunge samnida.",
      "translations": {
        "en": "I live on the upper floor.",
        "ko": "저는 위층에 삽니다.",
        "ipa": "Jeoneun wicheunge samnida.",
        "ar": "أعيش في الطابق العلوي.",
        "cs": "Bydlím v horním patře.",
        "da": "Jeg bor på øverste etage.",
        "de": "Ich wohne im oberen Stockwerk.",
        "el": "Μένω στον πάνω όροφο.",
        "es": "Vivo en el piso de arriba.",
        "fi": "Asun yläkerrassa.",
        "fr": "J’habite à l’étage du dessus.",
        "he": "אני גר בקומה העליונה.",
        "hi": "मैं ऊपर की मंज़िल पर रहता हूँ।",
        "hu": "A felső emeleten lakom.",
        "id": "Saya tinggal di lantai atas.",
        "it": "Abito al piano di sopra.",
        "ja": "私は上の階に住んでいます。",
        "nb": "Jeg bor i etasjen over.",
        "nl": "Ik woon op de bovenste verdieping.",
        "pl": "Mieszkam na górnym piętrze.",
        "pt": "Moro no andar de cima.",
        "ro": "Locuiesc la etajul de sus.",
        "ru": "Я живу на верхнем этаже.",
        "sv": "Jag bor på övervåningen.",
        "tr": "Üst katta oturuyorum.",
        "uk": "Я живу на верхньому поверсі.",
        "vi": "Tôi sống ở tầng trên.",
