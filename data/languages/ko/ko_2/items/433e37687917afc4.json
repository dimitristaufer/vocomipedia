    {
      "target": "위층에서 아이들이 뛰고 있어요.",
      "reading": "Wicheungeseo aideuri ttwigo isseoyo.",
      "translations": {
        "en": "The kids are running around upstairs.",
        "ko": "위층에서 아이들이 뛰고 있어요.",
        "ipa": "Wicheungeseo aideuri ttwigo isseoyo.",
        "ar": "الأطفال يركضون في الطابق العلوي.",
        "cs": "Děti běhají nahoře.",
        "da": "Børnene løber rundt ovenpå.",
        "de": "Die Kinder rennen oben herum.",
        "el": "Τα παιδιά τρέχουν πάνω πάνω.",
        "es": "Los niños están corriendo arriba.",
        "fi": "Lapset juoksevat yläkerrassa.",
        "fr": "Les enfants courent à l’étage.",
