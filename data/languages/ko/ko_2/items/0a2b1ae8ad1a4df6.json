  "sentences": [
    {
      "target": "저는 대기업에 취직하고 싶어요.",
      "reading": "jeoneun daegieobe chwijikago sipeoyo.",
      "translations": {
        "en": "I want to get a job at a big company.",
        "ko": "저는 대기업에 취직하고 싶어요.",
        "ipa": "jeoneun daegieobe chwijikago sipeoyo.",
        "ar": "أريد أن أحصل على وظيفة في شركة كبيرة.",
        "cs": "Chci získat práci ve velké firmě.",
        "da": "Jeg vil gerne have et job i en stor virksomhed.",
        "de": "Ich möchte bei einem großen Unternehmen arbeiten.",
        "el": "Θέλω να βρω δουλειά σε μια μεγάλη εταιρεία.",
        "es": "Quiero conseguir trabajo en una gran empresa.",
        "fi": "Haluan saada töitä isosta yrityksestä.",
        "fr": "Je veux décrocher un emploi dans une grande entreprise.",
        "he": "אני רוצה להתקבל לעבודה בחברה גדולה.",
        "hi": "मैं एक बड़ी कंपनी में नौकरी करना चाहता हूँ।",
        "hu": "Egy nagy cégnél szeretnék elhelyezkedni.",
        "id": "Saya ingin bekerja di perusahaan besar.",
        "it": "Voglio trovare lavoro in una grande azienda.",
        "ja": "私は大企業に就職したいです。",
        "nb": "Jeg vil ha jobb i et stort selskap.",
        "nl": "Ik wil graag een baan bij een groot bedrijf.",
        "pl": "Chcę dostać pracę w dużej firmie.",
        "pt": "Quero conseguir um emprego em uma grande empresa.",
        "ro": "Vreau să mă angajez la o companie mare.",
        "ru": "Я хочу устроиться в большую компанию.",
        "sv": "Jag vill få jobb på ett stort företag.",
        "tr": "Büyük bir şirkette işe girmek istiyorum.",
        "uk": "Я хочу влаштуватися на роботу у велику компанію.",
        "vi": "Tôi muốn xin việc ở một công ty lớn.",
        "yue": "我想喺大企業搵份工。",
        "zh-Hans": "我想进一家大企业工作。"
