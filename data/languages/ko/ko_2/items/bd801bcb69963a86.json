    "ar": [
      "تسرب الماء من السقف لأن المطر نزل.",
      "السقف الجديد يلمع.",
      "صعدت القطة إلى السطح.",
      "سقف ذلك البيت أحمر."
    ],
    "cs": [
      "Pršelo a ze střechy tekla voda.",
      "Nová střecha se leskne.",
      "Kočka vylezla na střechu.",
      "Ta střecha domu je červená."
    ],
    "da": [
      "Det regnede, og der sivede vand fra taget.",
      "Det nye tag skinner.",
      "Katten gik op på taget.",
      "Taget på det hus er rødt."
    ],
    "de": [
      "Es hat geregnet, und Wasser sickerte vom Dach.",
      "Das neue Dach glänzt.",
      "Die Katze ist auf das Dach gegangen.",
      "Das Haus dort hat ein rotes Dach."
    ],
    "el": [
      "Έβρεξε και έσταζε νερό από τη στέγη.",
      "Η καινούρια στέγη γυαλίζει.",
      "Η γάτα ανέβηκε στη στέγη.",
      "Η στέγη εκείνου του σπιτιού είναι κόκκινη."
    ],
    "es": [
      "Llovió y se filtró agua del techo.",
      "El techo nuevo brilla.",
      "El gato subió al techo.",
      "El techo de esa casa es rojo."
    ],
    "fi": [
      "Satoi, ja vettä vuoti katosta.",
      "Uusi katto kiiltää.",
      "Kissa nousi katolle.",
      "Tuon talon katto on punainen."
    ],
    "fr": [
      "Il a plu, et de l'eau a coulé du toit.",
      "Le nouveau toit brille.",
      "Le chat est monté sur le toit.",
      "Le toit de cette maison est rouge."
    ],
    "he": [
      "ירד גשם, ומים דלפו מהגג.",
      "הגג החדש נוצץ.",
      "החתול עלה על הגג.",
      "הגג של הבית הזה אדום."
    ],
    "hi": [
      "बारिश हुई, और छत से पानी टपका।",
      "नई छत चमक रही है।",
      "बिल्ली छत पर चढ़ गई।",
      "वह घर की छत लाल है।"
    ],
    "hu": [
      "Esett az eső, és a tetőből szivárgott a víz.",
      "Az új tető csillog.",
      "A macska felment a tetőre.",
      "Az a ház teteje piros."
    ],
    "id": [
      "Hujan turun, dan air merembes dari atap.",
      "Atap baru itu berkilau.",
      "Kucing itu naik ke atap.",
      "Atap rumah itu merah."
    ],
    "it": [
      "Ha piovuto e l'acqua è filtrata dal tetto.",
      "Il tetto nuovo brilla.",
      "Il gatto è salito sul tetto.",
      "Il tetto di quella casa è rosso."
    ],
    "ja": [
      "雨が降って、屋根から水が漏れました。",
      "新しい屋根が光っています。",
      "猫が屋根の上に上がりました。",
      "あそこの家の屋根は赤いですね。"
    ],
    "nb": [
      "Det regnet, og det lekket vann fra taket.",
      "Det nye taket skinner.",
      "Katten gikk opp på taket.",
      "Taket på det huset er rødt."
    ],
    "nl": [
      "Het regende, en er lekte water van het dak.",
      "Het nieuwe dak glanst.",
      "De kat ging op het dak.",
      "Het dak van dat huis is rood."
    ],
    "pl": [
      "Padało i woda przeciekała z dachu.",
      "Nowy dach błyszczy.",
      "Kot wszedł na dach.",
      "Dach tego domu jest czerwony."
    ],
    "pt": [
      "Choveu, e a água vazou do telhado.",
      "O telhado novo brilha.",
      "O gato subiu no telhado.",
      "O telhado daquela casa é vermelho."
    ],
    "ro": [
      "A plouat și a picurat apă din acoperiș.",
      "Noul acoperiș strălucește.",
      "Pisica a urcat pe acoperiș.",
      "Acoperișul casei aceleia este roșu."
    ],
    "ru": [
      "Шёл дождь, и с крыши протекала вода.",
      "Новая крыша блестит.",
      "Кошка забралась на крышу.",
      "У того дома красная крыша."
    ],
    "sv": [
      "Det regnade, och det läckte vatten från taket.",
      "Det nya taket glänser.",
      "Katten gick upp på taket.",
      "Taket på det där huset är rött."
    ],
    "tr": [
      "Yağmur yağdı ve çatıdan su sızdı.",
      "Yeni çatı parlıyor.",
      "Kedi çatıya çıktı.",
      "Şu evin çatısı kırmızı."
    ],
    "uk": [
      "Йшов дощ, і з даху протікала вода.",
      "Новий дах блищить.",
      "Кіт заліз на дах.",
      "У того будинку червоний дах."
    ],
    "vi": [
      "Trời mưa, và nước bị rò từ mái nhà xuống.",
      "Mái nhà mới đang sáng lấp lánh.",
      "Con mèo đã trèo lên mái nhà.",
      "Mái nhà của ngôi nhà kia màu đỏ."
    ],
    "yue": [
      "落咗雨，天花漏水。",
      "新屋頂閃閃發光。",
      "隻貓上咗屋頂。",
      "嗰間屋嘅屋頂係紅色。"
    ],
    "zh-Hans": [
      "下雨了，屋顶漏水了。",
      "新屋顶闪闪发亮。",
      "猫爬到屋顶上了。",
      "那座房子的屋顶是红色的。"
