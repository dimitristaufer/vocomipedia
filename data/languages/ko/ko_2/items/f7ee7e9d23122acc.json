  "sentences": [
    {
      "target": "저는 흑백 사진이 더 좋아요.",
      "reading": "jeoneun heukbaek sajini deo joahaeyo.",
      "translations": {
        "en": "I like black-and-white photos more.",
        "ko": "저는 흑백 사진이 더 좋아요.",
        "ipa": "jeoneun heukbaek sajini deo joahaeyo.",
        "ar": "أفضل الصور بالأبيض والأسود.",
        "cs": "Mám raději černobílé fotky.",
        "da": "Jeg kan bedre lide sort-hvide fotos.",
        "de": "Ich mag Schwarz-Weiß-Fotos lieber.",
        "el": "Μου αρέσουν περισσότερο οι ασπρόμαυρες φωτογραφίες.",
        "es": "Me gustan más las fotos en blanco y negro.",
        "fi": "Pidän enemmän mustavalkoisista valokuvista.",
        "fr": "Je préfère les photos en noir et blanc.",
        "he": "אני אוהב יותר תמונות בשחור-לבן.",
        "hi": "मुझे काले-सफेद फ़ोटो ज़्यादा पसंद हैं।",
        "hu": "Jobban szeretem a fekete-fehér fotókat.",
        "id": "Saya lebih suka foto hitam putih.",
        "it": "Mi piacciono di più le foto in bianco e nero.",
        "ja": "私は白黒写真のほうが好きです。",
        "nb": "Jeg liker svart-hvitt-bilder bedre.",
        "nl": "Ik hou meer van zwart-witfoto's.",
        "pl": "Bardziej lubię czarno-białe zdjęcia.",
        "pt": "Eu gosto mais de fotos em preto e branco.",
        "ro": "Îmi plac mai mult fotografiile alb-negru.",
        "ru": "Мне больше нравятся чёрно-белые фотографии.",
        "sv": "Jag gillar svartvita foton bättre.",
        "tr": "Ben siyah beyaz fotoğrafları daha çok severim.",
        "uk": "Мені більше подобаються чорно-білі фотографії.",
        "vi": "Tôi thích ảnh đen trắng hơn.",
        "yue": "我比較鍾意黑白相。",
        "zh-Hans": "我更喜欢黑白照片。"
