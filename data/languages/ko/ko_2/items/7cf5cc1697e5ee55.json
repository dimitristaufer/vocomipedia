  "sentences": [
    {
      "target": "요즘 정신적 피로가 심해요.",
      "reading": "yojeum jeongsinjeok piroga simhaeyo.",
      "translations": {
        "en": "I’ve been feeling a lot of mental fatigue lately.",
        "ko": "요즘 정신적 피로가 심해요.",
        "ipa": "yojeum jeongsinjeok piroga simhaeyo.",
        "ar": "أشعر بتعب ذهني شديد هذه الأيام.",
        "cs": "V poslední době mám velkou psychickou únavu.",
        "da": "Jeg har haft meget mental træthed på det sidste.",
        "de": "Ich bin in letzter Zeit stark mental erschöpft.",
        "el": "Τον τελευταίο καιρό νιώθω πολύ πνευματική κούραση.",
        "es": "Últimamente tengo mucho cansancio mental.",
        "fi": "Minulla on ollut viime aikoina paljon henkistä väsymystä.",
        "fr": "J’ai eu beaucoup de fatigue mentale ces derniers temps.",
        "he": "לאחרונה יש לי עייפות נפשית רבה.",
        "hi": "इन दिनों मुझे बहुत मानसिक थकान हो रही है।",
        "hu": "Mostanában nagyon fáradt vagyok mentálisan.",
        "id": "Belakangan ini saya merasa sangat lelah mental.",
        "it": "Ultimamente ho molta stanchezza mentale.",
        "ja": "最近、精神的な疲れがひどいです。",
        "nb": "I det siste har jeg vært veldig mentalt sliten.",
        "nl": "Ik ben de laatste tijd erg mentaal vermoeid.",
        "pl": "Ostatnio jestem bardzo psychicznie zmęczony.",
        "pt": "Tenho tido muito cansaço mental ultimamente.",
        "ro": "În ultima vreme am multă oboseală psihică.",
        "ru": "В последнее время я сильно устаю морально.",
        "sv": "Jag har känt mig väldigt mentalt trött på sistone.",
        "tr": "Son zamanlarda çok zihinsel yorgunluk hissediyorum.",
        "uk": "Останнім часом я дуже втомлююся морально.",
        "vi": "Dạo này tôi rất mệt mỏi về tinh thần.",
        "yue": "呢排我精神好攰。",
        "zh-Hans": "最近我精神很疲惫。"
      },
