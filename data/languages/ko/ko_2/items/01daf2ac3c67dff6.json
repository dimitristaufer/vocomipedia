  "sentences": [
    {
      "target": "응원하며 우리 팀 이름을 외쳤어요.",
      "reading": "Eungwonhamyeo uri tim ireumeul oechyeosseoyo.",
      "translations": {
        "en": "We cheered and shouted our team’s name.",
        "ko": "응원하며 우리 팀 이름을 외쳤어요.",
        "ipa": "Eungwonhamyeo uri tim ireumeul oechyeosseoyo.",
        "ar": "هتفنا باسم فريقنا بحماس.",
        "cs": "Jásali jsme a volali jméno našeho týmu.",
        "da": "Vi heppede og råbte vores holds navn.",
        "de": "Wir feuerten an und riefen den Namen unseres Teams.",
        "el": "Ενθαρρύναμε την ομάδα μας και φωνάξαμε το όνομά της.",
        "es": "Animamos y gritamos el nombre de nuestro equipo.",
        "fi": "Kannustimme ja huusimme joukkueemme nimen.",
        "fr": "Nous avons encouragé notre équipe et crié son nom.",
        "he": "עודדנו וצעקנו את שם הקבוצה שלנו.",
        "hi": "हमने उत्साह बढ़ाया और अपनी टीम का नाम चिल्लाया।",
        "hu": "Biztattuk a csapatunkat, és kiáltottuk a nevét.",
        "id": "Kami memberi semangat dan meneriakkan nama tim kami.",
        "it": "Abbiamo tifato e gridato il nome della nostra squadra.",
        "ja": "私たちは応援しながら、チームの名前を叫びました。",
        "nb": "Vi heiet og ropte navnet på laget vårt.",
        "nl": "We juichten en riepen de naam van ons team.",
        "pl": "Dopingowaliśmy i krzyczeliśmy nazwę naszej drużyny.",
        "pt": "Nós torcemos e gritamos o nome do nosso time.",
        "ro": "Am făcut galerie și am strigat numele echipei noastre.",
        "ru": "Мы болели и кричали название нашей команды.",
        "sv": "Vi hejade och ropade vårt lags namn.",
        "tr": "Takımımızı destekledik ve adını bağırdık.",
        "uk": "Ми вболівали й вигукували назву нашої команди.",
        "vi": "Chúng tôi cổ vũ và hô tên đội mình.",
        "yue": "我哋一邊打氣，一邊大叫我哋球隊嘅名。",
        "zh-Hans": "我们一边加油，一边喊出我们队的名字。"
      },
