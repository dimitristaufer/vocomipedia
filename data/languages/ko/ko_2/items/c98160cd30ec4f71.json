    {
      "target": "잠들기 전에 현관문을 잠갔어요.",
      "reading": "jam-deul-gi jeon-e hyeong-gwan-mun-eul jam-ga-sseo-yo.",
      "translations": {
        "en": "I locked the front door before going to sleep.",
        "ko": "잠들기 전에 현관문을 잠갔어요.",
        "ipa": "jam-deul-gi jeon-e hyeong-gwan-mun-eul jam-ga-sseo-yo.",
        "ar": "أغلقت الباب الأمامي قبل أن أنام.",
        "cs": "Před spaním jsem zamkl vchodové dveře.",
        "da": "Jeg låste hoveddøren, før jeg gik i seng.",
        "de": "Ich habe die Haustür vor dem Schlafengehen abgeschlossen.",
        "el": "Κλείδωσα την εξώπορτα πριν κοιμηθώ.",
        "es": "Cerré con llave la puerta de la entrada antes de dormir.",
        "fi": "Lukitsin etuoven ennen nukkumaanmenoa.",
        "fr": "J'ai fermé à clé la porte d'entrée avant de dormir.",
        "he": "נעלתי את דלת הכניסה לפני שהלכתי לישון.",
        "hi": "सोने से पहले मैंने मुख्य दरवाज़ा बंद किया।",
        "hu": "Elalvás előtt bezártam a bejárati ajtót.",
        "id": "Saya mengunci pintu depan sebelum tidur.",
        "it": "Ho chiuso a chiave la porta di casa prima di dormire.",
        "ja": "寝る前に玄関のドアに鍵をかけました。",
        "nb": "Jeg låste inngangsdøren før jeg la meg.",
        "nl": "Ik deed de voordeur op slot voordat ik ging slapen.",
        "pl": "Przed snem zamknąłem(-am) drzwi wejściowe na klucz.",
        "pt": "Tranquei a porta da frente antes de dormir.",
        "ro": "Am încuiat ușa de la intrare înainte să adorm.",
        "ru": "Перед сном я запер(ла) входную дверь.",
        "sv": "Jag låste ytterdörren innan jag gick och lade mig.",
        "tr": "Uyumadan önce ön kapıyı kilitledim.",
        "uk": "Перед сном я замкнув(ла) вхідні двері.",
        "vi": "Tôi đã khóa cửa chính trước khi đi ngủ.",
        "yue": "瞓覺之前我鎖咗大門。",
        "zh-Hans": "睡觉前我锁了前门。"
      },
