  "sentences": [
    {
      "target": "아침에 현관문을 열었어요.",
      "reading": "a-chim-e hyeong-gwan-mun-eul yeol-eo-sseo-yo.",
      "translations": {
        "en": "I opened the front door in the morning.",
        "ko": "아침에 현관문을 열었어요.",
        "ipa": "a-chim-e hyeong-gwan-mun-eul yeol-eo-sseo-yo.",
        "ar": "فتحت الباب الأمامي في الصباح.",
        "cs": "Ráno jsem otevřel vchodové dveře.",
        "da": "Jeg åbnede hoveddøren om morgenen.",
        "de": "Ich habe morgens die Haustür geöffnet.",
        "el": "Άνοιξα την εξώπορτα το πρωί.",
        "es": "Abrí la puerta de la entrada por la mañana.",
        "fi": "Avasin etuoven aamulla.",
        "fr": "J'ai ouvert la porte d'entrée le matin.",
        "he": "פתחתי את דלת הכניסה בבוקר.",
        "hi": "मैंने सुबह मुख्य दरवाज़ा खोला।",
        "hu": "Reggel kinyitottam a bejárati ajtót.",
        "id": "Saya membuka pintu depan di pagi hari.",
        "it": "Ho aperto la porta di casa la mattina.",
        "ja": "朝に玄関のドアを開けました。",
        "nb": "Jeg åpnet inngangsdøren om morgenen.",
        "nl": "Ik deed de voordeur 's ochtends open.",
        "pl": "Otworzyłem(-am) drzwi wejściowe rano.",
        "pt": "Abri a porta da frente de manhã.",
        "ro": "Am deschis ușa de la intrare dimineața.",
        "ru": "Утром я открыл(а) входную дверь.",
        "sv": "Jag öppnade ytterdörren på morgonen.",
        "tr": "Sabah ön kapıyı açtım.",
        "uk": "Вранці я відчинив(ла) вхідні двері.",
        "vi": "Tôi đã mở cửa chính vào buổi sáng.",
        "yue": "朝早我打開咗大門。",
        "zh-Hans": "我早上打开了前门。"
      },
