  "sentences": [
    {
      "target": "아버지가 어제 입원했어요.",
      "reading": "abeojiga eoje ibwonhaesseoyo.",
      "translations": {
        "en": "My father was hospitalized yesterday.",
        "ko": "아버지가 어제 입원했어요.",
        "ipa": "abeojiga eoje ibwonhaesseoyo.",
        "ar": "تم إدخال والدي إلى المستشفى أمس.",
        "cs": "Můj otec byl včera hospitalizován.",
        "da": "Min far blev indlagt i går.",
        "de": "Mein Vater wurde gestern ins Krankenhaus eingeliefert.",
        "el": "Ο πατέρας μου νοσηλεύτηκε χθες.",
        "es": "A mi padre lo hospitalizaron ayer.",
        "fi": "Isäni joutui sairaalaan eilen.",
        "fr": "Mon père a été hospitalisé hier.",
        "he": "אבא שלי אושפז אתמול.",
        "hi": "मेरे पिता को कल अस्पताल में भर्ती किया गया था।",
        "hu": "Az apámat tegnap kórházba vitték.",
        "id": "Ayah saya dirawat di rumah sakit kemarin.",
        "it": "Mio padre è stato ricoverato ieri.",
        "ja": "父は昨日入院しました。",
        "nb": "Faren min ble innlagt i går.",
        "nl": "Mijn vader is gisteren opgenomen in het ziekenhuis.",
        "pl": "Mój ojciec został wczoraj przyjęty do szpitala.",
        "pt": "Meu pai foi internado ontem.",
        "ro": "Tatăl meu a fost internat ieri.",
        "ru": "Моего отца вчера положили в больницу.",
        "sv": "Min pappa blev inlagd i går.",
        "tr": "Babam dün hastaneye yatırıldı.",
        "uk": "Мого батька вчора госпіталізували.",
        "vi": "Bố tôi đã nhập viện hôm qua.",
        "yue": "我爸爸噚日入咗院。",
        "zh-Hans": "我父亲昨天住院了。"
      },
