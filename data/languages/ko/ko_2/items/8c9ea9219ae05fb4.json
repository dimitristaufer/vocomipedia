  "sentences": [
    {
      "target": "그 만남은 필연적이었어요.",
      "reading": "geu mannameun piryeonjeogieosseoyo.",
      "translations": {
        "en": "That meeting was inevitable.",
        "ko": "그 만남은 필연적이었어요.",
        "ipa": "geu mannameun piryeonjeogieosseoyo.",
        "ar": "كان ذلك اللقاء حتميًا.",
        "cs": "To setkání bylo nevyhnutelné.",
        "da": "Det møde var uundgåeligt.",
        "de": "Dieses Treffen war unvermeidlich.",
        "el": "Αυτή η συνάντηση ήταν αναπόφευκτη.",
        "es": "Ese encuentro fue inevitable.",
        "fi": "Tuo tapaaminen oli väistämätön.",
        "fr": "Cette rencontre était inévitable.",
        "he": "המפגש הזה היה בלתי נמנע.",
        "hi": "वह मुलाकात अनिवार्य थी।",
        "hu": "Az a találkozás elkerülhetetlen volt.",
        "id": "Pertemuan itu tak terelakkan.",
        "it": "Quell'incontro era inevitabile.",
        "ja": "その出会いは必然でした。",
        "nb": "Det møtet var uunngåelig.",
        "nl": "Die ontmoeting was onvermijdelijk.",
        "pl": "To spotkanie było nieuniknione.",
        "pt": "Esse encontro foi inevitável.",
        "ro": "Întâlnirea aceea a fost inevitabilă.",
        "ru": "Та встреча была неизбежной.",
        "sv": "Det mötet var oundvikligt.",
        "tr": "O karşılaşma kaçınılmazdı.",
        "uk": "Та зустріч була неминучою.",
        "vi": "Cuộc gặp đó là không thể tránh khỏi.",
        "yue": "嗰次見面係必然嘅。",
        "zh-Hans": "那次见面是必然的。"
      },
