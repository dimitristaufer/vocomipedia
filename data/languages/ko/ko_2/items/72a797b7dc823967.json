  "sentences": [
    {
      "target": "선생님은 교실에서 권위를 지켰어요.",
      "reading": "seonsaengnimeun gyosileseo gwonwireul jikyeosseoyo.",
      "translations": {
        "en": "The teacher maintained authority in the classroom.",
        "ko": "선생님은 교실에서 권위를 지켰어요.",
        "ipa": "seonsaengnimeun gyosileseo gwonwireul jikyeosseoyo.",
        "ar": "حافظ المعلم على هيبته في الفصل.",
        "cs": "Učitel si ve třídě zachoval autoritu.",
        "da": "Læreren bevarede sin autoritet i klassen.",
        "de": "Der Lehrer behielt im Klassenzimmer seine Autorität.",
        "el": "Ο δάσκαλος διατήρησε το κύρος του στην τάξη.",
        "es": "El profesor mantuvo su autoridad en el aula.",
        "fi": "Opettaja säilytti auktoriteettinsa luokassa.",
        "fr": "Le professeur a gardé son autorité dans la classe.",
        "he": "המורה שמר על סמכותו בכיתה.",
        "hi": "शिक्षक ने कक्षा में अपना अधिकार बनाए रखा।",
        "hu": "A tanár megőrizte a tekintélyét az osztályban.",
        "id": "Guru itu mempertahankan wibawanya di kelas.",
        "it": "L'insegnante ha mantenuto la sua autorità in classe.",
        "ja": "先生は教室で威厳を保っていました。",
        "nb": "Læreren beholdt autoriteten i klasserommet.",
        "nl": "De leraar behield gezag in de klas.",
        "pl": "Nauczyciel zachował autorytet w klasie.",
        "pt": "O professor manteve sua autoridade na sala de aula.",
        "ro": "Profesorul și-a păstrat autoritatea în clasă.",
        "ru": "Учитель сохранял авторитет в классе.",
        "sv": "Läraren behöll sin auktoritet i klassrummet.",
        "tr": "Öğretmen sınıfta otoritesini korudu.",
        "uk": "Учитель зберігав авторитет у класі.",
        "vi": "Thầy giáo giữ uy tín trong lớp học.",
        "yue": "老師喺課室入面保持住權威。",
        "zh-Hans": "老师在教室里保持了权威。"
      },
