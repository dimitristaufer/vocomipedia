    {
      "target": "다음 달에 월급을 받을 거예요.",
      "reading": "daeum dare wolgeubeul badeul geoyeyo.",
      "translations": {
        "en": "I’ll get paid next month.",
        "ko": "다음 달에 월급을 받을 거예요.",
        "ipa": "daeum dare wolgeubeul badeul geoyeyo.",
        "ar": "سأستلم راتبي الشهر القادم.",
        "cs": "Příští měsíc dostanu výplatu.",
        "da": "Jeg får min løn næste måned.",
        "de": "Ich bekomme nächsten Monat mein Gehalt.",
        "el": "Θα πάρω τον μισθό μου τον επόμενο μήνα.",
        "es": "Cobraré el sueldo el mes que viene.",
        "fi": "Saan palkkani ensi kuussa.",
        "fr": "Je recevrai mon salaire le mois prochain.",
        "he": "אקבל את המשכורת שלי בחודש הבא.",
        "hi": "मुझे अगले महीने तनख्वाह मिलेगी।",
        "hu": "Jövő hónapban kapom meg a fizetésemet.",
        "id": "Saya akan menerima gaji bulan depan.",
        "it": "Riceverò lo stipendio il mese prossimo.",
        "ja": "来月、給料をもらいます。",
        "nb": "Jeg får lønn neste måned.",
        "nl": "Ik krijg volgende maand mijn salaris.",
        "pl": "Dostanę wypłatę w przyszłym miesiącu.",
        "pt": "Vou receber meu salário no mês que vem.",
        "ro": "O să primesc salariul luna viitoare.",
        "ru": "Я получу зарплату в следующем месяце.",
        "sv": "Jag får min lön nästa månad.",
        "tr": "Gelecek ay maaşımı alacağım.",
        "uk": "Я отримаю зарплату наступного місяця.",
        "vi": "Tôi sẽ nhận lương vào tháng sau.",
        "yue": "我下個月會出糧。",
        "zh-Hans": "我下个月会领工资。"
      },
