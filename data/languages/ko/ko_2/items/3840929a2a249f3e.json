  "sentences": [
    {
      "target": "저는 월급을 받으면 먼저 저축해요.",
      "reading": "jeoneun wolgeubeul badeumyeon meonjeo jeochukhaeyo.",
      "translations": {
        "en": "When I get my salary, I save first.",
        "ko": "저는 월급을 받으면 먼저 저축해요.",
        "ipa": "jeoneun wolgeubeul badeumyeon meonjeo jeochukhaeyo.",
        "ar": "عندما أستلم راتبي، أوفر أولًا.",
        "cs": "Když dostanu výplatu, nejdřív šetřím.",
        "da": "Når jeg får min løn, sparer jeg først op.",
        "de": "Wenn ich mein Gehalt bekomme, spare ich zuerst.",
        "el": "Όταν παίρνω τον μισθό μου, αποταμιεύω πρώτα.",
        "es": "Cuando cobro mi sueldo, primero ahorro.",
        "fi": "Kun saan palkkani, säästän ensin.",
        "fr": "Quand je reçois mon salaire, j’épargne d’abord.",
        "he": "כשאני מקבל את המשכורת שלי, אני חוסך קודם.",
        "hi": "जब मुझे तनख्वाह मिलती है, तो मैं पहले बचत करता हूँ।",
        "hu": "Amikor megkapom a fizetésemet, először félreteszek.",
        "id": "Kalau saya menerima gaji, saya menabung dulu.",
        "it": "Quando ricevo lo stipendio, prima risparmio.",
        "ja": "給料をもらったら、まず貯金します。",
        "nb": "Når jeg får lønn, sparer jeg først.",
        "nl": "Als ik mijn salaris krijg, spaar ik eerst.",
        "pl": "Kiedy dostaję wypłatę, najpierw oszczędzam.",
        "pt": "Quando recebo meu salário, economizo primeiro.",
        "ro": "Când primesc salariul, mai întâi economisesc.",
        "ru": "Когда я получаю зарплату, я сначала откладываю.",
        "sv": "När jag får min lön sparar jag först.",
        "tr": "Maaşımı alınca önce biriktiririm.",
        "uk": "Коли я отримую зарплату, я спочатку відкладаю.",
        "vi": "Khi tôi nhận lương, tôi tiết kiệm trước.",
        "yue": "我出糧之後，會先儲錢。",
        "zh-Hans": "我发工资后，先存钱。"
      },
