  "sentences": [
    {
      "target": "아침에 잃어버린 지갑을 되찾았어요.",
      "reading": "achime ireobeorin jigabeul doechajasseoyo.",
      "translations": {
        "en": "I got back the wallet I lost this morning.",
        "ko": "아침에 잃어버린 지갑을 되찾았어요.",
        "ipa": "achime ireobeorin jigabeul doechajasseoyo.",
        "ar": "استعدتُ المحفظة التي فقدتها هذا الصباح.",
        "cs": "Dostal jsem zpátky peněženku, kterou jsem ráno ztratil.",
        "da": "Jeg fik min pung tilbage, som jeg mistede i morges.",
        "de": "Ich habe die Brieftasche zurückbekommen, die ich heute Morgen verloren habe.",
        "el": "Πήρα πίσω το πορτοφόλι που έχασα το πρωί.",
        "es": "Recuperé la cartera que perdí esta mañana.",
        "fi": "Sain takaisin aamulla kadottamani lompakon.",
        "fr": "J’ai récupéré le portefeuille que j’ai perdu ce matin.",
        "he": "קיבלתי בחזרה את הארנק שאיבדתי הבוקר.",
        "hi": "मुझे आज सुबह खोया हुआ मेरा बटुआ वापस मिल गया।",
        "hu": "Visszakaptam a reggel elvesztett pénztárcámat.",
        "id": "Saya mendapatkan kembali dompet yang hilang pagi ini.",
        "it": "Ho ritrovato il portafoglio che avevo perso stamattina.",
        "ja": "今朝なくした財布を取り戻しました。",
        "nb": "Jeg fikk tilbake lommeboka jeg mistet i morges.",
        "nl": "Ik heb mijn portemonnee teruggekregen die ik vanmorgen kwijt was.",
        "pl": "Odzyskałem portfel, który zgubiłem dziś rano.",
        "pt": "Recuperei a carteira que perdi esta manhã.",
        "ro": "Mi-am recuperat portofelul pe care l-am pierdut azi dimineață.",
        "ru": "Я получил обратно кошелёк, который потерял сегодня утром.",
        "sv": "Jag fick tillbaka plånboken som jag tappade i morse.",
        "tr": "Bu sabah kaybettiğim cüzdanı geri aldım.",
        "uk": "Я отримав назад гаманець, який загубив сьогодні вранці.",
        "vi": "Tôi đã lấy lại được cái ví bị mất sáng nay.",
        "yue": "我攞返咗今朝唔見咗嘅銀包。",
        "zh-Hans": "我找回了今天早上丢失的钱包。"
      },
