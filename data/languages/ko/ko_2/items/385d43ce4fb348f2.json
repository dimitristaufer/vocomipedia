    {
      "target": "음식물은 냉장고에 넣어 두세요.",
      "reading": "eumsikmureun naengjanggoe neoeo dueseyo.",
      "translations": {
        "en": "Please put the food in the fridge.",
        "ko": "음식물은 냉장고에 넣어 두세요.",
        "ipa": "eumsikmureun naengjanggoe neoeo dueseyo.",
        "ar": "ضع الطعام في الثلاجة من فضلك.",
        "cs": "Dejte prosím jídlo do lednice.",
        "da": "Læg maden i køleskabet.",
        "de": "Bitte legen Sie das Essen in den Kühlschrank.",
        "el": "Βάλτε το φαγητό στο ψυγείο, παρακαλώ.",
        "es": "Por favor, guarda la comida en la nevera.",
        "fi": "Laita ruoka jääkaappiin.",
        "fr": "Mettez la nourriture dans le réfrigérateur, s'il vous plaît.",
        "he": "שימו את האוכל במקרר, בבקשה.",
        "hi": "कृपया खाना फ्रिज में रख दें।",
        "hu": "Tegye az ételt a hűtőbe, kérem.",
        "id": "Tolong simpan makanan di kulkas.",
        "it": "Metta il cibo in frigorifero, per favore.",
        "ja": "食べ物は冷蔵庫に入れておいてください。",
        "nb": "Legg maten i kjøleskapet.",
        "nl": "Zet het eten in de koelkast.",
        "pl": "Włóż proszę jedzenie do lodówki.",
        "pt": "Coloque a comida na geladeira, por favor.",
        "ro": "Puneți mâncarea în frigider, vă rog.",
        "ru": "Положите еду в холодильник, пожалуйста.",
        "sv": "Lägg maten i kylskåpet.",
        "tr": "Lütfen yiyecekleri buzdolabına koyun.",
        "uk": "Покладіть їжу в холодильник, будь ласка.",
        "vi": "Làm ơn để thức ăn vào tủ lạnh.",
        "yue": "請將食物放喺雪櫃入面。",
        "zh-Hans": "请把食物放进冰箱。"
      },
