  "sentences": [
    {
      "target": "그전에는 매일 아침 산책했어요.",
      "reading": "geu-jeon-eneun maeil achim sanchaekhaesseoyo.",
      "translations": {
        "en": "Before that, I walked every morning.",
        "ko": "그전에는 매일 아침 산책했어요.",
        "ipa": "geu-jeon-eneun maeil achim sanchaekhaesseoyo.",
        "ar": "كنت أمشي كل صباح من قبل.",
        "cs": "Předtím jsem chodila každé ráno na procházku.",
        "da": "Før gik jeg en tur hver morgen.",
        "de": "Früher bin ich jeden Morgen spazieren gegangen.",
        "el": "Παλιά πήγαινα κάθε πρωί για περπάτημα.",
        "es": "Antes salía a caminar todas las mañanas.",
        "fi": "Kävin ennen kävelyllä joka aamu.",
        "fr": "Avant, je me promenais tous les matins.",
        "he": "פעם הייתי יוצאת להליכה כל בוקר.",
        "hi": "पहले मैं हर सुबह टहलती थी।",
        "hu": "Régen minden reggel sétáltam.",
        "id": "Dulu saya berjalan-jalan setiap pagi.",
        "it": "Prima facevo una passeggiata ogni mattina.",
        "ja": "その前は毎朝散歩していました。",
        "nb": "Før gikk jeg en tur hver morgen.",
        "nl": "Vroeger wandelde ik elke ochtend.",
        "pl": "Kiedyś chodziłam na spacer każdego ranka.",
        "pt": "Antes, eu caminhava todas as manhãs.",
        "ro": "Înainte ieșeam la plimbare în fiecare dimineață.",
        "ru": "Раньше я каждый день ходила по утрам гулять.",
        "sv": "Förr gick jag en promenad varje morgon.",
        "tr": "Eskiden her sabah yürüyüşe çıkardım.",
        "uk": "Раніше я щоранку ходила на прогулянку.",
        "vi": "Trước đây tôi đi bộ mỗi sáng.",
        "yue": "以前我每日朝早都會散步。",
        "zh-Hans": "以前我每天早上都会散步。"
      },
