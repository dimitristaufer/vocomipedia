  "sentences": [
    {
      "target": "우리는 근처 여관에서 하룻밤 묵었어요.",
      "reading": "Urineun geuncheo yeogwaneseo harutbam mugeosseoyo.",
      "translations": {
        "en": "We stayed at a nearby inn for one night.",
        "ko": "우리는 근처 여관에서 하룻밤 묵었어요.",
        "ipa": "Urineun geuncheo yeogwaneseo harutbam mugeosseoyo.",
        "ar": "بقينا ليلة واحدة في نُزُل قريب.",
        "cs": "Zůstali jsme jednu noc v nedalekém hostinci.",
        "da": "Vi overnattede på et nærliggende kro for en nat.",
        "de": "Wir haben eine Nacht in einem nahegelegenen Gasthaus übernachtet.",
        "el": "Μείναμε ένα βράδυ σε ένα κοντινό πανδοχείο.",
        "es": "Nos quedamos una noche en una posada cercana.",
        "fi": "Majoituimme läheisessä majatalossa yhden yön.",
        "fr": "Nous avons passé une nuit dans une auberge voisine.",
        "he": "ישנו לילה אחד בפונדק קרוב.",
        "hi": "हमने पास के सराय में एक रात बिताई।",
        "hu": "Egy közeli fogadóban szálltunk meg egy éjszakára.",
        "id": "Kami menginap semalam di penginapan terdekat.",
        "it": "Abbiamo passato una notte in una locanda vicina.",
        "ja": "私たちは近くの旅館に一晩泊まりました。",
        "nb": "Vi overnattet på et nærliggende vertshus i én natt.",
        "nl": "We verbleven een nacht in een nabijgelegen herberg.",
        "pl": "Spędziliśmy jedną noc w pobliskim pensjonacie.",
        "pt": "Passamos uma noite em uma pousada perto dali.",
        "ro": "Am stat o noapte la un han din apropiere.",
        "ru": "Мы переночевали в ближайшем постоялом дворе.",
        "sv": "Vi övernattade på ett närliggande värdshus.",
        "tr": "Yakındaki bir handa bir gece kaldık.",
        "uk": "Ми переночували в найближчому заїжджому дворі.",
        "vi": "Chúng tôi đã nghỉ một đêm ở một quán trọ gần đó.",
        "yue": "我哋喺附近嘅旅館住咗一晚。",
        "zh-Hans": "我们在附近的旅馆住了一晚。"
      },
