    {
      "target": "형이 방을 넓혔어요.",
      "reading": "hyeongi bangeul neolphyeosseoyo.",
      "translations": {
        "en": "My brother widened the room.",
        "ko": "형이 방을 넓혔어요.",
        "ipa": "hyeongi bangeul neolphyeosseoyo.",
        "ar": "وسع أخي الغرفة.",
        "cs": "Bratr rozšířil pokoj.",
        "da": "Min bror gjorde værelset større.",
        "de": "Mein Bruder hat das Zimmer vergrößert.",
        "el": "Ο αδερφός μου μεγάλωσε το δωμάτιο.",
        "es": "Mi hermano agrandó la habitación.",
        "fi": "Veljeni suurensi huonetta.",
        "fr": "Mon frère a agrandi la chambre.",
        "he": "אחי הגדיל את החדר.",
        "hi": "मेरे भाई ने कमरा बड़ा कर दिया।",
        "hu": "A bátyám megnövelte a szobát.",
        "id": "Kakak laki-laki saya memperlebar kamar.",
        "it": "Mio fratello ha allargato la stanza.",
        "ja": "兄が部屋を広くしました。",
        "nb": "Broren min gjorde rommet større.",
        "nl": "Mijn broer heeft de kamer groter gemaakt.",
        "pl": "Mój brat powiększył pokój.",
        "pt": "Meu irmão aumentou o quarto.",
        "ro": "Fratele meu a mărit camera.",
        "ru": "Мой брат расширил комнату.",
        "sv": "Min bror gjorde rummet större.",
        "tr": "Ağabeyim odayı büyüttü.",
        "uk": "Мій брат розширив кімнату.",
        "vi": "Anh trai tôi đã nới rộng căn phòng.",
        "yue": "我哥哥將個房間擴闊咗。",
        "zh-Hans": "我哥哥把房间扩大了。"
