  "sentences": [
    {
      "target": "주말에 해안을 따라 산책했어요.",
      "reading": "jumare haeaneul ttara sanchaekhaesseoyo.",
      "translations": {
        "en": "I walked along the coast on the weekend.",
        "ko": "주말에 해안을 따라 산책했어요.",
        "ipa": "jumare haeaneul ttara sanchaekhaesseoyo.",
        "ar": "مشيت على طول الساحل في عطلة نهاية الأسبوع.",
        "cs": "O víkendu jsem se procházel podél pobřeží.",
        "da": "Jeg gik en tur langs kysten i weekenden.",
        "de": "Ich bin am Wochenende am Ufer entlang spaziert.",
        "el": "Περπάτησα κατά μήκος της ακτής το Σαββατοκύριακο.",
        "es": "Caminé por la costa el fin de semana.",
        "fi": "Kävelin rannikkoa pitkin viikonloppuna.",
        "fr": "Je me suis promené le long de la côte ce week-end.",
        "he": "טיילתי לאורך החוף בסוף השבוע.",
        "hi": "मैंने सप्ताहांत में तट के किनारे टहल लिया।",
        "hu": "A hétvégén a part mentén sétáltam.",
        "id": "Saya berjalan-jalan di sepanjang pantai pada akhir pekan.",
        "it": "Ho passeggiato lungo la costa nel fine settimana.",
        "ja": "週末に海岸沿いを散歩しました。",
        "nb": "Jeg gikk en tur langs kysten i helgen.",
        "nl": "Ik heb in het weekend langs de kust gewandeld.",
        "pl": "Spacerowałem wzdłuż wybrzeża w weekend.",
        "pt": "Eu caminhei ao longo da costa no fim de semana.",
        "ro": "Am mers pe jos de-a lungul țărmului în weekend.",
        "ru": "Я гулял вдоль побережья на выходных.",
        "sv": "Jag promenerade längs kusten i helgen.",
        "tr": "Hafta sonu kıyı boyunca yürüdüm.",
        "uk": "Я гуляв уздовж узбережжя на вихідних.",
        "vi": "Tôi đã đi dạo dọc bờ biển vào cuối tuần.",
        "yue": "我周末沿住海岸散步。",
        "zh-Hans": "我周末沿着海岸散步。"
      },
