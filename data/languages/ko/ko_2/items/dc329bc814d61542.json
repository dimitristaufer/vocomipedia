  "sentences": [
    {
      "target": "창문 앞에 제비 한 마리가 앉아 있어요.",
      "reading": "changmun ape jebi han mariga anja isseoyo.",
      "translations": {
        "en": "A swallow is sitting in front of the window.",
        "ko": "창문 앞에 제비 한 마리가 앉아 있어요.",
        "ipa": "changmun ape jebi han mariga anja isseoyo.",
        "ar": "تقف سنونوة أمام النافذة.",
        "cs": "Před oknem sedí jedna vlaštovka.",
        "da": "En svale sidder foran vinduet.",
        "de": "Vor dem Fenster sitzt eine Schwalbe.",
        "el": "Ένα χελιδόνι κάθεται μπροστά στο παράθυρο.",
        "es": "Hay una golondrina sentada delante de la ventana.",
        "fi": "Yksi pääsky istuu ikkunan edessä.",
        "fr": "Une hirondelle est posée devant la fenêtre.",
        "he": "סנונית אחת יושבת מול החלון.",
        "hi": "खिड़की के सामने एक अबाबील बैठी है।",
        "hu": "Egy fecske ül az ablak előtt.",
        "id": "Seekor burung layang-layang sedang bertengger di depan jendela.",
        "it": "Una rondine è seduta davanti alla finestra.",
        "ja": "窓の前にツバメが一羽止まっています。",
        "nb": "En svale sitter foran vinduet.",
        "nl": "Een zwaluw zit voor het raam.",
        "pl": "Jaskółka siedzi przed oknem.",
        "pt": "Uma andorinha está sentada em frente à janela.",
        "ro": "O rândunică stă în fața ferestrei.",
        "ru": "Перед окном сидит ласточка.",
        "sv": "En svala sitter framför fönstret.",
        "tr": "Pencerenin önünde bir kırlangıç oturuyor.",
        "uk": "Перед вікном сидить ластівка.",
        "vi": "Có một con chim én đang đậu trước cửa sổ.",
        "yue": "窗前有一隻燕子停咗喺度。",
        "zh-Hans": "窗前有一只燕子停着。"
      },
