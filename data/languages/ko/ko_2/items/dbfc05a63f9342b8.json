  "sentences": [
    {
      "target": "사과를 비닐봉지에 넣었어요.",
      "reading": "sagwareul binilbongjie neoeosseoyo.",
      "translations": {
        "en": "I put the apples in a plastic bag.",
        "ko": "사과를 비닐봉지에 넣었어요.",
        "ipa": "sagwareul binilbongjie neoeosseoyo.",
        "ar": "وضعتُ التفاح في كيس بلاستيكي.",
        "cs": "Dala jsem jablka do igelitové tašky.",
        "da": "Jeg lagde æblerne i en plastikpose.",
        "de": "Ich habe die Äpfel in eine Plastiktüte gelegt.",
        "el": "Έβαλα τα μήλα σε μια πλαστική σακούλα.",
        "es": "Puse las manzanas en una bolsa de plástico.",
        "fi": "Laitoin omenat muovipussiin.",
        "fr": "J'ai mis les pommes dans un sac en plastique.",
        "he": "שמתי את התפוחים בשקית ניילון.",
        "hi": "मैंने सेब प्लास्टिक की थैली में रखे।",
        "hu": "Beletettem az almákat egy műanyag zacskóba.",
        "id": "Saya memasukkan apel ke dalam kantong plastik.",
        "it": "Ho messo le mele in un sacchetto di plastica.",
        "ja": "りんごをビニール袋に入れました。",
        "nb": "Jeg la eplene i en plastpose.",
        "nl": "Ik deed de appels in een plastic zak.",
        "pl": "Włożyłem jabłka do plastikowej torby.",
        "pt": "Coloquei as maçãs em um saco plástico.",
        "ro": "Am pus merele într-o pungă de plastic.",
        "ru": "Я положил яблоки в пластиковый пакет.",
        "sv": "Jag lade äpplena i en plastpåse.",
        "tr": "Elmaları plastik bir torbaya koydum.",
        "uk": "Я поклав яблука в поліетиленовий пакет.",
        "vi": "Tôi đã cho táo vào một túi ni lông.",
        "yue": "我將蘋果放咗入膠袋。",
        "zh-Hans": "我把苹果放进了塑料袋。"
      },
