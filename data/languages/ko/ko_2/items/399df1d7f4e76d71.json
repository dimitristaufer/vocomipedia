  "sentences": [
    {
      "target": "저는 한국어와 영어, 두 언어를 공부해요.",
      "reading": "jeoneun hangug-eowa yeong-eo, du eoneoreul gongbuhaeyo.",
      "translations": {
        "en": "I study two languages, Korean and English.",
        "ko": "저는 한국어와 영어, 두 언어를 공부해요.",
        "ipa": "jeoneun hangug-eowa yeong-eo, du eoneoreul gongbuhaeyo.",
        "ar": "أدرس لغتين، الكورية والإنجليزية.",
        "cs": "Učím se dva jazyky, korejštinu a angličtinu.",
        "da": "Jeg studerer to sprog, koreansk og engelsk.",
        "de": "Ich lerne zwei Sprachen, Koreanisch und Englisch.",
        "el": "Μαθαίνω δύο γλώσσες, τα κορεατικά και τα αγγλικά.",
        "es": "Estudio dos idiomas, coreano e inglés.",
        "fi": "Opiskelen kahta kieltä, koreaa ja englantia.",
        "fr": "J'étudie deux langues, le coréen et l'anglais.",
        "he": "אני לומד שתי שפות, קוריאנית ואנגלית.",
        "hi": "मैं कोरियाई और अंग्रेज़ी, दो भाषाएँ सीखता हूँ।",
        "hu": "Két nyelvet tanulok, koreait és angolt.",
        "id": "Saya belajar dua bahasa, bahasa Korea dan bahasa Inggris.",
        "it": "Studio due lingue, coreano e inglese.",
        "ja": "私は韓国語と英語、二つの言語を勉強しています。",
        "nb": "Jeg studerer to språk, koreansk og engelsk.",
        "nl": "Ik studeer twee talen, Koreaans en Engels.",
        "pl": "Uczę się dwóch języków: koreańskiego i angielskiego.",
        "pt": "Eu estudo dois idiomas, coreano e inglês.",
        "ro": "Studiez două limbi, coreeana și engleza.",
        "ru": "Я изучаю два языка: корейский и английский.",
        "sv": "Jag studerar två språk, koreanska och engelska.",
        "tr": "Korece ve İngilizce, iki dil öğreniyorum.",
        "uk": "Я вивчаю дві мови: корейську та англійську.",
        "vi": "Tôi học hai ngôn ngữ, tiếng Hàn và tiếng Anh.",
        "yue": "我學韓文同英文，兩種語言。",
        "zh-Hans": "我学习韩语和英语，两种语言。"
      },
