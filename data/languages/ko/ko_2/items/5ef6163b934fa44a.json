  "sentences": [
    {
      "target": "그는 늦게 와서 많이 후회했어요.",
      "reading": "geuneun neutge waseo mani huhoehaesseoyo.",
      "translations": {
        "en": "He regretted coming late.",
        "ko": "그는 늦게 와서 많이 후회했어요.",
        "ipa": "geuneun neutge waseo mani huhoehaesseoyo.",
        "ar": "لقد ندم لأنه جاء متأخرًا.",
        "cs": "Litoval, že přišel pozdě.",
        "da": "Han fortrød, at han kom for sent.",
        "de": "Er bereute, dass er zu spät gekommen war.",
        "el": "Μετάνιωσε που ήρθε αργά.",
        "es": "Se arrepintió de haber llegado tarde.",
        "fi": "Hän katui, että tuli myöhässä.",
        "fr": "Il a regretté d'être venu en retard.",
        "he": "הוא התחרט על כך שהגיע מאוחר.",
        "hi": "उसे देर से आने का बहुत पछतावा हुआ।",
        "hu": "Megbánta, hogy későn jött.",
        "id": "Dia menyesal karena datang terlambat.",
        "it": "Si è pentito di essere arrivato tardi.",
        "ja": "彼は遅れて来たことをとても後悔しました。",
        "nb": "Han angret på at han kom for sent.",
        "nl": "Hij had er spijt van dat hij te laat kwam.",
        "pl": "Żałował, że przyszedł późno.",
        "pt": "Ele se arrependeu de ter chegado tarde.",
        "ro": "A regretat că a venit târziu.",
        "ru": "Он сожалел, что пришёл поздно.",
        "sv": "Han ångrade att han kom sent.",
        "tr": "Geç geldiğine çok pişman oldu.",
        "uk": "Він шкодував, що прийшов пізно.",
        "vi": "Anh ấy đã hối hận vì đến muộn.",
        "yue": "佢因為遲到而好後悔。",
        "zh-Hans": "他因为来晚了而很后悔。"
      },
