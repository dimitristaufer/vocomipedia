  "sentences": [
    {
      "target": "우리 우정은 영원히 계속될 거예요.",
      "reading": "uri ujeongeun yeongwonhi gyesokdoel geoyeyo.",
      "translations": {
        "en": "Our friendship will continue forever.",
        "ko": "우리 우정은 영원히 계속될 거예요.",
        "ipa": "uri ujeongeun yeongwonhi gyesokdoel geoyeyo.",
        "ar": "ستستمر صداقتنا إلى الأبد.",
        "cs": "Naše přátelství bude trvat navždy.",
        "da": "Vores venskab vil vare for evigt.",
        "de": "Unsere Freundschaft wird für immer weitergehen.",
        "el": "Η φιλία μας θα κρατήσει για πάντα.",
        "es": "Nuestra amistad durará para siempre.",
        "fi": "Ystävyytemme kestää ikuisesti.",
        "fr": "Notre amitié durera pour toujours.",
        "he": "החברות שלנו תימשך לנצח.",
        "hi": "हमारी दोस्ती हमेशा बनी रहेगी।",
        "hu": "A barátságunk örökké tartani fog.",
        "id": "Persahabatan kami akan terus berlangsung selamanya.",
        "it": "La nostra amicizia continuerà per sempre.",
        "ja": "私たちの友情は永遠に続くでしょう。",
        "nb": "Vennskapet vårt vil vare for alltid.",
        "nl": "Onze vriendschap zal voor altijd doorgaan.",
        "pl": "Nasza przyjaźń będzie trwać wiecznie.",
        "pt": "Nossa amizade vai durar para sempre.",
        "ro": "Prietenia noastră va dura pentru totdeauna.",
        "ru": "Наша дружба будет длиться вечно.",
        "sv": "Vår vänskap kommer att vara för evigt.",
        "tr": "Dostluğumuz sonsuza kadar sürecek.",
        "uk": "Наша дружба триватиме вічно.",
        "vi": "Tình bạn của chúng ta sẽ kéo dài mãi mãi.",
        "yue": "我哋嘅友誼會永遠繼續落去。",
        "zh-Hans": "我们的友谊会永远继续下去。"
      },
