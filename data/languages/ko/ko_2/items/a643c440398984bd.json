    {
      "target": "지금은 밤늦은 시간이에요.",
      "reading": "jigeumeun bamneujeun siganieyo.",
      "translations": {
        "en": "It's late at night now.",
        "ko": "지금은 밤늦은 시간이에요.",
        "ipa": "jigeumeun bamneujeun siganieyo.",
        "ar": "الآن الوقت متأخر ليلًا.",
        "cs": "Teď je už pozdě v noci.",
        "da": "Det er sent om natten nu.",
        "de": "Es ist jetzt spät in der Nacht.",
        "el": "Τώρα είναι αργά τη νύχτα.",
        "es": "Ahora es tarde en la noche.",
        "fi": "Nyt on myöhä yö.",
        "fr": "Il est tard dans la nuit, maintenant.",
        "he": "עכשיו מאוחר בלילה.",
        "hi": "अब रात बहुत हो गई है।",
        "hu": "Most már késő van éjszaka.",
        "id": "Sekarang sudah larut malam.",
        "it": "Adesso è tardi nella notte.",
        "ja": "今は夜遅いです。",
        "nb": "Det er sent på natten nå.",
        "nl": "Het is nu laat in de nacht.",
        "pl": "Jest teraz późno w nocy.",
        "pt": "Agora é tarde da noite.",
        "ro": "Acum este târziu în noapte.",
        "ru": "Сейчас уже поздняя ночь.",
        "sv": "Det är sent på natten nu.",
        "tr": "Şimdi gece geç oldu.",
        "uk": "Зараз уже пізно вночі.",
        "vi": "Bây giờ đã khuya rồi.",
        "yue": "而家已經好夜。",
        "zh-Hans": "现在已经很晚了。"
      },
