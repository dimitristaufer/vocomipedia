  "sentences": [
    {
      "target": "대낮인데도 방이 너무 어두워요.",
      "reading": "daenajindeodo bangi neomu eoduwoyo.",
      "translations": {
        "en": "Even though it's broad daylight, the room is very dark.",
        "ko": "대낮인데도 방이 너무 어두워요.",
        "ipa": "daenajindeodo bangi neomu eoduwoyo.",
        "ar": "مع أن الوقت كان في وضح النهار، كانت الغرفة مظلمة جدًا.",
        "cs": "I když bylo bílého dne, pokoj byl velmi tmavý.",
        "da": "Selv om det var højlys dag, var værelset meget mørkt.",
        "de": "Obwohl es heller Tag war, war das Zimmer sehr dunkel.",
        "el": "Παρόλο που ήταν μέρα μεσημέρι, το δωμάτιο ήταν πολύ σκοτεινό.",
        "es": "Aunque era pleno día, la habitación estaba muy oscura.",
        "fi": "Vaikka oli keskellä päivää, huone oli hyvin pimeä.",
        "fr": "Même en plein jour, la chambre était très sombre.",
        "he": "למרות שהיה אור יום מלא, החדר היה חשוך מאוד.",
        "hi": "हालाँकि दोपहर का उजाला था, कमरा बहुत अँधेरा था।",
        "hu": "Bár fényes nappal volt, a szoba nagyon sötét volt.",
        "id": "Meski masih siang bolong, kamarnya sangat gelap.",
        "it": "Anche se era pieno giorno, la stanza era molto buia.",
        "ja": "真昼なのに、部屋がとても暗いです。",
        "nb": "Selv om det var høylys dag, var rommet veldig mørkt.",
        "nl": "Hoewel het helder daglicht was, was de kamer erg donker.",
        "pl": "Mimo że był biały dzień, pokój był bardzo ciemny.",
        "pt": "Embora fosse pleno dia, o quarto estava muito escuro.",
        "ro": "Deși era în plină zi, camera era foarte întunecată.",
        "ru": "Хотя был белый день, в комнате было очень темно.",
        "sv": "Trots att det var fullt dagsljus var rummet väldigt mörkt.",
        "tr": "Gün ortası olmasına rağmen oda çok karanlıktı.",
        "uk": "Хоча був білий день, у кімнаті було дуже темно.",
        "vi": "Dù đang giữa ban ngày, căn phòng vẫn rất tối.",
        "yue": "雖然係大白天，但間房好暗。",
        "zh-Hans": "虽然是大白天，房间却很暗。"
      },
