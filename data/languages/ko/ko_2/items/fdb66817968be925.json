  "sentences": [
    {
      "target": "저는 아침에 물을 마시는 습관이 있어요.",
      "reading": "jeoneun achime mureul masineun seupgwan-i isseoyo.",
      "translations": {
        "en": "I have a habit of drinking water in the morning.",
        "ko": "저는 아침에 물을 마시는 습관이 있어요.",
        "ipa": "jeoneun achime mureul masineun seupgwan-i isseoyo.",
        "ar": "لديّ عادة شرب الماء في الصباح.",
        "cs": "Mám zvyk pít ráno vodu.",
        "da": "Jeg har for vane at drikke vand om morgenen.",
        "de": "Ich habe die Gewohnheit, morgens Wasser zu trinken.",
        "el": "Έχω τη συνήθεια να πίνω νερό το πρωί.",
        "es": "Tengo la costumbre de beber agua por la mañana.",
        "fi": "Minulla on tapa juoda vettä aamuisin.",
        "fr": "J'ai l'habitude de boire de l'eau le matin.",
        "he": "יש לי הרגל לשתות מים בבוקר.",
        "hi": "मुझे सुबह पानी पीने की आदत है।",
        "hu": "Az a szokásom, hogy reggel vizet iszom.",
        "id": "Saya punya kebiasaan minum air di pagi hari.",
        "it": "Ho l'abitudine di bere acqua al mattino.",
        "ja": "私は朝に水を飲む習慣があります。",
        "nb": "Jeg har for vane å drikke vann om morgenen.",
        "nl": "Ik heb de gewoonte om 's ochtends water te drinken.",
        "pl": "Mam zwyczaj pić rano wodę.",
        "pt": "Tenho o hábito de beber água de manhã.",
        "ro": "Am obiceiul să beau apă dimineața.",
        "ru": "У меня есть привычка пить воду по утрам.",
        "sv": "Jag har för vana att dricka vatten på morgonen.",
        "tr": "Sabahları su içme alışkanlığım var.",
        "uk": "У мене є звичка пити воду вранці.",
        "vi": "Tôi có thói quen uống nước vào buổi sáng.",
        "yue": "我有朝早飲水嘅習慣。",
        "zh-Hans": "我有早上喝水的习惯。"
      },
