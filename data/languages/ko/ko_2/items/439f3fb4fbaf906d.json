  "sentences": [
    {
      "target": "교사 한 분이 칠판 앞에서 문제를 설명해요.",
      "reading": "gyosa han bun-i chilpan apeseo munjereul seolmyeonghaeyo.",
      "translations": {
        "en": "A teacher is explaining the problem in front of the blackboard.",
        "ko": "교사 한 분이 칠판 앞에서 문제를 설명해요.",
        "ipa": "gyosa han bun-i chilpan apeseo munjereul seolmyeonghaeyo.",
        "ar": "يشرح المعلم المسألة أمام السبورة.",
        "cs": "Učitel vysvětluje úlohu před tabulí.",
        "da": "Læreren forklarer opgaven foran tavlen.",
        "de": "Die Lehrkraft erklärt die Aufgabe vor der Tafel.",
        "el": "Ο δάσκαλος εξηγεί την άσκηση μπροστά στον πίνακα.",
        "es": "La profesora explica el problema delante de la pizarra.",
        "fi": "Opettaja selittää tehtävää taulun edessä.",
        "fr": "L'enseignant explique le problème devant le tableau.",
        "he": "המורה מסביר את התרגיל מול הלוח.",
        "hi": "शिक्षक ब्लैकबोर्ड के सामने सवाल समझा रहे हैं।",
        "hu": "A tanár a tábla előtt magyarázza a feladatot.",
        "id": "Guru itu menjelaskan soal di depan papan tulis.",
        "it": "L'insegnante spiega il problema davanti alla lavagna.",
        "ja": "先生が黒板の前で問題を説明しています。",
        "nb": "Læreren forklarer oppgaven foran tavla.",
        "nl": "De leraar legt de som uit voor het bord.",
        "pl": "Nauczyciel wyjaśnia zadanie przed tablicą.",
        "pt": "A professora explica o problema em frente ao quadro.",
        "ro": "Profesorul explică exercițiul în fața tablei.",
        "ru": "Учитель объясняет задачу у доски.",
        "sv": "Läraren förklarar uppgiften framför tavlan.",
        "tr": "Öğretmen, tahtanın önünde soruyu anlatıyor.",
        "uk": "Учитель пояснює завдання біля дошки.",
        "vi": "Thầy giáo đang giải thích bài toán trước bảng.",
        "yue": "老師喺黑板前面解釋呢條題目。",
        "zh-Hans": "老师在黑板前讲解题目。"
      },
