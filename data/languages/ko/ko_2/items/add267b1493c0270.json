  "sentences": [
    {
      "target": "교장 선생님의 연설이 길었어요.",
      "reading": "gyojang seonsaengnim-ui yeonseol-i gireosseoyo.",
      "translations": {
        "en": "The principal's speech was long.",
        "ko": "교장 선생님의 연설이 길었어요.",
        "ipa": "gyojang seonsaengnim-ui yeonseol-i gireosseoyo.",
        "ar": "كانت كلمة مدير المدرسة طويلة.",
        "cs": "Řeč ředitele byla dlouhá.",
        "da": "Rektors tale var lang.",
        "de": "Die Rede des Schulleiters war lang.",
        "el": "Η ομιλία του διευθυντή ήταν μεγάλη.",
        "es": "El discurso del director fue largo.",
        "fi": "Rehtorin puhe oli pitkä.",
        "fr": "Le discours du directeur était long.",
        "he": "הנאום של המנהל היה ארוך.",
        "hi": "प्रधानाचार्य का भाषण लंबा था।",
        "hu": "Az igazgató beszéde hosszú volt.",
        "id": "Pidato kepala sekolah itu panjang.",
        "it": "Il discorso del preside è stato lungo.",
        "ja": "校長先生のスピーチは長かったです。",
        "nb": "Rektorens tale var lang.",
        "nl": "De toespraak van de directeur was lang.",
        "pl": "Przemówienie dyrektora było długie.",
        "pt": "O discurso do diretor foi longo.",
        "ro": "Discursul directorului a fost lung.",
        "ru": "Речь директора была долгой.",
        "sv": "Rektorns tal var långt.",
        "tr": "Müdürün konuşması uzundu.",
        "uk": "Промова директора була довгою.",
        "vi": "Bài phát biểu của hiệu trưởng rất dài.",
        "yue": "校長嘅演講好長。",
        "zh-Hans": "校长的演讲很长。"
      },
