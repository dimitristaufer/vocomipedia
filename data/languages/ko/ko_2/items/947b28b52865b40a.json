  "sentences": [
    {
      "target": "그 사나이는 약속을 꼭 지켜요.",
      "reading": "geu sanain-eun yaksogeul kkok jikyeoyo.",
      "translations": {
        "en": "That man always keeps his word.",
        "ko": "그 사나이는 약속을 꼭 지켜요.",
        "ipa": "geu sanain-eun yaksogeul kkok jikyeoyo.",
        "ar": "ذلك الرجل يفي بوعده دائمًا.",
        "cs": "Ten muž vždy dodrží slovo.",
        "da": "Den mand holder altid sit ord.",
        "de": "Der Mann hält immer sein Wort.",
        "el": "Εκείνος ο άντρας κρατά πάντα τον λόγο του.",
        "es": "Ese hombre siempre cumple su palabra.",
        "fi": "Se mies pitää aina sanansa.",
        "fr": "Cet homme tient toujours sa parole.",
        "he": "הגבר הזה תמיד עומד בהבטחתו.",
        "hi": "वह आदमी हमेशा अपना वादा निभाता है।",
        "hu": "Az a férfi mindig tartja a szavát.",
        "id": "Pria itu selalu menepati janjinya.",
        "it": "Quell'uomo mantiene sempre la parola.",
        "ja": "あの男はいつも約束を守ります。",
        "nb": "Den mannen holder alltid ord.",
        "nl": "Die man houdt zich altijd aan zijn woord.",
        "pl": "Ten mężczyzna zawsze dotrzymuje słowa.",
        "pt": "Aquele homem sempre cumpre a palavra.",
        "ro": "Bărbatul acela își ține mereu cuvântul.",
        "ru": "Тот мужчина всегда держит слово.",
        "sv": "Den där mannen håller alltid sitt ord.",
        "tr": "Şu adam verdiği sözü hep tutar.",
        "uk": "Той чоловік завжди тримає слово.",
        "vi": "Người đàn ông đó luôn giữ lời hứa.",
        "yue": "嗰個男人成日守承諾。",
        "zh-Hans": "那个人总是信守承诺。"
      },
