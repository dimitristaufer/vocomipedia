    {
      "target": "좋은 소식에 할머니도 만세를 외치셨어요.",
      "reading": "joeun sosige halmeonido manserul oechisyeosseoyo.",
      "translations": {
        "en": "Even Grandma cheered, “Hurray!” at the good news.",
        "ko": "좋은 소식에 할머니도 만세를 외치셨어요.",
        "ipa": "joeun sosige halmeonido manserul oechisyeosseoyo.",
        "ar": "حتى جدتي هتفت: «هورا!» عند سماع الخبر السار.",
        "cs": "I babička vykřikla nad dobrou zprávou: „Hurá!“",
        "da": "Selv bedstemor råbte: „Hurra!“ over den gode nyhed.",
        "de": "Sogar Oma rief bei der guten Nachricht: „Hurra!“",
        "el": "Ακόμα και η γιαγιά ζητωκραύγασε στης καλής είδησης.",
        "es": "Hasta la abuela gritó: «¡Hurra!» ante la buena noticia.",
        "fi": "Myös mummo hurrasi hyvän uutisen kuultuaan.",
        "fr": "Même mamie a crié : « Hourra ! » à la bonne nouvelle.",
        "he": "גם סבתא קראה: ״הידד!״ לשמע החדשות הטובות.",
        "hi": "अच्छी खबर सुनकर दादी ने भी हुर्रे कहा।",
        "hu": "A jó hírre még a nagyi is felkiáltott: „Hurrá!”",
        "id": "Bahkan nenek juga berseru, “Hore!” saat mendengar kabar baik.",
        "it": "Anche la nonna ha gridato: «Urrà!» alla bella notizia.",
        "ja": "いい知らせに、おばあちゃんも万歳と叫びました。",
        "nb": "Til og med bestemor ropte: «Hurra!» over de gode nyhetene.",
        "nl": "Zelfs oma riep: ‘Hoera!’ bij het goede nieuws.",
        "pl": "Nawet babcia zawołała: „Hurra!” na dobrą wiadomość.",
        "pt": "Até a vovó gritou: “Viva!” com a boa notícia.",
        "ro": "Chiar și bunica a strigat: «Ura!» la vestea cea bună.",
        "ru": "Даже бабушка воскликнула: «Ура!» на хорошую новость.",
        "sv": "Till och med mormor ropade: ”Hurra!” när hon hörde de goda nyheterna.",
        "tr": "İyi haberi duyunca büyükanne bile «Yaşasın!» diye bağırdı.",
        "uk": "Навіть бабуся вигукнула: «Ура!» на добру новину.",
        "vi": "Nghe tin tốt, bà cũng hô: “Hoan hô!”",
        "yue": "有好消息，婆婆都歡呼：「萬歲！」",
        "zh-Hans": "听到好消息，奶奶也欢呼：“万岁！”"
      },
