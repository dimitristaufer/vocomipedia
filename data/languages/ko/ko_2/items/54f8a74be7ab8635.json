    {
      "target": "사람들은 광장에 모여 만세를 외쳤어요.",
      "reading": "saramdeureun gwangjange moyeo manserul oechyeosseoyo.",
      "translations": {
        "en": "People gathered in the square and shouted, “Hurray!”",
        "ko": "사람들은 광장에 모여 만세를 외쳤어요.",
        "ipa": "saramdeureun gwangjange moyeo manserul oechyeosseoyo.",
        "ar": "تجمع الناس في الساحة وهتفوا: «هورا!»",
        "cs": "Lidé se shromáždili na náměstí a křičeli: „Hurá!“",
        "da": "Folk samledes på pladsen og råbte: „Hurra!“",
        "de": "Die Leute versammelten sich auf dem Platz und riefen: „Hurra!“",
        "el": "Οι άνθρωποι μαζεύτηκαν στην πλατεία και φώναξαν: «Ουρά!»",
        "es": "La gente se reunió en la plaza y gritó: «¡Hurra!»",
        "fi": "Ihmiset kokoontuivat aukiolle ja huusivat: ”Hurraa!”",
        "fr": "Les gens se sont rassemblés sur la place et ont crié : « Hourra ! »",
        "he": "האנשים התאספו בכיכר וצעקו: ״הידד!״",
        "hi": "लोग चौक में इकट्ठा हुए और हुर्रे कहा।",
        "hu": "Az emberek összegyűltek a téren, és azt kiáltották: „Hurrá!”",
        "id": "Orang-orang berkumpul di alun-alun dan berseru, “Hore!”",
        "it": "La gente si è radunata nella piazza e ha gridato: «Urrà!»",
        "ja": "人々は広場に集まって万歳と叫びました。",
        "nb": "Folk samlet seg på torget og ropte: «Hurra!»",
        "nl": "Mensen verzamelden zich op het plein en riepen: ‘Hoera!’",
        "pl": "Ludzie zebrali się na placu i zawołali: „Hurra!”",
        "pt": "As pessoas se reuniram na praça e gritaram: “Viva!”",
        "ro": "Oamenii s-au adunat în piață și au strigat: «Ura!»",
        "ru": "Люди собрались на площади и закричали: «Ура!»",
