  "sentences": [
    {
      "target": "우승 소식에 모두 만세를 불렀어요.",
      "reading": "usung sosige modu manserul bulreosseoyo.",
      "translations": {
        "en": "At the news of the victory, everyone cheered, “Hurray!”",
        "ko": "우승 소식에 모두 만세를 불렀어요.",
        "ipa": "usung sosige modu manserul bulreosseoyo.",
        "ar": "عند سماع خبر الفوز، هتف الجميع: «هورا!»",
        "cs": "Když se dozvěděli o vítězství, všichni jásali: „Hurá!“",
        "da": "Da de hørte om sejren, jublede alle: „Hurra!“",
        "de": "Bei der Nachricht vom Sieg riefen alle: „Hurra!“",
        "el": "Στο άκουσμα της νίκης, όλοι ζητωκραύγασαν: «Ουρά!»",
        "es": "Al enterarse de la victoria, todos gritaron: «¡Hurra!»",
        "fi": "Voiton kuultuaan kaikki hurrasivat.",
        "fr": "À l’annonce de la victoire, tout le monde a crié : « Hourra ! »",
        "he": "לנוכח בשורת הניצחון, כולם קראו: ״הידד!״",
        "hi": "जीत की खबर सुनकर सब ने हुर्रे कहा।",
        "hu": "A győzelem hírére mindenki éljenzett: „Hurrá!”",
        "id": "Saat mendengar berita kemenangan, semua orang bersorak, “Hore!”",
        "it": "Alla notizia della vittoria, tutti hanno gridato: «Urrà!»",
        "ja": "勝利の知らせに、みんなで万歳と叫びました。",
        "nb": "Da de hørte om seieren, jublet alle: «Hurra!»",
        "nl": "Bij het nieuws van de overwinning juichten ze allemaal: ‘Hoera!’",
        "pl": "Na wieść o zwycięstwie wszyscy zawołali: „Hurra!”",
        "pt": "Com a notícia da vitória, todos gritaram: “Viva!”",
        "ro": "La vestea victoriei, toți au strigat: «Ura!»",
        "ru": "Услышав о победе, все закричали: «Ура!»",
        "sv": "När de fick höra om segern jublade সবাই: ”Hurra!”",
        "tr": "Zafer haberini duyunca herkes «Yaşasın!» diye bağırdı.",
        "uk": "Дізнавшись про перемогу, усі закричали: «Ура!»",
        "vi": "Nghe tin thắng lợi, mọi người đều hô: “Hoan hô!”",
        "yue": "聽到勝利嘅消息，大家都歡呼：「萬歲！」",
        "zh-Hans": "听到胜利的消息，大家都欢呼：“万岁！”"
      },
