    {
      "target": "요즘 경제가 많이 어려워요.",
      "reading": "yojeum gyeongjega mani eoryeowoyo.",
      "translations": {
        "en": "The economy is very difficult these days.",
        "ko": "요즘 경제가 많이 어려워요.",
        "ipa": "yojeum gyeongjega mani eoryeowoyo.",
        "ar": "الاقتصاد صعب جدًا هذه الأيام.",
        "cs": "V poslední době je ekonomika hodně špatná.",
        "da": "Økonomien er meget svær i disse dage.",
        "de": "Die Wirtschaft ist in letzter Zeit sehr schwierig.",
        "el": "Η οικονομία είναι πολύ δύσκολη τελευταία.",
        "es": "La economía está muy difícil estos días.",
        "fi": "Talous on ollut viime aikoina todella vaikea.",
        "fr": "L'économie est très difficile en ce moment.",
        "he": "הכלכלה קשה מאוד בימים אלה.",
        "hi": "इन दिनों अर्थव्यवस्था बहुत मुश्किल है।",
        "hu": "Mostanában a gazdaság nagyon nehéz helyzetben van.",
        "id": "Ekonomi sedang sangat sulit akhir-akhir ini.",
        "it": "L'economia è molto difficile in questi giorni.",
        "ja": "最近、景気がとても悪いです。",
        "nb": "Økonomien er veldig vanskelig i disse dager.",
        "nl": "De economie is de laatste tijd erg slecht.",
        "pl": "Gospodarka jest ostatnio bardzo trudna.",
        "pt": "A economia está muito difícil estes dias.",
        "ro": "Economia este foarte grea în zilele astea.",
        "ru": "В наши дни экономика очень тяжёлая.",
        "sv": "Ekonomin är väldigt svår nuförtiden.",
        "tr": "Ekonomi bu günlerde çok zor.",
        "uk": "Останнім часом економіка дуже важка.",
        "vi": "Kinh tế dạo này rất khó khăn.",
        "yue": "呢排經濟好差。",
        "zh-Hans": "这些天经济很困难。"
      },
