  "sentences": [
    {
      "target": "박물관에서 오래된 유물을 봤어요.",
      "reading": "bakmulgwan-eseo oraedoen yumul-eul bwasseoyo.",
      "translations": {
        "en": "I saw an old relic at the museum.",
        "ko": "박물관에서 오래된 유물을 봤어요.",
        "ipa": "bakmulgwan-eseo oraedoen yumul-eul bwasseoyo.",
        "ar": "رأيتُ قطعة أثرية قديمة في المتحف.",
        "cs": "V muzeu jsem viděl starý artefakt.",
        "da": "Jeg så en gammel genstand på museet.",
        "de": "Ich habe im Museum ein altes Relikt gesehen.",
        "el": "Είδα ένα παλιό κειμήλιο στο μουσείο.",
        "es": "Vi una reliquia antigua en el museo.",
        "fi": "Näin museossa vanhan esineen.",
        "fr": "J'ai vu une vieille relique au musée.",
        "he": "ראיתי במוזיאון שריד עתיק.",
        "hi": "मैंने संग्रहालय में एक पुरावशेष देखा।",
        "hu": "Láttam egy régi ereklyét a múzeumban.",
        "id": "Saya melihat benda purbakala tua di museum.",
        "it": "Ho visto una vecchia reliquia al museo.",
        "ja": "博物館で古い遺物を見ました。",
        "nb": "Jeg så et gammelt kulturminne på museet.",
        "nl": "Ik zag een oud relikwie in het museum.",
        "pl": "W muzeum zobaczyłem stary zabytek.",
        "pt": "Vi uma relíquia antiga no museu.",
        "ro": "Am văzut o relicvă veche la muzeu.",
        "ru": "Я увидел в музее древний артефакт.",
        "sv": "Jag såg ett gammalt kulturföremål på museet.",
        "tr": "Müzede eski bir eser gördüm.",
        "uk": "Я побачив у музеї стародавній артефакт.",
        "vi": "Tôi đã thấy một hiện vật cổ ở bảo tàng.",
        "yue": "我喺博物館見到一件古老嘅文物。",
        "zh-Hans": "我在博物馆里看到了一件古老的文物。"
      },
