  "sentences": [
    {
      "target": "그 집에는 자매가 셋 있어요.",
      "reading": "geu jibeneun jamaega set isseoyo.",
      "translations": {
        "en": "There are three sisters in that family.",
        "ko": "그 집에는 자매가 셋 있어요.",
        "ipa": "geu jibeneun jamaega set isseoyo.",
        "ar": "في ذلك البيت ثلاث أخوات.",
        "cs": "V tom domě jsou tři sestry.",
        "da": "Der er tre søstre i det hus.",
        "de": "In dem Haus gibt es drei Schwestern.",
        "el": "Σε εκείνο το σπίτι υπάρχουν τρεις αδελφές.",
        "es": "En esa casa hay tres hermanas.",
        "fi": "Siinä talossa on kolme sisarta.",
        "fr": "Il y a trois sœurs dans cette maison.",
        "he": "בבית הזה יש שלוש אחיות.",
        "hi": "उस घर में तीन बहनें हैं।",
        "hu": "Abban a házban három testvérlány van.",
        "id": "Di rumah itu ada tiga saudara perempuan.",
        "it": "In quella casa ci sono tre sorelle.",
        "ja": "あの家には姉妹が三人います。",
        "nb": "Det er tre søstre i det huset.",
        "nl": "In dat huis zijn drie zussen.",
        "pl": "W tym domu są trzy siostry.",
        "pt": "Nessa casa há três irmãs.",
        "ro": "În casa aceea sunt trei surori.",
        "ru": "В том доме три сестры.",
        "sv": "Det finns tre systrar i det huset.",
        "tr": "O evde üç kız kardeş var.",
        "uk": "У тому будинку три сестри.",
        "vi": "Trong ngôi nhà đó có ba chị em gái.",
        "yue": "嗰間屋企有三姊妹。",
        "zh-Hans": "那个家里有三个姐妹。"
      },
