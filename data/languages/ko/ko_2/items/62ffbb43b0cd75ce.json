  "sentences": [
    {
      "target": "아버지는 저의 영웅이에요.",
      "reading": "abeojineun jeoui yeongungieyo.",
      "translations": {
        "en": "My father is my hero.",
        "ko": "아버지는 저의 영웅이에요.",
        "ipa": "abeojineun jeoui yeongungieyo.",
        "ar": "أبي هو بطلي.",
        "cs": "Můj táta je můj hrdina.",
        "da": "Min far er min helt.",
        "de": "Mein Vater ist mein Held.",
        "el": "Ο πατέρας μου είναι ο ήρωάς μου.",
        "es": "Mi padre es mi héroe.",
        "fi": "Isäni on sankarini.",
        "fr": "Mon père est mon héros.",
        "he": "אבא שלי הוא הגיבור שלי.",
        "hi": "मेरे पिता मेरे नायक हैं।",
        "hu": "Az apám a hősöm.",
        "id": "Ayah saya adalah pahlawan saya.",
        "it": "Mio padre è il mio eroe.",
        "ja": "父は私のヒーローです。",
        "nb": "Faren min er helten min.",
        "nl": "Mijn vader is mijn held.",
        "pl": "Mój tata jest moim bohaterem.",
        "pt": "Meu pai é meu herói.",
        "ro": "Tatăl meu este eroul meu.",
        "ru": "Мой отец — мой герой.",
        "sv": "Min pappa är min hjälte.",
        "tr": "Babam benim kahramanım.",
        "uk": "Мій батько — мій герой.",
        "vi": "Bố tôi là người hùng của tôi.",
        "yue": "我爸爸係我嘅英雄。",
        "zh-Hans": "我父亲是我的英雄。"
      },
