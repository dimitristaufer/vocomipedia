  "sentences": [
    {
      "target": "오늘 행사 진행자는 민수예요.",
      "reading": "oneul haengsa jinhaengjaneun minsu-yeyo.",
      "translations": {
        "en": "Today's event host is Min-su.",
        "ko": "오늘 행사 진행자는 민수예요.",
        "ipa": "oneul haengsa jinhaengjaneun minsu-yeyo.",
        "ar": "مقدم الفعالية اليوم هو مينسو.",
        "cs": "Dnešním moderátorem akce je Min-su.",
        "da": "Dagens vært er Min-su.",
        "de": "Der Moderator der heutigen Veranstaltung ist Min-su.",
        "el": "Ο παρουσιαστής της σημερινής εκδήλωσης είναι ο Μιν-σου.",
        "es": "El presentador del evento de hoy es Min-su.",
        "fi": "Tämän päivän juontaja on Min-su.",
        "fr": "L’animateur de l’événement d’aujourd’hui est Min-su.",
        "he": "מנחה האירוע היום הוא מין-סו.",
        "hi": "आज के कार्यक्रम का संचालक मिनसू है।",
        "hu": "A mai rendezvény műsorvezetője Min-su.",
        "id": "Pembawa acara acara hari ini adalah Min-su.",
        "it": "Il presentatore dell'evento di oggi è Min-su.",
        "ja": "今日のイベントの司会はミンスです。",
        "nb": "Dagens konferansier er Min-su.",
        "nl": "De presentator van het evenement van vandaag is Min-su.",
        "pl": "Prowadzącym dzisiejszej imprezy jest Min-su.",
        "pt": "O apresentador do evento de hoje é Min-su.",
        "ro": "Gazda evenimentului de azi este Min-su.",
        "ru": "Ведущим сегодняшнего мероприятия является Минсу.",
        "sv": "Dagens konferencier är Min-su.",
        "tr": "Bugünkü etkinliğin sunucusu Min-su.",
        "uk": "Ведучим сьогоднішнього заходу є Мінсу.",
        "vi": "Người dẫn chương trình của sự kiện hôm nay là Min-su.",
        "yue": "今日活動嘅主持係敏洙。",
        "zh-Hans": "今天活动的主持人是敏洙。"
      },
