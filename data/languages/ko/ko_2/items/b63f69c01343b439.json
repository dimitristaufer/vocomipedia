  "sentences": [
    {
      "target": "저는 이번 월드컵을 집에서 봤어요.",
      "reading": "jeoneun ibeon woldeukeopeul jibeseo bwasseoyo.",
      "translations": {
        "en": "I watched this World Cup at home.",
        "ko": "저는 이번 월드컵을 집에서 봤어요.",
        "ipa": "jeoneun ibeon woldeukeopeul jibeseo bwasseoyo.",
        "ar": "شاهدت كأس العالم هذا العام في المنزل.",
        "cs": "Sledal jsem tenhle mistrovský turnaj doma.",
        "da": "Jeg så denne VM-turnering derhjemme.",
        "de": "Ich habe diese Weltmeisterschaft zu Hause gesehen.",
        "el": "Είδα αυτό το Μουντιάλ στο σπίτι.",
        "es": "Vi este Mundial en casa.",
        "fi": "Katsoin tämän MM-kisat kotona.",
        "fr": "J’ai regardé cette Coupe du monde à la maison.",
        "he": "צפיתי במונדיאל הזה בבית.",
        "hi": "मैंने यह विश्व कप घर पर देखा।",
        "hu": "Ezt a világbajnokságot otthon néztem.",
        "id": "Saya menonton Piala Dunia ini di rumah.",
        "it": "Ho guardato questo Mondiale a casa.",
        "ja": "私は今回のワールドカップを家で見ました。",
        "nb": "Jeg så dette verdensmesterskapet hjemme.",
        "nl": "Ik keek thuis naar dit WK.",
        "pl": "Oglądałem to mistrzostwo świata w domu.",
        "pt": "Eu assisti a esta Copa do Mundo em casa.",
        "ro": "Am urmărit acest Campionat Mondial acasă.",
        "ru": "Я смотрел этот чемпионат мира дома.",
        "sv": "Jag såg det här världsmästerskapet hemma.",
        "tr": "Bu Dünya Kupası'nı evde izledim.",
        "uk": "Я дивився цей чемпіонат світу вдома.",
        "vi": "Tôi đã xem World Cup này ở nhà.",
        "yue": "我喺屋企睇咗今屆世界盃。",
        "zh-Hans": "我在家看了这届世界杯。"
