  "sentences": [
    {
      "target": "어린이날에 아이들이 공원에서 놀았어요.",
      "reading": "eorininal-e aideuri gongwoneseo norasseoyo.",
      "translations": {
        "en": "The children played in the park on Children's Day.",
        "ko": "어린이날에 아이들이 공원에서 놀았어요.",
        "ipa": "eorininal-e aideuri gongwoneseo norasseoyo.",
        "ar": "لعب الأطفال في الحديقة في يوم الطفل.",
        "cs": "Na Den dětí si děti hrály v parku.",
        "da": "Børnene legede i parken på Børnenes Dag.",
        "de": "Am Kindertag spielten die Kinder im Park.",
        "el": "Την Ημέρα του Παιδιού τα παιδιά έπαιξαν στο πάρκο.",
        "es": "Los niños jugaron en el parque en el Día del Niño.",
        "fi": "Lapset leikkivät puistossa lastenpäivänä.",
        "fr": "Les enfants ont joué dans le parc à l'occasion de la Journée des enfants.",
        "he": "הילדים שיחקו בפארק ביום הילד.",
        "hi": "बाल दिवस पर बच्चे पार्क में खेले।",
        "hu": "Gyereknapon a gyerekek a parkban játszottak.",
        "id": "Pada Hari Anak, anak-anak bermain di taman.",
        "it": "I bambini hanno giocato nel parco per la Festa dei bambini.",
        "ja": "こどもの日に子どもたちは公園で遊びました。",
        "nb": "På barnedagen lekte barna i parken.",
        "nl": "Op Kinderdag speelden de kinderen in het park.",
        "pl": "W Dzień Dziecka dzieci bawiły się w parku.",
        "pt": "No Dia das Crianças, as crianças brincaram no parque.",
        "ro": "De Ziua Copilului, copiii s-au jucat în parc.",
        "ru": "В День детей дети играли в парке.",
        "sv": "På barnens dag lekte barnen i parken.",
        "tr": "Çocuk Bayramı'nda çocuklar parkta oynadı.",
        "uk": "На День дітей діти гралися в парку.",
        "vi": "Vào Ngày Thiếu nhi, bọn trẻ đã chơi ở công viên.",
        "yue": "喺兒童節，啲小朋友喺公園玩。",
        "zh-Hans": "儿童节那天，孩子们在公园里玩。"
      },
