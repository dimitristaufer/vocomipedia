  "sentences": [
    {
      "target": "그 소설은 주인공의 타락을 다뤘어요.",
      "reading": "geu soseoreun juingong-ui tarageul darwosseoyo.",
      "translations": {
        "en": "The novel dealt with the hero's downfall.",
        "ko": "그 소설은 주인공의 타락을 다뤘어요.",
        "ipa": "geu soseoreun juingong-ui tarageul darwosseoyo.",
        "ar": "تناولت تلك الرواية سقوط البطل.",
        "cs": "Ten román pojednával o pádu hlavního hrdiny.",
        "da": "Den roman handlede om heltenes fald.",
        "de": "Der Roman handelte vom Niedergang des Helden.",
        "el": "Το μυθιστόρημα ασχολήθηκε με την πτώση του ήρωα.",
        "es": "La novela trataba la caída del protagonista.",
        "fi": "Romaani kertoi sankarin lankeemuksesta.",
        "fr": "Le roman racontait la chute du héros.",
        "he": "הרומן עסק בנפילתו של הגיבור.",
        "hi": "उस उपन्यास में नायक के पतन को दिखाया गया था।",
        "hu": "A regény a hős bukását mutatta be.",
        "id": "Novel itu membahas kejatuhan tokoh utamanya.",
        "it": "Il romanzo trattava la caduta del protagonista.",
        "ja": "その小説は主人公の堕落を扱っていました。",
        "nb": "Romanen handlet om heltens fall.",
        "nl": "De roman ging over de ondergang van de held.",
        "pl": "Ta powieść opowiadała o upadku bohatera.",
        "pt": "O romance tratava da queda do herói.",
        "ro": "Romanul trata despre decăderea eroului.",
        "ru": "Роман рассказывал о падении героя.",
        "sv": "Romanen handlade om hjältens fall.",
        "tr": "Roman, kahramanın çöküşünü anlatıyordu.",
        "uk": "Роман розповідав про падіння героя.",
        "vi": "Cuốn tiểu thuyết nói về sự sa ngã của nhân vật chính.",
        "yue": "嗰本小說講咗主角嘅墮落。",
        "zh-Hans": "那部小说讲述了主人公的堕落。"
      },
