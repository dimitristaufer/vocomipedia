    {
      "target": "아버지는 암 진단을 받았어요.",
      "reading": "abeojineun am jindaneul badasseoyo.",
      "translations": {
        "en": "My father was diagnosed with cancer.",
        "ko": "아버지는 암 진단을 받았어요.",
        "ipa": "abeojineun am jindaneul badasseoyo.",
        "ar": "شُخِّص والدي بالسرطان.",
        "cs": "Mému otci diagnostikovali rakovinu.",
        "da": "Min far fik konstateret kræft.",
        "de": "Bei meinem Vater wurde Krebs diagnostiziert.",
        "el": "Διαγνώστηκε καρκίνος στον πατέρα μου.",
        "es": "A mi padre le diagnosticaron cáncer.",
        "fi": "Isälleni diagnosoitiin syöpä.",
        "fr": "On a diagnostiqué un cancer à mon père.",
        "he": "אבא שלי אובחן כחולה סרטן.",
        "hi": "मेरे पिता को कैंसर का पता चला।",
        "hu": "Apámat rákkal diagnosztizálták.",
        "id": "Ayah saya didiagnosis kanker.",
        "it": "A mio padre hanno diagnosticato un cancro.",
        "ja": "父はがんと診断されました。",
        "nb": "Faren min fikk påvist kreft.",
        "nl": "Mijn vader kreeg de diagnose kanker.",
        "pl": "Mojemu ojcu zdiagnozowano raka.",
        "pt": "Meu pai foi diagnosticado com câncer.",
        "ro": "Tatăl meu a fost diagnosticat cu cancer.",
        "ru": "У моего отца диагностировали рак.",
        "sv": "Min pappa fick diagnosen cancer.",
        "tr": "Babamın kanser teşhisi kondu.",
        "uk": "У мого батька діагностували рак.",
        "vi": "Bố tôi được chẩn đoán mắc ung thư.",
        "yue": "我爸爸確診咗癌症。",
        "zh-Hans": "我父亲被诊断出癌症。"
      },
