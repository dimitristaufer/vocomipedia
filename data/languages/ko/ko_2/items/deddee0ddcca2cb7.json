    {
      "target": "경기장에 긴장감이 감돌았어요.",
      "reading": "gyeonggijange ginjanggami gamdoratseoyo.",
      "translations": {
        "en": "A feeling of tension filled the stadium.",
        "ko": "경기장에 긴장감이 감돌았어요.",
        "ipa": "gyeonggijange ginjanggami gamdoratseoyo.",
        "ar": "ساد جو من التوتر في الملعب.",
        "cs": "Na stadionu panovalo napětí.",
        "da": "Der herskede spænding på stadion.",
        "de": "Im Stadion lag eine angespannte Stimmung.",
        "el": "Η ατμόσφαιρα στο στάδιο ήταν τεταμένη.",
        "es": "Había tensión en el estadio.",
        "fi": "Stadionilla oli jännittynyt tunnelma.",
        "fr": "Il régnait une atmosphère tendue dans le stade.",
        "he": "שררה מתח באצטדיון.",
        "hi": "स्टेडियम में तनाव का माहौल था।",
        "hu": "Feszült volt a hangulat a stadionban.",
        "id": "Ada suasana tegang di stadion.",
        "it": "C'era tensione nello stadio.",
        "ja": "競技場には緊張感が漂っていた。",
        "nb": "Det lå en spent stemning på stadion.",
        "nl": "Er hing spanning in het stadion.",
        "pl": "Na stadionie panowało napięcie.",
        "pt": "Havia tensão no estádio.",
        "ro": "Era o atmosferă tensionată pe stadion.",
        "ru": "На стадионе царило напряжение.",
        "sv": "Det låg en spänd stämning på stadion.",
        "tr": "Stadyumda gergin bir hava vardı.",
        "uk": "На стадіоні панувала напруга.",
        "vi": "Trong sân vận động có một bầu không khí căng thẳng.",
        "yue": "球場入面有緊張嘅氣氛。",
        "zh-Hans": "体育场里弥漫着紧张的气氛。"
      },
