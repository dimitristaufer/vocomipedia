  "sentences": [
    {
      "target": "저는 내년에 유럽에 여행 가고 싶어요.",
      "reading": "jeoneun naenyeone yureobe yeohaeng gago sipeoyo.",
      "translations": {
        "en": "I want to travel to Europe next year.",
        "ko": "저는 내년에 유럽에 여행 가고 싶어요.",
        "ipa": "jeoneun naenyeone yureobe yeohaeng gago sipeoyo.",
        "ar": "أريد أن أسافر إلى أوروبا العام المقبل.",
        "cs": "Chci příští rok cestovat do Evropy.",
        "da": "Jeg vil gerne rejse til Europa næste år.",
        "de": "Ich möchte nächstes Jahr nach Europa reisen.",
        "el": "Θέλω να ταξιδέψω στην Ευρώπη του χρόνου.",
        "es": "Quiero viajar a Europa el año que viene.",
        "fi": "Haluan matkustaa Eurooppaan ensi vuonna.",
        "fr": "Je veux voyager en Europe l'année prochaine.",
        "he": "אני רוצה לטייל באירופה בשנה הבאה.",
        "hi": "मैं अगले साल यूरोप जाना चाहता हूँ।",
        "hu": "Jövőre szeretnék Európába utazni.",
        "id": "Saya ingin bepergian ke Eropa tahun depan.",
        "it": "Voglio viaggiare in Europa l'anno prossimo.",
        "ja": "来年、ヨーロッパに旅行したいです。",
        "nb": "Jeg vil reise til Europa neste år.",
        "nl": "Ik wil volgend jaar naar Europa reizen.",
        "pl": "Chcę w przyszłym roku pojechać do Europy.",
        "pt": "Quero viajar para a Europa no ano que vem.",
        "ro": "Vreau să călătoresc în Europa anul viitor.",
        "ru": "Я хочу поехать в Европу в следующем году.",
        "sv": "Jag vill resa till Europa nästa år.",
        "tr": "Gelecek yıl Avrupa'ya seyahat etmek istiyorum.",
        "uk": "Я хочу поїхати в Європу наступного року.",
        "vi": "Tôi muốn đi du lịch châu Âu vào năm tới.",
        "yue": "我想聽年去歐洲旅行。",
        "zh-Hans": "我想明年去欧洲旅游。"
      },
