  "sentences": [
    {
      "target": "할아버지는 손자와 공원에 갔어요.",
      "reading": "harabeojineun sonjawa gongwone gasseoyo.",
      "translations": {
        "en": "Grandpa went to the park with his grandson.",
        "ko": "할아버지는 손자와 공원에 갔어요.",
        "ipa": "harabeojineun sonjawa gongwone gasseoyo.",
        "ar": "ذهب الجد إلى الحديقة مع حفيده.",
        "cs": "Dědeček šel s vnukem do parku.",
        "da": "Bedstefaren gik i parken med sit barnebarn.",
        "de": "Der Opa ging mit seinem Enkel in den Park.",
        "el": "Ο παππούς πήγε στο πάρκο με τον εγγονό του.",
        "es": "El abuelo fue al parque con su nieto.",
        "fi": "Isoisä meni puistoon pojanpoikansa kanssa.",
        "fr": "Le grand-père est allé au parc avec son petit-fils.",
        "he": "הסבא הלך לפארק עם הנכד שלו.",
        "hi": "दादा अपने पोते के साथ पार्क गए।",
        "hu": "A nagypapa elment a parkba az unokájával.",
        "id": "Kakek pergi ke taman bersama cucunya.",
        "it": "Il nonno è andato al parco con suo nipote.",
        "ja": "おじいさんは孫と公園に行きました。",
        "nb": "Bestefaren gikk til parken med barnebarnet sitt.",
        "nl": "Opa ging met zijn kleinzoon naar het park.",
        "pl": "Dziadek poszedł do parku ze swoim wnukiem.",
        "pt": "O avô foi ao parque com o neto.",
        "ro": "Bunicul a mers în parc cu nepotul său.",
        "ru": "Дедушка пошёл в парк со своим внуком.",
        "sv": "Farfar gick till parken med sitt barnbarn.",
        "tr": "Dede, torunuyla parka gitti.",
        "uk": "Дідусь пішов до парку зі своїм онуком.",
        "vi": "Ông nội đã đi công viên với cháu trai của mình.",
        "yue": "爺爺同佢個孫仔去咗公園。",
        "zh-Hans": "爷爷和他的孙子去了公园。"
      },
