    {
      "target": "교대 시간이 다 됐어요.",
      "reading": "gyodae sigani da dwaesseoyo.",
      "translations": {
        "en": "It's time to change shifts.",
        "ko": "교대 시간이 다 됐어요.",
        "ipa": "gyodae sigani da dwaesseoyo.",
        "ar": "حان وقت تبديل الشفتات.",
        "cs": "Je čas vystřídat směnu.",
        "da": "Det er tid til at skifte vagt.",
        "de": "Es ist Zeit für den Schichtwechsel.",
        "el": "Ώρα για αλλαγή βάρδιας.",
        "es": "Es hora de cambiar de turno.",
        "fi": "On aika vaihtaa vuoroa.",
        "fr": "Il est temps de changer de poste.",
        "he": "הגיע הזמן להחליף משמרת.",
        "hi": "शिफ्ट बदलने का समय हो गया है।",
        "hu": "Itt az ideje váltani a műszakot.",
        "id": "Sudah waktunya ganti shift.",
        "it": "È ora di cambiare turno.",
        "ja": "交代の時間になりました。",
        "nb": "Det er på tide å skifte skift.",
        "nl": "Het is tijd om van dienst te wisselen.",
        "pl": "Czas zmienić zmianę.",
        "pt": "Está na hora de trocar de turno.",
        "ro": "E timpul să schimbăm tura.",
        "ru": "Пора сменить смену.",
        "sv": "Det är dags att byta skift.",
        "tr": "Vardiyayı değiştirme zamanı geldi.",
        "uk": "Час змінювати зміну.",
        "vi": "Đến giờ đổi ca rồi.",
        "yue": "到換更嘅時間喇。",
        "zh-Hans": "到换班时间了。"
      },
