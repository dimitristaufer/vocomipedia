  "sentences": [
    {
      "target": "우리는 산길을 따라 천천히 걸었어요.",
      "reading": "urineun sangkkireul ttara cheoncheonhi georeosseoyo.",
      "translations": {
        "en": "We walked slowly along the mountain path.",
        "ko": "우리는 산길을 따라 천천히 걸었어요.",
        "ipa": "urineun sangkkireul ttara cheoncheonhi georeosseoyo.",
        "ar": "مشينا ببطء على طول الطريق الجبلي.",
        "cs": "Šli jsme pomalu po horské stezce.",
        "da": "Vi gik langsomt langs bjergstien.",
        "de": "Wir gingen langsam den Bergpfad entlang.",
        "el": "Περπατήσαμε αργά κατά μήκος του ορεινού μονοπατιού.",
        "es": "Caminamos despacio por el sendero de la montaña.",
        "fi": "Kävelimme hitaasti vuoristopolulla.",
        "fr": "Nous avons marché lentement le long du sentier de montagne.",
        "he": "הלכנו לאט לאורך שביל ההר.",
        "hi": "हम पहाड़ी रास्ते पर धीरे-धीरे चले।",
        "hu": "Lassan sétáltunk a hegyi ösvényen.",
        "id": "Kami berjalan pelan di sepanjang jalan setapak di gunung.",
        "it": "Abbiamo camminato lentamente lungo il sentiero di montagna.",
        "ja": "私たちは山道をゆっくり歩きました。",
        "nb": "Vi gikk sakte langs fjellstien.",
        "nl": "We liepen langzaam over het bergpad.",
        "pl": "Szliśmy powoli górską ścieżką.",
        "pt": "Nós caminhamos devagar pela trilha da montanha.",
        "ro": "Am mers încet pe poteca de munte.",
        "ru": "Мы медленно шли по горной тропе.",
        "sv": "Vi gick långsamt längs bergsstigen.",
        "tr": "Dağ patikası boyunca yavaşça yürüdük.",
        "uk": "Ми повільно йшли гірською стежкою.",
        "vi": "Chúng tôi đi chậm dọc theo con đường mòn trên núi.",
        "yue": "我哋沿住山路慢慢行。",
        "zh-Hans": "我们沿着山路慢慢走。"
      },
