    {
      "target": "그는 다섯 번 연속으로 성공했어요.",
      "reading": "Geuneun daseot beon yeonsok-euro seonggonghaesseoyo.",
      "translations": {
        "en": "He succeeded five times in a row.",
        "ko": "그는 다섯 번 연속으로 성공했어요.",
        "ipa": "Geuneun daseot beon yeonsok-euro seonggonghaesseoyo.",
        "ar": "نجح خمس مرات متتالية.",
        "cs": "Podařilo se mu to pětkrát po sobě.",
        "da": "Han lykkedes fem gange i træk.",
        "de": "Er war fünfmal in Folge erfolgreich.",
        "el": "Τα κατάφερε πέντε φορές στη σειρά.",
        "es": "Tuvo éxito cinco veces seguidas.",
        "fi": "Hän onnistui viisi kertaa peräkkäin.",
        "fr": "Il a réussi cinq fois d'affilée.",
        "he": "הוא הצליח חמש פעמים ברצף.",
        "hi": "उसने पाँच बार लगातार सफलता पाई।",
        "hu": "Ötször egymás után sikerült neki.",
        "id": "Dia berhasil lima kali berturut-turut.",
        "it": "Ci è riuscito cinque volte di fila.",
        "ja": "彼は五回連続で成功しました。",
        "nb": "Han lyktes fem ganger på rad.",
        "nl": "Hij slaagde vijf keer achter elkaar.",
        "pl": "Udało mu się pięć razy z rzędu.",
        "pt": "Ele conseguiu cinco vezes seguidas.",
        "ro": "A reușit de cinci ori la rând.",
        "ru": "У него получилось пять раз подряд.",
        "sv": "Han lyckades fem gånger i rad.",
        "tr": "Beş kez üst üste başarılı oldu.",
        "uk": "Він п'ять разів поспіль досяг успіху.",
        "vi": "Anh ấy thành công năm lần liên tiếp.",
        "yue": "佢連續成功咗五次。",
        "zh-Hans": "他连续成功了五次。"
      },
