  "sentences": [
    {
      "target": "비가 사흘 연속 왔어요.",
      "reading": "Biga saheul yeonsok wasseoyo.",
      "translations": {
        "en": "It rained for three days in a row.",
        "ko": "비가 사흘 연속 왔어요.",
        "ipa": "Biga saheul yeonsok wasseoyo.",
        "ar": "مطر ثلاثة أيام متتالية.",
        "cs": "Pršelo tři dny po sobě.",
        "da": "Det regnede i tre dage i træk.",
        "de": "Es regnete drei Tage hintereinander.",
        "el": "Έβρεχε τρεις μέρες στη σειρά.",
        "es": "Llovió durante tres días seguidos.",
        "fi": "Satoi kolme päivää peräkkäin.",
        "fr": "Il a plu trois jours d'affilée.",
        "he": "ירד גשם שלושה ימים ברצף.",
        "hi": "तीन दिन लगातार बारिश हुई।",
        "hu": "Három napig egymás után esett az eső.",
        "id": "Hujan turun tiga hari berturut-turut.",
        "it": "Ha piovuto per tre giorni di fila.",
        "ja": "雨が三日続けて降りました。",
        "nb": "Det regnet i tre dager på rad.",
        "nl": "Het regende drie dagen achter elkaar.",
        "pl": "Padało przez trzy dni z rzędu.",
        "pt": "Choveu durante três dias seguidos.",
        "ro": "A plouat trei zile la rând.",
        "ru": "Три дня подряд шёл дождь.",
        "sv": "Det regnade tre dagar i rad.",
        "tr": "Üç gün üst üste yağmur yağdı.",
        "uk": "Три дні поспіль ішов дощ.",
        "vi": "Trời mưa ba ngày liên tiếp.",
        "yue": "雨連續落咗三日。",
        "zh-Hans": "雨连续下了三天。"
      },
