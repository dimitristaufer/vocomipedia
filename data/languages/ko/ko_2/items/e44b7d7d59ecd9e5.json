  "sentences": [
    {
      "target": "수화기를 들고 엄마에게 전화를 걸었어요.",
      "reading": "suhwagireul deulgo eommagege jeonhwareul georeosseoyo.",
      "translations": {
        "en": "I picked up the receiver and called my mom.",
        "ko": "수화기를 들고 엄마에게 전화를 걸었어요.",
        "ipa": "suhwagireul deulgo eommagege jeonhwareul georeosseoyo.",
        "ar": "رفعتُ السماعة واتصلتُ بأمي.",
        "cs": "Zvedl jsem sluchátko a zavolal jsem mámě.",
        "da": "Jeg tog røret og ringede til min mor.",
        "de": "Ich nahm den Hörer ab und rief meine Mutter an.",
        "el": "Σήκωσα το ακουστικό και τηλεφώνησα στη μαμά μου.",
        "es": "Levanté el auricular y llamé a mi mamá.",
        "fi": "Nostin luurin ja soitin äidilleni.",
        "fr": "J’ai décroché le combiné et j’ai appelé ma mère.",
        "he": "הרמתי את השפופרת והתקשרתי לאמא שלי.",
        "hi": "मैंने रिसीवर उठाया और अपनी माँ को फोन किया।",
        "hu": "Felemeltem a kagylót, és felhívtam anyát.",
        "id": "Saya mengangkat gagang telepon dan menelepon ibu saya.",
        "it": "Ho alzato la cornetta e ho chiamato mia madre.",
        "ja": "受話器を取って母に電話をかけました。",
        "nb": "Jeg løftet av røret og ringte til mamma.",
        "nl": "Ik nam de hoorn op en belde mijn moeder.",
        "pl": "Podniosłem słuchawkę i zadzwoniłem do mamy.",
        "pt": "Peguei o fone e liguei para a minha mãe.",
        "ro": "Am ridicat receptorul și am sunat-o pe mama.",
        "ru": "Я поднял трубку и позвонил маме.",
        "sv": "Jag lyfte luren och ringde till min mamma.",
        "tr": "Ahizeyi kaldırıp annemi aradım.",
        "uk": "Я підняв слухавку й подзвонив мамі.",
        "vi": "Tôi nhấc ống nghe lên và gọi cho mẹ tôi.",
        "yue": "我拎起電話筒，打畀媽媽。",
        "zh-Hans": "我拿起听筒给妈妈打了电话。"
      },
