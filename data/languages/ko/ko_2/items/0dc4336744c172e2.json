  "sentences": [
    {
      "target": "오늘은 자연현상을 공부해요.",
      "reading": "oneureun jayeonhyeonsangeul gongbuhaeyo.",
      "translations": {
        "en": "Today, I study natural phenomena.",
        "ko": "오늘은 자연현상을 공부해요.",
        "ipa": "oneureun jayeonhyeonsangeul gongbuhaeyo.",
        "ar": "اليوم أدرس الظواهر الطبيعية.",
        "cs": "Dnes se učím o přírodních jevech.",
        "da": "I dag lærer jeg om naturfænomener.",
        "de": "Heute lerne ich etwas über Naturphänomene.",
        "el": "Σήμερα μαθαίνω για τα φυσικά φαινόμενα.",
        "es": "Hoy estudio los fenómenos naturales.",
        "fi": "Opiskelen tänään luonnonilmiöitä.",
        "fr": "Aujourd'hui, j'étudie les phénomènes naturels.",
        "he": "היום אני לומד על תופעות טבע.",
        "hi": "आज मैं प्राकृतिक घटनाओं के बारे में पढ़ता हूँ।",
        "hu": "Ma a természeti jelenségeket tanulom.",
        "id": "Hari ini saya belajar tentang fenomena alam.",
        "it": "Oggi studio i fenomeni naturali.",
        "ja": "今日は自然現象を勉強します。",
        "nb": "I dag lærer jeg om naturfenomener.",
        "nl": "Vandaag leer ik over natuurverschijnselen.",
        "pl": "Dziś uczę się o zjawiskach naturalnych.",
        "pt": "Hoje eu estudo fenômenos naturais.",
        "ro": "Astăzi învăț despre fenomene naturale.",
        "ru": "Сегодня я изучаю природные явления.",
        "sv": "I dag lär jag mig om naturfenomen.",
        "tr": "Bugün doğal olayları öğreniyorum.",
        "uk": "Сьогодні я вивчаю природні явища.",
        "vi": "Hôm nay tôi học về các hiện tượng tự nhiên.",
        "yue": "今日我學自然現象。",
        "zh-Hans": "今天我学习自然现象。"
      },
