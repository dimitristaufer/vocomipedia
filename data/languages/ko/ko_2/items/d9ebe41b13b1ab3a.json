  "sentences": [
    {
      "target": "이번 달 중순에 여행을 가요.",
      "reading": "ibeon dal jungsune yeohaengeul gayo.",
      "translations": {
        "en": "We're going on a trip in the middle of this month.",
        "ko": "이번 달 중순에 여행을 가요.",
        "ipa": "ibeon dal jungsune yeohaengeul gayo.",
        "ar": "سنذهب في رحلة في منتصف هذا الشهر.",
        "cs": "Pojedeme na výlet v polovině tohoto měsíce.",
        "da": "Vi tager på en rejse midt på denne måned.",
        "de": "Wir fahren Mitte dieses Monats auf eine Reise.",
        "el": "Θα πάμε ταξίδι στα μέσα αυτού του μήνα.",
        "es": "Nos iremos de viaje a mediados de este mes.",
        "fi": "Lähdemme matkalle tämän kuun puolivälissä.",
        "fr": "Nous partirons en voyage à la mi-mois.",
        "he": "ניסע לטיול באמצע החודש הזה.",
        "hi": "हम इस महीने के मध्य में यात्रा पर जाएंगे।",
        "hu": "A hónap közepén megyünk kirándulni.",
        "id": "Kami akan pergi dalam perjalanan pada pertengahan bulan ini.",
        "it": "Andremo in viaggio a metà di questo mese.",
        "ja": "今月の中旬に旅行に行きます。",
        "nb": "Vi skal på tur i midten av denne måneden.",
        "nl": "We gaan midden deze maand op reis.",
        "pl": "Wyruszamy w podróż w połowie tego miesiąca.",
        "pt": "Vamos fazer uma viagem no meio deste mês.",
        "ro": "Vom pleca într-o excursie la mijlocul acestei luni.",
        "ru": "Мы поедем в поездку в середине этого месяца.",
        "sv": "Vi ska resa i mitten av den här månaden.",
        "tr": "Bu ayın ortasında bir geziye çıkacağız.",
        "uk": "Ми поїдемо в подорож у середині цього місяця.",
        "vi": "Chúng tôi sẽ đi du lịch vào giữa tháng này.",
        "yue": "我哋今個月中旬會去旅行。",
        "zh-Hans": "我们这个月中旬要去旅行。"
      },
