  "sentences": [
    {
      "target": "우리는 역 앞 술집에서 만났어요.",
      "reading": "urineun yeok ap suljibeseo mannasseoyo.",
      "translations": {
        "en": "We met at a bar near the station.",
        "ko": "우리는 역 앞 술집에서 만났어요.",
        "ipa": "urineun yeok ap suljibeseo mannasseoyo.",
        "ar": "التقينا في حانة قرب المحطة.",
        "cs": "Potkali jsme se v baru poblíž nádraží.",
        "da": "Vi mødtes på en bar nær stationen.",
        "de": "Wir haben uns in einer Bar am Bahnhof getroffen.",
        "el": "Συναντηθήκαμε σε ένα μπαρ κοντά στον σταθμό.",
        "es": "Nos encontramos en un bar cerca de la estación.",
        "fi": "Tapasimme aseman lähellä olevassa baarissa.",
        "fr": "Nous nous sommes rencontrés dans un bar près de la gare.",
        "he": "נפגשנו בבר ליד התחנה.",
        "hi": "हम स्टेशन के पास एक बार में मिले थे।",
        "hu": "Az állomás melletti bárban találkoztunk.",
        "id": "Kami bertemu di bar dekat stasiun.",
        "it": "Ci siamo incontrati in un bar vicino alla stazione.",
        "ja": "私たちは駅前のバーで会いました。",
        "nb": "Vi møttes på en bar nær stasjonen.",
        "nl": "We ontmoetten elkaar in een café bij het station.",
        "pl": "Spotkaliśmy się w barze niedaleko dworca.",
        "pt": "Nós nos encontramos em um bar perto da estação.",
        "ro": "Ne-am întâlnit la un bar lângă gară.",
        "ru": "Мы встретились в баре возле станции.",
        "sv": "Vi träffades på en bar nära stationen.",
        "tr": "İstasyona yakın bir barda buluştuk.",
        "uk": "Ми зустрілися в барі біля вокзалу.",
        "vi": "Chúng tôi đã gặp nhau ở một quán bar gần ga.",
        "yue": "我哋喺車站附近嘅酒吧見面。",
        "zh-Hans": "我们在车站附近的酒吧见面。"
      },
