    "ar": [
      "عاد المريض إلى الحياة من جديد.",
      "انتعش الجو أخيرًا.",
      "عندما توقفت الأمطار، عادت القرية إلى الحياة.",
      "عندما جاء الربيع، عاد الحديقة إلى الحياة."
    ],
    "cs": [
      "Pacient zase ožil.",
      "Po dlouhé době atmosféra konečně ožila.",
      "Když déšť přestal, vesnice ožila.",
      "Když přišlo jaro, zahrada ožila."
    ],
    "da": [
      "Patienten kom til live igen.",
      "Stemningen kom endelig til live.",
      "Da regnen stoppede, kom landsbyen til live.",
      "Da foråret kom, kom haven til live."
    ],
    "de": [
      "Der Patient ist wieder zum Leben erwacht.",
      "Die Stimmung ist endlich aufgekommen.",
      "Als der Regen aufhörte, erwachte das Dorf zum Leben.",
      "Als der Frühling kam, erwachte der Garten zum Leben."
    ],
    "el": [
      "Ο ασθενής επανήλθε στη ζωή.",
      "Η ατμόσφαιρα επιτέλους ζωντάνεψε.",
      "Όταν σταμάτησε η βροχή, το χωριό ζωντάνεψε.",
      "Όταν ήρθε η άνοιξη, ο κήπος ζωντάνεψε."
    ],
    "es": [
      "El paciente volvió a la vida.",
      "Por fin, el ambiente se animó.",
      "Cuando dejó de llover, el pueblo cobró vida.",
      "Cuando llegó la primavera, el jardín cobró vida."
    ],
    "fi": [
      "Potilas palasi jälleen eloon.",
      "Tunnelma heräsi vihdoin eloon.",
      "Kun sade loppui, kylä heräsi eloon.",
      "Kun kevät tuli, puutarha heräsi eloon."
    ],
    "fr": [
      "Le patient est revenu à la vie.",
      "L'ambiance s'est enfin animée.",
      "Quand la pluie s'est arrêtée, le village s'est animé.",
      "Quand le printemps est arrivé, le jardin s'est animé."
    ],
    "he": [
      "החולה חזר לחיים.",
      "האווירה סוף סוף התעוררה לחיים.",
      "כשהגשם פסק, הכפר התעורר לחיים.",
      "כשהאביב הגיע, הגינה התעוררה לחיים."
    ],
    "hi": [
      "मरीज़ फिर से ज़िंदा हो गया।",
      "आखिरकार माहौल में जान आ गई।",
      "बारिश रुकते ही गाँव में जान आ गई।",
      "बसंत आने पर बाग में जान आ गई।"
    ],
    "hu": [
      "A beteg újra életre kelt.",
      "Végre felélénkült a hangulat.",
      "Amikor elállt az eső, a falu életre kelt.",
      "Amikor megjött a tavasz, a kert életre kelt."
    ],
    "id": [
      "Pasien itu hidup lagi.",
      "Suasana akhirnya jadi hidup.",
      "Saat hujan berhenti, desa itu jadi hidup.",
      "Saat musim semi tiba, taman itu jadi hidup."
    ],
    "it": [
      "Il paziente è tornato in vita.",
      "L'atmosfera si è finalmente animata.",
      "Quando è smesso di piovere, il villaggio si è animato.",
      "Quando è arrivata la primavera, il giardino si è animato."
    ],
    "ja": [
      "患者は再び生き返った。",
      "久しぶりに雰囲気が活気づいた。",
      "雨がやむと、村に活気が戻った。",
      "春が来ると、庭が生き生きとしてきた。"
    ],
    "nb": [
      "Pasienten kom til live igjen.",
      "Stemningen kom endelig til live.",
      "Da regnet stoppet, kom landsbyen til live.",
      "Da våren kom, kom hagen til live."
    ],
    "nl": [
      "De patiënt kwam weer tot leven.",
      "De sfeer kwam eindelijk tot leven.",
      "Toen de regen ophield, kwam het dorp tot leven.",
      "Toen de lente kwam, kwam de tuin tot leven."
    ],
    "pl": [
      "Pacjent znowu ożył.",
      "Atmosfera w końcu ożyła.",
      "Kiedy deszcz przestał padać, wieś ożyła.",
      "Kiedy przyszła wiosna, ogród ożył."
    ],
    "pt": [
      "O paciente voltou à vida.",
      "O ambiente finalmente ganhou vida.",
      "Quando a chuva parou, a aldeia ganhou vida.",
      "Quando a primavera chegou, o jardim ganhou vida."
    ],
    "ro": [
      "Pacientul a revenit la viață.",
      "Atmosfera s-a animat în sfârșit.",
      "Când s-a oprit ploaia, satul a prins viață.",
      "Când a venit primăvara, grădina a prins viață."
    ],
    "ru": [
      "Пациент снова ожил.",
      "Атмосфера наконец оживилась.",
      "Когда дождь закончился, деревня ожила.",
      "Когда пришла весна, сад ожил."
    ],
    "sv": [
      "Patienten kom tillbaka till livet.",
      "Stämningen kom äntligen igång.",
      "När regnet slutade vaknade byn till liv.",
      "När våren kom vaknade trädgården till liv."
    ],
    "tr": [
      "Hasta yeniden hayata döndü.",
      "Hava sonunda canlandı.",
      "Yağmur dinince köy canlandı.",
      "İlkbahar gelince bahçe canlandı."
    ],
    "uk": [
      "Пацієнт знову ожив.",
      "Атмосфера нарешті ожила.",
      "Коли дощ припинився, село ожило.",
      "Коли настала весна, сад ожив."
    ],
    "vi": [
      "Bệnh nhân sống lại.",
      "Không khí cuối cùng cũng sôi nổi lên.",
      "Khi mưa tạnh, ngôi làng trở nên nhộn nhịp.",
      "Khi xuân đến, khu vườn như sống dậy."
    ],
    "yue": [
      "病人又活返。",
      "氣氛終於熱鬧返。",
      "雨停咗之後，條村活返。",
      "春天嚟咗，個花園充滿生氣。"
    ],
    "zh-Hans": [
