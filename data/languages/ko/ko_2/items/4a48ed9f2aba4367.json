  "sentences": [
    {
      "target": "제 손이 저 높은 칸까지 미치지 않아요.",
      "reading": "je soni jeo nopeun kankkaji michiji anayo.",
      "translations": {
        "en": "My hand doesn't reach that high shelf.",
        "ko": "제 손이 저 높은 칸까지 미치지 않아요.",
        "ipa": "je soni jeo nopeun kankkaji michiji anayo.",
        "ar": "يدي لا تصل إلى ذلك الرف العالي.",
        "cs": "Moje ruka nedosáhne na tu vysokou polici.",
        "da": "Min hånd kan ikke nå den høje hylde.",
        "de": "Meine Hand reicht nicht bis zu dem hohen Regal.",
        "el": "Το χέρι μου δεν φτάνει ως το ψηλό ράφι.",
        "es": "Mi mano no llega a ese estante alto.",
        "fi": "Käteni ei ylety tuolle korkealle hyllylle.",
        "fr": "Ma main n'atteint pas cette étagère en hauteur.",
        "he": "היד שלי לא מגיעה למדף הגבוה הזה.",
        "hi": "मेरा हाथ उस ऊँची शेल्फ़ तक नहीं पहुँचता।",
        "hu": "A kezem nem ér el addig a magas polcig.",
        "id": "Tangan saya tidak sampai ke rak yang tinggi itu.",
        "it": "La mia mano non arriva a quel ripiano in alto.",
        "ja": "私の手はあの高い棚に届きません。",
        "nb": "Hånden min når ikke opp til den høye hylla.",
        "nl": "Mijn hand reikt niet tot dat hoge schap.",
        "pl": "Moja ręka nie sięga do tej wysokiej półki.",
        "pt": "Minha mão não alcança aquela prateleira alta.",
        "ro": "Mâna mea nu ajunge la raftul acela înalt.",
        "ru": "Моя рука не дотягивается до той высокой полки.",
        "sv": "Min hand når inte upp till den höga hyllan.",
        "tr": "Elim o yüksek rafa uzanmıyor.",
        "uk": "Моя рука не дістає до тієї високої полиці.",
        "vi": "Tay tôi không với tới cái kệ cao đó.",
        "yue": "我隻手攞唔到咁高嗰個架。",
        "zh-Hans": "我的手够不到那么高的架子。"
      },
