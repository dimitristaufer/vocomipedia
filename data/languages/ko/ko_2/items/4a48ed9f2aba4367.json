    {
      "target": "햇빛이 창가까지 미쳤어요.",
      "reading": "haetbiti changgakkaji michyeosseoyo.",
      "translations": {
        "en": "The sunlight reached the window.",
        "ko": "햇빛이 창가까지 미쳤어요.",
        "ipa": "haetbiti changgakkaji michyeosseoyo.",
        "ar": "وصل ضوء الشمس إلى النافذة.",
        "cs": "Sluneční světlo dosáhlo k oknu.",
        "da": "Sollyset nåede hen til vinduet.",
        "de": "Das Sonnenlicht reichte bis zum Fenster.",
        "el": "Το φως του ήλιου έφτασε ως το παράθυρο.",
        "es": "La luz del sol llegó hasta la ventana.",
        "fi": "Auringonvalo ylsi ikkunalle asti.",
        "fr": "La lumière du soleil est arrivée jusqu'à la fenêtre.",
        "he": "אור השמש הגיע עד החלון.",
        "hi": "धूप खिड़की तक पहुँच गई।",
        "hu": "A napfény elért az ablakig.",
        "id": "Cahaya matahari sampai ke jendela.",
        "it": "La luce del sole è arrivata fino alla finestra.",
        "ja": "日差しが窓辺まで届きました。",
        "nb": "Sollyset nådde bort til vinduet.",
        "nl": "Het zonlicht reikte tot het raam.",
        "pl": "Światło słoneczne sięgnęło aż do okna.",
        "pt": "A luz do sol chegou até a janela.",
        "ro": "Lumina soarelui a ajuns până la fereastră.",
        "ru": "Солнечный свет дошёл до окна.",
        "sv": "Solljuset nådde fram till fönstret.",
        "tr": "Güneş ışığı pencereye kadar ulaştı.",
        "uk": "Сонячне світло дійшло до вікна.",
        "vi": "Ánh nắng đã chiếu tới cửa sổ.",
        "yue": "陽光照到窗邊。",
        "zh-Hans": "阳光照到了窗边。"
      },
