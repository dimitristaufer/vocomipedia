  "sentences": [
    {
      "target": "검사 결과를 듣고 안심했어요.",
      "reading": "geomsa gyeolgwareul deutgo ansimhesseoyo.",
      "translations": {
        "en": "I felt relieved after hearing the test results.",
        "ko": "검사 결과를 듣고 안심했어요.",
        "ipa": "geomsa gyeolgwareul deutgo ansimhesseoyo.",
        "ar": "ارتحتُ بعد سماع نتائج الفحص.",
        "cs": "Když jsem slyšel výsledky vyšetření, ulevilo se mi.",
        "da": "Jeg blev lettet, da jeg hørte prøveresultaterne.",
        "de": "Ich war erleichtert, nachdem ich die Testergebnisse gehört hatte.",
        "el": "Ανακουφίστηκα όταν άκουσα τα αποτελέσματα των εξετάσεων.",
        "es": "Me sentí aliviado al oír los resultados de la prueba.",
        "fi": "Huojennuin, kun kuulin testitulokset.",
        "fr": "J’ai été soulagé en apprenant les résultats du test.",
        "he": "הרגשתי הקלה אחרי ששמעתי את תוצאות הבדיקה.",
        "hi": "जांच के नतीजे सुनकर मुझे राहत मिली।",
        "hu": "Megkönnyebbültem, amikor meghallottam a vizsgálati eredményeket.",
        "id": "Saya merasa lega setelah mendengar hasil tes.",
        "it": "Mi sono sentito sollevato dopo aver sentito i risultati dell'esame.",
        "ja": "検査の結果を聞いて安心しました。",
        "nb": "Jeg ble lettet da jeg hørte prøvesvarene.",
        "nl": "Ik was opgelucht toen ik de testresultaten hoorde.",
        "pl": "Poczułem ulgę, gdy usłyszałem wyniki badania.",
        "pt": "Fiquei aliviado ao ouvir os resultados do exame.",
        "ro": "M-am simțit mai liniștit după ce am auzit rezultatele testului.",
        "ru": "Я почувствовал облегчение, когда услышал результаты анализа.",
        "sv": "Jag blev lättad när jag fick höra provresultaten.",
        "tr": "Test sonuçlarını duyunca rahatladım.",
        "uk": "Я відчув полегшення, коли почув результати аналізу.",
        "vi": "Tôi thấy yên tâm sau khi nghe kết quả xét nghiệm.",
        "yue": "聽到檢查結果之後，我放心晒。",
        "zh-Hans": "听到检查结果后，我放心了。"
      },
