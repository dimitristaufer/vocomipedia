  "sentences": [
    {
      "target": "그는 신세대 감각이 있어요.",
      "reading": "geuneun sinsedae gamgagi isseoyo.",
      "translations": {
        "en": "He has a new-generation sense of style.",
        "ko": "그는 신세대 감각이 있어요.",
        "ipa": "geuneun sinsedae gamgagi isseoyo.",
        "ar": "لديه إحساس عصري بالأناقة.",
        "cs": "Má moderní cit pro styl.",
        "da": "Han har en moderne sans for stil.",
        "de": "Er hat ein Gespür für den Stil der neuen Generation.",
        "el": "Έχει νεανικό γούστο στο στυλ.",
        "es": "Tiene un estilo muy de la nueva generación.",
        "fi": "Hänellä on moderni tyylitaju.",
        "fr": "Il a le sens du style de la nouvelle génération.",
        "he": "יש לו חוש סטייל של הדור החדש.",
        "hi": "उसमें नई पीढ़ी वाली समझ है।",
        "hu": "Moderna stílusérzéke van.",
        "id": "Dia punya selera gaya yang modern.",
        "it": "Ha un senso dello stile da nuova generazione.",
        "ja": "彼は新しい世代の感覚を持っています。",
        "nb": "Han har en moderne sans for stil.",
        "nl": "Hij heeft gevoel voor de stijl van de nieuwe generatie.",
        "pl": "Ma nowoczesne wyczucie stylu.",
        "pt": "Ele tem um estilo bem da nova geração.",
        "ro": "Are un simț modern al stilului.",
        "ru": "У него современное чувство стиля.",
        "sv": "Han har en modern känsla för stil.",
        "tr": "Onun yeni nesil bir tarz anlayışı var.",
        "uk": "Він має сучасне відчуття стилю.",
        "vi": "Anh ấy có gu rất hợp với thế hệ mới.",
        "yue": "佢有新世代嘅品味。",
        "zh-Hans": "他有新世代的时尚感。"
      },
