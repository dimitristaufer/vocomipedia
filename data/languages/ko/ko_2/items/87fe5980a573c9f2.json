  "sentences": [
    {
      "target": "길에서 친구를 우연히 만났어요.",
      "reading": "gil-eseo chingureul uyeonhi mannasseoyo.",
      "translations": {
        "en": "I ran into a friend by chance on the street.",
        "ko": "길에서 친구를 우연히 만났어요.",
        "ipa": "gil-eseo chingureul uyeonhi mannasseoyo.",
        "ar": "صادفت صديقًا في الشارع بالصدفة.",
        "cs": "Na ulici jsem náhodou potkal kamaráda.",
        "da": "Jeg mødte en ven tilfældigt på gaden.",
        "de": "Ich habe auf der Straße zufällig einen Freund getroffen.",
        "el": "Συνάντησα έναν φίλο τυχαία στον δρόμο.",
        "es": "Me encontré con un amigo por casualidad en la calle.",
        "fi": "Tapasin ystävän sattumalta kadulla.",
        "fr": "J'ai croisé un ami par hasard dans la rue.",
        "he": "פגשתי חבר במקרה ברחוב.",
        "hi": "मैं सड़क पर संयोग से एक दोस्त से मिला।",
        "hu": "Az utcán véletlenül találkoztam egy barátommal.",
        "id": "Saya bertemu teman di jalan secara tidak sengaja.",
        "it": "Ho incontrato un amico per caso in strada.",
        "ja": "道で友だちに偶然会いました。",
        "nb": "Jeg møtte en venn tilfeldig på gaten.",
        "nl": "Ik kwam een vriend toevallig op straat tegen.",
        "pl": "Przypadkiem spotkałem na ulicy przyjaciela.",
        "pt": "Encontrei um amigo por acaso na rua.",
        "ro": "Am întâlnit un prieten din întâmplare pe stradă.",
        "ru": "Я случайно встретил друга на улице.",
        "sv": "Jag träffade en vän av en slump på gatan.",
        "tr": "Sokakta bir arkadaşıma tesadüfen rastladım.",
        "uk": "Я випадково зустрів друга на вулиці.",
        "vi": "Tôi tình cờ gặp một người bạn trên đường.",
        "yue": "我喺街上偶然撞到一個朋友。",
        "zh-Hans": "我在街上偶然遇到了一个朋友。"
      },
