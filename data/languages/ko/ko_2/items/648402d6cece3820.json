  "sentences": [
    {
      "target": "무더위 때문에 밖에 나가기가 싫어요.",
      "reading": "무더위 때문에 바께 나가기가 실어요.",
      "translations": {
        "en": "I don’t want to go outside because of the heat.",
        "ko": "무더위 때문에 밖에 나가기가 싫어요.",
        "ipa": "무더위 때문에 바께 나가기가 실어요.",
        "ar": "لا أريد أن أخرج بسبب الحر الشديد.",
        "cs": "Kvůli vedru se mi nechce ven.",
        "da": "Jeg har ikke lyst til at gå udenfor på grund af heden.",
        "de": "Wegen der Hitze will ich nicht nach draußen gehen.",
        "el": "Δεν θέλω να βγω έξω εξαιτίας της πολλής ζέστης.",
        "es": "No quiero salir por el calor.",
        "fi": "En halua mennä ulos helteen takia.",
        "fr": "Je n’ai pas envie de sortir à cause de la chaleur.",
        "he": "לא בא לי לצאת בגלל החום הכבד.",
        "hi": "गर्मी की वजह से मेरा बाहर जाने का मन नहीं है।",
        "hu": "A hőség miatt nincs kedvem kimenni.",
        "id": "Karena cuaca panas, saya tidak mau keluar.",
        "it": "Non ho voglia di uscire per il caldo.",
        "ja": "暑いので外に出たくないです。",
        "nb": "Jeg har ikke lyst til å gå ut på grunn av varmen.",
        "nl": "Ik heb geen zin om naar buiten te gaan vanwege de hitte.",
        "pl": "Nie chcę wychodzić z powodu upału.",
        "pt": "Não quero sair por causa do calor.",
        "ro": "Nu vreau să ies din cauza căldurii.",
        "ru": "Из-за жары мне не хочется выходить на улицу.",
        "sv": "Jag vill inte gå ut på grund av värmen.",
        "tr": "Sıcaktan dolayı dışarı çıkmak istemiyorum.",
        "uk": "Через спеку мені не хочеться виходити надвір.",
        "vi": "Vì trời nóng quá nên tôi không muốn ra ngoài.",
        "yue": "因為好熱，我唔想出街。",
        "zh-Hans": "因为天气太热，我不想出门。"
      },
