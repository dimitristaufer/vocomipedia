  "sentences": [
    {
      "target": "저는 다른 의견도 존중해요.",
      "reading": "jeoneun dareun uigyeondo jonjunghaeyo.",
      "translations": {
        "en": "I respect other opinions too.",
        "ko": "저는 다른 의견도 존중해요.",
        "ipa": "jeoneun dareun uigyeondo jonjunghaeyo.",
        "ar": "أنا أحترم الآراء الأخرى أيضًا.",
        "cs": "Respektuji i jiné názory.",
        "da": "Jeg respekterer også andre meninger.",
        "de": "Ich respektiere auch andere Meinungen.",
        "el": "Σέβομαι και τις άλλες απόψεις.",
        "es": "Yo también respeto otras opiniones.",
        "fi": "Kunnioitan myös muita mielipiteitä.",
        "fr": "Je respecte aussi les autres avis.",
        "he": "אני מכבד גם דעות אחרות.",
        "hi": "मैं दूसरे विचारों का भी सम्मान करता हूँ।",
        "hu": "Más véleményeket is tisztelek.",
        "id": "Saya juga menghormati pendapat lain.",
        "it": "Rispetto anche le opinioni degli altri.",
        "ja": "私はほかの意見も尊重します。",
        "nb": "Jeg respekterer også andre meninger.",
        "nl": "Ik respecteer ook andere meningen.",
        "pl": "Szanuję też inne opinie.",
        "pt": "Eu também respeito outras opiniões.",
        "ro": "Respect și alte opinii.",
        "ru": "Я тоже уважаю другие мнения.",
        "sv": "Jag respekterar också andra åsikter.",
        "tr": "Ben de diğer görüşlere saygı duyarım.",
        "uk": "Я теж поважаю інші думки.",
        "vi": "Tôi cũng tôn trọng ý kiến khác.",
        "yue": "我都尊重其他意見。",
        "zh-Hans": "我也尊重其他意见。"
      },
