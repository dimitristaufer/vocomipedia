    {
      "target": "저는 잠자기 전에 기도를 해요.",
      "reading": "Jeoneun jamjagi jeone gidoreul haeyo.",
      "translations": {
        "en": "I pray before going to sleep.",
        "ko": "저는 잠자기 전에 기도를 해요.",
        "ipa": "Jeoneun jamjagi jeone gidoreul haeyo.",
        "ar": "أصلي قبل أن أنام.",
        "cs": "Modlím se před spaním.",
        "da": "Jeg beder, før jeg går i seng.",
        "de": "Ich bete vor dem Schlafengehen.",
        "el": "Προσεύχομαι πριν κοιμηθώ.",
        "es": "Rezo antes de dormir.",
        "fi": "Rukoilen ennen nukkumaanmenoa.",
        "fr": "Je prie avant de dormir.",
        "he": "אני מתפלל לפני השינה.",
        "hi": "मैं सोने से पहले प्रार्थना करता हूँ।",
        "hu": "Imádkozom, mielőtt lefekszem aludni.",
        "id": "Saya berdoa sebelum tidur.",
        "it": "Pregho prima di dormire.",
        "ja": "私は寝る前にお祈りをします。",
        "nb": "Jeg ber før jeg legger meg.",
        "nl": "Ik bid voordat ik ga slapen.",
        "pl": "Modlę się przed snem.",
        "pt": "Eu rezo antes de dormir.",
        "ro": "Mă rog înainte de culcare.",
        "ru": "Я молюсь перед сном.",
        "sv": "Jag ber innan jag somnar.",
        "tr": "Uyumadan önce dua ederim.",
        "uk": "Я молюся перед сном.",
        "vi": "Tôi cầu nguyện trước khi đi ngủ.",
        "yue": "我瞓覺前會祈禱。",
        "zh-Hans": "我睡觉前会祷告。"
      },
