  "sentences": [
    {
      "target": "웃어른께 먼저 인사드렸어요.",
      "reading": "useoreunkke meonjeo insadryeosseoyo.",
      "translations": {
        "en": "I greeted my elder first.",
        "ko": "웃어른께 먼저 인사드렸어요.",
        "ipa": "useoreunkke meonjeo insadryeosseoyo.",
        "ar": "حييتُ الكبير أولًا.",
        "cs": "Nejprve jsem pozdravil staršího.",
        "da": "Jeg hilste først på den ældre.",
        "de": "Ich habe zuerst die Älteren begrüßt.",
        "el": "Χαιρέτησα πρώτα τους μεγαλύτερους.",
        "es": "Saludé primero a mis mayores.",
        "fi": "Tervehdin ensin vanhempaa ihmistä.",
        "fr": "J'ai d'abord salué mon aîné.",
        "he": "ברכתי קודם את המבוגר ממני.",
        "hi": "मैंने पहले बड़ों को नमस्ते किया।",
        "hu": "Először az idősebbet köszöntöttem.",
        "id": "Saya lebih dulu memberi salam kepada orang yang lebih tua.",
        "it": "Ho salutato prima l'anziano.",
        "ja": "まず年長者にあいさつしました。",
        "nb": "Jeg hilste først på de eldre.",
        "nl": "Ik begroette eerst de oudere.",
        "pl": "Najpierw przywitałem starszego.",
        "pt": "Cumprimentei primeiro o mais velho.",
        "ro": "L-am salutat mai întâi pe cel mai în vârstă.",
        "ru": "Сначала я поздоровался со старшим.",
        "sv": "Jag hälsade först på den äldre.",
        "tr": "Önce büyüklerimi selamladım.",
        "uk": "Спочатку я привітав старшого.",
        "vi": "Tôi chào người lớn tuổi trước.",
        "yue": "我先同長輩打招呼。",
        "zh-Hans": "我先向长辈问了好。"
      },
