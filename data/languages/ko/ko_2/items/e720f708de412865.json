  "sentences": [
    {
      "target": "그 소식은 큰 충격이었어요.",
      "reading": "geu sosigeun keun chunggyeogi eosseoyo.",
      "translations": {
        "en": "That news was a huge shock.",
        "ko": "그 소식은 큰 충격이었어요.",
        "ipa": "geu sosigeun keun chunggyeogi eosseoyo.",
        "ar": "كان ذلك الخبر صدمة كبيرة.",
        "cs": "Ta zpráva byl velký šok.",
        "da": "Den nyhed var et stort chok.",
        "de": "Die Nachricht war ein großer Schock.",
        "el": "Αυτή η είδηση ήταν μεγάλο σοκ.",
        "es": "Esa noticia fue una gran sorpresa.",
        "fi": "Se uutinen oli suuri järkytys.",
        "fr": "Cette nouvelle a été un grand choc.",
        "he": "הבשורה הזאת הייתה הלם גדול.",
        "hi": "वह खबर बहुत बड़ा झटका थी।",
        "hu": "Az a hír nagy sokk volt.",
        "id": "Berita itu sangat mengejutkan.",
        "it": "Quella notizia è stata uno shock enorme.",
        "ja": "その知らせは大きなショックでした。",
        "nb": "Den beskjeden var et stort sjokk.",
        "nl": "Dat nieuws was een grote schok.",
        "pl": "Tamta wiadomość była wielkim szokiem.",
        "pt": "Essa notícia foi um choque enorme.",
        "ro": "Vestea aceea a fost un șoc mare.",
        "ru": "Та новость стала большим шоком.",
        "sv": "Den nyheten var en stor chock.",
        "tr": "O haber büyük bir şoktu.",
        "uk": "Та новина була великим шоком.",
        "vi": "Tin đó là một cú sốc lớn.",
        "yue": "嗰個消息真係好震驚。",
        "zh-Hans": "那个消息非常令人震惊。"
      },
