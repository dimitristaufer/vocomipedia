  "sentences": [
    {
      "target": "사모님, 커피 한 잔 드릴까요?",
      "reading": "samonim, keopi han jan deurilkkayo?",
      "translations": {
        "en": "Ma'am, would you like a cup of coffee?",
        "ko": "사모님, 커피 한 잔 드릴까요?",
        "ipa": "samonim, keopi han jan deurilkkayo?",
        "ar": "يا سيدتي، هل أقدّم لكِ فنجان قهوة؟",
        "cs": "Paní, dala byste si šálek kávy?",
        "da": "Frue, vil du have en kop kaffe?",
        "de": "Gnädige Frau, möchten Sie eine Tasse Kaffee?",
        "el": "Κυρία μου, θέλετε μια κούπα καφέ;",
        "es": "Señora, ¿le sirvo una taza de café?",
        "fi": "Rouva, haluaisitteko kupin kahvia?",
        "fr": "Madame, voulez-vous une tasse de café ?",
        "he": "גברתי, תרצי כוס קפה?",
        "hi": "मैडम, क्या आपको एक कप कॉफी दूँ?",
        "hu": "Asszonyom, kér egy csésze kávét?",
        "id": "Bu, mau secangkir kopi?",
        "it": "Signora, vuole una tazza di caffè?",
        "ja": "奥様、コーヒーを一杯いかがですか。",
        "nb": "Frue, vil du ha en kopp kaffe?",
        "nl": "Mevrouw, wilt u een kopje koffie?",
        "pl": "Proszę pani, czy chce pani filiżankę kawy?",
        "pt": "Senhora, quer uma xícara de café?",
        "ro": "Doamnă, doriți o ceașcă de cafea?",
        "ru": "Госпожа, не хотите чашку кофе?",
        "sv": "Fru, vill du ha en kopp kaffe?",
        "tr": "Hanımefendi, bir fincan kahve ister misiniz?",
        "uk": "Пані, хочете чашку кави?",
        "vi": "Thưa bà, bà dùng một tách cà phê nhé?",
        "yue": "太太，要唔要一杯咖啡呀？",
        "zh-Hans": "太太，要来一杯咖啡吗？"
      },
