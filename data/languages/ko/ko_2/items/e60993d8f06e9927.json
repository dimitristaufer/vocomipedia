  "sentences": [
    {
      "target": "감기가 거의 회복되었어요.",
      "reading": "gamgiga geoui hoebokdoeeosseoyo.",
      "translations": {
        "en": "I’ve almost recovered from my cold.",
        "ko": "감기가 거의 회복되었어요.",
        "ipa": "gamgiga geoui hoebokdoeeosseoyo.",
        "ar": "لقد تعافيتُ تقريبًا من الزكام.",
        "cs": "Z nachlazení jsem se už skoro uzdravil.",
        "da": "Jeg er næsten kommet mig over min forkølelse.",
        "de": "Ich bin fast von meiner Erkältung genesen.",
        "el": "Έχω σχεδόν αναρρώσει από το κρυολόγημά μου.",
        "es": "Casi me he recuperado del resfriado.",
        "fi": "Olen melkein toipunut flunssasta.",
        "fr": "Je me suis presque remis de mon rhume.",
        "he": "כמעט החלמתי מהצינון.",
        "hi": "मुझे जुकाम से लगभग आराम मिल गया है।",
        "hu": "Már majdnem felépültem a megfázásomból.",
        "id": "Saya hampir sembuh dari flu saya.",
        "it": "Sono quasi guarito dal raffreddore.",
        "ja": "かぜはほとんど治りました。",
        "nb": "Jeg er nesten frisk etter forkjølelsen.",
        "nl": "Ik ben bijna hersteld van mijn verkoudheid.",
        "pl": "Prawie wyzdrowiałem z przeziębienia.",
        "pt": "Estou quase curado da minha gripe.",
        "ro": "M-am vindecat aproape complet de răceală.",
        "ru": "Я почти выздоровел от простуды.",
        "sv": "Jag har nästan frisknat till från min förkylning.",
        "tr": "Soğuk algınlığından neredeyse iyileştim.",
        "uk": "Я майже одужав від застуди.",
        "vi": "Tôi gần khỏi cảm rồi.",
        "yue": "我已經差唔多痊癒咗。",
        "zh-Hans": "我感冒已经差不多好了。"
      },
