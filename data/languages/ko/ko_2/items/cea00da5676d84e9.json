  "sentences": [
    {
      "target": "엄마는 비빔밥에 고추장을 조금 넣었어요.",
      "reading": "eommaneun bibimbape gochujangeul jogeum neoeosseoyo.",
      "translations": {
        "en": "Mom put a little gochujang in the bibimbap.",
        "ko": "엄마는 비빔밥에 고추장을 조금 넣었어요.",
        "ipa": "eommaneun bibimbape gochujangeul jogeum neoeosseoyo.",
        "ar": "أمي وضعت قليلًا من معجون الفلفل الأحمر في البيبيمباب.",
        "cs": "Maminka přidala do bibimbapu trochu gočudžangu.",
        "da": "Mor kom lidt gochujang i bibimbap.",
        "de": "Mama hat etwas Gochujang in den Bibimbap getan.",
        "el": "Η μαμά έβαλε λίγο γκοτσουτζάνγκ στο bibimbap.",
        "es": "Mamá puso un poco de gochujang en el bibimbap.",
        "fi": "Äiti laittoi vähän gochujangia bibimbapiin.",
        "fr": "Maman a mis un peu de gochujang dans le bibimbap.",
        "he": "אמא שמה קצת גוצ'וג'אנג בביבימבאפ.",
        "hi": "माँ ने बिबिम्बाप में थोड़ा गोचुजांग डाला।",
        "hu": "Anya tett egy kis gochujangot a bibimbapba.",
        "id": "Ibu menaruh sedikit gochujang ke dalam bibimbap.",
        "it": "Mamma ha messo un po' di gochujang nel bibimbap.",
        "ja": "母はビビンバにコチュジャンを少し入れました。",
        "nb": "Mamma la litt gochujang i bibimbapen.",
        "nl": "Mama deed een beetje gochujang in de bibimbap.",
        "pl": "Mama dodała trochę gochujangu do bibimbapu.",
        "pt": "A mãe pôs um pouco de gochujang no bibimbap.",
        "ro": "Mama a pus puțin gochujang în bibimbap.",
        "ru": "Мама положила немного кочхуджана в пибимпап.",
        "sv": "Mamma lade lite gochujang i bibimbapen.",
        "tr": "Annem bibimbapa biraz gochujang koydu.",
        "uk": "Мама поклала трохи кочхуджан у бібімбап.",
        "vi": "Mẹ cho một ít gochujang vào bibimbap.",
        "yue": "阿媽喺拌飯入面加咗少少韓式辣醬。",
        "zh-Hans": "妈妈在拌饭里放了一点辣椒酱。"
      },
