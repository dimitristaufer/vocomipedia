  "sentences": [
    {
      "target": "부엌의 수도꼭지가 조금 새요.",
      "reading": "부어게 수도꼭찌가 조금 새요.",
      "translations": {
        "en": "The kitchen faucet is leaking a little.",
        "ko": "부엌의 수도꼭지가 조금 새요.",
        "ipa": "부어게 수도꼭찌가 조금 새요.",
        "ar": "صنبور المطبخ يسرّب قليلًا.",
        "cs": "Kuchyňský kohoutek trochu protéká.",
        "da": "Køkkenhanen lækker lidt.",
        "de": "Der Küchenwasserhahn tropft ein bisschen.",
        "el": "Η βρύση της κουζίνας στάζει λίγο.",
        "es": "El grifo de la cocina gotea un poco.",
        "fi": "Keittiön hana vuotaa vähän.",
        "fr": "Le robinet de la cuisine fuit un peu.",
        "he": "ברז המטבח מטפטף קצת.",
        "hi": "रसोई का नल थोड़ा रिस रहा है।",
        "hu": "A konyhai csap kicsit csöpög.",
        "id": "Keran dapur bocor sedikit.",
        "it": "Il rubinetto della cucina perde un po'.",
        "ja": "台所の蛇口が少し漏れています。",
        "nb": "Kjøkkenkranen lekker litt.",
        "nl": "De keukenkraan lekt een beetje.",
        "pl": "Kuchenny kran trochę przecieka.",
        "pt": "A torneira da cozinha está vazando um pouco.",
        "ro": "Robinetul din bucătărie curge puțin.",
        "ru": "Кухонный кран немного протекает.",
        "sv": "Kökskranen läcker lite.",
        "tr": "Mutfak musluğu biraz sızdırıyor.",
        "uk": "Кухонний кран трохи протікає.",
        "vi": "Vòi nước trong bếp bị rỉ một chút.",
        "yue": "廚房個水龍頭漏緊少少。",
        "zh-Hans": "厨房的水龙头有点漏水。"
      },
