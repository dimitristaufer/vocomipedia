  "sentences": [
    {
      "target": "오늘은 피로가 너무 심해요.",
      "reading": "oneureun piroga neomu simhaeyo.",
      "translations": {
        "en": "Today, I’m extremely tired.",
        "ko": "오늘은 피로가 너무 심해요.",
        "ipa": "oneureun piroga neomu simhaeyo.",
        "ar": "أنا متعب جدًا اليوم.",
        "cs": "Dnes jsem strašně unavený.",
        "da": "Jeg er meget træt i dag.",
        "de": "Heute bin ich sehr müde.",
        "el": "Σήμερα είμαι πολύ κουρασμένος.",
        "es": "Hoy estoy muy cansado.",
        "fi": "Olen tänään hyvin väsynyt.",
        "fr": "Je suis très fatigué aujourd'hui.",
        "he": "אני עייף מאוד היום.",
        "hi": "आज मैं बहुत थका हुआ हूँ।",
        "hu": "Ma nagyon fáradt vagyok.",
        "id": "Saya sangat lelah hari ini.",
        "it": "Oggi sono molto stanco.",
        "ja": "今日はとても疲れています。",
        "nb": "Jeg er veldig trøtt i dag.",
        "nl": "Ik ben vandaag erg moe.",
        "pl": "Jestem dziś bardzo zmęczony.",
        "pt": "Estou muito cansado hoje.",
        "ro": "Sunt foarte obosit astăzi.",
        "ru": "Сегодня я очень устал.",
        "sv": "Jag är väldigt trött i dag.",
        "tr": "Bugün çok yorgunum.",
        "uk": "Сьогодні я дуже втомлений.",
        "vi": "Hôm nay tôi rất mệt.",
        "yue": "我今日好攰。",
        "zh-Hans": "我今天很累。"
      },
