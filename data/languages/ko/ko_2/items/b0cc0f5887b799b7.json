  "sentences": [
    {
      "target": "아이가 꾸중을 듣고 고개를 숙였어요.",
      "reading": "ai-ga kkujung-eul deutgo gogae-reul sugeo-sseoyo.",
      "translations": {
        "en": "The child bowed their head after being scolded.",
        "ko": "아이가 꾸중을 듣고 고개를 숙였어요.",
        "ipa": "ai-ga kkujung-eul deutgo gogae-reul sugeo-sseoyo.",
        "ar": "خفض الطفل رأسه بعد أن وبّخه أحدهم.",
        "cs": "Dítě sklopilo hlavu poté, co dostalo vynadáno.",
        "da": "Barnet sænkede hovedet, efter at det blev skældt ud.",
        "de": "Das Kind senkte den Kopf, nachdem es gescholten worden war.",
        "el": "Το παιδί έσκυψε το κεφάλι του αφού το μάλωσαν.",
        "es": "El niño bajó la cabeza después de que lo regañaran.",
        "fi": "Lapsi laski päänsä nuhtelun jälkeen.",
        "fr": "L'enfant a baissé la tête après avoir été grondé.",
        "he": "הילד השפיל את ראשו אחרי שנזפו בו.",
        "hi": "बच्चे ने डाँट खाने के बाद सिर झुका लिया।",
        "hu": "A gyerek lehajtotta a fejét, miután leszidták.",
        "id": "Anak itu menunduk setelah dimarahi.",
        "it": "Il bambino ha abbassato la testa dopo essere stato rimproverato.",
        "ja": "子どもは叱られて、頭を下げました。",
        "nb": "Barnet senket hodet etter å ha fått kjeft.",
        "nl": "Het kind boog zijn hoofd na de berisping.",
        "pl": "Dziecko spuściło głowę po naganie.",
        "pt": "A criança baixou a cabeça depois de levar uma bronca.",
        "ro": "Copilul și-a plecat capul după ce a fost certat.",
        "ru": "Ребёнок опустил голову после выговора.",
        "sv": "Barnet sänkte huvudet efter att ha fått en tillrättavisning.",
        "tr": "Çocuk azar işitince başını eğdi.",
        "uk": "Дитина опустила голову після догани.",
        "vi": "Đứa trẻ cúi đầu sau khi bị mắng.",
        "yue": "個細路俾人鬧完之後低咗頭。",
        "zh-Hans": "孩子被责备后低下了头。"
      },
