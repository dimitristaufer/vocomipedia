    {
      "target": "참새가 창밖에서 짹짹 울어요.",
      "reading": "chamsaega changbakkeseo jjekjjek ureoyo.",
      "translations": {
        "en": "A sparrow is chirping outside the window.",
        "ko": "참새가 창밖에서 짹짹 울어요.",
        "ipa": "chamsaega changbakkeseo jjekjjek ureoyo.",
        "ar": "تغرّد عصفورة خارج النافذة.",
        "cs": "Vrabec zpívá za oknem.",
        "da": "En spurv kvidrer uden for vinduet.",
        "de": "Ein Spatz zwitschert draußen vor dem Fenster.",
        "el": "Ένα σπουργίτι κελαηδάει έξω από το παράθυρο.",
        "es": "Un gorrión piaba fuera de la ventana.",
        "fi": "Varpunen sirkuttaa ikkunan ulkopuolella.",
        "fr": "Un moineau pépie dehors, sous la fenêtre.",
        "he": "דרור מצייץ מחוץ לחלון.",
        "hi": "खिड़की के बाहर एक गौरैया चहचहा रही है।",
        "hu": "Egy veréb csiripel az ablakon kívül.",
        "id": "Seekor burung pipit berkicau di luar jendela.",
        "it": "Un passero cinguetta fuori dalla finestra.",
        "ja": "スズメが窓の外でさえずっています。",
        "nb": "En spurv kvitrer utenfor vinduet.",
        "nl": "Een musje tjilpt buiten het raam.",
        "pl": "Wróbel ćwierka za oknem.",
        "pt": "Um pardal pia do lado de fora da janela.",
        "ro": "O vrabie ciripește afară, la fereastră.",
        "ru": "Воробей чирикает за окном.",
        "sv": "En sparv kvittrar utanför fönstret.",
        "tr": "Bir serçe pencerenin dışında cıvıldıyor.",
        "uk": "Горобець цвірінькає за вікном.",
        "vi": "Một con chim sẻ đang hót ở ngoài cửa sổ.",
        "yue": "麻雀喺窗外面吱吱叫。",
        "zh-Hans": "一只麻雀在窗外叽叽叫。"
      },
