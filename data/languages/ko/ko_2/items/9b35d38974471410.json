  "sentences": [
    {
      "target": "제 언니는 만화가예요.",
      "reading": "Je eonnineun manhwaga-yeyo.",
      "translations": {
        "en": "My older sister is a cartoon artist.",
        "ko": "제 언니는 만화가예요.",
        "ipa": "Je eonnineun manhwaga-yeyo.",
        "ar": "أختي الكبرى رسامة كرتون.",
        "cs": "Moje starší sestra je kreslířka komiksů.",
        "da": "Min storesøster er tegneserietegner.",
        "de": "Meine große Schwester ist Comiczeichnerin.",
        "el": "Η μεγάλη μου αδελφή είναι σκιτσογράφος κόμικς.",
        "es": "Mi hermana mayor es dibujante de cómics.",
        "fi": "Isosiskoni on sarjakuvataiteilija.",
        "fr": "Ma grande sœur est dessinatrice de bandes dessinées.",
        "he": "אחותי הגדולה היא מאיירת קומיקס.",
        "hi": "मेरी बड़ी बहन कॉमिक्स की कलाकार है।",
        "hu": "A nővérem képregényrajzoló.",
        "id": "Kakak perempuan saya seorang komikus.",
        "it": "Mia sorella maggiore è una fumettista.",
        "ja": "私の姉は漫画家です。",
        "nb": "Storesøsteren min er tegneserietegner.",
        "nl": "Mijn oudere zus is striptekenaar.",
        "pl": "Moja starsza siostra jest rysowniczką komiksów.",
        "pt": "Minha irmã mais velha é desenhista de quadrinhos.",
        "ro": "Sora mea mai mare este desenatoare de benzi desenate.",
        "ru": "Моя старшая сестра — художница-комиксист.",
        "sv": "Min storasyster är serietecknare.",
        "tr": "Abla m karikatürist.",
        "uk": "Моя старша сестра — художниця-коміксистка.",
        "vi": "Chị gái tôi là họa sĩ truyện tranh.",
        "yue": "我家家姐係漫畫家。",
        "zh-Hans": "我姐姐是漫画家。"
      },
