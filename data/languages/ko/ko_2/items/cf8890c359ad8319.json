    {
      "target": "수십 명이 기다리고 있었어요.",
      "reading": "susip myeongi gidaligo isseosseoyo.",
      "translations": {
        "en": "Tens of people were waiting.",
        "ko": "수십 명이 기다리고 있었어요.",
        "ipa": "susip myeongi gidaligo isseosseoyo.",
        "ar": "كان عشرات الأشخاص ينتظرون.",
        "cs": "Čekaly tam desítky lidí.",
        "da": "Der ventede dusinvis af mennesker.",
        "de": "Dutzende von Menschen warteten.",
        "el": "Περίμεναν δεκάδες άνθρωποι.",
        "es": "Esperaban decenas de personas.",
        "fi": "Siellä odotti kymmeniä ihmisiä.",
        "fr": "Des dizaines de personnes attendaient.",
        "he": "עשרות אנשים חיכו.",
        "hi": "दर्जनों लोग इंतज़ार कर रहे थे।",
        "hu": "Több tucat ember várakozott.",
        "id": "Ada puluhan orang yang sedang menunggu.",
        "it": "C'erano decine di persone che aspettavano.",
        "ja": "何十人も待っていました。",
        "nb": "Det ventet dusinvis av mennesker.",
        "nl": "Er stonden tientallen mensen te wachten.",
        "pl": "Czekały tam dziesiątki ludzi.",
        "pt": "Havia dezenas de pessoas esperando.",
        "ro": "Așteptau zeci de oameni.",
        "ru": "Ждали десятки людей.",
        "sv": "Det stod dussintals människor och väntade.",
        "tr": "Bekleyen onlarca kişi vardı.",
        "uk": "Чекали десятки людей.",
        "vi": "Có hàng chục người đang đợi.",
        "yue": "有幾十個人喺度等。",
        "zh-Hans": "有几十个人在等着。"
      },
