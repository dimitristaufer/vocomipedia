  "sentences": [
    {
      "target": "만일 비가 오면 우산을 가져가세요.",
      "reading": "manil biga omyeon usaneul gajyeogaseyo.",
      "translations": {
        "en": "If it rains, please take an umbrella.",
        "ko": "만일 비가 오면 우산을 가져가세요.",
        "ipa": "manil biga omyeon usaneul gajyeogaseyo.",
        "ar": "إذا أمطرت، خذ مظلة معك من فضلك.",
        "cs": "Jestli bude pršet, vezměte si deštník.",
        "da": "Hvis det regner, så tag en paraply med.",
        "de": "Wenn es regnet, nehmen Sie bitte einen Regenschirm mit.",
        "el": "Αν βρέχει, πάρτε μαζί σας μια ομπρέλα.",
        "es": "Si llueve, lleva un paraguas.",
        "fi": "Jos sataa, ota sateenvarjo mukaan.",
        "fr": "S'il pleut, prenez un parapluie.",
        "he": "אם יורד גשם, קחו מטרייה.",
        "hi": "अगर बारिश हो, तो छाता ले जाइए।",
        "hu": "Ha esik az eső, vigyen magával egy esernyőt.",
        "id": "Kalau hujan, bawa payung.",
        "it": "Se piove, porta un ombrello.",
        "ja": "もし雨が降ったら、傘を持って行ってください。",
        "nb": "Hvis det regner, ta med deg en paraply.",
        "nl": "Als het regent, neem dan een paraplu mee.",
        "pl": "Jeśli będzie padać, weź ze sobą parasol.",
        "pt": "Se chover, leve um guarda-chuva.",
        "ro": "Dacă plouă, ia cu tine o umbrelă.",
        "ru": "Если пойдёт дождь, возьмите зонтик.",
        "sv": "Om det regnar, ta med ett paraply.",
        "tr": "Yağmur yağarsa, lütfen şemsiye alın.",
        "uk": "Якщо піде дощ, візьміть парасольку.",
        "vi": "Nếu trời mưa, hãy mang theo ô.",
        "yue": "如果落雨，請攞把遮。",
        "zh-Hans": "如果下雨，请带上伞。"
      },
