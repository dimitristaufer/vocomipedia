  "sentences": [
    {
      "target": "그 일은 사소하다고 느꼈어요.",
      "reading": "geu ireun sasohadago neukkyeosseoyo.",
      "translations": {
        "en": "I felt that the matter was trivial.",
        "ko": "그 일은 사소하다고 느꼈어요.",
        "ipa": "geu ireun sasohadago neukkyeosseoyo.",
        "ar": "شعرت أن الأمر كان تافهًا.",
        "cs": "Měl jsem pocit, že ta věc byla bezvýznamná.",
        "da": "Jeg følte, at det var en ubetydelig ting.",
        "de": "Ich hatte das Gefühl, dass die Sache belanglos war.",
        "el": "Ένιωσα ότι το θέμα ήταν ασήμαντο.",
        "es": "Sentí que el asunto era trivial.",
        "fi": "Tunsin, että asia oli mitätön.",
        "fr": "J’ai trouvé que cette affaire était insignifiante.",
        "he": "הרגשתי שהעניין היה זניח.",
        "hi": "मुझे लगा कि वह बात मामूली थी।",
        "hu": "Úgy éreztem, hogy az ügy jelentéktelen volt.",
        "id": "Saya merasa bahwa hal itu sepele.",
        "it": "Mi è sembrato che la cosa fosse insignificante.",
        "ja": "そのことは些細だと感じました。",
        "nb": "Jeg følte at saken var ubetydelig.",
        "nl": "Ik vond dat de zaak onbeduidend was.",
        "pl": "Miałem wrażenie, że ta sprawa była błaha.",
        "pt": "Senti que a questão era insignificante.",
        "ro": "Am simțit că lucrul acela era neînsemnat.",
        "ru": "Мне казалось, что это дело незначительное.",
        "sv": "Jag kände att saken var obetydlig.",
        "tr": "Meselenin önemsiz olduğunu hissettim.",
        "uk": "Мені здавалося, що ця справа була незначною.",
        "vi": "Tôi cảm thấy việc đó là chuyện nhỏ.",
        "yue": "我覺得嗰件事好瑣碎。",
        "zh-Hans": "我觉得那件事很琐碎。"
      },
