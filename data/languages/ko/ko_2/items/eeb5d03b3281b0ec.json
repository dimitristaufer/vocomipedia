  "sentences": [
    {
      "target": "조카가 오늘 우리 집에 놀러 왔어요.",
      "reading": "joka-ga oneul uri jibe nollleo wasseoyo.",
      "translations": {
        "en": "My nephew/niece came to visit our house today.",
        "ko": "조카가 오늘 우리 집에 놀러 왔어요.",
        "ipa": "joka-ga oneul uri jibe nollleo wasseoyo.",
        "ar": "جاء ابن أخي لزيارة بيتنا اليوم.",
        "cs": "Dnes k nám domů přišel synovec.",
        "da": "Min nevø kom på besøg hos os i dag.",
        "de": "Mein Neffe ist heute zu uns nach Hause gekommen.",
        "el": "Ο ανιψιός μου ήρθε σήμερα επίσκεψη στο σπίτι μας.",
        "es": "Mi sobrino vino hoy a visitarnos a casa.",
        "fi": "Siskonpoikani tuli tänään käymään meillä.",
        "fr": "Mon neveu est venu nous rendre visite aujourd'hui.",
        "he": "האחיין שלי בא לבקר אצלנו היום.",
        "hi": "मेरा भतीजा आज हमारे घर मिलने आया।",
        "hu": "A ma az unokaöcsém jött el hozzánk látogatóba.",
        "id": "Keponakanku datang berkunjung ke rumah kami hari ini.",
        "it": "Mio nipote è venuto a trovarci a casa oggi.",
        "ja": "今日は甥がうちに遊びに来ました。",
        "nb": "Nevøen min kom på besøk hos oss i dag.",
        "nl": "Mijn neefje kwam vandaag bij ons op bezoek.",
        "pl": "Mój siostrzeniec przyszedł dziś do nas w odwiedziny.",
        "pt": "Meu sobrinho veio nos visitar hoje em casa.",
        "ro": "Nepotul meu a venit azi în vizită la noi acasă.",
        "ru": "Мой племянник сегодня пришёл к нам в гости.",
        "sv": "Min brorson kom på besök hos oss i dag.",
        "tr": "Yeğenim bugün bizi evde ziyarete geldi.",
        "uk": "Мій племінник сьогодні прийшов до нас у гості.",
        "vi": "Cháu tôi hôm nay đến nhà chơi.",
        "yue": "我個姪今日嚟我哋屋企玩。",
        "zh-Hans": "我侄子今天来我们家玩。"
      },
