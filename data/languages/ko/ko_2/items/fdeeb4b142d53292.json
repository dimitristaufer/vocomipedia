  "sentences": [
    {
      "target": "저는 재활용품을 분리해서 버려요.",
      "reading": "jeoneun jaehwaryongpumeul bunrihaeseo beoryeoyo.",
      "translations": {
        "en": "I separate recyclables before I throw them away.",
        "ko": "저는 재활용품을 분리해서 버려요.",
        "ipa": "jeoneun jaehwaryongpumeul bunrihaeseo beoryeoyo.",
        "ar": "أفصل المواد القابلة لإعادة التدوير قبل أن أرميها.",
        "cs": "Třídím recyklovatelné věci, než je vyhodím.",
        "da": "Jeg sorterer genbrugsting, før jeg smider dem ud.",
        "de": "Ich trenne Recyclingabfälle, bevor ich sie wegwerfe.",
        "el": "Ξεχωρίζω τα ανακυκλώσιμα πριν τα πετάξω.",
        "es": "Separo los reciclables antes de tirarlos.",
        "fi": "Lajittelen kierrätettävät ennen kuin heitän ne pois.",
        "fr": "Je trie les objets recyclables avant de les jeter.",
        "he": "אני ממיין את המיחזור לפני שאני זורק אותו.",
        "hi": "मैं रीसायकल होने वाली चीज़ें अलग करके फेंकता हूँ।",
        "hu": "Különválogatom az újrahasznosítható dolgokat, mielőtt kidobom őket.",
        "id": "Saya memisahkan barang daur ulang sebelum membuangnya.",
        "it": "Separo gli oggetti riciclabili prima di buttarli via.",
        "ja": "私は捨てる前にリサイクル品を分けます。",
        "nb": "Jeg sorterer resirkulerbart avfall før jeg kaster det.",
        "nl": "Ik scheid recyclebaar afval voordat ik het weggooi.",
        "pl": "Segreguję rzeczy do recyklingu, zanim je wyrzucę.",
        "pt": "Eu separo os materiais recicláveis antes de jogá-los fora.",
        "ro": "Eu separ materialele reciclabile înainte să le arunc.",
        "ru": "Я сортирую перерабатываемые вещи, прежде чем выбросить их.",
        "sv": "Jag sorterar återvinningsbart avfall innan jag slänger det.",
        "tr": "Atmadan önce geri dönüştürülebilirleri ayırırım.",
        "uk": "Я сортую вторсировину, перш ніж викинути її.",
        "vi": "Tôi phân loại đồ tái chế trước khi vứt chúng đi.",
        "yue": "我掉嘢之前會分開可回收物。",
        "zh-Hans": "我扔东西之前会把可回收物分开。"
      },
