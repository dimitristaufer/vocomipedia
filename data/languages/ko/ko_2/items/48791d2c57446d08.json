  "sentences": [
    {
      "target": "그는 즉석에서 노래를 불렀어요.",
      "reading": "geuneun jeukseok-eseo noraereul bulreosseoyo.",
      "translations": {
        "en": "He sang a song on the spot.",
        "ko": "그는 즉석에서 노래를 불렀어요.",
        "ipa": "geuneun jeukseok-eseo noraereul bulreosseoyo.",
        "ar": "غنى أغنية على الفور.",
        "cs": "Zpíval píseň na místě.",
        "da": "Han sang en sang på stedet.",
        "de": "Er sang vor Ort ein Lied.",
        "el": "Τραγούδησε ένα τραγούδι επιτόπου.",
        "es": "Cantó una canción allí mismo.",
        "fi": "Hän lauloi laulun heti.",
        "fr": "Il a chanté une chanson sur-le-champ.",
        "he": "הוא שר שיר במקום.",
        "hi": "उसने वहीं गाना गाया।",
        "hu": "Ott helyben elénekelt egy dalt.",
        "id": "Dia menyanyikan sebuah lagu saat itu juga.",
        "it": "Ha cantato una canzone sul momento.",
        "ja": "彼はその場で歌を歌いました。",
        "nb": "Han sang en sang på stedet.",
        "nl": "Hij zong ter plekke een lied.",
        "pl": "Zaśpiewał piosenkę na miejscu.",
        "pt": "Ele cantou uma música na hora.",
        "ro": "A cântat un cântec pe loc.",
        "ru": "Он спел песню на месте.",
        "sv": "Han sjöng en sång på plats.",
        "tr": "Orada şarkı söyledi.",
        "uk": "Він заспівав пісню на місці.",
        "vi": "Anh ấy hát một bài ngay tại chỗ.",
        "yue": "佢即刻唱咗首歌。",
        "zh-Hans": "他当场唱了一首歌。"
      },
