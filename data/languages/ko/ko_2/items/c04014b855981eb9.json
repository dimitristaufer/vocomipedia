  "sentences": [
    {
      "target": "계단에서 미끄러져서 팔을 다쳤어요.",
      "reading": "gyedaneseo mikkeureojyeoseo paleul dachyeosseoyo.",
      "translations": {
        "en": "I slipped on the stairs and hurt my arm.",
        "ko": "계단에서 미끄러져서 팔을 다쳤어요.",
        "ipa": "gyedaneseo mikkeureojyeoseo paleul dachyeosseoyo.",
        "ar": "انزلقت على الدرج وأصبت ذراعي.",
        "cs": "Sklouzla jsem na schodech a poranila jsem si ruku.",
        "da": "Jeg gled på trappen og kom til skade med min arm.",
        "de": "Ich bin auf der Treppe ausgerutscht und habe mir den Arm verletzt.",
        "el": "Γλίστρησα στη σκάλα και χτύπησα το χέρι μου.",
        "es": "Resbalé en las escaleras y me lastimé el brazo.",
        "fi": "Lipsahdin portaissa ja satutin käsivarteni.",
        "fr": "J'ai glissé dans les escaliers et je me suis blessé au bras.",
        "he": "החלקתי במדרגות ופצעתי את היד.",
        "hi": "मैं सीढ़ियों पर फिसल गया और मेरी बांह में चोट लग गई।",
        "hu": "Elcsúsztam a lépcsőn, és megsérült a karom.",
        "id": "Saya terpeleset di tangga dan melukai lengan saya.",
        "it": "Sono scivolato sulle scale e mi sono fatto male al braccio.",
        "ja": "階段で滑って腕をけがしました。",
        "nb": "Jeg skled i trappa og skadet armen min.",
        "nl": "Ik gleed uit op de trap en bezeerde mijn arm.",
        "pl": "Poślizgnąłem się na schodach i zraniłem ramię.",
        "pt": "Escorreguei na escada e machuquei o braço.",
        "ro": "Am alunecat pe scări și mi-am rănit brațul.",
        "ru": "Я поскользнулся на лестнице и повредил руку.",
        "sv": "Jag halkade i trappan och skadade armen.",
        "tr": "Merdivenlerde kaydım ve kolumu incittim.",
        "uk": "Я послизнувся на сходах і пошкодив руку.",
        "vi": "Tôi bị trượt ở cầu thang và bị đau tay.",
        "yue": "我喺樓梯度跣咗腳，整傷咗隻手臂。",
        "zh-Hans": "我在楼梯上滑了一跤，弄伤了胳膊。"
      },
