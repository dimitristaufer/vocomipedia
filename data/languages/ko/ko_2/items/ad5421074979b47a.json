  "sentences": [
    {
      "target": "선생님이 조용히 명령을 내렸어요.",
      "reading": "seonsaengnimi joyonghi myeongnyeongeul naeryeosseoyo.",
      "translations": {
        "en": "The teacher quietly gave an order.",
        "ko": "선생님이 조용히 명령을 내렸어요.",
        "ipa": "seonsaengnimi joyonghi myeongnyeongeul naeryeosseoyo.",
        "ar": "أصدر المعلم أمرًا بهدوء.",
        "cs": "Učitel tiše vydal pokyn.",
        "da": "Læreren gav roligt en ordre.",
        "de": "Der Lehrer gab leise einen Befehl.",
        "el": "Ο δάσκαλος έδωσε ήσυχα μια εντολή.",
        "es": "El profesor dio una orden en voz baja.",
        "fi": "Opettaja antoi hiljaa käskyn.",
        "fr": "Le professeur a donné un ordre à voix basse.",
        "he": "המורה נתן הוראה בשקט.",
        "hi": "शिक्षक ने चुपचाप आदेश दिया।",
        "hu": "A tanár halkan adott egy parancsot.",
        "id": "Guru itu memberi perintah dengan tenang.",
        "it": "L'insegnante diede un ordine a voce bassa.",
        "ja": "先生は静かに命令を出しました。",
        "nb": "Læreren ga rolig en ordre.",
        "nl": "De leraar gaf rustig een bevel.",
        "pl": "Nauczyciel spokojnie wydał polecenie.",
        "pt": "O professor deu uma ordem em voz baixa.",
        "ro": "Profesorul a dat o comandă încet.",
        "ru": "Учитель тихо отдал приказ.",
        "sv": "Läraren gav lugnt en order.",
        "tr": "Öğretmen sessizce bir emir verdi.",
        "uk": "Учитель тихо віддав наказ.",
        "vi": "Giáo viên đã ra lệnh nhẹ nhàng.",
        "yue": "老師輕聲地下咗命令。",
        "zh-Hans": "老师轻声下了命令。"
      },
