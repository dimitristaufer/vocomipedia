  "sentences": [
    {
      "target": "저는 그 사람에게 믿음이 생겼어요.",
      "reading": "jeoneun geu saramege mideumi saenggyeosseoyo.",
      "translations": {
        "en": "I came to trust that person.",
        "ko": "저는 그 사람에게 믿음이 생겼어요.",
        "ipa": "jeoneun geu saramege mideumi saenggyeosseoyo.",
        "ar": "بدأت أثق بذلك الشخص.",
        "cs": "Začal jsem tomu člověku věřit.",
        "da": "Jeg begyndte at stole på den person.",
        "de": "Ich habe angefangen, dieser Person zu vertrauen.",
        "el": "Άρχισα να εμπιστεύομαι αυτό το άτομο.",
        "es": "Empecé a confiar en esa persona.",
        "fi": "Alkoin luottaa siihen ihmiseen.",
        "fr": "J'ai commencé à faire confiance à cette personne.",
        "he": "התחלתי לסמוך על האדם הזה.",
        "hi": "मैं उस व्यक्ति पर भरोसा करने लगा।",
        "hu": "Elkezdtem bízni abban az emberben.",
        "id": "Saya mulai mempercayai orang itu.",
        "it": "Ho iniziato a fidarmi di quella persona.",
        "ja": "私はその人を信じるようになりました。",
        "nb": "Jeg begynte å stole på den personen.",
        "nl": "Ik ben die persoon gaan vertrouwen.",
        "pl": "Zacząłem ufać tej osobie.",
        "pt": "Passei a confiar naquela pessoa.",
        "ro": "Am început să am încredere în persoana aceea.",
        "ru": "Я начал доверять этому человеку.",
        "sv": "Jag började lita på den personen.",
        "tr": "O kişiye güvenmeye başladım.",
        "uk": "Я почав довіряти цій людині.",
        "vi": "Tôi bắt đầu tin tưởng người đó.",
        "yue": "我開始信任嗰個人。",
        "zh-Hans": "我开始信任那个人了。"
      },
