    {
      "target": "어머니의 믿음에 보답하고 싶어요.",
      "reading": "eomeoni-ui mideume bodapago sipeoyo.",
      "translations": {
        "en": "I want to repay my mother's trust.",
        "ko": "어머니의 믿음에 보답하고 싶어요.",
        "ipa": "eomeoni-ui mideume bodapago sipeoyo.",
        "ar": "أريد أن أرد ثقة أمي.",
        "cs": "Chci splatit důvěru své matky.",
        "da": "Jeg vil gengælde min mors tillid.",
        "de": "Ich möchte meiner Mutter das Vertrauen zurückgeben.",
        "el": "Θέλω να ανταποδώσω την εμπιστοσύνη της μητέρας μου.",
        "es": "Quiero corresponder a la confianza de mi madre.",
        "fi": "Haluan osoittaa olevani äitini luottamuksen arvoinen.",
        "fr": "Je veux rendre à ma mère la confiance qu'elle m'a donnée.",
        "he": "אני רוצה להחזיר את האמון של אמא שלי.",
        "hi": "मैं अपनी माँ के भरोसे का बदला चुकाना चाहता हूँ।",
        "hu": "Viszonozni akarom anyám bizalmát.",
        "id": "Saya ingin membalas kepercayaan ibu saya.",
        "it": "Voglio ricambiare la fiducia di mia madre.",
        "ja": "母の信頼に応えたいです。",
        "nb": "Jeg vil gjengjelde min mors tillit.",
        "nl": "Ik wil het vertrouwen van mijn moeder terugbetalen.",
        "pl": "Chcę odpłacić się za zaufanie mojej mamy.",
        "pt": "Quero retribuir a confiança da minha mãe.",
        "ro": "Vreau să răsplătesc încrederea mamei mele.",
        "ru": "Я хочу оправдать доверие своей мамы.",
        "sv": "Jag vill återgälda min mammas förtroende.",
        "tr": "Annemin güvenini boşa çıkarmak istemiyorum.",
        "uk": "Я хочу виправдати довіру моєї мами.",
        "vi": "Tôi muốn đáp lại lòng tin của mẹ tôi.",
        "yue": "我想報答媽媽對我嘅信任。",
        "zh-Hans": "我想报答妈妈对我的信任。"
      },
