  "sentences": [
    {
      "target": "길이 미끄러워서 걸을 때 조심스러워요.",
      "reading": "giri mikkeureowoseo georeul ttae josimseureowoyo.",
      "translations": {
        "en": "The road is slippery, so I’m careful when I walk.",
        "ko": "길이 미끄러워서 걸을 때 조심스러워요.",
        "ipa": "giri mikkeureowoseo georeul ttae josimseureowoyo.",
        "ar": "الطريق زلق، لذا أنا حذر عندما أمشي.",
        "cs": "Silnice klouže, takže při chůzi dávám pozor.",
        "da": "Vejen er glat, så jeg er forsigtig, når jeg går.",
        "de": "Die Straße ist rutschig, deshalb bin ich vorsichtig, wenn ich gehe.",
        "el": "Ο δρόμος είναι γλιστερός, οπότε είμαι προσεκτικός όταν περπατάω.",
        "es": "La calle está resbaladiza, así que voy con cuidado cuando camino.",
        "fi": "Tie on liukas, joten olen varovainen kävellessäni.",
        "fr": "La route est glissante, alors je fais attention quand je marche.",
        "he": "הדרך חלקה, אז אני נזהר כשאני הולך.",
        "hi": "सड़क फिसलन भरी है, इसलिए मैं चलते समय सावधान रहता हूँ।",
        "hu": "Az út csúszós, ezért óvatos vagyok, amikor sétálok.",
        "id": "Jalannya licin, jadi saya berhati-hati saat berjalan.",
        "it": "La strada è scivolosa, quindi sto attento quando cammino.",
        "ja": "道が滑りやすいので、歩くときは気をつけています。",
        "nb": "Veien er glatt, så jeg er forsiktig når jeg går.",
        "nl": "De weg is glad, dus ik kijk uit als ik loop.",
        "pl": "Droga jest śliska, więc uważam, kiedy idę.",
        "pt": "A estrada está escorregadia, então eu tomo cuidado quando caminho.",
        "ro": "Drumul e alunecos, așa că sunt atent când merg.",
        "ru": "Дорога скользкая, поэтому я иду осторожно.",
        "sv": "Vägen är hal, så jag är försiktig när jag går.",
        "tr": "Yol kaygan, bu yüzden yürürken dikkatli olurum.",
        "uk": "Дорога слизька, тож я обережний, коли йду.",
        "vi": "Đường trơn, nên tôi đi bộ rất cẩn thận.",
        "yue": "條路好跣，所以我行路嗰陣都好小心。",
        "zh-Hans": "路很滑，所以我走路时很小心。"
      },
