  "sentences": [
    {
      "target": "역사상 이런 일이 처음이에요.",
      "reading": "yeoksasang ireon ir-i cheoeum-ieyo.",
      "translations": {
        "en": "This has never happened in history before.",
        "ko": "역사상 이런 일이 처음이에요.",
        "ipa": "yeoksasang ireon ir-i cheoeum-ieyo.",
        "ar": "لم يحدث هذا من قبل في التاريخ.",
        "cs": "Tohle se v historii ještě nikdy nestalo.",
        "da": "Det er aldrig sket før i historien.",
        "de": "So etwas ist in der Geschichte noch nie passiert.",
        "el": "Αυτό δεν έχει ξανασυμβεί ποτέ στην ιστορία.",
        "es": "Esto nunca ha pasado en la historia.",
        "fi": "Tällaista ei ole koskaan ennen tapahtunut historiassa.",
        "fr": "Cela n’est jamais arrivé dans l’histoire.",
        "he": "זה מעולם לא קרה בהיסטוריה.",
        "hi": "इतिहास में ऐसा पहले कभी नहीं हुआ।",
        "hu": "Ilyen még soha nem történt a történelemben.",
        "id": "Hal seperti ini belum pernah terjadi dalam sejarah.",
        "it": "Non è mai successo niente del genere nella storia.",
        "ja": "歴史上、こんなことは初めてです。",
        "nb": "Dette har aldri skjedd før i historien.",
        "nl": "Dit is nog nooit eerder in de geschiedenis gebeurd.",
        "pl": "Coś takiego nigdy wcześniej nie wydarzyło się w historii.",
        "pt": "Isso nunca aconteceu antes na história.",
        "ro": "Așa ceva nu s-a mai întâmplat niciodată în istorie.",
        "ru": "Такого в истории еще никогда не было.",
        "sv": "Det har aldrig hänt förut i historien.",
        "tr": "Bu, tarihte ilk kez oluyor.",
        "uk": "Такого в історії ще ніколи не було.",
        "vi": "Điều này chưa từng xảy ra trong lịch sử.",
        "yue": "呢件事喺歷史上從未發生過。",
        "zh-Hans": "这件事在历史上从未发生过。"
      },
