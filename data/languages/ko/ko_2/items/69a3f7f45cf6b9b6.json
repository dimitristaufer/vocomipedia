  "sentences": [
    {
      "target": "그는 자존심이 세서 사과를 못 했어요.",
      "reading": "geuneun jajonsimi seseo sagwareul mot haesseoyo.",
      "translations": {
        "en": "He was too proud to apologize.",
        "ko": "그는 자존심이 세서 사과를 못 했어요.",
        "ipa": "geuneun jajonsimi seseo sagwareul mot haesseoyo.",
        "ar": "كان معتدًا بنفسه لدرجة أنه لم يستطع أن يعتذر.",
        "cs": "Byl tak hrdý, že se nedokázal omluvit.",
        "da": "Han var så stolt, at han ikke kunne sige undskyld.",
        "de": "Er war zu stolz, um sich zu entschuldigen.",
        "el": "Ήταν τόσο υπερήφανος που δεν μπορούσε να ζητήσει συγγνώμη.",
        "es": "Era demasiado orgulloso para disculparse.",
        "fi": "Hän oli niin ylpeä, ettei voinut pyytää anteeksi.",
        "fr": "Il était trop fier pour s’excuser.",
        "he": "הוא היה גאה מדי כדי להתנצל.",
        "hi": "वह इतना घमंडी था कि माफ़ी नहीं माँग सका।",
        "hu": "Annyira büszke volt, hogy nem tudott bocsánatot kérni.",
        "id": "Dia terlalu bangga untuk minta maaf.",
        "it": "Era troppo orgoglioso per chiedere scusa.",
        "ja": "彼はプライドが高くて、謝れませんでした。",
        "nb": "Han var så stolt at han ikke klarte å be om unnskyldning.",
        "nl": "Hij was te trots om zijn excuses aan te bieden.",
        "pl": "Był tak dumny, że nie mógł przeprosić.",
        "pt": "Ele era orgulhoso demais para pedir desculpas.",
        "ro": "Era prea mândru ca să-și ceară scuze.",
        "ru": "Он был слишком гордым, чтобы извиниться.",
        "sv": "Han var för stolt för att be om ursäkt.",
        "tr": "Özür dilemeyecek kadar gururluydu.",
        "uk": "Він був надто гордий, щоб вибачитися.",
        "vi": "Anh ấy quá sĩ diện nên không thể xin lỗi.",
        "yue": "佢太有自尊心，所以唔能夠道歉。",
        "zh-Hans": "他太要强了，所以没法道歉。"
      },
