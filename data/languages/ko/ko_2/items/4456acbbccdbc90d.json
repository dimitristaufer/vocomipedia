  "sentences": [
    {
      "target": "다음 달에 도쿄(동경)에 갑니다.",
      "reading": "daeum dal-e dokyo(donggyeong)e gamnida.",
      "translations": {
        "en": "I'm going to Tokyo next month.",
        "ko": "다음 달에 도쿄(동경)에 갑니다.",
        "ipa": "daeum dal-e dokyo(donggyeong)e gamnida.",
        "ar": "سأذهب إلى طوكيو الشهر القادم.",
        "cs": "Příští měsíc pojedu do Tokia.",
        "da": "Jeg skal til Tokyo næste måned.",
        "de": "Nächsten Monat fahre ich nach Tokio.",
        "el": "Τον επόμενο μήνα θα πάω στο Τόκιο.",
        "es": "Voy a ir a Tokio el próximo mes.",
        "fi": "Menen Tokioon ensi kuussa.",
        "fr": "Je vais à Tokyo le mois prochain.",
        "he": "אני נוסע לטוקיו בחודש הבא.",
        "hi": "मैं अगले महीने टोक्यो जा रहा हूँ।",
        "hu": "Jövő hónapban Tokióba megyek.",
        "id": "Saya akan pergi ke Tokyo bulan depan.",
        "it": "Il mese prossimo andrò a Tokyo.",
        "ja": "来月、東京へ行きます。",
        "nb": "Jeg skal til Tokyo neste måned.",
        "nl": "Ik ga volgende maand naar Tokio.",
        "pl": "W przyszłym miesiącu jadę do Tokio.",
        "pt": "Vou para Tóquio no próximo mês.",
        "ro": "Merg la Tokyo luna viitoare.",
        "ru": "Я поеду в Токио в следующем месяце.",
        "sv": "Jag ska till Tokyo nästa månad.",
        "tr": "Gelecek ay Tokyo'ya gideceğim.",
        "uk": "Я поїду до Токіо наступного місяця.",
        "vi": "Tháng sau tôi sẽ đi Tokyo.",
        "yue": "我下個月去東京。",
        "zh-Hans": "我下个月去东京。"
      },
