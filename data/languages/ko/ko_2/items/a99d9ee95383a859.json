  "sentences": [
    {
      "target": "당장 가야 해요.",
      "reading": "dangjang gaya haeyo.",
      "translations": {
        "en": "I have to go right now.",
        "ko": "당장 가야 해요.",
        "ipa": "dangjang gaya haeyo.",
        "ar": "يجب أن أذهب الآن.",
        "cs": "Musím jít hned.",
        "da": "Jeg skal af sted lige nu.",
        "de": "Ich muss sofort gehen.",
        "el": "Πρέπει να φύγω αμέσως.",
        "es": "Tengo que irme ahora mismo.",
        "fi": "Minun täytyy lähteä heti.",
        "fr": "Je dois partir tout de suite.",
        "he": "אני חייב ללכת מיד.",
        "hi": "मुझे अभी जाना है।",
        "hu": "Most azonnal mennem kell.",
        "id": "Saya harus pergi sekarang juga.",
        "it": "Devo andare subito.",
        "ja": "今すぐ行かなければなりません。",
        "nb": "Jeg må dra med en gang.",
        "nl": "Ik moet meteen gaan.",
        "pl": "Muszę iść od razu.",
        "pt": "Tenho que ir agora mesmo.",
        "ro": "Trebuie să plec chiar acum.",
        "ru": "Мне нужно идти прямо сейчас.",
        "sv": "Jag måste gå direkt.",
        "tr": "Hemen gitmem gerekiyor.",
        "uk": "Мені треба йти просто зараз.",
        "vi": "Tôi phải đi ngay bây giờ.",
        "yue": "我要即刻走。",
        "zh-Hans": "我得马上走。"
      },
