  "sentences": [
    {
      "target": "아침 신문 사설을 읽었어요.",
      "reading": "achim sinmun saseoreul ilgeosseoyo.",
      "translations": {
        "en": "I read the newspaper editorial this morning.",
        "ko": "아침 신문 사설을 읽었어요.",
        "ipa": "achim sinmun saseoreul ilgeosseoyo.",
        "ar": "قرأت افتتاحية الجريدة هذا الصباح.",
        "cs": "Ráno jsem si přečetl úvodník v novinách.",
        "da": "Jeg læste avisens leder i morges.",
        "de": "Ich habe heute Morgen den Leitartikel in der Zeitung gelesen.",
        "el": "Διάβασα το πρωινό άρθρο γνώμης της εφημερίδας.",
        "es": "Leí el editorial del periódico esta mañana.",
        "fi": "Luin aamun sanomalehden pääkirjoituksen.",
        "fr": "J'ai lu l'éditorial du journal ce matin.",
        "he": "קראתי את מאמר המערכת של העיתון הבוקר.",
        "hi": "मैंने आज सुबह अखबार का संपादकीय पढ़ा।",
        "hu": "Reggel elolvastam az újság vezércikkét.",
        "id": "Saya membaca editorial koran pagi ini.",
        "it": "Ho letto l'editoriale del giornale stamattina.",
        "ja": "今朝、新聞の社説を読みました。",
        "nb": "Jeg leste avisens leder i morges.",
        "nl": "Ik heb vanmorgen het redactioneel in de krant gelezen.",
        "pl": "Rano przeczytałem artykuł wstępny w gazecie.",
        "pt": "Li o editorial do jornal esta manhã.",
        "ro": "Am citit editorialul din ziar în această dimineață.",
        "ru": "Я прочитал утреннюю передовицу в газете.",
        "sv": "Jag läste tidningens ledare i morse.",
        "tr": "Sabah gazetede bir başyazı okudum.",
        "uk": "Я прочитав ранкову передову статтю в газеті.",
        "vi": "Tôi đã đọc bài xã luận trên báo vào sáng nay.",
        "yue": "我今朝讀咗份報紙嘅社論。",
        "zh-Hans": "我今天早上读了报纸社论。"
      },
