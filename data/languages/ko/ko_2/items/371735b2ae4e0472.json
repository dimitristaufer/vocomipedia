      "reading": "gwaenhan uisim-eun haji maseyo.",
      "translations": {
        "en": "Please don’t suspect without reason.",
        "ko": "괜한 의심은 하지 마세요.",
        "ipa": "gwaenhan uisim-eun haji maseyo.",
        "ar": "من فضلك لا تَشُكَّ بلا سبب.",
        "cs": "Nedělejte zbytečné podezření.",
        "da": "Lad være med at mistænke uden grund.",
