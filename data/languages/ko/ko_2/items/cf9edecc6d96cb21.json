  "sentences": [
    {
      "target": "아이들이 줄을 서서 질서를 지켰어요.",
      "reading": "aidurineun jureul seoseo jilseoreul jikyeosseoyo.",
      "translations": {
        "en": "The children lined up and kept order.",
        "ko": "아이들이 줄을 서서 질서를 지켰어요.",
        "ipa": "aidurineun jureul seoseo jilseoreul jikyeosseoyo.",
        "ar": "اصطف الأطفال وحافظوا على النظام.",
        "cs": "Děti se seřadily a dodržovaly pořádek.",
        "da": "Børnene stillede sig i kø og holdt orden.",
        "de": "Die Kinder stellten sich in einer Reihe auf und hielten sich an die Regeln.",
        "el": "Τα παιδιά παρατάχθηκαν και κράτησαν την τάξη.",
        "es": "Los niños se formaron en fila y mantuvieron el orden.",
        "fi": "Lapset asettuivat jonoon ja noudattivat järjestystä.",
        "fr": "Les enfants se sont mis en file et ont gardé l'ordre.",
        "he": "הילדים עמדו בתור ושמרו על הסדר.",
        "hi": "बच्चे कतार में खड़े हुए और अनुशासन बनाए रखा।",
        "hu": "A gyerekek sorba álltak, és betartották a rendet.",
        "id": "Anak-anak berbaris dan menjaga ketertiban.",
        "it": "I bambini si sono messi in fila e hanno mantenuto l'ordine.",
        "ja": "子どもたちは並んで、きちんと順番を守りました。",
        "nb": "Barna stilte seg i kø og holdt orden.",
        "nl": "De kinderen gingen in de rij staan en hielden zich aan de orde.",
        "pl": "Dzieci ustawiły się w kolejce i zachowywały porządek.",
        "pt": "As crianças ficaram em fila e mantiveram a ordem.",
        "ro": "Copiii s-au așezat la coadă și au păstrat ordinea.",
        "ru": "Дети выстроились в очередь и соблюдали порядок.",
        "sv": "Barnen ställde sig i kö och höll ordning.",
        "tr": "Çocuklar sıraya girdiler ve düzeni korudular.",
        "uk": "Діти стали в чергу й дотримувалися порядку.",
        "vi": "Bọn trẻ xếp hàng và giữ trật tự.",
        "yue": "啲細路仔排好隊，守秩序。",
        "zh-Hans": "孩子们排好队，遵守了秩序。"
      },
