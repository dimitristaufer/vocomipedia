    {
      "target": "고양이가 소파 밑에 숨어 있어요.",
      "reading": "Goyangiga sopa mite sumeo isseoyo.",
      "translations": {
        "en": "The cat is hiding under the sofa.",
        "ko": "고양이가 소파 밑에 숨어 있어요.",
        "ipa": "Goyangiga sopa mite sumeo isseoyo.",
        "ar": "القط يختبئ تحت الأريكة.",
        "cs": "Kočka se schovává pod pohovkou.",
        "da": "Katten gemmer sig under sofaen.",
        "de": "Die Katze versteckt sich unter dem Sofa.",
        "el": "Η γάτα κρύβεται κάτω από τον καναπέ.",
        "es": "El gato se esconde debajo del sofá.",
        "fi": "Kissa piilottelee sohvan alla.",
        "fr": "Le chat se cache sous le canapé.",
        "he": "החתול מתחבא מתחת לספה.",
        "hi": "बिल्ली सोफ़े के नीचे छिपी है।",
        "hu": "A macska a kanapé alatt bújik meg.",
        "id": "Kucing itu bersembunyi di bawah sofa.",
        "it": "Il gatto si nasconde sotto il divano.",
        "ja": "猫がソファの下に隠れています。",
        "nb": "Katten gjemmer seg under sofaen.",
        "nl": "De kat verstopt zich onder de bank.",
        "pl": "Kot chowa się pod sofą.",
        "pt": "O gato está se escondendo debaixo do sofá.",
        "ro": "Pisica se ascunde sub canapea.",
        "ru": "Кот прячется под диваном.",
        "sv": "Katten gömmer sig under soffan.",
        "tr": "Kedi koltuğun altında saklanıyor.",
        "uk": "Кіт ховається під диваном.",
        "vi": "Con mèo đang trốn dưới ghế sofa.",
        "yue": "隻貓匿喺梳化下面。",
        "zh-Hans": "猫藏在沙发下面。"
      },
