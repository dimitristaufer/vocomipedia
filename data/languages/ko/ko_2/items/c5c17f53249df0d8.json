    {
      "target": "아이가 나무 뒤에 숨었어요.",
      "reading": "Aiga namu dwie sumeosseoyo.",
      "translations": {
        "en": "The child hid behind the tree.",
        "ko": "아이가 나무 뒤에 숨었어요.",
        "ipa": "Aiga namu dwie sumeosseoyo.",
        "ar": "اختبأ الطفل خلف الشجرة.",
        "cs": "Dítě se schovalo za strom.",
        "da": "Barnet gemte sig bag træet.",
        "de": "Das Kind hat sich hinter dem Baum versteckt.",
        "el": "Το παιδί κρύφτηκε πίσω από το δέντρο.",
        "es": "El niño se escondió detrás del árbol.",
        "fi": "Lapsi piiloutui puun taakse.",
        "fr": "L'enfant s'est caché derrière l'arbre.",
        "he": "הילד התחבא מאחורי העץ.",
        "hi": "बच्चा पेड़ के पीछे छिप गया।",
        "hu": "A gyerek elbújt a fa mögött.",
        "id": "Anak itu bersembunyi di belakang pohon.",
        "it": "Il bambino si è nascosto dietro l'albero.",
        "ja": "子どもが木の後ろに隠れました。",
        "nb": "Barnet gjemte seg bak treet.",
        "nl": "Het kind verstopte zich achter de boom.",
        "pl": "Dziecko schowało się za drzewem.",
        "pt": "A criança se escondeu atrás da árvore.",
        "ro": "Copilul s-a ascuns după copac.",
        "ru": "Ребёнок спрятался за деревом.",
        "sv": "Barnet gömde sig bakom trädet.",
        "tr": "Çocuk ağacın arkasına saklandı.",
        "uk": "Дитина сховалася за деревом.",
        "vi": "Đứa trẻ đã trốn sau cây.",
        "yue": "小朋友匿咗喺樹後面。",
        "zh-Hans": "孩子躲在树后面。"
