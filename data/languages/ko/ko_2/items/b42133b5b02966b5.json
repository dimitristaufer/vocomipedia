  "sentences": [
    {
      "target": "이번 달 초순에 계약서를 보냈어요.",
      "reading": "ibeon dal chosun-e gyeyakseoreul bonaesseoyo.",
      "translations": {
        "en": "I sent the contract in the first third of this month.",
        "ko": "이번 달 초순에 계약서를 보냈어요.",
        "ipa": "ibeon dal chosun-e gyeyakseoreul bonaesseoyo.",
        "ar": "أرسلت العقد في أوائل هذا الشهر.",
        "cs": "Poslal jsem smlouvu na začátku tohoto měsíce.",
        "da": "Jeg sendte kontrakten i begyndelsen af denne måned.",
        "de": "Ich habe den Vertrag Anfang dieses Monats geschickt.",
        "el": "Έστειλα το συμβόλαιο στις αρχές αυτού του μήνα.",
        "es": "Envié el contrato a principios de este mes.",
        "fi": "Lähetin sopimuksen tämän kuun alussa.",
        "fr": "J'ai envoyé le contrat au début de ce mois.",
        "he": "שלחתי את החוזה בתחילת החודש הזה.",
        "hi": "मैंने इस महीने की शुरुआत में अनुबंध भेज दिया।",
        "hu": "A hónap elején küldtem el a szerződést.",
        "id": "Saya mengirim kontraknya di awal bulan ini.",
        "it": "Ho mandato il contratto all'inizio di questo mese.",
        "ja": "今月の上旬に契約書を送りました。",
        "nb": "Jeg sendte kontrakten i begynnelsen av denne måneden.",
        "nl": "Ik heb het contract aan het begin van deze maand verstuurd.",
        "pl": "Wysłałem umowę na początku tego miesiąca.",
        "pt": "Enviei o contrato no começo deste mês.",
        "ro": "Am trimis contractul la începutul acestei luni.",
        "ru": "Я отправил договор в начале этого месяца.",
        "sv": "Jag skickade kontraktet i början av den här månaden.",
        "tr": "Sözleşmeyi bu ayın başında gönderdim.",
        "uk": "Я надіслав договір на початку цього місяця.",
        "vi": "Tôi đã gửi hợp đồng vào đầu tháng này.",
        "yue": "我喺今個月月初寄咗份合約。",
        "zh-Hans": "我在这个月月初寄出了合同。"
      },
