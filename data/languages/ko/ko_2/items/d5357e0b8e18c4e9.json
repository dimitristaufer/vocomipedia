  "sentences": [
    {
      "target": "그 소식은 정말 충격적이었어요.",
      "reading": "geu sosigeun jeongmal chunggyeokjeogieosseoyo.",
      "translations": {
        "en": "That news was really shocking.",
        "ko": "그 소식은 정말 충격적이었어요.",
        "ipa": "geu sosigeun jeongmal chunggyeokjeogieosseoyo.",
        "ar": "كان ذلك الخبر صادمًا حقًا.",
        "cs": "Ta zpráva byla opravdu šokující.",
        "da": "Den nyhed var virkelig chokerende.",
        "de": "Die Nachricht war wirklich schockierend.",
        "el": "Αυτή η είδηση ήταν πραγματικά σοκαριστική.",
        "es": "Esa noticia fue realmente impactante.",
        "fi": "Se uutinen oli todella järkyttävä.",
        "fr": "Cette nouvelle était vraiment choquante.",
        "he": "החדשות האלה היו באמת מזעזעות.",
        "hi": "वह खबर वाकई चौंकाने वाली थी।",
        "hu": "Az a hír tényleg sokkoló volt.",
        "id": "Kabar itu benar-benar mengejutkan.",
        "it": "Quella notizia era davvero scioccante.",
        "ja": "その知らせは本当に衝撃的でした。",
        "nb": "Den nyheten var virkelig sjokkerende.",
        "nl": "Dat nieuws was echt schokkend.",
        "pl": "Ta wiadomość była naprawdę szokująca.",
        "pt": "Essa notícia foi realmente chocante.",
        "ro": "Vestea aceea a fost chiar șocantă.",
        "ru": "Та новость была действительно шокирующей.",
        "sv": "Den nyheten var verkligen chockerande.",
        "tr": "O haber gerçekten şok ediciydi.",
        "uk": "Та новина була справді шокуючою.",
        "vi": "Tin đó thật sự gây sốc.",
        "yue": "嗰個消息真係好震撼。",
        "zh-Hans": "那个消息真的很震惊。"
      },
