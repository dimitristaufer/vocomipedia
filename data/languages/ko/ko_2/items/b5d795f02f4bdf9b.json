  "sentences": [
    {
      "target": "그는 양심에 따라 거짓말을 하지 않았어요.",
      "reading": "geuneun yangsim-e ttara geojismal-eul haji anasseoyo.",
      "translations": {
        "en": "He didn't lie, following his conscience.",
        "ko": "그는 양심에 따라 거짓말을 하지 않았어요.",
        "ipa": "geuneun yangsim-e ttara geojismal-eul haji anasseoyo.",
        "ar": "لم يكذب، واتبع ضميره.",
        "cs": "Nelhal, řídil se svým svědomím.",
        "da": "Han løj ikke og fulgte sin samvittighed.",
        "de": "Er log nicht und folgte seinem Gewissen.",
        "el": "Δεν είπε ψέματα, ακολουθώντας τη συνείδησή του.",
        "es": "No mintió, siguiendo su conciencia.",
        "fi": "Hän ei valehdellut, vaan seurasi omaatuntoaan.",
        "fr": "Il n'a pas menti, en suivant sa conscience.",
        "he": "הוא לא שיקר, לפי מצפונו.",
        "hi": "उसने अपने विवेक के अनुसार झूठ नहीं बोला।",
        "hu": "Nem hazudott, mert a lelkiismeretére hallgatott.",
        "id": "Dia tidak berbohong, mengikuti nuraninya.",
        "it": "Non ha mentito, seguendo la sua coscienza.",
        "ja": "彼は良心に従ってうそをつきませんでした。",
        "nb": "Han løy ikke, og fulgte samvittigheten sin.",
        "nl": "Hij loog niet en volgde zijn geweten.",
        "pl": "Nie skłamał, kierując się sumieniem.",
        "pt": "Ele não mentiu, seguindo a sua consciência.",
        "ro": "Nu a mințit, urmându-și conștiința.",
        "ru": "Он не соврал, поступив по совести.",
        "sv": "Han ljög inte och följde sitt samvete.",
        "tr": "Vicdanına göre davranıp yalan söylemedi.",
        "uk": "Він не збрехав, бо дослухався до своєї совісті.",
        "vi": "Anh ấy không nói dối, làm theo lương tâm mình.",
        "yue": "佢跟住良心，冇講大話。",
        "zh-Hans": "他遵从良心，没有说谎。"
      },
