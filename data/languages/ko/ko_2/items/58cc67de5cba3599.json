  "sentences": [
    {
      "target": "그 계획은 애초에 무리였어요.",
      "reading": "geu gyehoek-eun aechoe muriyeosseoyo.",
      "translations": {
        "en": "That plan was unrealistic from the start.",
        "ko": "그 계획은 애초에 무리였어요.",
        "ipa": "geu gyehoek-eun aechoe muriyeosseoyo.",
        "ar": "كان ذلك المخطط غير واقعي منذ البداية.",
        "cs": "Ten plán byl od začátku nereálný.",
        "da": "Den plan var urealistisk fra starten.",
        "de": "Der Plan war von Anfang an unrealistisch.",
        "el": "Το σχέδιο αυτό ήταν μη ρεαλιστικό από την αρχή.",
        "es": "Ese plan era poco realista desde el principio.",
        "fi": "Se suunnitelma oli alusta alkaen epärealistinen.",
        "fr": "Ce projet était irréaliste dès le départ.",
        "he": "התוכנית הזאת הייתה לא מציאותית מלכתחילה.",
        "hi": "वह योजना शुरू से ही अव्यावहारिक थी।",
        "hu": "Az a terv már a kezdetektől irreális volt.",
        "id": "Rencana itu sudah tidak masuk akal sejak awal.",
        "it": "Quel piano era irrealistico fin dall'inizio.",
        "ja": "その計画は最初から無理でした。",
        "nb": "Den planen var urealistisk fra starten av.",
        "nl": "Dat plan was vanaf het begin onrealistisch.",
        "pl": "Ten plan był od początku nierealny.",
        "pt": "Esse plano era inviável desde o início.",
        "ro": "Planul acela era nerealist de la început.",
        "ru": "Этот план с самого начала был нереальным.",
        "sv": "Den planen var orealistisk från början.",
        "tr": "O plan başından beri gerçekçi değildi.",
        "uk": "Цей план від самого початку був нереалістичним.",
        "vi": "Kế hoạch đó đã không thực tế ngay từ đầu.",
        "yue": "嗰個計劃一開始就唔切實際。",
        "zh-Hans": "那个计划从一开始就不现实。"
