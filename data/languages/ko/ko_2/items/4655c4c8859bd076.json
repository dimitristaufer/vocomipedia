  "sentences": [
    {
      "target": "이 사진은 좋은 추억을 떠올리게 해요.",
      "reading": "i sajineun joeun chueogeul tteoollige haeyo.",
      "translations": {
        "en": "This photo brings back good memories.",
        "ko": "이 사진은 좋은 추억을 떠올리게 해요.",
        "ipa": "i sajineun joeun chueogeul tteoollige haeyo.",
        "ar": "هذه الصورة تذكرني بذكريات جميلة.",
        "cs": "Ta fotka mi připomíná hezké vzpomínky.",
        "da": "Dette foto bringer gode minder frem.",
        "de": "Dieses Foto weckt schöne Erinnerungen.",
        "el": "Αυτή η φωτογραφία μου φέρνει όμορφες αναμνήσεις.",
        "es": "Esta foto me trae buenos recuerdos.",
        "fi": "Tämä valokuva tuo mieleen hyviä muistoja.",
        "fr": "Cette photo me rappelle de bons souvenirs.",
        "he": "התמונה הזאת מזכירה לי זיכרונות טובים.",
        "hi": "यह फोटो मुझे अच्छी यादें दिलाती है।",
        "hu": "Ez a kép szép emlékeket idéz fel.",
        "id": "Foto ini mengingatkan saya pada kenangan indah.",
        "it": "Questa foto mi fa venire in mente dei bei ricordi.",
        "ja": "この写真を見ると、いい思い出がよみがえります。",
        "nb": "Dette bildet vekker gode minner.",
        "nl": "Deze foto roept mooie herinneringen op.",
        "pl": "To zdjęcie przywołuje miłe wspomnienia.",
        "pt": "Esta foto me traz boas lembranças.",
        "ro": "Această fotografie îmi aduce amintiri frumoase.",
        "ru": "Эта фотография напоминает мне о хороших воспоминаниях.",
        "sv": "Det här fotot väcker fina minnen.",
        "tr": "Bu fotoğraf bana güzel anıları hatırlatıyor.",
        "uk": "Ця фотографія нагадує мені про гарні спогади.",
        "vi": "Bức ảnh này gợi cho tôi những kỷ niệm đẹp.",
        "yue": "呢張相片令我諗起好多美好回憶。",
        "zh-Hans": "这张照片让我想起美好的回忆。"
      },
