  "sentences": [
    {
      "target": "오늘 합격자 명단이 발표됐어요.",
      "reading": "Oneul hapgyeokja myeongdani balpyodoesseoyo.",
      "translations": {
        "en": "The list of people who passed was announced today.",
        "ko": "오늘 합격자 명단이 발표됐어요.",
        "ipa": "Oneul hapgyeokja myeongdani balpyodoesseoyo.",
        "ar": "أُعلنَت قائمة الناجحين اليوم.",
        "cs": "Dnes byl oznámen seznam těch, kteří uspěli.",
        "da": "Listen over dem, der bestod, blev offentliggjort i dag.",
        "de": "Die Liste der Bestandenenge wurde heute bekannt gegeben.",
        "el": "Η λίστα με όσους πέρασαν ανακοινώθηκε σήμερα.",
        "es": "Hoy se anunció la lista de los aprobados.",
        "fi": "Hyväksyttyjen lista julkistettiin tänään.",
        "fr": "La liste des admis a été annoncée aujourd'hui.",
        "he": "רשימת המתקבלים הוכרזה היום.",
        "hi": "आज पास होने वालों की सूची घोषित की गई।",
        "hu": "Ma kihirdették a megfeleltek listáját.",
        "id": "Daftar orang yang lulus diumumkan hari ini.",
        "it": "Oggi è stata annunciata la lista dei promossi.",
        "ja": "今日は合格者の一覧が発表されました。",
        "nb": "Lista over dem som bestod, ble kunngjort i dag.",
        "nl": "De lijst met geslaagden is vandaag bekendgemaakt.",
        "pl": "Lista osób, które zdały, została dziś ogłoszona.",
        "pt": "A lista de aprovados foi anunciada hoje.",
        "ro": "Lista celor care au trecut a fost anunțată azi.",
        "ru": "Сегодня был объявлен список тех, кто прошёл.",
        "sv": "Listan över dem som klarade sig offentliggjordes i dag.",
        "tr": "Başaranların listesi bugün açıklandı.",
        "uk": "Сьогодні оголосили список тих, хто склав.",
        "vi": "Danh sách người đỗ đã được công bố hôm nay.",
        "yue": "今日公佈咗合格名單。",
        "zh-Hans": "今天公布了合格者名单。"
      },
