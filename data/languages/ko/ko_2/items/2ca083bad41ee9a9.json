  "sentences": [
    {
      "target": "비에 젖어서 신발이 더러워졌어요.",
      "reading": "bi-e jeojeoseo sinbari deoreowojyeosseoyo.",
      "translations": {
        "en": "The shoes got dirty from the rain.",
        "ko": "비에 젖어서 신발이 더러워졌어요.",
        "ipa": "bi-e jeojeoseo sinbari deoreowojyeosseoyo.",
        "ar": "ابتلت الأحذية بالمطر فاتسخت.",
        "cs": "Boty se od deště zašpinily.",
        "da": "Skoene blev beskidte af regnen.",
        "de": "Die Schuhe wurden vom Regen schmutzig.",
        "el": "Τα παπούτσια λερώθηκαν από τη βροχή.",
        "es": "Los zapatos se ensuciaron por la lluvia.",
        "fi": "Kengät likaantuivat sateessa.",
        "fr": "Les chaussures se sont salies à cause de la pluie.",
        "he": "הנעליים התלכלכו מהגשם.",
        "hi": "बारिश से जूते गंदे हो गए।",
        "hu": "Az esőtől koszos lett a cipőm.",
        "id": "Sepatunya jadi kotor karena hujan.",
        "it": "Le scarpe si sono sporcate per la pioggia.",
        "ja": "雨にぬれて、靴が汚れました。",
        "nb": "Skoene ble skitne av regnet.",
        "nl": "De schoenen zijn vies geworden door de regen.",
        "pl": "Buty zamoczyły się od deszczu i się pobrudziły.",
        "pt": "Os sapatos ficaram sujos por causa da chuva.",
        "ro": "Pantofii s-au murdărit de la ploaie.",
        "ru": "От дождя ботинки испачкались.",
        "sv": "Skorna blev smutsiga av regnet.",
        "tr": "Ayakkabılar yağmurdan kirlendi.",
        "uk": "Взуття забруднилося від дощу.",
        "vi": "Giày bị bẩn vì mưa.",
        "yue": "對鞋淋雨後變咗污糟。",
        "zh-Hans": "鞋子被雨淋脏了。"
      },
