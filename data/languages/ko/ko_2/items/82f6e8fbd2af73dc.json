    {
      "target": "어릴 때 가난을 겪었어요.",
      "reading": "eoril ttae gananeul gyeokeosseoyo.",
      "translations": {
        "en": "I experienced poverty as a child.",
        "ko": "어릴 때 가난을 겪었어요.",
        "ipa": "eoril ttae gananeul gyeokeosseoyo.",
        "ar": "عانيت الفقر عندما كنت طفلاً.",
        "cs": "V dětství jsem zažil chudobu.",
        "da": "Jeg oplevede fattigdom som barn.",
        "de": "Ich habe als Kind Armut erlebt.",
        "el": "Έζησα τη φτώχεια όταν ήμουν παιδί.",
        "es": "Pasé pobreza de niño.",
        "fi": "Koin köyhyyttä lapsena.",
        "fr": "J’ai connu la pauvreté quand j’étais enfant.",
        "he": "הכרתי עוני כילד.",
        "hi": "मैंने बचपन में गरीबी झेली।",
        "hu": "Gyerekként megtapasztaltam a szegénységet.",
        "id": "Saya mengalami kemiskinan saat kecil.",
        "it": "Ho vissuto la povertà da bambino.",
        "ja": "子どものころに貧乏を経験しました。",
        "nb": "Jeg opplevde fattigdom som barn.",
        "nl": "Ik heb armoede meegemaakt toen ik klein was.",
        "pl": "W dzieciństwie doświadczyłem biedy.",
        "pt": "Passei por pobreza quando era criança.",
        "ro": "Am trăit în sărăcie când eram copil.",
        "ru": "Я испытал бедность в детстве.",
        "sv": "Jag upplevde fattigdom som barn.",
        "tr": "Çocukken yoksulluk yaşadım.",
        "uk": "У дитинстві я зазнав бідності.",
        "vi": "Tôi đã trải qua cảnh nghèo khó khi còn nhỏ.",
        "yue": "我細個嗰陣經歷過窮困。",
        "zh-Hans": "我小时候经历过贫穷。"
      },
