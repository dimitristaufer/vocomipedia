  "sentences": [
    {
      "target": "가난 때문에 이사했어요.",
      "reading": "ganan ttaemune isahaesseoyo.",
      "translations": {
        "en": "We moved because of poverty.",
        "ko": "가난 때문에 이사했어요.",
        "ipa": "ganan ttaemune isahaesseoyo.",
        "ar": "انتقلنا بسبب الفقر.",
        "cs": "Přestěhovali jsme se kvůli chudobě.",
        "da": "Vi flyttede på grund af fattigdom.",
        "de": "Wir sind wegen der Armut umgezogen.",
        "el": "Μετακομίσαμε λόγω της φτώχειας.",
        "es": "Nos mudamos por la pobreza.",
        "fi": "Muutimme köyhyyden vuoksi.",
        "fr": "Nous avons déménagé à cause de la pauvreté.",
        "he": "עברנו דירה בגלל העוני.",
        "hi": "हमने गरीबी की वजह से घर बदला।",
        "hu": "A szegénység miatt költöztünk el.",
        "id": "Kami pindah karena kemiskinan.",
        "it": "Ci siamo trasferiti a causa della povertà.",
        "ja": "貧乏だったので引っ越しました。",
        "nb": "Vi flyttet på grunn av fattigdom.",
        "nl": "We zijn verhuisd vanwege armoede.",
        "pl": "Przeprowadziliśmy się z powodu biedy.",
        "pt": "Nós nos mudamos por causa da pobreza.",
        "ro": "Ne-am mutat din cauza sărăciei.",
        "ru": "Мы переехали из-за бедности.",
        "sv": "Vi flyttade på grund av fattigdom.",
        "tr": "Yoksulluk yüzünden taşındık.",
        "uk": "Ми переїхали через бідність.",
        "vi": "Chúng tôi chuyển nhà vì nghèo khó.",
        "yue": "我哋因為窮而搬咗屋。",
        "zh-Hans": "我们因为贫穷搬家了。"
      },
