  "sentences": [
    {
      "target": "비가 와서 온종일 집에 있었어요.",
      "reading": "biga waseo onjongil jibe isseosseoyo.",
      "translations": {
        "en": "It rained, so I stayed home all day.",
        "ko": "비가 와서 온종일 집에 있었어요.",
        "ipa": "biga waseo onjongil jibe isseosseoyo.",
        "ar": "أمطرت، فبقيت في البيت طوال اليوم.",
        "cs": "Pršelo, tak jsem byl celý den doma.",
        "da": "Det regnede, så jeg blev hjemme hele dagen.",
        "de": "Es regnete, also blieb ich den ganzen Tag zu Hause.",
        "el": "Έβρεχε, οπότε έμεινα σπίτι όλη μέρα.",
        "es": "Llovió, así que me quedé en casa todo el día.",
        "fi": "Satoi, joten olin kotona მთელი päivän.",
        "fr": "Il a plu, alors je suis resté à la maison toute la journée.",
        "he": "ירד גשם, אז נשארתי בבית כל היום.",
        "hi": "बारिश हुई, इसलिए मैं पूरे दिन घर पर रहा।",
        "hu": "Esett az eső, úgyhogy egész nap otthon maradtam.",
        "id": "Hujan turun, jadi saya tinggal di rumah seharian.",
        "it": "Ha piovuto, quindi sono rimasto a casa tutto il giorno.",
        "ja": "雨が降ったので、一日中家にいました。",
        "nb": "Det regnet, så jeg ble hjemme hele dagen.",
        "nl": "Het regende, dus ik bleef de hele dag thuis.",
        "pl": "Padało, więc cały dzień byłem w domu.",
        "pt": "Estava chovendo, então fiquei em casa o dia todo.",
        "ro": "A plouat, așa că am stat acasă toată ziua.",
        "ru": "Шёл дождь, поэтому я весь день был дома.",
        "sv": "Det regnade, så jag stannade hemma hela dagen.",
        "tr": "Yağmur yağıyordu, bu yüzden bütün gün evde kaldım.",
        "uk": "Ішов дощ, тому я цілий день був удома.",
        "vi": "Trời mưa nên tôi ở nhà cả ngày.",
        "yue": "落雨，所以我成日都喺屋企。",
        "zh-Hans": "下雨了，所以我一整天都待在家里。"
      },
