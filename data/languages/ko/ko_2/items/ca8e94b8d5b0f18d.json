    {
      "target": "어제 할머니가 수술을 받으셨어요.",
      "reading": "eoje halmeoniga susureul badeusyeosseoyo",
      "translations": {
        "en": "My grandmother had surgery yesterday.",
        "ko": "어제 할머니가 수술을 받으셨어요.",
        "ipa": "eoje halmeoniga susureul badeusyeosseoyo",
        "ar": "أجرت جدتي عملية جراحية أمس.",
        "cs": "Moje babička měla včera operaci.",
        "da": "Min bedstemor blev opereret i går.",
        "de": "Meine Großmutter wurde gestern operiert.",
        "el": "Η γιαγιά μου έκανε εγχείρηση χθες.",
        "es": "Ayer operaron a mi abuela.",
        "fi": "Isoäitini leikattiin eilen.",
        "fr": "Ma grand-mère a été opérée hier.",
        "he": "סבתא שלי עברה ניתוח אתמול.",
        "hi": "मेरी दादी की कल सर्जरी हुई।",
        "hu": "A nagymamámnak tegnap műtétje volt.",
        "id": "Nenek saya menjalani operasi kemarin.",
        "it": "Mia nonna è stata operata ieri.",
        "ja": "昨日、祖母が手術を受けました。",
        "nb": "Bestemoren min ble operert i går.",
        "nl": "Mijn oma is gisteren geopereerd.",
        "pl": "Moja babcia miała wczoraj operację.",
        "pt": "Minha avó fez uma cirurgia ontem.",
        "ro": "Bunica mea a fost operată ieri.",
        "ru": "Мою бабушку вчера прооперировали.",
        "sv": "Min mormor opererades i går.",
        "tr": "Büyükannem dün ameliyat oldu.",
        "uk": "Мою бабусю вчора прооперували.",
        "vi": "Bà tôi đã phẫu thuật hôm qua.",
        "yue": "我嫲嫲噚日做咗手術。",
        "zh-Hans": "我奶奶昨天做了手术。"
      },
