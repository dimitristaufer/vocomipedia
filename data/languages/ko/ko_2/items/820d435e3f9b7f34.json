  "sentences": [
    {
      "target": "저는 그를 형으로 착각했어요.",
      "reading": "jeoneun geureul hyeong-euro chakkakhaesseoyo.",
      "translations": {
        "en": "I mistook him for my older brother.",
        "ko": "저는 그를 형으로 착각했어요.",
        "ipa": "jeoneun geureul hyeong-euro chakkakhaesseoyo.",
        "ar": "ظننته أخي الأكبر.",
        "cs": "Myslel jsem, že je to můj starší bratr.",
        "da": "Jeg troede, han var min storebror.",
        "de": "Ich habe ihn mit meinem älteren Bruder verwechselt.",
        "el": "Νόμιζα πως ήταν ο μεγάλος μου αδελφός.",
        "es": "Lo confundí con mi hermano mayor.",
        "fi": "Luulin häntä isoveljekseni.",
        "fr": "Je l’ai pris pour mon grand frère.",
        "he": "חשבתי שהוא אחי הגדול.",
        "hi": "मैंने उसे अपना बड़ा भाई समझ लिया था।",
        "hu": "Azt hittem, hogy ő a bátyám.",
        "id": "Saya mengira dia kakak saya.",
        "it": "L'ho scambiato per mio fratello maggiore.",
        "ja": "私は彼を兄と勘違いしました。",
        "nb": "Jeg trodde han var storebroren min.",
        "nl": "Ik dacht dat hij mijn oudere broer was.",
        "pl": "Myślałem, że to mój starszy brat.",
        "pt": "Eu confundi-o com o meu irmão mais velho.",
        "ro": "L-am confundat cu fratele meu mai mare.",
        "ru": "Я принял его за своего старшего брата.",
        "sv": "Jag trodde att han var min storebror.",
        "tr": "Onu ağabeyim sandım.",
        "uk": "Я переплутав його зі своїм старшим братом.",
        "vi": "Tôi tưởng anh ấy là anh trai tôi.",
        "yue": "我以為佢係我哥哥。",
        "zh-Hans": "我以为他是我哥哥。"
      },
