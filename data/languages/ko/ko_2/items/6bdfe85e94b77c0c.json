  "sentences": [
    {
      "target": "그는 사람들 앞에서 말할 때 목소리가 약점이에요.",
      "reading": "geuneun saramdeul apeseo malhal ttae moksoriga yakjeomieyo.",
      "translations": {
        "en": "Speaking in front of people is his weak point.",
        "ko": "그는 사람들 앞에서 말할 때 목소리가 약점이에요.",
        "ipa": "geuneun saramdeul apeseo malhal ttae moksoriga yakjeomieyo.",
        "ar": "التحدث أمام الناس هو نقطة ضعفه.",
        "cs": "Mluvení před lidmi je jeho slabina.",
        "da": "At tale foran andre er hans svage punkt.",
        "de": "Vor Leuten zu sprechen ist seine Schwäche.",
        "el": "Το να μιλά μπροστά σε κόσμο είναι η αδυναμία του.",
        "es": "Hablar delante de la gente es su punto débil.",
        "fi": "Puhuminen ihmisten edessä on hänen heikko kohtansa.",
        "fr": "Parler devant les gens est son point faible.",
        "he": "לדבר מול אנשים הוא נקודת התורפה שלו.",
        "hi": "लोगों के सामने बोलना उसकी कमज़ोरी है।",
        "hu": "Az emberek előtt beszélni az ő gyenge pontja.",
        "id": "Berbicara di depan orang banyak adalah kelemahannya.",
        "it": "Parlare davanti alla gente è il suo punto debole.",
        "ja": "人前で話すのが彼の苦手なところです。",
        "nb": "Å snakke foran folk er hans svake punkt.",
        "nl": "Voor mensen spreken is zijn zwakke punt.",
        "pl": "Mówienie przed ludźmi to jego słaba strona.",
        "pt": "Falar em público é o seu ponto fraco.",
        "ro": "A vorbi în fața oamenilor este punctul lui slab.",
        "ru": "Говорить перед людьми — его слабое место.",
        "sv": "Att prata inför folk är hans svaga punkt.",
        "tr": "İnsanların önünde konuşmak onun zayıf noktasıdır.",
        "uk": "Говорити перед людьми — його слабке місце.",
        "vi": "Nói trước đám đông là điểm yếu của anh ấy.",
        "yue": "喺人哋面前講嘢係佢嘅弱點。",
        "zh-Hans": "当着人们的面说话是他的弱点。"
      },
