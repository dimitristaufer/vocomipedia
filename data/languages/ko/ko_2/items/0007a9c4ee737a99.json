    {
      "target": "천천히 내쉬어 보세요.",
      "reading": "cheoncheonhi naeswieo boseyo.",
      "translations": {
        "en": "Try exhaling slowly.",
        "ko": "천천히 내쉬어 보세요.",
        "ipa": "cheoncheonhi naeswieo boseyo.",
        "ar": "جرّب أن تزفر ببطء.",
        "cs": "Zkuste pomalu vydechnout.",
        "da": "Prøv at puste langsomt ud.",
        "de": "Versuchen Sie langsam auszuatmen.",
        "el": "Δοκιμάστε να εκπνεύσετε αργά.",
        "es": "Intenta exhalar despacio.",
        "fi": "Yritä hengittää ulos hitaasti.",
        "fr": "Essayez d'expirer lentement.",
        "he": "נסה לנשוף לאט.",
        "hi": "धीरे-धीरे साँस बाहर छोड़ने की कोशिश करें।",
        "hu": "Próbálj lassan kifújni a levegőt.",
        "id": "Coba hembuskan napas perlahan.",
        "it": "Prova a espirare lentamente.",
        "ja": "ゆっくり息を吐いてみてください。",
        "nb": "Prøv å puste rolig ut.",
        "nl": "Probeer langzaam uit te ademen.",
