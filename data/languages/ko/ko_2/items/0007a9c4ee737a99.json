    {
      "target": "그는 한숨을 길게 내쉬었다.",
      "reading": "geuneun hansumeul gilge naeswieotda.",
      "translations": {
        "en": "He let out a long sigh.",
        "ko": "그는 한숨을 길게 내쉬었다.",
        "ipa": "geuneun hansumeul gilge naeswieotda.",
        "ar": "أطلق زفرة طويلة.",
        "cs": "Dlouze si povzdechl.",
        "da": "Han sukkede dybt.",
        "de": "Er stieß einen langen Seufzer aus.",
        "el": "Άφησε έναν μακρύ αναστεναγμό.",
        "es": "Soltó un largo suspiro.",
        "fi": "Hän huokaisi pitkään.",
        "fr": "Il a poussé un long soupir.",
        "he": "הוא שחרר אנחה ארוכה.",
        "hi": "उसने लंबी साँस छोड़ी।",
        "hu": "Hosszan felsóhajtott.",
        "id": "Dia menghela napas panjang.",
        "it": "Lui sospirò profondamente.",
        "ja": "彼は長いため息をついた。",
        "nb": "Han sukket dypt.",
        "nl": "Hij slaakte een diepe zucht.",
        "pl": "Westchnął głęboko.",
        "pt": "Ele soltou um longo suspiro.",
        "ro": "A oftat lung.",
        "ru": "Он тяжело вздохнул.",
        "sv": "Han suckade djupt.",
        "tr": "Uzun bir iç çekti.",
        "uk": "Він важко зітхнув.",
        "vi": "Anh ấy thở dài một hơi thật dài.",
        "yue": "佢長長噉嘆咗口氣。",
        "zh-Hans": "他长长地叹了口气。"
      },
