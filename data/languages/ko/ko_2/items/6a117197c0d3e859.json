  "sentences": [
    {
      "target": "그의 등장에 모두 박수를 쳤어요.",
      "reading": "geuui deungjange modu baksureul cheosseoyo.",
      "translations": {
        "en": "Everyone applauded his appearance.",
        "ko": "그의 등장에 모두 박수를 쳤어요.",
        "ipa": "geuui deungjange modu baksureul cheosseoyo.",
        "ar": "صفق الجميع عند ظهوره.",
        "cs": "Všichni mu zatleskali, když se objevil.",
        "da": "Alle klappede, da han kom på scenen.",
        "de": "Alle klatschten bei seinem Auftritt.",
        "el": "Όλοι χειροκρότησαν όταν εμφανίστηκε.",
        "es": "Todos aplaudieron su aparición.",
        "fi": "Kaikki taputtivat hänen tullessaan lavalle.",
        "fr": "Tout le monde a applaudi son apparition.",
        "he": "כולם מחאו כפיים כשהוא הופיע.",
        "hi": "सबने उसके आने पर तालियाँ बजाईं।",
        "hu": "Mindenki megtapsolta, amikor megjelent.",
        "id": "Semua bertepuk tangan saat dia muncul.",
        "it": "Tutti hanno applaudito alla sua apparizione.",
        "ja": "彼の登場にみんなが拍手しました。",
        "nb": "Alle applauderte da han kom på scenen.",
        "nl": "Iedereen applaudisseerde voor zijn optreden.",
        "pl": "Wszyscy bili brawo, gdy się pojawił.",
        "pt": "Todos aplaudiram a sua entrada.",
        "ro": "Toți au aplaudat la apariția lui.",
        "ru": "Все аплодировали его появлению.",
        "sv": "Alla applåderade när han kom in på scenen.",
        "tr": "Herkes onun sahneye çıkışını alkışladı.",
        "uk": "Усі аплодували його появі.",
        "vi": "Mọi người đều vỗ tay khi anh ấy xuất hiện.",
        "yue": "佢一出場，大家都拍手。",
        "zh-Hans": "他一出场，大家都鼓掌了。"
      },
