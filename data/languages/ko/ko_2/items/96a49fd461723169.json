    "ar": [
      "الطفل النعسان يفرك عينيه.",
      "في يوم بارد أفرك يدي.",
      "الأم تخلط البيبيمباب.",
      "الحذاء الجديد يحتك بكعبي."
    ],
    "cs": [
      "Ospalé dítě si tře oči.",
      "V chladný den si třu ruce.",
      "Maminka míchá bibimbap.",
      "Nové boty mě dřou na patách."
    ],
    "da": [
      "Det søvnige barn gnider sig i øjnene.",
      "På en kold dag gnider jeg mine hænder.",
      "Mor rører bibimbapen sammen.",
      "De nye sko gnaver mine hæle."
    ],
    "de": [
      "Das müde Kind reibt sich die Augen.",
      "An einem kalten Tag reibe ich mir die Hände.",
      "Mama mischt das Bibimbap.",
      "Die neuen Schuhe scheuern meine Fersen."
    ],
    "el": [
      "Το νυσταγμένο παιδί τρίβει τα μάτια του.",
      "Την κρύα μέρα τρίβω τα χέρια μου.",
      "Η μαμά ανακατεύει το μπибιμπάπ.",
      "Τα καινούρια παπούτσια μου τρίβουν τις φτέρνες."
    ],
    "es": [
      "El niño somnoliento se frota los ojos.",
      "En un día frío, me froto las manos.",
      "Mamá mezcla el bibimbap.",
      "Los zapatos nuevos me rozan los talones."
    ],
    "fi": [
      "Uninen lapsi hieroo silmiään.",
      "Kylmänä päivänä hieron käsiäni.",
      "Äiti sekoittaa bibimbapia.",
      "Uudet kengät hiertävät kantapäitäni."
    ],
    "fr": [
      "L'enfant endormi se frotte les yeux.",
      "Par temps froid, je me frotte les mains.",
      "Maman mélange le bibimbap.",
      "Les nouvelles chaussures me frottent les talons."
    ],
    "he": [
      "הילד המנומנם משפשף את עיניו.",
      "ביום קר אני משפשף את הידיים.",
      "אמא מערבבת את הביבימבאפ.",
      "הנעליים החדשות משפשפות לי את העקבים."
    ],
    "hi": [
      "नींद में डूबा बच्चा अपनी आँखें मलता है।",
      "ठंडे दिन मैं अपने हाथ मलता हूँ।",
      "माँ बिबिमबाप मिलाती है।",
      "नए जूते मेरी एड़ियों को रगड़ते हैं।"
    ],
    "hu": [
      "A álmos gyerek dörzsöli a szemét.",
      "Hideg napon összedörzsölöm a kezem.",
      "Anya összekeveri a bibimbapot.",
      "Az új cipő kidörzsöli a sarkamat."
    ],
    "id": [
      "Anak yang mengantuk mengucek matanya.",
      "Pada hari yang dingin, saya menggosok tangan saya.",
      "Ibu mengaduk bibimbap.",
      "Sepatu baru itu menggesek tumit saya."
    ],
    "it": [
      "Il bambino assonnato si strofina gli occhi.",
      "In una giornata fredda, mi strofino le mani.",
      "La mamma mescola il bibimbap.",
      "Le scarpe nuove mi sfregano i talloni."
    ],
    "ja": [
      "眠そうな子どもが目をこすっています。",
      "寒い日に手をこすります。",
      "お母さんがビビンバを混ぜています。",
      "新しい靴がかかとをこすります。"
    ],
    "nb": [
      "Det søvnige barnet gnir seg i øynene.",
      "På en kald dag gnir jeg hendene mine.",
      "Mamma blander bibimbap.",
      "De nye skoene gnir mot hælene mine."
    ],
    "nl": [
      "Het slaperige kind wrijft in zijn ogen.",
      "Op een koude dag wrijf ik mijn handen.",
      "Mama mengt de bibimbap.",
      "De nieuwe schoenen schuren tegen mijn hielen."
    ],
    "pl": [
      "Senne dziecko przeciera oczy.",
      "W zimny dzień pocieram ręce.",
      "Mama miesza bibimbap.",
      "Nowe buty obcierają mi pięty."
    ],
    "pt": [
      "A criança sonolenta esfrega os olhos.",
      "Num dia frio, esfrego as mãos.",
      "A mãe mistura o bibimbap.",
      "Os sapatos novos machucam meus calcanhares."
    ],
    "ro": [
      "Copilul somnoros își freacă ochii.",
      "Într-o zi rece, îmi frec mâinile.",
      "Mama amestecă bibimbapul.",
      "Pantofii noi îmi rod călcâiele."
    ],
    "ru": [
      "Сонный ребёнок трёт глаза.",
      "В холодный день я тру руки.",
      "Мама смешивает пибимпап.",
      "Новые туфли натирают мне пятки."
    ],
    "sv": [
      "Det sömniga barnet gnuggar ögonen.",
      "En kall dag gnuggar jag händerna.",
      "Mamma blandar bibimbap.",
      "De nya skorna skaver på mina hälar."
    ],
    "tr": [
      "Uykulu çocuk gözlerini ovuşturuyor.",
      "Soğuk bir günde ellerimi ovuyorum.",
      "Annem bibimbapı karıştırıyor.",
      "Yeni ayakkabılar topuklarımı vuruyor."
    ],
    "uk": [
      "Сонна дитина тре очі.",
      "У холодний день я тру руки.",
      "Мама змішує бібімбап.",
      "Нові туфлі натирають мені п’яти."
    ],
    "vi": [
      "Đứa trẻ ngái ngủ dụi mắt.",
      "Vào ngày lạnh, tôi xoa tay.",
      "Mẹ trộn bibimbap.",
      "Đôi giày mới làm rát gót chân tôi."
    ],
    "yue": [
      "瞓緊嘅小朋友揉眼。",
      "天氣凍嗰日，我揉手。",
      "媽媽拌拌飯。",
      "新鞋磨我嘅腳踭。"
    ],
    "zh-Hans": [
      "困倦的孩子揉眼睛。",
      "在寒冷的天气里，我搓手。",
      "妈妈拌拌饭。",
      "新鞋磨我的脚后跟。"
    ],
