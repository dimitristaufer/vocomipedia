  "sentences": [
    {
      "target": "같은 말을 되풀이하다 보니 지쳤어요.",
      "reading": "gateun mareul doepurihada boni jichyeosseoyo.",
      "translations": {
        "en": "I got tired of repeating the same thing.",
        "ko": "같은 말을 되풀이하다 보니 지쳤어요.",
        "ipa": "gateun mareul doepurihada boni jichyeosseoyo.",
        "ar": "أصبحت متعبًا من تكرار الكلام نفسه.",
        "cs": "Unavilo mě opakovat pořád to samé.",
        "da": "Jeg blev træt af at gentage det samme.",
        "de": "Es hat mich müde gemacht, immer dasselbe zu wiederholen.",
        "el": "Κουράστηκα να επαναλαμβάνω τα ίδια.",
        "es": "Me cansé de repetir lo mismo.",
        "fi": "Väsyin toistamaan samaa asiaa.",
        "fr": "J'en ai eu assez de répéter la même chose.",
        "he": "התעייפתי מלחזור על אותו הדבר.",
        "hi": "एक ही बात दोहराते-दोहराते मैं थक गया।",
        "hu": "Elfáradtam attól, hogy ugyanazt ismételjem.",
        "id": "Saya capek mengulang-ulang hal yang sama.",
        "it": "Mi sono stancato di ripetere la stessa cosa.",
        "ja": "同じことを繰り返していたら疲れました。",
        "nb": "Jeg ble lei av å gjenta det samme.",
        "nl": "Ik werd moe van steeds hetzelfde te herhalen.",
        "pl": "Zmęczyło mnie powtarzanie tego samego.",
        "pt": "Fiquei cansado de repetir a mesma coisa.",
        "ro": "M-am săturat să repet același lucru.",
        "ru": "Я устал повторять одно и то же.",
        "sv": "Jag blev trött på att upprepa samma sak.",
        "tr": "Aynı şeyi tekrar etmekten yoruldum.",
        "uk": "Я втомився повторювати одне й те саме.",
        "vi": "Tôi đã mệt vì cứ lặp lại cùng một điều.",
        "yue": "我重複同一句說話，重複到攰晒。",
        "zh-Hans": "我一直重复同样的话，都累了。"
      },
