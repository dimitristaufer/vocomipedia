  "sentences": [
    {
      "target": "공원 벤치 아래에서 지갑이 발견되었어요.",
      "reading": "gongwon benchi araeseo jigabi balgyeondoeeosseoyo.",
      "translations": {
        "en": "A wallet was found under a park bench.",
        "ko": "공원 벤치 아래에서 지갑이 발견되었어요.",
        "ipa": "gongwon benchi araeseo jigabi balgyeondoeeosseoyo.",
        "ar": "وُجِدَت محفظة تحت مقعد في الحديقة.",
        "cs": "Pod lavičkou v parku byla nalezena peněženka.",
        "da": "Der blev fundet en pung under en parkbænk.",
        "de": "Unter einer Parkbank wurde eine Geldbörse gefunden.",
        "el": "Βρέθηκε ένα πορτοφόλι κάτω από ένα παγκάκι στο πάρκο.",
        "es": "Se encontró una cartera debajo de un banco del parque.",
        "fi": "Puistonpenkin alta löytyi lompakko.",
        "fr": "Un portefeuille a été trouvé sous un banc du parc.",
        "he": "ארנק נמצא מתחת לספסל בפארק.",
        "hi": "पार्क की बेंच के नीचे एक बटुआ मिला।",
        "hu": "Egy pénztárcát találtak a parkban egy pad alatt.",
        "id": "Dompet ditemukan di bawah bangku taman.",
        "it": "È stato trovato un portafoglio sotto una panchina del parco.",
        "ja": "公園のベンチの下で財布が見つかりました。",
        "nb": "En lommebok ble funnet under en parkbenk.",
        "nl": "Onder een bankje in het park werd een portemonnee gevonden.",
        "pl": "Pod ławką w parku znaleziono portfel.",
        "pt": "Foi encontrada uma carteira debaixo de um banco do parque.",
        "ro": "Un portofel a fost găsit sub o bancă din parc.",
        "ru": "Под скамейкой в парке нашли кошелек.",
        "sv": "En plånbok hittades under en parkbänk.",
        "tr": "Park bankının altında bir cüzdan bulundu.",
        "uk": "Під лавкою в парку знайшли гаманець.",
        "vi": "Một chiếc ví đã được tìm thấy dưới ghế đá công viên.",
        "yue": "喺公園長櫈下面搵到個銀包。",
        "zh-Hans": "在公园长椅下面找到了一个钱包。"
      },
