  "sentences": [
    {
      "target": "이것이 우리 팀의 최후의 승리였어요.",
      "reading": "igeosi uri tim-ui choehu-ui seungni-ieosseoyo.",
      "translations": {
        "en": "This was our team's final victory.",
        "ko": "이것이 우리 팀의 최후의 승리였어요.",
        "ipa": "igeosi uri tim-ui choehu-ui seungni-ieosseoyo.",
        "ar": "كان هذا الانتصار الأخير لفريقنا.",
        "cs": "Bylo to poslední vítězství našeho týmu.",
        "da": "Det her var vores holds sidste sejr.",
        "de": "Das war der letzte Sieg unseres Teams.",
        "el": "Αυτή ήταν η τελευταία νίκη της ομάδας μας.",
        "es": "Esta fue la última victoria de nuestro equipo.",
        "fi": "Tämä oli joukkueemme viimeinen voitto.",
        "fr": "C'était la dernière victoire de notre équipe.",
        "he": "זו הייתה הניצחון האחרון של הקבוצה שלנו.",
        "hi": "यह हमारी टीम की आखिरी जीत थी।",
        "hu": "Ez volt a csapatunk utolsó győzelme.",
        "id": "Ini adalah kemenangan terakhir tim kami.",
        "it": "Questa è stata l'ultima vittoria della nostra squadra.",
        "ja": "これは私たちのチームの最後の勝利でした。",
        "nb": "Dette var lagets siste seier.",
        "nl": "Dit was de laatste overwinning van ons team.",
        "pl": "To było ostatnie zwycięstwo naszej drużyny.",
        "pt": "Esta foi a última vitória da nossa equipe.",
        "ro": "Aceasta a fost ultima victorie a echipei noastre.",
        "ru": "Это была последняя победа нашей команды.",
        "sv": "Det här var vårt lags sista seger.",
        "tr": "Bu, takımımızın son galibiyetiydi.",
        "uk": "Це була остання перемога нашої команди.",
        "vi": "Đây là chiến thắng cuối cùng của đội chúng tôi.",
        "yue": "呢個係我哋隊最後嘅勝利。",
        "zh-Hans": "这是我们队最后的胜利。"
