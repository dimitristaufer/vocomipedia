  "sentences": [
    {
      "target": "저는 헌 옷을 버리지 못해요.",
      "reading": "jeoneun heon oseul beoriji mothaeyo.",
      "translations": {
        "en": "I can’t bring myself to throw away old clothes.",
        "ko": "저는 헌 옷을 버리지 못해요.",
        "ipa": "jeoneun heon oseul beoriji mothaeyo.",
        "ar": "لا أستطيع أن أرمي الملابس القديمة.",
        "cs": "Nemůžu vyhodit staré oblečení.",
        "da": "Jeg kan ikke få mig selv til at smide gammelt tøj ud.",
        "de": "Ich kann mich nicht dazu bringen, alte Kleidung wegzuwerfen.",
        "el": "Δεν μπορώ να πετάξω τα παλιά ρούχα μου.",
        "es": "No puedo tirar mi ropa vieja.",
        "fi": "En saa heitettyä vanhoja vaatteita pois.",
        "fr": "Je n’arrive pas à jeter mes vieux vêtements.",
        "he": "אני לא מצליח לזרוק את הבגדים הישנים שלי.",
        "hi": "मैं अपने पुराने कपड़े फेंक नहीं पाता।",
        "hu": "Nem bírom kidobni a régi ruháimat.",
        "id": "Saya tidak tega membuang pakaian lama.",
        "it": "Non riesco a buttare via i vestiti vecchi.",
        "ja": "古い服を捨てられません。",
        "nb": "Jeg klarer ikke å kaste gamle klær.",
        "nl": "Ik kan mijn oude kleren niet weggooien.",
        "pl": "Nie mogę wyrzucić starych ubrań.",
        "pt": "Não consigo jogar fora minhas roupas velhas.",
        "ro": "Nu pot să arunc hainele vechi.",
        "ru": "Я не могу выбросить старую одежду.",
        "sv": "Jag kan inte förmå mig att slänga gamla kläder.",
        "tr": "Eski kıyafetlerimi atmaya kıyamıyorum.",
        "uk": "Я не можу викинути старий одяг.",
        "vi": "Tôi không nỡ bỏ quần áo cũ.",
        "yue": "我唔捨得掉啲舊衫。",
        "zh-Hans": "我不忍心扔掉旧衣服。"
      },
