    {
      "target": "아나운서가 뉴스를 차분하게 읽었습니다.",
      "reading": "anaunseoga nyuseureul chabunhage ilgeotseumnida.",
      "translations": {
        "en": "The announcer read the news calmly.",
        "ko": "아나운서가 뉴스를 차분하게 읽었습니다.",
        "ipa": "anaunseoga nyuseureul chabunhage ilgeotseumnida.",
        "ar": "قرأ المذيع الأخبار بهدوء.",
        "cs": "Hlasatel přečetl zprávy klidně.",
        "da": "Oplæseren læste nyhederne roligt op.",
        "de": "Der Sprecher las die Nachrichten ruhig vor.",
        "el": "Ο εκφωνητής διάβασε ήρεμα τις ειδήσεις.",
        "es": "El locutor leyó las noticias con calma.",
        "fi": "Kuuluttaja luki uutiset rauhallisesti.",
        "fr": "L'annonceur a lu les informations calmement.",
        "he": "המגיש קרא את החדשות בשלווה.",
        "hi": "उद्घोषक ने समाचार शांति से पढ़ा।",
        "hu": "A bemondó nyugodtan felolvasta a híreket.",
        "id": "Pembawa acara itu membacakan berita dengan tenang.",
        "it": "Il presentatore ha letto le notizie con calma.",
        "ja": "アナウンサーは落ち着いてニュースを読みました。",
        "nb": "Programlederen leste nyhetene rolig.",
        "nl": "De omroeper las het nieuws rustig voor.",
        "pl": "Spiker spokojnie czytał wiadomości.",
        "pt": "O locutor leu as notícias com calma.",
        "ro": "Prezentatorul a citit știrile calm.",
        "ru": "Диктор спокойно прочитал новости.",
        "sv": "Programledaren läste nyheterna lugnt.",
        "tr": "Spiker haberleri sakin bir şekilde okudu.",
        "uk": "Диктор спокійно читав новини.",
        "vi": "Người phát thanh viên đọc tin tức rất bình tĩnh.",
        "yue": "播音員平靜咁讀咗新聞。",
        "zh-Hans": "播音员平静地读了新闻。"
      },
