    {
      "target": "어제 TV에서 유명한 아나운서를 봤어요.",
      "reading": "eoje TVeseo yumyeonghan anaunseoreul bwasseoyo.",
      "translations": {
        "en": "I saw a famous announcer on TV yesterday.",
        "ko": "어제 TV에서 유명한 아나운서를 봤어요.",
        "ipa": "eoje TVeseo yumyeonghan anaunseoreul bwasseoyo.",
        "ar": "رأيت مذيعًا مشهورًا على التلفاز أمس.",
        "cs": "Včera jsem v televizi viděl slavného hlasatele.",
        "da": "Jeg så en berømt oplæser i fjernsynet i går.",
        "de": "Ich habe gestern einen berühmten Sprecher im Fernsehen gesehen.",
        "el": "Είδα χθες έναν διάσημο εκφωνητή στην τηλεόραση.",
        "es": "Ayer vi a un locutor famoso en la tele.",
        "fi": "Näin eilen kuuluisan kuuluttajan televisiossa.",
        "fr": "J'ai vu un annonceur célèbre à la télévision hier.",
        "he": "ראיתי אתמול מגיש מפורסם בטלוויזיה.",
        "hi": "मैंने कल टीवी पर एक मशहूर उद्घोषक को देखा।",
        "hu": "Tegnap láttam egy híres bemondót a tévében.",
        "id": "Kemarin saya melihat pembawa acara terkenal di TV.",
        "it": "Ieri ho visto un presentatore famoso in TV.",
        "ja": "昨日、テレビで有名なアナウンサーを見ました。",
        "nb": "Jeg så en kjent programleder på TV i går.",
        "nl": "Ik zag gisteren een beroemde omroeper op tv.",
        "pl": "Wczoraj zobaczyłem w telewizji znanego spikera.",
        "pt": "Ontem vi um locutor famoso na TV.",
        "ro": "L-am văzut ieri la televizor pe un prezentator celebru.",
        "ru": "Вчера я видел по телевизору известного диктора.",
        "sv": "Jag såg en känd programledare på tv i går.",
        "tr": "Dün televizyonda ünlü bir spiker gördüm.",
        "uk": "Учора я бачив по телевізору відомого диктора.",
        "vi": "Hôm qua tôi đã xem một phát thanh viên nổi tiếng trên tivi.",
        "yue": "我噚日喺電視見到一位出名嘅播音員。",
        "zh-Hans": "昨天我在电视上看到了一位著名的播音员。"
      },
