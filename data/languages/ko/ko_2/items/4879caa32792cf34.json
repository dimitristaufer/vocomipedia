  "sentences": [
    {
      "target": "수업 시간에는 선생님 말씀에 집중해요.",
      "reading": "su-eop siganeneun seonsaengnim malsseume jipjunghaeyo.",
      "translations": {
        "en": "I focus on the teacher's words during class.",
        "ko": "수업 시간에는 선생님 말씀에 집중해요.",
        "ipa": "su-eop siganeneun seonsaengnim malsseume jipjunghaeyo.",
        "ar": "أركز على كلام المعلمة في الحصة.",
        "cs": "Během vyučování se soustředím na učitelova slova.",
        "da": "I timen fokuserer jeg på lærerens ord.",
        "de": "Im Unterricht konzentriere ich mich auf die Worte der Lehrerin.",
        "el": "Στην τάξη συγκεντρώνομαι στα λόγια του δασκάλου.",
        "es": "En clase, me concentro en lo que dice la profesora.",
        "fi": "Tunnilla keskityn opettajan sanoihin.",
        "fr": "En classe, je me concentre sur les paroles du professeur.",
        "he": "בשיעור אני מתרכז בדברים של המורה.",
        "hi": "क्लास में मैं शिक्षक की बातों पर ध्यान देता हूँ।",
        "hu": "Órán a tanár szavaira figyelek.",
        "id": "Di kelas, saya fokus pada kata-kata guru.",
        "it": "In classe mi concentro sulle parole dell'insegnante.",
        "ja": "授業中は先生の話に集中します。",
        "nb": "I timen konsentrerer jeg meg om det læreren sier.",
        "nl": "In de les let ik goed op wat de leraar zegt.",
        "pl": "Na lekcji skupiam się na słowach nauczyciela.",
        "pt": "Na aula, eu me concentro no que a professora diz.",
        "ro": "La oră mă concentrez pe ce spune profesorul.",
        "ru": "На уроке я сосредотачиваюсь на словах учителя.",
        "sv": "På lektionen fokuserar jag på lärarens ord.",
        "tr": "Derste öğretmenin söylediklerine odaklanıyorum.",
        "uk": "На уроці я зосереджуюся на словах учителя.",
        "vi": "Trong giờ học, tôi tập trung vào lời của cô giáo.",
        "yue": "喺堂上，我專心聽老師講嘅說話。",
        "zh-Hans": "上课时，我专注听老师的话。"
      },
