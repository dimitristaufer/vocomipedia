    {
      "target": "저는 유학 준비를 하고 있어요.",
      "reading": "jeoneun yuhak junbireul hago isseoyo.",
      "translations": {
        "en": "I’m preparing to study abroad.",
        "ko": "저는 유학 준비를 하고 있어요.",
        "ipa": "jeoneun yuhak junbireul hago isseoyo.",
        "ar": "أستعد للدراسة في الخارج.",
        "cs": "Připravuji se na studium v zahraničí.",
        "da": "Jeg forbereder mig på at studere i udlandet.",
