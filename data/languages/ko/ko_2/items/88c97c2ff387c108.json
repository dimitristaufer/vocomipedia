  "sentences": [
    {
      "target": "저는 그 제안에 찬성을 했어요.",
      "reading": "jeoneun geu jaane chanseongeul haesseoyo.",
      "translations": {
        "en": "I approved the proposal.",
        "ko": "저는 그 제안에 찬성을 했어요.",
        "ipa": "jeoneun geu jaane chanseongeul haesseoyo.",
        "ar": "وافقت على الاقتراح.",
        "cs": "Schválil jsem ten návrh.",
        "da": "Jeg godkendte forslaget.",
        "de": "Ich habe dem Vorschlag zugestimmt.",
        "el": "Συμφώνησα με την πρόταση.",
        "es": "Aprobé la propuesta.",
        "fi": "Hyväksyin ehdotuksen.",
        "fr": "J’ai approuvé la proposition.",
        "he": "אישרתי את ההצעה.",
        "hi": "मैंने उस प्रस्ताव को मंजूरी दी।",
        "hu": "Jóváhagytam a javaslatot.",
        "id": "Saya menyetujui usulan itu.",
        "it": "Ho approvato la proposta.",
        "ja": "私はその提案に賛成しました。",
        "nb": "Jeg godkjente forslaget.",
        "nl": "Ik keurde het voorstel goed.",
        "pl": "Zatwierdziłem ten pomysł.",
        "pt": "Eu aprovei a proposta.",
        "ro": "Am aprobat propunerea.",
        "ru": "Я одобрил это предложение.",
        "sv": "Jag godkände förslaget.",
        "tr": "Öneriyi onayladım.",
        "uk": "Я схвалив цю пропозицію.",
        "vi": "Tôi đã tán thành đề xuất đó.",
        "yue": "我贊成咗嗰個提議。",
        "zh-Hans": "我赞成了那个提议。"
      },
