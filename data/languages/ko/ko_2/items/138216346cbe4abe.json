  "sentences": [
    {
      "target": "그는 외모보다 성격이 더 좋다.",
      "reading": "geuneun oemoboda seonggyeogi deo jota.",
      "translations": {
        "en": "He has a better personality than looks.",
        "ko": "그는 외모보다 성격이 더 좋다.",
        "ipa": "geuneun oemoboda seonggyeogi deo jota.",
        "ar": "شخصيته أفضل من مظهره.",
        "cs": "Má lepší povahu než vzhled.",
        "da": "Han har en bedre personlighed end udseende.",
        "de": "Er hat ein besseres Wesen als Aussehen.",
        "el": "Έχει καλύτερο χαρακτήρα παρά εμφάνιση.",
        "es": "Tiene mejor carácter que apariencia.",
        "fi": "Hänen luonteensa on parempi kuin ulkonäkönsä.",
        "fr": "Il a une meilleure personnalité que son apparence.",
        "he": "יש לו אופי טוב יותר מאשר מראה.",
        "hi": "उसका स्वभाव उसकी शक्ल-सूरत से बेहतर है।",
        "hu": "A személyisége jobb, mint a külseje.",
        "id": "Kepribadiannya lebih baik daripada penampilannya.",
        "it": "Ha una personalità migliore dell'aspetto.",
        "ja": "彼は見た目より性格がいい。",
        "nb": "Han har bedre personlighet enn utseende.",
        "nl": "Hij heeft een beter karakter dan uiterlijk.",
        "pl": "Ma lepszy charakter niż wygląd.",
        "pt": "Ele tem uma personalidade melhor do que a aparência.",
        "ro": "Are o personalitate mai bună decât aspectul.",
        "ru": "У него характер лучше, чем внешность.",
        "sv": "Han har bättre personlighet än utseende.",
        "tr": "Görünüşünden çok karakteri daha iyi.",
        "uk": "У нього характер кращий, ніж зовнішність.",
        "vi": "Tính cách của anh ấy tốt hơn ngoại hình.",
        "yue": "佢嘅性格比樣貌好。",
        "zh-Hans": "他的性格比外貌更好。"
      },
