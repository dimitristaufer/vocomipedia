    {
      "target": "그 사람의 국적은 한국입니다.",
      "reading": "geu saramui gukjeogeun hangugimnida",
      "translations": {
        "en": "That person's nationality is Korea.",
        "ko": "그 사람의 국적은 한국입니다.",
        "ipa": "geu saramui gukjeogeun hangugimnida",
        "ar": "جنسية ذلك الشخص هي كوريا.",
        "cs": "Národnost toho člověka je korejská.",
        "da": "Den persons nationalitet er koreansk.",
        "de": "Die Nationalität dieser Person ist koreanisch.",
        "el": "Η εθνικότητα αυτού του ατόμου είναι κορεατική.",
        "es": "La nacionalidad de esa persona es coreana.",
        "fi": "Tuon henkilön kansalaisuus on korealainen.",
        "fr": "La nationalité de cette personne est coréenne.",
        "he": "הלאום של האדם הזה הוא קוריאני.",
        "hi": "उस व्यक्ति की राष्ट्रीयता कोरियाई है।",
        "hu": "Annak az embernek a nemzetisége koreai.",
        "id": "Kewarganegaraan orang itu adalah Korea.",
        "it": "La nazionalità di quella persona è coreana.",
        "ja": "その人の国籍は韓国です。",
        "nb": "Den personens nasjonalitet er koreansk.",
        "nl": "De nationaliteit van die persoon is Koreaans.",
        "pl": "Narodowość tej osoby to koreańska.",
        "pt": "A nacionalidade dessa pessoa é coreana.",
        "ro": "Naționalitatea acelei persoane este coreeană.",
        "ru": "Гражданство этого человека — корейское.",
        "sv": "Den personens nationalitet är koreansk.",
        "tr": "O kişinin uyruğu Koreli.",
        "uk": "Громадянство цієї людини — корейське.",
        "vi": "Quốc tịch của người đó là Hàn Quốc.",
        "yue": "嗰個人嘅國籍係韓國。",
        "zh-Hans": "那个人的国籍是韩国。"
