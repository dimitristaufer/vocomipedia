    {
      "target": "국에 소금을 조금 가해 보세요.",
      "reading": "gug-e sogeumeul jogeum gahae boseyo",
      "translations": {
        "en": "Try adding a little salt to the soup.",
        "ko": "국에 소금을 조금 가해 보세요.",
        "ipa": "gug-e sogeumeul jogeum gahae boseyo",
