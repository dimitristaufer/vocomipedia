    {
      "target": "드디어 본격적인 여름이 왔어요.",
      "reading": "deudieo bongyeokjeogin yeoreumi wasseoyo.",
      "translations": {
        "en": "Summer has finally begun in earnest.",
        "ko": "드디어 본격적인 여름이 왔어요.",
        "ipa": "deudieo bongyeokjeogin yeoreumi wasseoyo.",
        "ar": "أخيرًا بدأ الصيف فعليًا.",
        "cs": "Konečně přišlo pořádné léto.",
        "da": "Endelig er sommeren for alvor begyndt.",
        "de": "Endlich hat der Sommer richtig begonnen.",
        "el": "Επιτέλους ήρθε για τα καλά το καλοκαίρι.",
        "es": "Por fin ha empezado el verano de verdad.",
        "fi": "Lopulta kesä on alkanut toden teolla.",
        "fr": "L'été a enfin commencé pour de bon.",
        "he": "הקיץ סוף סוף התחיל באמת.",
        "hi": "आखिरकार गर्मी पूरी तरह आ गई है।",
        "hu": "Végre igazán elkezdődött a nyár.",
        "id": "Akhirnya musim panas benar-benar tiba.",
        "it": "Finalmente è arrivata davvero l'estate.",
        "ja": "ついに本格的な夏が来ました。",
        "nb": "Endelig har sommeren kommet for alvor.",
        "nl": "Eindelijk is de zomer echt begonnen.",
        "pl": "W końcu nadeszło prawdziwe lato.",
        "pt": "Finalmente o verão começou de verdade.",
        "ro": "În sfârșit a început vara cu adevărat.",
        "ru": "Наконец-то наступило настоящее лето.",
        "sv": "Äntligen har sommaren kommit på allvar.",
        "tr": "Sonunda yaz tam anlamıyla geldi.",
        "uk": "Нарешті літо по-справжньому настало.",
        "vi": "Cuối cùng thì mùa hè cũng thực sự đến rồi.",
        "yue": "夏天終於真正開始咗。",
        "zh-Hans": "夏天终于真正开始了。"
      },
