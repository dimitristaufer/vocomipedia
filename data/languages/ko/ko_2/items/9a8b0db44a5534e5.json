  "sentences": [
    {
      "target": "아저씨가 혼잣말로 중얼거렸어요.",
      "reading": "ajeossiga honjatmalro jungeolgeoryeosseoyo.",
      "translations": {
        "en": "The man muttered to himself.",
        "ko": "아저씨가 혼잣말로 중얼거렸어요.",
        "ipa": "ajeossiga honjatmalro jungeolgeoryeosseoyo.",
        "ar": "تمتم الرجل لنفسه.",
        "cs": "Muž si pro sebe zamumlal.",
        "da": "Manden mumlede for sig selv.",
        "de": "Der Mann murmelte vor sich hin.",
        "el": "Ο άντρας μουρμούρισε στον εαυτό του.",
        "es": "El hombre murmuró para sí mismo.",
        "fi": "Mies mumisi itsekseen.",
        "fr": "L'homme marmonnait pour lui-même.",
        "he": "האיש מלמל לעצמו.",
        "hi": "आदमी अपने आप से बड़बड़ा रहा था।",
        "hu": "A férfi magában motyogott.",
        "id": "Pria itu bergumam pada dirinya sendiri.",
        "it": "L'uomo borbottò tra sé.",
        "ja": "その男性は独り言をつぶやきました。",
        "nb": "Mannen mumlet for seg selv.",
        "nl": "De man mompelde in zichzelf.",
        "pl": "Mężczyzna mamrotał do siebie.",
        "pt": "O homem resmungou para si mesmo.",
        "ro": "Bărbatul mormăia pentru el.",
        "ru": "Мужчина бормотал себе под нос.",
        "sv": "Mannen mumlade för sig själv.",
        "tr": "Adam kendi kendine mırıldandı.",
        "uk": "Чоловік бурмотів собі під ніс.",
        "vi": "Người đàn ông lẩm bẩm một mình.",
        "yue": "個男人自言自語咁喃喃自語。",
        "zh-Hans": "那个男人自言自语地嘟囔着。"
      },
