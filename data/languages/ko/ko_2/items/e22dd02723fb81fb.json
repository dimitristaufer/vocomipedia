    {
      "target": "선생님이 학생들을 교실 밖으로 내보냈어요.",
      "reading": "seonsaengnimi haksaengdeureul gyosil bakkeuro naebonaesseoyo.",
      "translations": {
        "en": "The teacher sent the students out of the classroom.",
        "ko": "선생님이 학생들을 교실 밖으로 내보냈어요.",
        "ipa": "seonsaengnimi haksaengdeureul gyosil bakkeuro naebonaesseoyo.",
        "ar": "أخرج المعلم الطلاب من الفصل.",
        "cs": "Učitel poslal studenty ze třídy ven.",
        "da": "Læreren sendte eleverne ud af klasseværelset.",
        "de": "Der Lehrer schickte die Schüler aus dem Klassenzimmer.",
        "el": "Ο δάσκαλος έστειλε τους μαθητές έξω από την τάξη.",
        "es": "El profesor sacó a los estudiantes del aula.",
        "fi": "Opettaja lähetti oppilaat ulos luokasta.",
        "fr": "Le professeur a fait sortir les élèves de la classe.",
        "he": "המורה הוציא את התלמידים מהכיתה.",
        "hi": "शिक्षक ने छात्रों को कक्षा से बाहर भेज दिया।",
        "hu": "A tanár kiküldte a diákokat a teremből.",
        "id": "Guru menyuruh para siswa keluar dari kelas.",
        "it": "L'insegnante ha mandato gli studenti fuori dall'aula.",
        "ja": "先生が生徒たちを教室の外に出しました。",
        "nb": "Læreren sendte elevene ut av klasserommet.",
        "nl": "De leraar stuurde de leerlingen het klaslokaal uit.",
        "pl": "Nauczyciel wyprowadził uczniów z klasy.",
        "pt": "O professor mandou os alunos para fora da sala.",
        "ro": "Profesorul i-a scos pe elevi din clasă.",
        "ru": "Учитель выгнал учеников из класса.",
        "sv": "Läraren skickade ut eleverna ur klassrummet.",
        "tr": "Öğretmen öğrencileri sınıftan dışarı gönderdi.",
        "uk": "Учитель вивів учнів із класу.",
        "vi": "Thầy giáo cho học sinh ra khỏi lớp.",
        "yue": "老師叫學生出咗課室。",
        "zh-Hans": "老师把学生们赶出了教室。"
      },
