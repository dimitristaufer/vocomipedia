  "sentences": [
    {
      "target": "집에 가는 길에 편의점에 들렀어요.",
      "reading": "Jibe ganeun gire pyeonuijeome deulleosseoyo.",
      "translations": {
        "en": "I stopped by a convenience store on my way home.",
        "ko": "집에 가는 길에 편의점에 들렀어요.",
        "ipa": "Jibe ganeun gire pyeonuijeome deulleosseoyo.",
        "ar": "توقفت عند متجر صغير في طريقي إلى المنزل.",
        "cs": "Cestou domů jsem se zastavil v samoobsluze.",
        "da": "Jeg stoppede ved en kiosk på vej hjem.",
        "de": "Ich habe auf dem Heimweg im Laden angehalten.",
        "el": "Πέρασα από ένα ψιλικατζίδικο στον δρόμο για το σπίτι.",
        "es": "Me paré en una tienda de conveniencia de camino a casa.",
        "fi": "Pysähdyin kotimatkalla lähikauppaan.",
        "fr": "Je me suis arrêté dans une supérette en rentrant chez moi.",
        "he": "עברתי במכולת בדרך הביתה.",
        "hi": "मैं घर जाते समय एक किराने की दुकान पर रुका।",
        "hu": "Hazafelé megálltam egy kisboltban.",
        "id": "Saya mampir ke minimarket dalam perjalanan pulang.",
        "it": "Mi sono fermato in un minimarket sulla strada di casa.",
        "ja": "家に帰る途中でコンビニに寄りました。",
        "nb": "Jeg stoppet innom en kiosk på vei hjem.",
        "nl": "Ik stopte onderweg naar huis even bij een buurtwinkel.",
        "pl": "W drodze do domu wstąpiłem do sklepu spożywczego.",
        "pt": "Passei numa loja de conveniência no caminho para casa.",
        "ro": "M-am oprit la un magazin de pe drum spre casă.",
        "ru": "По дороге домой я зашёл в магазин.",
        "sv": "Jag stannade till i en närbutik på väg hem.",
        "tr": "Eve giderken bir markete uğradım.",
        "uk": "Дорогою додому я зайшов у крамницю.",
        "vi": "Tôi ghé qua một cửa hàng tiện lợi trên đường về nhà.",
        "yue": "我喺返屋企嘅路上順便去咗便利店。",
        "zh-Hans": "我在回家的路上顺便去了便利店。"
      },
