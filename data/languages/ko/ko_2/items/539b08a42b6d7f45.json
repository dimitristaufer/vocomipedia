    {
      "target": "뉴스에서 미사일 발사를 봤어요.",
      "reading": "nyuseueseo misail balssareul bwasseoyo.",
      "translations": {
        "en": "I saw a missile launch on the news.",
        "ko": "뉴스에서 미사일 발사를 봤어요.",
        "ipa": "nyuseueseo misail balssareul bwasseoyo.",
        "ar": "رأيت إطلاق صاروخ في الأخبار.",
        "cs": "Viděl jsem vypuštění rakety ve zprávách.",
        "da": "Jeg så en raketopsendelse i nyhederne.",
        "de": "Ich habe in den Nachrichten einen Raketenstart gesehen.",
        "el": "Είδα μια εκτόξευση πυραύλου στις ειδήσεις.",
        "es": "Vi el lanzamiento de un misil en las noticias.",
        "fi": "Näin uutisissa ohjuksen laukaisun.",
        "fr": "J’ai vu un lancement de missile aux informations.",
        "he": "ראיתי שיגור טיל בחדשות.",
        "hi": "मैंने खबरों में मिसाइल का प्रक्षेपण देखा।",
        "hu": "Láttam egy rakétaindítást a hírekben.",
        "id": "Saya melihat peluncuran misil di berita.",
        "it": "Ho visto il lancio di un missile al telegiornale.",
        "ja": "ニュースでミサイルの発射を見ました。",
        "nb": "Jeg så en rakettoppskytning i nyhetene.",
        "nl": "Ik zag een raketlancering op het nieuws.",
        "pl": "W wiadomościach widziałem wystrzelenie rakiety.",
        "pt": "Vi o lançamento de um míssil no noticiário.",
        "ro": "Am văzut lansarea unei rachete la știri.",
        "ru": "Я видел запуск ракеты в новостях.",
        "sv": "Jag såg en raketuppskjutning på nyheterna.",
        "tr": "Haberlerde bir füze fırlatılışını gördüm.",
        "uk": "Я бачив запуск ракети в новинах.",
        "vi": "Tôi đã xem vụ phóng tên lửa trên bản tin.",
        "yue": "我喺新聞睇到導彈發射。",
        "zh-Hans": "我在新闻里看到了导弹发射。"
      },
