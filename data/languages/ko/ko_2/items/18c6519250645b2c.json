  "sentences": [
    {
      "target": "우리는 강변을 따라 걸었어요.",
      "reading": "urineun gangbyeoneul ttara georeosseoyo.",
      "translations": {
        "en": "We walked along the riverside.",
        "ko": "우리는 강변을 따라 걸었어요.",
        "ipa": "urineun gangbyeoneul ttara georeosseoyo.",
        "ar": "مشينا على طول ضفة النهر.",
        "cs": "Procházeli jsme se podél nábřeží.",
        "da": "Vi gik langs floden.",
        "de": "Wir sind am Ufer entlang spaziert.",
        "el": "Περπατήσαμε κατά μήκος της όχθης του ποταμού.",
        "es": "Caminamos por la orilla del río.",
        "fi": "Kävelimme joen vartta pitkin.",
        "fr": "Nous avons marché le long de la rive.",
        "he": "הלכנו לאורך גדת הנהר.",
        "hi": "हम नदी किनारे चले।",
        "hu": "A folyópart mentén sétáltunk.",
        "id": "Kami berjalan di sepanjang tepi sungai.",
        "it": "Abbiamo camminato lungo la riva del fiume.",
        "ja": "私たちは川沿いを歩きました。",
        "nb": "Vi gikk langs elvebredden.",
        "nl": "We liepen langs de rivier.",
        "pl": "Spacerowaliśmy wzdłuż brzegu rzeki.",
        "pt": "Nós caminhamos pela margem do rio.",
        "ro": "Am mers pe lângă malul râului.",
        "ru": "Мы шли вдоль берега реки.",
        "sv": "Vi gick längs flodstranden.",
        "tr": "Nehir kıyısı boyunca yürüdük.",
        "uk": "Ми гуляли вздовж берега річки.",
        "vi": "Chúng tôi đi bộ dọc bờ sông.",
        "yue": "我哋沿住河邊行。",
        "zh-Hans": "我们沿着河边走。"
      },
