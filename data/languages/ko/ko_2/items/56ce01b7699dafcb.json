  "sentences": [
    {
      "target": "저는 복이 많아서 늘 감사해요.",
      "reading": "jeoneun bogi manaseo neul gamsahaeyo.",
      "translations": {
        "en": "I'm lucky, so I'm always grateful.",
        "ko": "저는 복이 많아서 늘 감사해요.",
        "ipa": "jeoneun bogi manaseo neul gamsahaeyo.",
        "ar": "أنا محظوظ، لذلك أنا ممتن دائمًا.",
        "cs": "Mám hodně štěstí, takže jsem pořád vděčný.",
        "da": "Jeg er heldig, så jeg er altid taknemmelig.",
        "de": "Ich habe viel Glück und bin immer dankbar.",
        "el": "Είμαι πολύ τυχερός, γι' αυτό είμαι πάντα ευγνώμων.",
        "es": "Tengo mucha suerte, así que siempre estoy agradecido.",
        "fi": "Olen onnekas, joten olen aina kiitollinen.",
        "fr": "J'ai beaucoup de chance, alors je suis toujours reconnaissant.",
        "he": "יש לי הרבה מזל, אז אני תמיד אסיר תודה.",
        "hi": "मैं बहुत भाग्यशाली हूँ, इसलिए मैं हमेशा आभारी रहता हूँ।",
        "hu": "Szerencsés vagyok, ezért mindig hálás vagyok.",
        "id": "Saya beruntung, jadi saya selalu bersyukur.",
        "it": "Sono fortunato, quindi sono sempre grato.",
        "ja": "私は運がいいので、いつも感謝しています。",
        "nb": "Jeg er heldig, så jeg er alltid takknemlig.",
        "nl": "Ik heb veel geluk, dus ik ben altijd dankbaar.",
        "pl": "Mam dużo szczęścia, więc zawsze jestem wdzięczny.",
        "pt": "Tenho muita sorte, então sou sempre grato.",
        "ro": "Am mult noroc, așa că sunt mereu recunoscător.",
        "ru": "Мне очень везёт, поэтому я всегда благодарен.",
        "sv": "Jag har tur, så jag är alltid tacksam.",
        "tr": "Çok şanslıyım, bu yüzden hep minnettarım.",
        "uk": "Мені дуже щастить, тому я завжди вдячний.",
        "vi": "Tôi rất may mắn, nên tôi luôn biết ơn.",
        "yue": "我好有福氣，所以我一直都好感恩。",
        "zh-Hans": "我很有福气，所以我一直很感激。"
      },
