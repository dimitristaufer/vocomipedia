  "sentences": [
    {
      "target": "저는 그 문제를 달리 생각해 봤어요.",
      "reading": "jeoneun geu munjereul dalli saenggakhae bwasseoyo.",
      "translations": {
        "en": "I tried thinking about that problem differently.",
        "ko": "저는 그 문제를 달리 생각해 봤어요.",
        "ipa": "jeoneun geu munjereul dalli saenggakhae bwasseoyo.",
        "ar": "حاولت أن أفكر في تلك المشكلة بشكل مختلف.",
        "cs": "Zkusil jsem o tom problému přemýšlet jinak.",
        "da": "Jeg prøvede at tænke anderledes om det problem.",
        "de": "Ich habe über das Problem anders nachgedacht.",
        "el": "Προσπάθησα να σκεφτώ διαφορετικά αυτό το πρόβλημα.",
        "es": "Intenté pensar en ese problema de otra manera.",
        "fi": "Yritin ajatella sitä ongelmaa eri tavalla.",
        "fr": "J'ai essayé de penser à ce problème autrement.",
        "he": "ניסיתי לחשוב על הבעיה הזאת אחרת.",
        "hi": "मैंने उस समस्या के बारे में अलग तरह से सोचा।",
        "hu": "Megpróbáltam másképp gondolkodni arról a problémáról.",
        "id": "Saya mencoba memikirkan masalah itu dengan cara yang berbeda.",
        "it": "Ho provato a pensare a quel problema in modo diverso.",
        "ja": "私はその問題を別の考え方で考えてみました。",
        "nb": "Jeg prøvde å tenke annerledes om det problemet.",
        "nl": "Ik probeerde anders over dat probleem na te denken.",
        "pl": "Spróbowałem pomyśleć o tym problemie inaczej.",
        "pt": "Tentei pensar nesse problema de outra forma.",
        "ro": "Am încercat să mă gândesc la problema aceea altfel.",
        "ru": "Я попробовал подумать об этой проблеме по-другому.",
        "sv": "Jag försökte tänka annorlunda om det problemet.",
        "tr": "O sorunu farklı düşünmeye çalıştım.",
        "uk": "Я спробував подумати про ту проблему інакше.",
        "vi": "Tôi đã thử nghĩ về vấn đề đó theo cách khác.",
        "yue": "我試過用另一種方式諗呢個問題。",
        "zh-Hans": "我试着用不同的方式想那个问题。"
      },
