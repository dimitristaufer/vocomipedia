  "sentences": [
    {
      "target": "주말에 시부모님을 뵈러 갔어요.",
      "reading": "jumal-e sibumonimeul boero gasseoyo.",
      "translations": {
        "en": "I went to visit my husband’s parents on the weekend.",
        "ko": "주말에 시부모님을 뵈러 갔어요.",
        "ipa": "jumal-e sibumonimeul boero gasseoyo.",
        "ar": "ذهبت لزيارة والدي زوجي في عطلة نهاية الأسبوع.",
        "cs": "O víkendu jsem šla navštívit rodiče svého manžela.",
        "da": "Jeg tog hen for at besøge min mands forældre i weekenden.",
        "de": "Ich bin am Wochenende zu Besuch bei den Eltern meines Mannes gegangen.",
        "el": "Πήγα να επισκεφτώ τους γονείς του άντρα μου το Σαββατοκύριακο.",
        "es": "Fui a visitar a los padres de mi marido el fin de semana.",
        "fi": "Kävin viikonloppuna katsomassa mieheni vanhempia.",
        "fr": "Je suis allée rendre visite aux parents de mon mari le week-end.",
        "he": "הלכתי לבקר את ההורים של בעלי בסוף השבוע.",
        "hi": "मैं सप्ताहांत में अपने पति के माता-पिता से मिलने गई।",
        "hu": "Hétvégén elmentem meglátogatni a férjem szüleit.",
        "id": "Saya pergi mengunjungi orang tua suami saya pada akhir pekan.",
        "it": "Sono andata a trovare i genitori di mio marito nel fine settimana.",
        "ja": "週末に夫の両親に会いに行きました。",
        "nb": "Jeg dro for å besøke svigerforeldrene mine i helgen.",
        "nl": "Ik ging in het weekend op bezoek bij de ouders van mijn man.",
        "pl": "Pojechałam odwiedzić rodziców mojego męża w weekend.",
        "pt": "Fui visitar os pais do meu marido no fim de semana.",
        "ro": "Am mers să-i vizitez pe părinții soțului meu în weekend.",
        "ru": "Я поехала на выходных в гости к родителям мужа.",
        "sv": "Jag gick för att hälsa på min mans föräldrar i helgen.",
        "tr": "Hafta sonu eşimin anne babasını ziyarete gittim.",
        "uk": "На вихідних я пішла провідати батьків мого чоловіка.",
        "vi": "Tôi đã đi thăm bố mẹ chồng vào cuối tuần.",
        "yue": "我週末去探望我丈夫嘅父母。",
        "zh-Hans": "我周末去看望了我丈夫的父母。"
      },
