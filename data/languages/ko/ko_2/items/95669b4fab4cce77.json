  "sentences": [
    {
      "target": "주말마다 낚시꾼이 강가에 모여요.",
      "reading": "jumalmada nakksikkuni ganggae moyeoyo.",
      "translations": {
        "en": "Anglers gather by the river every weekend.",
        "ko": "주말마다 낚시꾼이 강가에 모여요.",
        "ipa": "jumalmada nakksikkuni ganggae moyeoyo.",
        "ar": "يجتمع الصيادون على ضفة النهر كل عطلة نهاية أسبوع.",
        "cs": "Každý víkend se u řeky scházejí rybáři.",
        "da": "Fiskere samles ved floden hver weekend.",
        "de": "Jedenes Wochenende treffen sich Angler am Flussufer.",
        "el": "Κάθε Σαββατοκύριακο οι ψαράδες μαζεύονται δίπλα στο ποτάμι.",
        "es": "Los pescadores se reúnen junto al río cada fin de semana.",
        "fi": "Kalastajat kokoontuvat joen rannalle joka viikonloppu.",
        "fr": "Les pêcheurs se réunissent au bord de la rivière chaque week-end.",
        "he": "הדייגים מתאספים ליד הנהר בכל סוף שבוע.",
        "hi": "हर सप्ताहांत मछुआरे नदी किनारे इकट्ठा होते हैं।",
        "hu": "A horgászok minden hétvégén összegyűlnek a folyóparton.",
        "id": "Para pemancing berkumpul di tepi sungai setiap akhir pekan.",
        "it": "I pescatori si riuniscono sul fiume ogni fine settimana.",
        "ja": "毎週末、釣り人たちが川岸に集まります。",
        "nb": "Fiskere samles ved elvebredden hver helg.",
        "nl": "Vissers verzamelen zich elk weekend bij de rivier.",
        "pl": "Wędkarze zbierają się nad rzeką co weekend.",
        "pt": "Os pescadores se reúnem à beira do rio todo fim de semana.",
        "ro": "Pescarii se adună pe malul râului în fiecare weekend.",
        "ru": "Рыбаки собираются у реки каждые выходные.",
        "sv": "Fiskare samlas vid floden varje helg.",
        "tr": "Balıkçılar her hafta sonu nehir kıyısında toplanır.",
        "uk": "Рибалки збираються біля річки щовихідних.",
        "vi": "Những người câu cá tụ tập bên sông vào mỗi cuối tuần.",
        "yue": "啲釣魚人每個週末都會喺河邊聚埋一齊。",
        "zh-Hans": "垂钓者每个周末都聚在河边。"
      },
