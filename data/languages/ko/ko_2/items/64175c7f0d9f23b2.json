  "sentences": [
    {
      "target": "고양이가 슬그머니 의자 밑으로 숨었어요.",
      "reading": "goyangiga seulgeumeoni uija mit-euro sumeosseoyo.",
      "translations": {
        "en": "The cat furtively hid under the chair.",
        "ko": "고양이가 슬그머니 의자 밑으로 숨었어요.",
        "ipa": "goyangiga seulgeumeoni uija mit-euro sumeosseoyo.",
        "ar": "اختبأت القطة خفيةً تحت الكرسي.",
        "cs": "Kočka se potají schovala pod židli.",
        "da": "Katten gemte sig listigt under stolen.",
        "de": "Die Katze versteckte sich heimlich unter dem Stuhl.",
        "el": "Η γάτα κρύφτηκε κρυφά κάτω από την καρέκλα.",
        "es": "El gato se escondió furtivamente debajo de la silla.",
        "fi": "Kissa piiloutui salaa tuolin alle.",
        "fr": "Le chat s'est caché furtivement sous la chaise.",
        "he": "החתול התחבא בחשאי מתחת לכיסא.",
        "hi": "बिल्ली चुपके से कुर्सी के नीचे छिप गई।",
        "hu": "A macska sunyin elbújt a szék alá.",
        "id": "Kucing itu bersembunyi diam-diam di bawah kursi.",
        "it": "Il gatto si è nascosto furtivamente sotto la sedia.",
        "ja": "猫はそっといすの下に隠れました。",
        "nb": "Katten gjemte seg snikende under stolen.",
        "nl": "De kat verstopte zich stiekem onder de stoel.",
        "pl": "Kot schował się potajemnie pod krzesłem.",
        "pt": "O gato escondeu-se às escondidas debaixo da cadeira.",
        "ro": "Pisica s-a ascuns pe furiș sub scaun.",
        "ru": "Кошка украдкой спряталась под стул.",
        "sv": "Katten gömde sig smygande under stolen.",
        "tr": "Kedi usulca sandalyenin altına saklandı.",
        "uk": "Кіт нишком сховався під стілець.",
        "vi": "Con mèo lén lút trốn dưới ghế.",
        "yue": "隻貓靜靜哋匿咗喺櫈底。",
        "zh-Hans": "猫悄悄地躲到椅子底下了。"
      },
