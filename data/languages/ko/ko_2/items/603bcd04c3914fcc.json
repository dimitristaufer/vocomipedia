  "sentences": [
    {
      "target": "‘내버리다’는 물건을 버린다는 뜻이에요.",
      "reading": "naebeorida-neun mulgeoneul beorinaneun tteusieyo.",
      "translations": {
        "en": "‘내버리다’ means to throw something away.",
        "ko": "‘내버리다’는 물건을 버린다는 뜻이에요.",
        "ipa": "naebeorida-neun mulgeoneul beorinaneun tteusieyo.",
        "ar": "تعني كلمة «내버리다» أن ترمي شيئًا بعيدًا.",
        "cs": "‚Neberida‘ znamená něco vyhodit.",
        "da": "‘Neobeorida’ betyder at smide noget væk.",
        "de": "„Neobeorida“ bedeutet, etwas wegzuwerfen.",
        "el": "Το «νεμποριντα» σημαίνει να πετάς κάτι στα σκουπίδια.",
        "es": "«Neberida» significa tirar algo.",
        "fi": "‘Neberida’ tarkoittaa jonkin heittämistä pois.",
        "fr": "« Neberida » signifie jeter quelque chose.",
        "he": "“נברידה” פירושו לזרוק משהו.",
        "hi": "‘नेबोरिडा’ का मतलब है किसी चीज़ को फेंक देना।",
        "hu": "A „neberida” azt jelenti, hogy kidobunk valamit.",
        "id": "‘Neberida’ berarti membuang sesuatu.",
        "it": "«Neberida» significa buttare via qualcosa.",
        "ja": "「ネボリダ」は、物を捨てるという意味です。",
        "nb": "«Neberida» betyr å kaste noe.",
        "nl": "'Neberida' betekent iets weggooien.",
        "pl": "„Neberida” oznacza wyrzucić coś.",
        "pt": "«Neberida» significa deitar algo fora.",
        "ro": "„Neberida” înseamnă să arunci ceva.",
        "ru": "«Neberida» означает выбросить что-то.",
        "sv": "”Neberida” betyder att kasta bort något.",
        "tr": "‘Neberida’ bir şeyi çöpe atmak demektir.",
        "uk": "«Neberida» означає викинути щось.",
        "vi": "‘Neberida’ có nghĩa là vứt bỏ một thứ gì đó.",
        "yue": "「네버리다」係指掉咗啲嘢。",
        "zh-Hans": "“内버리다”表示扔掉东西。"
      },
