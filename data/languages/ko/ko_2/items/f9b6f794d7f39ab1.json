    {
      "target": "그는 교통 신호를 위반했어요.",
      "reading": "geuneun gyotong sinhoreul wibanhaesseoyo",
      "translations": {
        "en": "He ran a red light.",
        "ko": "그는 교통 신호를 위반했어요.",
        "ipa": "geuneun gyotong sinhoreul wibanhaesseoyo",
        "ar": "تجاوز الإشارة الحمراء.",
        "cs": "Projel na červenou.",
        "da": "Han kørte over for rødt.",
        "de": "Er ist über Rot gefahren.",
        "el": "Πέρασε με κόκκινο.",
        "es": "Se saltó un semáforo en rojo.",
        "fi": "Hän ajoi punaisia päin.",
        "fr": "Il est passé au feu rouge.",
        "he": "הוא עבר באור אדום.",
        "hi": "उसने लाल बत्ती तोड़ दी।",
        "hu": "Átment a piroson.",
        "id": "Dia menerobos lampu merah.",
        "it": "Ha passato con il rosso.",
        "ja": "彼は赤信号を無視しました。",
        "nb": "Han kjørte på rødt lys.",
        "nl": "Hij reed door rood.",
        "pl": "Przejechał na czerwonym świetle.",
        "pt": "Ele avançou o sinal vermelho.",
        "ro": "A trecut pe roșu.",
        "ru": "Он проехал на красный свет.",
        "sv": "Han körde mot rött.",
        "tr": "Kırmızı ışıkta geçti.",
        "uk": "Він проїхав на червоне світло.",
        "vi": "Anh ấy đã vượt đèn đỏ.",
        "yue": "佢衝紅燈。",
        "zh-Hans": "他闯红灯了。"
