  "sentences": [
    {
      "target": "효도는 작은 말 한마디에서 시작해요.",
      "reading": "hyodoneun jageun mal hanmadieseo sijakhaeyo.",
      "translations": {
        "en": "Filial piety starts with a small word.",
        "ko": "효도는 작은 말 한마디에서 시작해요.",
        "ipa": "hyodoneun jageun mal hanmadieseo sijakhaeyo.",
        "ar": "تبدأ برّ الوالدين بكلمة صغيرة.",
        "cs": "Synovská úcta začíná malým slovem.",
        "da": "Filial pietet begynder med et lille ord.",
        "de": "Kindliche Pietät beginnt mit einem kleinen Wort.",
        "el": "Η ευσέβεια προς τους γονείς αρχίζει με μια μικρή κουβέντα.",
        "es": "La piedad filial empieza con una palabra pequeña.",
        "fi": "Hurskaus vanhempia kohtaan alkaa pienestä sanasta.",
        "fr": "La piété filiale commence par un petit mot.",
        "he": "אדיקות לילדים מתחילה במילה קטנה.",
        "hi": "माता-पिता के प्रति भक्ति एक छोटे से शब्द से शुरू होती है।",
        "hu": "A szülőtisztelet egyetlen kis szóval kezdődik.",
        "id": "Bakti kepada orang tua dimulai dari satu kata kecil.",
        "it": "La pietà filiale inizia con una piccola parola.",
        "ja": "孝行はちょっとした一言から始まります。",
        "nb": "Sønnlig pietet begynner med et lite ord.",
        "nl": "Kinderlijke vroomheid begint met een klein woord.",
        "pl": "Synowska pobożność zaczyna się od jednego małego słowa.",
        "pt": "A piedade filial começa com uma pequena palavra.",
        "ro": "Filialitatea începe cu un cuvânt mic.",
        "ru": "Сыновняя почтительность начинается с одного маленького слова.",
        "sv": "Sönlig fromhet börjar med ett litet ord.",
        "tr": "Ana babaya saygı küçük bir sözle başlar.",
        "uk": "Синівська шанобливість починається з одного маленького слова.",
        "vi": "Lòng hiếu thảo bắt đầu từ một lời nhỏ.",
        "yue": "孝順由一句細細聲嘅說話開始。",
        "zh-Hans": "孝顺从一句小小的话开始。"
      },
