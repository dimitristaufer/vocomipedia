    {
      "target": "그다음에는 제가 설명할게요.",
      "reading": "geudaumeneun jega seolmyeonghalgeyo.",
      "translations": {
        "en": "Then I’ll explain it.",
        "ko": "그다음에는 제가 설명할게요.",
        "ipa": "geudaumeneun jega seolmyeonghalgeyo.",
        "ar": "ثم سأشرح.",
        "cs": "Pak to vysvětlím já.",
        "da": "Så forklarer jeg det.",
        "de": "Dann erkläre ich es.",
        "el": "Μετά θα το εξηγήσω εγώ.",
        "es": "Luego yo lo explico.",
        "fi": "Sitten minä selitän sen.",
        "fr": "Ensuite, je vais l'expliquer.",
        "he": "אחר כך אני אסביר.",
        "hi": "फिर मैं समझाऊँगा।",
        "hu": "Aztán én elmagyarázom.",
        "id": "Lalu saya akan menjelaskannya.",
        "it": "Poi lo spiego io.",
        "ja": "それから私が説明します。",
        "nb": "Så skal jeg forklare det.",
        "nl": "Dan leg ik het uit.",
        "pl": "Potem ja to wyjaśnię.",
        "pt": "Depois eu explico.",
        "ro": "Apoi o să explic eu.",
        "ru": "Потом я объясню.",
        "sv": "Sedan förklarar jag.",
        "tr": "Sonra ben açıklarım.",
        "uk": "Потім я поясню.",
        "vi": "Rồi tôi sẽ giải thích.",
        "yue": "跟住我會解釋。",
        "zh-Hans": "然后我来解释。"
