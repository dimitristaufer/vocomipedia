  "sentences": [
    {
      "target": "그 나라는 민주화가 빠르게 진행됐어요.",
      "reading": "geu naraneun minjuhwaga ppalleuge jinhaengdwaesseoyo.",
      "translations": {
        "en": "That country democratized quickly.",
        "ko": "그 나라는 민주화가 빠르게 진행됐어요.",
        "ipa": "geu naraneun minjuhwaga ppalleuge jinhaengdwaesseoyo.",
        "ar": "تحولت تلك البلاد إلى الديمقراطية بسرعة.",
        "cs": "Tato země rychle přešla k demokracii.",
        "da": "Det land blev hurtigt demokratiseret.",
        "de": "Das Land wurde schnell demokratisiert.",
        "el": "Η χώρα αυτή εκδημοκρατίστηκε γρήγορα.",
        "es": "Ese país se democratizó rápidamente.",
        "fi": "Se maa demokratisoitui nopeasti.",
        "fr": "Ce pays s'est rapidement démocratisé.",
        "he": "המדינה הזאת עברה דמוקרטיזציה במהירות.",
        "hi": "उस देश में जल्दी लोकतंत्रीकरण हुआ।",
        "hu": "Az az ország gyorsan demokratizálódott.",
        "id": "Negara itu mengalami demokratisasi dengan cepat.",
        "it": "Quel paese si è democratizzato rapidamente.",
        "ja": "その国は急速に民主化しました。",
        "nb": "Det landet ble raskt demokratisert.",
        "nl": "Dat land democratiseerde snel.",
        "pl": "Ten kraj szybko się zdemokratyzował.",
        "pt": "Aquele país se democratizou rapidamente.",
        "ro": "Țara aceea s-a democratizat rapid.",
        "ru": "Та страна быстро демократизировалась.",
        "sv": "Det landet demokratiserades snabbt.",
        "tr": "O ülke hızla demokratikleşti.",
        "uk": "Та країна швидко демократизувалася.",
        "vi": "Đất nước đó đã dân chủ hóa rất nhanh.",
        "yue": "嗰個國家好快就民主化咗。",
        "zh-Hans": "那个国家很快就民主化了。"
      },
