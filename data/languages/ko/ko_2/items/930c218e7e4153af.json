  "sentences": [
    {
      "target": "그는 조용히 문을 슬쩍 열고 나갔어요.",
      "reading": "geuneun joyonghi muneul seuljjeok yeolgo nagasseoyo.",
      "translations": {
        "en": "He quietly opened the door and went out.",
        "ko": "그는 조용히 문을 슬쩍 열고 나갔어요.",
        "ipa": "geuneun joyonghi muneul seuljjeok yeolgo nagasseoyo.",
        "ar": "فتح الباب بهدوء وخرج.",
        "cs": "Tiše otevřel dveře a odešel.",
        "da": "Han åbnede døren stille og gik ud.",
        "de": "Er öffnete die Tür leise und ging hinaus.",
        "el": "Άνοιξε αθόρυβα την πόρτα και βγήκε έξω.",
        "es": "Abrió la puerta en silencio y salió.",
        "fi": "Hän avasi oven hiljaa ja meni ulos.",
        "fr": "Il a ouvert la porte doucement et est sorti.",
        "he": "הוא פתח בשקט את הדלת ויצא.",
        "hi": "उसने चुपचाप दरवाज़ा थोड़ा सा खोला और बाहर चला गया।",
        "hu": "Halkan kinyitotta az ajtót, és kiment.",
        "id": "Dia membuka pintu pelan-pelan dan pergi keluar.",
        "it": "Ha aperto piano la porta ed è uscito.",
        "ja": "彼は静かにドアを少し開けて出ていきました。",
        "nb": "Han åpnet døren stille og gikk ut.",
        "nl": "Hij deed de deur zachtjes open en ging naar buiten.",
        "pl": "Cicho otworzył drzwi i wyszedł.",
        "pt": "Ele abriu a porta de mansinho e saiu.",
        "ro": "A deschis ușa încet și a ieșit.",
        "ru": "Он тихо приоткрыл дверь и вышел.",
        "sv": "Han öppnade dörren tyst och gick ut.",
        "tr": "Kapıyı sessizce aralayıp çıktı.",
        "uk": "Він тихо прочинив двері й вийшов.",
        "vi": "Anh ấy lặng lẽ mở cửa rồi đi ra ngoài.",
        "yue": "佢靜靜地打開道門，然後出咗去。",
        "zh-Hans": "他悄悄地把门打开，出去了。"
      },
