  "sentences": [
    {
      "target": "엄마가 추운 아기에게 털모자를 씌워 준다.",
      "reading": "eomma-ga chuun agiege teolmotjareul sswiwo junda.",
      "translations": {
        "en": "The mother puts a warm knit hat on the baby.",
        "ko": "엄마가 추운 아기에게 털모자를 씌워 준다.",
        "ipa": "eomma-ga chuun agiege teolmotjareul sswiwo junda.",
        "ar": "تضع الأم قبعة صوفية دافئة على الطفل.",
        "cs": "Maminka dává miminku vlněnou čepici.",
        "da": "Mor sætter en varm strikhue på babyen.",
        "de": "Die Mutter setzt dem Baby eine warme Strickmütze auf.",
        "el": "Η μητέρα βάζει στο μωρό ένα ζεστό πλεκτό σκουφί.",
        "es": "La madre le pone al bebé un gorro de lana abrigado.",
        "fi": "Äiti laittaa vauvalle lämpimän villamyssyn.",
        "fr": "La mère met un bonnet chaud en laine au bébé.",
        "he": "האם שמה על התינוק כובע צמר חם.",
        "hi": "माँ बच्चे को ऊनी टोपी पहनाती है।",
        "hu": "Anya meleg kötött sapkát tesz a babára.",
        "id": "Ibu memasangkan topi rajut hangat pada bayi itu.",
        "it": "La madre mette al bambino un caldo berretto di lana.",
        "ja": "母親が寒がっている赤ちゃんにあったかい毛糸の帽子をかぶせる。",
        "nb": "Moren setter en varm strikket lue på babyen.",
        "nl": "Moeder zet de baby een warme gebreide muts op.",
        "pl": "Mama zakłada dziecku ciepłą wełnianą czapkę.",
        "pt": "A mãe põe um gorro de lã quentinho no bebê.",
        "ro": "Mama îi pune bebelușului o căciulă de lână caldă.",
        "ru": "Мама надевает на малыша тёплую вязаную шапку.",
        "sv": "Mamman sätter en varm stickad mössa på bebisen.",
        "tr": "Anne bebeğe sıcak bir örgü şapka giydiriyor.",
        "uk": "Мама надягає на малюка теплу в'язану шапку.",
        "vi": "Mẹ đội cho em bé một chiếc mũ len ấm.",
        "yue": "媽媽幫怕凍嘅BB戴上頂暖笠笠嘅毛線帽。",
        "zh-Hans": "妈妈给怕冷的宝宝戴上一顶暖和的毛线帽。"
      },
