    {
      "target": "사람들 사이로 빠져나갔어요.",
      "reading": "saramdeul sairo ppajyeonagasseoyo.",
      "translations": {
        "en": "I slipped out through the crowd.",
        "ko": "사람들 사이로 빠져나갔어요.",
        "ipa": "saramdeul sairo ppajyeonagasseoyo.",
        "ar": "تسللتُ بين الناس.",
        "cs": "Proklouzl jsem mezi lidmi.",
        "da": "Jeg gled ud mellem folkene.",
        "de": "Ich bin zwischen den Leuten durchgeschlüpft.",
        "el": "Ξέφυγα ανάμεσα από τον κόσμο.",
        "es": "Me escabullí entre la gente.",
        "fi": "Luikahdin ihmisten välistä.",
        "fr": "Je me suis faufilé parmi les gens.",
        "he": "התחמקתי בין האנשים.",
        "hi": "मैं लोगों के बीच से निकल गया।",
        "hu": "Átcsúsztam az emberek között.",
        "id": "Saya menyelinap melewati orang-orang.",
        "it": "Mi sono fatto largo tra la gente.",
        "ja": "人混みをかき分けて抜け出しました。",
        "nb": "Jeg snek meg ut mellom folkene.",
        "nl": "Ik wurmde me tussen de mensen door.",
        "pl": "Przecisnąłem się między ludźmi.",
        "pt": "Eu me esgueirei entre as pessoas.",
        "ro": "M-am strecurat printre oameni.",
        "ru": "Я протиснулся сквозь толпу.",
        "sv": "Jag smet genom folkmassan.",
        "tr": "İnsanların arasından sıyrıldım.",
        "uk": "Я проштовхався крізь людей.",
        "vi": "Tôi len qua đám đông.",
        "yue": "我喺人群入面擠咗出去。",
        "zh-Hans": "我从人群中挤了出去。"
      },
