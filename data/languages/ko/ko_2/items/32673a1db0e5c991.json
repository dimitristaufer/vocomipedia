    {
      "target": "비가 계속돼요.",
      "reading": "biga gyesokdwaeyo.",
      "translations": {
        "en": "It's still raining.",
        "ko": "비가 계속돼요.",
        "ipa": "biga gyesokdwaeyo.",
        "ar": "ما زالت السماء تمطر.",
        "cs": "Pořád prší.",
        "da": "Det regner stadig.",
        "de": "Es regnet immer noch.",
        "el": "Βρέχει ακόμα.",
        "es": "Sigue lloviendo.",
        "fi": "Sataa vielä.",
        "fr": "Il pleut encore.",
        "he": "עדיין יורד גשם.",
        "hi": "अभी भी बारिश हो रही है।",
        "hu": "Még mindig esik az eső.",
        "id": "Masih hujan.",
        "it": "Piove ancora.",
        "ja": "まだ雨が降っています。",
        "nb": "Det regner fortsatt.",
        "nl": "Het regent nog steeds.",
        "pl": "Nadal pada deszcz.",
        "pt": "Ainda está chovendo.",
        "ro": "Încă plouă.",
        "ru": "Все еще идет дождь.",
        "sv": "Det regnar fortfarande.",
        "tr": "Hâlâ yağmur yağıyor.",
        "uk": "Усе ще йде дощ.",
        "vi": "Trời vẫn đang mưa.",
        "yue": "雨仲落緊。",
        "zh-Hans": "还在下雨。"
      },
