  "sentences": [
    {
      "target": "아침에 빵에 꿀을 발랐어요.",
      "reading": "achim-e ppang-e kkul-eul barasseoyo.",
      "translations": {
        "en": "I spread honey on my bread for breakfast.",
        "ko": "아침에 빵에 꿀을 발랐어요.",
        "ipa": "achim-e ppang-e kkul-eul barasseoyo.",
        "ar": "وضعتُ العسل على الخبز في الصباح.",
        "cs": "Ráno jsem si namazal na chleba med.",
        "da": "Jeg smurte honning på mit brød om morgenen.",
        "de": "Ich habe mir morgens Honig aufs Brot gestrichen.",
        "el": "Το πρωί άπλωσα μέλι στο ψωμί μου.",
        "es": "Por la mañana me unté miel en el pan.",
        "fi": "Levitin aamulla leipäni päälle hunajaa.",
        "fr": "Le matin, j’ai mis du miel sur mon pain.",
        "he": "בבוקר מרחתי דבש על הלחם שלי.",
        "hi": "मैंने सुबह रोटी पर शहद लगाया।",
        "hu": "Reggel mézet kentem a kenyérre.",
        "id": "Saya mengoleskan madu pada roti saya saat sarapan.",
        "it": "La mattina ho spalmato il miele sul pane.",
        "ja": "朝、パンに蜂蜜を塗りました。",
        "nb": "Jeg smurte honning på brødet om morgenen.",
        "nl": "Ik smeerde 's ochtends honing op mijn brood.",
        "pl": "Rano posmarowałem chleb miodem.",
        "pt": "De manhã, passei mel no pão.",
        "ro": "Dimineața am întins miere pe pâine.",
        "ru": "Утром я намазал хлеб мёдом.",
        "sv": "Jag bredde honung på brödet på morgonen.",
        "tr": "Sabah ekmeğime bal sürdüm.",
        "uk": "Вранці я намазав хліб медом.",
        "vi": "Buổi sáng, tôi phết mật ong lên bánh mì.",
        "yue": "朝早我喺麵包上搽咗蜜糖。",
        "zh-Hans": "早上我在面包上抹了蜂蜜。"
      },
