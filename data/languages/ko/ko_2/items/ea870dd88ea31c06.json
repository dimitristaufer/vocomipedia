    {
      "target": "선생님의 지시대로 앉아 주세요.",
      "reading": "seonsaengnim-ui jisidaero anja juseyo.",
      "translations": {
        "en": "Please sit as the teacher instructed.",
        "ko": "선생님의 지시대로 앉아 주세요.",
        "ipa": "seonsaengnim-ui jisidaero anja juseyo.",
        "ar": "من فضلك اجلسوا كما طلب المعلم.",
        "cs": "Posaďte se prosím podle pokynů učitele.",
        "da": "Sæt dig venligst ned, som læreren sagde.",
        "de": "Setzen Sie sich bitte so hin, wie der Lehrer es gesagt hat.",
        "el": "Καθίστε, παρακαλώ, όπως είπε ο δάσκαλος.",
        "es": "Siéntese, por favor, como indicó el profesor.",
        "fi": "Istukaa niin kuin opettaja sanoi.",
        "fr": "Asseyez-vous comme le professeur l'a demandé, s'il vous plaît.",
        "he": "נא לשבת כפי שהמורה הורה.",
        "hi": "कृपया शिक्षक के निर्देश के अनुसार बैठिए।",
        "hu": "Kérjük, üljenek le úgy, ahogy a tanár mondta.",
        "id": "Silakan duduk seperti yang diperintahkan guru.",
        "it": "Si sieda come ha detto l'insegnante, per favore.",
        "ja": "先生の指示どおりに座ってください。",
        "nb": "Sett deg ned slik læreren sa, vær så snill.",
        "nl": "Ga alstublieft zitten zoals de leraar zei.",
        "pl": "Proszę usiąść tak, jak polecił nauczyciel.",
        "pt": "Sente-se como o professor mandou, por favor.",
        "ro": "Vă rog să vă așezați așa cum a spus profesorul.",
        "ru": "Сядьте, пожалуйста, так, как сказал учитель.",
        "sv": "Sätt dig ner som läraren sa, tack.",
        "tr": "Lütfen öğretmenin dediği gibi oturun.",
        "uk": "Сядьте, будь ласка, так, як сказав учитель.",
        "vi": "Xin hãy ngồi xuống như thầy giáo đã dặn.",
        "yue": "請按老師講嘅坐低。",
        "zh-Hans": "请按照老师的指示坐下。"
      },
