  "sentences": [
    {
      "target": "겨울철에는 감기에 걸리기 쉬워요.",
      "reading": "gyeoulcheol-eneun gamgiene geolligi swiwoyo.",
      "translations": {
        "en": "It’s easy to catch a cold in the winter season.",
        "ko": "겨울철에는 감기에 걸리기 쉬워요.",
        "ipa": "gyeoulcheol-eneun gamgiene geolligi swiwoyo.",
        "ar": "من السهل أن تصاب بالزكام في فصل الشتاء.",
        "cs": "V zimě se snadno nachladíte.",
        "da": "Det er let at blive forkølet om vinteren.",
        "de": "Im Winter erkältet man sich leicht.",
        "el": "Είναι εύκολο να κρυολογήσεις τον χειμώνα.",
        "es": "Es fácil resfriarse en invierno.",
        "fi": "Talvella on helppo vilustua.",
        "fr": "Il est facile d’attraper un rhume en hiver.",
        "he": "קל להצטנן בחורף.",
        "hi": "सर्दियों में सर्दी लगना आसान है।",
        "hu": "Télen könnyű megfázni.",
        "id": "Di musim dingin, mudah terkena flu.",
        "it": "In inverno è facile prendere il raffreddore.",
        "ja": "冬は風邪をひきやすいです。",
        "nb": "Det er lett å bli forkjølet om vinteren.",
        "nl": "In de winter kun je gemakkelijk verkouden worden.",
        "pl": "Zimą łatwo się przeziębić.",
        "pt": "No inverno, é fácil ficar resfriado.",
        "ro": "Iarna, te poți răci ușor.",
        "ru": "Зимой легко простудиться.",
        "sv": "Det är lätt att bli förkyld på vintern.",
        "tr": "Kışın hasta olmak kolaydır.",
        "uk": "Взимку легко застудитися.",
        "vi": "Mùa đông dễ bị cảm lạnh.",
        "yue": "冬天好容易感冒。",
        "zh-Hans": "冬天容易感冒。"
      },
