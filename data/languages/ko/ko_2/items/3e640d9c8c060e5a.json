  "sentences": [
    {
      "target": "오늘은 조선글날이라서 집에서 쉬어요.",
      "reading": "oneureun joseongeulnariraseo jibeseo swieoyo.",
      "translations": {
        "en": "It's Joseongeulnal today, so I'm resting at home.",
        "ko": "오늘은 조선글날이라서 집에서 쉬어요.",
        "ipa": "oneureun joseongeulnariraseo jibeseo swieoyo.",
        "ar": "اليوم هو عيد جوسونغولنال، لذلك أرتاح في البيت.",
        "cs": "Dnes je Joseongeulnal, tak odpočívám doma.",
        "da": "Det er Joseongeulnal i dag, så jeg slapper af derhjemme.",
        "de": "Heute ist Joseongeulnal, also ruhe ich mich zu Hause aus.",
        "el": "Σήμερα είναι η Joseongeulnal, οπότε ξεκουράζομαι στο σπίτι.",
        "es": "Hoy es Joseongeulnal, así que descanso en casa.",
        "fi": "Tänään on Joseongeulnal, joten lepään kotona.",
        "fr": "Aujourd'hui, c'est Joseongeulnal, alors je me repose à la maison.",
        "he": "היום זה ג'וסונגולנל, אז אני נח בבית.",
        "hi": "आज जोसोनगुलनाल है, इसलिए मैं घर पर आराम कर रहा हूँ।",
        "hu": "Ma Joseongeulnal van, ezért otthon pihenek.",
        "id": "Hari ini Joseongeulnal, jadi saya beristirahat di rumah.",
        "it": "Oggi è Joseongeulnal, quindi mi riposo a casa.",
        "ja": "今日は朝鮮グルナルなので、家で休んでいます。",
        "nb": "Det er Joseongeulnal i dag, så jeg slapper av hjemme.",
        "nl": "Vandaag is het Joseongeulnal, dus ik rust thuis uit.",
        "pl": "Dzisiaj jest Joseongeulnal, więc odpoczywam w domu.",
        "pt": "Hoje é Joseongeulnal, então estou descansando em casa.",
        "ro": "Azi este Joseongeulnal, așa că mă odihnesc acasă.",
        "ru": "Сегодня Чосонгыллаль, поэтому я отдыхаю дома.",
        "sv": "Det är Joseongeulnal i dag, så jag vilar hemma.",
        "tr": "Bugün Joseongeulnal, bu yüzden evde dinleniyorum.",
        "uk": "Сьогодні Чосонгульнал, тож я відпочиваю вдома.",
        "vi": "Hôm nay là Joseongeulnal, nên tôi nghỉ ở nhà.",
        "yue": "今日係朝鮮文日，所以我喺屋企休息。",
        "zh-Hans": "今天是朝鲜文日，所以我在家休息。"
      },
