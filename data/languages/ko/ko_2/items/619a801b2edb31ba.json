  "sentences": [
    {
      "target": "엄마가 늦게 나가는 걸 허락했어요.",
      "reading": "eommaga neutge naganeun geol heorakhaesseoyo.",
      "translations": {
        "en": "My mom allowed me to go out late.",
        "ko": "엄마가 늦게 나가는 걸 허락했어요.",
        "ipa": "eommaga neutge naganeun geol heorakhaesseoyo.",
        "ar": "سمحت لي أمي أن أخرج متأخرًا.",
        "cs": "Maminka mi dovolila jít ven pozdě.",
        "da": "Min mor lod mig gå sent ud.",
        "de": "Meine Mutter hat mir erlaubt, spät auszugehen.",
        "el": "Η μαμά μου μού επέτρεψε να βγω αργά.",
        "es": "Mi mamá me dejó salir tarde.",
        "fi": "Äiti antoi minun mennä ulos myöhään.",
        "fr": "Ma mère m'a autorisé à sortir tard.",
        "he": "אמא שלי הרשתה לי לצאת מאוחר.",
        "hi": "माँ ने मुझे देर से बाहर जाने की अनुमति दी।",
        "hu": "Anyu megengedte, hogy későn menjek ki.",
        "id": "Ibu mengizinkan saya pergi keluar larut malam.",
        "it": "Mia madre mi ha permesso di uscire tardi.",
        "ja": "お母さんは私が遅く出かけるのを許してくれました。",
        "nb": "Mamma lot meg gå ut sent.",
        "nl": "Mijn moeder stond me toe laat uit te gaan.",
        "pl": "Mama pozwoliła mi wyjść późno.",
        "pt": "Minha mãe me deixou sair tarde.",
        "ro": "Mama m-a lăsat să ies târziu.",
        "ru": "Мама разрешила мне поздно выйти.",
        "sv": "Mamma lät mig gå ut sent.",
        "tr": "Annem geç çıkmama izin verdi.",
        "uk": "Мама дозволила мені пізно вийти.",
        "vi": "Mẹ tôi cho phép tôi ra ngoài muộn.",
        "yue": "阿媽准我夜啲出門。",
        "zh-Hans": "妈妈允许我晚点出去。"
      },
