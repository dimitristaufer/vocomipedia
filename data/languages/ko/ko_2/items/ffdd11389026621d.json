  "sentences": [
    {
      "target": "따뜻한 환영을 받았어요.",
      "reading": "ttatteutan hwanyeongeul badasseoyo.",
      "translations": {
        "en": "I received a warm welcome.",
        "ko": "따뜻한 환영을 받았어요.",
        "ipa": "ttatteutan hwanyeongeul badasseoyo.",
        "ar": "تلقيت ترحيبًا حارًا.",
        "cs": "Dostalo se mi vřelého přivítání.",
        "da": "Jeg fik en varm velkomst.",
        "de": "Ich wurde herzlich empfangen.",
        "el": "Δέχτηκα μια θερμή υποδοχή.",
        "es": "Recibí una cálida bienvenida.",
        "fi": "Sain lämpimän vastaanoton.",
        "fr": "J’ai reçu un accueil chaleureux.",
        "he": "קיבלתי קבלת פנים חמה.",
        "hi": "मेरा गर्मजोशी से स्वागत किया गया।",
        "hu": "Meleg fogadtatásban részesültem.",
        "id": "Saya mendapat sambutan hangat.",
        "it": "Ho ricevuto un caloroso benvenuto.",
        "ja": "私は温かく迎えられました。",
        "nb": "Jeg fikk en varm velkomst.",
        "nl": "Ik kreeg een warm welkom.",
        "pl": "Zostałem ciepło przyjęty.",
        "pt": "Recebi uma calorosa recepção.",
        "ro": "Am primit o primire caldă.",
        "ru": "Меня тепло встретили.",
        "sv": "Jag fick ett varmt välkomnande.",
        "tr": "Sıcak bir karşılama aldım.",
        "uk": "Мене тепло зустріли.",
        "vi": "Tôi đã nhận được sự chào đón nồng nhiệt.",
        "yue": "我受到熱烈歡迎。",
        "zh-Hans": "我受到了热烈欢迎。"
      },
