    {
      "target": "장차 그는 의사가 될 거예요.",
      "reading": "jangcha geuneun uisaga doel geoyeyo.",
      "translations": {
        "en": "He will become a doctor someday.",
        "ko": "장차 그는 의사가 될 거예요.",
        "ipa": "jangcha geuneun uisaga doel geoyeyo.",
        "ar": "سيصبح طبيبًا يومًا ما.",
        "cs": "Jednou se stane lékařem.",
        "da": "Han bliver læge en dag.",
        "de": "Er wird eines Tages Arzt werden.",
        "el": "Θα γίνει γιατρός κάποια μέρα.",
        "es": "Será médico algún día.",
        "fi": "Hänestä tulee joskus lääkäri.",
        "fr": "Il deviendra médecin un jour.",
        "he": "הוא יהיה רופא יום אחד.",
        "hi": "वह एक दिन डॉक्टर बनेगा।",
        "hu": "Egyszer orvos lesz.",
        "id": "Dia akan menjadi dokter suatu hari nanti.",
        "it": "Un giorno diventerà un medico.",
        "ja": "彼はいつか医者になるでしょう。",
        "nb": "Han kommer til å bli lege en dag.",
        "nl": "Hij zal ooit dokter worden.",
        "pl": "Kiedyś zostanie lekarzem.",
        "pt": "Ele vai se tornar médico um dia.",
        "ro": "El va deveni doctor într-o zi.",
        "ru": "Он когда-нибудь станет врачом.",
        "sv": "Han kommer att bli läkare en dag.",
        "tr": "O, bir gün doktor olacak.",
        "uk": "Він колись стане лікарем.",
        "vi": "Một ngày nào đó anh ấy sẽ trở thành bác sĩ.",
        "yue": "佢總有一日會成為醫生。",
        "zh-Hans": "他总有一天会成为一名医生。"
      },
