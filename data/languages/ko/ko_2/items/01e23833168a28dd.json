  "sentences": [
    {
      "target": "어머니가 속담 하나를 알려 주셨어요.",
      "reading": "eomeoniga sokdam hanareul allyeo jusyeosseoyo.",
      "translations": {
        "en": "My mother taught me a proverb.",
        "ko": "어머니가 속담 하나를 알려 주셨어요.",
        "ipa": "eomeoniga sokdam hanareul allyeo jusyeosseoyo.",
        "ar": "علمتني أمي مثلًا شعبيًا.",
        "cs": "Maminka mě naučila jedno přísloví.",
        "da": "Min mor lærte mig et ordsprog.",
        "de": "Meine Mutter hat mir ein Sprichwort beigebracht.",
        "el": "Η μητέρα μου μού έμαθε μια παροιμία.",
        "es": "Mi madre me enseñó un proverbio.",
        "fi": "Äitini opetti minulle yhden sananlaskun.",
        "fr": "Ma mère m'a appris un proverbe.",
        "he": "אמא שלי לימדה אותי פתגם.",
        "hi": "मेरी माँ ने मुझे एक कहावत सिखाई।",
        "hu": "Anyukám tanított nekem egy közmondást.",
        "id": "Ibu mengajarkan saya sebuah peribahasa.",
        "it": "Mia madre mi ha insegnato un proverbio.",
        "ja": "母がことわざを一つ教えてくれました。",
        "nb": "Moren min lærte meg et ordtak.",
        "nl": "Mijn moeder leerde me een spreekwoord.",
        "pl": "Mama nauczyła mnie jednego przysłowia.",
        "pt": "Minha mãe me ensinou um provérbio.",
        "ro": "Mama m-a învățat o zicală.",
        "ru": "Мама научила меня одной пословице.",
        "sv": "Min mamma lärde mig ett ordspråk.",
        "tr": "Annem bana bir atasözü öğretti.",
        "uk": "Мама навчила мене однієї приказки.",
        "vi": "Mẹ tôi đã dạy tôi một câu tục ngữ.",
        "yue": "阿媽教咗我一個諺語。",
        "zh-Hans": "妈妈教了我一个谚语。"
