  "sentences": [
    {
      "target": "그 방송사는 뉴스를 잘 만들어요.",
      "reading": "geu bangsongsaneun nyuseureul jal mandeureoyo.",
      "translations": {
        "en": "That broadcasting company makes good news programs.",
        "ko": "그 방송사는 뉴스를 잘 만들어요.",
        "ipa": "geu bangsongsaneun nyuseureul jal mandeureoyo.",
        "ar": "تلك الشركة الإذاعية تقدم برامج أخبار جيدة.",
        "cs": "Ta vysílací společnost dělá dobré zpravodajství.",
        "da": "Det tv-selskab laver gode nyhedsudsendelser.",
        "de": "Die Rundfunkanstalt macht gute Nachrichtensendungen.",
        "el": "Αυτή η ραδιοτηλεοπτική εταιρεία φτιάχνει καλές ειδήσεις.",
        "es": "Esa cadena de televisión hace buenos noticieros.",
        "fi": "Tuo televisioyhtiö tekee hyviä uutisia.",
        "fr": "Cette chaîne de télévision fait de bons journaux télévisés.",
        "he": "חברת השידור הזו מכינה מהדורות חדשות טובות.",
        "hi": "वह प्रसारण कंपनी अच्छी खबरें बनाती है।",
        "hu": "Az a műsorszolgáltató cég jó híreket készít.",
        "id": "Perusahaan penyiaran itu membuat berita yang bagus.",
        "it": "Quella emittente fa buoni notiziari.",
        "ja": "その放送局はいいニュース番組を作ります。",
        "nb": "Det kringkastingsselskapet lager gode nyhetssendinger.",
        "nl": "Dat omroepbedrijf maakt goed nieuws.",
        "pl": "Ta stacja telewizyjna robi dobre wiadomości.",
        "pt": "Essa emissora faz bons noticiários.",
        "ro": "Acea companie de difuzare face știri bune.",
        "ru": "Та телерадиокомпания делает хорошие новости.",
        "sv": "Det där tv-bolaget gör bra nyheter.",
        "tr": "O yayın şirketi iyi haberler hazırlıyor.",
        "uk": "Та телерадіокомпанія робить хороші новини.",
        "vi": "Công ty phát sóng đó làm bản tin rất hay.",
        "yue": "嗰間廣播公司做得好嘅新聞節目。",
        "zh-Hans": "那家广播公司制作的新闻节目很好。"
      },
