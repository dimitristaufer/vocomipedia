  "sentences": [
    {
      "target": "아침에 새소리가 들렸어요.",
      "reading": "achim-e saesoriga deullyeosseoyo.",
      "translations": {
        "en": "I heard birds chirping in the morning.",
        "ko": "아침에 새소리가 들렸어요.",
        "ipa": "achim-e saesoriga deullyeosseoyo.",
        "ar": "سمعت زقزقة العصافير في الصباح.",
        "cs": "Ráno jsem slyšel zpěv ptáků.",
        "da": "Jeg hørte fuglesang om morgenen.",
        "de": "Am Morgen hörte ich Vogelgezwitscher.",
        "el": "Άκουσα κελάηδισμα πουλιών το πρωί.",
        "es": "Oí el canto de los pájaros por la mañana.",
        "fi": "Kuulin aamulla lintujen laulua.",
        "fr": "J’ai entendu le chant des oiseaux le matin.",
        "he": "שמעתי ציוץ ציפורים בבוקר.",
        "hi": "मैंने सुबह पक्षियों की चहचहाहट सुनी।",
        "hu": "Reggel madárcsicsergést hallottam.",
        "id": "Saya mendengar kicauan burung di pagi hari.",
        "it": "Ho sentito il cinguettio degli uccelli al mattino.",
        "ja": "朝、鳥のさえずりが聞こえました。",
        "nb": "Jeg hørte fuglesang om morgenen.",
        "nl": "Ik hoorde vogelgezang in de ochtend.",
        "pl": "Rano słyszałem śpiew ptaków.",
        "pt": "Ouvi o canto dos pássaros de manhã.",
        "ro": "Am auzit ciripitul păsărilor dimineața.",
        "ru": "Утром я слышал пение птиц.",
        "sv": "Jag hörde fågelsång på morgonen.",
        "tr": "Sabah kuş cıvıltısı duydum.",
        "uk": "Вранці я почув пташиний спів.",
        "vi": "Tôi nghe tiếng chim hót vào buổi sáng.",
        "yue": "朝早我聽到鳥叫聲。",
        "zh-Hans": "早上我听到了鸟叫声。"
      },
