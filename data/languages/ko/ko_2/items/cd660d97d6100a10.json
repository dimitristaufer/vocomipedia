  "sentences": [
    {
      "target": "오늘은 친구 집에서 머무를 거예요.",
      "reading": "oneureun chingu jib-eseo meomureul geoyeyo.",
      "translations": {
        "en": "I’m going to stay overnight at a friend’s house today.",
        "ko": "오늘은 친구 집에서 머무를 거예요.",
        "ipa": "oneureun chingu jib-eseo meomureul geoyeyo.",
        "ar": "سأبيت الليلة في بيت صديقي اليوم.",
        "cs": "Dnes přespím u kamaráda.",
        "da": "Jeg skal overnatte hos en ven i dag.",
        "de": "Ich übernachte heute bei einem Freund.",
        "el": "Θα μείνω απόψε στο σπίτι ενός φίλου.",
        "es": "Voy a pasar la noche en casa de un amigo hoy.",
        "fi": "Aion yöpyä ystävän luona tänään.",
        "fr": "Je vais passer la nuit chez un ami aujourd’hui.",
        "he": "אני אשן הלילה אצל חבר היום.",
        "hi": "मैं आज एक दोस्त के घर रात बिताने वाला हूँ।",
        "hu": "Ma egy barátomnál alszom.",
        "id": "Saya akan menginap di rumah teman hari ini.",
        "it": "Stanotte dormirò a casa di un amico.",
        "ja": "今日は友達の家に泊まります。",
        "nb": "Jeg skal overnatte hos en venn i dag.",
        "nl": "Ik blijf vandaag bij een vriend logeren.",
        "pl": "Dzisiaj zostanę na noc u przyjaciela.",
        "pt": "Vou passar a noite na casa de um amigo hoje.",
        "ro": "Voi dormi la un prieten azi.",
        "ru": "Сегодня я переночую у друга.",
        "sv": "Jag ska sova över hos en vän i dag.",
        "tr": "Bugün bir arkadaşımda kalacağım.",
        "uk": "Сьогодні я заночую в друга.",
        "vi": "Hôm nay tôi sẽ ở qua đêm nhà một người bạn.",
        "yue": "我今日會喺朋友屋企過夜。",
        "zh-Hans": "我今天会在朋友家过夜。"
      },
