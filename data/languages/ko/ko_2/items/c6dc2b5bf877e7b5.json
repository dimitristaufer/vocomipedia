  "sentences": [
    {
      "target": "수천 명이 광장에 모였어요.",
      "reading": "sucheon myeongi gwangjange moyeosseoyo.",
      "translations": {
        "en": "Thousands of people gathered in the square.",
        "ko": "수천 명이 광장에 모였어요.",
        "ipa": "sucheon myeongi gwangjange moyeosseoyo.",
        "ar": "تجمّع آلاف الأشخاص في الساحة.",
        "cs": "Na náměstí se shromáždily tisíce lidí.",
        "da": "Tusindvis af mennesker samledes på pladsen.",
        "de": "Auf dem Platz versammelten sich Tausende von Menschen.",
        "el": "Χιλιάδες άνθρωποι συγκεντρώθηκαν στην πλατεία.",
        "es": "Miles de personas se reunieron en la plaza.",
        "fi": "Tuhannet ihmiset kokoontuivat aukiolle.",
        "fr": "Des milliers de personnes se sont rassemblées sur la place.",
        "he": "אלפי אנשים התאספו בכיכר.",
        "hi": "हज़ारों लोग चौक में इकट्ठा हुए।",
        "hu": "Több ezer ember gyűlt össze a téren.",
        "id": "Ribuan orang berkumpul di alun-alun.",
        "it": "Migliaia di persone si sono radunate nella piazza.",
        "ja": "何千人もの人が広場に集まりました。",
        "nb": "Tusener av mennesker samlet seg på torget.",
        "nl": "Duizenden mensen verzamelden zich op het plein.",
        "pl": "Na placu zebrały się tysiące ludzi.",
        "pt": "Milhares de pessoas se reuniram na praça.",
        "ro": "Mii de oameni s-au adunat în piață.",
        "ru": "На площади собралось тысячи людей.",
        "sv": "Tusentals människor samlades på torget.",
        "tr": "Meydanda binlerce kişi toplandı.",
        "uk": "На площі зібралися тисячі людей.",
        "vi": "Hàng nghìn người đã tụ tập ở quảng trường.",
        "yue": "成千上萬嘅人聚集喺廣場。",
        "zh-Hans": "成千上万的人聚集在广场上。"
      },
