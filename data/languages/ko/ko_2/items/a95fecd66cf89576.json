  "sentences": [
    {
      "target": "이 나라는 문화적 차이가 커요.",
      "reading": "i naraneun munhwajeok chaiga keoyo.",
      "translations": {
        "en": "This country has big cultural differences.",
        "ko": "이 나라는 문화적 차이가 커요.",
        "ipa": "i naraneun munhwajeok chaiga keoyo.",
        "ar": "هذا البلد فيه اختلافات ثقافية كبيرة.",
        "cs": "V téhle zemi jsou velké kulturní rozdíly.",
        "da": "Det her land har store kulturelle forskelle.",
        "de": "In diesem Land gibt es große kulturelle Unterschiede.",
        "el": "Αυτή η χώρα έχει μεγάλες πολιτισμικές διαφορές.",
        "es": "Este país tiene grandes diferencias culturales.",
        "fi": "Tässä maassa on suuria kulttuurieroja.",
        "fr": "Ce pays a de grandes différences culturelles.",
        "he": "במדינה הזאת יש הבדלים תרבותיים גדולים.",
        "hi": "इस देश में सांस्कृतिक अंतर बहुत बड़े हैं।",
        "hu": "Ebben az országban nagy kulturális különbségek vannak.",
        "id": "Negara ini punya banyak perbedaan budaya.",
        "it": "Questo paese ha grandi differenze culturali.",
        "ja": "この国は文化の違いが大きいです。",
        "nb": "Dette landet har store kulturelle forskjeller.",
        "nl": "Dit land heeft grote culturele verschillen.",
        "pl": "Ten kraj ma duże różnice kulturowe.",
        "pt": "Este país tem grandes diferenças culturais.",
        "ro": "Această țară are diferențe culturale mari.",
        "ru": "В этой стране большие культурные различия.",
        "sv": "Det här landet har stora kulturella skillnader.",
        "tr": "Bu ülkede büyük kültürel farklılıklar var.",
        "uk": "У цій країні великі культурні відмінності.",
        "vi": "Đất nước này có nhiều khác biệt văn hóa.",
        "yue": "呢個國家有好大嘅文化差異。",
        "zh-Hans": "这个国家有很大的文化差异。"
