  "sentences": [
    {
      "target": "여름에 계곡에 가서 물놀이를 했어요.",
      "reading": "yeoreume gyegoge gaseo mulnorireul haesseoyo.",
      "translations": {
        "en": "I went to the valley in summer and played in the water.",
        "ko": "여름에 계곡에 가서 물놀이를 했어요.",
        "ipa": "yeoreume gyegoge gaseo mulnorireul haesseoyo.",
        "ar": "ذهبت إلى الوادي في الصيف ولعبت في الماء.",
        "cs": "V létě jsem jel do údolí a cákal jsem se ve vodě.",
        "da": "Jeg tog til dalen om sommeren og badede i vandet.",
        "de": "Im Sommer bin ich ins Tal gegangen und habe im Wasser gespielt.",
        "el": "Πήγα στην κοιλάδα το καλοκαίρι και έπαιξα στο νερό.",
        "es": "Fui al valle en verano y jugué en el agua.",
        "fi": "Menen kesällä laaksoon ja leikin vedessä.",
        "fr": "Je suis allé dans la vallée en été et j’ai joué dans l’eau.",
        "he": "הלכתי אל העמק בקיץ ושיחקתי במים.",
        "hi": "मैं गर्मियों में घाटी में गया और पानी में खेला।",
        "hu": "Nyáron elmentem a völgybe, és a vízben játszottam.",
        "id": "Saya pergi ke lembah pada musim panas dan bermain air.",
        "it": "Sono andato nella valle in estate e ho giocato nell'acqua.",
        "ja": "夏に渓谷に行って、水遊びをしました。",
        "nb": "Jeg dro til dalen om sommeren og lekte i vannet.",
        "nl": "Ik ging in de zomer naar het dal en speelde in het water.",
        "pl": "Pojechałem latem do doliny i bawiłem się w wodzie.",
        "pt": "Fui ao vale no verão e brinquei na água.",
        "ro": "Am mers în vale vara și m-am jucat în apă.",
        "ru": "Летом я поехал в ущелье и играл в воде.",
        "sv": "Jag åkte till dalen på sommaren och lekte i vattnet.",
        "tr": "Yazın vadiye gittim ve suda oynadım.",
        "uk": "Влітку я поїхав у долину й грався у воді.",
        "vi": "Vào mùa hè, tôi đến thung lũng và chơi dưới nước.",
        "yue": "我夏天去咗山谷玩水。",
        "zh-Hans": "夏天我去了山谷玩水。"
      },
