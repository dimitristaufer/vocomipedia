  "sentences": [
    {
      "target": "지하철 문에 어깨가 스쳤어요.",
      "reading": "jihacheol mun-e eokkaega seuchyeosseoyo.",
      "translations": {
        "en": "My shoulder grazed the subway door.",
        "ko": "지하철 문에 어깨가 스쳤어요.",
        "ipa": "jihacheol mun-e eokkaega seuchyeosseoyo.",
        "ar": "لامست كتفي باب المترو.",
        "cs": "Rameno mi zavadilo o dveře metra.",
        "da": "Min skulder strejfede metrodøren.",
        "de": "Meine Schulter streifte die U-Bahn-Tür.",
        "el": "Ο ώμος μου ακούμπησε ελαφρά στην πόρτα του μετρό.",
        "es": "Mi hombro rozó la puerta del metro.",
        "fi": "Hartiani hipaisi metron oveen.",
        "fr": "Mon épaule a frôlé la porte du métro.",
        "he": "הכתף שלי נגעה קלות בדלת הרכבת התחתית.",
        "hi": "मेरे कंधे ने मेट्रो के दरवाज़े को छू लिया।",
        "hu": "A vállam hozzáért a metró ajtajához.",
        "id": "Bahuku menyenggol pintu kereta bawah tanah.",
        "it": "La mia spalla ha sfiorato la porta della metro.",
        "ja": "地下鉄のドアに肩が触れました。",
        "nb": "Skulderen min strøk borti metrodøren.",
        "nl": "Mijn schouder streek langs de metrodeur.",
        "pl": "Moje ramię otarło się o drzwi metra.",
        "pt": "Meu ombro roçou a porta do metrô.",
        "ro": "Umărul mi-a atins ușor ușa de la metrou.",
        "ru": "Моё плечо задело дверь метро.",
        "sv": "Min axel snuddade vid tunnelbanedörren.",
        "tr": "Omzum metro kapısına çarptı.",
        "uk": "Моє плече зачепило двері метро.",
        "vi": "Vai tôi chạm vào cửa tàu điện ngầm.",
        "yue": "我嘅肩膀掂到地鐵門。",
        "zh-Hans": "我的肩膀碰到了地铁门。"
      },
