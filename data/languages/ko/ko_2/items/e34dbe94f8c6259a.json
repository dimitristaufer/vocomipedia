  "sentences": [
    {
      "target": "밤이 되면 외로움이 밀려와요.",
      "reading": "bami doemyeon oeroumi millyeowayo.",
      "translations": {
        "en": "When night falls, loneliness washes over me.",
        "ko": "밤이 되면 외로움이 밀려와요.",
        "ipa": "bami doemyeon oeroumi millyeowayo.",
        "ar": "عندما يحلّ الليل، يطغى عليّ الشعور بالوحدة.",
        "cs": "Když se setmí, přepadne mě samota.",
        "da": "Når det bliver nat, overvælder ensomheden mig.",
        "de": "Wenn es Nacht wird, überkommt mich die Einsamkeit.",
        "el": "Όταν πέφτει η νύχτα, με κυριεύει η μοναξιά.",
        "es": "Cuando cae la noche, me invade la soledad.",
        "fi": "Kun tulee yö, yksinäisyys valtaa minut.",
        "fr": "Quand la nuit tombe, la solitude m'envahit.",
        "he": "כשהלילה יורד, הבדידות מציפה אותי.",
        "hi": "जब रात होती है, तो मुझे अकेलापन घेर लेता है।",
        "hu": "Amikor leszáll az éj, elönt a magány.",
        "id": "Saat malam tiba, kesepian menyergapku.",
        "it": "Quando cala la notte, la solitudine mi assale.",
        "ja": "夜になると、寂しさが押し寄せてきます。",
        "nb": "Når det blir natt, overvelder ensomheten meg.",
        "nl": "Als de nacht valt, overvalt eenzaamheid me.",
        "pl": "Kiedy zapada noc, ogarnia mnie samotność.",
        "pt": "Quando a noite cai, a solidão me invade.",
        "ro": "Când se lasă noaptea, mă copleșește singurătatea.",
        "ru": "Когда наступает ночь, меня охватывает одиночество.",
        "sv": "När det blir natt överväldigas jag av ensamhet.",
        "tr": "Gece olunca yalnızlık içimi kaplıyor.",
        "uk": "Коли настає ніч, мене охоплює самотність.",
        "vi": "Khi đêm xuống, nỗi cô đơn ập đến.",
        "yue": "夜晚一到，孤獨就湧上嚟。",
        "zh-Hans": "到了晚上，孤独就涌上心头。"
      },
