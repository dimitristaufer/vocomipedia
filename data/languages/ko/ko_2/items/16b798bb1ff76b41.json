    {
      "target": "\"저기예요!\" 하고 지수가 소리쳤어요.",
      "reading": "\"jeogiyeyo!\" hago jisuga sorichyeosseoyo.",
      "translations": {
        "en": "\"It's over there!\" Jisoo shouted.",
        "ko": "\"저기예요!\" 하고 지수가 소리쳤어요.",
        "ipa": "\"jeogiyeyo!\" hago jisuga sorichyeosseoyo.",
        "ar": "\"إنه هناك!\" صاحت جي سو.",
        "cs": "„Je to tam!“ vykřikla Jisu.",
        "da": "\"Det er derovre!\" råbte Jisoo.",
        "de": "„Dort drüben!“ rief Jisoo.",
        "el": "«Είναι εκεί!» φώναξε η Τζισού.",
        "es": "\"¡Está allí!\" gritó Jisoo.",
        "fi": "\"Se on tuolla!\" Jisoo huusi.",
        "fr": "« C'est là-bas ! » a crié Jisoo.",
        "he": "\"זה שם!\" ג'יסו צעקה.",
        "hi": "\"वह उधर है!\" जिसू ने चिल्लाकर कहा।",
        "hu": "„Ott van!” kiáltotta Jiszu.",
        "id": "\"Itu di sana!\" teriak Jisoo.",
        "it": "\"È lì!\" gridò Jisoo.",
        "ja": "「あそこです！」とジスが叫びました。",
        "nb": "\"Det er der!\" ropte Jisoo.",
        "nl": "\"Het is daar!\" riep Jisoo.",
        "pl": "„Jest tam!” zawołała Jisoo.",
        "pt": "\"Está ali!\" gritou Jisoo.",
        "ro": "„Este acolo!” a strigat Jisoo.",
        "ru": "«Оно там!» — крикнула Джису.",
        "sv": "\"Det är där borta!\" ropade Jisoo.",
        "tr": "\"Orada!\" diye bağırdı Jisoo.",
        "uk": "«Воно там!» — вигукнула Джісу.",
        "vi": "\"Ở kia kìa!\" Jisoo hét lên.",
        "yue": "「喺嗰邊！」智秀大叫。",
        "zh-Hans": "“在那边！”智秀喊道。"
      },
