  "sentences": [
    {
      "target": "그 일 이래로 매일 운동해요.",
      "reading": "geu il iraero maeil undonghaeyo.",
      "translations": {
        "en": "Since that incident, I exercise every day.",
        "ko": "그 일 이래로 매일 운동해요.",
        "ipa": "geu il iraero maeil undonghaeyo.",
        "ar": "منذ ذلك الحادث أمارس الرياضة كل يوم.",
        "cs": "Od té události cvičím každý den.",
        "da": "Siden den hændelse har jeg dyrket motion hver dag.",
        "de": "Seit dem Vorfall treibe ich jeden Tag Sport.",
        "el": "Από εκείνο το περιστατικό γυμνάζομαι κάθε μέρα.",
        "es": "Desde ese incidente hago ejercicio todos los días.",
        "fi": "Teen liikuntaa joka päivä siitä tapahtumasta lähtien.",
        "fr": "Depuis cet incident, je fais du sport tous les jours.",
        "he": "מאז אותו מקרה אני מתעמל כל יום.",
        "hi": "उस घटना के बाद से मैं हर दिन व्यायाम करता हूँ।",
        "hu": "Az az eset óta minden nap sportolok.",
        "id": "Sejak kejadian itu, saya berolahraga setiap hari.",
        "it": "Da quell'incidente faccio esercizio ogni giorno.",
        "ja": "あの出来事以来、毎日運動しています。",
        "nb": "Siden den hendelsen har jeg trent hver dag.",
        "nl": "Sinds dat incident sport ik elke dag.",
        "pl": "Od tamtego zdarzenia ćwiczę codziennie.",
        "pt": "Desde aquele incidente, faço exercício todos os dias.",
        "ro": "De la incidentul acela fac sport în fiecare zi.",
        "ru": "С того случая я занимаюсь спортом каждый день.",
        "sv": "Sedan den händelsen tränar jag varje dag.",
        "tr": "O olaydan beri her gün spor yapıyorum.",
        "uk": "Від тієї події я займаюся спортом щодня.",
        "vi": "Từ sự việc đó, tôi tập thể dục mỗi ngày.",
        "yue": "自從嗰件事之後，我日日做運動。",
        "zh-Hans": "自从那件事后，我每天都锻炼。"
      },
