  "sentences": [
    {
      "target": "저를 따라오다 보면 바로 보여요.",
      "reading": "jeoreul ttaraoda bomyeon baro boyeoyo.",
      "translations": {
        "en": "If you follow me, you'll see it right away.",
        "ko": "저를 따라오다 보면 바로 보여요.",
        "ipa": "jeoreul ttaraoda bomyeon baro boyeoyo.",
        "ar": "إذا اتبعتني، سترى ذلك فورًا.",
        "cs": "Když mě budete následovat, hned to uvidíte.",
        "da": "Hvis du følger mig, kan du se det med det samme.",
        "de": "Wenn du mir folgst, siehst du es sofort.",
        "el": "Αν με ακολουθήσετε, θα το δείτε αμέσως.",
        "es": "Si me sigues, lo verás enseguida.",
        "fi": "Jos seuraat minua, näet sen heti.",
        "fr": "Si tu me suis, tu le verras tout de suite.",
        "he": "אם תלכו אחריי, תראו את זה מיד.",
        "hi": "अगर आप मेरे पीछे आएँगे, तो आपको यह तुरंत दिखेगा।",
        "hu": "Ha követsz, rögtön meglátod.",
        "id": "Kalau kamu mengikuti saya, kamu akan langsung melihatnya.",
        "it": "Se mi segui, lo vedi subito.",
        "ja": "私についてくれば、すぐ見えます。",
        "nb": "Hvis du følger meg, ser du det med en gang.",
        "nl": "Als je mij volgt, zie je het meteen.",
        "pl": "Jeśli pójdziesz za mną, od razu to zobaczysz.",
        "pt": "Se você me seguir, vai ver isso na hora.",
        "ro": "Dacă mă urmezi, o vezi imediat.",
        "ru": "Если вы пойдёте за мной, то сразу это увидите.",
        "sv": "Om du följer med mig ser du det direkt.",
        "tr": "Beni takip edersen, onu hemen görürsün.",
        "uk": "Якщо ви підете за мною, то одразу це побачите.",
        "vi": "Nếu bạn đi theo tôi, bạn sẽ thấy ngay.",
        "yue": "你跟住我，就會即刻見到。",
        "zh-Hans": "你跟着我，就会马上看到。"
      },
