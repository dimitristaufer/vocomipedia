  "sentences": [
    {
      "target": "그는 약속을 어기고 늦게 왔어요.",
      "reading": "geuneun yaksogeul eogigo neutge wasseoyo.",
      "translations": {
        "en": "He broke his promise and came late.",
        "ko": "그는 약속을 어기고 늦게 왔어요.",
        "ipa": "geuneun yaksogeul eogigo neutge wasseoyo.",
        "ar": "لقد نكث بوعده وجاء متأخرًا.",
        "cs": "Porušil slib a přišel pozdě.",
        "da": "Han brød sit løfte og kom sent.",
        "de": "Er hat sein Versprechen gebrochen und ist spät gekommen.",
        "el": "Έσπασε την υπόσχεσή του και ήρθε αργά.",
        "es": "Rompió su promesa y llegó tarde.",
        "fi": "Hän rikkoi lupauksensa ja tuli myöhässä.",
        "fr": "Il a rompu sa promesse et il est arrivé en retard.",
        "he": "הוא הפר את ההבטחה שלו והגיע מאוחר.",
        "hi": "उसने अपना वादा तोड़ दिया और देर से आया।",
        "hu": "Megszegte az ígéretét, és későn jött.",
        "id": "Dia mengingkari janjinya dan datang terlambat.",
        "it": "Ha infranto la sua promessa ed è arrivato tardi.",
        "ja": "彼は約束を破って、遅れて来ました。",
        "nb": "Han brøt løftet sitt og kom sent.",
        "nl": "Hij brak zijn belofte en kwam laat.",
        "pl": "Złamał obietnicę i przyszedł późno.",
        "pt": "Ele quebrou a promessa e chegou tarde.",
        "ro": "Și-a încălcat promisiunea și a venit târziu.",
        "ru": "Он нарушил обещание и пришёл поздно.",
        "sv": "Han bröt sitt löfte och kom sent.",
        "tr": "Sözünü bozdu ve geç geldi.",
        "uk": "Він порушив свою обіцянку і прийшов пізно.",
        "vi": "Anh ấy đã thất hứa và đến muộn.",
        "yue": "佢打爛咗自己嘅承諾，仲遲咗嚟。",
        "zh-Hans": "他违背了自己的承诺，还来晚了。"
