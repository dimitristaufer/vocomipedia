  "sentences": [
    {
      "target": "같은 실수가 또 되풀이된다.",
      "reading": "gateun silsuga tto doepuridoenda.",
      "translations": {
        "en": "The same mistake is repeated again.",
        "ko": "같은 실수가 또 되풀이된다.",
        "ipa": "gateun silsuga tto doepuridoenda.",
        "ar": "يتكرر الخطأ نفسه مرة أخرى.",
        "cs": "Stejná chyba se opakuje znovu.",
        "da": "Den samme fejl gentager sig igen.",
        "de": "Der gleiche Fehler wiederholt sich wieder.",
        "el": "Το ίδιο λάθος επαναλαμβάνεται πάλι.",
        "es": "Se repite el mismo error otra vez.",
        "fi": "Sama virhe toistuu taas.",
        "fr": "La même erreur se répète encore.",
        "he": "אותה טעות חוזרת שוב.",
        "hi": "वही गलती फिर से दोहराई जाती है।",
        "hu": "Ugyanaz a hiba megint megismétlődik.",
        "id": "Kesalahan yang sama terulang lagi.",
        "it": "Lo stesso errore si ripete di nuovo.",
        "ja": "同じ間違いがまた繰り返される。",
        "nb": "Den samme feilen gjentar seg igjen.",
        "nl": "Dezelfde fout wordt weer herhaald.",
        "pl": "Ten sam błąd powtarza się znowu.",
        "pt": "O mesmo erro se repete de novo.",
        "ro": "Aceeași greșeală se repetă din nou.",
        "ru": "Одна и та же ошибка повторяется снова.",
        "sv": "Samma misstag upprepas igen.",
        "tr": "Aynı hata yine tekrar ediyor.",
        "uk": "Та сама помилка повторюється знову.",
        "vi": "Cùng một lỗi lại xảy ra nữa.",
        "yue": "同一個錯誤又重複發生。",
        "zh-Hans": "同样的错误又重复出现。"
      },
