    {
      "target": "설명을 자세히 해 주세요.",
      "reading": "seolmyeongeul jasehi hae juseyo.",
      "translations": {
        "en": "Please explain it in detail.",
        "ko": "설명을 자세히 해 주세요.",
        "ipa": "seolmyeongeul jasehi hae juseyo.",
        "ar": "من فضلك اشرح الأمر بالتفصيل.",
        "cs": "Prosím, vysvětlete to podrobně.",
        "da": "Forklar det venligst i detaljer.",
        "de": "Bitte erklären Sie das im Detail.",
        "el": "Παρακαλώ εξηγήστε το λεπτομερώς.",
        "es": "Por favor, explícalo en detalle.",
        "fi": "Selitä se tarkasti, kiitos.",
        "fr": "Expliquez-le-moi en détail, s'il vous plaît.",
        "he": "אנא הסבר את זה בפירוט.",
        "hi": "कृपया इसे विस्तार से समझाइए।",
        "hu": "Kérlek, magyarázd el részletesen.",
        "id": "Tolong jelaskan itu secara rinci.",
        "it": "Per favore, spiegalo in dettaglio.",
        "ja": "詳しく説明してください。",
        "nb": "Forklar det gjerne i detalj.",
        "nl": "Leg het alstublieft in detail uit.",
        "pl": "Proszę wyjaśnić to dokładnie.",
        "pt": "Explique isso em detalhes, por favor.",
        "ro": "Vă rog să explicați asta în detaliu.",
        "ru": "Пожалуйста, объясните это подробно.",
        "sv": "Förklara det gärna i detalj.",
        "tr": "Lütfen bunu ayrıntılı olarak açıklayın.",
        "uk": "Будь ласка, поясніть це докладно.",
        "vi": "Làm ơn giải thích chi tiết.",
        "yue": "請你詳細解釋。",
        "zh-Hans": "请详细说明。"
      },
