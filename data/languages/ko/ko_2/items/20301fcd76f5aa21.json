  "sentences": [
    {
      "target": "저는 손수건으로 땀을 닦았어요.",
      "reading": "jeoneun sonsugeoneuro ttameul dakkasseoyo.",
      "translations": {
        "en": "I wiped the sweat with a handkerchief.",
        "ko": "저는 손수건으로 땀을 닦았어요.",
        "ipa": "jeoneun sonsugeoneuro ttameul dakkasseoyo.",
        "ar": "مسحتُ العرق بمنديل.",
        "cs": "Otřel jsem si pot kapesníkem.",
        "da": "Jeg tørrede sveden af med et lommetørklæde.",
        "de": "Ich wischte den Schweiß mit einem Taschentuch ab.",
        "el": "Σκούπισα τον ιδρώτα με ένα μαντίλι.",
        "es": "Me sequé el sudor con un pañuelo.",
        "fi": "Pyyhin hien nenäliinalla.",
        "fr": "J'ai essuyé la sueur avec un mouchoir.",
        "he": "ניגבתי את הזיעה עם ממחטה.",
        "hi": "मैंने रूमाल से पसीना पोंछा।",
        "hu": "Zsebkendővel letöröltem az izzadságot.",
        "id": "Saya menyeka keringat dengan saputangan.",
        "it": "Mi sono asciugato il sudore con un fazzoletto.",
        "ja": "私はハンカチで汗をぬぐいました。",
        "nb": "Jeg tørket svetten med et lommetørkle.",
        "nl": "Ik veegde het zweet weg met een zakdoek.",
        "pl": "Wytarłem pot chusteczką.",
        "pt": "Eu enxuguei o suor com um lenço.",
        "ro": "Mi-am șters transpirația cu o batistă.",
        "ru": "Я вытер пот носовым платком.",
        "sv": "Jag torkade bort svetten med en näsduk.",
        "tr": "Terimi bir mendille sildim.",
        "uk": "Я витер піт носовою хустинкою.",
        "vi": "Tôi lau mồ hôi bằng một chiếc khăn tay.",
        "yue": "我用手巾抹汗。",
        "zh-Hans": "我用手帕擦了汗。"
      },
