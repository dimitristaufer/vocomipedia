    {
      "target": "그는 말하다가 침을 튀겼어요.",
      "reading": "geuneun malhadaga chimeul ttwigyeosseoyo.",
      "translations": {
        "en": "He sprayed spit while talking.",
        "ko": "그는 말하다가 침을 튀겼어요.",
        "ipa": "geuneun malhadaga chimeul ttwigyeosseoyo.",
        "ar": "رَشَّ اللعاب وهو يتكلم.",
        "cs": "Při mluvení rozstřikoval sliny.",
        "da": "Han sprøjtede spyt, mens han talte.",
        "de": "Er spritzte beim Reden Speichel.",
        "el": "Έφτυνε σάλιο καθώς μιλούσε.",
        "es": "Escupió saliva mientras hablaba.",
        "fi": "Hän roiski sylkeä puhuessaan.",
        "fr": "Il projetait de la salive en parlant.",
        "he": "הוא התיז רוק כשהוא דיבר.",
        "hi": "बोलते समय उसने लार उछाली।",
        "hu": "Beszéd közben nyálat fröcskölt.",
        "id": "Dia menyemprotkan ludah saat berbicara.",
        "it": "Ha schizzato saliva mentre parlava.",
        "ja": "彼は話しながらつばを飛ばした。",
        "nb": "Han sprutet spytt mens han snakket.",
        "nl": "Hij spatte speeksel terwijl hij praatte.",
        "pl": "Pluł śliną, kiedy mówił.",
        "pt": "Ele cuspiu saliva enquanto falava.",
        "ro": "A stropit cu salivă când vorbea.",
        "ru": "Он брызгал слюной, когда говорил.",
        "sv": "Han sprutade saliv när han talade.",
        "tr": "Konuşurken tükürük sıçrattı.",
        "uk": "Він бризкав слиною, коли говорив.",
        "vi": "Anh ấy bắn nước bọt khi nói.",
        "yue": "佢講嘢嗰陣噴到口水。",
        "zh-Hans": "他一说话就喷口水。"
      },
