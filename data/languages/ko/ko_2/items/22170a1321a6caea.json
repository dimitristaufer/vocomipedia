  "sentences": [
    {
      "target": "정원에 무궁화가 예쁘게 피었어요.",
      "reading": "jeongwone mugunghwaga yeppeuge pieosseoyo.",
      "translations": {
        "en": "A rose of Sharon bloomed beautifully in the garden.",
        "ko": "정원에 무궁화가 예쁘게 피었어요.",
        "ipa": "jeongwone mugunghwaga yeppeuge pieosseoyo.",
        "ar": "تفتحت وردة شارون بشكل جميل في الحديقة.",
        "cs": "V zahradě krásně rozkvetl ketmie syrský.",
        "da": "Der blomstrede en rosenhibiscus smukt i haven.",
        "de": "Im Garten blühte ein Roseneibisch schön.",
        "el": "Στον κήπο άνθισε όμορφα μια ροδοϊβίσκος.",
        "es": "En el jardín floreció una rosa de Sharon.",
        "fi": "Puutarhassa kukki kauniisti roselilja.",
        "fr": "Un hibiscus de Syrie a fleuri joliment dans le jardin.",
        "he": "ורד השרון פרח יפה בגינה.",
        "hi": "बगीचे में गुलाब-ए-शेरोन बहुत सुंदर ढंग से खिला।",
        "hu": "A kertben szépen kivirágzott egy selyemmályva.",
        "id": "Bunga mugunghwa mekar indah di taman.",
        "it": "Nel giardino è fiorito un ibisco di Siria.",
        "ja": "庭にムクゲがきれいに咲きました。",
        "nb": "Det blomstret en rosenhibiskus vakkert i hagen.",
        "nl": "Er bloeide mooi een roos van Sharon in de tuin.",
        "pl": "W ogrodzie pięknie zakwitł ketmia syryjska.",
        "pt": "No jardim, uma rosa-de-Saron floresceu lindamente.",
        "ro": "În grădină a înflorit frumos un hibiscus de Siria.",
        "ru": "В саду красиво расцвела роза Шарона.",
        "sv": "Det blommade vackert en rosenskibiskus i trädgården.",
        "tr": "Bahçede bir karayemiş gülü güzelce açtı.",
        "uk": "У саду гарно розквітла троянда Шарона.",
        "vi": "Trong vườn, một bông hoa mugunghwa nở rất đẹp.",
        "yue": "花園入面有棵木槿花開得好靚。",
        "zh-Hans": "花园里木槿开得很漂亮。"
      },
