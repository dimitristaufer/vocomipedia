  "sentences": [
    {
      "target": "할머니의 웃음이 방 안을 따뜻하게 했어요.",
      "reading": "할머니에 우슴이 방 아늘 따뜻하게 해써요.",
      "translations": {
        "en": "Grandma's smile warmed the room.",
        "ko": "할머니의 웃음이 방 안을 따뜻하게 했어요.",
        "ipa": "할머니에 우슴이 방 아늘 따뜻하게 해써요.",
        "ar": "دفأَت ابتسامةُ الجدة الغرفة.",
        "cs": "Babiččin úsměv zahřál místnost.",
        "da": "Mormors smil gjorde rummet varmt.",
        "de": "Omas Lächeln machte den Raum warm.",
        "el": "Το χαμόγελο της γιαγιάς ζέστανε το δωμάτιο.",
        "es": "La sonrisa de la abuela calentó la habitación.",
        "fi": "Isoäidin hymy lämmitti huoneen.",
        "fr": "Le sourire de grand-mère a réchauffé la pièce.",
        "he": "החיוך של סבתא חימם את החדר.",
        "hi": "दादी की मुस्कान ने कमरे को गर्म कर दिया।",
        "hu": "Nagymama mosolya meleggé tette a szobát.",
        "id": "Senyum nenek menghangatkan ruangan.",
        "it": "Il sorriso della nonna ha scaldato la stanza.",
        "ja": "おばあさんの笑顔で部屋があたたかくなりました。",
        "nb": "Bestemors smil gjorde rommet varmt.",
        "nl": "De glimlach van oma maakte de kamer warm.",
        "pl": "Uśmiech babci rozgrzał pokój.",
        "pt": "O sorriso da avó aqueceu o quarto.",
        "ro": "Zâmbetul bunicii a încălzit camera.",
        "ru": "Улыбка бабушки согрела комнату.",
        "sv": "Mormors leende värmde rummet.",
        "tr": "Büyükannenin gülümsemesi odayı ısıttı.",
        "uk": "Усмішка бабусі зігріла кімнату.",
        "vi": "Nụ cười của bà đã làm căn phòng ấm lên.",
        "yue": "嫲嫲嘅笑容令房入面暖咗。",
        "zh-Hans": "奶奶的笑容让屋里暖和起来。"
      },
