  "sentences": [
    {
      "target": "그의 무관심이 저를 서운하게 했어요.",
      "reading": "geu-ui mugwansimi jeoreul seowunhage haesseoyo.",
      "translations": {
        "en": "His indifference made me feel hurt.",
        "ko": "그의 무관심이 저를 서운하게 했어요.",
        "ipa": "geu-ui mugwansimi jeoreul seowunhage haesseoyo.",
        "ar": "لقد جرحني عدم اكتراثه.",
        "cs": "Jeho nezájem mě ranil.",
        "da": "Hans ligegyldighed gjorde mig ked af det.",
        "de": "Seine Gleichgültigkeit hat mich verletzt.",
        "el": "Η αδιαφορία του με πλήγωσε.",
        "es": "Su indiferencia me hirió.",
        "fi": "Hänen välinpitämättömyytensä satutti minua.",
        "fr": "Son indifférence m'a blessé.",
        "he": "האדישות שלו פגעה בי.",
        "hi": "उसकी उदासीनता ने मुझे दुखी किया।",
        "hu": "A közönye megbántott.",
        "id": "Sikap tidak pedulinya membuat saya sedih.",
        "it": "La sua indifferenza mi ha ferito.",
        "ja": "彼の無関心に私は傷つきました。",
        "nb": "Hans likegyldighet såret meg.",
        "nl": "Zijn onverschilligheid deed me pijn.",
        "pl": "Jego obojętność mnie zraniła.",
        "pt": "A indiferença dele me magoou.",
        "ro": "Indiferența lui m-a rănit.",
        "ru": "Его равнодушие меня задело.",
        "sv": "Hans likgiltighet gjorde mig ledsen.",
        "tr": "Onun kayıtsızlığı beni kırdı.",
        "uk": "Його байдужість мене образила.",
        "vi": "Sự thờ ơ của anh ấy làm tôi buồn.",
        "yue": "佢嘅冷漠令我好難過。",
        "zh-Hans": "他的冷漠让我很难过。"
      },
