  "sentences": [
    {
      "target": "한겨울에도 저는 매일 산책해요.",
      "reading": "han-gyeouredo jeoneun maeil sanchaekhaeyo.",
      "translations": {
        "en": "Even in midwinter, I walk every day.",
        "ko": "한겨울에도 저는 매일 산책해요.",
        "ipa": "han-gyeouredo jeoneun maeil sanchaekhaeyo.",
        "ar": "حتى في منتصف الشتاء، أمشي كل يوم.",
        "cs": "I uprostřed zimy chodím každý den na procházku.",
        "da": "Selv midt om vinteren går jeg en tur hver dag.",
        "de": "Auch im tiefsten Winter gehe ich jeden Tag spazieren.",
        "el": "Ακόμα και στη βαρυχειμωνιά, περπατάω κάθε μέρα.",
        "es": "Incluso en pleno invierno, camino todos los días.",
        "fi": "Kävelen joka päivä, vaikka on keskitalvi.",
        "fr": "Même au cœur de l'hiver, je me promène tous les jours.",
        "he": "אפילו בשיא החורף אני יוצא להליכה כל יום.",
        "hi": "मैं कड़ाके की सर्दी में भी हर दिन टहलता हूँ।",
        "hu": "Még a tél közepén is minden nap sétálok.",
        "id": "Bahkan di puncak musim dingin, saya berjalan kaki setiap hari.",
        "it": "Anche nel cuore dell'inverno, cammino ogni giorno.",
        "ja": "真冬でも、私は毎日散歩します。",
        "nb": "Selv midt på vinteren går jeg tur hver dag.",
        "nl": "Zelfs midden in de winter maak ik elke dag een wandeling.",
        "pl": "Nawet w samym środku zimy chodzę codziennie na spacer.",
        "pt": "Mesmo no meio do inverno, eu caminho todos os dias.",
        "ro": "Chiar și în miezul iernii, mă plimb în fiecare zi.",
        "ru": "Даже в разгар зимы я гуляю каждый день.",
        "sv": "Även mitt i vintern går jag en promenad varje dag.",
        "tr": "Kışın ortasında bile her gün yürüyüş yapıyorum.",
        "uk": "Навіть серед зими я щодня гуляю.",
        "vi": "Ngay cả giữa mùa đông, tôi vẫn đi bộ mỗi ngày.",
        "yue": "就算係嚴冬，我每日都會散步。",
        "zh-Hans": "即使在隆冬，我也每天散步。"
      },
