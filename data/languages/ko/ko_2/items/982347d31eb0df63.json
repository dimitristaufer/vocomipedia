    {
      "target": "운전할 때는 벨트를 매세요.",
      "reading": "unjeonhal ttaeneun belteureul maeseyo.",
      "translations": {
        "en": "Please fasten your seat belt when you drive.",
        "ko": "운전할 때는 벨트를 매세요.",
        "ipa": "unjeonhal ttaeneun belteureul maeseyo.",
