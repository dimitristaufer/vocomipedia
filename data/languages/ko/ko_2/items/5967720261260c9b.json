  "sentences": [
    {
      "target": "처음 만나서 악수를 했어요.",
      "reading": "cheoeum mannaseo aksureul haesseoyo.",
      "translations": {
        "en": "We shook hands when we first met.",
        "ko": "처음 만나서 악수를 했어요.",
        "ipa": "cheoeum mannaseo aksureul haesseoyo.",
        "ar": "تصافحنا عندما التقينا لأول مرة.",
        "cs": "Když jsme se poprvé setkali, podali jsme si ruku.",
        "da": "Vi gav hånd, da vi mødtes første gang.",
        "de": "Wir gaben uns bei der ersten Begegnung die Hand.",
        "el": "Όταν γνωριστήκαμε πρώτη φορά, δώσαμε τα χέρια.",
        "es": "Nos dimos la mano cuando nos conocimos por primera vez.",
        "fi": "Kun tapasimme ensimmäistä kertaa, kättelimme.",
        "fr": "Nous nous sommes serré la main quand nous nous sommes rencontrés pour la première fois.",
        "he": "כשהכרנו לראשונה, לחצנו ידיים.",
        "hi": "जब हम पहली बार मिले, तो हमने हाथ मिलाया।",
        "hu": "Amikor először találkoztunk, kezet fogtunk.",
        "id": "Kami berjabat tangan saat pertama kali bertemu.",
        "it": "Ci siamo stretti la mano quando ci siamo incontrati per la prima volta.",
        "ja": "初めて会って、握手をしました。",
        "nb": "Vi tok hverandre i hånden da vi møttes første gang.",
        "nl": "We gaven elkaar een hand toen we elkaar voor het eerst ontmoetten.",
        "pl": "Kiedy spotkaliśmy się po raz pierwszy, podaliśmy sobie ręce.",
        "pt": "Nós apertamos as mãos quando nos conhecemos pela primeira vez.",
        "ro": "Ne-am strâns mâna când ne-am întâlnit pentru prima dată.",
        "ru": "Когда мы впервые встретились, мы пожали друг другу руки.",
        "sv": "Vi tog i hand när vi träffades för första gången.",
        "tr": "İlk tanıştığımızda tokalaştık.",
        "uk": "Коли ми вперше зустрілися, ми потиснули руки.",
        "vi": "Chúng tôi bắt tay khi mới gặp nhau.",
        "yue": "我哋第一次見面嗰陣握手。",
        "zh-Hans": "我们第一次见面时握了手。"
      },
