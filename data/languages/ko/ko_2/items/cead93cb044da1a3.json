  "sentences": [
    {
      "target": "바람이 부는 편으로 가세요.",
      "reading": "baram-i bureuneun pyeoneuro gaseyo.",
      "translations": {
        "en": "Please go in the direction the wind is blowing.",
        "ko": "바람이 부는 편으로 가세요.",
        "ipa": "baram-i bureuneun pyeoneuro gaseyo.",
        "ar": "اذهب في اتجاه هبوب الرياح.",
        "cs": "Jděte ve směru, odkud fouká vítr.",
        "da": "Gå i den retning, hvor vinden blæser.",
        "de": "Gehen Sie in die Richtung, aus der der Wind weht.",
        "el": "Πηγαίνετε προς την κατεύθυνση που φυσάει ο άνεμος.",
        "es": "Vaya en la dirección en que sopla el viento.",
        "fi": "Mene siihen suuntaan, johon tuuli puhaltaa.",
        "fr": "Allez dans la direction du vent.",
        "he": "לכו לכיוון שממנו הרוח נושבת.",
        "hi": "हवा जिस दिशा में चल रही है, उस दिशा में जाएँ।",
        "hu": "Arra menjen, amerre a szél fúj.",
        "id": "Silakan pergi ke arah angin bertiup.",
        "it": "Vada nella direzione in cui soffia il vento.",
        "ja": "風が吹く方へ行ってください。",
        "nb": "Gå i den retningen vinden blåser.",
        "nl": "Ga in de richting waar de wind waait.",
        "pl": "Proszę iść w stronę, z której wieje wiatr.",
        "pt": "Vá na direção em que o vento sopra.",
        "ro": "Mergeți în direcția în care bate vântul.",
        "ru": "Идите в ту сторону, куда дует ветер.",
        "sv": "Gå i den riktning vinden blåser.",
        "tr": "Rüzgârın estiği yöne gidin.",
        "uk": "Ідіть у бік, куди дме вітер.",
        "vi": "Đi về phía gió đang thổi.",
        "yue": "請向風吹嘅方向行。",
        "zh-Hans": "请往风吹的方向走。"
      },
