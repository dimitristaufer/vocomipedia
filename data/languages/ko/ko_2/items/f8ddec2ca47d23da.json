  "sentences": [
    {
      "target": "그녀의 미소가 참 따뜻했어요.",
      "reading": "geunyeoui misoga cham ttatteuthaesseoyo.",
      "translations": {
        "en": "Her smile was so warm.",
        "ko": "그녀의 미소가 참 따뜻했어요.",
        "ipa": "geunyeoui misoga cham ttatteuthaesseoyo.",
        "ar": "كانت ابتسامتها دافئة جدًا.",
        "cs": "Její úsměv byl opravdu vřelý.",
        "da": "Hendes smil var så varmt.",
        "de": "Ihr Lächeln war so warm.",
        "el": "Το χαμόγελό της ήταν τόσο ζεστό.",
        "es": "Su sonrisa era muy cálida.",
        "fi": "Hänen hymynsä oli niin lämmin.",
        "fr": "Son sourire était si chaleureux.",
        "he": "החיוך שלה היה כל כך חם.",
        "hi": "उसकी मुस्कान बहुत गर्मजोशी भरी थी।",
        "hu": "A mosolya nagyon meleg volt.",
        "id": "Senyumnya sangat hangat.",
        "it": "Il suo sorriso era così caldo.",
        "ja": "彼女の笑顔はとても温かかったです。",
        "nb": "Smilet hennes var så varmt.",
        "nl": "Haar glimlach was zo warm.",
        "pl": "Jej uśmiech był taki ciepły.",
        "pt": "O sorriso dela era tão caloroso.",
        "ro": "Zâmbetul ei a fost atât de cald.",
        "ru": "Её улыбка была такой тёплой.",
        "sv": "Hennes leende var så varmt.",
        "tr": "Onun gülümsemesi çok sıcaktı.",
        "uk": "Її усмішка була такою теплою.",
        "vi": "Nụ cười của cô ấy thật ấm áp.",
        "yue": "佢嘅笑容好溫暖。",
        "zh-Hans": "她的笑容很温暖。"
      },
