    {
      "target": "이 차는 기름을 많이 소비한다.",
      "reading": "i chaneun gireumeul mani sobihanda",
      "translations": {
        "en": "This car consumes a lot of fuel.",
        "ko": "이 차는 기름을 많이 소비한다.",
        "ipa": "i chaneun gireumeul mani sobihanda",
        "ar": "هذه السيارة تستهلك الكثير من الوقود.",
        "cs": "Toto auto spotřebuje hodně paliva.",
        "da": "Denne bil bruger meget brændstof.",
        "de": "Dieses Auto verbraucht viel Benzin.",
        "el": "Αυτό το αυτοκίνητο καταναλώνει πολύ καύσιμο.",
        "es": "Este coche consume mucho combustible.",
        "fi": "Tämä auto kuluttaa paljon polttoainetta.",
        "fr": "Cette voiture consomme beaucoup de carburant.",
        "he": "המכונית הזאת צורכת הרבה דלק.",
        "hi": "यह कार बहुत ज़्यादा ईंधन खर्च करती है।",
        "hu": "Ez az autó sok üzemanyagot fogyaszt.",
        "id": "Mobil ini menghabiskan banyak bahan bakar.",
        "it": "Questa macchina consuma molto carburante.",
        "ja": "この車は燃料をたくさん消費します。",
        "nb": "Denne bilen bruker mye drivstoff.",
        "nl": "Deze auto verbruikt veel brandstof.",
        "pl": "Ten samochód zużywa dużo paliwa.",
        "pt": "Este carro consome muito combustível.",
        "ro": "Mașina asta consumă mult combustibil.",
        "ru": "Эта машина потребляет много топлива.",
        "sv": "Den här bilen använder mycket bränsle.",
        "tr": "Bu araba çok fazla yakıt tüketiyor.",
        "uk": "Ця машина споживає багато палива.",
        "vi": "Chiếc xe này tiêu thụ rất nhiều nhiên liệu.",
        "yue": "呢架車食好多油。",
        "zh-Hans": "这辆车耗油很多。"
      },
