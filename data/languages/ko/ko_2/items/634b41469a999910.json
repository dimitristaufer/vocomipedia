    {
      "target": "그는 약속에 늦기 일쑤예요.",
      "reading": "geuneun yaksoge neutgi ilssu-yeyo.",
      "translations": {
        "en": "He is often late for appointments.",
        "ko": "그는 약속에 늦기 일쑤예요.",
        "ipa": "geuneun yaksoge neutgi ilssu-yeyo.",
        "ar": "غالبًا ما يتأخر عن المواعيد.",
        "cs": "Bývá často pozdě na schůzky.",
        "da": "Han kommer ofte for sent til aftaler.",
        "de": "Er kommt oft zu spät zu Terminen.",
        "el": "Συνηθίζει να αργεί στα ραντεβού.",
        "es": "Suele llegar tarde a las citas.",
        "fi": "Hän on usein myöhässä tapaamisista.",
        "fr": "Il est souvent en retard aux rendez-vous.",
        "he": "הוא בדרך כלל מאחר לפגישות.",
        "hi": "वह अक्सर मुलाकातों के लिए देर से आता है।",
        "hu": "Gyakran késik a megbeszélésekről.",
        "id": "Dia sering terlambat ke janji temu.",
        "it": "Lui arriva spesso in ritardo agli appuntamenti.",
        "ja": "彼は約束に遅れがちです。",
        "nb": "Han kommer ofte for sent til avtaler.",
        "nl": "Hij komt vaak te laat op afspraken.",
        "pl": "Często spóźnia się na spotkania.",
        "pt": "Ele costuma se atrasar para os compromissos.",
        "ro": "Ajunge adesea târziu la întâlniri.",
        "ru": "Он часто опаздывает на встречи.",
        "sv": "Han kommer ofta sent till möten.",
        "tr": "Toplantılara sık sık geç kalır.",
        "uk": "Він часто запізнюється на зустрічі.",
        "vi": "Anh ấy thường hay đến muộn các cuộc hẹn.",
        "yue": "佢成日約會遲到。",
        "zh-Hans": "他约会总是迟到。"
      },
