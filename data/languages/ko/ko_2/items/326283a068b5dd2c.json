  "sentences": [
    {
      "target": "이 길은 이제 익숙합니다.",
      "reading": "I gireun ije iksukhamnida.",
      "translations": {
        "en": "I'm used to this road now.",
        "ko": "이 길은 이제 익숙합니다.",
        "ipa": "I gireun ije iksukhamnida.",
        "ar": "أنا معتاد الآن على هذا الطريق.",
        "cs": "Na tuhle cestu jsem už zvyklý.",
        "da": "Jeg er vant til denne vej nu.",
        "de": "Ich bin jetzt an diese Straße gewöhnt.",
        "el": "Έχω πλέον συνηθίσει αυτόν τον δρόμο.",
        "es": "Ya estoy acostumbrado a esta calle.",
        "fi": "Olen nyt tottunut tähän tiehen.",
        "fr": "Je suis maintenant habitué à cette route.",
        "he": "אני כבר רגיל לכביש הזה.",
        "hi": "अब मुझे इस सड़क की आदत है।",
        "hu": "Már hozzászoktam ehhez az úthoz.",
        "id": "Saya sudah terbiasa dengan jalan ini.",
        "it": "Ora sono abituato a questa strada.",
        "ja": "私はもうこの道に慣れています。",
        "nb": "Jeg er vant til denne veien nå.",
        "nl": "Ik ben nu gewend aan deze weg.",
        "pl": "Jestem już przyzwyczajony do tej drogi.",
        "pt": "Já estou habituado a esta rua.",
        "ro": "Sunt deja obișnuit cu drumul acesta.",
        "ru": "Я уже привык к этой дороге.",
        "sv": "Jag är van vid den här vägen nu.",
        "tr": "Artık bu yola alıştım.",
        "uk": "Я вже звик до цієї дороги.",
        "vi": "Bây giờ tôi đã quen với con đường này.",
        "yue": "我而家已經習慣呢條路。",
        "zh-Hans": "我现在已经习惯这条路了。"
      },
