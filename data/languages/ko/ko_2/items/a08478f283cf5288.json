  "sentences": [
    {
      "target": "아이들이 축구장에서 공을 차요.",
      "reading": "aideuri chukgujangeseo gong-eul chayo.",
      "translations": {
        "en": "The kids are kicking a ball on the soccer field.",
        "ko": "아이들이 축구장에서 공을 차요.",
        "ipa": "aideuri chukgujangeseo gong-eul chayo.",
        "ar": "الأطفال يركلون الكرة في ملعب كرة القدم.",
        "cs": "Děti kopou na fotbalovém hřišti do míče.",
        "da": "Børnene sparker til en bold på fodboldbanen.",
        "de": "Die Kinder schießen auf dem Fußballplatz einen Ball.",
        "el": "Τα παιδιά κλοτσάνε μια μπάλα στο γήπεδο ποδοσφαίρου.",
        "es": "Los niños patean una pelota en la cancha de fútbol.",
        "fi": "Lapset potkivat palloa jalkapallokentällä.",
        "fr": "Les enfants tapent dans un ballon sur le terrain de foot.",
        "he": "הילדים בועטים בכדור במגרש הכדורגל.",
        "hi": "बच्चे फुटबॉल के मैदान में गेंद को मार रहे हैं।",
        "hu": "A gyerekek a focipályán rúgják a labdát.",
        "id": "Anak-anak menendang bola di lapangan sepak bola.",
        "it": "I bambini tirano un calcio al pallone sul campo da calcio.",
        "ja": "子どもたちがサッカー場でボールを蹴っています。",
        "nb": "Barna sparker ball på fotballbanen.",
        "nl": "De kinderen trappen een bal op het voetbalveld.",
        "pl": "Dzieci kopią piłkę na boisku do piłki nożnej.",
        "pt": "As crianças chutam uma bola no campo de futebol.",
        "ro": "Copiii lovesc mingea pe terenul de fotbal.",
        "ru": "Дети пинают мяч на футбольном поле.",
        "sv": "Barnen sparkar på en boll på fotbollsplanen.",
        "tr": "Çocuklar futbol sahasında topa vuruyor.",
        "uk": "Діти грають у м'яч на футбольному полі.",
        "vi": "Bọn trẻ đang đá bóng trên sân bóng đá.",
        "yue": "啲小朋友喺足球場踢波。",
        "zh-Hans": "孩子们在足球场上踢球。"
      },
