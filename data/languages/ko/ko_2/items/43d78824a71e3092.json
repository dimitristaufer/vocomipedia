  "sentences": [
    {
      "target": "아침에 알을 두 개 삶았어요.",
      "reading": "아치메 아를 두 개 삼마써요.",
      "translations": {
        "en": "I boiled two eggs for breakfast.",
        "ko": "아침에 알을 두 개 삶았어요.",
        "ipa": "아치메 아를 두 개 삼마써요.",
        "ar": "سلقْتُ بيضتين للفطور.",
        "cs": "Ráno jsem uvařil dvě vejce.",
        "da": "Jeg kogte to æg til morgenmad.",
        "de": "Ich habe zum Frühstück zwei Eier gekocht.",
        "el": "Έβρασα δύο αυγά για πρωινό.",
        "es": "Cocí dos huevos para el desayuno.",
        "fi": "Keitin aamiaiseksi kaksi kananmunaa.",
        "fr": "J'ai fait cuire deux œufs pour le petit-déjeuner.",
        "he": "בישלתי שתי ביצים לארוחת בוקר.",
        "hi": "मैंने नाश्ते के लिए दो अंडे उबाले।",
        "hu": "Két tojást főztem reggelire.",
        "id": "Saya merebus dua telur untuk sarapan.",
        "it": "Ho lessato due uova per colazione.",
        "ja": "朝食に卵を2つゆでました。",
        "nb": "Jeg kokte to egg til frokost.",
        "nl": "Ik heb twee eieren gekookt als ontbijt.",
        "pl": "Ugotowałem dwa jajka na śniadanie.",
        "pt": "Cozinhei dois ovos para o café da manhã.",
        "ro": "Am fiert două ouă la micul dejun.",
        "ru": "Я сварил два яйца на завтрак.",
        "sv": "Jag kokade två ägg till frukost.",
        "tr": "Kahvaltı için iki yumurta haşladım.",
        "uk": "Я зварив два яйця на сніданок.",
        "vi": "Tôi đã luộc hai quả trứng cho bữa sáng.",
        "yue": "我朝早煮咗兩隻蛋食早餐。",
        "zh-Hans": "我早上煮了两个鸡蛋当早餐。"
      },
