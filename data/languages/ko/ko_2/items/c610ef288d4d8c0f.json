  "sentences": [
    {
      "target": "그 선생님은 학생들에게 영향력이 커요.",
      "reading": "geu seonsaengnimeun haksaengdeurege yeonghyangryeogi keoyo.",
      "translations": {
        "en": "That teacher has a strong influence on the students.",
        "ko": "그 선생님은 학생들에게 영향력이 커요.",
        "ipa": "geu seonsaengnimeun haksaengdeurege yeonghyangryeogi keoyo.",
        "ar": "ذلك المعلّم له تأثير كبير على الطلاب.",
        "cs": "Ten učitel má na studenty velký vliv.",
        "da": "Den lærer har stor indflydelse på eleverne.",
        "de": "Der Lehrer hat großen Einfluss auf die Schüler.",
        "el": "Αυτός ο δάσκαλος έχει μεγάλη επιρροή στους μαθητές.",
        "es": "Ese profesor tiene mucha influencia en los estudiantes.",
        "fi": "Sillä opettajalla on suuri vaikutus oppilaisiin.",
        "fr": "Ce professeur a beaucoup d'influence sur les élèves.",
        "he": "לאותו מורה יש השפעה גדולה על התלמידים.",
        "hi": "उस शिक्षक का छात्रों पर बहुत प्रभाव है।",
        "hu": "Az a tanár nagy hatással van a diákokra.",
        "id": "Guru itu punya pengaruh besar pada siswa.",
        "it": "Quel professore ha molta influenza sugli studenti.",
        "ja": "その先生は生徒たちに大きな影響力があります。",
        "nb": "Den læreren har stor innflytelse på elevene.",
        "nl": "Die leraar heeft veel invloed op de leerlingen.",
        "pl": "Ten nauczyciel ma duży wpływ na uczniów.",
        "pt": "Aquele professor tem muita influência sobre os alunos.",
        "ro": "Profesorul acela are multă influență asupra elevilor.",
        "ru": "У того учителя большое влияние на учеников.",
        "sv": "Den läraren har stort inflytande på eleverna.",
        "tr": "O öğretmenin öğrenciler üzerinde büyük etkisi var.",
        "uk": "Той учитель має великий вплив на учнів.",
        "vi": "Thầy giáo đó có ảnh hưởng lớn đến học sinh.",
        "yue": "嗰位老師對學生好有影響力。",
        "zh-Hans": "那位老师对学生影响很大。"
      },
