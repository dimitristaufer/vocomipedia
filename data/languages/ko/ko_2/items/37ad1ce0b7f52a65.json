    {
      "target": "그 이야기는 이다음에 하자.",
      "reading": "geu iyagineun idaume haja.",
      "translations": {
        "en": "Let's talk about that later.",
        "ko": "그 이야기는 이다음에 하자.",
        "ipa": "geu iyagineun idaume haja.",
        "ar": "لنتحدث عن ذلك لاحقًا.",
        "cs": "O tom si promluvíme později.",
        "da": "Lad os tale om det senere.",
        "de": "Lass uns später darüber reden.",
        "el": "Ας μιλήσουμε γι’ αυτό αργότερα.",
        "es": "Hablemos de eso más tarde.",
        "fi": "Puhutaan siitä myöhemmin.",
        "fr": "Parlons-en plus tard.",
        "he": "נדבר על זה אחר כך.",
        "hi": "उसके बारे में बाद में बात करेंगे।",
        "hu": "Majd később beszélünk erről.",
        "id": "Kita bicarakan itu nanti saja.",
        "it": "Ne parliamo più tardi.",
        "ja": "その話はまた今度にしましょう。",
        "nb": "La oss snakke om det senere.",
        "nl": "Laten we het daar later over hebben.",
        "pl": "Porozmawiajmy o tym później.",
        "pt": "Vamos falar disso mais tarde.",
        "ro": "Să vorbim despre asta mai târziu.",
        "ru": "Поговорим об этом позже.",
        "sv": "Vi kan prata om det senare.",
        "tr": "Bunu sonra konuşuruz.",
        "uk": "Поговоримо про це пізніше.",
        "vi": "Mình nói chuyện đó sau nhé.",
        "yue": "我哋遲啲再講嗰件事。",
        "zh-Hans": "我们过会儿再谈那件事。"
      },
