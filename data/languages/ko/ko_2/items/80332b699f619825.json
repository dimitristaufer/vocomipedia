  "sentences": [
    {
      "target": "가게 앞에 손님들이 길게 늘어서 있어요.",
      "reading": "gage ap-e sonnimdeuri gilge neureoseo isseoyo.",
      "translations": {
        "en": "The customers are lined up long in front of the store.",
        "ko": "가게 앞에 손님들이 길게 늘어서 있어요.",
        "ipa": "gage ap-e sonnimdeuri gilge neureoseo isseoyo.",
        "ar": "يقف الزبائن في صف طويل أمام المتجر.",
        "cs": "Před obchodem stojí dlouhá řada zákazníků.",
        "da": "Kunderne står i en lang kø foran butikken.",
        "de": "Vor dem Laden steht eine lange Schlange von Kunden.",
        "el": "Οι πελάτες περιμένουν σε μεγάλη ουρά μπροστά στο μαγαζί.",
        "es": "Los clientes están haciendo fila frente a la tienda.",
        "fi": "Asiakkaat ovat jonossa kaupan edessä.",
        "fr": "Les clients font la queue en une longue file devant le magasin.",
        "he": "הלקוחות עומדים בתור ארוך מול החנות.",
        "hi": "ग्राहक दुकान के सामने लंबी कतार में खड़े हैं।",
        "hu": "A vásárlók hosszú sorban állnak az üzlet előtt.",
        "id": "Para pelanggan mengantre panjang di depan toko.",
        "it": "I clienti sono in fila lunga davanti al negozio.",
        "ja": "店の前にお客さんが長く並んでいます。",
        "nb": "Kundene står i en lang kø foran butikken.",
        "nl": "De klanten staan in een lange rij voor de winkel.",
        "pl": "Klienci stoją w długiej kolejce przed sklepem.",
        "pt": "Os clientes estão em uma longa fila em frente à loja.",
        "ro": "Clienții stau la o coadă lungă în fața magazinului.",
        "ru": "Покупатели стоят длинной очередью перед магазином.",
        "sv": "Kunderna står i en lång kö framför butiken.",
        "tr": "Müşteriler mağazanın önünde uzun bir kuyruk oluşturmuş.",
        "uk": "Покупці стоять у довгій черзі перед магазином.",
        "vi": "Khách hàng đang xếp hàng dài trước cửa hàng.",
        "yue": "客人喺舖頭前面排咗條長龍。",
        "zh-Hans": "顾客们在商店前排起了长队。"
      },
