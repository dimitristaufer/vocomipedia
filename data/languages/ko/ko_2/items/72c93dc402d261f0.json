    {
      "target": "멀리서 웃음소리가 들렸어요.",
      "reading": "meolliseo useumsoriga deullyeosseoyo.",
      "translations": {
        "en": "I heard the sound of laughter from far away.",
        "ko": "멀리서 웃음소리가 들렸어요.",
        "ipa": "meolliseo useumsoriga deullyeosseoyo.",
        "ar": "سمعت ضحكًا من بعيد.",
        "cs": "Slyšel jsem smích z dálky.",
        "da": "Jeg hørte latter langt væk fra.",
        "de": "Ich hörte aus der Ferne Lachen.",
        "el": "Άκουσα γέλια από μακριά.",
        "es": "Oí risas desde lejos.",
        "fi": "Kuulin naurua kaukaa.",
        "fr": "J’ai entendu des rires de loin.",
        "he": "שמעתי צחוק מרחוק.",
        "hi": "मैंने दूर से हँसी की आवाज़ सुनी।",
        "hu": "Messziről nevetést hallottam.",
        "id": "Saya mendengar suara tawa dari jauh.",
        "it": "Ho sentito delle risate da lontano.",
        "ja": "遠くから笑い声が聞こえました。",
        "nb": "Jeg hørte latter på lang avstand.",
        "nl": "Ik hoorde gelach van ver weg.",
        "pl": "Usłyszałem śmiech z daleka.",
        "pt": "Ouvi risadas de longe.",
        "ro": "Am auzit râsete de departe.",
        "ru": "Я услышал смех издалека.",
        "sv": "Jag hörde skratt på långt håll.",
        "tr": "Uzaktan kahkaha duydum.",
        "uk": "Я почув сміх здалеку.",
        "vi": "Tôi nghe tiếng cười từ xa.",
        "yue": "我喺遠處聽到笑聲。",
        "zh-Hans": "我听见远处传来笑声。"
      },
