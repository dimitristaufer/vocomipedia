  "sentences": [
    {
      "target": "할아버지는 한평생 농사를 지으셨어요.",
      "reading": "harabeojineun hanpyeongsaeng nongsareul jieusyeosseoyo.",
      "translations": {
        "en": "My grandfather farmed all his life.",
        "ko": "할아버지는 한평생 농사를 지으셨어요.",
        "ipa": "harabeojineun hanpyeongsaeng nongsareul jieusyeosseoyo.",
        "ar": "كان جدي يزرع طوال حياته.",
        "cs": "Můj dědeček celý život hospodařil.",
        "da": "Min bedstefar dyrkede jorden hele sit liv.",
        "de": "Mein Großvater hat sein Leben lang Landwirtschaft betrieben.",
        "el": "Ο παππούς μου καλλιεργούσε τη γη όλη του τη ζωή.",
        "es": "Mi abuelo cultivó toda su vida.",
        "fi": "Isoisäni viljeli koko elämänsä.",
        "fr": "Mon grand-père a cultivé toute sa vie.",
        "he": "סבא שלי עבד בחקלאות כל חייו.",
        "hi": "मेरे दादाजी ने सारी ज़िंदगी खेती की।",
        "hu": "A nagyapám egész életében földet művelt.",
        "id": "Kakek saya bertani sepanjang hidupnya.",
        "it": "Mio nonno ha fatto il contadino per tutta la vita.",
        "ja": "祖父は一生農業をしていました。",
        "nb": "Bestefaren min drev med jordbruk hele livet.",
        "nl": "Mijn grootvader was zijn hele leven boer.",
        "pl": "Mój dziadek całe życie uprawiał ziemię.",
        "pt": "Meu avô trabalhou na lavoura a vida toda.",
        "ro": "Bunicul meu a lucrat toată viața la câmp.",
        "ru": "Мой дед всю жизнь работал в поле.",
        "sv": "Min farfar odlade hela livet.",
        "tr": "Dedem bütün hayatı boyunca çiftçilik yaptı.",
        "uk": "Мій дідусь усе життя займався фермерством.",
        "vi": "Ông tôi làm nông cả đời.",
        "yue": "我爺爺成世都耕田。",
        "zh-Hans": "我爷爷一辈子都在种地。"
      },
