  "sentences": [
    {
      "target": "박스는 창고에 넣어 두세요.",
      "reading": "bakseuneun changgoe neoeo duseyo.",
      "translations": {
        "en": "Please put the boxes in the warehouse.",
        "ko": "박스는 창고에 넣어 두세요.",
        "ipa": "bakseuneun changgoe neoeo duseyo.",
        "ar": "ضع الصناديق في المستودع.",
        "cs": "Dejte prosím krabice do skladu.",
        "da": "Sæt venligst kasserne i lageret.",
        "de": "Bitte stellen Sie die Kartons ins Lager.",
        "el": "Βάλτε τα κουτιά στην αποθήκη.",
        "es": "Por favor, guarda las cajas en el almacén.",
        "fi": "Laita laatikot varastoon.",
        "fr": "Mettez les cartons dans l'entrepôt, s'il vous plaît.",
        "he": "שימו את הקרטונים במחסן.",
        "hi": "कृपया डिब्बों को गोदाम में रख दो।",
        "hu": "Tedd a dobozokat a raktárba.",
        "id": "Tolong masukkan kotak-kotak itu ke gudang.",
        "it": "Metti per favore le scatole nel magazzino.",
        "ja": "箱は倉庫に入れておいてください。",
        "nb": "Sett boksene i lageret, takk.",
        "nl": "Zet de dozen alsjeblieft in het magazijn.",
        "pl": "Włóż proszę pudełka do magazynu.",
        "pt": "Coloque as caixas no armazém, por favor.",
        "ro": "Pune te rog cutiile în depozit.",
        "ru": "Положите коробки на склад.",
        "sv": "Ställ lådorna i förrådet, tack.",
        "tr": "Kutuları lütfen depoya koyun.",
        "uk": "Покладіть коробки на склад.",
        "vi": "Hãy để các thùng vào kho.",
        "yue": "請將啲盒放入倉庫。",
        "zh-Hans": "请把箱子放进仓库。"
      },
