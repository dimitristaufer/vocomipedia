  "sentences": [
    {
      "target": "동생이 장난으로 저를 바보라고 했어요.",
      "reading": "dongsaengi jangnan-euro jeoreul baborago haesseoyo.",
      "translations": {
        "en": "My younger sibling jokingly called me a fool.",
        "ko": "동생이 장난으로 저를 바보라고 했어요.",
        "ipa": "dongsaengi jangnan-euro jeoreul baborago haesseoyo.",
        "ar": "ناداني أخي الأصغر مازحًا بالأحمق.",
        "cs": "Mladší sourozenec mi ze žertu řekl, že jsem hlupák.",
        "da": "Min yngre søskende kaldte mig for sjov en tåbe.",
        "de": "Mein jüngerer Bruder hat mich im Scherz einen Dummkopf genannt.",
        "el": "Το μικρότερο αδερφάκι μου με είπε χαζό για αστείο.",
        "es": "Mi hermano menor me llamó tonto en broma.",
        "fi": "Nuorempi sisarukseni sanoi minua leikillään tyhmäksi.",
        "fr": "Mon petit frère m'a traité d'idiot pour rire.",
        "he": "אחי הקטן קרא לי טיפש בצחוק.",
        "hi": "मेरे छोटे भाई-बहन ने मज़ाक में मुझे बेवकूफ कहा।",
        "hu": "A kisebb testvérem viccből hülyének nevezett.",
        "id": "Adik saya bercanda menyebut saya bodoh.",
        "it": "Mio fratello minore mi ha chiamato stupido per scherzo.",
        "ja": "弟は冗談で私をばかと言った。",
        "nb": "Min yngre søsken kalte meg tullete som en spøk.",
        "nl": "Mijn jongere broer noemde me voor de grap een domkop.",
        "pl": "Młodsze rodzeństwo żartem nazwało mnie głupkiem.",
        "pt": "Meu irmão mais novo me chamou de bobo de brincadeira.",
        "ro": "Fratele meu mai mic mi-a spus în glumă prostule.",
        "ru": "Младший брат в шутку назвал меня дураком.",
        "sv": "Min yngre syskon kallade mig skojigt för fånig.",
        "tr": "Küçük kardeşim bana şakayla aptal dedi.",
        "uk": "Молодший брат пожартома назвав мене дурнем.",
        "vi": "Em tôi đùa gọi tôi là đồ ngốc.",
        "yue": "細佬同我開玩笑，叫我做傻瓜。",
        "zh-Hans": "弟弟开玩笑地叫我傻瓜。"
      },
