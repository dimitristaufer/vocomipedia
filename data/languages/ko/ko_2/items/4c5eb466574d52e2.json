  "sentences": [
    {
      "target": "오늘은 잠바를 입고 나갔어요.",
      "reading": "oneureun jambareul ipgo nagasseoyo.",
      "translations": {
        "en": "I went out wearing a jumper today.",
        "ko": "오늘은 잠바를 입고 나갔어요.",
        "ipa": "oneureun jambareul ipgo nagasseoyo.",
        "ar": "خرجت اليوم مرتديًا سترة.",
        "cs": "Dnes jsem vyšel ven v bundě.",
        "da": "Jeg gik ud i en jakke i dag.",
        "de": "Heute bin ich mit einer Jacke rausgegangen.",
        "el": "Σήμερα βγήκα φορώντας ένα μπουφάν.",
        "es": "Hoy salí con una chaqueta.",
        "fi": "Lähdin tänään ulos takki päällä.",
        "fr": "Je suis sorti aujourd'hui en portant une veste.",
        "he": "יצאתי היום עם ג'קט.",
        "hi": "मैं आज जैकेट पहनकर बाहर गया।",
        "hu": "Ma kabátban mentem ki.",
        "id": "Hari ini saya keluar memakai jaket.",
        "it": "Oggi sono uscito con una giacca.",
        "ja": "今日はジャンパーを着て出かけました。",
        "nb": "Jeg gikk ut med en jakke i dag.",
        "nl": "Ik ging vandaag naar buiten met een jas aan.",
        "pl": "Dziś wyszedłem w kurtce.",
        "pt": "Hoje saí de jaqueta.",
        "ro": "Astăzi am ieșit purtând o geacă.",
        "ru": "Сегодня я вышел в куртке.",
        "sv": "Jag gick ut i en jacka i dag.",
        "tr": "Bugün ceket giyip dışarı çıktım.",
        "uk": "Сьогодні я вийшов у куртці.",
        "vi": "Hôm nay tôi ra ngoài mặc một chiếc áo khoác.",
        "yue": "今日我著住件褸出門。",
        "zh-Hans": "我今天穿着夹克出门了。"
      },
