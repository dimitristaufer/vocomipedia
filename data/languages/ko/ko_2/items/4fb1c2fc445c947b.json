  "sentences": [
    {
      "target": "일정이 아직 불확실해요.",
      "reading": "iljeongi ajik bulhwaksilhaeyo.",
      "translations": {
        "en": "The schedule is still uncertain.",
        "ko": "일정이 아직 불확실해요.",
        "ipa": "iljeongi ajik bulhwaksilhaeyo.",
        "ar": "الجدول الزمني ما زال غير مؤكد.",
        "cs": "Rozvrh je zatím nejistý.",
        "da": "Tidsplanen er stadig usikker.",
        "de": "Der Zeitplan ist noch ungewiss.",
        "el": "Το πρόγραμμα είναι ακόμα αβέβαιο.",
        "es": "El horario sigue siendo incierto.",
        "fi": "Aikataulu on vielä epävarma.",
        "fr": "L'horaire est encore incertain.",
        "he": "הלו״ז עדיין לא ברור.",
        "hi": "कार्यक्रम अभी भी अनिश्चित है।",
        "hu": "Az időbeosztás még bizonytalan.",
        "id": "Jadwalnya masih tidak pasti.",
        "it": "L'orario è ancora incerto.",
        "ja": "予定はまだ不確かです。",
        "nb": "Timeplanen er fortsatt usikker.",
        "nl": "De planning is nog onzeker.",
        "pl": "Plan jest jeszcze niepewny.",
        "pt": "A agenda ainda está incerta.",
        "ro": "Programul este încă nesigur.",
        "ru": "Расписание пока неясно.",
        "sv": "Schemat är fortfarande osäkert.",
        "tr": "Program hâlâ belirsiz.",
        "uk": "Розклад поки що невизначений.",
        "vi": "Lịch trình vẫn chưa chắc chắn.",
        "yue": "行程仲未確定。",
        "zh-Hans": "日程还不确定。"
      },
