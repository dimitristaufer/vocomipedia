  "sentences": [
    {
      "target": "이 책은 내년에 출판될 예정이에요.",
      "reading": "I chaekeun naenyeone chulpan doel yejeong-ieyo.",
      "translations": {
        "en": "This book is scheduled to be published next year.",
        "ko": "이 책은 내년에 출판될 예정이에요.",
        "ipa": "I chaekeun naenyeone chulpan doel yejeong-ieyo.",
        "ar": "من المقرر أن يُنشر هذا الكتاب العام المقبل.",
        "cs": "Tato kniha má vyjít příští rok.",
        "da": "Denne bog skal udkomme næste år.",
        "de": "Dieses Buch soll nächstes Jahr veröffentlicht werden.",
        "el": "Αυτό το βιβλίο πρόκειται να εκδοθεί του χρόνου.",
        "es": "Este libro está previsto para publicarse el año que viene.",
        "fi": "Tämä kirja on tarkoitus julkaista ensi vuonna.",
        "fr": "Ce livre doit être publié l'année prochaine.",
        "he": "הספר הזה אמור להתפרסם בשנה הבאה.",
        "hi": "यह किताब अगले साल प्रकाशित होने वाली है।",
        "hu": "Ezt a könyvet jövőre fogják kiadni.",
        "id": "Buku ini dijadwalkan terbit tahun depan.",
        "it": "Questo libro è previsto per l'anno prossimo.",
        "ja": "この本は来年出版される予定です。",
        "nb": "Denne boken skal utgis neste år.",
        "nl": "Dit boek wordt volgend jaar uitgegeven.",
        "pl": "Ta książka ma zostać wydana w przyszłym roku.",
        "pt": "Este livro está previsto para ser publicado no ano que vem.",
        "ro": "Cartea aceasta urmează să fie publicată anul viitor.",
        "ru": "Эта книга должна выйти в следующем году.",
        "sv": "Den här boken ska ges ut nästa år.",
        "tr": "Bu kitabın gelecek yıl yayımlanması planlanıyor.",
        "uk": "Цю книжку мають видати наступного року.",
        "vi": "Cuốn sách này dự kiến sẽ được xuất bản vào năm sau.",
        "yue": "呢本書預計聽年會出版。",
        "zh-Hans": "这本书预计明年出版。"
