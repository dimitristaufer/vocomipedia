  "sentences": [
    {
      "target": "신호등이 빨간불이라서 길을 건너지 않았어요.",
      "reading": "sinhodeungi ppalganburiraseo gireul geonneoji anasseoyo.",
      "translations": {
        "en": "The traffic light was red, so I didn’t cross the street.",
        "ko": "신호등이 빨간불이라서 길을 건너지 않았어요.",
        "ipa": "sinhodeungi ppalganburiraseo gireul geonneoji anasseoyo.",
        "ar": "كانت إشارة المرور حمراء، لذلك لم أعبر الشارع.",
        "cs": "Semafor svítil červeně, tak jsem nepřešel ulici.",
        "da": "Lyskrydset var rødt, så jeg gik ikke over gaden.",
        "de": "Die Ampel war rot, also bin ich nicht über die Straße gegangen.",
        "el": "Το φανάρι ήταν κόκκινο, οπότε δεν πέρασα τον δρόμο.",
        "es": "El semáforo estaba en rojo, así que no crucé la calle.",
        "fi": "Liikennevalo oli punainen, joten en ylittänyt katua.",
        "fr": "Le feu était rouge, alors je n’ai pas traversé la rue.",
        "he": "הרמזור היה אדום, אז לא חציתי את הרחוב.",
        "hi": "सिग्नल लाल था, इसलिए मैं सड़क पार नहीं किया।",
        "hu": "A lámpa piros volt, ezért nem mentem át az úton.",
        "id": "Lampu lalu lintasnya merah, jadi saya tidak menyeberang jalan.",
        "it": "Il semaforo era rosso, quindi non ho attraversato la strada.",
        "ja": "信号が赤だったので、通りを渡りませんでした。",
        "nb": "Lyskrysset var rødt, så jeg krysset ikke gaten.",
        "nl": "Het verkeerslicht was rood, dus ik stak de straat niet over.",
        "pl": "Światło było czerwone, więc nie przeszedłem przez ulicę.",
        "pt": "O semáforo estava vermelho, então não atravessei a rua.",
        "ro": "Semaforul era roșu, așa că nu am traversat strada.",
        "ru": "Светофор был красный, поэтому я не переходил улицу.",
        "sv": "Ljuset var rött, så jag gick inte över gatan.",
        "tr": "Işık kırmızıydı, bu yüzden karşıya geçmedim.",
        "uk": "Світлофор був червоний, тому я не переходив вулицю.",
        "vi": "Đèn giao thông đỏ nên tôi không băng qua đường.",
        "yue": "交通燈係紅燈，所以我冇過馬路。",
        "zh-Hans": "红灯亮着，所以我没有过马路。"
      },
