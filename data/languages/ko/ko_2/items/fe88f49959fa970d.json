    {
      "target": "하늘이 갑자기 흐려졌어요.",
      "reading": "haneuri gapjagi heuryeojyeosseoyo.",
      "translations": {
        "en": "The sky suddenly became cloudy.",
        "ko": "하늘이 갑자기 흐려졌어요.",
        "ipa": "haneuri gapjagi heuryeojyeosseoyo.",
        "ar": "أصبحت السماء غائمةً فجأةً.",
        "cs": "Obloha se najednou zatáhla.",
        "da": "Himlen blev pludselig overskyet.",
        "de": "Der Himmel hat sich plötzlich bezogen.",
        "el": "Ο ουρανός συννεφιάστηκε ξαφνικά.",
        "es": "El cielo se nubló de repente.",
        "fi": "Taivas meni yhtäkkiä pilveen.",
        "fr": "Le ciel s'est soudainement couvert.",
        "he": "השמיים התעננו פתאום.",
        "hi": "आसमान अचानक घिर गया।",
        "hu": "Az ég hirtelen beborult.",
        "id": "Langit tiba-tiba menjadi mendung.",
        "it": "Il cielo si è annuvolato all'improvviso.",
        "ja": "空が急に曇りました。",
        "nb": "Himmelen ble plutselig overskyet.",
        "nl": "De lucht werd opeens bewolkt.",
        "pl": "Niebo nagle się zachmurzyło.",
        "pt": "O céu ficou nublado de repente.",
        "ro": "Cerul s-a înnorat deodată.",
        "ru": "Небо вдруг затянуло облаками.",
        "sv": "Det blev plötsligt molnigt.",
        "tr": "Gökyüzü birden bulutlandı.",
        "uk": "Небо раптом затягло хмарами.",
        "vi": "Bầu trời đột nhiên nhiều mây.",
        "yue": "天空突然變陰。",
        "zh-Hans": "天空突然阴沉起来。"
      },
