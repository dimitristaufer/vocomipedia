  "sentences": [
    {
      "target": "매스컴에 나온 소식을 믿지 마세요.",
      "reading": "maeseukeome naon sosigeul mitji maseyo.",
      "translations": {
        "en": "Don't trust the news that comes out in the media.",
        "ko": "매스컴에 나온 소식을 믿지 마세요.",
        "ipa": "maeseukeome naon sosigeul mitji maseyo.",
        "ar": "لا تصدقوا الأخبار التي تظهر في وسائل الإعلام.",
        "cs": "Nevěřte zprávám v médiích.",
        "da": "Tro ikke på nyhederne i medierne.",
        "de": "Glauben Sie nicht den Nachrichten aus den Medien.",
        "el": "Μην πιστεύετε τις ειδήσεις που βγαίνουν στα μέσα ενημέρωσης.",
        "es": "No creas en las noticias que salen en los medios.",
        "fi": "Älä usko mediassa olevia uutisia.",
        "fr": "Ne croyez pas les informations qui sortent dans les médias.",
        "he": "אל תאמינו לחדשות שמופיעות בתקשורת.",
        "hi": "मीडिया में आने वाली खबरों पर विश्वास मत करो।",
        "hu": "Ne higgy a médiában megjelenő híreknek.",
        "id": "Jangan percaya berita yang muncul di media.",
        "it": "Non credere alle notizie che escono sui media.",
        "ja": "メディアで出たニュースを信じないでください。",
        "nb": "Ikke tro på nyhetene som kommer i mediene.",
        "nl": "Geloof het nieuws dat in de media komt niet.",
        "pl": "Nie wierz wiadomościom w mediach.",
        "pt": "Não acredite nas notícias que saem na mídia.",
        "ro": "Nu crede știrile care apar în mass-media.",
        "ru": "Не верьте новостям, которые появляются в СМИ.",
        "sv": "Tro inte på nyheterna som kommer i medierna.",
        "tr": "Medyada çıkan haberlere inanma.",
        "uk": "Не вірте новинам, які з'являються в медіа.",
        "vi": "Đừng tin những tin tức xuất hiện trên truyền thông.",
        "yue": "唔好相信傳媒出嘅新聞。",
        "zh-Hans": "不要相信媒体上出现的新闻。"
      },
