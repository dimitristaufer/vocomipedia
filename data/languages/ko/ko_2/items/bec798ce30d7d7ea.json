  "sentences": [
    {
      "target": "그는 내적 갈등이 커 보였다.",
      "reading": "geuneun naejeok galdeungi keo boyeotda.",
      "translations": {
        "en": "He seemed to be struggling with inner conflict.",
        "ko": "그는 내적 갈등이 커 보였다.",
        "ipa": "geuneun naejeok galdeungi keo boyeotda.",
        "ar": "كان يبدو أنه يعاني من صراع داخلي.",
        "cs": "Zdálo se, že svádí vnitřní boj.",
        "da": "Han så ud til at kæmpe med indre konflikt.",
        "de": "Er schien mit einem inneren Konflikt zu kämpfen.",
        "el": "Έμοιαζε να παλεύει με εσωτερική σύγκρουση.",
        "es": "Parecía estar luchando con un conflicto interno.",
        "fi": "Hän vaikutti kamppailevan sisäisen konfliktin kanssa.",
        "fr": "Il semblait lutter contre un conflit intérieur.",
        "he": "נראה שהיה לו מאבק פנימי.",
        "hi": "वह भीतर के संघर्ष से जूझता हुआ लग रहा था।",
        "hu": "Úgy tűnt, belső konfliktussal küzd.",
        "id": "Dia tampak sedang bergumul dengan konflik batin.",
        "it": "Sembrava lottare con un conflitto interiore.",
        "ja": "彼は内面の葛藤に苦しんでいるようだった。",
        "nb": "Han så ut til å slite med en indre konflikt.",
        "nl": "Hij leek te worstelen met een innerlijk conflict.",
        "pl": "Wyglądało na to, że zmaga się z wewnętrznym konfliktem.",
        "pt": "Ele parecia lutar com um conflito interno.",
        "ro": "Părea să se lupte cu un conflict interior.",
        "ru": "Он, похоже, переживал внутренний конфликт.",
        "sv": "Han verkade kämpa med en inre konflikt.",
        "tr": "İç çatışma yaşıyor gibi görünüyordu.",
        "uk": "Здавалося, він боровся з внутрішнім конфліктом.",
        "vi": "Anh ấy có vẻ đang vật lộn với mâu thuẫn nội tâm.",
        "yue": "佢睇落好似喺度同內心衝突搏鬥。",
        "zh-Hans": "他看起来在与内心冲突作斗争。"
      },
