  "sentences": [
    {
      "target": "주말에 아버지와 낚시를 갔어요.",
      "reading": "jumal-e abeojiwa nakksireul gasseoyo.",
      "translations": {
        "en": "I went fishing with my father on the weekend.",
        "ko": "주말에 아버지와 낚시를 갔어요.",
        "ipa": "jumal-e abeojiwa nakksireul gasseoyo.",
        "ar": "ذهبتُ إلى الصيد مع والدي في عطلة نهاية الأسبوع.",
        "cs": "O víkendu jsem šel na ryby s otcem.",
        "da": "Jeg var ude at fiske med min far i weekenden.",
        "de": "Ich bin am Wochenende mit meinem Vater angeln gegangen.",
        "el": "Πήγα για ψάρεμα με τον πατέρα μου το Σαββατοκύριακο.",
        "es": "Fui a pescar con mi padre el fin de semana.",
        "fi": "Kävin kalassa isäni kanssa viikonloppuna.",
        "fr": "Je suis allé pêcher avec mon père le week-end.",
        "he": "הלכתי לדוג עם אבי בסוף השבוע.",
        "hi": "मैंने सप्ताहांत में अपने पिता के साथ मछली पकड़ने गया।",
        "hu": "A hétvégén apámmal horgászni mentem.",
        "id": "Saya pergi memancing dengan ayah saya pada akhir pekan.",
        "it": "Sono andato a pescare con mio padre nel fine settimana.",
        "ja": "週末に父と釣りに行きました。",
        "nb": "Jeg var på fisketur med faren min i helgen.",
        "nl": "Ik ging in het weekend vissen met mijn vader.",
        "pl": "Poszedłem na ryby z ojcem w weekend.",
        "pt": "Fui pescar com meu pai no fim de semana.",
        "ro": "Am mers la pescuit cu tatăl meu în weekend.",
        "ru": "Я ходил на рыбалку с отцом на выходных.",
        "sv": "Jag var och fiskade med min pappa i helgen.",
        "tr": "Hafta sonu babamla balığa gittim.",
        "uk": "На вихідних я ходив рибалити з батьком.",
        "vi": "Tôi đã đi câu cá với bố vào cuối tuần.",
        "yue": "週末我同爸爸去咗釣魚。",
        "zh-Hans": "周末我和爸爸去钓鱼了。"
      },
