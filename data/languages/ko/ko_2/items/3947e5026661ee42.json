  "sentences": [
    {
      "target": "그 셔츠는 파란 줄무늬가 있어요.",
      "reading": "geu syeocheuneun paran julmuni-ga isseoyo.",
      "translations": {
        "en": "That shirt has blue stripes.",
        "ko": "그 셔츠는 파란 줄무늬가 있어요.",
        "ipa": "geu syeocheuneun paran julmuni-ga isseoyo.",
        "ar": "تلك القميص عليه خطوط زرقاء.",
        "cs": "Ta košile má modré proužky.",
        "da": "Den skjorte har blå striber.",
        "de": "Das Hemd hat blaue Streifen.",
        "el": "Το πουκάμισο έχει μπλε ρίγες.",
        "es": "Esa camisa tiene rayas azules.",
        "fi": "Tuossa paidassa on sinisiä raitoja.",
        "fr": "Cette chemise a des rayures bleues.",
        "he": "לחולצה הזאת יש פסים כחולים.",
        "hi": "उस शर्ट पर नीली धारियाँ हैं।",
        "hu": "Ennek az ingnek kék csíkjai vannak.",
        "id": "Kemeja itu punya garis-garis biru.",
        "it": "Questa camicia ha strisce blu.",
        "ja": "あのシャツには青いしま模様があります。",
        "nb": "Den skjorten har blå striper.",
        "nl": "Dat overhemd heeft blauwe strepen.",
        "pl": "Ta koszula ma niebieskie paski.",
        "pt": "Essa camisa tem listras azuis.",
        "ro": "Cămașa aceea are dungi albastre.",
        "ru": "У той рубашки есть синие полоски.",
        "sv": "Den där skjortan har blå ränder.",
        "tr": "O gömlekte mavi çizgiler var.",
        "uk": "На тій сорочці є сині смужки.",
        "vi": "Chiếc áo sơ mi đó có sọc xanh.",
        "yue": "嗰件恤衫有藍色條紋。",
        "zh-Hans": "那件衬衫有蓝色条纹。"
      },
