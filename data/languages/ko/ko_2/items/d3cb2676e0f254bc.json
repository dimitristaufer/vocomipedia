  "sentences": [
    {
      "target": "문제의 본질을 먼저 생각해 보세요.",
      "reading": "munjeui bonjireul meonjeo saenggakhae boseyo.",
      "translations": {
        "en": "Please think about the essence of the problem first.",
        "ko": "문제의 본질을 먼저 생각해 보세요.",
        "ipa": "munjeui bonjireul meonjeo saenggakhae boseyo.",
        "ar": "فكر في جوهر المشكلة أولًا.",
        "cs": "Nejprve přemýšlejte o podstatě problému.",
        "da": "Tænk først over problemets essens.",
        "de": "Denke zuerst über das Wesen des Problems nach.",
        "el": "Σκεφτείτε πρώτα την ουσία του προβλήματος.",
        "es": "Piense primero en la esencia del problema.",
        "fi": "Ajattele ensin ongelman ydintä.",
        "fr": "Réfléchissez d'abord à l'essence du problème.",
        "he": "חשבו קודם על מהות הבעיה.",
        "hi": "पहले समस्या के मूल पर सोचिए।",
        "hu": "Először gondolj a probléma lényegére.",
        "id": "Pikirkan dulu inti masalahnya.",
        "it": "Pensa prima all'essenza del problema.",
        "ja": "まずは問題の本質を考えてください。",
        "nb": "Tenk først på problemets kjerne.",
        "nl": "Denk eerst na over de kern van het probleem.",
        "pl": "Najpierw pomyśl o istocie problemu.",
        "pt": "Pense primeiro na essência do problema.",
        "ro": "Gândește-te mai întâi la esența problemei.",
        "ru": "Сначала подумайте о сути проблемы.",
        "sv": "Tänk först på problemets kärna.",
        "tr": "Önce sorunun özünü düşünün.",
        "uk": "Спочатку подумайте про суть проблеми.",
        "vi": "Hãy nghĩ trước về bản chất của vấn đề.",
        "yue": "先諗吓問題嘅本質。",
        "zh-Hans": "先想想问题的本质。"
      },
