  "sentences": [
    {
      "target": "그 사건은 오늘 뉴스에 보도됐어요.",
      "reading": "Geu sageoneun oneul nyuseue bododwaesseoyo.",
      "translations": {
        "en": "That incident was reported on the news today.",
        "ko": "그 사건은 오늘 뉴스에 보도됐어요.",
        "ipa": "Geu sageoneun oneul nyuseue bododwaesseoyo.",
        "ar": "تم الإبلاغ عن تلك الحادثة في أخبار اليوم.",
        "cs": "Ta událost byla dnes uvedena ve zprávách.",
        "da": "Den hændelse blev omtalt i nyhederne i dag.",
        "de": "Dieser Vorfall wurde heute in den Nachrichten gemeldet.",
        "el": "Αυτό το περιστατικό προβλήθηκε στις σημερινές ειδήσεις.",
        "es": "Ese incidente se informó hoy en las noticias.",
        "fi": "Tuo tapaus uutisoitiin tänään.",
        "fr": "Cet incident a été diffusé aux informations aujourd'hui.",
        "he": "האירוע הזה דווח בחדשות היום.",
        "hi": "उस घटना के बारे में आज खबरों में रिपोर्ट की गई।",
        "hu": "Arról az esetről ma beszámoltak a hírekben.",
        "id": "Kejadian itu diberitakan di berita hari ini.",
        "it": "Quell'incidente è stato riportato oggi al telegiornale.",
        "ja": "その出来事は今日のニュースで報道されました。",
        "nb": "Den hendelsen ble omtalt på nyhetene i dag.",
        "nl": "Dat incident werd vandaag in het nieuws gemeld.",
        "pl": "To zdarzenie zostało dziś podane w wiadomościach.",
        "pt": "Esse incidente foi noticiado hoje no jornal.",
        "ro": "Incidentul acela a fost relatat azi la știri.",
        "ru": "Об этом происшествии сегодня сообщили в новостях.",
        "sv": "Den händelsen rapporterades i nyheterna i dag.",
        "tr": "O olay bugün haberlerde yer aldı.",
        "uk": "Про той випадок сьогодні повідомили в новинах.",
        "vi": "Sự việc đó đã được đưa tin trên bản tin hôm nay.",
        "yue": "嗰件事今日喺新聞報道咗。",
        "zh-Hans": "那件事今天在新闻里报道了。"
      },
