  "sentences": [
    {
      "target": "상대방의 말을 잘 들어 주세요.",
      "reading": "sangdaebang-ui mal-eul jal deureo juseyo.",
      "translations": {
        "en": "Please listen carefully to the other person.",
        "ko": "상대방의 말을 잘 들어 주세요.",
        "ipa": "sangdaebang-ui mal-eul jal deureo juseyo.",
        "ar": "من فضلك استمع جيدًا إلى الطرف الآخر.",
        "cs": "Prosím, poslouchejte toho druhého pozorně.",
        "da": "Lyt venligst godt til den anden person.",
        "de": "Bitte hören Sie der anderen Person gut zu.",
        "el": "Σε παρακαλώ, άκου προσεκτικά τον άλλο άνθρωπο.",
        "es": "Por favor, escucha bien a la otra persona.",
        "fi": "Kuuntelethan toista ihmistä tarkasti.",
        "fr": "Écoutez bien l'autre personne, s'il vous plaît.",
        "he": "אנא הקשב היטב לצד השני.",
        "hi": "कृपया दूसरे व्यक्ति की बात ध्यान से सुनिए।",
        "hu": "Kérlek, figyelmesen hallgasd meg a másikat.",
        "id": "Tolong dengarkan lawan bicara dengan baik.",
        "it": "Ascolta bene l'altra persona, per favore.",
        "ja": "相手の話をよく聞いてください。",
        "nb": "Vennligst lytt nøye til den andre personen.",
        "nl": "Luister goed naar de ander, alstublieft.",
        "pl": "Proszę uważnie słuchać drugiej osoby.",
        "pt": "Por favor, ouça bem a outra pessoa.",
        "ro": "Te rog să asculți bine ce spune cealaltă persoană.",
        "ru": "Пожалуйста, внимательно слушайте собеседника.",
        "sv": "Lyssna noga på den andra personen, tack.",
        "tr": "Lütfen karşı tarafı dikkatle dinleyin.",
        "uk": "Будь ласка, уважно слухайте співрозмовника.",
        "vi": "Hãy lắng nghe người đối diện thật kỹ.",
        "yue": "請你好好聽對方講嘅嘢。",
        "zh-Hans": "请认真听对方说的话。"
      },
