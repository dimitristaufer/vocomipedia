  "sentences": [
    {
      "target": "그 사고로 신체적 피해를 입었어요.",
      "reading": "geu sago-ro sinchejeok pihareul ibeosseoyo.",
      "translations": {
        "en": "He suffered physical harm in the accident.",
        "ko": "그 사고로 신체적 피해를 입었어요.",
        "ipa": "geu sago-ro sinchejeok pihareul ibeosseoyo.",
        "ar": "تعرض لأذى جسدي في الحادث.",
        "cs": "Při té nehodě utrpěl fyzické zranění.",
        "da": "Han kom til fysisk skade i ulykken.",
        "de": "Er erlitt bei dem Unfall körperliche Verletzungen.",
        "el": "Έπαθε σωματική βλάβη στο ατύχημα.",
        "es": "Sufrió daños físicos en el accidente.",
        "fi": "Hän sai fyysisiä vammoja onnettomuudessa.",
        "fr": "Il a subi des blessures physiques dans l'accident.",
        "he": "הוא נפגע פיזית בתאונה.",
        "hi": "उस दुर्घटना में उसे शारीरिक चोट लगी।",
        "hu": "A balesetben fizikai sérülést szenvedett.",
        "id": "Dia mengalami cedera fisik dalam kecelakaan itu.",
        "it": "Ha riportato danni fisici nell'incidente.",
        "ja": "その事故で身体的な被害を受けました。",
        "nb": "Han ble fysisk skadet i ulykken.",
        "nl": "Hij liep lichamelijk letsel op bij het ongeluk.",
        "pl": "Doznał obrażeń fizycznych w wypadku.",
        "pt": "Ele sofreu danos físicos no acidente.",
        "ro": "A suferit răni fizice în accident.",
        "ru": "Он получил физические травмы в аварии.",
        "sv": "Han skadades fysiskt i olyckan.",
        "tr": "Kazada fiziksel zarar gördü.",
        "uk": "Він отримав фізичні травми в аварії.",
        "vi": "Anh ấy bị tổn hại về thể chất trong vụ tai nạn.",
        "yue": "佢喺嗰次意外入面受咗身體傷害。",
        "zh-Hans": "他在那次事故中受了身体伤害。"
      },
