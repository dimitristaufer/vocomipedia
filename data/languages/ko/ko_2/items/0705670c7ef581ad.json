  "sentences": [
    {
      "target": "밤에 모기가 많이 물었어요.",
      "reading": "바메 모기가 많이 무럿써요.",
      "translations": {
        "en": "A lot of mosquitoes bit me at night.",
        "ko": "밤에 모기가 많이 물었어요.",
        "ipa": "바메 모기가 많이 무럿써요.",
        "ar": "لدغني الكثير من البعوض في الليل.",
        "cs": "V noci mě hodně kousali komáři.",
        "da": "Der var mange myg, som bed mig om natten.",
        "de": "Nachts haben mich viele Mücken gestochen.",
        "el": "Τα κουνούπια με δάγκωσαν πολύ τη νύχτα.",
        "es": "Me picaron muchos mosquitos por la noche.",
        "fi": "Hyttyset pistivät minua paljon yöllä.",
        "fr": "J'ai été beaucoup piqué par des moustiques la nuit.",
        "he": "יתושים עקצו אותי הרבה בלילה.",
        "hi": "रात में मच्छरों ने मुझे बहुत काटा।",
        "hu": "Éjszaka sok szúnyog megcsípett.",
        "id": "Banyak nyamuk menggigit saya malam hari.",
        "it": "Di notte mi hanno punto molte zanzare.",
        "ja": "夜に蚊にたくさん刺されました。",
        "nb": "Jeg ble bitt av mange mygg om natten.",
        "nl": "Ik werd 's nachts veel gestoken door muggen.",
        "pl": "W nocy pogryzło mnie dużo komarów.",
        "pt": "Muitos mosquitos me picaram à noite.",
        "ro": "M-au înțepat mulți țânțari noaptea.",
        "ru": "Ночью меня сильно покусали комары.",
        "sv": "Det bet många myggor på mig på natten.",
        "tr": "Gece beni çok sivrisinek ısırdı.",
        "uk": "Уночі мене сильно покусали комарі.",
        "vi": "Tối qua muỗi đốt tôi rất nhiều.",
        "yue": "夜晚好多蚊咬我。",
        "zh-Hans": "晚上很多蚊子咬我。"
      },
