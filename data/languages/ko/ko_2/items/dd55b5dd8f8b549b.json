  "sentences": [
    {
      "target": "날씨가 점차 좋아지고 있어요.",
      "reading": "nalssiga jeomcha joajigo isseoyo.",
      "translations": {
        "en": "The weather is gradually getting better.",
        "ko": "날씨가 점차 좋아지고 있어요.",
        "ipa": "nalssiga jeomcha joajigo isseoyo.",
        "ar": "الطقس يتحسن تدريجيًا.",
        "cs": "Počasí se postupně zlepšuje.",
        "da": "Vejret bliver gradvist bedre.",
        "de": "Das Wetter wird allmählich besser.",
        "el": "Ο καιρός βελτιώνεται σταδιακά.",
        "es": "El tiempo está mejorando poco a poco.",
        "fi": "Sää paranee vähitellen.",
        "fr": "Le temps s'améliore peu à peu.",
        "he": "מזג האוויר משתפר בהדרגה.",
        "hi": "मौसम धीरे-धीरे बेहतर हो रहा है।",
        "hu": "Az időjárás fokozatosan javul.",
        "id": "Cuacanya perlahan membaik.",
        "it": "Il tempo sta migliorando gradualmente.",
        "ja": "天気がだんだんよくなっています。",
        "nb": "Været blir gradvis bedre.",
        "nl": "Het weer wordt geleidelijk beter.",
        "pl": "Pogoda stopniowo się poprawia.",
        "pt": "O tempo está melhorando aos poucos.",
        "ro": "Vremea se îmbunătățește treptat.",
        "ru": "Погода постепенно улучшается.",
        "sv": "Vädret blir gradvis bättre.",
        "tr": "Hava giderek güzelleşiyor.",
        "uk": "Погода поступово поліпшується.",
        "vi": "Thời tiết đang dần tốt lên.",
        "yue": "天氣逐漸好轉。",
        "zh-Hans": "天气逐渐好转。"
      },
