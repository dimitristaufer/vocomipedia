  "sentences": [
    {
      "target": "우리 사회는 많이 바뀌었어요.",
      "reading": "uri sahoe-neun mani bakkwieosseoyo.",
      "translations": {
        "en": "Our society has changed a lot.",
        "ko": "우리 사회는 많이 바뀌었어요.",
        "ipa": "uri sahoe-neun mani bakkwieosseoyo.",
        "ar": "لقد تغيّر مجتمعنا كثيرًا.",
        "cs": "Naše společnost se hodně změnila.",
        "da": "Vores samfund har ændret sig meget.",
        "de": "Unsere Gesellschaft hat sich sehr verändert.",
        "el": "Η κοινωνία μας έχει αλλάξει πολύ.",
        "es": "Nuestra sociedad ha cambiado mucho.",
        "fi": "Yhteiskuntamme on muuttunut paljon.",
        "fr": "Notre société a beaucoup changé.",
        "he": "החברה שלנו השתנתה הרבה.",
        "hi": "हमारा समाज बहुत बदल गया है।",
        "hu": "A társadalmunk sokat változott.",
        "id": "Masyarakat kita sudah banyak berubah.",
        "it": "La nostra società è cambiata molto.",
        "ja": "私たちの社会はとても変わりました。",
        "nb": "Samfunnet vårt har forandret seg mye.",
        "nl": "Onze samenleving is veel veranderd.",
        "pl": "Nasze społeczeństwo bardzo się zmieniło.",
        "pt": "A nossa sociedade mudou muito.",
        "ro": "Societatea noastră s-a schimbat mult.",
        "ru": "Наше общество сильно изменилось.",
        "sv": "Vårt samhälle har förändrats mycket.",
        "tr": "Toplumumuz çok değişti.",
        "uk": "Наше суспільство дуже змінилося.",
        "vi": "Xã hội chúng ta đã thay đổi nhiều.",
        "yue": "我哋社會變咗好多。",
        "zh-Hans": "我们的社会已经发生了很大变化。"
      },
