    {
      "target": "눈썹에 물방울이 맺혔어요.",
      "reading": "nunsseobe mulbangouli maejyeosseoyo.",
      "translations": {
        "en": "Raindrops gathered on my eyebrow.",
        "ko": "눈썹에 물방울이 맺혔어요.",
        "ipa": "nunsseobe mulbangouli maejyeosseoyo.",
        "ar": "تجمعت قطرات المطر على حاجبي.",
        "cs": "Na mém obočí se zachytily kapky deště.",
        "da": "Regndråber samlede sig på mit øjenbryn.",
        "de": "Auf meiner Augenbraue sammelten sich Regentropfen.",
        "el": "Μαζεύτηκαν σταγόνες βροχής στο φρύδι μου.",
        "es": "Se acumularon gotas de lluvia en mi ceja.",
        "fi": "Sadepisaroita kertyi kulmakarvaani.",
        "fr": "Des gouttes de pluie se sont posées sur mon sourcil.",
        "he": "טיפות גשם נצברו על הגבה שלי.",
        "hi": "मेरी भौं पर बारिश की बूंदें जमा हो गईं।",
        "hu": "Esőcseppek gyűltek a szemöldökömön.",
        "id": "Tetesan hujan mengumpul di alis saya.",
        "it": "Si sono raccolte delle gocce di pioggia sul mio sopracciglio.",
        "ja": "眉に雨粒がつきました。",
        "nb": "Regndråper samlet seg på øyenbrynet mitt.",
        "nl": "Er bleven regendruppels op mijn wenkbrauw liggen.",
        "pl": "Na mojej brwi zebrały się krople deszczu.",
        "pt": "Gotinhas de chuva se acumularam na minha sobrancelha.",
        "ro": "S-au strâns picături de ploaie pe sprânceana mea.",
        "ru": "На моей брови собрались капли дождя.",
        "sv": "Regndroppar samlades på mitt ögonbryn.",
        "tr": "Kaşımda yağmur damlaları birikti.",
        "uk": "На моїй брові зібралися краплі дощу.",
        "vi": "Những giọt mưa đọng lại trên lông mày tôi.",
        "yue": "雨點喺我條眉上面聚咗埋。",
        "zh-Hans": "雨滴落在我的眉毛上。"
      },
