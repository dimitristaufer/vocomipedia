    {
      "target": "엄마가 아기에게 따뜻한 옷을 입혀요.",
      "reading": "eommaga agiege ttatteuthan oseul iphyeoyo.",
      "translations": {
        "en": "Mom is putting warm clothes on the baby.",
        "ko": "엄마가 아기에게 따뜻한 옷을 입혀요.",
        "ipa": "eommaga agiege ttatteuthan oseul iphyeoyo.",
        "ar": "الأم تلبس الطفل ملابس دافئة.",
        "cs": "Maminka obléká miminku teplé oblečení.",
        "da": "Mor tager varmt tøj på babyen.",
        "de": "Mama zieht dem Baby warme Kleidung an.",
        "el": "Η μαμά ντύνει το μωρό με ζεστά ρούχα.",
        "es": "Mamá le pone ropa abrigada al bebé.",
        "fi": "Äiti pukee vauvalle lämpimiä vaatteita.",
        "fr": "Maman met des vêtements chauds au bébé.",
        "he": "אמא מלבישה לתינוק בגדים חמים.",
        "hi": "माँ बच्चे को गरम कपड़े पहना रही है।",
        "hu": "Anya meleg ruhát ad a babára.",
        "id": "Ibu memakaikan bayi pakaian hangat.",
        "it": "La mamma mette al bambino dei vestiti caldi.",
        "ja": "お母さんが赤ちゃんに暖かい服を着せています。",
        "nb": "Mamma kler på babyen varme klær.",
        "nl": "Mama trekt de baby warme kleren aan.",
        "pl": "Mama ubiera dziecko w ciepłe ubrania.",
        "pt": "A mãe veste o bebê com roupas quentes.",
        "ro": "Mama îi pune bebelușului haine groase.",
        "ru": "Мама одевает малыша в тёплую одежду.",
        "sv": "Mamma klär på bebisen varma kläder.",
        "tr": "Anne bebeğe sıcak kıyafetler giydiriyor.",
        "uk": "Мама вдягає малюка в теплий одяг.",
        "vi": "Mẹ mặc cho em bé quần áo ấm.",
        "yue": "媽媽幫嬰兒著暖和嘅衫。",
        "zh-Hans": "妈妈给宝宝穿暖和的衣服。"
      },
