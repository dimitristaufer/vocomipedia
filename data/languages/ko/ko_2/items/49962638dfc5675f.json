    {
      "target": "할머니는 손녀에게 예쁜 한복을 입혀요.",
      "reading": "halmeonineun sonnyeoge yeppeun hanbogeul iphyeoyo.",
      "translations": {
        "en": "Grandma is dressing her granddaughter in a pretty hanbok.",
        "ko": "할머니는 손녀에게 예쁜 한복을 입혀요.",
        "ipa": "halmeonineun sonnyeoge yeppeun hanbogeul iphyeoyo.",
        "ar": "تلبس الجدة حفيدتها ثوبا كوريًا جميلا.",
        "cs": "Babička obléká své vnučce krásný hanbok.",
        "da": "Bedstemor klæder sit barnebarn i en fin hanbok.",
        "de": "Oma zieht ihrer Enkelin einen schönen Hanbok an.",
        "el": "Η γιαγιά ντύνει την εγγονή της με ένα όμορφο χανμπόκ.",
        "es": "La abuela viste a su nieta con un hanbok bonito.",
        "fi": "Isoäiti pukee tyttärentyttärelleen kauniin hanbokin.",
        "fr": "Grand-mère habille sa petite-fille d'un joli hanbok.",
        "he": "סבתא מלבישה לנכדה שמלה קוריאנית יפה.",
        "hi": "दादी अपनी पोती को सुंदर हनबोक पहना रही हैं।",
        "hu": "A nagymama egy szép hanbokot ad az unokájára.",
        "id": "Nenek memakaikan cucunya hanbok yang cantik.",
        "it": "La nonna veste la nipote con un bel hanbok.",
        "ja": "おばあさんは孫娘にきれいな韓服を着せています。",
        "nb": "Bestemor kler på barnebarnet sitt en fin hanbok.",
        "nl": "Oma kleedt haar kleindochter in een mooie hanbok.",
        "pl": "Babcia ubiera wnuczkę w piękny hanbok.",
        "pt": "A avó veste a neta com um hanbok bonito.",
        "ro": "Bunica își îmbracă nepoata cu un hanbok drăguț.",
        "ru": "Бабушка одевает внучку в красивый ханбок.",
        "sv": "Farmor klär sin barnbarnsdotter i en fin hanbok.",
        "tr": "Büyükanne, torununa güzel bir hanbok giydiriyor.",
        "uk": "Бабуся вдягає онуку в гарний ханбок.",
        "vi": "Bà đang mặc cho cháu gái một bộ hanbok đẹp.",
        "yue": "嫲嫲幫孫女著一件靚嘅韓服。",
        "zh-Hans": "奶奶给孙女穿漂亮的韩服。"
      },
