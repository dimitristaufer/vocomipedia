  "sentences": [
    {
      "target": "서울 방면으로 가면 바로 보여요.",
      "reading": "Seoul bangmyeoneuro gamyeon baro boyeoyo.",
      "translations": {
        "en": "If you go toward Seoul, you’ll see it right away.",
        "ko": "서울 방면으로 가면 바로 보여요.",
        "ipa": "Seoul bangmyeoneuro gamyeon baro boyeoyo.",
        "ar": "إذا ذهبت في اتجاه سول، فستراه فورًا.",
        "cs": "Když půjdete směrem na Soul, uvidíte to hned.",
        "da": "Hvis du går mod Seoul, ser du det med det samme.",
        "de": "Wenn du in Richtung Seoul gehst, siehst du es sofort.",
        "el": "Αν πάτε προς τη Σεούλ, θα το δείτε αμέσως.",
        "es": "Si vas hacia Seúl, lo verás enseguida.",
        "fi": "Jos menet kohti Seoulia, näet sen heti.",
        "fr": "Si vous allez vers Séoul, vous le verrez tout de suite.",
        "he": "אם תלך לכיוון סיאול, תראה את זה מיד.",
        "hi": "अगर आप सियोल की ओर जाएँ, तो यह आपको तुरंत दिख जाएगा।",
        "hu": "Ha Szöul felé mész, rögtön meglátod.",
        "id": "Kalau kamu pergi ke arah Seoul, kamu akan langsung melihatnya.",
        "it": "Se vai in direzione di Seoul, lo vedi subito.",
        "ja": "ソウル方面に行くと、すぐに見えます。",
        "nb": "Hvis du går i retning Seoul, ser du det med en gang.",
        "nl": "Als je in de richting van Seoul gaat, zie je het meteen.",
        "pl": "Jeśli pójdziesz w stronę Seulu, od razu to zobaczysz.",
        "pt": "Se você for na direção de Seul, vai vê-lo na hora.",
        "ro": "Dacă mergi spre Seul, îl vei vedea imediat.",
        "ru": "Если пойдёшь в сторону Сеула, ты сразу это увидишь.",
        "sv": "Om du går mot Seoul ser du det direkt.",
        "tr": "Seul yönüne gidersen, onu hemen görürsün.",
        "uk": "Якщо підеш у бік Сеула, ти одразу це побачиш.",
        "vi": "Nếu bạn đi về phía Seoul, bạn sẽ thấy ngay.",
        "yue": "如果你向首爾方向行，就會即刻見到。",
        "zh-Hans": "如果你往首尔方向走，就会马上看到。"
      },
