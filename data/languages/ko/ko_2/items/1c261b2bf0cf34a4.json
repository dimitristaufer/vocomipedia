  "sentences": [
    {
      "target": "늦어서 친구에게 사과했어요.",
      "reading": "neujeoseo chinguge sagwahesseoyo.",
      "translations": {
        "en": "I apologized to my friend for being late.",
        "ko": "늦어서 친구에게 사과했어요.",
        "ipa": "neujeoseo chinguge sagwahesseoyo.",
        "ar": "اعتذرت لصديقي لأنني تأخرت.",
        "cs": "Omluvil jsem se kamarádovi, že jsem přišel pozdě.",
        "da": "Jeg undskyldte over for min ven, fordi jeg kom for sent.",
        "de": "Ich habe mich bei meinem Freund dafür entschuldigt, dass ich zu spät war.",
        "el": "Ζήτησα συγγνώμη από τον φίλο μου επειδή άργησα.",
        "es": "Le pedí disculpas a mi amigo por llegar tarde.",
        "fi": "Pahoittelin myöhästymistäni ystävälleni.",
        "fr": "Je me suis excusé auprès de mon ami parce que j’étais en retard.",
        "he": "התנצלתי בפני החבר שלי כי איחרתי.",
        "hi": "मैंने देर से आने के लिए अपने दोस्त से माफ़ी माँगी।",
        "hu": "Bocsánatot kértem a barátomtól, amiért elkéstem.",
        "id": "Saya meminta maaf kepada teman saya karena terlambat.",
        "it": "Mi sono scusato con il mio amico per il ritardo.",
        "ja": "遅れたので友達に謝りました。",
        "nb": "Jeg beklaget overfor vennen min for at jeg kom for sent.",
        "nl": "Ik heb mijn vriend mijn excuses aangeboden omdat ik te laat was.",
        "pl": "Przeprosiłem mojego przyjaciela za spóźnienie.",
        "pt": "Pedi desculpas ao meu amigo por me atrasar.",
        "ro": "Mi-am cerut scuze prietenului meu pentru că am întârziat.",
        "ru": "Я извинился перед другом за опоздание.",
        "sv": "Jag bad min vän om ursäkt för att jag kom sent.",
        "tr": "Geç kaldığım için arkadaşımdan özür diledim.",
        "uk": "Я перепросив у друга за запізнення.",
        "vi": "Tôi đã xin lỗi bạn vì đến muộn.",
        "yue": "我因為遲到而同朋友道歉。",
        "zh-Hans": "我因为迟到向朋友道歉了。"
      },
