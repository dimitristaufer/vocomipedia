    {
      "target": "제가 먼저 사과해야 해요.",
      "reading": "jega meonjeo sagwahaya haeyo.",
      "translations": {
        "en": "I should apologize first.",
        "ko": "제가 먼저 사과해야 해요.",
        "ipa": "jega meonjeo sagwahaya haeyo.",
        "ar": "يجب أن أعتذر أولًا.",
        "cs": "Měl bych se omluvit první.",
        "da": "Jeg bør undskylde først.",
        "de": "Ich sollte mich zuerst entschuldigen.",
        "el": "Πρέπει να ζητήσω πρώτος συγγνώμη.",
        "es": "Debo disculparme primero.",
        "fi": "Minun pitäisi pyytää ensin anteeksi.",
        "fr": "Je dois m’excuser d’abord.",
        "he": "אני צריך להתנצל קודם.",
        "hi": "मुझे पहले माफ़ी माँगनी चाहिए।",
        "hu": "Először nekem kell bocsánatot kérnem.",
        "id": "Saya harus minta maaf dulu.",
        "it": "Devo scusarmi per primo.",
        "ja": "私が先に謝らないといけません。",
        "nb": "Jeg bør beklage først.",
        "nl": "Ik moet eerst mijn excuses aanbieden.",
        "pl": "Muszę najpierw przeprosić.",
        "pt": "Preciso pedir desculpas primeiro.",
        "ro": "Trebuie să-mi cer eu scuze primul.",
        "ru": "Мне нужно извиниться первым.",
        "sv": "Jag borde be om ursäkt först.",
        "tr": "Önce ben özür dilemeliyim.",
        "uk": "Я маю вибачитися першим.",
        "vi": "Tôi nên xin lỗi trước.",
        "yue": "我應該先道歉。",
        "zh-Hans": "我应该先道歉。"
      },
