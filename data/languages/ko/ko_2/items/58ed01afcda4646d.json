  "sentences": [
    {
      "target": "이 카페는 분위기가 정말 좋아요.",
      "reading": "i kape-neun bunwigi-ga jeongmal joayo.",
      "translations": {
        "en": "This cafe has a really nice atmosphere.",
        "ko": "이 카페는 분위기가 정말 좋아요.",
        "ipa": "i kape-neun bunwigi-ga jeongmal joayo.",
        "ar": "هذا المقهى جوه جميل جدًا.",
        "cs": "V téhle kavárně je opravdu příjemná atmosféra.",
        "da": "Der er en rigtig hyggelig stemning på den her café.",
        "de": "Dieses Café hat eine richtig schöne Atmosphäre.",
        "el": "Αυτό το καφέ έχει πολύ ωραία ατμόσφαιρα.",
        "es": "Este café tiene un ambiente muy agradable.",
        "fi": "Tässä kahvilassa on todella mukava tunnelma.",
        "fr": "Ce café a une très bonne ambiance.",
        "he": "לבית הקפה הזה יש אווירה ממש נעימה.",
        "hi": "इस कैफ़े का माहौल बहुत अच्छा है।",
        "hu": "Ennek a kávézónak nagyon jó a hangulata.",
        "id": "Kafe ini suasananya sangat bagus.",
        "it": "Questo caffè ha un'atmosfera davvero bella.",
        "ja": "このカフェは雰囲気が本当にいいです。",
        "nb": "Denne kafeen har en veldig god atmosfære.",
        "nl": "Dit café heeft een heel fijne sfeer.",
        "pl": "Ta kawiarnia ma naprawdę miłą atmosferę.",
        "pt": "Este café tem um ambiente muito agradável.",
        "ro": "Această cafenea are o atmosferă foarte plăcută.",
        "ru": "В этом кафе очень приятная атмосфера.",
        "sv": "Det här kaféet har en väldigt trevlig stämning.",
        "tr": "Bu kafenin havası gerçekten çok güzel.",
        "uk": "У цьому кафе дуже приємна атмосфера.",
        "vi": "Quán cà phê này có không khí rất dễ chịu.",
        "yue": "呢間咖啡店嘅氣氛真係好好。",
        "zh-Hans": "这家咖啡馆的气氛真的很好。"
      },
