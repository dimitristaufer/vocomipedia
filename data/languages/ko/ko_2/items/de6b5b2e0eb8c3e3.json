  "sentences": [
    {
      "target": "그 소식에 우려가 커졌어요.",
      "reading": "geu sosige uryeoga keojyeosseoyo.",
      "translations": {
        "en": "That news increased my worries.",
        "ko": "그 소식에 우려가 커졌어요.",
        "ipa": "geu sosige uryeoga keojyeosseoyo.",
        "ar": "زادت مخاوفي بسبب ذلك الخبر.",
        "cs": "Ta zpráva mi přidala starosti.",
        "da": "Nyheden gjorde mig mere bekymret.",
        "de": "Die Nachricht hat meine Sorgen vergrößert.",
        "el": "Αυτή η είδηση αύξησε τις ανησυχίες μου.",
        "es": "Esa noticia aumentó mis preocupaciones.",
        "fi": "Se uutinen lisäsi huoliani.",
        "fr": "Cette nouvelle a accru mes inquiétudes.",
        "he": "הידיעה הזאת הגבירה את הדאגה שלי.",
        "hi": "उस खबर से मेरी चिंता बढ़ गई।",
        "hu": "Ez a hír csak növelte az aggodalmamat.",
        "id": "Kabar itu membuat kekhawatiran saya bertambah.",
        "it": "Quella notizia ha aumentato le mie preoccupazioni.",
        "ja": "その知らせで心配が大きくなりました。",
        "nb": "Den nyheten gjorde meg mer bekymret.",
        "nl": "Dat nieuws maakte me nog bezorgder.",
        "pl": "Ta wiadomość jeszcze bardziej mnie zaniepokoiła.",
        "pt": "Essa notícia aumentou minha preocupação.",
        "ro": "Vestea aceea mi-a sporit îngrijorarea.",
        "ru": "Из-за этой новости моя тревога усилилась.",
        "sv": "Nyheten gjorde mig mer orolig.",
        "tr": "O haberle endişem arttı.",
        "uk": "Така новина посилила мою тривогу.",
        "vi": "Tin đó làm tôi lo hơn.",
        "yue": "嗰個消息令我更擔心。",
        "zh-Hans": "那条消息让我更担心了。"
      },
