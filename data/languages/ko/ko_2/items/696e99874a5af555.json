  "sentences": [
    {
      "target": "비가 와요. 그래도 산책해요.",
      "reading": "biga wayo. geuraedo sanchaekhaeyo.",
      "translations": {
        "en": "It's raining. Still, I go for a walk.",
        "ko": "비가 와요. 그래도 산책해요.",
        "ipa": "biga wayo. geuraedo sanchaekhaeyo.",
        "ar": "إنه يمطر. مع ذلك، أتمشى.",
        "cs": "Prší. Přesto jdu na procházku.",
        "da": "Det regner. Alligevel går jeg en tur.",
        "de": "Es regnet. Trotzdem gehe ich spazieren.",
        "el": "Βρέχει. Παρ' όλα αυτά, πάω για μια βόλτα.",
        "es": "Está lloviendo. Aun así, salgo a caminar.",
        "fi": "Sataa. Silti menen kävelylle.",
        "fr": "Il pleut. Pourtant, je vais me promener.",
        "he": "יורד גשם. בכל זאת, אני הולך לטייל.",
        "hi": "बारिश हो रही है। फिर भी, मैं टहलने जाता हूँ।",
        "hu": "Esik az eső. Mégis sétálok egyet.",
        "id": "Sedang hujan. Tetap saja, saya pergi jalan-jalan.",
        "it": "Sta piovendo. Però vado a fare una passeggiata.",
        "ja": "雨が降っています。それでも散歩します。",
        "nb": "Det regner. Likevel går jeg en tur.",
        "nl": "Het regent. Toch ga ik wandelen.",
        "pl": "Pada deszcz. Mimo to idę na spacer.",
        "pt": "Está chovendo. Mesmo assim, vou dar uma caminhada.",
        "ro": "Plouă. Totuși, merg la plimbare.",
        "ru": "Идёт дождь. Всё равно я иду гулять.",
        "sv": "Det regnar. Ändå går jag ut och promenerar.",
        "tr": "Yağmur yağıyor. Yine de yürüyüşe çıkıyorum.",
        "uk": "Іде дощ. Все одно я йду на прогулянку.",
        "vi": "Trời đang mưa. Dù vậy, tôi vẫn đi dạo.",
        "yue": "落緊雨。不過，我都會去散步。",
        "zh-Hans": "下雨了。尽管如此，我还是去散步。"
      },
