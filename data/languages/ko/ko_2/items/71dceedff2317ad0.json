    {
      "target": "아침보다 기분이 한결 좋아요.",
      "reading": "achimboda gibuni hangyeol joayo.",
      "translations": {
        "en": "I feel much better than this morning.",
        "ko": "아침보다 기분이 한결 좋아요.",
        "ipa": "achimboda gibuni hangyeol joayo.",
        "ar": "أشعر أنني أفضل بكثير من هذا الصباح.",
        "cs": "Cítím se mnohem lépe než ráno.",
        "da": "Jeg har det meget bedre end i morges.",
        "de": "Mir geht es viel besser als heute Morgen.",
        "el": "Νιώθω πολύ καλύτερα από το πρωί.",
        "es": "Me siento mucho mejor que esta mañana.",
        "fi": "Minulla on paljon parempi olo kuin aamulla.",
        "fr": "Je me sens beaucoup mieux que ce matin.",
        "he": "אני מרגיש הרבה יותר טוב מאשר הבוקר.",
        "hi": "मुझे सुबह से काफ़ी बेहतर लग रहा है।",
        "hu": "Sokkal jobban érzem magam, mint reggel.",
        "id": "Saya merasa jauh lebih baik daripada pagi tadi.",
        "it": "Mi sento molto meglio rispetto a stamattina.",
        "ja": "朝よりずっと気分がいいです。",
        "nb": "Jeg føler meg mye bedre enn i morges.",
        "nl": "Ik voel me een stuk beter dan vanmorgen.",
        "pl": "Czuję się dużo lepiej niż rano.",
        "pt": "Estou me sentindo muito melhor do que de manhã.",
        "ro": "Mă simt mult mai bine decât dimineață.",
        "ru": "Мне гораздо лучше, чем утром.",
        "sv": "Jag mår mycket bättre än i morse.",
        "tr": "Sabaha göre kendimi çok daha iyi hissediyorum.",
        "uk": "Я почуваюся набагато краще, ніж зранку.",
        "vi": "Tôi thấy khá hơn nhiều so với sáng nay.",
        "yue": "我嘅心情比朝早好咗好多。",
        "zh-Hans": "我感觉比早上好多了。"
      },
