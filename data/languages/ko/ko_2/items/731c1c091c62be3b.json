  "sentences": [
    {
      "target": "그분은 모두에게 좋은 선생님으로 여겨집니다.",
      "reading": "geubuneun modeuege joeun seonsaengnim-euro yeogyeojimnida.",
      "translations": {
        "en": "He is regarded as a good teacher by everyone.",
        "ko": "그분은 모두에게 좋은 선생님으로 여겨집니다.",
        "ipa": "geubuneun modeuege joeun seonsaengnim-euro yeogyeojimnida.",
        "ar": "يُنظر إليه على أنه معلم جيد من قبل الجميع.",
        "cs": "Všichni ho považují za dobrého učitele.",
        "da": "Han regnes som en god lærer af alle.",
        "de": "Er wird von allen als guter Lehrer angesehen.",
        "el": "Όλοι τον θεωρούν καλό δάσκαλο.",
        "es": "Todos lo consideran un buen profesor.",
        "fi": "Kaikki pitävät häntä hyvänä opettajana.",
        "fr": "Tout le monde le considère comme un bon professeur.",
        "he": "כולם רואים בו מורה טוב.",
        "hi": "उसे सब एक अच्छे शिक्षक के रूप में मानते हैं।",
        "hu": "Mindenki jó tanárnak tartja.",
        "id": "Dia dianggap sebagai guru yang baik oleh semua orang.",
        "it": "Tutti lo considerano un buon insegnante.",
        "ja": "彼はみんなにいい先生だと思われています。",
        "nb": "Han regnes som en god lærer av alle.",
        "nl": "Hij wordt door iedereen als een goede leraar gezien.",
        "pl": "Wszyscy uważają go za dobrego nauczyciela.",
        "pt": "Ele é considerado um bom professor por todos.",
        "ro": "Toată lumea îl consideră un profesor bun.",
        "ru": "Все считают его хорошим учителем.",
        "sv": "Han ses som en bra lärare av alla.",
        "tr": "Herkes onu iyi bir öğretmen olarak görür.",
        "uk": "Усі вважають його хорошим учителем.",
        "vi": "Mọi người đều coi anh ấy là một giáo viên giỏi.",
        "yue": "大家都認為佢係個好老師。",
        "zh-Hans": "大家都认为他是个好老师。"
      },
