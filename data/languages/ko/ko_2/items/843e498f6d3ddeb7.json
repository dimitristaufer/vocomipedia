  "sentences": [
    {
      "target": "그는 나에게 조심히 다가서요.",
      "reading": "Geuneun naege josimhi dagaseoyo.",
      "translations": {
        "en": "He approaches me carefully.",
        "ko": "그는 나에게 조심히 다가서요.",
        "ipa": "Geuneun naege josimhi dagaseoyo.",
        "ar": "يقترب مني بحذر.",
        "cs": "Přibližuje se ke mně opatrně.",
        "da": "Han nærmer sig mig forsigtigt.",
        "de": "Er nähert sich mir vorsichtig.",
        "el": "Με πλησιάζει προσεκτικά.",
        "es": "Se acerca a mí con cuidado.",
        "fi": "Hän tulee varovasti luokseni.",
        "fr": "Il s'approche de moi avec prudence.",
        "he": "הוא ניגש אליי בזהירות.",
        "hi": "वह मुझसे सावधानी से पास आ रहा है।",
        "hu": "Óvatosan közeledik hozzám.",
        "id": "Dia mendekati saya dengan hati-hati.",
        "it": "Si avvicina a me con cautela.",
        "ja": "彼は私にそっと近づきます。",
        "nb": "Han kommer forsiktig bort til meg.",
        "nl": "Hij komt voorzichtig naar me toe.",
        "pl": "Podchodzi do mnie ostrożnie.",
        "pt": "Ele se aproxima de mim com cuidado.",
        "ro": "Se apropie de mine cu grijă.",
        "ru": "Он осторожно подходит ко мне.",
        "sv": "Han kommer försiktigt fram till mig.",
        "tr": "Bana dikkatlice yaklaşıyor.",
        "uk": "Він обережно підходить до мене.",
        "vi": "Anh ấy đến gần tôi một cách cẩn thận.",
        "yue": "佢小心咁行近我。",
        "zh-Hans": "他小心地向我靠近。"
      },
