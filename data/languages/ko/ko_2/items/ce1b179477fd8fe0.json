    {
      "target": "나무의 높이를 재 봤어요.",
      "reading": "namu-ui nopireul jae bwasseoyo.",
      "translations": {
        "en": "I measured the height of the tree.",
        "ko": "나무의 높이를 재 봤어요.",
        "ipa": "namu-ui nopireul jae bwasseoyo.",
        "ar": "قست ارتفاع الشجرة.",
        "cs": "Změřil jsem výšku stromu.",
        "da": "Jeg målte træets højde.",
        "de": "Ich habe die Höhe des Baums gemessen.",
        "el": "Μέτρησα το ύψος του δέντρου.",
        "es": "Medí la altura del árbol.",
        "fi": "Mittaoin puun korkeuden.",
        "fr": "J'ai mesuré la hauteur de l'arbre.",
        "he": "מדדתי את גובה העץ.",
        "hi": "मैंने पेड़ की ऊँचाई नापी।",
        "hu": "Megmértem a fa magasságát.",
        "id": "Saya mengukur tinggi pohon itu.",
        "it": "Ho misurato l'altezza dell'albero.",
        "ja": "木の高さを測りました。",
        "nb": "Jeg målte høyden på treet.",
        "nl": "Ik heb de hoogte van de boom gemeten.",
        "pl": "Zmierzylem wysokość drzewa.",
        "pt": "Meça a altura da árvore.",
        "ro": "Am măsurat înălțimea copacului.",
        "ru": "Я измерил высоту дерева.",
        "sv": "Jag mätte trädets höjd.",
        "tr": "Ağacın yüksekliğini ölçtüm.",
        "uk": "Я виміряв висоту дерева.",
        "vi": "Tôi đã đo chiều cao của cây.",
        "yue": "我量咗棵樹嘅高度。",
        "zh-Hans": "我量了树的高度。"
      },
