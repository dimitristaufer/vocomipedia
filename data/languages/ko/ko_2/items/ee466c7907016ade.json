  "sentences": [
    {
      "target": "샐러드에 마요네즈를 조금 뿌렸어요.",
      "reading": "saelleodeue mayonejeureul jogeum ppurieosseoyo.",
      "translations": {
        "en": "I added a little mayonnaise to the salad.",
        "ko": "샐러드에 마요네즈를 조금 뿌렸어요.",
        "ipa": "saelleodeue mayonejeureul jogeum ppurieosseoyo.",
        "ar": "أضفتُ قليلًا من المايونيز إلى السلطة.",
        "cs": "Do salátu jsem přidal trochu majonézy.",
        "da": "Jeg kom lidt mayonnaise på salaten.",
        "de": "Ich habe etwas Mayonnaise in den Salat gegeben.",
        "el": "Έβαλα λίγη μαγιονέζα στη σαλάτα.",
        "es": "Le eché un poco de mayonesa a la ensalada.",
        "fi": "Lisäsin salaattiin vähän majoneesia.",
        "fr": "J'ai ajouté un peu de mayonnaise à la salade.",
        "he": "הוספתי קצת מיונז לסלט.",
        "hi": "मैंने सलाद में थोड़ा सा मेयोनेज़ डाला।",
        "hu": "Tettem egy kis majonézt a salátára.",
        "id": "Saya menambahkan sedikit mayones ke salad.",
        "it": "Ho aggiunto un po' di maionese all'insalata.",
        "ja": "サラダにマヨネーズを少しかけました。",
        "nb": "Jeg hadde litt majones på salaten.",
        "nl": "Ik deed wat mayonaise op de salade.",
        "pl": "Dodałem trochę majonezu do sałatki.",
        "pt": "Coloquei um pouco de maionese na salada.",
        "ro": "Am pus puțină maioneză în salată.",
        "ru": "Я добавил немного майонеза в салат.",
        "sv": "Jag hällde lite majonnäs på salladen.",
        "tr": "Salataya biraz mayonez ekledim.",
        "uk": "Я додав трохи майонезу до салату.",
        "vi": "Tôi cho thêm một ít sốt mayonnaise vào salad.",
        "yue": "我加咗少少蛋黃醬喺沙律度。",
        "zh-Hans": "我在沙拉里加了一点蛋黄酱。"
      },
