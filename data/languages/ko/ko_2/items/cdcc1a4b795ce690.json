  "sentences": [
    {
      "target": "합격 소식에 기쁨이 컸어요.",
      "reading": "hapgyeok sosige gippeumi keosseoyo.",
      "translations": {
        "en": "I was filled with joy at the good news of passing.",
        "ko": "합격 소식에 기쁨이 컸어요.",
        "ipa": "hapgyeok sosige gippeumi keosseoyo.",
        "ar": "غمرتني الفرحة بخبر النجاح.",
        "cs": "Zpráva o přijetí mi udělala velkou radost.",
        "da": "Jeg blev fyldt med glæde over den gode nyhed om, at jeg var kommet ind.",
        "de": "Die gute Nachricht über die bestandene Prüfung hat mich mit Freude erfüllt.",
        "el": "Χάρηκα πολύ με τα καλά νέα ότι πέρασα.",
        "es": "Me llené de alegría con la buena noticia de que aprobé.",
        "fi": "Hyvät uutiset läpipääsystä täyttivät minut ilolla.",
        "fr": "J'ai été rempli de joie à la bonne nouvelle de ma réussite.",
        "he": "התמלאתי שמחה מהחדשות הטובות על המעבר.",
        "hi": "पास होने की अच्छी खबर से मैं बहुत खुश हो गया।",
        "hu": "Nagy öröm töltött el a jó hír hallatán, hogy átmentem.",
        "id": "Saya dipenuhi kegembiraan saat mendengar kabar kelulusan itu.",
        "it": "La buona notizia del superamento mi ha riempito di gioia.",
        "ja": "合格の知らせにとても喜びました。",
        "nb": "Jeg ble fylt av glede over den gode nyheten om at jeg hadde bestått.",
        "nl": "Ik was dolblij met het goede nieuws dat ik geslaagd was.",
        "pl": "Dobra wiadomość o zaliczeniu bardzo mnie ucieszyła.",
        "pt": "Fiquei muito feliz com a boa notícia da aprovação.",
        "ro": "Am fost plin de bucurie la vestea bună că am trecut.",
        "ru": "Я был полон радости, когда услышал хорошую новость о сдаче.",
        "sv": "Jag fylldes av glädje över det glada beskedet att jag hade klarat det.",
        "tr": "Geçtiğime dair güzel haberi alınca çok sevindim.",
        "uk": "Я був сповнений радості від хорошої новини про те, що я склав іспит.",
        "vi": "Tôi rất vui khi nghe tin đậu.",
        "yue": "知道考試合格嘅好消息後，我好高興。",
        "zh-Hans": "听到通过的好消息后，我非常高兴。"
      },
