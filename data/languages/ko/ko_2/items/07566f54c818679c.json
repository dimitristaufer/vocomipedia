  "sentences": [
    {
      "target": "아버지는 내 설명에 천천히 끄덕였다.",
      "reading": "abeojineun nae seolmyeong-e cheoncheonhi kkeudeogyeotda",
      "translations": {
        "en": "My father nodded slowly at my explanation.",
        "ko": "아버지는 내 설명에 천천히 끄덕였다.",
        "ipa": "abeojineun nae seolmyeong-e cheoncheonhi kkeudeogyeotda",
        "ar": "أومأ أبي ببطء عند شرحي.",
        "cs": "Táta při mém vysvětlení pomalu přikývl.",
        "da": "Min far nikkede langsomt til min forklaring.",
        "de": "Mein Vater nickte langsam zu meiner Erklärung.",
        "el": "Ο πατέρας μου έγνεψε αργά στην εξήγησή μου.",
        "es": "Mi padre asintió despacio ante mi explicación.",
        "fi": "Isä nyökkäsi hitaasti selitykselleni.",
        "fr": "Mon père a hoché lentement la tête à mon explication.",
        "he": "אבא שלי הנהן לאט להסבר שלי.",
        "hi": "मेरे पिता ने मेरी बात सुनकर धीरे से सिर हिलाया।",
        "hu": "Apám lassan bólintott a magyarázatomra.",
        "id": "Ayah mengangguk pelan mendengar penjelasanku.",
        "it": "Mio padre annuì lentamente alla mia spiegazione.",
        "ja": "父は私の説明にゆっくりうなずいた。",
        "nb": "Faren min nikket langsomt til forklaringen min.",
        "nl": "Mijn vader knikte langzaam bij mijn uitleg.",
        "pl": "Mój ojciec powoli skinął głową na moje wyjaśnienie.",
        "pt": "Meu pai assentiu lentamente à minha explicação.",
        "ro": "Tatăl meu a dat încet din cap la explicația mea.",
        "ru": "Мой отец медленно кивнул в ответ на мои объяснения.",
        "sv": "Min pappa nickade långsamt åt min förklaring.",
        "tr": "Babam açıklamama yavaşça başını salladı.",
        "uk": "Мій батько повільно кивнув на моє пояснення.",
        "vi": "Bố tôi gật đầu chậm rãi trước lời giải thích của tôi.",
        "yue": "阿爸聽完我嘅解釋後，慢慢點頭。",
        "zh-Hans": "我父亲听了我的解释后慢慢点头。"
      },
