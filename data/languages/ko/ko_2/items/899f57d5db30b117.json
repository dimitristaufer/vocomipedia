    "ar": [
      "وضعتُ القرص المدمج في حقيبتي.",
      "هذا القرص المدمج القديم ما زال يعمل جيدًا.",
      "من فضلك، أعطني قرصًا مدمجًا واحدًا فقط.",
      "القرص المدمج مخدوش، لذلك لا أستطيع الاستماع إليه."
    ],
    "cs": [
      "Dal jsem CD do tašky.",
      "Toto staré CD stále dobře hraje.",
      "Půjčte mi prosím jen jedno CD.",
      "CD je poškrábané, tak si ho nemůžu pustit."
    ],
    "da": [
      "Jeg lagde cd'en i min taske.",
      "Denne gamle cd virker stadig fint.",
      "Lån mig bare én cd, tak.",
      "Cd'en er ridset, så jeg kan ikke lytte til den."
    ],
    "de": [
      "Ich habe die CD in meine Tasche getan.",
      "Diese alte CD spielt noch gut.",
      "Bitte leih mir nur eine CD.",
      "Die CD ist zerkratzt, deshalb kann ich sie nicht hören."
    ],
    "el": [
      "Έβαλα το CD στην τσάντα μου.",
      "Αυτό το παλιό CD παίζει ακόμα καλά.",
      "Δανείσου μου μόνο ένα CD, σε παρακαλώ.",
      "Το CD είναι γρατζουνισμένο, οπότε δεν μπορώ να το ακούσω."
    ],
    "es": [
      "Puse el CD en mi bolso.",
      "Este CD viejo todavía funciona bien.",
      "Préstame solo un CD, por favor.",
      "El CD está rayado, así que no puedo escucharlo."
    ],
    "fi": [
      "Laitoin CD:n laukkuuni.",
      "Tämä vanha CD toimii vielä hyvin.",
      "Lainaa minulle vain yksi CD, kiitos.",
      "CD on naarmuinen, joten en voi kuunnella sitä."
    ],
    "fr": [
      "J'ai mis le CD dans mon sac.",
      "Ce vieux CD marche encore bien.",
      "Prête-moi juste un CD, s'il te plaît.",
      "Le CD est rayé, alors je ne peux pas l'écouter."
    ],
    "he": [
      "שמתי את התקליטור בתיק שלי.",
      "התקליטור הישן הזה עדיין עובד טוב.",
      "תלווה לי רק תקליטור אחד, בבקשה.",
      "התקליטור שרוט, אז אני לא יכול להאזין לו."
    ],
    "hi": [
      "मैंने सीडी को अपने बैग में रख दिया।",
      "यह पुरानी सीडी अभी भी अच्छी तरह चलती है।",
      "कृपया मुझे सिर्फ एक सीडी उधार दें।",
      "सीडी पर खरोंच है, इसलिए मैं उसे सुन नहीं सकता।"
    ],
    "hu": [
      "Betettem a CD-t a táskámba.",
      "Ez a régi CD még mindig jól működik.",
      "Kérlek, adj kölcsön csak egy CD-t.",
      "A CD karcos, ezért nem tudom meghallgatni."
    ],
    "id": [
      "Saya memasukkan CD ke dalam tas.",
      "CD tua ini masih bisa diputar dengan baik.",
      "Tolong pinjamkan saya hanya satu CD.",
      "CD itu tergores, jadi saya tidak bisa mendengarkannya."
    ],
    "it": [
      "Ho messo il CD nella mia borsa.",
      "Questo vecchio CD funziona ancora bene.",
      "Prestami solo un CD, per favore.",
      "Il CD è graffiato, quindi non riesco ad ascoltarlo."
    ],
    "ja": [
      "CDをかばんに入れました。",
      "この古いCDはまだちゃんと再生できます。",
      "CDを1枚だけ貸してください。",
      "CDに傷があるので、聞けません。"
    ],
    "nb": [
      "Jeg la CD-en i vesken min.",
      "Denne gamle CD-en spiller fortsatt bra.",
      "Lån meg bare én CD, takk.",
      "CD-en er ripet, så jeg kan ikke høre på den."
    ],
    "nl": [
      "Ik deed de cd in mijn tas.",
