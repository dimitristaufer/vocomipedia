  "sentences": [
    {
      "target": "저는 간혹 버스를 타고 출근해요.",
      "reading": "jeoneun ganhok beoseureul tago chulgeunhaeyo.",
      "translations": {
        "en": "I occasionally take the bus to work.",
        "ko": "저는 간혹 버스를 타고 출근해요.",
        "ipa": "jeoneun ganhok beoseureul tago chulgeunhaeyo.",
        "ar": "أستقل الحافلة إلى العمل أحيانًا.",
        "cs": "Do práce jezdím občas autobusem.",
        "da": "Jeg tager af og til bussen på arbejde.",
        "de": "Ich fahre gelegentlich mit dem Bus zur Arbeit.",
        "el": "Πηγαίνω περιστασιακά στη δουλειά με το λεωφορείο.",
        "es": "A veces voy al trabajo en autobús.",
        "fi": "Kuljen joskus töihin bussilla.",
        "fr": "Je prends parfois le bus pour aller au travail.",
        "he": "אני לוקח את האוטובוס לעבודה לפעמים.",
        "hi": "मैं कभी-कभी बस से काम पर जाता हूँ।",
        "hu": "Néha busszal járok dolgozni.",
        "id": "Saya kadang-kadang naik bus ke kantor.",
        "it": "A volte vado al lavoro in autobus.",
        "ja": "私はときどきバスで通勤します。",
        "nb": "Jeg tar av og til bussen til jobben.",
        "nl": "Ik neem soms de bus naar mijn werk.",
        "pl": "Czasami jeżdżę do pracy autobusem.",
        "pt": "Às vezes vou para o trabalho de ônibus.",
        "ro": "Uneori merg la serviciu cu autobuzul.",
        "ru": "Я иногда езжу на работу на автобусе.",
        "sv": "Jag tar ibland bussen till jobbet.",
        "tr": "İşe bazen otobüsle giderim.",
        "uk": "Я іноді їжджу на роботу автобусом.",
        "vi": "Tôi thỉnh thoảng đi làm bằng xe buýt.",
        "yue": "我間中搭巴士返工。",
        "zh-Hans": "我偶尔坐公交车上班。"
      },
