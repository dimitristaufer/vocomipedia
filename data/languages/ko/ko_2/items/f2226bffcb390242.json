  "sentences": [
    {
      "target": "그 마음은 헤아릴 수 없어요.",
      "reading": "geu maeumeun hearil su eopseoyo.",
      "translations": {
        "en": "I can't begin to imagine that feeling.",
        "ko": "그 마음은 헤아릴 수 없어요.",
        "ipa": "geu maeumeun hearil su eopseoyo.",
        "ar": "لا أستطيع أن أتخيل هذا الشعور.",
        "cs": "Ten pocit si ani nedokážu představit.",
        "da": "Jeg kan slet ikke forestille mig den følelse.",
        "de": "Ich kann mir dieses Gefühl nicht einmal vorstellen.",
        "el": "Δεν μπορώ ούτε να το φανταστώ αυτό το συναίσθημα.",
        "es": "No puedo ni imaginar ese sentimiento.",
        "fi": "En osaa edes kuvitella sitä tunnetta.",
        "fr": "Je n’arrive même pas à imaginer ce sentiment.",
        "he": "אני לא יכול אפילו לדמיין את ההרגשה הזאת.",
        "hi": "मैं उस भावना की कल्पना भी नहीं कर सकता।",
        "hu": "El sem tudom képzelni ezt az érzést.",
        "id": "Saya bahkan tidak bisa membayangkan perasaan itu.",
        "it": "Non riesco nemmeno a immaginare quel sentimento.",
        "ja": "その気持ちは想像もつきません。",
        "nb": "Jeg kan ikke engang forestille meg den følelsen.",
        "nl": "Ik kan me dat gevoel niet eens voorstellen.",
        "pl": "Nie potrafię sobie nawet wyobrazić tego uczucia.",
        "pt": "Nem consigo imaginar esse sentimento.",
        "ro": "Nici nu-mi pot imagina acel sentiment.",
        "ru": "Я даже не могу представить это чувство.",
        "sv": "Jag kan inte ens föreställa mig den känslan.",
        "tr": "O duyguyu hayal bile edemiyorum.",
        "uk": "Я навіть не можу уявити це відчуття.",
        "vi": "Tôi không thể nào tưởng tượng nổi cảm giác đó.",
        "yue": "我完全想像唔到嗰種感受。",
        "zh-Hans": "我完全想象不出那种感觉。"
      },
