    {
      "target": "고양이가 문 밖으로 뛰어나가요.",
      "reading": "Goyangi-ga mun bakkeuro ttwieonagayo.",
      "translations": {
        "en": "The cat runs out the door.",
        "ko": "고양이가 문 밖으로 뛰어나가요.",
        "ipa": "Goyangi-ga mun bakkeuro ttwieonagayo.",
        "ar": "خرج القط مسرعًا من الباب.",
        "cs": "Kočka vyběhla ze dveří.",
        "da": "Katten løber ud gennem døren.",
        "de": "Die Katze rennt aus der Tür.",
        "el": "Η γάτα τρέχει έξω από την πόρτα.",
        "es": "El gato sale corriendo por la puerta.",
        "fi": "Kissa juoksee ulos ovesta.",
        "fr": "Le chat sort en courant par la porte.",
        "he": "החתול רץ החוצה מהדלת.",
        "hi": "बिल्ली दरवाज़े से बाहर भागती है।",
        "hu": "A macska kirohan az ajtón.",
        "id": "Kucing itu lari keluar lewat pintu.",
        "it": "Il gatto corre fuori dalla porta.",
        "ja": "猫がドアの外へ飛び出します。",
        "nb": "Katten løper ut døra.",
        "nl": "De kat rent de deur uit.",
        "pl": "Kot wybiegł przez drzwi.",
        "pt": "O gato sai correndo pela porta.",
        "ro": "Pisica aleargă afară pe ușă.",
        "ru": "Кошка выбегает за дверь.",
        "sv": "Katten springer ut genom dörren.",
        "tr": "Kedi kapıdan dışarı fırlıyor.",
        "uk": "Кіт вибігає з дверей.",
        "vi": "Con mèo chạy vụt ra khỏi cửa.",
        "yue": "隻貓衝出門口。",
        "zh-Hans": "猫从门外跑出去。"
      },
