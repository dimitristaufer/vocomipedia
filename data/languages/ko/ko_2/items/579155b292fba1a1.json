    {
      "target": "어제 이모를 오랜만에 만났어요.",
      "reading": "eoje imo-reul oraenmane mannasseoyo.",
      "translations": {
        "en": "I met my aunt for the first time in a long while yesterday.",
        "ko": "어제 이모를 오랜만에 만났어요.",
        "ipa": "eoje imo-reul oraenmane mannasseoyo.",
        "ar": "التقيت خالتي أمس بعد فترة طويلة.",
        "cs": "Včera jsem po dlouhé době potkal svou tetu.",
        "da": "Jeg mødte min moster i går efter lang tid.",
        "de": "Ich habe meine Tante gestern nach langer Zeit getroffen.",
        "el": "Χθες συνάντησα τη θεία μου μετά από πολύ καιρό.",
        "es": "Ayer vi a mi tía después de mucho tiempo.",
        "fi": "Tapasin tätini eilen pitkästä aikaa.",
        "fr": "J'ai vu ma tante hier après longtemps.",
        "he": "אתמול פגשתי את הדודה שלי אחרי הרבה זמן.",
        "hi": "कल मैं अपनी मौसी से बहुत समय बाद मिला।",
        "hu": "Tegnap hosszú idő után találkoztam a nagynénémmel.",
        "id": "Kemarin saya bertemu bibi saya setelah lama.",
        "it": "Ieri ho incontrato mia zia dopo molto tempo.",
        "ja": "昨日、久しぶりにおばに会いました。",
        "nb": "Jeg møtte tanta mi i går, etter lang tid.",
        "nl": "Ik heb mijn tante gisteren na lange tijd weer gezien.",
        "pl": "Wczoraj spotkałem moją ciocię po długim czasie.",
        "pt": "Ontem encontrei minha tia depois de muito tempo.",
        "ro": "Ieri mi-am întâlnit mătușa după mult timp.",
        "ru": "Вчера я встретил тётю после долгого времени.",
        "sv": "Jag träffade min moster i går efter lång tid.",
        "tr": "Dün teyzemi uzun zaman sonra gördüm.",
        "uk": "Учора я зустрів тітку після довгого часу.",
        "vi": "Hôm qua tôi đã gặp dì tôi sau một thời gian dài.",
        "yue": "聽日我同阿姨好耐冇見，尋日見咗面。",
        "zh-Hans": "昨天我很久没见到我阿姨了。"
      },
