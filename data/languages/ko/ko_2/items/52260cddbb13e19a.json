  "sentences": [
    {
      "target": "저는 그가 거짓말하지 않았다고 확신해요.",
      "reading": "Jeoneun geuga geojitmalhaji anhatdago hwaksinhaeyo.",
      "translations": {
        "en": "I'm sure he didn't lie.",
        "ko": "저는 그가 거짓말하지 않았다고 확신해요.",
        "ipa": "Jeoneun geuga geojitmalhaji anhatdago hwaksinhaeyo.",
        "ar": "أنا متأكد أنه لم يكذب.",
        "cs": "Jsem si jistý, že nelhal.",
        "da": "Jeg er sikker på, at han ikke løj.",
        "de": "Ich bin sicher, dass er nicht gelogen hat.",
        "el": "Είμαι σίγουρος ότι δεν είπε ψέματα.",
        "es": "Estoy seguro de que no mintió.",
        "fi": "Olen varma, ettei hän valehdellut.",
        "fr": "Je suis sûr qu'il n'a pas menti.",
        "he": "אני בטוח שהוא לא שיקר.",
        "hi": "मुझे यकीन है कि उसने झूठ नहीं बोला।",
        "hu": "Biztos vagyok benne, hogy nem hazudott.",
        "id": "Saya yakin dia tidak berbohong.",
        "it": "Sono sicuro che non ha mentito.",
        "ja": "彼がうそをついていないと確信しています。",
        "nb": "Jeg er sikker på at han ikke løy.",
        "nl": "Ik ben er zeker van dat hij niet heeft gelogen.",
        "pl": "Jestem pewien, że on nie kłamał.",
        "pt": "Tenho certeza de que ele não mentiu.",
        "ro": "Sunt sigur că el nu a mințit.",
        "ru": "Я уверен, что он не лгал.",
        "sv": "Jag är säker på att han inte ljög.",
        "tr": "Yalan söylemediğinden emindim.",
        "uk": "Я впевнений, що він не брехав.",
        "vi": "Tôi chắc chắn là anh ấy không nói dối.",
        "yue": "我肯定佢冇講大話。",
        "zh-Hans": "我确定他没有说谎。"
      },
