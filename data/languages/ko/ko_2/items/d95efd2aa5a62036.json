  "sentences": [
    {
      "target": "그 영화는 아직도 저에게 감동을 줘요.",
      "reading": "geu yeonghwaneun ajikdo jeoege gamdong-eul jwoyo.",
      "translations": {
        "en": "That movie still moves me.",
        "ko": "그 영화는 아직도 저에게 감동을 줘요.",
        "ipa": "geu yeonghwaneun ajikdo jeoege gamdong-eul jwoyo.",
        "ar": "هذا الفيلم ما زال يؤثر فيّ.",
        "cs": "Ten film mě pořád dojímá.",
        "da": "Den film rører mig stadig.",
        "de": "Der Film rührt mich immer noch.",
        "el": "Αυτή η ταινία με συγκινεί ακόμα.",
        "es": "Esa película todavía me emociona.",
        "fi": "Tuo elokuva liikuttaa minua yhä.",
        "fr": "Ce film m'émeut encore.",
        "he": "הסרט הזה עדיין מרגש אותי.",
        "hi": "यह फिल्म मुझे अभी भी भावुक कर देती है।",
        "hu": "Ez a film még mindig meghat.",
        "id": "Film itu masih mengharukan saya.",
        "it": "Quel film mi emoziona ancora.",
        "ja": "あの映画は今でも私を感動させます。",
        "nb": "Den filmen rører meg fortsatt.",
        "nl": "Die film ontroert me nog steeds.",
        "pl": "Ten film nadal mnie wzrusza.",
        "pt": "Esse filme ainda me emociona.",
        "ro": "Filmul acela încă mă emoționează.",
        "ru": "Этот фильм до сих пор трогает меня.",
        "sv": "Den där filmen berör mig fortfarande.",
        "tr": "O film beni hâlâ duygulandırıyor.",
        "uk": "Цей фільм досі мене зворушує.",
        "vi": "Bộ phim đó vẫn làm tôi xúc động.",
        "yue": "呢套戲而家仲係好感動我。",
        "zh-Hans": "那部电影到现在还让我感动。"
      },
