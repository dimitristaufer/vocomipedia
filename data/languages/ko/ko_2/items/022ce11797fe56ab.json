    {
      "target": "시험 전에 마음을 다졌어요.",
      "reading": "siheom jeone maeumeul dajyeosseoyo.",
      "translations": {
        "en": "I steeled my mind before the exam.",
        "ko": "시험 전에 마음을 다졌어요.",
        "ipa": "siheom jeone maeumeul dajyeosseoyo.",
        "ar": "تماسكت قبل الامتحان.",
        "cs": "Před zkouškou jsem se psychicky posílil.",
        "da": "Jeg samlede mig før eksamen.",
        "de": "Vor der Prüfung habe ich mich gesammelt.",
        "el": "Πριν από τις εξετάσεις, έκανα τον εαυτό μου να σταθεί γερά.",
        "es": "Me armé de valor antes del examen.",
        "fi": "Vahvistin mieltäni ennen koetta.",
        "fr": "Je me suis préparé mentalement avant l'examen.",
        "he": "חיזקתי את עצמי לפני המבחן.",
        "hi": "मैंने परीक्षा से पहले हिम्मत जुटाई।",
        "hu": "Megacéloztam magam a vizsga előtt.",
        "id": "Saya menguatkan hati sebelum ujian.",
        "it": "Mi sono fatto coraggio prima dell'esame.",
        "ja": "試験の前に気持ちを引き締めました。",
        "nb": "Jeg samlet mot før eksamen.",
        "nl": "Ik zette me schrap voor het examen.",
        "pl": "Przed egzaminem wzmocniłem się psychicznie.",
        "pt": "Me preparei mentalmente antes da prova.",
        "ro": "M-am întărit înainte de examen.",
        "ru": "Я собрался перед экзаменом.",
        "sv": "Jag samlade mig före provet.",
        "tr": "Sınavdan önce kendimi topladım.",
        "uk": "Я зібрався перед іспитом.",
        "vi": "Tôi lấy lại tinh thần trước kỳ thi.",
        "yue": "考試前，我定咗心。",
        "zh-Hans": "考试前，我定了心。"
      },
