      "target": "제 발을 밟지 마세요.",
      "reading": "제 바를 밥찌 마세요.",
      "translations": {
        "en": "Please don't step on my foot.",
        "ko": "제 발을 밟지 마세요.",
        "ipa": "제 바를 밥찌 마세요.",
        "ar": "من فضلك لا تدس على قدمي.",
        "cs": "Prosím, nešlapejte mi na nohu.",
        "da": "Træd ikke på min fod, tak.",
        "de": "Treten Sie mir bitte nicht auf den Fuß.",
        "el": "Σε παρακαλώ, μην πατήσεις το πόδι μου.",
        "es": "Por favor, no me pises el pie.",
        "fi": "Älä astu jalalleni.",
