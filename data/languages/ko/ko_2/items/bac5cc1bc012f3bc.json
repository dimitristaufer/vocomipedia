  "sentences": [
    {
      "target": "저는 적금보다 투자에 관심이 있어요.",
      "reading": "jeoneun jeokgeumboda tujae gwansimi isseoyo.",
      "translations": {
        "en": "I’m more interested in investment than in savings.",
        "ko": "저는 적금보다 투자에 관심이 있어요.",
        "ipa": "jeoneun jeokgeumboda tujae gwansimi isseoyo.",
        "ar": "أنا مهتم بالاستثمار أكثر من التوفير.",
        "cs": "Mám větší zájem o investice než o spoření.",
        "da": "Jeg er mere interesseret i investering end i opsparing.",
        "de": "Ich interessiere mich mehr für Investitionen als für Sparen.",
        "el": "Με ενδιαφέρουν περισσότερο οι επενδύσεις παρά οι αποταμιεύσεις.",
        "es": "Me interesan más las inversiones que los ahorros.",
        "fi": "Olen enemmän kiinnostunut sijoittamisesta kuin säästämisestä.",
        "fr": "Je m'intéresse plus à l'investissement qu'à l'épargne.",
        "he": "אני מתעניין יותר בהשקעות מאשר בחיסכון.",
        "hi": "मुझे बचत से ज़्यादा निवेश में दिलचस्पी है।",
        "hu": "Jobban érdekel a befektetés, mint a megtakarítás.",
        "id": "Saya lebih tertarik pada investasi daripada tabungan.",
        "it": "Mi interessa più l'investimento che il risparmio.",
        "ja": "私は貯金より投資に興味があります。",
        "nb": "Jeg er mer interessert i investering enn i sparing.",
        "nl": "Ik ben meer geïnteresseerd in beleggen dan in sparen.",
        "pl": "Bardziej interesują mnie inwestycje niż oszczędzanie.",
        "pt": "Tenho mais interesse em investimentos do que em poupança.",
        "ro": "Sunt mai interesat de investiții decât de economii.",
        "ru": "Меня больше интересуют инвестиции, чем сбережения.",
        "sv": "Jag är mer intresserad av investeringar än av sparande.",
        "tr": "Tasarruftan çok yatırıma ilgi duyuyorum.",
