  "sentences": [
    {
      "target": "아내의 임신 소식을 들었어요.",
      "reading": "anae-ui imsin sosigeul deureosseoyo.",
      "translations": {
        "en": "I heard the news of my wife's pregnancy.",
        "ko": "아내의 임신 소식을 들었어요.",
        "ipa": "anae-ui imsin sosigeul deureosseoyo.",
        "ar": "سمعت خبر حمل زوجتي.",
        "cs": "Slyšel jsem, že je moje žena těhotná.",
        "da": "Jeg hørte nyheden om, at min kone var gravid.",
        "de": "Ich habe die Nachricht von der Schwangerschaft meiner Frau gehört.",
        "el": "Άκουσα τα νέα για την εγκυμοσύνη της γυναίκας μου.",
        "es": "Escuché la noticia de que mi esposa estaba embarazada.",
        "fi": "Sain kuulla, että vaimoni on raskaana.",
        "fr": "J'ai appris que ma femme était enceinte.",
        "he": "שמעתי את החדשות על ההיריון של אשתי.",
        "hi": "मुझे अपनी पत्नी के गर्भवती होने की खबर मिली।",
        "hu": "Megkaptam a hírt, hogy a feleségem terhes.",
        "id": "Saya mendengar kabar bahwa istri saya hamil.",
        "it": "Ho saputo che mia moglie è incinta.",
        "ja": "妻の妊娠の知らせを聞きました。",
        "nb": "Jeg hørte nyheten om at kona mi var gravid.",
        "nl": "Ik hoorde dat mijn vrouw zwanger is.",
        "pl": "Usłyszałem wiadomość, że moja żona jest w ciąży.",
        "pt": "Ouvi a notícia de que minha esposa estava grávida.",
        "ro": "Am aflat vestea că soția mea este însărcinată.",
        "ru": "Я услышал новость о беременности моей жены.",
        "sv": "Jag fick höra att min fru var gravid.",
        "tr": "Eşimin hamile olduğu haberini aldım.",
        "uk": "Я почув новину про вагітність моєї дружини.",
        "vi": "Tôi đã nghe tin vợ tôi mang thai.",
        "yue": "我聽到太太懷孕嘅消息。",
        "zh-Hans": "我听到妻子怀孕的消息。"
      },
