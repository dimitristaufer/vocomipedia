    {
      "target": "임신 중에는 술을 마시지 않아요.",
      "reading": "imsin jung-eneun sur-eul masiji anhayo.",
      "translations": {
        "en": "During pregnancy, you don't drink alcohol.",
        "ko": "임신 중에는 술을 마시지 않아요.",
        "ipa": "imsin jung-eneun sur-eul masiji anhayo.",
        "ar": "أثناء الحمل، لا تشربين الكحول.",
        "cs": "Během těhotenství se nepije alkohol.",
        "da": "Under graviditeten drikker man ikke alkohol.",
        "de": "Während der Schwangerschaft trinkt man keinen Alkohol.",
        "el": "Κατά τη διάρκεια της εγκυμοσύνης, δεν πίνεις αλκοόλ.",
        "es": "Durante el embarazo, no bebes alcohol.",
        "fi": "Raskauden aikana ei juoda alkoholia.",
        "fr": "Pendant la grossesse, on ne boit pas d'alcool.",
        "he": "במהלך ההיריון לא שותים אלכוהול.",
        "hi": "गर्भावस्था के दौरान शराब नहीं पीते हैं।",
        "hu": "Terhesség alatt nem iszunk alkoholt.",
        "id": "Selama hamil, kamu tidak minum alkohol.",
        "it": "Durante la gravidanza non si beve alcol.",
        "ja": "妊娠中はお酒を飲みません。",
        "nb": "Under graviditeten drikker man ikke alkohol.",
        "nl": "Tijdens de zwangerschap drink je geen alcohol.",
        "pl": "W ciąży nie pije się alkoholu.",
        "pt": "Durante a gravidez, não se bebe álcool.",
        "ro": "În timpul sarcinii, nu bei alcool.",
        "ru": "Во время беременности не пьют алкоголь.",
        "sv": "Under graviditeten dricker man inte alkohol.",
        "tr": "Hamilelikte alkol içilmez.",
        "uk": "Під час вагітності не п'ють алкоголь.",
        "vi": "Trong thời gian mang thai, không uống rượu.",
        "yue": "懷孕期間唔飲酒。",
        "zh-Hans": "怀孕期间不喝酒。"
      },
