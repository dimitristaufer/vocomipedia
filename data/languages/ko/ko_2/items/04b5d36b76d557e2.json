  "sentences": [
    {
      "target": "명절에는 가족이 다 같이 모여요.",
      "reading": "myeongjeol-eneun gajogi da gachi moyeoyo.",
      "translations": {
        "en": "On holidays, the whole family gets together.",
        "ko": "명절에는 가족이 다 같이 모여요.",
        "ipa": "myeongjeol-eneun gajogi da gachi moyeoyo.",
        "ar": "في الأعياد تجتمع العائلة كلها.",
        "cs": "O svátcích se sejde celá rodina.",
        "da": "I højtider samles hele familien.",
        "de": "An Feiertagen kommt die ganze Familie zusammen.",
        "el": "Στις γιορτές μαζεύεται όλη η οικογένεια.",
        "es": "En las fiestas, se reúne toda la familia.",
        "fi": "Juhlapyhinä koko perhe kokoontuu.",
        "fr": "Pendant les fêtes, toute la famille se réunit.",
        "he": "בחגים כל המשפחה מתכנסת.",
        "hi": "त्योहारों पर पूरा परिवार इकट्ठा होता है।",
        "hu": "Ünnepnapokon az egész család összegyűlik.",
        "id": "Saat hari raya, seluruh keluarga berkumpul.",
        "it": "Durante le feste, tutta la famiglia si riunisce.",
        "ja": "祝日には家族がみんな集まります。",
        "nb": "I høytidene samles hele familien.",
        "nl": "Tijdens de feestdagen komt het hele gezin bij elkaar.",
        "pl": "W święta spotyka się cała rodzina.",
        "pt": "Nos feriados, a família inteira se reúne.",
        "ro": "De sărbători, se adună toată familia.",
        "ru": "В праздники вся семья собирается вместе.",
        "sv": "Under högtider samlas hela familjen.",
        "tr": "Bayramlarda bütün aile bir araya gelir.",
        "uk": "На свята вся родина збирається разом.",
        "vi": "Vào dịp lễ, cả gia đình đều tụ họp.",
        "yue": "喺節日，成家人都會聚埋一齊。",
        "zh-Hans": "节日里，全家人都会聚在一起。"
      },
