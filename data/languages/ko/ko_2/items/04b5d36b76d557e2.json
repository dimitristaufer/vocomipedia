    {
      "target": "명절 선물로 과일을 샀어요.",
      "reading": "myeongjeol seonmul-ro gwail-eul sasseoyo.",
      "translations": {
        "en": "I bought fruit as a holiday gift.",
        "ko": "명절 선물로 과일을 샀어요.",
        "ipa": "myeongjeol seonmul-ro gwail-eul sasseoyo.",
        "ar": "اشتريت فاكهة هدية للعيد.",
        "cs": "Koupil jsem ovoce jako sváteční dárek.",
        "da": "Jeg købte frugt som en gave til højtiden.",
        "de": "Ich habe Obst als Geschenk für den Feiertag gekauft.",
        "el": "Αγόρασα φρούτα για δώρο γιορτής.",
        "es": "Compré fruta como regalo de fiesta.",
        "fi": "Ostin hedelmiä juhlaherkuksi.",
        "fr": "J’ai acheté des fruits comme cadeau pour les fêtes.",
        "he": "קניתי פירות כמתנה לחג.",
        "hi": "मैंने त्योहार के लिए फल खरीदे।",
        "hu": "Gyümölcsöt vettem ünnepi ajándéknak.",
        "id": "Saya membeli buah sebagai hadiah hari raya.",
        "it": "Ho comprato della frutta come regalo per le feste.",
        "ja": "祝日の贈り物に果物を買いました。",
        "nb": "Jeg kjøpte frukt som en gave til høytiden.",
        "nl": "Ik heb fruit gekocht als feestgeschenk.",
        "pl": "Kupiłem owoce na świąteczny prezent.",
        "pt": "Comprei frutas como presente de feriado.",
        "ro": "Am cumpărat fructe ca dar de sărbători.",
        "ru": "Я купил фрукты в подарок к празднику.",
        "sv": "Jag köpte frukt som en högtidspresent.",
        "tr": "Bayram hediyesi olarak meyve aldım.",
        "uk": "Я купив фрукти як святковий подарунок.",
        "vi": "Tôi đã mua trái cây làm quà lễ.",
        "yue": "我買咗生果做節日禮物。",
        "zh-Hans": "我买了水果当节日礼物。"
      },
