  "sentences": [
    {
      "target": "주말에 가족이랑 나들이를 갔어요.",
      "reading": "jumare gajogirang nadeurireul gasseoyo.",
      "translations": {
        "en": "I went on an outing with my family on the weekend.",
        "ko": "주말에 가족이랑 나들이를 갔어요.",
        "ipa": "jumare gajogirang nadeurireul gasseoyo.",
        "ar": "خرجتُ في نزهة مع عائلتي في عطلة نهاية الأسبوع.",
        "cs": "O víkendu jsem šel na výlet s rodinou.",
        "da": "Jeg var på tur med min familie i weekenden.",
        "de": "Ich bin am Wochenende mit meiner Familie spazieren gegangen.",
        "el": "Πήγα για βόλτα με την οικογένειά μου το Σαββατοκύριακο.",
        "es": "Fui de paseo con mi familia el fin de semana.",
        "fi": "Lähdin viikonloppuna perheen kanssa ulos.",
        "fr": "Je suis allé me promener en famille le week-end.",
        "he": "יצאתי לטיול עם המשפחה שלי בסוף השבוע.",
        "hi": "मैं सप्ताहांत में अपने परिवार के साथ घूमने गया था।",
        "hu": "Hétvégén kirándulni mentem a családommal.",
        "id": "Saya pergi jalan-jalan dengan keluarga saya saat akhir pekan.",
        "it": "Sono andato in gita con la mia famiglia nel fine settimana.",
        "ja": "週末に家族とお出かけしました。",
        "nb": "Jeg dro på tur med familien i helgen.",
        "nl": "Ik ben in het weekend met mijn familie op pad geweest.",
        "pl": "W weekend wybrałem się na wycieczkę z rodziną.",
        "pt": "Fui passear com a minha família no fim de semana.",
        "ro": "Am ieșit la plimbare cu familia în weekend.",
        "ru": "В выходные я ходил на прогулку с семьёй.",
        "sv": "Jag gick ut med min familj i helgen.",
        "tr": "Hafta sonu ailemle gezmeye gittim.",
        "uk": "У вихідні я пішов на прогулянку з родиною.",
        "vi": "Cuối tuần tôi đã đi dạo cùng gia đình.",
        "yue": "週末我同屋企人去咗郊遊。",
        "zh-Hans": "周末我和家人去郊游了。"
      },
