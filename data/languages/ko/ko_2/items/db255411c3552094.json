  "sentences": [
    {
      "target": "저는 주말에 아르바이트를 해요.",
      "reading": "jeoneun jumare areubaiteureul haeyo.",
      "translations": {
        "en": "I work part-time on weekends.",
        "ko": "저는 주말에 아르바이트를 해요.",
        "ipa": "jeoneun jumare areubaiteureul haeyo.",
        "ar": "أعمل بدوام جزئي في عطلة نهاية الأسبوع.",
        "cs": "O víkendu chodím na brigádu.",
        "da": "Jeg arbejder deltid i weekenden.",
        "de": "Ich arbeite am Wochenende nebenbei.",
        "el": "Δουλεύω μερική απασχόληση τα Σαββατοκύριακα.",
        "es": "Trabajo a media jornada los fines de semana.",
        "fi": "Teen viikonloppuisin osa-aikatyötä.",
        "fr": "Je travaille à temps partiel le week-end.",
        "he": "אני עובד במשרה חלקית בסופי שבוע.",
        "hi": "मैं वीकेंड पर पार्ट-टाइम काम करता हूँ।",
        "hu": "Hétvégén részmunkaidőben dolgozom.",
        "id": "Saya bekerja paruh waktu di akhir pekan.",
        "it": "Lavoro part-time nei fine settimana.",
        "ja": "私は週末にアルバイトをしています。",
        "nb": "Jeg jobber deltid i helgene.",
        "nl": "Ik werk in het weekend parttime.",
        "pl": "Pracuję na pół etatu w weekendy.",
        "pt": "Eu trabalho meio período nos fins de semana.",
        "ro": "Lucrez part-time în weekend.",
        "ru": "Я подрабатываю по выходным.",
        "sv": "Jag jobbar extra på helgerna.",
        "tr": "Hafta sonları yarı zamanlı çalışıyorum.",
        "uk": "Я підробляю на вихідних.",
        "vi": "Tôi làm thêm vào cuối tuần.",
        "yue": "我週末做兼職。",
        "zh-Hans": "我周末打工。"
      },
