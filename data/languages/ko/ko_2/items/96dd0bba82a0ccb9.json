    {
      "target": "의사에게 질병에 대해 물어봤어요.",
      "reading": "uisaege jilbyeonge daehae mureobwasseoyo.",
      "translations": {
        "en": "I asked the doctor about the disease.",
        "ko": "의사에게 질병에 대해 물어봤어요.",
        "ipa": "uisaege jilbyeonge daehae mureobwasseoyo.",
        "ar": "سألت الطبيب عن المرض.",
        "cs": "Zeptal jsem se lékaře na tu nemoc.",
        "da": "Jeg spurgte lægen om sygdommen.",
        "de": "Ich habe den Arzt nach der Krankheit gefragt.",
        "el": "Ρώτησα τον γιατρό για την ασθένεια.",
        "es": "Le pregunté al médico sobre la enfermedad.",
        "fi": "Kysyin lääkäriltä taudista.",
        "fr": "J'ai demandé au médecin à propos de la maladie.",
        "he": "שאלתי את הרופא על המחלה.",
        "hi": "मैंने डॉक्टर से बीमारी के बारे में पूछा।",
        "hu": "Megkérdeztem az orvost a betegségről.",
        "id": "Saya bertanya kepada dokter tentang penyakit itu.",
        "it": "Ho chiesto al medico informazioni sulla malattia.",
        "ja": "医者にその病気について聞きました。",
        "nb": "Jeg spurte legen om sykdommen.",
        "nl": "Ik vroeg de dokter naar de ziekte.",
        "pl": "Zapytałem lekarza o tę chorobę.",
        "pt": "Perguntei ao médico sobre a doença.",
        "ro": "L-am întrebat pe doctor despre boală.",
        "ru": "Я спросил врача о болезни.",
        "sv": "Jag frågade läkaren om sjukdomen.",
        "tr": "Doktora hastalık hakkında sordum.",
        "uk": "Я запитав лікаря про хворобу.",
        "vi": "Tôi đã hỏi bác sĩ về căn bệnh đó.",
        "yue": "我問咗醫生關於呢種病。",
        "zh-Hans": "我向医生询问了这种疾病。"
      },
