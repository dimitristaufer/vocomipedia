  "sentences": [
    {
      "target": "이 질병은 빨리 퍼집니다.",
      "reading": "i jilbyeongeun ppalli peojimnida.",
      "translations": {
        "en": "This disease spreads quickly.",
        "ko": "이 질병은 빨리 퍼집니다.",
        "ipa": "i jilbyeongeun ppalli peojimnida.",
        "ar": "ينتشر هذا المرض بسرعة.",
        "cs": "Tato nemoc se šíří rychle.",
        "da": "Denne sygdom spreder sig hurtigt.",
        "de": "Diese Krankheit verbreitet sich schnell.",
        "el": "Αυτή η ασθένεια εξαπλώνεται γρήγορα.",
        "es": "Esta enfermedad se propaga rápidamente.",
        "fi": "Tämä tauti leviää nopeasti.",
        "fr": "Cette maladie se propage rapidement.",
        "he": "המחלה הזו מתפשטת מהר.",
        "hi": "यह बीमारी जल्दी फैलती है।",
        "hu": "Ez a betegség gyorsan terjed.",
        "id": "Penyakit ini menyebar dengan cepat.",
        "it": "Questa malattia si diffonde rapidamente.",
        "ja": "この病気はすぐに広がります。",
        "nb": "Denne sykdommen sprer seg raskt.",
        "nl": "Deze ziekte verspreidt zich snel.",
        "pl": "Ta choroba szybko się rozprzestrzenia.",
        "pt": "Esta doença se espalha rapidamente.",
        "ro": "Această boală se răspândește repede.",
        "ru": "Эта болезнь быстро распространяется.",
        "sv": "Den här sjukdomen sprider sig snabbt.",
        "tr": "Bu hastalık hızla yayılıyor.",
        "uk": "Ця хвороба швидко поширюється.",
        "vi": "Bệnh này lây lan rất nhanh.",
        "yue": "呢種病傳得好快。",
        "zh-Hans": "这种疾病传播得很快。"
      },
