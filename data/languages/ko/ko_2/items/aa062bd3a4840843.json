  "sentences": [
    {
      "target": "우리는 좋은 인연으로 만났어요.",
      "reading": "urineun joheun inyeoneuro mannasseoyo.",
      "translations": {
        "en": "We met through a good connection.",
        "ko": "우리는 좋은 인연으로 만났어요.",
        "ipa": "urineun joheun inyeoneuro mannasseoyo.",
        "ar": "التقينا بفضل رابط طيب.",
        "cs": "Seznámili jsme se díky hezké náhodě.",
        "da": "Vi mødtes gennem en god forbindelse.",
        "de": "Wir haben uns durch eine gute Verbindung kennengelernt.",
        "el": "Γνωριστήκαμε χάρη σε μια καλή συγκυρία.",
        "es": "Nos conocimos gracias a una buena conexión.",
        "fi": "Tutustuimme hyvän sattuman kautta.",
        "fr": "Nous nous sommes rencontrés grâce à un beau hasard.",
        "he": "נפגשנו בזכות קשר טוב.",
        "hi": "हम एक अच्छे संबंध के कारण मिले।",
        "hu": "Egy jó kapcsolat révén találkoztunk.",
        "id": "Kami bertemu karena hubungan yang baik.",
        "it": "Ci siamo conosciuti grazie a un bel legame.",
        "ja": "私たちはいい縁で出会いました。",
        "nb": "Vi møttes gjennom en god forbindelse.",
        "nl": "We hebben elkaar via een goede band ontmoet.",
        "pl": "Spotkaliśmy się dzięki dobrej znajomości.",
        "pt": "Nós nos conhecemos por um bom vínculo.",
        "ro": "Ne-am cunoscut printr-o legătură bună.",
        "ru": "Мы познакомились благодаря хорошей связи.",
        "sv": "Vi träffades genom en bra kontakt.",
        "tr": "İyi bir bağ sayesinde tanıştık.",
        "uk": "Ми познайомилися завдяки гарному зв’язку.",
        "vi": "Chúng tôi gặp nhau nhờ một mối duyên tốt.",
        "yue": "我哋因為好嘅緣分而相遇。",
        "zh-Hans": "我们因为一段好缘分而相遇。"
      },
