    {
      "target": "그건 제 운에 맡길게요.",
      "reading": "Geugeon je un-e matgilleoyo.",
      "translations": {
        "en": "I'll leave that to luck.",
        "ko": "그건 제 운에 맡길게요.",
        "ipa": "Geugeon je un-e matgilleoyo.",
        "ar": "سأترك ذلك للحظ.",
        "cs": "To nechám na osudu.",
        "da": "Det vil jeg overlade til skæbnen.",
        "de": "Das überlasse ich dem Glück.",
        "el": "Θα το αφήσω στην τύχη.",
        "es": "Se lo dejaré a la suerte.",
        "fi": "Jätän sen kohtalon varaan.",
        "fr": "Je laisserai ça au hasard.",
        "he": "אני אשאיר את זה למזל.",
        "hi": "मैं यह किस्मत पर छोड़ दूँगा।",
        "hu": "Ezt a szerencsére bízom.",
        "id": "Saya serahkan itu pada keberuntungan.",
        "it": "Lo lascerò al caso.",
        "ja": "それは運に任せます。",
        "nb": "Det overlater jeg til tilfeldighetene.",
        "nl": "Dat laat ik aan het geluk over.",
        "pl": "Zostawię to szczęściu.",
        "pt": "Vou deixar isso por conta da sorte.",
        "ro": "Las asta în seama norocului.",
        "ru": "Я оставлю это на волю случая.",
        "sv": "Det lämnar jag åt slumpen.",
        "tr": "Bunu şansa bırakacağım.",
        "uk": "Я залишу це на волю випадку.",
        "vi": "Tôi sẽ để chuyện đó cho may rủi.",
        "yue": "嗰件事我交俾運氣決定。",
        "zh-Hans": "我把那件事交给运气吧。"
      },
