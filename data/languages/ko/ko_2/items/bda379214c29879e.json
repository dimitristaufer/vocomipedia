  "sentences": [
    {
      "target": "그 버스는 10분 뒤에 도착할 거예요. 확실해요.",
      "reading": "geu beoseuneun sipbun dwie dochakal geoyeyo. hwaksilhaeyo.",
      "translations": {
        "en": "The bus will arrive in 10 minutes. I'm sure.",
        "ko": "그 버스는 10분 뒤에 도착할 거예요. 확실해요.",
        "ipa": "geu beoseuneun sipbun dwie dochakal geoyeyo. hwaksilhaeyo.",
        "ar": "ستصل الحافلة بعد عشر دقائق. أنا متأكد.",
        "cs": "Ten autobus přijede za 10 minut. Jsem si jistý.",
        "da": "Bussen kommer om 10 minutter. Det er jeg sikker på.",
        "de": "Der Bus kommt in 10 Minuten. Da bin ich mir sicher.",
        "el": "Το λεωφορείο θα φτάσει σε 10 λεπτά. Είμαι σίγουρος.",
        "es": "El autobús llegará en 10 minutos. Estoy seguro.",
        "fi": "Bussi saapuu 10 minuutin päästä. Olen varma.",
        "fr": "Le bus arrivera dans 10 minutes. J'en suis sûr.",
        "he": "האוטובוס יגיע בעוד עשר דקות. אני בטוח.",
        "hi": "बस 10 मिनट में आ जाएगी। मुझे यकीन है।",
        "hu": "A busz 10 perc múlva érkezik. Biztos vagyok benne.",
        "id": "Bus itu akan tiba dalam 10 menit. Aku yakin.",
        "it": "L'autobus arriverà tra 10 minuti. Ne sono sicuro.",
        "ja": "そのバスは10分後に到着します。間違いありません。",
        "nb": "Bussen kommer om 10 minutter. Jeg er sikker.",
        "nl": "De bus komt over 10 minuten. Ik weet het zeker.",
        "pl": "Autobus przyjedzie za 10 minut. Jestem pewien.",
        "pt": "O ônibus vai chegar em 10 minutos. Tenho certeza.",
        "ro": "Autobuzul va sosi peste 10 minute. Sunt sigur.",
        "ru": "Автобус приедет через 10 минут. Я уверен.",
        "sv": "Bussen kommer om 10 minuter. Jag är säker.",
        "tr": "Otobüs 10 dakika sonra gelecek. Eminim.",
        "uk": "Автобус приїде за 10 хвилин. Я впевнений.",
        "vi": "Xe buýt sẽ đến sau 10 phút nữa. Tôi chắc chắn.",
        "yue": "架巴士十分钟后会到。我肯定。",
        "zh-Hans": "公交车10分钟后会到。我肯定。"
      },
