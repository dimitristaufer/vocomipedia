  "sentences": [
    {
      "target": "이번에는 제가 좀 손해를 봤어요.",
      "reading": "ibeoneneun jega jom sonhaereul bwasseoyo.",
      "translations": {
        "en": "This time, I ended up losing out a little.",
        "ko": "이번에는 제가 좀 손해를 봤어요.",
        "ipa": "ibeoneneun jega jom sonhaereul bwasseoyo.",
        "ar": "هذه المرة خسرت قليلًا.",
        "cs": "Tentokrát jsem na tom byl trochu tratný.",
        "da": "Denne gang kom jeg lidt i underskud.",
        "de": "Diesmal hatte ich einen kleinen Nachteil.",
        "el": "Αυτή τη φορά έβγαλα λίγο τη χασούρα.",
        "es": "Esta vez salí perdiendo un poco.",
        "fi": "Tällä kertaa jäin vähän tappiolle.",
        "fr": "Cette fois, j’y ai perdu un peu.",
        "he": "הפעם יצאתי קצת בהפסד.",
        "hi": "इस बार मुझे थोड़ा नुकसान हुआ।",
        "hu": "Ezúttal kicsit ráfizettem.",
        "id": "Kali ini saya agak rugi.",
        "it": "Questa volta ci ho perso un po'.",
        "ja": "今回は少し損をしました。",
        "nb": "Denne gangen tapte jeg litt på det.",
        "nl": "Deze keer zat ik een beetje in het nadeel.",
        "pl": "Tym razem trochę na tym straciłem.",
        "pt": "Desta vez, saí perdendo um pouco.",
        "ro": "De data asta am ieșit puțin în pierdere.",
        "ru": "На этот раз я немного проиграл.",
        "sv": "Den här gången gick jag lite back.",
        "tr": "Bu sefer biraz zarardaydım.",
        "uk": "Цього разу я трохи втратив.",
        "vi": "Lần này tôi bị thiệt một chút.",
        "yue": "今次我蝕咗少少。",
        "zh-Hans": "这次我有点吃亏。"
      },
