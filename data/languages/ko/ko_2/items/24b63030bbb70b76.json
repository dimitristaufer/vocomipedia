  "sentences": [
    {
      "target": "그녀는 상류 사회에 들어가고 싶어 해요.",
      "reading": "geunyeoneun sangryu sahoe-e deureogago sipeo haeyo.",
      "translations": {
        "en": "She wants to enter upper-class society.",
        "ko": "그녀는 상류 사회에 들어가고 싶어 해요.",
        "ipa": "geunyeoneun sangryu sahoe-e deureogago sipeo haeyo.",
        "ar": "هي تريد أن تدخل المجتمع الراقي.",
        "cs": "Chce vstoupit do vyšší společnosti.",
        "da": "Hun vil gerne ind i det fine selskab.",
        "de": "Sie möchte in die feine Gesellschaft aufgenommen werden.",
        "el": "Θέλει να μπει στην ανώτερη κοινωνία.",
        "es": "Ella quiere entrar en la alta sociedad.",
        "fi": "Hän haluaa päästä seurapiireihin.",
        "fr": "Elle veut entrer dans la haute société.",
        "he": "היא רוצה להיכנס לחברה הגבוהה.",
        "hi": "वह उच्च समाज में जाना चाहती है।",
        "hu": "Be akar kerülni a felső tízezerbe.",
        "id": "Dia ingin masuk ke kalangan atas.",
        "it": "Vuole entrare nell'alta società.",
        "ja": "彼女は上流社会に入りたがっています。",
        "nb": "Hun vil inn i det fine selskap.",
        "nl": "Ze wil graag tot de hogere kringen behoren.",
        "pl": "Chce wejść do wyższych sfer.",
        "pt": "Ela quer entrar na alta sociedade.",
        "ro": "Vrea să intre în lumea bună.",
        "ru": "Она хочет попасть в высшее общество.",
        "sv": "Hon vill komma in i de fina kretsarna.",
        "tr": "O, üst sınıf topluma girmek istiyor.",
        "uk": "Вона хоче ввійти у вищі кола.",
        "vi": "Cô ấy muốn gia nhập giới thượng lưu.",
        "yue": "佢想打入上流社會。",
        "zh-Hans": "她想进入上流社会。"
      },
