  "sentences": [
    {
      "target": "우리 반에서는 민주주의를 배워요.",
      "reading": "uri baneseoneun minjujuuireul baewoyo.",
      "translations": {
        "en": "We learn about democracy in our class.",
        "ko": "우리 반에서는 민주주의를 배워요.",
        "ipa": "uri baneseoneun minjujuuireul baewoyo.",
        "ar": "نتعلم عن الديمقراطية في صفنا.",
        "cs": "V naší třídě se učíme o demokracii.",
        "da": "Vi lærer om demokrati i vores klasse.",
        "de": "Wir lernen im Unterricht etwas über Demokratie.",
        "el": "Στην τάξη μας μαθαίνουμε για τη δημοκρατία.",
        "es": "Aprendemos sobre la democracia en nuestra clase.",
        "fi": "Opimme demokratiasta luokassamme.",
        "fr": "Nous apprenons la démocratie en classe.",
        "he": "אנחנו לומדים על דמוקרטיה בכיתה שלנו.",
        "hi": "हम अपनी कक्षा में लोकतंत्र के बारे में सीखते हैं।",
        "hu": "Az osztályunkban demokráciáról tanulunk.",
        "id": "Kami belajar tentang demokrasi di kelas kami.",
        "it": "Impariamo la democrazia in classe.",
        "ja": "私たちのクラスでは民主主義について学びます。",
        "nb": "Vi lærer om demokrati i klassen vår.",
        "nl": "We leren over democratie in onze klas.",
        "pl": "Uczymy się o demokracji na naszej lekcji.",
        "pt": "Aprendemos sobre democracia na nossa turma.",
        "ro": "Învățăm despre democrație la clasă.",
        "ru": "Мы изучаем демократию в нашем классе.",
        "sv": "Vi lär oss om demokrati i vår klass.",
        "tr": "Sınıfımızda demokrasi hakkında öğreniyoruz.",
        "uk": "Ми вивчаємо демократію в нашому класі.",
        "vi": "Chúng tôi học về dân chủ trong lớp học của mình.",
        "yue": "我哋喺班房學民主。",
        "zh-Hans": "我们在班上学习民主。"
      },
