  "sentences": [
    {
      "target": "우리 작은아들은 오늘 집에서 저녁을 먹었어요.",
      "reading": "우리 자근아들은 오늘 지베서 저녀글 머거써요.",
      "translations": {
        "en": "Our younger son ate dinner at home today.",
        "ko": "우리 작은아들은 오늘 집에서 저녁을 먹었어요.",
        "ipa": "우리 자근아들은 오늘 지베서 저녀글 머거써요.",
        "ar": "تناول ابننا الأصغر العشاء في البيت اليوم.",
        "cs": "Náš mladší syn dnes večeřel doma.",
        "da": "Vores yngste søn spiste aftensmad hjemme i dag.",
        "de": "Unser jüngerer Sohn hat heute zu Hause zu Abend gegessen.",
        "el": "Ο μικρότερος γιος μας έφαγε απόψε στο σπίτι.",
        "es": "Nuestro hijo menor cenó en casa hoy.",
        "fi": "Nuorempi poikamme söi tänään illallista kotona.",
        "fr": "Notre fils cadet a dîné à la maison aujourd'hui.",
        "he": "הבן הצעיר שלנו אכל ארוחת ערב בבית היום.",
        "hi": "हमारे छोटे बेटे ने आज घर पर रात का खाना खाया।",
        "hu": "A kisebbik fiunk ma otthon vacsorázott.",
        "id": "Anak laki-laki kami yang lebih kecil makan malam di rumah hari ini.",
        "it": "Il nostro figlio minore ha cenato a casa oggi.",
        "ja": "うちの下の息子は今日、家で夕食を食べました。",
        "nb": "Den yngste sønnen vår spiste middag hjemme i dag.",
        "nl": "Onze jongste zoon heeft vandaag thuis gegeten.",
        "pl": "Nasz młodszy syn jadł dziś kolację w domu.",
        "pt": "Nosso filho mais novo jantou em casa hoje.",
        "ro": "Fiul nostru mai mic a cinat azi acasă.",
        "ru": "Наш младший сын сегодня ужинал дома.",
        "sv": "Vår yngre son åt middag hemma i dag.",
        "tr": "Küçük oğlumuz bugün evde akşam yemeği yedi.",
        "uk": "Наш молодший син сьогодні вечеряв удома.",
        "vi": "Con trai út của chúng tôi đã ăn tối ở nhà hôm nay.",
        "yue": "我哋細仔今日喺屋企食咗晚飯。",
        "zh-Hans": "我们的小儿子今天在家吃了晚饭。"
      },
