  "sentences": [
    {
      "target": "엄마가 찻잔에 따뜻한 차를 따라 줬어요.",
      "reading": "eommaga chatjane ttatteushan chareul ttara jwosseoyo",
      "translations": {
        "en": "Mom poured warm tea into the teacup.",
        "ko": "엄마가 찻잔에 따뜻한 차를 따라 줬어요.",
        "ipa": "eommaga chatjane ttatteushan chareul ttara jwosseoyo",
        "ar": "سكبت الأم شايًا دافئًا في فنجان الشاي.",
        "cs": "Maminka nalila do čajového šálku teplý čaj.",
        "da": "Mor hældte varm te op i tekoppen.",
        "de": "Mama goss warmen Tee in die Teetasse.",
        "el": "Η μαμά έριξε ζεστό τσάι στο φλιτζάνι.",
        "es": "Mamá sirvió té caliente en la taza de té.",
        "fi": "Äiti kaatoi lämmintä teetä teekuppiin.",
        "fr": "Maman a versé du thé chaud dans la tasse à thé.",
        "he": "אמא מזגה תה חם לתוך כוס התה.",
        "hi": "माँ ने चाय के प्याले में गरम चाय डाली।",
        "hu": "Anya meleg teát öntött a teáscsészébe.",
        "id": "Ibu menuangkan teh hangat ke dalam cangkir teh.",
        "it": "La mamma ha versato del tè caldo nella tazza da tè.",
        "ja": "お母さんが湯のみ茶わんに温かいお茶を注いでくれました。",
        "nb": "Mamma helte varm te i tekoppen.",
        "nl": "Mama schonk warme thee in het theekopje.",
        "pl": "Mama nalała ciepłą herbatę do filiżanki.",
        "pt": "A mãe serviu chá quente na xícara de chá.",
        "ro": "Mama a turnat ceai cald în ceașca de ceai.",
        "ru": "Мама налила тёплый чай в чайную чашку.",
        "sv": "Mamma hällde varmt te i tekoppen.",
        "tr": "Anne sıcak çayı çay fincanına döktü.",
        "uk": "Мама налила теплий чай у чашку для чаю.",
        "vi": "Mẹ rót trà nóng vào tách trà.",
        "yue": "阿媽將熱茶倒入茶杯。",
        "zh-Hans": "妈妈把热茶倒进茶杯里。"
      },
