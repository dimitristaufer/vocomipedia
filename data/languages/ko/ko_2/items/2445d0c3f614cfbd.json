  "sentences": [
    {
      "target": "민수는 혼잣말을 하며 방을 정리했어요.",
      "reading": "minsuneun honjasmareul hamyeo bangeul jeongrihaesseoyo.",
      "translations": {
        "en": "Min-su tidied the room while talking to himself.",
        "ko": "민수는 혼잣말을 하며 방을 정리했어요.",
        "ipa": "minsuneun honjasmareul hamyeo bangeul jeongrihaesseoyo.",
        "ar": "رتّب مينسو الغرفة وهو يحدّث نفسه.",
        "cs": "Min-su uklízel pokoj a přitom si pro sebe povídal.",
        "da": "Min-su ryddede værelset, mens han talte med sig selv.",
        "de": "Min-su räumte das Zimmer auf und redete dabei mit sich selbst.",
        "el": "Ο Μιν-σου τακτοποιούσε το δωμάτιο μιλώντας μόνος του.",
        "es": "Min-su ordenó la habitación mientras hablaba solo.",
        "fi": "Min-su siivosi huonetta puhuen itsekseen.",
        "fr": "Min-su a rangé la chambre en se parlant à lui-même.",
        "he": "민수 סידר את החדר תוך כדי דיבור לעצמו.",
        "hi": "मिन-सु अपने-आप से बात करते हुए कमरा साफ़ कर रहा था।",
        "hu": "Min-su úgy pakolta rendbe a szobát, hogy közben magában beszélt.",
        "id": "Min-su merapikan kamar sambil berbicara sendiri.",
        "it": "Min-su ha riordinato la stanza parlando da solo.",
        "ja": "ミンスは独り言を言いながら部屋を片づけました。",
        "nb": "Min-su ryddet rommet mens han snakket med seg selv.",
        "nl": "Min-su ruimde de kamer op terwijl hij tegen zichzelf praatte.",
        "pl": "Min-su sprzątał pokój, mówiąc do siebie.",
        "pt": "Min-su arrumou o quarto falando sozinho.",
        "ro": "Min-su a aranjat camera vorbind singur.",
        "ru": "Минсу прибирал комнату, разговаривая сам с собой.",
        "sv": "Min-su städade rummet medan han pratade med sig själv.",
        "tr": "Min-su kendi kendine konuşarak odayı topladı.",
        "uk": "Мінсу прибирав кімнату, розмовляючи сам із собою.",
        "vi": "Min-su dọn phòng vừa lẩm bẩm một mình.",
        "yue": "民洙一邊自言自語，一邊執房。",
        "zh-Hans": "敏洙一边自言自语，一边整理房间。"
      },
