    {
      "target": "도착하면 연락해 주세요.",
      "reading": "dochakhamyeon yeonrakhae juseyo.",
      "translations": {
        "en": "Please contact me when you arrive.",
        "ko": "도착하면 연락해 주세요.",
        "ipa": "dochakhamyeon yeonrakhae juseyo.",
        "ar": "اتصل بي عندما تصل، من فضلك.",
        "cs": "Ozvěte se mi, až dorazíte.",
        "da": "Kontakt mig, når du er fremme.",
        "de": "Melden Sie sich bitte, wenn Sie ankommen.",
        "el": "Επικοινωνήστε μαζί μου όταν φτάσετε, παρακαλώ.",
        "es": "Contáctame cuando llegues, por favor.",
        "fi": "Ota minuun yhteyttä, kun saavut.",
        "fr": "Contactez-moi quand vous arrivez, s'il vous plaît.",
        "he": "תתקשר אליי כשתגיע, בבקשה.",
        "hi": "जब आप पहुँचें, तो मुझे संपर्क करें।",
        "hu": "Kérlek, jelentkezz, ha megérkeztél.",
        "id": "Hubungi saya saat Anda tiba.",
        "it": "Contattami quando arrivi, per favore.",
        "ja": "着いたら連絡してください。",
        "nb": "Ta kontakt når du kommer fram.",
        "nl": "Neem contact met me op als je aankomt.",
        "pl": "Skontaktuj się ze mną, gdy dotrzesz.",
        "pt": "Entre em contato comigo quando você chegar, por favor.",
        "ro": "Contactează-mă când ajungi, te rog.",
        "ru": "Свяжитесь со мной, когда приедете.",
        "sv": "Hör av dig när du kommer fram.",
        "tr": "Varınca bana haber ver lütfen.",
        "uk": "Напишіть мені, коли приїдете, будь ласка.",
        "vi": "Hãy liên lạc với tôi khi bạn đến nhé.",
        "yue": "你到咗之後請聯絡我。",
        "zh-Hans": "你到了以后请联系我。"
      },
