    {
      "target": "선생님이 숙제를 하나씩 살펴봐요.",
      "reading": "seonsaengnimi sukjereul hanassik salpyeobwayo.",
      "translations": {
        "en": "The teacher checks each homework assignment one by one.",
        "ko": "선생님이 숙제를 하나씩 살펴봐요.",
        "ipa": "seonsaengnimi sukjereul hanassik salpyeobwayo.",
        "ar": "يفحص المعلم الواجبات المنزلية واحدًا واحدًا.",
        "cs": "Učitel kontroluje každý domácí úkol jeden po druhém.",
        "da": "Læreren gennemgår hver lektie én for én.",
        "de": "Der Lehrer schaut sich jede Hausaufgabe einzeln an.",
        "el": "Ο δάσκαλος ελέγχει κάθε εργασία μία μία.",
        "es": "El profesor revisa cada tarea una por una.",
        "fi": "Opettaja tarkistaa jokaisen läksyn yksi kerrallaan.",
        "fr": "Le professeur vérifie chaque devoir un par un.",
        "he": "המורה בודק כל מטלה אחת אחת.",
        "hi": "शिक्षक एक-एक करके हर होमवर्क जाँचता है।",
        "hu": "A tanár egyenként átnézi a házi feladatokat.",
        "id": "Guru memeriksa setiap pekerjaan rumah satu per satu.",
        "it": "L'insegnante controlla ogni compito uno per uno.",
        "ja": "先生は宿題を一つずつ確認します。",
        "nb": "Læreren går gjennom hver lekse én etter én.",
        "nl": "De leraar bekijkt elk huiswerk één voor één.",
        "pl": "Nauczyciel sprawdza każdą pracę domową po kolei.",
        "pt": "O professor confere cada lição de casa uma por uma.",
        "ro": "Profesorul verifică fiecare temă, una câte una.",
        "ru": "Учитель проверяет каждое домашнее задание по одному.",
        "sv": "Läraren går igenom varje läxa en i taget.",
        "tr": "Öğretmen her ödevi tek tek kontrol ediyor.",
        "uk": "Учитель перевіряє кожне домашнє завдання по одному.",
        "vi": "Giáo viên kiểm tra từng bài tập một.",
        "yue": "老師逐份檢查功課。",
        "zh-Hans": "老师逐一检查每份作业。"
      },
