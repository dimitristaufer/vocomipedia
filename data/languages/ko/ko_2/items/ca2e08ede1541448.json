  "sentences": [
    {
      "target": "어쩌다 그 친구를 역에서 만났어요.",
      "reading": "eojjeoda geu chingureul yeokeseo mannasseoyo.",
      "translations": {
        "en": "I ran into that friend at the station by chance.",
        "ko": "어쩌다 그 친구를 역에서 만났어요.",
        "ipa": "eojjeoda geu chingureul yeokeseo mannasseoyo.",
        "ar": "صادفت ذلك الصديق في المحطة بالصدفة.",
        "cs": "Toho kamaráda jsem náhodou potkal na nádraží.",
        "da": "Jeg mødte den ven på stationen tilfældigt.",
        "de": "Ich bin diesem Freund zufällig am Bahnhof begegnet.",
        "el": "Συνάντησα εκείνον τον φίλο στον σταθμό τυχαία.",
        "es": "Me encontré con ese amigo en la estación por casualidad.",
        "fi": "Tapasin sen ystävän sattumalta asemalla.",
        "fr": "J'ai croisé cet ami à la gare par hasard.",
        "he": "פגשתי את החבר הזה בתחנה במקרה.",
        "hi": "मैं उस दोस्त से स्टेशन पर संयोग से मिला।",
        "hu": "Véletlenül találkoztam azzal a barátommal az állomáson.",
        "id": "Aku tak sengaja bertemu teman itu di stasiun.",
        "it": "Ho incontrato quell'amico alla stazione per caso.",
        "ja": "駅でその友だちにたまたま会いました。",
        "nb": "Jeg møtte den vennen på stasjonen ved en tilfeldighet.",
        "nl": "Ik kwam die vriend toevallig tegen op het station.",
        "pl": "Spotkałem tego kolegę na dworcu przypadkiem.",
        "pt": "Encontrei esse amigo na estação por acaso.",
        "ro": "M-am întâlnit întâmplător cu prietenul acela la gară.",
        "ru": "Я случайно встретил того друга на станции.",
        "sv": "Jag sprang på den vännen på stationen av en slump.",
        "tr": "O arkadaşa istasyonda tesadüfen rastladım.",
        "uk": "Я випадково зустрів того друга на станції.",
        "vi": "Tôi tình cờ gặp người bạn đó ở nhà ga.",
        "yue": "我喺車站撞到嗰個朋友，純屬巧合。",
        "zh-Hans": "我在车站偶然遇到了那个朋友。"
      },
