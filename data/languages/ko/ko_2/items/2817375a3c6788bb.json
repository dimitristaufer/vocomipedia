  "sentences": [
    {
      "target": "어젯밤에 재미있는 꿈을 꿨어요.",
      "reading": "eojetbame jaemiinneun kkumeul kkwosseoyo.",
      "translations": {
        "en": "I had an interesting dream last night.",
        "ko": "어젯밤에 재미있는 꿈을 꿨어요.",
        "ipa": "eojetbame jaemiinneun kkumeul kkwosseoyo.",
        "ar": "حلمتُ بحلمٍ ممتعٍ الليلة الماضية.",
        "cs": "Včera v noci se mi zdál zajímavý sen.",
        "da": "Jeg drømte en interessant drøm i går aftes.",
        "de": "Ich habe letzte Nacht einen interessanten Traum gehabt.",
        "el": "Είδα ένα ενδιαφέρον όνειρο χθες το βράδυ.",
        "es": "Anoche tuve un sueño interesante.",
        "fi": "Näin viime yönä mielenkiintoisen unen.",
        "fr": "J’ai fait un rêve intéressant la nuit dernière.",
        "he": "חלמתי חלום מעניין אתמול בלילה.",
        "hi": "मैंने कल रात एक दिलचस्प सपना देखा।",
        "hu": "Tegnap éjjel egy érdekes álmom volt.",
        "id": "Saya bermimpi menarik semalam.",
        "it": "Stanotte ho fatto un sogno interessante.",
        "ja": "昨夜、面白い夢を見ました。",
        "nb": "Jeg drømte en interessant drøm i går natt.",
        "nl": "Ik had vannacht een interessante droom.",
        "pl": "Śnił mi się zeszłej nocy ciekawy sen.",
        "pt": "Sonhei um sonho interessante na noite passada.",
        "ro": "Am visat un vis interesant aseară.",
        "ru": "Мне прошлой ночью приснился интересный сон.",
        "sv": "Jag drömde en intressant dröm i går kväll.",
        "tr": "Dün gece ilginç bir rüya gördüm.",
        "uk": "Мені минулої ночі наснився цікавий сон.",
        "vi": "Đêm qua tôi đã mơ một giấc mơ thú vị.",
        "yue": "噚晚我發咗個幾有趣嘅夢。",
        "zh-Hans": "我昨晚做了一个有趣的梦。"
      },
