  "sentences": [
    {
      "target": "비가 올 걸 내다보고 우산을 챙겼어요.",
      "reading": "bi-ga ol geol naedabogo usaneul chaenggyeosseoyo.",
      "translations": {
        "en": "I expected rain and brought an umbrella.",
        "ko": "비가 올 걸 내다보고 우산을 챙겼어요.",
        "ipa": "bi-ga ol geol naedabogo usaneul chaenggyeosseoyo.",
        "ar": "توقعتُ هطول المطر وأخذتُ مظلة.",
        "cs": "Očekával jsem déšť, a vzal jsem si deštník.",
        "da": "Jeg regnede med regn og tog en paraply med.",
        "de": "Ich habe mit Regen gerechnet und einen Regenschirm mitgenommen.",
        "el": "Περίμενα βροχή και πήρα μαζί μου μια ομπρέλα.",
        "es": "Esperaba lluvia y llevé un paraguas.",
        "fi": "Odotin sadetta ja otin sateenvarjon mukaan.",
        "fr": "Je m’attendais à la pluie et j’ai pris un parapluie.",
        "he": "ציפיתי לגשם ולקחתי מטרייה.",
        "hi": "मुझे बारिश की उम्मीद थी, इसलिए मैं छाता ले आया।",
        "hu": "Esőre számítottam, és vittem magammal egy esernyőt.",
        "id": "Saya memperkirakan akan hujan dan membawa payung.",
        "it": "Mi aspettavo la pioggia e ho preso l’ombrello.",
        "ja": "雨が降ると思って、傘を持っていきました。",
        "nb": "Jeg regnet med regn og tok med paraply.",
        "nl": "Ik hield rekening met regen en nam een paraplu mee.",
        "pl": "Spodziewałem się deszczu i wziąłem parasol.",
        "pt": "Eu esperava chuva e levei um guarda-chuva.",
        "ro": "Mă așteptam la ploaie și am luat o umbrelă.",
        "ru": "Я ожидал дождя и взял зонтик.",
        "sv": "Jag räknade med regn och tog med ett paraply.",
        "tr": "Yağmur bekliyordum ve bir şemsiye aldım.",
        "uk": "Я очікував дощу й узяв парасольку.",
        "vi": "Tôi đoán trời sẽ mưa nên đã mang ô.",
        "yue": "我估到會落雨，所以帶咗把遮。",
        "zh-Hans": "我预料会下雨，所以带了把伞。"
      },
