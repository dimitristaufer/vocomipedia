  "sentences": [
    {
      "target": "회의에서 논쟁이 시작됐어요.",
      "reading": "hoeuieseo nonjaeng-i sijak-dwaesseoyo.",
      "translations": {
        "en": "A controversy started at the meeting.",
        "ko": "회의에서 논쟁이 시작됐어요.",
        "ipa": "hoeuieseo nonjaeng-i sijak-dwaesseoyo.",
        "ar": "بدأ الجدل في الاجتماع.",
        "cs": "Na schůzi začala hádka.",
        "da": "Der opstod en kontrovers på mødet.",
        "de": "Bei dem Treffen entstand eine Kontroverse.",
        "el": "Στη συνάντηση ξέσπασε μια διαμάχη.",
        "es": "Empezó una controversia en la reunión.",
        "fi": "Kokouksessa alkoi kiista.",
        "fr": "Une controverse a commencé pendant la réunion.",
        "he": "בפגישה התחיל ויכוח.",
        "hi": "बैठक में विवाद शुरू हो गया।",
        "hu": "A megbeszélésen vita kezdődött.",
        "id": "Kontroversi mulai di rapat itu.",
        "it": "In riunione è scoppiata una controversia.",
        "ja": "会議で論争が始まりました。",
        "nb": "Det oppstod en kontrovers i møtet.",
        "nl": "Tijdens de vergadering ontstond er een controverse.",
        "pl": "Na spotkaniu wybuchła kontrowersja.",
        "pt": "Começou uma controvérsia na reunião.",
        "ro": "A început o controversă la ședință.",
        "ru": "На собрании начался спор.",
        "sv": "Det uppstod en kontrovers på mötet.",
        "tr": "Toplantıda bir tartışma başladı.",
        "uk": "На зустрічі почалася суперечка.",
        "vi": "Cuộc họp đã nổ ra tranh cãi.",
        "yue": "會議上開始咗爭論。",
        "zh-Hans": "会议上开始了争论。"
      },
