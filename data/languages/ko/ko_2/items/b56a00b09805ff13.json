    {
      "target": "동부 해안에서 일출을 봤어요.",
      "reading": "Dongbu haeaneseo ilsureul bwasseoyo.",
      "translations": {
        "en": "I watched the sunrise on the east coast.",
        "ko": "동부 해안에서 일출을 봤어요.",
        "ipa": "Dongbu haeaneseo ilsureul bwasseoyo.",
        "ar": "شاهدت شروق الشمس على الساحل الشرقي.",
        "cs": "Sledoval jsem východ slunce na východním pobřeží.",
        "da": "Jeg så solopgangen på østkysten.",
        "de": "Ich habe den Sonnenaufgang an der Ostküste gesehen.",
        "el": "Είδα την ανατολή του ήλιου στην ανατολική ακτή.",
        "es": "Vi el amanecer en la costa este.",
        "fi": "Katselin auringonnousua itärannikolla.",
        "fr": "J’ai vu le lever du soleil sur la côte est.",
        "he": "צפיתי בזריחה בחוף המזרחי.",
        "hi": "मैंने पूर्वी तट पर सूर्योदय देखा।",
        "hu": "Megnéztem a napfelkeltét a keleti parton.",
        "id": "Saya melihat matahari terbit di pantai timur.",
        "it": "Ho visto l'alba sulla costa est.",
        "ja": "東海岸で日の出を見ました。",
        "nb": "Jeg så soloppgangen på østkysten.",
        "nl": "Ik heb de zonsopgang aan de oostkust gezien.",
        "pl": "Oglądałem wschód słońca na wschodnim wybrzeżu.",
        "pt": "Vi o nascer do sol na costa leste.",
        "ro": "Am privit răsăritul pe coasta de est.",
        "ru": "Я смотрел восход солнца на восточном побережье.",
        "sv": "Jag såg soluppgången på östkusten.",
        "tr": "Gün doğumunu doğu kıyısında izledim.",
        "uk": "Я дивився схід сонця на східному узбережжі.",
        "vi": "Tôi đã ngắm bình minh ở bờ biển phía đông.",
        "yue": "我喺東海岸睇咗日出。",
        "zh-Hans": "我在东海岸看了日出。"
      },
