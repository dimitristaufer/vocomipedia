    {
      "target": "교실 안에 야단이 났어요.",
      "reading": "gyosil ane yadan-i nasseoyo.",
      "translations": {
        "en": "There was an uproar in the classroom.",
        "ko": "교실 안에 야단이 났어요.",
        "ipa": "gyosil ane yadan-i nasseoyo.",
        "ar": "كان هناك ضجة في الفصل.",
        "cs": "Ve třídě byl rozruch.",
        "da": "Der var ståhej i klasselokalet.",
        "de": "Im Klassenzimmer war viel Aufruhr.",
        "el": "Έγινε αναστάτωση στην τάξη.",
        "es": "Hubo alboroto en el aula.",
        "fi": "Luokassa oli hälinää.",
        "fr": "Il y avait du remue-ménage dans la classe.",
        "he": "היה בלגן בכיתה.",
        "hi": "कक्षा में हंगामा हो गया।",
        "hu": "Az osztályban nagy volt a felfordulás.",
        "id": "Ada keributan di kelas.",
        "it": "In classe c'era confusione.",
        "ja": "教室は大騒ぎでした。",
        "nb": "Det var oppstyr i klasserommet.",
        "nl": "Er was opschudding in het klaslokaal.",
        "pl": "W klasie był rwetes.",
        "pt": "Houve alvoroço na sala de aula.",
        "ro": "A fost agitație în clasă.",
        "ru": "В классе был шум и гам.",
        "sv": "Det var ett liv i klassrummet.",
        "tr": "Sınıfta kıyamet koptu.",
        "uk": "У класі був галас.",
        "vi": "Lớp học rất ồn ào.",
        "yue": "課室裡好嘈吵。",
        "zh-Hans": "教室里一片喧闹。"
      },
