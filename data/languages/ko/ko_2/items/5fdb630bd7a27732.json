  "sentences": [
    {
      "target": "전기줄이 눈 때문에 잘렸어요.",
      "reading": "Jeongijuri nun ttaemune jallyeosseoyo.",
      "translations": {
        "en": "The power line snapped because of the snow.",
        "ko": "전기줄이 눈 때문에 잘렸어요.",
        "ipa": "Jeongijuri nun ttaemune jallyeosseoyo.",
        "ar": "انقطع سلك الكهرباء بسبب الثلج.",
        "cs": "Elektrické vedení se přetrhlo kvůli sněhu.",
        "da": "Strømkablet knækkede på grund af sneen.",
        "de": "Die Stromleitung ist wegen des Schnees gerissen.",
        "el": "Το καλώδιο ρεύματος κόπηκε λόγω του χιονιού.",
        "es": "El cable de la luz se rompió por la nieve.",
        "fi": "Sähköjohto katkesi lumen takia.",
        "fr": "Le câble électrique s'est rompu à cause de la neige.",
        "he": "קו החשמל נקרע בגלל השלג.",
        "hi": "बर्फ की वजह से बिजली की तार टूट गई।",
        "hu": "A villanyvezeték elszakadt a hó miatt.",
        "id": "Kabel listrik putus karena salju.",
        "it": "Il cavo della corrente si è spezzato a causa della neve.",
        "ja": "雪のせいで電線が切れました。",
        "nb": "Strømkabelen røk på grunn av snøen.",
        "nl": "De elektriciteitskabel is door de sneeuw geknapt.",
        "pl": "Przewód elektryczny pękł z powodu śniegu.",
        "pt": "O cabo de energia arrebentou por causa da neve.",
        "ro": "Cablul de curent s-a rupt din cauza zăpezii.",
        "ru": "Электропровод оборвался из-за снега.",
        "sv": "Elkabeln gick av på grund av snön.",
        "tr": "Elektrik teli kar yüzünden koptu.",
        "uk": "Електричний дріт обірвався через сніг.",
        "vi": "Dây điện bị đứt vì tuyết.",
        "yue": "電線因為落雪而斷咗。",
        "zh-Hans": "电线因为下雪断了。"
      },
