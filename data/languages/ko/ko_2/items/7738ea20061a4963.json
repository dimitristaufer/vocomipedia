  "sentences": [
    {
      "target": "저는 오늘부터 매일 운동하기로 결심했어요.",
      "reading": "jeoneun oneulbuteo maeil undonghagiro gyeolsimhaesseoyo.",
      "translations": {
        "en": "I decided to exercise every day starting today.",
        "ko": "저는 오늘부터 매일 운동하기로 결심했어요.",
        "ipa": "jeoneun oneulbuteo maeil undonghagiro gyeolsimhaesseoyo.",
        "ar": "قررت أن أمارس الرياضة كل يوم ابتداءً من اليوم.",
        "cs": "Rozhodl jsem se cvičit každý den od dneška.",
        "da": "Jeg besluttede at træne hver dag fra i dag.",
        "de": "Ich habe beschlossen, ab heute jeden Tag Sport zu machen.",
        "el": "Αποφάσισα να γυμνάζομαι κάθε μέρα από σήμερα.",
        "es": "Decidí hacer ejercicio todos los días desde hoy.",
        "fi": "Päätin alkaa liikkua joka päivä tästä päivästä lähtien.",
        "fr": "J'ai décidé de faire de l'exercice tous les jours à partir d'aujourd'hui.",
        "he": "החלטתי להתאמן כל יום מהיום.",
        "hi": "मैंने आज से हर दिन व्यायाम करने का फैसला किया।",
        "hu": "Elhatároztam, hogy ma minden nap tornázom.",
        "id": "Saya memutuskan untuk berolahraga setiap hari mulai hari ini.",
        "it": "Ho deciso di fare esercizio ogni giorno da oggi.",
        "ja": "今日から毎日運動すると決めました。",
        "nb": "Jeg bestemte meg for å trene hver dag fra i dag.",
        "nl": "Ik heb besloten om vanaf vandaag elke dag te sporten.",
        "pl": "Postanowiłem ćwiczyć codziennie od dziś.",
        "pt": "Decidi fazer exercícios todos os dias a partir de hoje.",
        "ro": "Am hotărât să fac exerciții în fiecare zi, începând de azi.",
        "ru": "Я решил заниматься каждый день, начиная с сегодняшнего дня.",
        "sv": "Jag bestämde mig för att träna varje dag från och med i dag.",
        "tr": "Bugünden itibaren her gün spor yapmaya karar verdim.",
        "uk": "Я вирішив займатися щодня від сьогодні.",
        "vi": "Tôi quyết định tập thể dục mỗi ngày từ hôm nay.",
        "yue": "我決定由今日開始每日做運動。",
        "zh-Hans": "我决定从今天开始每天锻炼。"
      },
