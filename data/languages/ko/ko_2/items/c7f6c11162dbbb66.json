  "sentences": [
    {
      "target": "이 유적은 기원전 500년에 지어졌어요.",
      "reading": "i yujeogeun giwonjeon obaengnyeone jieojyeosseoyo.",
      "translations": {
        "en": "This ruin was built in 500 B.C.",
        "ko": "이 유적은 기원전 500년에 지어졌어요.",
        "ipa": "i yujeogeun giwonjeon obaengnyeone jieojyeosseoyo.",
        "ar": "بُني هذا الأثر في عام 500 قبل الميلاد.",
        "cs": "Tato památka byla postavena v roce 500 př. n. l.",
        "da": "Denne ruin blev bygget i 500 f.Kr.",
        "de": "Diese Ruine wurde 500 v. Chr. erbaut.",
        "el": "Αυτό το ερείπιο χτίστηκε το 500 π.Χ.",
        "es": "Esta ruina fue construida en el 500 a. C.",
        "fi": "Tämä raunio rakennettiin vuonna 500 eaa.",
        "fr": "Cette ruine a été construite en 500 av. J.-C.",
        "he": "החורבה הזאת נבנתה בשנת 500 לפני הספירה.",
        "hi": "यह खंडहर 500 ईसा पूर्व बनाया गया था।",
        "hu": "Ezt a romot időszámításunk előtt 500-ban építették.",
        "id": "Reruntuhan ini dibangun pada 500 SM.",
        "it": "Questa rovina fu costruita nel 500 a.C.",
        "ja": "この遺跡は紀元前500年に建てられました。",
        "nb": "Denne ruinen ble bygget i 500 f.Kr.",
        "nl": "Deze ruïne werd gebouwd in 500 v.Chr.",
        "pl": "Te ruiny zbudowano w 500 r. p.n.e.",
        "pt": "Esta ruína foi construída em 500 a.C.",
        "ro": "Această ruină a fost construită în anul 500 î.Hr.",
        "ru": "Эта руина была построена в 500 году до н. э.",
        "sv": "Den här ruinen byggdes 500 f.Kr.",
        "tr": "Bu harabe MÖ 500'de inşa edildi.",
        "uk": "Цю руїну збудували у 500 році до н. е.",
        "vi": "Di tích này được xây vào năm 500 trước Công nguyên.",
        "yue": "呢個遺跡係公元前500年建成嘅。",
        "zh-Hans": "这处遗址建于公元前500年。"
      },
