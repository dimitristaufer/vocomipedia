  "sentences": [
    {
      "target": "엄마가 밥그릇에 밥을 담았어요.",
      "reading": "엄마가 밥끄르세 바블 다마써요.",
      "translations": {
        "en": "Mom put rice in the rice bowl.",
        "ko": "엄마가 밥그릇에 밥을 담았어요.",
        "ipa": "엄마가 밥끄르세 바블 다마써요.",
        "ar": "وضعت الأم الأرز في وعاء الأرز.",
        "cs": "Máma dala do misky rýži.",
        "da": "Mor kom ris i riskålen.",
        "de": "Mama hat Reis in die Reisschüssel getan.",
        "el": "Η μαμά έβαλε ρύζι στο μπολ με το ρύζι.",
        "es": "Mamá puso arroz en el cuenco de arroz.",
        "fi": "Äiti laittoi riisiä riisikulhoon.",
        "fr": "Maman a mis du riz dans le bol à riz.",
        "he": "אמא שמה אורז בקערת האורז.",
        "hi": "माँ ने चावल के कटोरे में चावल डाले।",
        "hu": "Anya rizst tett a rizses tálba.",
        "id": "Ibu memasukkan nasi ke dalam mangkuk nasi.",
        "it": "Mamma ha messo il riso nella ciotola del riso.",
        "ja": "お母さんがご飯茶碗にご飯をよそいました。",
        "nb": "Mamma la ris i risskålen.",
        "nl": "Mama deed rijst in de rijstkom.",
        "pl": "Mama nałożyła ryż do miski na ryż.",
        "pt": "A mãe colocou arroz na tigela de arroz.",
        "ro": "Mama a pus orez în bolul de orez.",
        "ru": "Мама положила рис в миску для риса.",
        "sv": "Mamma la ris i riskålen.",
        "tr": "Annem pirinci pirinç kâsesine koydu.",
        "uk": "Мама поклала рис у миску для рису.",
        "vi": "Mẹ đã cho cơm vào bát cơm.",
        "yue": "阿媽將飯放咗喺飯碗入面。",
        "zh-Hans": "妈妈把饭盛进了饭碗里。"
      },
