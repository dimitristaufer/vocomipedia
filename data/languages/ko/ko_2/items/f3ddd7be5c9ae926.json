  "sentences": [
    {
      "target": "거울을 보고 턱을 만져 봤어요.",
      "reading": "Geoureul bogo teokeul manjyeo bwasseoyo.",
      "translations": {
        "en": "I looked in the mirror and touched my chin.",
        "ko": "거울을 보고 턱을 만져 봤어요.",
        "ipa": "Geoureul bogo teokeul manjyeo bwasseoyo.",
        "ar": "نظرتُ في المرآة ولمستُ ذقني.",
        "cs": "Podíval jsem se do zrcadla a dotkl jsem se brady.",
        "da": "Jeg kiggede i spejlet og rørte ved min hage.",
        "de": "Ich habe in den Spiegel geschaut und mein Kinn berührt.",
        "el": "Κοίταξα στον καθρέφτη και άγγιξα το πηγούνι μου.",
        "es": "Me miré en el espejo y me toqué la barbilla.",
        "fi": "Katsoin peiliin ja kosketin leukaani.",
        "fr": "Je me suis regardé dans le miroir et j'ai touché mon menton.",
        "he": "הסתכלתי במראה ונגעתי בסנטר שלי.",
        "hi": "मैंने आईने में देखा और अपनी ठुड्डी छुई।",
        "hu": "Belenéztem a tükörbe, és megérintettem az állam.",
        "id": "Saya bercermin dan menyentuh dagu saya.",
        "it": "Mi sono guardato allo specchio e ho toccato il mento.",
        "ja": "鏡を見てあごを触ってみました。",
        "nb": "Jeg så meg i speilet og tok på haken min.",
        "nl": "Ik keek in de spiegel en raakte mijn kin aan.",
        "pl": "Spojrzałem w lustro i dotknąłem brody.",
        "pt": "Olhei no espelho e toquei no meu queixo.",
        "ro": "M-am uitat în oglindă și mi-am atins bărbia.",
        "ru": "Я посмотрел в зеркало и потрогал свой подбородок.",
        "sv": "Jag tittade i spegeln och rörde vid min haka.",
        "tr": "Aynaya baktım ve çeneme dokundum.",
        "uk": "Я подивився в дзеркало й доторкнувся до підборіддя.",
        "vi": "Tôi nhìn vào gương và chạm vào cằm của mình.",
        "yue": "我照咗下鏡，摸咗下下巴。",
        "zh-Hans": "我照了照镜子，摸了摸下巴。"
      },
