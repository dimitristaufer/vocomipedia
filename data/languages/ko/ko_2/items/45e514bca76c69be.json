  "sentences": [
    {
      "target": "그녀는 순간적인 판단으로 문을 열었어요.",
      "reading": "geunyeoneun sunganjeogin pandaneuro muneul yeoreosseoyo.",
      "translations": {
        "en": "She opened the door on a split-second decision.",
        "ko": "그녀는 순간적인 판단으로 문을 열었어요.",
        "ipa": "geunyeoneun sunganjeogin pandaneuro muneul yeoreosseoyo.",
        "ar": "فتحت الباب بقرار لحظي.",
        "cs": "Ona otevřela dveře z impulzivního rozhodnutí.",
        "da": "Hun åbnede døren på et øjebliks beslutning.",
        "de": "Sie öffnete die Tür aus einer spontanen Entscheidung.",
        "el": "Άνοιξε την πόρτα με μια στιγμιαία απόφαση.",
        "es": "Abrió la puerta por una decisión de último segundo.",
        "fi": "Hän avasi oven hetken mielijohteesta.",
        "fr": "Elle a ouvert la porte sur une décision de dernière seconde.",
        "he": "היא פתחה את הדלת בהחלטה של רגע.",
        "hi": "उसने पल भर के फैसले से दरवाज़ा खोला।",
        "hu": "Egy hirtelen döntéssel kinyitotta az ajtót.",
        "id": "Dia membuka pintu karena keputusan spontan.",
        "it": "Ha aperto la porta con una decisione improvvisa.",
        "ja": "彼女はとっさの判断でドアを開けました。",
        "nb": "Hun åpnet døren på et øyeblikks innfall.",
        "nl": "Ze deed de deur open op een impulsmatige beslissing.",
        "pl": "Otworzyła drzwi pod wpływem chwili.",
        "pt": "Ela abriu a porta por uma decisão de impulso.",
        "ro": "A deschis ușa dintr-o decizie de moment.",
        "ru": "Она открыла дверь, приняв мгновенное решение.",
        "sv": "Hon öppnade dörren på ett ögonblicks beslut.",
        "tr": "O, anlık bir kararla kapıyı açtı.",
        "uk": "Вона відчинила двері, ухваливши миттєве рішення.",
        "vi": "Cô ấy mở cửa vì một quyết định chớp nhoáng.",
        "yue": "佢一時之間決定咗，然後打開咗道門。",
        "zh-Hans": "她一时决定打开了门。"
      },
