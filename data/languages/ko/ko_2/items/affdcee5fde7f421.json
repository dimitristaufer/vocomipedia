      "target": "친구의 말이 섭섭하다.",
      "reading": "chinguui mari seopseophada.",
      "translations": {
        "en": "I'm hurt by my friend's words.",
        "ko": "친구의 말이 섭섭하다.",
        "ipa": "chinguui mari seopseophada.",
        "ar": "أشعر بالأذى من كلام صديقي.",
