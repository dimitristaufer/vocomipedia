    {
      "target": "바람에 머리칼이 날렸어요.",
      "reading": "baram-e meorikari nallyeosseoyo.",
      "translations": {
        "en": "The wind blew my hair around.",
        "ko": "바람에 머리칼이 날렸어요.",
        "ipa": "baram-e meorikari nallyeosseoyo.",
        "ar": "بعثر الهواء شعري.",
        "cs": "Vítr mi rozfoukal vlasy.",
        "da": "Vinden blæste mit hår rundt.",
        "de": "Der Wind hat mein Haar verweht.",
        "el": "Ο άνεμος ανακάτεψε τα μαλλιά μου.",
        "es": "El viento me despeinó el pelo.",
        "fi": "Tuuli pörrötti hiukseni.",
        "fr": "Le vent a ébouriffé mes cheveux.",
