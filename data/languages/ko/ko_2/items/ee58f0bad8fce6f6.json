  "sentences": [
    {
      "target": "우리 집 강아지가 멍멍 짖어요.",
      "reading": "uri jip gangajiga meongmeong jijeoyo.",
      "translations": {
        "en": "My dog at home barks, \"woof woof.\"",
        "ko": "우리 집 강아지가 멍멍 짖어요.",
        "ipa": "uri jip gangajiga meongmeong jijeoyo.",
        "ar": "ينبح كلبنا الصغير في البيت: وووف وووف.",
        "cs": "Náš pejsek doma štěká haf haf.",
        "da": "Vores lille hund derhjemme gør vov vov.",
        "de": "Unser Hund zu Hause bellt wau wau.",
        "el": "Το σκυλάκι μας στο σπίτι γαβγίζει γαβ γαβ.",
        "es": "Nuestro perrito de casa ladra guau guau.",
        "fi": "Meidän koiramme kotona haukkuu hau hau.",
        "fr": "Notre petit chien à la maison aboie ouaf ouaf.",
        "he": "הכלב שלנו בבית נובח ווף ווף.",
        "hi": "हमारा कुत्ता घर में भौं-भौं करता है।",
        "hu": "A kutyánk otthon vau-vau ugat.",
        "id": "Anjing kecil kami di rumah menggonggong, guk guk.",
        "it": "Il nostro cagnolino a casa abbaia bau bau.",
        "ja": "うちの子犬がワンワンほえます。",
        "nb": "Hunden vår hjemme bjeffer vov vov.",
        "nl": "Onze hond thuis blaft waf waf.",
        "pl": "Nasz pies w domu szczeka hau hau.",
        "pt": "Nosso cachorro em casa late au au.",
        "ro": "Cățelul nostru de acasă latră ham ham.",
        "ru": "Наша собака дома лает гав-гав.",
        "sv": "Vår hund hemma skäller vov vov.",
        "tr": "Evdeki köpeğimiz hav hav diye havlıyor.",
        "uk": "Наш пес удома гавкає гав-гав.",
        "vi": "Con chó nhà tôi sủa gâu gâu.",
        "yue": "我屋企隻狗汪汪叫。",
        "zh-Hans": "我家里的小狗汪汪叫。"
      },
