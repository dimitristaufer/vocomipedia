  "sentences": [
    {
      "target": "저는 매달 용돈을 받아요.",
      "reading": "jeoneun maedal yongdoneul badayo",
      "translations": {
        "en": "I get pocket money every month.",
        "ko": "저는 매달 용돈을 받아요.",
        "ipa": "jeoneun maedal yongdoneul badayo",
        "ar": "أحصل على مصروف شهريًا.",
        "cs": "Dostávám kapesné každý měsíc.",
        "da": "Jeg får lommepenge hver måned.",
        "de": "Ich bekomme jeden Monat Taschengeld.",
        "el": "Παίρνω χαρτζιλίκι κάθε μήνα.",
        "es": "Recibo mesada cada mes.",
        "fi": "Saan taskurahaa joka kuukausi.",
        "fr": "Je reçois de l'argent de poche chaque mois.",
        "he": "אני מקבל דמי כיס כל חודש.",
        "hi": "मुझे हर महीने जेबखर्च मिलता है।",
        "hu": "Minden hónapban kapok zsebpénzt.",
        "id": "Saya mendapat uang saku setiap bulan.",
        "it": "Ricevo la paghetta ogni mese.",
        "ja": "私は毎月お小遣いをもらっています。",
        "nb": "Jeg får lommepenger hver måned.",
        "nl": "Ik krijg elke maand zakgeld.",
        "pl": "Co miesiąc dostaję kieszonkowe.",
        "pt": "Eu recebo mesada todo mês.",
        "ro": "Primesc bani de buzunar în fiecare lună.",
        "ru": "Я получаю карманные деньги каждый месяц.",
        "sv": "Jag får fickpengar varje månad.",
        "tr": "Her ay harçlık alıyorum.",
        "uk": "Я отримую кишенькові гроші щомісяця.",
        "vi": "Tôi nhận tiền tiêu vặt mỗi tháng.",
        "yue": "我每個月都攞零用錢。",
        "zh-Hans": "我每个月都拿零花钱。"
      },
