    {
      "target": "아이에게 용돈을 조금 줬어요.",
      "reading": "aiege yongdoneul jogeum jwosseoyo",
      "translations": {
        "en": "I gave the child a little pocket money.",
        "ko": "아이에게 용돈을 조금 줬어요.",
        "ipa": "aiege yongdoneul jogeum jwosseoyo",
        "ar": "أعطيت الطفل قليلًا من المصروف.",
        "cs": "Dala jsem dítěti trochu kapesného.",
        "da": "Jeg gav barnet lidt lommepenge.",
        "de": "Ich habe dem Kind etwas Taschengeld gegeben.",
        "el": "Έδωσα στο παιδί λίγο χαρτζιλίκι.",
        "es": "Le di un poco de mesada al niño.",
        "fi": "Annan lapselle vähän taskurahaa.",
        "fr": "J'ai donné un peu d'argent de poche à l'enfant.",
        "he": "נתתי לילד קצת דמי כיס.",
        "hi": "मैंने बच्चे को थोड़ा जेबखर्च दिया।",
        "hu": "Adtam a gyereknek egy kis zsebpénzt.",
        "id": "Saya memberi anak itu sedikit uang saku.",
        "it": "Ho dato al bambino un po' di paghetta.",
        "ja": "子どもに少しお小遣いをあげました。",
        "nb": "Jeg ga barnet litt lommepenger.",
        "nl": "Ik gaf het kind wat zakgeld.",
        "pl": "Dałam dziecku trochę kieszonkowego.",
        "pt": "Dei um pouco de mesada para a criança.",
        "ro": "I-am dat copilului puțini bani de buzunar.",
        "ru": "Я дал ребёнку немного карманных денег.",
        "sv": "Jag gav barnet lite fickpengar.",
        "tr": "Çocuğa biraz harçlık verdim.",
        "uk": "Я дав дитині трохи кишенькових грошей.",
        "vi": "Tôi đã cho đứa trẻ ít tiền tiêu vặt.",
        "yue": "我畀咗少少零用錢個細路。",
        "zh-Hans": "我给了孩子一点零花钱。"
      },
