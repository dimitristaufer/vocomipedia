  "sentences": [
    {
      "target": "어머니는 가족을 위해 매일 일찍 일어나세요.",
      "reading": "eomeonineun gajogeul wihae maeil iljjik ireonaseyo.",
      "translations": {
        "en": "My mother gets up early every day for the sake of the family.",
        "ko": "어머니는 가족을 위해 매일 일찍 일어나세요.",
        "ipa": "eomeonineun gajogeul wihae maeil iljjik ireonaseyo.",
        "ar": "أمي تستيقظ مبكرًا كل يوم من أجل الأسرة.",
        "cs": "Moje maminka vstává každý den brzy kvůli rodině.",
        "da": "Min mor står tidligt op hver dag for familiens skyld.",
        "de": "Meine Mutter steht jeden Tag früh für die Familie auf.",
        "el": "Η μητέρα μου σηκώνεται νωρίς κάθε μέρα για χάρη της οικογένειας.",
        "es": "Mi madre se levanta temprano todos los días por la familia.",
        "fi": "Äitini nousee joka päivä aikaisin perheen vuoksi.",
        "fr": "Ma mère se lève tôt tous les jours pour la famille.",
        "he": "אמא שלי קמה מוקדם כל יום בשביל המשפחה.",
        "hi": "मेरी माँ परिवार के लिए हर दिन जल्दी उठती हैं।",
        "hu": "Anyukám minden nap korán kel a családért.",
        "id": "Ibu saya bangun pagi setiap hari demi keluarga.",
        "it": "Mia madre si alza presto ogni giorno per la famiglia.",
        "ja": "母は家族のために毎日早起きします。",
        "nb": "Moren min står opp tidlig hver dag for familiens skyld.",
        "nl": "Mijn moeder staat elke dag vroeg op voor het gezin.",
        "pl": "Moja mama wstaje wcześnie każdego dnia dla rodziny.",
        "pt": "Minha mãe acorda cedo todos os dias pela família.",
        "ro": "Mama mea se trezește devreme în fiecare zi pentru familie.",
        "ru": "Моя мама каждый день рано встаёт ради семьи.",
        "sv": "Min mamma går upp tidigt varje dag för familjens skull.",
        "tr": "Annem her gün aile için erkenden kalkar.",
        "uk": "Моя мама щодня рано встає заради сім’ї.",
        "vi": "Mẹ tôi dậy sớm mỗi ngày vì gia đình.",
        "yue": "我阿媽每日都為咗屋企好早起身。",
        "zh-Hans": "我妈妈每天为了家人很早起床。"
      },
