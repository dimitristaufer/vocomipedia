    {
      "target": "마당에 낙엽이 쌓였어요.",
      "reading": "madange nagyeobi ssahyeosseoyo.",
      "translations": {
        "en": "Dead leaves have piled up in the yard.",
        "ko": "마당에 낙엽이 쌓였어요.",
        "ipa": "madange nagyeobi ssahyeosseoyo.",
        "ar": "تراكمت الأوراق اليابسة في الفناء.",
        "cs": "Na dvoře se nashromáždilo spadané listí.",
        "da": "Der er samlet visne blade i gården.",
