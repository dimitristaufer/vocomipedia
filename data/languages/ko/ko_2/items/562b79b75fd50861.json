  "sentences": [
    {
      "target": "어제는 밤을 새워서 공부했어요.",
      "reading": "eoje-neun bam-eul saewoseo gongbuhasseoyo.",
      "translations": {
        "en": "I stayed up all night studying yesterday.",
        "ko": "어제는 밤을 새워서 공부했어요.",
        "ipa": "eoje-neun bam-eul saewoseo gongbuhasseoyo.",
        "ar": "سَهِرْتُ الليلَ كُلَّهُ للدراسة أمس.",
        "cs": "Včera jsem se učil celou noc.",
        "da": "Jeg sad oppe hele natten og læste i går.",
        "de": "Ich habe gestern die ganze Nacht gelernt.",
        "el": "Χθες έμεινα ξύπνιος όλη τη νύχτα και διάβαζα.",
        "es": "Ayer me quedé despierto toda la noche estudiando.",
        "fi": "Valvoin viime yön ja opiskelin.",
        "fr": "Hier, j'ai veillé toute la nuit pour étudier.",
        "he": "נשארתי ער כל הלילה כדי ללמוד אתמול.",
        "hi": "कल मैं पढ़ने के लिए सारी रात जागता रहा।",
        "hu": "Tegnap egész éjjel fennmaradtam, és tanultam.",
        "id": "Kemarin aku begadang semalam suntuk untuk belajar.",
        "it": "Ieri sono stato sveglio tutta la notte a studiare.",
        "ja": "昨日は徹夜で勉強しました。",
        "nb": "Jeg var våken hele natten og leste i går.",
        "nl": "Ik heb gisteren de hele nacht door gestudeerd.",
        "pl": "Wczoraj zarwałem noc, żeby się uczyć.",
        "pt": "Ontem fiquei acordado a noite toda estudando.",
        "ro": "Ieri am stat treaz toată noaptea ca să învăț.",
        "ru": "Вчера я не спал всю ночь и учился.",
        "sv": "Jag var vaken hela natten och pluggade i går.",
        "tr": "Dün ders çalışmak için sabaha kadar uyumadım.",
        "uk": "Учора я не спав усю ніч і вчився.",
        "vi": "Hôm qua tôi thức cả đêm để học.",
        "yue": "噚日我瞓咗成晚嚟溫書。",
        "zh-Hans": "昨天我熬夜学习了。"
      },
