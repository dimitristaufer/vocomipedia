  "sentences": [
    {
      "target": "비행장에 착륙한 비행기가 보여요.",
      "reading": "bihaengjange chakryukhan bihaenggiga boyeoyo.",
      "translations": {
        "en": "I can see a plane that has landed at the airfield.",
        "ko": "비행장에 착륙한 비행기가 보여요.",
        "ipa": "bihaengjange chakryukhan bihaenggiga boyeoyo.",
        "ar": "أرى طائرة هبطت في المطار.",
        "cs": "Vidím letadlo, které přistálo na letišti.",
        "da": "Jeg kan se et fly, der er landet på flyvepladsen.",
        "de": "Ich sehe ein Flugzeug, das auf dem Flugplatz gelandet ist.",
        "el": "Βλέπω ένα αεροπλάνο που προσγειώθηκε στο αεροδρόμιο.",
        "es": "Veo un avión que aterrizó en el aeródromo.",
        "fi": "Näen lentokoneen, joka on laskeutunut lentokentälle.",
        "fr": "Je vois un avion qui a atterri sur l'aérodrome.",
        "he": "אני רואה מטוס שנחת בשדה התעופה.",
        "hi": "मैं हवाई अड्डे पर उतरे एक विमान को देख रहा हूँ।",
        "hu": "Látok egy repülőt, amely leszállt a repülőtéren.",
        "id": "Saya melihat pesawat yang baru mendarat di lapangan terbang.",
        "it": "Vedo un aereo atterrato nell'aerodromo.",
        "ja": "飛行場に着陸した飛行機が見えます。",
        "nb": "Jeg ser et fly som har landet på flyplassen.",
        "nl": "Ik zie een vliegtuig dat op het vliegveld is geland.",
        "pl": "Widzę samolot, który wylądował na lotnisku.",
        "pt": "Vejo um avião que pousou no aeroporto.",
        "ro": "Văd un avion care a aterizat pe aerodrom.",
        "ru": "Я вижу самолёт, который приземлился на аэродроме.",
        "sv": "Jag ser ett flygplan som har landat på flygfältet.",
        "tr": "Havaalanına inmiş bir uçak görüyorum.",
        "uk": "Я бачу літак, який приземлився на аеродромі.",
        "vi": "Tôi thấy một chiếc máy bay vừa hạ cánh ở sân bay.",
        "yue": "我見到一架喺飛機場降落咗嘅飛機。",
        "zh-Hans": "我看见一架降落在机场的飞机。"
      },
