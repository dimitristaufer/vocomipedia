  "sentences": [
    {
      "target": "물 표면에 작은 파문이 생겼어요.",
      "reading": "mul pyomyeone jageun pamuni saenggyeosseoyo.",
      "translations": {
        "en": "Small ripples formed on the water surface.",
        "ko": "물 표면에 작은 파문이 생겼어요.",
        "ipa": "mul pyomyeone jageun pamuni saenggyeosseoyo.",
        "ar": "تشكلت تموجات صغيرة على سطح الماء.",
        "cs": "Na hladině vody se vytvořily malé vlnky.",
        "da": "Der opstod små bølger på vandoverfladen.",
        "de": "Auf der Wasseroberfläche bildeten sich kleine Wellen.",
        "el": "Στην επιφάνεια του νερού δημιουργήθηκαν μικροί κυματισμοί.",
        "es": "Se formaron pequeñas ondulaciones en la superficie del agua.",
        "fi": "Veden pinnalle muodostui pieniä väreitä.",
        "fr": "De petites ondulations se sont formées à la surface de l'eau.",
        "he": "נוצרו אדוות קטנות על פני המים.",
        "hi": "पानी की सतह पर छोटी-छोटी लहरें बन गईं।",
        "hu": "A víz felszínén apró fodrok keletkeztek.",
        "id": "Muncul riak-riak kecil di permukaan air.",
        "it": "Si sono formate piccole increspature sulla superficie dell'acqua.",
        "ja": "水面に小さな波紋ができました。",
        "nb": "Det dannet seg små ringer på vannoverflaten.",
        "nl": "Er kwamen kleine rimpelingen op het wateroppervlak.",
        "pl": "Na powierzchni wody pojawiły się małe zmarszczki.",
        "pt": "Formaram-se pequenas ondulações na superfície da água.",
        "ro": "Pe suprafața apei s-au format mici valuri.",
        "ru": "На поверхности воды появились маленькие ряби.",
        "sv": "Det bildades små krusningar på vattenytan.",
        "tr": "Su yüzeyinde küçük dalgacıklar oluştu.",
        "uk": "На поверхні води з’явилися маленькі хвильки.",
        "vi": "Trên mặt nước xuất hiện những gợn sóng nhỏ.",
        "yue": "水面出現咗細細嘅漣漪。",
        "zh-Hans": "水面上出现了小小的涟漪。"
      },
