  "sentences": [
    {
      "target": "전날 비가 와서 길이 미끄러웠어요.",
      "reading": "jeonnal biga waseo giri miseureowosseoyo",
      "translations": {
        "en": "It rained the day before, so the road was slippery.",
        "ko": "전날 비가 와서 길이 미끄러웠어요.",
        "ipa": "jeonnal biga waseo giri miseureowosseoyo",
        "ar": "هطل المطر في اليوم السابق، فكان الطريق زلقًا.",
        "cs": "Den předtím pršelo, takže silnice byla kluzká.",
        "da": "Det regnede dagen før, så vejen var glat.",
        "de": "Am Vortag hat es geregnet, deshalb war die Straße rutschig.",
        "el": "Την προηγούμενη μέρα έβρεξε, οπότε ο δρόμος ήταν γλιστερός.",
        "es": "Llovió el día anterior, así que la calle estaba resbaladiza.",
        "fi": "Edellisenä päivänä satoi, joten tie oli liukas.",
        "fr": "Il a plu la veille, alors la route était glissante.",
        "he": "ירד גשם יום קודם, אז הכביש היה חלק.",
        "hi": "पिछले दिन बारिश हुई थी, इसलिए सड़क फिसलन भरी थी।",
        "hu": "Az előző nap esett az eső, ezért csúszós volt az út.",
        "id": "Kemarin hujan turun, jadi jalannya licin.",
        "it": "Il giorno prima ha piovuto, quindi la strada era scivolosa.",
        "ja": "前の日に雨が降ったので、道が滑りやすかったです。",
        "nb": "Det regnet dagen før, så veien var glatt.",
        "nl": "De dag ervoor had het geregend, dus de weg was glad.",
        "pl": "Dzień wcześniej padał deszcz, więc droga była śliska.",
        "pt": "No dia anterior, choveu, então a rua estava escorregadia.",
        "ro": "Cu o zi înainte a plouat, așa că drumul era alunecos.",
        "ru": "Накануне шёл дождь, поэтому дорога была скользкой.",
        "sv": "Det regnade dagen innan, så vägen var hal.",
        "tr": "Bir önceki gün yağmur yağmıştı, bu yüzden yol kaygandı.",
        "uk": "Напередодні йшов дощ, тому дорога була слизька.",
        "vi": "Hôm trước trời mưa nên đường trơn.",
        "yue": "前一日落過雨，所以條路好跣。",
        "zh-Hans": "前一天，下过雨，所以路很滑。"
      },
