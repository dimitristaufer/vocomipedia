  "sentences": [
    {
      "target": "비가 와서 오히려 사람이 적었어요.",
      "reading": "Biga waseo ohiryeo sarami jeogeosseoyo.",
      "translations": {
        "en": "Because it rained, there were fewer people.",
        "ko": "비가 와서 오히려 사람이 적었어요.",
        "ipa": "Biga waseo ohiryeo sarami jeogeosseoyo.",
        "ar": "بسبب المطر، كان الناس أقل.",
        "cs": "Kvůli dešti tam bylo méně lidí.",
        "da": "Fordi det regnede, var der færre mennesker.",
        "de": "Weil es geregnet hat, waren weniger Leute da.",
        "el": "Επειδή έβρεχε, είχε λιγότερο κόσμο.",
        "es": "Como llovía, había menos gente.",
        "fi": "Satoi, joten ihmisiä oli vähemmän.",
        "fr": "Comme il pleuvait, il y avait moins de monde.",
        "he": "בגלל שירד גשם, היו פחות אנשים.",
        "hi": "बारिश होने की वजह से लोग कम थे।",
        "hu": "Mivel esett az eső, kevesebb ember volt.",
        "id": "Karena hujan, orang-orang lebih sedikit.",
        "it": "Dato che pioveva, c'era meno gente.",
        "ja": "雨が降ったので、かえって人が少なかったです。",
        "nb": "Det regnet, så det var færre folk.",
        "nl": "Omdat het regende, waren er minder mensen.",
        "pl": "Ponieważ padał deszcz, było mniej ludzi.",
        "pt": "Como estava chovendo, havia menos gente.",
        "ro": "Pentru că ploua, erau mai puțini oameni.",
        "ru": "Из-за дождя людей было меньше.",
        "sv": "Eftersom det regnade var det färre människor.",
        "tr": "Yağmur yağdığı için daha az insan vardı.",
        "uk": "Через дощ людей було менше.",
        "vi": "Vì trời mưa nên ít người hơn.",
        "yue": "因為落雨，所以人少咗。",
        "zh-Hans": "因为下雨了，所以人更少了。"
      },
