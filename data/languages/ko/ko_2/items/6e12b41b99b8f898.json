    {
      "target": "그 말이 오히려 힘이 됐어요.",
      "reading": "Geu mari ohiryeo himi dwaesseoyo.",
      "translations": {
        "en": "Those words actually gave me strength.",
        "ko": "그 말이 오히려 힘이 됐어요.",
        "ipa": "Geu mari ohiryeo himi dwaesseoyo.",
        "ar": "تلك الكلمات منحتني قوةً فعلاً.",
        "cs": "Ta slova mi vlastně dodala sílu.",
        "da": "De ord gav mig faktisk styrke.",
        "de": "Diese Worte haben mir wirklich Kraft gegeben.",
        "el": "Αυτά τα λόγια μού έδωσαν πραγματικά δύναμη.",
        "es": "Esas palabras me dieron fuerzas de verdad.",
        "fi": "Nuo sanat antoivat minulle oikeasti voimaa.",
        "fr": "Ces mots m'ont vraiment donné de la force.",
        "he": "המילים האלה ממש נתנו לי כוח.",
        "hi": "उन बातों ने मुझे सच में हिम्मत दी।",
        "hu": "Ezek a szavak valójában erőt adtak nekem.",
        "id": "Kata-kata itu benar-benar memberi saya kekuatan.",
        "it": "Quelle parole mi hanno dato davvero forza.",
        "ja": "その言葉が、かえって力になりました。",
        "nb": "De ordene ga meg faktisk styrke.",
        "nl": "Die woorden gaven me echt kracht.",
        "pl": "Te słowa naprawdę dodały mi sił.",
        "pt": "Essas palavras realmente me deram força.",
        "ro": "Vorbele acelea chiar mi-au dat putere.",
        "ru": "Эти слова правда придали мне сил.",
        "sv": "De orden gav mig faktiskt styrka.",
        "tr": "O sözler bana gerçekten güç verdi.",
        "uk": "Ті слова справді додали мені сил.",
        "vi": "Những lời đó thật sự đã cho tôi sức mạnh.",
        "yue": "嗰句說話反而畀咗我力量。",
        "zh-Hans": "那句话反而给了我力量。"
      },
