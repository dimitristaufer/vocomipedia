  "sentences": [
    {
      "target": "그는 사고 뒤에도 지각이 있었다.",
      "reading": "geuneun sago dwiedo jigagi isseotda.",
      "translations": {
        "en": "He was conscious after the accident.",
        "ko": "그는 사고 뒤에도 지각이 있었다.",
        "ipa": "geuneun sago dwiedo jigagi isseotda.",
        "ar": "كان واعيًا بعد الحادث.",
        "cs": "Po nehodě byl při vědomí.",
        "da": "Han var ved bevidsthed efter ulykken.",
        "de": "Er war nach dem Unfall bei Bewusstsein.",
        "el": "Ήταν σε εγρήγορση μετά το ατύχημα.",
        "es": "Estaba consciente después del accidente.",
        "fi": "Hän oli tajuissaan onnettomuuden jälkeen.",
        "fr": "Il était conscient après l'accident.",
        "he": "הוא היה בהכרה אחרי התאונה.",
        "hi": "वह दुर्घटना के बाद होश में था।",
        "hu": "A baleset után eszméleténél volt.",
        "id": "Dia sadar setelah kecelakaan itu.",
        "it": "Era cosciente dopo l'incidente.",
        "ja": "彼は事故のあとも意識があった。",
        "nb": "Han var ved bevissthet etter ulykken.",
        "nl": "Hij was bij bewustzijn na het ongeluk.",
        "pl": "Po wypadku był przytomny.",
        "pt": "Ele estava consciente depois do acidente.",
        "ro": "Era conștient după accident.",
        "ru": "Он был в сознании после аварии.",
        "sv": "Han var vid medvetande efter olyckan.",
        "tr": "Kazadan sonra bilinci yerindeydi.",
        "uk": "Після аварії він був при свідомості.",
        "vi": "Anh ấy vẫn tỉnh táo sau tai nạn.",
        "yue": "佢喺意外之後仲清醒。",
        "zh-Hans": "他在事故后仍然清醒。"
      },
