    {
      "target": "오늘 날씨가 최악이에요.",
      "reading": "oneul nalssiga choeak-ieyo.",
      "translations": {
        "en": "The weather is the worst today.",
        "ko": "오늘 날씨가 최악이에요.",
        "ipa": "oneul nalssiga choeak-ieyo.",
        "ar": "الطقس اليوم هو الأسوأ.",
        "cs": "Dnes je počasí nejhorší.",
        "da": "Vejret er det værste i dag.",
        "de": "Das Wetter ist heute das Schlimmste.",
        "el": "Ο καιρός σήμερα είναι ο χειρότερος.",
        "es": "El clima de hoy es lo peor.",
        "fi": "Sää on tänään ihan kauhea.",
