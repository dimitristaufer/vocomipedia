    {
      "target": "외출하지 말고 집에서 쉬세요.",
      "reading": "oechulhaji malgo jibeseo swiseyo.",
      "translations": {
        "en": "Don't go out; rest at home.",
        "ko": "외출하지 말고 집에서 쉬세요.",
        "ipa": "oechulhaji malgo jibeseo swiseyo.",
        "ar": "لا تخرج، وارتاح في البيت.",
        "cs": "Nevycházej a odpočívej doma.",
        "da": "Gå ikke ud, og hvil dig derhjemme.",
        "de": "Geh nicht raus und ruh dich zu Hause aus.",
        "el": "Μην βγεις έξω και ξεκουράσου στο σπίτι.",
        "es": "No salgas; descansa en casa.",
        "fi": "Älä mene ulos, vaan lepää kotona.",
        "fr": "Ne sortez pas, reposez-vous à la maison.",
        "he": "אל תצא, תנוח בבית.",
        "hi": "बाहर मत जाओ, घर पर आराम करो।",
        "hu": "Ne menj ki, és pihenj otthon.",
        "id": "Jangan keluar, istirahatlah di rumah.",
        "it": "Non uscire, riposati a casa.",
        "ja": "外出せずに家で休んでください。",
        "nb": "Ikke gå ut, og hvil deg hjemme.",
        "nl": "Ga niet naar buiten en rust thuis uit.",
        "pl": "Nie wychodź i odpocznij w domu.",
        "pt": "Não saia; descanse em casa.",
        "ro": "Nu ieși afară, odihnește-te acasă.",
        "ru": "Не выходи, отдохни дома.",
        "sv": "Gå inte ut, vila hemma.",
        "tr": "Dışarı çıkma, evde dinlen.",
        "uk": "Не виходь і відпочинь удома.",
        "vi": "Đừng ra ngoài, hãy nghỉ ở nhà.",
        "yue": "唔好出街，喺屋企休息。",
        "zh-Hans": "不要出门，在家休息吧。"
      },
