  "sentences": [
    {
      "target": "아버지는 아침부터 농사일을 하셨어요.",
      "reading": "abeojineun achimbuteo nongsaireul hasyeosseoyo.",
      "translations": {
        "en": "My father has been doing farm work since morning.",
        "ko": "아버지는 아침부터 농사일을 하셨어요.",
        "ipa": "abeojineun achimbuteo nongsaireul hasyeosseoyo.",
        "ar": "يعمل أبي في أعمال الزراعة منذ الصباح.",
        "cs": "Táta pracoval na farmě už od rána.",
        "da": "Min far har arbejdet med landbrug siden i morges.",
        "de": "Mein Vater arbeitet seit dem Morgen auf dem Feld.",
        "el": "Ο πατέρας μου δουλεύει στα χωράφια από το πρωί.",
        "es": "Mi padre ha estado trabajando en el campo desde la mañana.",
        "fi": "Isäni on tehnyt maataloustöitä aamusta asti.",
        "fr": "Mon père travaille aux champs depuis ce matin.",
        "he": "אבא שלי עובד בשדה מאז הבוקר.",
        "hi": "मेरे पिताजी सुबह से खेती का काम कर रहे हैं।",
        "hu": "Apám reggel óta a földeken dolgozik.",
        "id": "Ayah saya sudah bekerja di ladang sejak pagi.",
        "it": "Mio padre sta lavorando nei campi da stamattina.",
        "ja": "父は朝から農作業をしています。",
        "nb": "Faren min har jobbet med gårdsarbeid siden i morges.",
        "nl": "Mijn vader werkt sinds vanmorgen op het land.",
        "pl": "Mój tata pracuje w polu od rana.",
        "pt": "Meu pai trabalha na lavoura desde cedo.",
        "ro": "Tatăl meu lucrează la câmp de dimineață.",
        "ru": "Мой отец с утра занимается работой в поле.",
        "sv": "Min pappa har arbetat på åkern sedan i morse.",
        "tr": "Babam sabahtan beri tarla işi yapıyor.",
        "uk": "Мій тато працює в полі від самого ранку.",
        "vi": "Bố tôi đã làm việc đồng áng từ sáng.",
        "yue": "我阿爸由朝早開始做農活。",
        "zh-Hans": "我爸爸从早上开始做农活。"
      },
