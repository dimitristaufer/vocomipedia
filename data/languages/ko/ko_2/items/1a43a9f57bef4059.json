    {
      "target": "오래 손뼉을 쳐서 아파요.",
      "reading": "Orae sonppyeogeul chyeoseo apayo.",
      "translations": {
        "en": "My palms hurt from clapping for a long time.",
        "ko": "오래 손뼉을 쳐서 아파요.",
        "ipa": "Orae sonppyeogeul chyeoseo apayo.",
        "ar": "تؤلمني كفاي من كثرة التصفيق.",
        "cs": "Po dlouhém tleskání mě bolí dlaně.",
        "da": "Mine håndflader gør ondt efter at have klappet længe.",
        "de": "Meine Handflächen tun weh, weil ich lange geklatscht habe.",
        "el": "Με πονάνε οι παλάμες μου από το πολύ χειροκρότημα.",
        "es": "Me duelen las palmas de las manos de tanto aplaudir.",
        "fi": "Kämmeneni ovat kipeät, kun olen taputtanut pitkään.",
        "fr": "J'ai mal aux paumes à force d'avoir applaudi longtemps.",
        "he": "כואבות לי כפות הידיים מרוב מחיאות כפיים.",
        "hi": "लंबे समय तक ताली बजाने से मेरी हथेलियों में दर्द है।",
        "hu": "Fáj a tenyerem, mert sokáig tapsoltam.",
        "id": "Telapak tanganku sakit karena lama bertepuk tangan.",
        "it": "Mi fanno male i palmi per aver applaudito a lungo.",
        "ja": "長い間拍手をしていたので、手のひらが痛いです。",
        "nb": "Jeg har vondt i håndflatene etter å ha klappet lenge.",
        "nl": "Mijn handpalmen doen pijn van het lang klappen.",
        "pl": "Bolą mnie dłonie od długiego klaskania.",
        "pt": "Minhas palmas doem de tanto bater palmas.",
        "ro": "Mă dor palmele de la atâta aplaudat.",
        "ru": "У меня болят ладони от долгих аплодисментов.",
        "sv": "Jag har ont i handflatorna efter att ha klappat länge.",
        "tr": "Uzun süre alkışladığım için avuç içlerim ağrıyor.",
        "uk": "У мене болять долоні від довгих оплесків.",
        "vi": "Tôi bị đau lòng bàn tay vì vỗ tay lâu.",
        "yue": "我拍手拍得耐，手掌好痛。",
        "zh-Hans": "我拍手拍得太久，手心疼。"
      },
