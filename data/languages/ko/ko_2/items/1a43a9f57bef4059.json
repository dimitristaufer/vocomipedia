  "sentences": [
    {
      "target": "아이가 손뼉을 치며 웃어요.",
      "reading": "Aiga sonppyeokeul chimyeo useoyo.",
      "translations": {
        "en": "The child claps and laughs.",
        "ko": "아이가 손뼉을 치며 웃어요.",
        "ipa": "Aiga sonppyeokeul chimyeo useoyo.",
        "ar": "يصفق الطفل ويضحك.",
        "cs": "Dítě tleská a směje se.",
        "da": "Barnet klapper og griner.",
        "de": "Das Kind klatscht und lacht.",
        "el": "Το παιδί χτυπά παλαμάκια και γελάει.",
        "es": "El niño aplaude y se ríe.",
        "fi": "Lapsi taputtaa ja nauraa.",
        "fr": "L'enfant applaudit et rit.",
        "he": "הילד מוחא כפיים וצוחק.",
        "hi": "बच्चा ताली बजाकर हँस रहा है।",
        "hu": "A gyerek tapsol és nevet.",
        "id": "Anak itu bertepuk tangan sambil tertawa.",
        "it": "Il bambino batte le mani e ride.",
        "ja": "子どもが手をたたいて笑っています。",
        "nb": "Barnet klapper og ler.",
        "nl": "Het kind klapt en lacht.",
        "pl": "Dziecko klaszcze i się śmieje.",
        "pt": "A criança bate palmas e ri.",
        "ro": "Copilul aplaudă și râde.",
        "ru": "Ребёнок хлопает в ладоши и смеётся.",
        "sv": "Barnet klappar händerna och skrattar.",
        "tr": "Çocuk el çırpıyor ve gülüyor.",
        "uk": "Дитина плескає в долоні й сміється.",
        "vi": "Đứa trẻ vỗ tay và cười.",
        "yue": "個細路仔拍手又笑。",
        "zh-Hans": "孩子拍手笑了。"
      },
