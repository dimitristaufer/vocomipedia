  "sentences": [
    {
      "target": "버스가 늦었어요. 게다가 비도 와요.",
      "reading": "beoseuga neujeosseoyo. gedaga bido wayo.",
      "translations": {
        "en": "The bus is late. In addition, it’s raining.",
        "ko": "버스가 늦었어요. 게다가 비도 와요.",
        "ipa": "beoseuga neujeosseoyo. gedaga bido wayo.",
        "ar": "الحافلة متأخرة. بالإضافة إلى ذلك، تمطر.",
        "cs": "Autobus má zpoždění. Navíc prší.",
        "da": "Bussen er forsinket. Derudover regner det.",
        "de": "Der Bus hat Verspätung. Außerdem regnet es.",
        "el": "Το λεωφορείο έχει καθυστέρηση. Επιπλέον, βρέχει.",
        "es": "El autobús va tarde. Además, está lloviendo.",
        "fi": "Bussi on myöhässä. Lisäksi sataa.",
        "fr": "Le bus est en retard. De plus, il pleut.",
        "he": "האוטובוס מאחר. בנוסף, יורד גשם.",
        "hi": "बस देर से है। इसके अलावा, बारिश हो रही है।",
        "hu": "A busz késik. Ráadásul esik az eső.",
        "id": "Busnya terlambat. Selain itu, hujan juga.",
        "it": "L'autobus è in ritardo. Inoltre, piove.",
        "ja": "バスが遅れています。そのうえ、雨も降っています。",
        "nb": "Bussen er forsinket. Dessuten regner det.",
        "nl": "De bus is te laat. Bovendien regent het.",
        "pl": "Autobus się spóźnia. Poza tym pada deszcz.",
        "pt": "O ônibus está atrasado. Além disso, está chovendo.",
        "ro": "Autobuzul întârzie. În plus, plouă.",
        "ru": "Автобус опаздывает. К тому же идет дождь.",
        "sv": "Bussen är sen. Dessutom regnar det.",
        "tr": "Otobüs gecikti. Ayrıca yağmur yağıyor.",
        "uk": "Автобус запізнюється. До того ж іде дощ.",
        "vi": "Xe buýt bị trễ. Ngoài ra, trời cũng đang mưa.",
        "yue": "巴士遲咗。再者，仲落緊雨。",
        "zh-Hans": "公交车晚点了。再者，还在下雨。"
      },
