  "sentences": [
    {
      "target": "바람이 불자 머리카락이 흩어졌어요.",
      "reading": "barami bulja meorikaeragi heuteojeosseoyo.",
      "translations": {
        "en": "When the wind blew, my hair scattered.",
        "ko": "바람이 불자 머리카락이 흩어졌어요.",
        "ipa": "barami bulja meorikaeragi heuteojeosseoyo.",
        "ar": "عندما هبت الرياح، تفرّق شعري.",
        "cs": "Když zafoukal vítr, vlasy se mi rozletěly.",
        "da": "Da vinden blæste, blafrede mit hår.",
        "de": "Als der Wind wehte, flatterten meine Haare.",
        "el": "Όταν φύσηξε ο αέρας, τα μαλλιά μου σκορπίστηκαν.",
        "es": "Cuando sopló el viento, mi pelo se desordenó.",
        "fi": "Kun tuuli puhalsi, hiukseni levisivät.",
        "fr": "Quand le vent a soufflé, mes cheveux se sont éparpillés.",
        "he": "כשהרוח נשבה, השיער שלי התפזר.",
        "hi": "जब हवा चली, मेरे बाल बिखर गए।",
        "hu": "Amikor fújt a szél, a hajam szétszóródott.",
        "id": "Saat angin bertiup, rambut saya berantakan.",
        "it": "Quando soffiava il vento, i miei capelli si sono scompigliati.",
        "ja": "風が吹くと、髪が乱れました。",
        "nb": "Da vinden blåste, blåste håret mitt utover.",
        "nl": "Toen de wind waaide, waaide mijn haar alle kanten op.",
        "pl": "Kiedy zawiał wiatr, moje włosy się rozwiały.",
        "pt": "Quando o vento soprou, meu cabelo ficou todo despenteado.",
        "ro": "Când a bătut vântul, mi s-a zburlit părul.",
        "ru": "Когда подул ветер, мои волосы растрепались.",
        "sv": "När det blåste spred sig mitt hår.",
        "tr": "Rüzgâr esince saçlarım dağıldı.",
        "uk": "Коли подув вітер, моє волосся розтріпалося.",
        "vi": "Khi gió thổi, tóc tôi tung ra.",
        "yue": "風一吹，我啲頭髮就散開咗。",
        "zh-Hans": "一刮风，我的头发就散开了。"
      },
