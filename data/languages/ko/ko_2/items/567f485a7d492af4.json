  "sentences": [
    {
      "target": "신청서의 기타란에 적어 주세요.",
      "reading": "sincheongseo-ui gita-ran-e jeogeo juseyo.",
      "translations": {
        "en": "Please write it in the \"Other\" section of the application form.",
        "ko": "신청서의 기타란에 적어 주세요.",
        "ipa": "sincheongseo-ui gita-ran-e jeogeo juseyo.",
        "ar": "من فضلك اكتبها في خانة \"أخرى\" في استمارة الطلب.",
        "cs": "Prosím, napište to do kolonky „Jiné“ v žádosti.",
        "da": "Skriv det venligst i feltet \"Andet\" på ansøgningsskemaet.",
        "de": "Bitte schreiben Sie es in das Feld „Sonstiges“ im Antragsformular.",
        "el": "Γράψτε το στο πεδίο «Άλλο» της αίτησης.",
        "es": "Por favor, escríbalo en la sección \"Otros\" del formulario de solicitud.",
        "fi": "Kirjoita se hakemuksen Muut-kohtaan.",
        "fr": "Veuillez l'écrire dans la rubrique « Autre » du formulaire de demande.",
        "he": "נא לכתוב את זה בסעיף \"אחר\" בטופס הבקשה.",
        "hi": "कृपया इसे आवेदन पत्र के \"अन्य\" भाग में लिखें।",
        "hu": "Kérjük, írja be az igénylőlapon az „Egyéb” rovatba.",
        "id": "Tolong tulis di bagian \"Lain-lain\" pada formulir permohonan.",
        "it": "Per favore, scrivilo nella sezione \"Altro\" del modulo di domanda.",
        "ja": "申請書の「その他」の欄に書いてください。",
        "nb": "Skriv det i feltet for «annet» på søknadsskjemaet.",
        "nl": "Schrijf het alstublieft in het vakje 'Overig' op het aanvraagformulier.",
        "pl": "Proszę wpisać to w rubryce „Inne” w formularzu zgłoszeniowym.",
        "pt": "Por favor, escreva isso na seção \"Outros\" do formulário de inscrição.",
        "ro": "Vă rugăm să scrieți asta la rubrica „Altele” din formularul de înscriere.",
        "ru": "Пожалуйста, напишите это в графе «Другое» в заявлении.",
        "sv": "Skriv det i rutan ”Övrigt” på ansökningsblanketten.",
        "tr": "Lütfen bunu başvuru formundaki \"Diğer\" bölümüne yazın.",
        "uk": "Будь ласка, запишіть це в розділі «Інше» в заяві.",
        "vi": "Vui lòng viết nó vào mục \"Khác\" của đơn đăng ký.",
        "yue": "請你寫喺申請表嘅「其他」欄。",
        "zh-Hans": "请把它写在申请表的“其他”栏里。"
      },
