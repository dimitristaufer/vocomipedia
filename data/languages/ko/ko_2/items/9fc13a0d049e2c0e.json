  "sentences": [
    {
      "target": "이 영화는 시대적 분위기를 잘 보여 줘요.",
      "reading": "i yeonghwaneun sidaejeok bunwigireul jal boyeo jwoyo.",
      "translations": {
        "en": "This movie clearly shows the atmosphere of its time.",
        "ko": "이 영화는 시대적 분위기를 잘 보여 줘요.",
        "ipa": "i yeonghwaneun sidaejeok bunwigireul jal boyeo jwoyo.",
        "ar": "يُظهر هذا الفيلم بوضوح أجواء عصره.",
        "cs": "Tento film dobře ukazuje atmosféru své doby.",
        "da": "Denne film viser tidens stemning tydeligt.",
        "de": "Dieser Film zeigt die Atmosphäre seiner Zeit gut.",
        "el": "Αυτή η ταινία δείχνει καλά την ατμόσφαιρα της εποχής της.",
        "es": "Esta película muestra bien el ambiente de su época.",
        "fi": "Tämä elokuva näyttää hyvin aikansa tunnelman.",
        "fr": "Ce film montre bien l'ambiance de son époque.",
        "he": "הסרט הזה מציג היטב את אווירת התקופה.",
        "hi": "यह फ़िल्म अपने समय का माहौल अच्छी तरह दिखाती है।",
        "hu": "Ez a film jól bemutatja a kor hangulatát.",
        "id": "Film ini dengan baik menunjukkan suasana zamannya.",
        "it": "Questo film mostra bene l'atmosfera del suo tempo.",
        "ja": "この映画は当時の雰囲気をよく表しています。",
        "nb": "Denne filmen viser tidens stemning godt.",
        "nl": "Deze film laat de sfeer van die tijd goed zien.",
        "pl": "Ten film dobrze oddaje atmosferę swoich czasów.",
        "pt": "Este filme mostra bem o clima da sua época.",
        "ro": "Acest film arată bine atmosfera vremii sale.",
        "ru": "Этот фильм хорошо передаёт атмосферу своего времени.",
        "sv": "Den här filmen visar tidens stämning väl.",
        "tr": "Bu film, döneminin havasını iyi gösteriyor.",
        "uk": "Цей фільм добре показує атмосферу свого часу.",
        "vi": "Bộ phim này thể hiện rất rõ không khí của thời đại đó.",
        "yue": "呢套戲好好咁呈現咗嗰個年代嘅氣氛。",
        "zh-Hans": "这部电影很好地展现了那个时代的氛围。"
      },
