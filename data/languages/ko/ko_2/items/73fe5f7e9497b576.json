  "sentences": [
    {
      "target": "비가 와도 상관없이 우리는 산책했어요.",
      "reading": "biga wado sanggwaneopsi urineun sanchaekhaesseoyo.",
      "translations": {
        "en": "We went for a walk regardless of the rain.",
        "ko": "비가 와도 상관없이 우리는 산책했어요.",
        "ipa": "biga wado sanggwaneopsi urineun sanchaekhaesseoyo.",
        "ar": "ذهبنا في نزهة رغم المطر.",
        "cs": "Šli jsme na procházku i přes déšť.",
        "da": "Vi gik en tur, selvom det regnede.",
        "de": "Wir gingen trotz des Regens spazieren.",
        "el": "Πήγαμε για βόλτα παρόλο που έβρεχε.",
        "es": "Salimos a caminar aunque llovía.",
        "fi": "Lähdimme kävelylle sateesta huolimatta.",
        "fr": "Nous sommes allés nous promener malgré la pluie.",
        "he": "יצאנו לטיול למרות הגשם.",
        "hi": "हम बारिश के बावजूद टहलने गए।",
        "hu": "Eső ellenére mentünk sétálni.",
        "id": "Kami pergi jalan-jalan meskipun hujan.",
        "it": "Siamo andati a fare una passeggiata nonostante la pioggia.",
        "ja": "雨が降っても関係なく、私たちは散歩しました。",
        "nb": "Vi gikk en tur selv om det regnet.",
        "nl": "We gingen wandelen, ondanks de regen.",
        "pl": "Poszliśmy na spacer mimo deszczu.",
        "pt": "Fomos dar uma caminhada apesar da chuva.",
        "ro": "Am mers la plimbare, în ciuda ploii.",
        "ru": "Мы пошли гулять, несмотря на дождь.",
        "sv": "Vi gick på promenad trots regnet.",
        "tr": "Yağmura rağmen yürüyüşe çıktık.",
        "uk": "Ми пішли на прогулянку, попри дощ.",
        "vi": "Chúng tôi đã đi dạo bất chấp trời mưa.",
        "yue": "落雨都無所謂，我哋去咗散步。",
        "zh-Hans": "我们不管下雨还是去散步了。"
      },
