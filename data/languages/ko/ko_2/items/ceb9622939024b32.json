  "sentences": [
    {
      "target": "할머니는 병실에서 쉬고 계세요.",
      "reading": "Halmeonineun byeongsileseo swigo gyeseyo.",
      "translations": {
        "en": "Grandma is resting in the hospital room.",
        "ko": "할머니는 병실에서 쉬고 계세요.",
        "ipa": "Halmeonineun byeongsileseo swigo gyeseyo.",
        "ar": "تستريح الجدة في غرفة المستشفى.",
        "cs": "Babička odpočívá na nemocničním pokoji.",
        "da": "Bedstemor hviler sig på hospitalstuen.",
        "de": "Oma ruht sich im Krankenzimmer aus.",
        "el": "Η γιαγιά ξεκουράζεται στο δωμάτιο του νοσοκομείου.",
        "es": "La abuela está descansando en la habitación del hospital.",
        "fi": "Isoäiti lepää sairaalahuoneessa.",
        "fr": "Grand-mère se repose dans la chambre d'hôpital.",
        "he": "סבתא נחה בחדר בבית החולים.",
        "hi": "दादी अस्पताल के कमरे में आराम कर रही हैं।",
        "hu": "A nagymama a kórteremben pihen.",
        "id": "Nenek sedang beristirahat di ruang rawat inap.",
        "it": "La nonna si riposa in camera d'ospedale.",
        "ja": "おばあさんは病室で休んでいます。",
        "nb": "Bestemor hviler på sykerommet.",
        "nl": "Oma rust in de ziekenkamer.",
        "pl": "Babcia odpoczywa na sali szpitalnej.",
        "pt": "A vovó está descansando no quarto do hospital.",
        "ro": "Bunica se odihnește în salonul de spital.",
        "ru": "Бабушка отдыхает в палате.",
        "sv": "Mormor vilar på sjukhusrummet.",
        "tr": "Büyükanne hastane odasında dinleniyor.",
        "uk": "Бабуся відпочиває в лікарняній палаті.",
        "vi": "Bà đang nghỉ ngơi trong phòng bệnh.",
        "yue": "婆婆喺病房休息緊。",
        "zh-Hans": "奶奶在病房里休息。"
      },
