    {
      "target": "駅で友だちの見送りをした。",
      "reading": "えきでともだちのみおくりをした。",
      "translations": {
        "en": "I saw my friend off at the station.",
        "ar": "ودعت صديقي في المحطة.",
        "cs": "Vyprovodil jsem kamaráda na nádraží.",
        "da": "Jeg fulgte min ven til stationen.",
        "de": "Ich habe meinen Freund am Bahnhof verabschiedet.",
        "el": "Αποχαιρέτησα τον φίλο μου στον σταθμό.",
        "es": "Despedí a mi amigo en la estación.",
        "fi": "Saatoin ystäväni asemalle.",
        "fr": "J'ai accompagné mon ami à la gare.",
        "he": "נפרדתי מהחבר שלי בתחנה.",
        "hi": "मैंने स्टेशन पर अपने दोस्त को विदा किया।",
        "hu": "Kikísértem a barátomat az állomásra.",
        "id": "Aku mengantar temanku sampai stasiun.",
        "it": "Ho accompagnato il mio amico alla stazione.",
        "ko": "역에서 친구를 배웅했어요.",
        "nb": "Jeg fulgte vennen min til stasjonen.",
        "nl": "Ik heb mijn vriend op het station uitgezwaaid.",
        "pl": "Oprowadziłem przyjaciela na dworzec.",
        "pt": "Levei meu amigo até a estação para me despedir dele.",
        "ro": "Mi-am condus prietenul la gară.",
        "ru": "Я проводил друга на вокзале.",
        "sv": "Jag följde min vän till stationen.",
        "tr": "Arkadaşımı istasyona kadar uğurladım.",
        "uk": "Я провів друга на вокзал.",
        "vi": "Tôi đã ra ga tiễn bạn tôi.",
        "yue": "我喺車站送咗朋友。",
        "zh-Hans": "我在车站送了朋友。"
      },
