    {
      "target": "夜明けに海を見に行った。",
      "reading": "よあけにうみをみにいった。",
      "translations": {
        "en": "I went to see the sea at dawn.",
        "ar": "ذهبت لرؤية البحر عند الفجر.",
        "cs": "Šel jsem se podívat na moře za svítání.",
        "da": "Jeg gik ned for at se havet ved daggry.",
        "de": "Ich ging bei Tagesanbruch ans Meer, um es zu sehen.",
        "el": "Πήγα να δω τη θάλασσα την αυγή.",
        "es": "Fui a ver el mar al amanecer.",
        "fi": "Lähdin katsomaan merta aamunkoitteessa.",
        "fr": "Je suis allé voir la mer à l'aube.",
        "he": "הלכתי לראות את הים עם שחר.",
        "hi": "मैं भोर में समुद्र देखने गया।",
        "hu": "Hajnalban mentem megnézni a tengert.",
        "id": "Saya pergi melihat laut saat fajar.",
        "it": "Sono andato a vedere il mare all'alba.",
        "ko": "새벽에 바다를 보러 갔다.",
        "nb": "Jeg gikk for å se havet ved daggry.",
        "nl": "Ik ging bij dageraad naar de zee om die te zien.",
        "pl": "Poszedłem zobaczyć morze o świcie.",
        "pt": "Fui ver o mar ao amanhecer.",
        "ro": "Am mers să văd marea în zori.",
        "ru": "Я пошёл посмотреть на море на рассвете.",
        "sv": "Jag gick för att se havet i gryningen.",
        "tr": "Şafakta denizi görmeye gittim.",
        "uk": "Я пішов подивитися на море на світанку.",
        "vi": "Tôi đi ngắm biển lúc rạng đông.",
        "yue": "我喺黎明去睇海。",
        "zh-Hans": "我在黎明去看海。"
